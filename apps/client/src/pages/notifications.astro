---
import Layout from '../layouts/Layout.astro';
import ActivityTabs from '../components/ActivityTabs.astro';
import { siteName, siteUrl, whatsappChannel, telegramChannel } from '../data/site';

const pageTitle = `Notifications | ${siteName}`;
const pageDescription = `View latest exam alerts, admit card updates, results, and system announcements on ${siteName}.`;
const canonicalUrl = `${siteUrl}/notifications`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  noindex={true}
  useClientRouter={true}
>
  <div class="max-w-4xl mx-auto px-3 sm:px-6 py-4 sm:py-8 min-h-[70vh]">
    <ActivityTabs activeTab="notifications" />

    {/* Controls Header: Filter pills, counts & Mark all read */}
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-border/60">
      <div class="flex items-center gap-1.5 sm:gap-2">
        <button
          type="button"
          id="notif-filter-unread"
          data-notif-filter="unread"
          class="notif-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-surface-raised text-white border border-border shadow-xs transition-colors cursor-pointer"
        >
          <span>Unread</span>
          <span class="notification-badge-count ml-1.5 px-1.5 py-0.2 rounded-full bg-accent/20 text-accent text-[10px] font-bold">
            0
          </span>
        </button>

        <button
          type="button"
          id="notif-filter-all"
          data-notif-filter="all"
          class="notif-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-muted hover:text-white hover:bg-surface-raised/40 transition-colors cursor-pointer"
        >
          <span>All</span>
          <span id="notif-total-count" class="ml-1 text-muted text-[10px]"></span>
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          data-mark-all-read
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-muted hover:text-white hover:bg-surface-raised/60 border border-transparent hover:border-border transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Mark all as read</span>
        </button>
      </div>
    </div>

    {/* Device Push Notification Opt-in Prompt */}
    <div data-browser-notification-prompt class="hidden mb-4 p-3.5 rounded-2xl bg-accent/10 border border-accent/30 text-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-start sm:items-center gap-2.5 min-w-0">
          <span class="text-xl shrink-0">🔔</span>
          <div>
            <p class="font-semibold text-white leading-snug">Enable instant device notifications</p>
            <p class="text-[11px] text-white/80 leading-relaxed mt-0.5">
              Receive breaking updates for official exam dates, admit cards, and recruitment notices on this device.
            </p>
          </div>
        </div>
        <button
          type="button"
          data-enable-browser-notifications
          class="self-start sm:self-center px-3.5 py-2 rounded-xl bg-accent hover:brightness-110 text-on-accent text-xs font-bold transition-all shadow-xs cursor-pointer shrink-0"
        >
          Enable Device Alerts
        </button>
      </div>
    </div>

    {/* Logged Out Banner */}
    <div id="notifications-logged-out" class="hidden mb-5 p-4 rounded-2xl bg-surface border border-border text-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-xl bg-accent/15 text-accent flex items-center justify-center shrink-0 mt-0.5 sm:mt-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-white text-sm">Sign in for personalized exam notifications</p>
            <p class="text-muted text-xs mt-0.5">
              Get targeted notifications for saved exams, category updates, and syllabus changes synchronized across all your devices.
            </p>
          </div>
        </div>
        <a
          href="/login"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-accent text-on-accent text-xs font-bold hover:brightness-110 transition shadow-xs shrink-0"
        >
          <span>Sign In / Register</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    {/* Active Notifications List */}
    <div id="notifications-list" class="space-y-2.5">
      <div class="py-12 text-center text-xs text-muted">
        <div class="w-7 h-7 border-2 border-accent border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p>Loading your notifications...</p>
      </div>
    </div>

    {/* All Caught Up / Empty State */}
    <div id="notifications-caught-up" class="hidden py-12 px-4 text-center rounded-2xl bg-surface border border-border shadow-2xs">
      <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center mx-auto mb-3.5">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h2 class="text-base font-bold text-white tracking-tight">You're all caught up!</h2>
      <p class="text-xs text-muted max-w-sm mx-auto mt-1 leading-relaxed">
        There are no new notifications right now. Check active government exam vacancies or join our broadcast channels.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2.5 mt-5">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-accent text-on-accent text-xs font-semibold hover:brightness-110 transition shadow-xs"
        >
          <span>Explore active exams</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        {whatsappChannel && (
          <a
            href={whatsappChannel}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-surface-raised hover:bg-surface border border-border text-xs font-semibold text-white transition"
          >
            <span>WhatsApp Channel</span>
          </a>
        )}

        {telegramChannel && (
          <a
            href={telegramChannel}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-surface-raised hover:bg-surface border border-border text-xs font-semibold text-white transition"
          >
            <span>Telegram Alerts</span>
          </a>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getNotifications, relativeTime, iconFor } from '../lib/notifications';

  let currentFilter: 'unread' | 'all' = 'unread';

  function renderPageNotifications() {
    const list = document.getElementById('notifications-list');
    const caughtUp = document.getElementById('notifications-caught-up');
    const loggedOutBanner = document.getElementById('notifications-logged-out');
    const totalCountEl = document.getElementById('notif-total-count');
    if (!list || !caughtUp) return;

    const allItems = getNotifications();
    const unreadItems = allItems.filter((i) => !i.read);
    const displayedItems = currentFilter === 'unread' ? unreadItems : allItems;

    // Check auth status
    const isAuth = document.documentElement.getAttribute('data-authenticated') === 'true' || Boolean((window as any).__currentUser);
    if (loggedOutBanner) {
      loggedOutBanner.classList.toggle('hidden', isAuth);
    }

    if (totalCountEl) {
      totalCountEl.textContent = `(${allItems.length})`;
    }

    list.innerHTML = '';

    if (displayedItems.length === 0) {
      list.classList.add('hidden');
      caughtUp.classList.remove('hidden');
      return;
    }

    list.classList.remove('hidden');
    caughtUp.classList.add('hidden');

    displayedItems.forEach((item) => {
      const card = document.createElement(item.href ? 'a' : 'div');
      card.className = `group relative block p-3.5 sm:p-4 rounded-2xl bg-surface hover:bg-surface-raised border transition-all duration-150 shadow-2xs pr-11 ${
        !item.read ? 'border-accent/40 bg-accent/5' : 'border-border'
      }`;
      if (card instanceof HTMLAnchorElement && item.href) {
        card.href = item.href;
        card.dataset.notificationLink = item.id;
      }

      const row = document.createElement('div');
      row.className = 'flex items-start gap-3';

      const icon = document.createElement('div');
      icon.className = 'w-9 h-9 rounded-xl bg-surface-raised border border-border/80 flex items-center justify-center text-lg shrink-0';
      icon.textContent = iconFor(item.kind);

      const content = document.createElement('div');
      content.className = 'flex-1 min-w-0';

      const titleRow = document.createElement('div');
      titleRow.className = 'flex items-center gap-2 mb-1';

      if (!item.read) {
        const unreadDot = document.createElement('span');
        unreadDot.className = 'w-2 h-2 rounded-full bg-accent shrink-0';
        titleRow.appendChild(unreadDot);
      }

      if (item.title) {
        const title = document.createElement('h3');
        title.className = 'text-xs sm:text-sm font-bold text-white group-hover:text-accent transition truncate leading-snug';
        title.textContent = item.title;
        titleRow.appendChild(title);
      }

      const body = document.createElement('p');
      body.className = 'text-xs text-white/90 leading-relaxed font-normal';
      body.textContent = item.body;

      const meta = document.createElement('div');
      meta.className = 'flex items-center gap-2 mt-2 text-[11px] text-muted';
      meta.innerHTML = `
        <span class="font-medium text-accent uppercase text-[10px] tracking-wider">${item.kind}</span>
        <span>•</span>
        <span>${relativeTime(item.createdAt)}</span>
      `;

      content.appendChild(titleRow);
      content.appendChild(body);
      content.appendChild(meta);

      row.appendChild(icon);
      row.appendChild(content);

      // Dismiss / Mark Read button
      const dismissBtn = document.createElement('button');
      dismissBtn.type = 'button';
      dismissBtn.dataset.dismissNotification = item.id;
      dismissBtn.title = item.read ? 'Dismiss notification' : 'Mark as read';
      dismissBtn.className =
        'absolute top-3.5 right-3.5 p-1.5 rounded-lg text-muted hover:text-white hover:bg-surface-raised border border-transparent hover:border-border transition cursor-pointer';
      dismissBtn.innerHTML = `
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      `;

      card.appendChild(row);
      card.appendChild(dismissBtn);
      list.appendChild(card);
    });
  }

  function setupFilterButtons() {
    document.querySelectorAll<HTMLElement>('[data-notif-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-notif-filter') as 'unread' | 'all';
        if (!filter || filter === currentFilter) return;
        currentFilter = filter;

        document.querySelectorAll<HTMLElement>('[data-notif-filter]').forEach((b) => {
          const isActive = b.getAttribute('data-notif-filter') === currentFilter;
          b.className = `notif-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors cursor-pointer ${
            isActive
              ? 'bg-surface-raised text-white border border-border shadow-xs'
              : 'text-muted hover:text-white hover:bg-surface-raised/40'
          }`;
        });

        renderPageNotifications();
      });
    });
  }

  // Initialize
  renderPageNotifications();
  setupFilterButtons();

  window.addEventListener('notifications-updated', () => {
    renderPageNotifications();
  });

  document.addEventListener('astro:page-load', () => {
    renderPageNotifications();
    setupFilterButtons();
  });
</script>
