---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Authenticating... - govtpariksha.com" hideHeaderFooter={true} disableTransitions={true}>
  <main class="min-h-screen w-full flex flex-col items-center justify-center bg-[#0d0e11] text-[#ffffff] px-4">
    <div class="flex flex-col items-center gap-4 text-center max-w-sm">
      <div class="w-10 h-10 border-3 border-accent border-t-transparent rounded-full animate-spin"></div>
      <h2 class="text-heading-md font-bold text-[#ffffff]">Authenticating...</h2>
      <p class="text-caption-sm text-[#888b96]">Completing sign-in with Google. You will be redirected shortly.</p>
    </div>
  </main>

  <script>
    import { getReadyClerk } from '../lib/clerk-session';

    function safeRedirect(url: string | null | undefined) {
      if (url && url.startsWith('/') && !url.startsWith('//')) return url;
      try {
        const parsed = url ? new URL(url, window.location.origin) : null;
        if (parsed && parsed.origin === window.location.origin) {
          return `${parsed.pathname}${parsed.search}`;
        }
      } catch {
        /* ignore */
      }
      return '/';
    }

    const clerk = await getReadyClerk();
    const fallback = safeRedirect(
      new URLSearchParams(window.location.search).get('redirect_url'),
    );

    try {
      if (typeof clerk?.handleRedirectCallback === 'function') {
        await clerk.handleRedirectCallback({});
      } else if (clerk?.user) {
        window.location.replace(fallback);
      } else {
        window.location.replace(fallback);
      }
    } catch (err: any) {
      const already =
        err?.errors?.[0]?.code === 'identifier_already_signed_in' ||
        /already signed in/i.test(String(err?.message || err?.errors?.[0]?.message || ''));
      if (already || clerk?.user) {
        window.location.replace(fallback === '/' ? '/admin/dashboard' : fallback);
      } else {
        window.location.assign('/login?error=' + encodeURIComponent(err?.message || 'sso_failed'));
      }
    }
  </script>
</Layout>
