---
import Layout from '../layouts/Layout.astro';
import { siteDomain } from '../data/site';
---

<Layout title={`Authenticating... - ${siteDomain}`} hideHeaderFooter={true}>
  <main class="min-h-screen w-full flex flex-col items-center justify-center bg-[#0d0e11] text-[#ffffff] px-4">
    <div class="flex flex-col items-center gap-4 text-center max-w-sm">
      <div class="w-10 h-10 border-3 border-accent border-t-transparent rounded-full animate-spin"></div>
      <h2 class="text-heading-md font-bold text-[#ffffff]">Authenticating...</h2>
      <p class="text-caption-sm text-[#888b96]">Completing sign-in with Google. You will be redirected shortly.</p>
    </div>
  </main>

  <script>
    async function handleAuthCallback() {
      const clerk = (window as any).Clerk;
      if (!clerk) return;

      if (!clerk.loaded && typeof clerk.load === 'function') {
        try {
          await clerk.load();
        } catch (_) {}
      }

      try {
        if (typeof clerk.handleRedirectCallback === 'function') {
          await clerk.handleRedirectCallback({
            afterSignInUrl: '/',
            afterSignUpUrl: '/',
          });
        } else {
          window.location.assign('/');
        }
      } catch (err: any) {
        console.error('Error in SSO redirect callback:', err);
        // If already signed in, navigate to /
        if (clerk.user) {
          window.location.assign('/');
        } else {
          window.location.assign('/login?error=' + encodeURIComponent(err?.message || 'sso_failed'));
        }
      }
    }

    window.addEventListener('load', handleAuthCallback);
    document.addEventListener('astro:page-load', handleAuthCallback);

    let checkCount = 0;
    const interval = setInterval(() => {
      checkCount++;
      if ((window as any).Clerk?.loaded || checkCount > 20) {
        clearInterval(interval);
        handleAuthCallback();
      }
    }, 150);
  </script>
</Layout>
