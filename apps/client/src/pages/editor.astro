  function applyKeywordsAndTags(keywords: string[]) {
    if (!keywords || !keywords.length) return;
    const cleanKeywords = keywords
      .map((k) => k.trim().toLowerCase())
      .filter(Boolean);
    const matchedTagIds: string[] = [];

    for (const tag of tagCatalog) {
      const tagNameLower = tag.name.trim().toLowerCase();
      const tagWords = tagNameLower.split(/\s+/);
      const isMatched = cleanKeywords.some((kw) => {
        if (kw === tagNameLower || kw.includes(tagNameLower) || tagNameLower.includes(kw)) return true;
        const kwWords = kw.split(/\s+/);
        return tagWords.some((tw) => tw.length > 2 && kwWords.includes(tw));
      });
      if (isMatched) {
        matchedTagIds.push(tag.id);
      }
    }

    if (matchedTagIds.length > 0) {
      document.querySelectorAll<HTMLInputElement>('#field-tags input[type="checkbox"]').forEach((checkbox) => {
        if (matchedTagIds.includes(checkbox.value)) {
          checkbox.checked = true;
        }
      });
    }
  }

