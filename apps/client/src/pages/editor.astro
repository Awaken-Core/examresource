    if (!editor || currentEditorMode === 'markdown') return;

    if (editor.isActive('image')) {
      emptyBox?.classList.add('hidden');
      activeBox?.classList.remove('hidden');
      if (blockName) blockName.textContent = 'Image Block';
      if (blockTag) blockTag.textContent = 'IMG';

      imgSec?.classList.remove('hidden');
      listSec?.classList.add('hidden');
