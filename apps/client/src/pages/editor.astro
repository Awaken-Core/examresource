  // 1-Click Bi-directional Bilingual Translation Workflow
  async function runBilingualTranslation(forceDirection?: 'H_TO_E' | 'E_TO_H') {
    if (currentEditorMode !== 'compare') {
      switchEditorMode('compare');
    }

    const hText = compareHinglishMarkdown?.value.trim() || '';
    const eText = compareEnglishMarkdown?.value.trim() || '';
    const hTitle = compareHinglishTitle?.value.trim() || '';
    const eTitle = compareEnglishTitle?.value.trim() || '';

    let direction = forceDirection;
    if (!direction) {
      if (hText && !eText) {
        direction = 'H_TO_E';
      } else if (eText && !hText) {
        direction = 'E_TO_H';
      } else if (languageSelect?.value === 'ENGLISH') {
        direction = 'E_TO_H';
      } else {
        direction = 'H_TO_E';
      }
    }

    const isHinglishSource = direction === 'H_TO_E';
    const sourceTitle = isHinglishSource
      ? (hTitle || titleInput?.value || '')
      : (eTitle || titleInput?.value || '');
    const sourceMarkdown = isHinglishSource
      ? (hText || (markdownTextarea?.value || turndownService.turndown(editor.getHTML())))
      : (eText || (markdownTextarea?.value || turndownService.turndown(editor.getHTML())));

    if (!sourceMarkdown && !sourceTitle) {
      alert('Please enter or paste article content into either the Hinglish or English editor pane first!');
      return;
    }

    // Set UI Feedback
    if (compareAiBtnLabel) compareAiBtnLabel.textContent = 'Translating with Gemini...';
    if (topBilingualBtn) {
      topBilingualBtn.classList.add('opacity-70', 'cursor-not-allowed');
      topBilingualBtn.setAttribute('disabled', 'true');
    }
    if (compareAutoTranslateBtn) {
      compareAutoTranslateBtn.setAttribute('disabled', 'true');
    }
    if (compareSyncBadge) {
      compareSyncBadge.className = 'px-2 py-0.5 rounded text-[10px] font-medium bg-amber-50 text-amber-700 border border-amber-200';
      compareSyncBadge.textContent = 'Translating...';
    }

    try {
      const res = await apiFetch('/blogs/translate-content', {
        method: 'POST',
        body: JSON.stringify({
          title: sourceTitle,
          markdown: sourceMarkdown,
          sourceLanguage: isHinglishSource ? 'HINGLISH' : 'ENGLISH',
          targetLanguage: isHinglishSource ? 'ENGLISH' : 'HINGLISH',
        }),
      });

      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.message || `HTTP ${res.status}`);
      }

      const data = await res.json();

      if (isHinglishSource) {
        if (compareEnglishTitle) compareEnglishTitle.value = data.title || '';
        if (compareEnglishMarkdown) compareEnglishMarkdown.value = data.markdown || '';
        if (compareEnglishExcerpt) compareEnglishExcerpt.value = data.excerpt || '';
        if (compareEnglishSlug && data.slugSuggestion) {
          compareEnglishSlug.value = data.slugSuggestion.endsWith('-english') ? data.slugSuggestion : `${data.slugSuggestion}-english`;
        }
        if (compareHinglishSlug && !compareHinglishSlug.value.trim() && slugInput?.value) {
          compareHinglishSlug.value = slugInput.value.endsWith('-hinglish') ? slugInput.value : `${slugInput.value}-hinglish`;
        }
      } else {
        if (compareHinglishTitle) compareHinglishTitle.value = data.title || '';
        if (compareHinglishMarkdown) compareHinglishMarkdown.value = data.markdown || '';
        if (compareHinglishExcerpt) compareHinglishExcerpt.value = data.excerpt || '';
        if (compareHinglishSlug && data.slugSuggestion) {
          compareHinglishSlug.value = data.slugSuggestion.endsWith('-hinglish') ? data.slugSuggestion : `${data.slugSuggestion}-hinglish`;
        }
        if (compareEnglishSlug && !compareEnglishSlug.value.trim() && slugInput?.value) {
          compareEnglishSlug.value = slugInput.value.endsWith('-english') ? slugInput.value : `${slugInput.value}-english`;
        }
      }

      updateCompareStats();

      if (compareSyncBadge) {
        compareSyncBadge.className = 'px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
        compareSyncBadge.textContent = 'Both Blogs Synced';
      }

      isDirty = true;
    } catch (err: any) {
      console.error('Bilingual translation failed:', err);
      alert(`Translation failed: ${err.message || 'Please verify Gemini API key configuration.'}`);
      if (compareSyncBadge) {
        compareSyncBadge.className = 'px-2 py-0.5 rounded text-[10px] font-medium bg-red-50 text-red-700 border border-red-200';
        compareSyncBadge.textContent = 'Translation Failed';
      }
    } finally {
      if (compareAiBtnLabel) compareAiBtnLabel.textContent = 'Auto-Translate';
      if (topBilingualBtn) {
        topBilingualBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        topBilingualBtn.removeAttribute('disabled');
      }
      if (compareAutoTranslateBtn) {
        compareAutoTranslateBtn.removeAttribute('disabled');
      }
    }
  }

