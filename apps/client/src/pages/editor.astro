---
import Layout from '../layouts/Layout.astro';
import { STATES_LIST, CATEGORIES_LIST } from '../data/portalMockData';
// Auth is enforced on the client below (Clerk's SSR session isn't reliably
// resolved on the first dev-mode request due to its handshake flow).
---

<Layout
  title="Article Editor - govtpariksha.com"
  description="Create and edit government exam articles, notifications, admit cards, and results."
  hideHeaderFooter={true}
  disableTransitions={true}
>
  <script>
    import { waitForClerkToken, fetchCurrentUser } from '../lib/clerk-session';

    const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';
    const token = await waitForClerkToken();
    if (!token) {
      window.location.replace('/login?redirect_url=/editor');
    } else {
      const { user } = await fetchCurrentUser(apiUrl, token);
      if (!user) window.location.replace('/login?redirect_url=/editor');
      else if (!['editor', 'admin'].includes(user.role)) window.location.replace('/');
    }
  </script>
  <div class="min-h-screen bg-canvas text-white px-4 sm:px-6 lg:px-8 py-6">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col gap-4 pb-6 border-b border-border sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2 text-caption-sm text-muted">
          <a href="/admin" class="hover:text-accent">Admin</a>
          <span>/</span>
          <span class="text-white font-medium">Article editor</span>
        </div>
        <h1 class="text-heading-md font-bold text-white mt-2">
          Write an article
        </h1>
        <p class="text-body-sm text-muted mt-1">
          Compose exam notices with headings, tables, and a live preview.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button id="toggle-preview-btn" class="btn-outline inline-flex items-center">
          <span id="preview-btn-text">Live preview</span>
        </button>
        <button id="save-draft-btn" class="btn-secondary">
          Save draft
        </button>
        <button id="publish-btn" class="btn-primary">
          Publish
        </button>
      </div>
    </div>

    <div id="editor-toast" class="hidden my-4 p-3 rounded-xl text-body-sm font-medium bg-surface text-success border border-success/40 flex items-center justify-between">
      <span id="editor-toast-text">Article saved successfully!</span>
      <button id="editor-toast-close" class="text-muted hover:text-white font-bold ml-2">✕</button>
    </div>

    {/* Main Workspace: Split into Form View & Live Preview Panel */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      
      {/* Editor Fields Column */}
      <div id="editor-form-col" class="lg:col-span-7 space-y-6">
        
        {/* Core Post Metadata Card */}
        <div class="card-flat p-5 space-y-4">
          <h2 class="text-heading-sm font-semibold text-white border-b border-border pb-2">
            Article details
          </h2>

          <div>
            <label class="block text-label font-medium text-white mb-1">Headline</label>
            <input 
              type="text" 
              id="field-title"
              value="Bihar DECE LE Seat Allotment Result 2026: 1st Round Allotment Letter Download Link"
              class="input font-semibold"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-label font-medium text-white mb-1">URL slug</label>
              <input 
                type="text" 
                id="field-slug"
                value="bihar-dece-le-seat-allotment-2026"
                class="input text-body-sm"
              />
            </div>

            <div>
              <label class="block text-label font-medium text-white mb-1">Target state</label>
              <select 
                id="field-state"
                class="input text-body-sm"
              >
                {STATES_LIST.map(st => (
                  <option value={st} selected={st === 'Bihar'}>{st}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-label font-medium text-white mb-1">Category</label>
              <select 
                id="field-category"
                class="input text-body-sm"
              >
                {CATEGORIES_LIST.filter(c => c.id !== 'all').map(c => (
                  <option value={c.name} selected={c.name === 'Admission & Counselling'}>{c.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-label font-medium text-white mb-1">Notice number</label>
              <input 
                type="text" 
                id="field-notice"
                value="BCECEB(DECE-LE)-2026/08"
                class="input text-body-sm"
              />
            </div>
          </div>

          <div>
            <label class="block text-label font-medium text-white mb-1">Summary</label>
            <textarea 
              id="field-summary"
              rows="3"
              class="input min-h-24 resize-y text-body-sm"
            >Bihar Combined Entrance Competitive Examination Board (BCECEB) has officially released the Round 1 Seat Allotment result for Lateral Entry Polytechnic diploma admissions.</textarea>
          </div>
        </div>

        {/* Content Body Editor with Formatting Bar */}
        <div class="card-flat p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-border">
            <h2 class="text-heading-sm font-semibold text-white">Article body</h2>
            <span class="text-caption-xs text-muted">HTML supported</span>
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" class="insert-tag btn-ghost text-button-xs h-7" data-tag="h2">Heading</button>
            <button type="button" class="insert-tag btn-ghost text-button-xs h-7" data-tag="h3">Subheading</button>
            <button type="button" class="insert-tag btn-ghost text-button-xs h-7" data-tag="p">Paragraph</button>
            <button type="button" class="insert-tag btn-ghost text-button-xs h-7" data-tag="list">List</button>
            <button type="button" class="insert-tag btn-ghost text-button-xs h-7" data-tag="table">Table</button>
            <button type="button" class="insert-tag btn-ghost text-button-xs h-7" data-tag="link">Link</button>
          </div>

          <textarea 
            id="field-content"
            rows="12"
            class="input font-mono text-body-xs min-h-64 resize-y"
          ><h2>Bihar DECE LE 2026: Important Counselling Schedule</h2>
<p>Candidates can check their college and branch allotment by logging into the official portal using their Roll Number and Password.</p>

<h3>Key Instructions for Document Verification:</h3>
<ul>
  <li>Download 3 clear copies of the provisional allotment order.</li>
  <li>Carry original matriculation and intermediate certificates.</li>
  <li>Report at the allotted nodal center before 16 October 2026.</li>
</ul>

<h3>Direct Verification Links:</h3>
<p><a href="https://bceceboard.bihar.gov.in" target="_blank">Download Round 1 Allotment Letter ↗</a></p></textarea>
        </div>

        {/* SEO & Featured Media Card */}
        <div class="card-flat p-5 space-y-3">
          <h2 class="text-heading-sm font-semibold text-white border-b border-border pb-2">
            SEO and media
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-label font-medium text-white mb-1">Cover image</label>
              <input 
                type="text" 
                id="field-image"
                value="/images/bihar-dece-le-allotment-2026.webp"
                class="input text-body-sm"
              />
            </div>

            <div>
              <label class="block text-label font-medium text-white mb-1">Keywords</label>
              <input 
                type="text" 
                id="field-keywords"
                value="bihar dece le allotment, bceceb lateral entry 2026"
                class="input text-body-sm"
              />
            </div>
          </div>
        </div>
      </div>

      {/* Live Preview Panel (5 cols on lg) */}
      <div id="preview-panel-col" class="lg:col-span-5 space-y-4">
        <div class="card sticky top-6 p-5">
          <div class="flex items-center justify-between pb-3 border-b border-border">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-success"></span>
              <h2 class="text-heading-sm font-semibold text-white">Live preview</h2>
            </div>
            <span id="preview-status-pill" class="badge-accent">
              Live
            </span>
          </div>

          <div class="mt-4 space-y-3">
            <div class="flex items-center gap-2">
              <span id="prev-category" class="badge-accent">
                Admission & Counselling
              </span>
              <span id="prev-state" class="badge-outline">
                Bihar
              </span>
            </div>

            <h3 id="prev-title" class="text-heading-sm font-bold text-white leading-snug">
              Bihar DECE LE Seat Allotment Result 2026: 1st Round Allotment Letter Download Link
            </h3>

            <div class="text-caption-xs text-muted pb-2 border-b border-border flex items-center justify-between">
              <span>govtpariksha.com</span>
              <span id="prev-date">Today</span>
            </div>

            <div class="border-l-3 border-accent bg-surface-raised p-3 rounded-r-xl">
              <p id="prev-summary" class="text-body-sm text-white">
                Bihar Combined Entrance Competitive Examination Board (BCECEB) has officially released the Round 1 Seat Allotment result.
              </p>
            </div>

            <div id="prev-content" class="prose-exam text-body-sm text-muted pt-2">
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
  </div>
</Layout>

<script>
  const titleInput = document.getElementById('field-title') as HTMLInputElement | null;
  const categoryInput = document.getElementById('field-category') as HTMLSelectElement | null;
  const stateInput = document.getElementById('field-state') as HTMLSelectElement | null;
  const summaryInput = document.getElementById('field-summary') as HTMLTextAreaElement | null;
  const contentInput = document.getElementById('field-content') as HTMLTextAreaElement | null;

  const prevTitle = document.getElementById('prev-title');
  const prevCategory = document.getElementById('prev-category');
  const prevState = document.getElementById('prev-state');
  const prevSummary = document.getElementById('prev-summary');
  const prevContent = document.getElementById('prev-content');

  const toast = document.getElementById('editor-toast');
  const toastText = document.getElementById('editor-toast-text');
  const toastClose = document.getElementById('editor-toast-close');
  const saveDraftBtn = document.getElementById('save-draft-btn');
  const publishBtn = document.getElementById('publish-btn');
  const togglePreviewBtn = document.getElementById('toggle-preview-btn');
  const previewPanel = document.getElementById('preview-panel-col');

  function updateLivePreview() {
    if (prevTitle && titleInput) prevTitle.textContent = titleInput.value || 'Untitled Article';
    if (prevCategory && categoryInput) prevCategory.textContent = categoryInput.value;
    if (prevState && stateInput) prevState.textContent = `📍 ${stateInput.value}`;
    if (prevSummary && summaryInput) prevSummary.textContent = summaryInput.value;
    if (prevContent && contentInput) {
      prevContent.innerHTML = contentInput.value;
    }
  }

  titleInput?.addEventListener('input', updateLivePreview);
  categoryInput?.addEventListener('change', updateLivePreview);
  stateInput?.addEventListener('change', updateLivePreview);
  summaryInput?.addEventListener('input', updateLivePreview);
  contentInput?.addEventListener('input', updateLivePreview);

  // Initial render
  updateLivePreview();

  // Toolbar tag insertion
  document.querySelectorAll<HTMLButtonElement>('.insert-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag;
      if (!contentInput) return;

      let snippet = '';
      if (tag === 'h2') snippet = '\n<h2>Section Title</h2>\n';
      else if (tag === 'h3') snippet = '\n<h3>Subheading Title</h3>\n';
      else if (tag === 'p') snippet = '\n<p>Add detailed descriptive text here.</p>\n';
      else if (tag === 'list') snippet = '\n<ul>\n  <li>Important item 1</li>\n  <li>Important item 2</li>\n</ul>\n';
      else if (tag === 'table') snippet = '\n<table class="w-full text-body-xs border border-border my-2">\n  <tr class="bg-surface-raised font-semibold"><td>Column 1</td><td>Column 2</td></tr>\n  <tr><td>Value 1</td><td>Value 2</td></tr>\n</table>\n';
      else if (tag === 'link') snippet = '\n<a href="https://example.com" class="text-accent underline font-semibold">Official Link Here</a>\n';

      const start = contentInput.selectionStart;
      const end = contentInput.selectionEnd;
      const text = contentInput.value;
      contentInput.value = text.substring(0, start) + snippet + text.substring(end);
      contentInput.focus();
      updateLivePreview();
    });
  });

  function showEditorToast(message: string) {
    if (toast && toastText) {
      toastText.textContent = message;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }
  }

  toastClose?.addEventListener('click', () => {
    toast?.classList.add('hidden');
  });

  saveDraftBtn?.addEventListener('click', () => {
    showEditorToast('Draft saved successfully to local state!');
  });

  publishBtn?.addEventListener('click', () => {
    showEditorToast('Article published! Live in public portal state filters.');
  });

  // Mobile toggle preview
  togglePreviewBtn?.addEventListener('click', () => {
    if (previewPanel) {
      previewPanel.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>
