  // Table of Contents generator inside editor
  function insertTableOfContentsBlock(targetPos?: number | null) {
    const headings: { text: string; id: string; level: number }[] = [];

    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const lines = markdownTextarea.value.split('\n');
      lines.forEach((l) => {
        const m = l.match(/^(#{2,4})\s+(.+)$/);
        if (m) {
          const text = m[2].trim();
          headings.push({ text, id: slugify(text), level: m[1].length });
        }
      });

      if (headings.length === 0) {
        insertMarkdownSnippet('toc', '\n\n### Table of Contents\n*(Add H2, H3 headings to populate)*\n\n');
        return;
      }

      const mdToc = '\n\n### Table of Contents\n' + headings.map(h => `${'  '.repeat(h.level - 2)}- [${h.text}](#${h.id})`).join('\n') + '\n\n';
      insertMarkdownSnippet('toc', mdToc);
      return;
    }

    if (!editor) return;

    editor.state.doc.descendants((node) => {
      if (node.type.name === 'heading') {
        const text = node.textContent;
        const level = node.attrs.level;
        const id = slugify(text);
        headings.push({ text, id, level });
      }
    });

    if (headings.length === 0) {
      const emptyToc = `<div class="toc-block p-4 my-4 bg-slate-50 border border-slate-200 rounded-lg text-xs"><p><strong>Table of Contents:</strong> Add headings (H2, H3) to populate this list.</p></div><p></p>`;
      if (typeof targetPos === 'number') {
        editor.chain().focus().insertContentAt(targetPos, emptyToc).run();
      } else {
        editor.chain().focus().insertContent(emptyToc).run();
      }
      return;
    }

    const tocList = headings
      .map((h) => `<li style="margin-left: ${(h.level - 2) * 16}px"><a href="#${h.id}" class="text-blue-600 hover:underline">${h.text}</a></li>`)
      .join('');

    const tocHtml = `
      <div class="toc-block p-4 my-4 bg-slate-50 border border-slate-200 rounded-lg text-xs">
        <strong class="block mb-2 text-slate-800 text-sm">Table of Contents</strong>
        <ul class="space-y-1 list-none pl-0">${tocList}</ul>
      </div>
      <p></p>
    `;

    if (typeof targetPos === 'number') {
      editor.chain().focus().insertContentAt(targetPos, tocHtml).run();
    } else {
      editor.chain().focus().insertContent(tocHtml).run();
    }
  }

  // Slash Command (/) Autocomplete
  function checkSlashCommand() {
    if (currentEditorMode !== 'visual') return;
    const { from } = editor.state.selection;
    const textBefore = editor.state.doc.textBetween(Math.max(0, from - 30), from, '\n', '\0');
    const match = textBefore.match(/\/([a-zA-Z0-9]*)$/);

    if (match) {
      const query = match[1].toLowerCase();
      openSlashMenu(query);
    } else {
      closeSlashMenu();
    }
  }

  const slashOptions = [
    { title: 'Paragraph', desc: 'Standard body text', action: () => insertBlock('paragraph') },
    { title: 'Heading 2', desc: 'Section heading (##)', action: () => insertBlock('h2') },
    { title: 'Heading 3', desc: 'Subheading (###)', action: () => insertBlock('h3') },
    { title: 'Heading 4', desc: 'Minor section (####)', action: () => insertBlock('h4') },
    { title: 'Bullet List', desc: 'Unordered bullet points (-)', action: () => insertBlock('bulletList') },
    { title: 'Numbered List', desc: 'Numbered step list (1.)', action: () => insertBlock('orderedList') },
    { title: 'Image', desc: 'Illustration with alt text', action: () => insertBlock('image') },
    { title: 'Table', desc: 'Row and column data', action: () => insertBlock('table') },
    { title: 'Code Block', desc: 'Syntax highlighted code (```)', action: () => insertBlock('codeBlock') },
    { title: 'Blockquote', desc: 'Quoted excerpt (>)', action: () => insertBlock('blockquote') },
    { title: 'Callout', desc: 'Important note alert', action: () => insertBlock('callout') },
    { title: 'Divider', desc: 'Horizontal rule (---)', action: () => insertBlock('divider') },
    { title: 'Video Embed', desc: 'YouTube or direct video player', action: () => insertBlock('video') },
