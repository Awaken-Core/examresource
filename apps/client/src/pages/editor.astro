  function formatVideoEmbedUrl(rawUrl: string): string | null {
    if (!rawUrl) return null;
    let url = rawUrl.trim();

    // YouTube watch or short link: https://www.youtube.com/watch?v=XYZ or https://youtu.be/XYZ
    const ytMatch = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i);
    if (ytMatch && ytMatch[1]) {
      return `https://www.youtube.com/embed/${ytMatch[1]}`;
    }

    // Vimeo link: https://vimeo.com/123456789
    const vimeoMatch = url.match(/vimeo\.com\/(?:channels\/(?:\w+\/)?|groups\/([^\/]*)\/videos\/|album\/(\d+)\/video\/|)(\d+)/i);
    if (vimeoMatch && vimeoMatch[3]) {
      return `https://player.vimeo.com/video/${vimeoMatch[3]}`;
    }

    // Direct embed link
    if (url.startsWith('https://www.youtube.com/embed/') || url.startsWith('https://player.vimeo.com/video/')) {
      return url;
    }

    return null;
  }

