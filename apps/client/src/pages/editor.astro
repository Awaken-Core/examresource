      md = currentLang === 'ENGLISH' ? (compareEnglishMarkdown?.value || '') : (compareHinglishMarkdown?.value || '');
    } else if (editor) {
      const html = editor.getHTML();
      if (html && html !== '<p></p>') {
        md = turndownService.turndown(html);
      } else if (markdownTextarea?.value.trim()) {
        md = markdownTextarea.value;
      }
    }

    if (currentLang === 'ENGLISH') {
      if (compareEnglishTitle && titleInput?.value) compareEnglishTitle.value = titleInput.value;
      if (compareEnglishSlug && slugInput?.value) compareEnglishSlug.value = slugInput.value;
      if (compareEnglishExcerpt && excerptInput?.value) compareEnglishExcerpt.value = excerptInput.value;
      if (compareEnglishMarkdown && md) compareEnglishMarkdown.value = md;
    } else {
      if (compareHinglishTitle && titleInput?.value) compareHinglishTitle.value = titleInput.value;
      if (compareHinglishSlug && slugInput?.value) compareHinglishSlug.value = slugInput.value;
      if (compareHinglishExcerpt && excerptInput?.value) compareHinglishExcerpt.value = excerptInput.value;
      if (compareHinglishMarkdown && md) compareHinglishMarkdown.value = md;
    }
  }

