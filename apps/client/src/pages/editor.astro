  mdFileInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    try {
      const text = await file.text();
      applyImportedMarkdown(text, file.name);
    } catch (err) {
      alert('Failed to read Markdown file. Please check file permissions and format.');
    } finally {
      if (mdFileInput) mdFileInput.value = '';
    }
  });

  function applyImportedMarkdown(rawMarkdown: string, fileName?: string) {
    if (!rawMarkdown || !rawMarkdown.trim()) {
      alert('Selected Markdown file is empty.');
      return;
    }

    let markdown = rawMarkdown;

    // Check if markdown begins with frontmatter (---)
    const frontmatterMatch = markdown.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n/);
    if (frontmatterMatch) {
      const frontmatter = frontmatterMatch[1];
      markdown = markdown.substring(frontmatterMatch[0].length);

      // Parse basic frontmatter (title, description, slug)
      const titleM = frontmatter.match(/title:\s*["']?(.*?)["']?$/m);
      if (titleM && titleInput && !titleInput.value) {
        titleInput.value = titleM[1];
      }
      const descM = frontmatter.match(/description:\s*["']?(.*?)["']?$/m);
      if (descM && excerptInput && !excerptInput.value) {
        excerptInput.value = descM[1];
      }
      const slugM = frontmatter.match(/slug:\s*["']?(.*?)["']?$/m);
      if (slugM && slugInput && !slugInput.value) {
        slugInput.value = slugM[1];
      }
    }

    // Check if the document has a top-level # H1 heading to initialize article title if not set
    const h1Match = markdown.match(/^#\s+(.+)$/m);
    if (h1Match) {
      const detectedH1 = h1Match[1].trim();
      if (titleInput && !titleInput.value) {
        titleInput.value = detectedH1;
      }
    } else if (!titleInput?.value && fileName) {
      // Use filename without extension as default title if title is blank
      const cleanName = fileName.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
      if (titleInput) titleInput.value = cleanName;
    }

    // Parse Markdown to semantic HTML and sanitize
    const rawHtml = marked.parse(markdown) as string;
    const safeHtml = DOMPurify.sanitize(rawHtml, DOMPURIFY_CONFIG);

    // Populate Visual Editor & Markdown Textarea
    editor.commands.setContent(safeHtml);
    if (markdownTextarea) {
      markdownTextarea.value = markdown;
      updateLineNumbers();
    }

    isDirty = true;
    updateMetrics();
    updateSerp();
    updateDocumentOutline();
    triggerAutosave();

    alert('Markdown article successfully imported!');
  }

  // 2. Export / Download Article as .md
  document.getElementById('opt-export-md')?.addEventListener('click', () => {
    let mdContent = '';
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      mdContent = markdownTextarea.value;
    } else {
      mdContent = turndownService.turndown(editor.getHTML());
    }

    const title = titleInput?.value.trim() || 'Untitled Article';
    const excerpt = excerptInput?.value.trim() || '';
    const slug = slugInput?.value.trim() || slugify(title);

    // Prepend standard clean Markdown metadata
    const fullMarkdownDoc = `---
title: "${title}"
slug: "${slug}"
description: "${excerpt}"
date: "${new Date().toISOString()}"
---

# ${title}

${mdContent}
`;

    const blob = new Blob([fullMarkdownDoc], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${slug || 'article'}.md`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  });

