  function updateBlockSettingsSidebar() {
    const emptyBox = document.getElementById('block-settings-empty');
    const activeBox = document.getElementById('block-settings-active');
    const blockName = document.getElementById('active-block-name');
    const blockTag = document.getElementById('active-block-tag');

