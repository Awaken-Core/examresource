      if (aiResHSlug) aiResHSlug.textContent = `/${data.hinglish?.slug || ''}`;
      if (aiResHWords) {
        const hw = (data.hinglish?.content || '').trim().split(/\s+/).length;
        aiResHWords.textContent = `${hw} words`;
