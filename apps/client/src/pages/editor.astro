  function duplicateOutlineBlock(pos: number) {
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const lines = markdownTextarea.value.split('\n');
      if (!lines[pos]) return;
      lines.splice(pos, 0, lines[pos]);
      markdownTextarea.value = lines.join('\n');
      markdownTextarea.dispatchEvent(new Event('input', { bubbles: true }));
      return;
    }
    const node = editor.state.doc.nodeAt(pos);
    if (!node) return;
    editor.view.dispatch(editor.state.tr.insert(pos + node.nodeSize, node));
  }

  function deleteOutlineBlock(pos: number) {
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const lines = markdownTextarea.value.split('\n');
      if (!lines[pos]) return;
      lines.splice(pos, 1);
      markdownTextarea.value = lines.join('\n');
      markdownTextarea.dispatchEvent(new Event('input', { bubbles: true }));
      return;
    }
    const node = editor.state.doc.nodeAt(pos);
    if (!node) return;
    editor.view.dispatch(editor.state.tr.delete(pos, pos + node.nodeSize));
  }

  // Document Outline / List View Update
  function updateDocumentOutline() {
    const tree = document.getElementById('outline-tree-container');
    const outlineWord = document.getElementById('outline-word-stat');
    const outlineChar = document.getElementById('outline-char-stat');
    const outlineHeadings = document.getElementById('outline-headings-stat');

    let text = '';
    const items: { text: string; id: string; level: number; pos: number }[] = [];

    if (currentEditorMode === 'markdown' && markdownTextarea) {
      text = markdownTextarea.value;
      const lines = text.split('\n');
      lines.forEach((l, idx) => {
        const m = l.match(/^(#{1,4})\s+(.+)$/);
        if (m) {
          const headingText = m[2].trim().replace(/\\+/g, '');
          items.push({
            level: m[1].length,
            text: headingText,
            id: slugify(headingText),
            pos: idx,
          });
        }
      });
    } else {
      text = editor.getText();
      editor.state.doc.descendants((node, pos) => {
        if (node.type.name === 'heading') {
          const headingText = (node.textContent || 'Untitled Heading').replace(/\\+/g, '');
          items.push({
            text: headingText,
            id: slugify(headingText),
            level: node.attrs.level,
            pos,
          });
        }
      });
    }

    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    if (outlineWord) outlineWord.textContent = `${words}`;
    if (outlineChar) outlineChar.textContent = `${text.length}`;
    if (outlineHeadings) outlineHeadings.textContent = `${items.length}`;

    if (!tree) return;
    if (items.length === 0) {
      tree.innerHTML = `<p class="text-slate-400 text-center py-6 text-xs">No headings created yet. Add H2, H3, or H4 to populate the outline.</p>`;
      return;
    }

    tree.innerHTML = items.map((h) => `
      <div 
        class="outline-item group flex items-center justify-between gap-1 p-2 rounded hover:bg-slate-50 cursor-pointer text-slate-800 transition"
        style="padding-left: ${Math.max(8, (h.level - 2) * 16 + 8)}px"
        data-pos="${h.pos}"
      >
        <div class="flex items-center gap-1.5 min-w-0">
          <span class="font-mono text-[10px] text-slate-400 font-bold uppercase">H${h.level}</span>
          <span class="truncate font-medium text-xs">${h.text.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>
        </div>
        <div class="flex items-center shrink-0">
          <button type="button" class="outline-duplicate p-1 rounded hover:bg-white text-slate-500 hover:text-slate-800" title="Duplicate block" aria-label="Duplicate block">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="8" y="8" width="12" height="12" rx="2" /><path stroke-linecap="round" d="M4 16V6a2 2 0 012-2h10" /></svg>
          </button>
          <button type="button" class="outline-delete p-1 rounded hover:bg-white text-slate-500 hover:text-red-600" title="Delete block" aria-label="Delete block">
