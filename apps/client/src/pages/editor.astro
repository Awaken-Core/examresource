  // Insert standard blocks
  function insertBlock(type: string, targetPos?: number | null) {
    if (currentEditorMode === 'markdown') {
      // In markdown mode, insert markdown snippet
      insertMarkdownSnippet(type);
      inserterDrawer?.classList.add('hidden');
      return;
    }

    if (!editor) return;

    if (typeof targetPos === 'number') {
      // Inline block insertion at specific position without replacing content
      editor.commands.setTextSelection(targetPos);
      let content = '<p></p>';
      if (type === 'paragraph') content = '<p></p>';
      else if (type === 'h2') content = '<h2></h2>';
      else if (type === 'h3') content = '<h3></h3>';
      else if (type === 'h4') content = '<h4></h4>';
      else if (type === 'bulletList') content = '<ul><li></li></ul>';
      else if (type === 'orderedList') content = '<ol><li></li></ol>';
      else if (type === 'blockquote') content = '<blockquote><p></p></blockquote>';
      else if (type === 'codeBlock') content = '<pre><code></code></pre>';
      else if (type === 'divider') content = '<hr><p></p>';
      else if (type === 'table') {
        editor.chain().focus().insertContentAt(targetPos, '<p></p>').run();
        editor.commands.setTextSelection(targetPos);
        editor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run();
        inserterDrawer?.classList.add('hidden');
        return;
      } else if (type === 'image') {
        openArticleImageModal(targetPos);
        return;
      } else if (type === 'video') {
        const url = prompt('Enter video embed URL (YouTube or direct embed URL):');
        if (url) {
          content = `<div class="aspect-video my-4"><iframe src="${url}" class="w-full h-full rounded-lg" allowfullscreen></iframe></div><p></p>`;
        } else {
          return;
        }
      } else if (type === 'callout') {
        content = `<div class="callout p-4 my-4 rounded-lg bg-blue-50/40 border-l-4 border-blue-500 text-slate-800 text-sm leading-relaxed"><p><strong>Important Note:</strong> Enter notice or advisory details here.</p></div><p></p>`;
      }

      editor.chain().focus().insertContentAt(targetPos, content).run();
      inserterDrawer?.classList.add('hidden');
      return;
    }

    editor.chain().focus();

    if (type === 'paragraph') editor.chain().focus().setParagraph().run();
    else if (type === 'h2') editor.chain().focus().toggleHeading({ level: 2 }).run();
    else if (type === 'h3') editor.chain().focus().toggleHeading({ level: 3 }).run();
    else if (type === 'h4') editor.chain().focus().toggleHeading({ level: 4 }).run();
    else if (type === 'bulletList') editor.chain().focus().toggleBulletList().run();
    else if (type === 'orderedList') editor.chain().focus().toggleOrderedList().run();
    else if (type === 'blockquote') editor.chain().focus().toggleBlockquote().run();
    else if (type === 'codeBlock') editor.chain().focus().toggleCodeBlock().run();
    else if (type === 'divider') editor.chain().focus().setHorizontalRule().run();
    else if (type === 'table') {
      editor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run();
    } else if (type === 'image') {
      openArticleImageModal();
    } else if (type === 'video') {
      const url = prompt('Enter video embed URL (YouTube or direct embed URL):');
      if (url) {
        editor.chain().focus().insertContent(`<div class="aspect-video my-4"><iframe src="${url}" class="w-full h-full rounded-lg" allowfullscreen></iframe></div><p></p>`).run();
      }
    } else if (type === 'callout') {
      editor.chain().focus().insertContent(`<div class="callout p-4 my-4 rounded-lg bg-blue-50/40 border-l-4 border-blue-500 text-slate-800 text-sm leading-relaxed"><p><strong>Important Note:</strong> Enter notice or advisory details here.</p></div><p></p>`).run();
    } else if (type === 'toc') {
      insertTableOfContentsBlock();
    }

    inserterDrawer?.classList.add('hidden');
    editor.chain().focus().run();
  }

  function insertMarkdownSnippet(type: string) {
    if (!markdownTextarea) return;
    let snippet = '';
    if (type === 'paragraph') snippet = '\n\nParagraph text goes here.\n\n';
    else if (type === 'h2') snippet = '\n\n## Section Heading\n\n';
    else if (type === 'h3') snippet = '\n\n### Subheading\n\n';
    else if (type === 'h4') snippet = '\n\n#### Smaller Heading\n\n';
    else if (type === 'bulletList') snippet = '\n\n- First item\n- Second item\n- Third item\n\n';
    else if (type === 'orderedList') snippet = '\n\n1. First step\n2. Second step\n3. Third step\n\n';
    else if (type === 'blockquote') snippet = '\n\n> This is an important note.\n\n';
    else if (type === 'codeBlock') snippet = '\n\n```typescript\nconst message: string = "Hello World";\n```\n\n';
    else if (type === 'divider') snippet = '\n\n---\n\n';
    else if (type === 'table') snippet = '\n\n| Column 1 | Column 2 | Column 3 |\n| --- | --- | --- |\n| Data 1 | Data 2 | Data 3 |\n\n';
    else if (type === 'image') snippet = '\n\n![Descriptive image alt text](https://example.com/image.png)\n\n';

    const start = markdownTextarea.selectionStart;
    const end = markdownTextarea.selectionEnd;
    const val = markdownTextarea.value;
    markdownTextarea.value = val.substring(0, start) + snippet + val.substring(end);
    markdownTextarea.selectionStart = markdownTextarea.selectionEnd = start + snippet.length;
    markdownTextarea.focus();
    updateLineNumbers();
    isDirty = true;
    triggerAutosave();
  }

  document.querySelectorAll<HTMLButtonElement>('.insert-block-btn').forEach((btn) => {
