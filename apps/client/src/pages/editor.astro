  // Language Switcher Logic (Allows seamless switching between Hindi & English in Visual and Markdown modes)
  function syncCurrentEditorToState() {
    const currentLang = languageSelect?.value === 'ENGLISH' ? 'ENGLISH' : 'HINGLISH';
    let md = '';
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      md = markdownTextarea.value;
