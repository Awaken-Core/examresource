  // Core Save Article Function (Draft & Publish)
  async function saveArticle(targetStatus?: string, isAutosave = false) {
    const title = titleInput?.value.trim();
    const slug = slugInput?.value.trim() || slugify(title || 'untitled');

    if (!title) {
      if (!isAutosave) alert('Please enter an article title before saving.');
      return;
    }

    const effectiveStatus = targetStatus || statusSelect?.value || 'DRAFT';

    // Get current HTML content regardless of active mode
    let effectiveHtml = '';
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const rawHtml = marked.parse(markdownTextarea.value) as string;
      effectiveHtml = DOMPurify.sanitize(rawHtml, DOMPURIFY_CONFIG);
    } else {
      effectiveHtml = editor.getHTML();
    }

    const payload = {
      title,
      slug,
      description: excerptInput?.value.trim() || null,
      coverImage: coverImageInput?.value.trim() || null,
      imageAlt: imageAltInput?.value.trim() || null,
      imageCaption: imageCaptionInput?.value.trim() || null,
      categoryId: categorySelect?.value || null,
      metaTitle: metaTitleInput?.value.trim() || null,
      metaDescription: metaDescInput?.value.trim() || null,
      canonicalUrl: canonicalUrlInput?.value.trim() || null,
      scheduledAt: scheduledAtInput?.value ? new Date(scheduledAtInput.value).toISOString() : null,
      noindex: noindexCheckbox?.checked ?? false,
      status: effectiveStatus,
      htmlContent: effectiveHtml,
      currentVersion,
    };

    try {
      if (saveStatusEl) {
        saveStatusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span><span>Saving...</span>`;
      }

      let res: Response;
      if (currentPostId) {
        res = await apiFetch(`/blogs/${currentPostId}`, {
          method: 'PATCH',
          body: JSON.stringify(payload),
        });
      } else {
        res = await apiFetch('/blogs', {
          method: 'POST',
          body: JSON.stringify(payload),
        });
      }

      if (res.ok) {
        const saved = await res.json();
        currentPostId = saved.id;
        currentVersion = saved.version;
        isDirty = false;
        if (statusSelect) statusSelect.value = saved.status || effectiveStatus;
        if (docVersionDisplay) docVersionDisplay.textContent = `${saved.version}`;
        if (docLastSavedTime) docLastSavedTime.textContent = `Saved at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

        if (saveStatusEl) {
          saveStatusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Saved</span>`;
        }

        if (!editId && saved.id) {
          window.history.replaceState({}, '', `/editor?edit=${saved.id}`);
        }
      } else if (res.status === 409) {
        const err = await res.json();
        alert(`Version Conflict: ${err.message}`);
      } else {
        const err = await res.json();
        alert(`Error saving article: ${err.message || 'Validation error'}`);
      }
    } catch (e: any) {
      console.error(e);
    }
  }

  document.getElementById('save-draft-btn')?.addEventListener('click', () => {
    if (statusSelect) statusSelect.value = 'DRAFT';
    saveArticle('DRAFT');
  });

  document.getElementById('publish-btn')?.addEventListener('click', () => {
    if (!categorySelect?.value) {
      alert('Please select a Blog Category before publishing.');
      return;
    }
    if (statusSelect) statusSelect.value = 'PUBLISHED';
    saveArticle('PUBLISHED');
  });

  // Duplicate Article
  document.getElementById('opt-duplicate')?.addEventListener('click', async () => {
    if (!currentPostId) {
      alert('Please save the article first before duplicating.');
      return;
    }
    const res = await apiFetch(`/blogs/${currentPostId}/duplicate`, { method: 'POST' });
    if (res.ok) {
      const duplicated = await res.json();
      window.location.href = `/editor?edit=${duplicated.id}`;
    } else {
      alert('Failed to duplicate article.');
    }
  });

  // Revisions Modal
  const revModal = document.getElementById('revisions-modal');
  document.getElementById('opt-revisions')?.addEventListener('click', async () => {
    if (!currentPostId) {
      alert('Save your article first to view revision history.');
      return;
    }
    const res = await apiFetch(`/blogs/${currentPostId}/revisions`);
    const listEl = document.getElementById('revisions-list');
    if (res.ok && listEl) {
      const revs = await res.json();
      if (revs.length === 0) {
        listEl.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">No past revisions recorded.</p>';
      } else {
        listEl.innerHTML = revs.map((r: any) => `
          <div class="p-2.5 rounded border border-slate-200 bg-slate-50 flex items-center justify-between text-xs">
            <div>
              <span class="font-bold text-slate-900">v${r.version}: ${r.title}</span>
              <span class="block text-[10px] text-slate-400">${new Date(r.createdAt).toLocaleString()}</span>
            </div>
            <button class="restore-rev-btn px-2 py-1 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded text-[11px] font-semibold" data-id="${r.id}">
              Restore
            </button>
          </div>
        `).join('');

        document.querySelectorAll<HTMLButtonElement>('.restore-rev-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            if (!confirm('Restore this revision snapshot?')) return;
            const revId = btn.dataset.id;
            const restoreRes = await apiFetch(`/blogs/${currentPostId}/revisions/${revId}/restore`, { method: 'POST' });
            if (restoreRes.ok) {
              window.location.reload();
            }
          });
        });
      }
    }
    revModal?.classList.remove('hidden');
    revModal?.classList.add('flex');
  });

  document.getElementById('close-revisions-modal')?.addEventListener('click', () => {
    revModal?.classList.add('hidden');
    revModal?.classList.remove('flex');
  });

  // Quick Category Creator
  const quickCatModal = document.getElementById('quick-category-modal');
  const openQuickCatBtn = document.getElementById('open-create-category-modal');
  const closeQuickCatBtn = document.getElementById('close-quick-cat-modal');
  const cancelQuickCatBtn = document.getElementById('cancel-quick-cat-modal');
  const quickCatForm = document.getElementById('quick-cat-form');
  const quickCatName = document.getElementById('quick-cat-name') as HTMLInputElement | null;
  const quickCatSlug = document.getElementById('quick-cat-slug') as HTMLInputElement | null;
  const quickCatDesc = document.getElementById('quick-cat-desc') as HTMLTextAreaElement | null;
  const quickCatError = document.getElementById('quick-cat-error');
  const saveQuickCatBtn = document.getElementById('save-quick-cat-btn') as HTMLButtonElement | null;

  openQuickCatBtn?.addEventListener('click', () => {
    quickCatError?.classList.add('hidden');
    if (quickCatName) quickCatName.value = '';
    if (quickCatSlug) quickCatSlug.value = '';
    if (quickCatDesc) quickCatDesc.value = '';
    quickCatModal?.classList.remove('hidden');
    quickCatModal?.classList.add('flex');
    quickCatName?.focus();
  });

  function closeQuickCategoryModal() {
    quickCatModal?.classList.add('hidden');
    quickCatModal?.classList.remove('flex');
  }

  closeQuickCatBtn?.addEventListener('click', closeQuickCategoryModal);
  cancelQuickCatBtn?.addEventListener('click', closeQuickCategoryModal);

  quickCatName?.addEventListener('input', () => {
    if (quickCatSlug) quickCatSlug.value = slugify(quickCatName.value);
  });

  quickCatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = quickCatName?.value.trim();
    const slug = slugify(quickCatSlug?.value.trim() || name || '');
    const description = quickCatDesc?.value.trim() || null;

    if (!name || !slug) return;
    if (saveQuickCatBtn) {
      saveQuickCatBtn.disabled = true;
      saveQuickCatBtn.textContent = 'Creating...';
    }

    try {
      const res = await apiFetch('/categories', {
        method: 'POST',
        body: JSON.stringify({ name, slug, description }),
      });

      if (res.ok) {
        const createdCat = await res.json();
        categoriesCache.push(createdCat);
        if (categorySelect) {
          const opt = document.createElement('option');
          opt.value = createdCat.id;
          opt.textContent = createdCat.name;
          opt.selected = true;
          categorySelect.appendChild(opt);
          categorySelect.value = createdCat.id;
        }
        closeQuickCategoryModal();
        updateSerp();
      } else {
        const err = await res.json().catch(() => ({}));
        if (quickCatError) {
          quickCatError.textContent = err.message || 'Failed to create category.';
          quickCatError.classList.remove('hidden');
        }
      }
    } catch (_) {
      if (quickCatError) {
        quickCatError.textContent = 'Network error while creating category.';
        quickCatError.classList.remove('hidden');
      }
    } finally {
      if (saveQuickCatBtn) {
        saveQuickCatBtn.disabled = false;
        saveQuickCatBtn.textContent = 'Create Category';
      }
    }
  });

  // Public Layout Live Preview Modal & Markdown Preview Handler
  const previewModal = document.getElementById('live-preview-modal');
  document.getElementById('preview-btn')?.addEventListener('click', () => {
    // If in Markdown Editor mode, trigger the dedicated reading-layout preview surface
    if (currentEditorMode === 'markdown') {
      showMarkdownPreview();
      return;
    }

    // In Visual Editor mode, open the public layout modal preview
    const title = titleInput?.value || 'Untitled Article';
    const excerpt = excerptInput?.value || '';
    const cat = categorySelect?.options[categorySelect.selectedIndex]?.text || 'General';

    const modalTitle = document.getElementById('prev-modal-title');
    const modalCat = document.getElementById('prev-modal-cat');
    const modalExcerpt = document.getElementById('prev-modal-excerpt');
    const modalContent = document.getElementById('prev-modal-content');
    const modalCoverBox = document.getElementById('prev-modal-cover-box');
    const modalCoverImg = document.getElementById('prev-modal-cover-img') as HTMLImageElement | null;
    const modalCoverCaption = document.getElementById('prev-modal-cover-caption');

    if (modalTitle) modalTitle.textContent = title;
    if (modalCat) modalCat.textContent = cat;
    if (modalExcerpt) modalExcerpt.textContent = excerpt;

    if (modalContent) modalContent.innerHTML = editor.getHTML();

    const coverUrl = coverImageInput?.value.trim();
    if (coverUrl && modalCoverBox && modalCoverImg) {
      modalCoverImg.src = coverUrl;
      modalCoverImg.alt = imageAltInput?.value || title;
      if (modalCoverCaption) modalCoverCaption.textContent = imageCaptionInput?.value || '';
      modalCoverBox.classList.remove('hidden');
    } else if (modalCoverBox) {
      modalCoverBox.classList.add('hidden');
    }

    previewModal?.classList.remove('hidden');
    previewModal?.classList.add('flex');
  });

  document.getElementById('close-preview-modal')?.addEventListener('click', () => {
    previewModal?.classList.add('hidden');
    previewModal?.classList.remove('flex');
  });

  // Document Overview Trigger
  document.getElementById('document-overview-trigger')?.addEventListener('click', () => {
    outlineDrawer?.classList.remove('hidden');
    updateDocumentOutline();
  });

  // Helper Slugify
  function slugify(text: string): string {
    return text.toLowerCase().trim().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-');
  }

  // Initialization
  async function init() {
    // 1. Categories
    const catRes = await apiFetch('/categories');
    if (catRes.ok) {
      categoriesCache = await catRes.json();
      if (categorySelect) {
        categorySelect.innerHTML = '<option value="">Select a blog category...</option>' + 
          categoriesCache.map((c: any) => `<option value="${c.id}">${c.name}</option>`).join('');
      }
    }

    // 2. Fetch existing post if editing
    if (editId) {
      const res = await apiFetch(`/me/blogs/${editId}`);
      if (res.ok) {
        const post = await res.json();
        currentVersion = post.version;
        if (titleInput) titleInput.value = post.title || '';
        if (slugInput) slugInput.value = post.slug || '';
        if (excerptInput) excerptInput.value = post.description || '';
        if (categorySelect && post.categoryId) categorySelect.value = post.categoryId;
        if (statusSelect && post.status) {
          statusSelect.value = post.status;
          if (post.status === 'SCHEDULED') scheduleDateGroup?.classList.remove('hidden');
        }
        if (metaTitleInput) metaTitleInput.value = post.metaTitle || '';
        if (metaDescInput) metaDescInput.value = post.metaDescription || '';
        if (coverImageInput) coverImageInput.value = post.coverImage || '';
        if (imageAltInput) imageAltInput.value = post.imageAlt || '';
        if (imageCaptionInput) imageCaptionInput.value = post.imageCaption || '';
        if (canonicalUrlInput) canonicalUrlInput.value = post.canonicalUrl || '';
        if (noindexCheckbox) noindexCheckbox.checked = post.noindex ?? false;
        if (scheduledAtInput && post.scheduledAt) {
          scheduledAtInput.value = new Date(post.scheduledAt).toISOString().slice(0, 16);
        }

        const authorDisplay = document.getElementById('author-name-display');
        if (authorDisplay && post.author?.name) {
          authorDisplay.textContent = post.author.name;
        }

        if (docVersionDisplay) docVersionDisplay.textContent = `${post.version}`;

        if (post.htmlContent) {
          editor.commands.setContent(post.htmlContent);
          if (markdownTextarea) {
            markdownTextarea.value = turndownService.turndown(post.htmlContent);
            updateLineNumbers();
          }
        }
      }
    }

    updateMetrics();
    updateSerp();
    updateDocumentOutline();
  }

  init();
</script>
