  // Core Save Article Function (Draft & Publish)
  async function saveArticle(targetStatus?: string, isAutosave = false) {
    const saveDraftBtn = document.getElementById('save-draft-btn') as HTMLButtonElement | null;
    const saveDraftSpinner = document.getElementById('save-draft-spinner');
    const saveDraftLabel = document.getElementById('save-draft-label');
    const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement | null;
    const publishSpinner = document.getElementById('publish-spinner');
    const publishLabel = document.getElementById('publish-label');

    const effectiveStatus = targetStatus || statusSelect?.value || 'DRAFT';
    const isPublishing = effectiveStatus === 'PUBLISHED';

    if (!isAutosave) {
      if (isPublishing) {
        publishSpinner?.classList.remove('hidden');
        publishBtn?.setAttribute('disabled', 'true');
        if (publishLabel) publishLabel.textContent = currentPostId ? 'Updating...' : 'Publishing...';
      } else {
        saveDraftSpinner?.classList.remove('hidden');
        saveDraftBtn?.setAttribute('disabled', 'true');
        if (saveDraftLabel) saveDraftLabel.textContent = 'Saving...';
      }
    }

    try {
      syncCurrentEditorToState();

      // If both Hinglish and English drafts exist, delegate to saveBilingualBlogs so neither is lost
      const hasBothBilingual = Boolean(
        compareHinglishMarkdown?.value.trim() &&
        compareEnglishMarkdown?.value.trim() &&
        compareHinglishTitle?.value.trim() &&
        compareEnglishTitle?.value.trim()
      );
      if (hasBothBilingual && (currentEditorMode === 'compare' || !currentPostId)) {
        await saveBilingualBlogs();
        return;
      }

      let title = titleInput?.value.trim();
      if (!title && currentEditorMode === 'compare') {
        title = languageSelect?.value === 'ENGLISH'
          ? (compareEnglishTitle?.value.trim() || '')
          : (compareHinglishTitle?.value.trim() || '');
        if (titleInput && title) titleInput.value = title;
      }
      let slug = slugInput?.value.trim();
      if (!slug && currentEditorMode === 'compare') {
        slug = languageSelect?.value === 'ENGLISH'
          ? (compareEnglishSlug?.value.trim() || '')
          : (compareHinglishSlug?.value.trim() || '');
        if (slugInput && slug) slugInput.value = slug;
      }
      slug = slug || slugify(title || 'untitled');

      if (!title) {
        if (!isAutosave) alert('Please enter an article title before saving.');
        return;
      }

      await imageUploadChain;
      try {
        await replaceLocalImagesInEditor();
      } catch (error) {
        if (!isAutosave) alert(error instanceof Error ? error.message : 'Image upload failed.');
        return;
      }

      // Get current HTML content regardless of active mode
      let effectiveHtml = '';
      if (currentEditorMode === 'markdown' && markdownTextarea) {
        const rawHtml = await marked.parse(markdownTextarea.value);
        effectiveHtml = DOMPurify.sanitize(String(rawHtml), DOMPURIFY_CONFIG);
      } else if (currentEditorMode === 'compare') {
        const activeMd = languageSelect?.value === 'ENGLISH'
          ? (compareEnglishMarkdown?.value || '')
          : (compareHinglishMarkdown?.value || '');
        const rawHtml = await marked.parse(activeMd);
        effectiveHtml = DOMPurify.sanitize(String(rawHtml), DOMPURIFY_CONFIG);
      } else {
        effectiveHtml = editor.getHTML();
        if ((!effectiveHtml || effectiveHtml === '<p></p>') && markdownTextarea?.value.trim()) {
          const rawHtml = await marked.parse(markdownTextarea.value);
          effectiveHtml = DOMPurify.sanitize(String(rawHtml), DOMPURIFY_CONFIG);
        }
      }

      const payload = {
        title,
        slug,
        description: excerptInput?.value.trim() || null,
        coverImage: coverImageInput?.value.trim() || null,
        imageAlt: imageAltInput?.value.trim() || null,
        imageCaption: imageCaptionInput?.value.trim() || null,
        categoryId: categorySelect?.value || null,
        metaTitle: metaTitleInput?.value.trim() || null,
        metaDescription: metaDescInput?.value.trim() || null,
        canonicalUrl: canonicalUrlInput?.value.trim() || null,
        scheduledAt: scheduledAtInput?.value ? new Date(scheduledAtInput.value).toISOString() : null,
        noindex: noindexCheckbox?.checked ?? false,
        language: languageSelect?.value || 'HINGLISH',
        translationGroupId: currentTranslationGroupId || undefined,
        ...((document.getElementById('field-author') as HTMLSelectElement | null)?.value
          ? { authorId: (document.getElementById('field-author') as HTMLSelectElement).value }
          : {}),
        tagIds: [...document.querySelectorAll<HTMLInputElement>('#field-tags input:checked')].map((input) => input.value),
        status: effectiveStatus,
        htmlContent: effectiveHtml,
        currentVersion,
      };

      if (saveStatusEl) {
        saveStatusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span><span>Saving...</span>`;
      }

      let res: Response;
      if (currentPostId) {
        res = await apiFetch(`/blogs/${currentPostId}`, {
          method: 'PATCH',
          body: JSON.stringify(payload),
        });
      } else {
        res = await apiFetch('/blogs', {
          method: 'POST',
          body: JSON.stringify(payload),
        });
      }

      if (res.ok) {
        const saved = await res.json();
        currentPostId = saved.id;
        currentVersion = saved.version;
        isDirty = false;
        if (saved.translationGroupId) currentTranslationGroupId = saved.translationGroupId;
        if (saved.language === 'ENGLISH') englishBlogId = saved.id;
        else if (saved.language === 'HINGLISH') hinglishBlogId = saved.id;

        if (statusSelect) statusSelect.value = saved.status || effectiveStatus;
        if (docVersionDisplay) docVersionDisplay.textContent = `${saved.version}`;
        if (docLastSavedTime) docLastSavedTime.textContent = `Saved at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

        if (saveStatusEl) {
          saveStatusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Saved</span>`;
        }

        if (!editId && saved.id) {
          window.history.replaceState({}, '', `/editor?edit=${saved.id}`);
        }
      } else if (res.status === 409) {
        const err = await res.json();
        alert(`Version Conflict: ${err.message}`);
      } else {
        const err = await res.json();
        alert(`Error saving article: ${err.message || 'Validation error'}`);
      }
    } catch (e: any) {
      console.error(e);
    } finally {
      if (!isAutosave) {
        if (isPublishing) {
          publishSpinner?.classList.add('hidden');
          publishBtn?.removeAttribute('disabled');
          if (publishLabel) publishLabel.textContent = (statusSelect?.value === 'PUBLISHED' || currentPostId) ? 'Update' : 'Publish';
        } else {
          saveDraftSpinner?.classList.add('hidden');
          saveDraftBtn?.removeAttribute('disabled');
          if (saveDraftLabel) saveDraftLabel.textContent = 'Save Draft';
        }
      }
    }
  }

