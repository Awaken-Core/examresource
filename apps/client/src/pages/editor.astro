  function selectedImageLayout() {
    const select = document.getElementById('article-image-width') as HTMLSelectElement | null;
    const value = select?.value;
    if (value === 'content' || value === 'wide' || value === 'full') return value;
    return 'custom';
  }

  function selectedImageWidth() {
    const layout = selectedImageLayout();
    if (layout === 'content') return 620;
    if (layout === 'wide') return 1440;
    if (layout === 'full') return null;
    const custom = Number((document.getElementById('article-image-width-custom') as HTMLInputElement | null)?.value);
    return Number.isFinite(custom) && custom >= 80 ? Math.round(custom) : null;
  }

  function insertBlock(type: string, targetPos?: number | null) {
    blockInsertTargetPos = typeof targetPos === 'number' ? targetPos : null;

    if (currentEditorMode === 'markdown') {
      if (type === 'image') {
        openArticleImageModal(targetPos);
        return;
      } else if (type === 'table') {
        openTableModal(targetPos);
        return;
      } else if (type === 'codeBlock') {
        openCodeModal(targetPos);
        return;
      } else if (type === 'callout') {
        openCalloutModal(targetPos);
        return;
      } else if (type === 'video') {
        openVideoModal(targetPos);
        return;
      }
      insertMarkdownSnippet(type);
      inserterDrawer?.classList.add('hidden');
      return;
    }

    if (!editor) return;

    // Rich Text / Visual Mode Block Insertion
    if (type === 'image') {
      openArticleImageModal(targetPos);
      return;
    } else if (type === 'table') {
      openTableModal(targetPos);
      return;
    } else if (type === 'codeBlock') {
      openCodeModal(targetPos);
      return;
    } else if (type === 'callout') {
      openCalloutModal(targetPos);
      return;
    } else if (type === 'video') {
      openVideoModal(targetPos);
      return;
    } else if (type === 'toc') {
      insertTableOfContentsBlock(targetPos);
      inserterDrawer?.classList.add('hidden');
      return;
    }

    if (typeof targetPos === 'number') {
      editor.commands.setTextSelection(targetPos);
      let content = '<p></p>';
      if (type === 'paragraph') content = '<p></p>';
      else if (type === 'h2') content = '<h2></h2>';
      else if (type === 'h3') content = '<h3></h3>';
      else if (type === 'h4') content = '<h4></h4>';
      else if (type === 'bulletList') content = `<ul data-bullet="${selectedBulletStyle()}"><li></li></ul>`;
      else if (type === 'orderedList') content = '<ol><li></li></ol>';
      else if (type === 'blockquote') content = '<blockquote><p></p></blockquote>';
      else if (type === 'divider') content = '<hr><p></p>';
      else if (type === 'spacer') content = '<p><br></p>';

      editor.chain().focus().insertContentAt(targetPos, content).run();
      inserterDrawer?.classList.add('hidden');
      return;
    }

    // Default cursor insertion: insert immediately after or at selection without deleting existing content
    editor.chain().focus();

    if (type === 'paragraph') editor.chain().focus().setParagraph().run();
    else if (type === 'h2') editor.chain().focus().toggleHeading({ level: 2 }).run();
    else if (type === 'h3') editor.chain().focus().toggleHeading({ level: 3 }).run();
    else if (type === 'h4') editor.chain().focus().toggleHeading({ level: 4 }).run();
    else if (type === 'bulletList') editor.chain().focus().toggleBulletList().updateAttributes('bulletList', { bullet: selectedBulletStyle() }).run();
    else if (type === 'orderedList') editor.chain().focus().toggleOrderedList().run();
    else if (type === 'blockquote') editor.chain().focus().toggleBlockquote().run();
    else if (type === 'divider') editor.chain().focus().setHorizontalRule().run();
    else if (type === 'spacer') editor.chain().focus().insertContent('<p><br></p>').run();

    inserterDrawer?.classList.add('hidden');
    editor.chain().focus().run();
  }

  function insertMarkdownSnippet(type: string, customSnippet?: string) {
    if (!markdownTextarea) return;
    let snippet = customSnippet || '';
    if (!snippet) {
      if (type === 'paragraph') snippet = '\n\nParagraph text goes here.\n\n';
      else if (type === 'h2') snippet = '\n\n## Section Heading\n\n';
      else if (type === 'h3') snippet = '\n\n### Subheading\n\n';
      else if (type === 'h4') snippet = '\n\n#### Smaller Heading\n\n';
      else if (type === 'bulletList') {
        const bullet = selectedBulletStyle();
        snippet = bullet === 'disc'
          ? '\n\n- First item\n- Second item\n- Third item\n\n'
          : `\n\n<ul data-bullet="${bullet}">\n<li>First item</li>\n<li>Second item</li>\n<li>Third item</li>\n</ul>\n\n`;
      }
      else if (type === 'orderedList') snippet = '\n\n1. First step\n2. Second step\n3. Third step\n\n';
      else if (type === 'blockquote') snippet = '\n\n> This is an important quote or note.\n\n';
      else if (type === 'divider') snippet = '\n\n---\n\n';
      else if (type === 'spacer') snippet = '\n\n&nbsp;\n\n';
      else if (type === 'table') snippet = '\n\n| Column 1 | Column 2 | Column 3 |\n| --- | --- | --- |\n| Item 1 | Item 2 | Item 3 |\n\n';
      else if (type === 'image') snippet = '\n\n![Image Alt](https://example.com/image.png)\n\n';
    }

    const start = markdownTextarea.selectionStart;
    const end = markdownTextarea.selectionEnd;
    const val = markdownTextarea.value;
    markdownTextarea.value = val.substring(0, start) + snippet + val.substring(end);
    markdownTextarea.selectionStart = markdownTextarea.selectionEnd = start + snippet.length;
    markdownTextarea.focus();
    updateLineNumbers();
    isDirty = true;
    triggerAutosave();
  }

