  // Block movement & manipulation
  document.getElementById('ctx-move-up-btn')?.addEventListener('click', () => {
    const { state, dispatch } = editor.view;
    const { $from } = state.selection;
    const currentPos = $from.before(1);
    const node = state.doc.nodeAt(currentPos);
    if (!node || currentPos === 0) return;

    let prevPos = 0;
    state.doc.forEach((n, offset) => {
      if (offset < currentPos) prevPos = offset;
    });

    const tr = state.tr;
    tr.delete(currentPos, currentPos + node.nodeSize);
    tr.insert(prevPos, node);
    dispatch(tr);
  });

  document.getElementById('ctx-move-down-btn')?.addEventListener('click', () => {
    const { state, dispatch } = editor.view;
    const { $from } = state.selection;
    const currentPos = $from.before(1);
    const node = state.doc.nodeAt(currentPos);
    if (!node) return;

    const nextPos = currentPos + node.nodeSize;
    if (nextPos >= state.doc.content.size) return;
    const nextNode = state.doc.nodeAt(nextPos);
    if (!nextNode) return;

    const tr = state.tr;
    tr.delete(currentPos, currentPos + node.nodeSize);
    tr.insert(currentPos + nextNode.nodeSize, node);
    dispatch(tr);
  });

  document.getElementById('ctx-duplicate-block-btn')?.addEventListener('click', duplicateSelectedBlock);

  function duplicateSelectedBlock() {
    const { state, dispatch } = editor.view;
    const { $from } = state.selection;
    const currentPos = $from.before(1);
    const node = state.doc.nodeAt(currentPos);
    if (!node) return;
    const tr = state.tr;
    tr.insert(currentPos + node.nodeSize, node);
    dispatch(tr);
  }

