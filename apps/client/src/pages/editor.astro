      emptyBox?.classList.add('hidden');
      activeBox?.classList.remove('hidden');
      if (blockName) blockName.textContent = 'Bullet List';
      if (blockTag) blockTag.textContent = 'UL';
      imgSec?.classList.add('hidden');
      listSec?.classList.remove('hidden');
      codeSec?.classList.add('hidden');
      headingSec?.classList.add('hidden');
      const bullet = editor.getAttributes('bulletList').bullet || 'disc';
      document.querySelectorAll<HTMLButtonElement>('.bullet-style-btn').forEach((btn) => {
        const selected = btn.dataset.bullet === bullet;
        btn.classList.toggle('border-blue-600', selected);
        btn.classList.toggle('bg-blue-50', selected);
        btn.classList.toggle('text-blue-700', selected);
      });
      const styleSelect = document.getElementById('bullet-style-select') as HTMLSelectElement | null;
      if (styleSelect) styleSelect.value = bullet;
    } else if (editor.isActive('codeBlock')) {
      emptyBox?.classList.add('hidden');
      activeBox?.classList.remove('hidden');
      if (blockName) blockName.textContent = 'Code Block';
      if (blockTag) blockTag.textContent = 'PRE';

      imgSec?.classList.add('hidden');
      listSec?.classList.add('hidden');
      codeSec?.classList.remove('hidden');
