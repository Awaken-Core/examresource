  // Helper Slugify
  function slugify(text: string): string {
    return text
      .toLowerCase()
      .trim()
      .replace(/\\+/g, '')
      .replace(/\s+/g, '-')
      .replace(/[^\p{L}\p{N}\s\-]+/gu, '')
      .replace(/\-\-+/g, '-')
      .replace(/(^-|-$)/g, '');
  }

  // Initialization

  function fillTags(selected: string[] = []) {
    const box = document.getElementById('field-tags');
    if (!box) return;
    box.replaceChildren();
    if (!tagCatalog.length) {
      const empty = document.createElement('p');
      empty.className = 'text-[11px] text-slate-400';
      empty.textContent = 'No tags yet';
      box.appendChild(empty);
      return;
    }
    for (const tag of tagCatalog) {
      const label = document.createElement('label');
      label.className = 'flex items-center gap-2 py-0.5 text-xs text-slate-700';
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.value = tag.id;
      input.checked = selected.includes(tag.id);
      label.append(input, document.createTextNode(tag.name));
      box.appendChild(label);
    }
  }

