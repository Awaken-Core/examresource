    const listSec = document.getElementById('block-settings-list');
    const codeSec = document.getElementById('block-settings-code');
    const headingSec = document.getElementById('block-settings-heading');

    if (!editor || currentEditorMode === 'markdown') return;

    if (editor.isActive('image')) {
      emptyBox?.classList.add('hidden');
      activeBox?.classList.remove('hidden');
      if (blockName) blockName.textContent = 'Image Block';
      if (blockTag) blockTag.textContent = 'IMG';

      imgSec?.classList.remove('hidden');
      listSec?.classList.add('hidden');
      codeSec?.classList.add('hidden');
      headingSec?.classList.add('hidden');

      const attrs = editor.getAttributes('image');
      const srcInput = document.getElementById('active-img-src') as HTMLInputElement | null;
      const altInput = document.getElementById('active-img-alt') as HTMLInputElement | null;
      const widthInput = document.getElementById('active-img-width') as HTMLInputElement | null;
      if (srcInput) srcInput.value = attrs.src || '';
      if (altInput) altInput.value = attrs.alt || '';
      if (widthInput) widthInput.value = attrs.width ? String(attrs.width) : '';
      document.querySelectorAll<HTMLButtonElement>('.active-image-align-btn').forEach((btn) => {
        const selected = btn.dataset.align === (attrs.align || 'center');
        btn.classList.toggle('border-blue-600', selected);
        btn.classList.toggle('bg-blue-50', selected);
        btn.classList.toggle('text-blue-700', selected);
      });
