  ];

  function renderSlashMenuItems() {
    if (!slashMenuItems) return;
    slashMenuItems.innerHTML = slashFilteredList.map((item, idx) => `
      <button 
        type="button" 
        class="slash-item w-full text-left px-2.5 py-1.5 rounded flex flex-col gap-0.5 text-xs transition ${idx === slashSelectedIndex ? 'bg-blue-50 text-blue-900 font-medium' : 'hover:bg-slate-100 text-slate-800'}" 
        data-idx="${idx}"
      >
        <span class="font-bold">${item.title}</span>
        <span class="text-[10px] ${idx === slashSelectedIndex ? 'text-blue-600' : 'text-slate-400'}">${item.desc}</span>
      </button>
    `).join('');

    const activeEl = slashMenuItems.querySelector(`[data-idx="${slashSelectedIndex}"]`) as HTMLElement | null;
    activeEl?.scrollIntoView({ block: 'nearest' });

    document.querySelectorAll<HTMLButtonElement>('.slash-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.idx);
        executeSlashItem(idx);
      });
      btn.addEventListener('mouseenter', () => {
        slashSelectedIndex = Number(btn.dataset.idx);
        renderSlashHighlight();
      });
    });
  }

  function renderSlashHighlight() {
    if (!slashMenuItems) return;
    const buttons = slashMenuItems.querySelectorAll<HTMLButtonElement>('.slash-item');
    buttons.forEach((btn, idx) => {
      if (idx === slashSelectedIndex) {
        btn.classList.add('bg-blue-50', 'text-blue-900', 'font-medium');
        btn.classList.remove('text-slate-800');
        const descEl = btn.querySelector('.text-\\[10px\\]');
        descEl?.classList.remove('text-slate-400');
        descEl?.classList.add('text-blue-600');
      } else {
        btn.classList.remove('bg-blue-50', 'text-blue-900', 'font-medium');
        btn.classList.add('text-slate-800');
        const descEl = btn.querySelector('.text-\\[10px\\]');
        descEl?.classList.remove('text-blue-600');
        descEl?.classList.add('text-slate-400');
      }
    });
    const activeEl = slashMenuItems.querySelector(`[data-idx="${slashSelectedIndex}"]`) as HTMLElement | null;
    activeEl?.scrollIntoView({ block: 'nearest' });
  }

  function executeSlashItem(index: number) {
    if (!slashFilteredList[index]) return;
    const { from } = editor.state.selection;
    const textBefore = editor.state.doc.textBetween(Math.max(0, from - 30), from, '\n', '\0');
    const match = textBefore.match(/\/([a-zA-Z0-9]*)$/);
    if (match) {
      editor.commands.deleteRange({ from: from - match[0].length, to: from });
    }
    const chosen = slashFilteredList[index];
    closeSlashMenu();
    chosen.action();
  }

  function openSlashMenu(filterQuery: string) {
    if (!slashMenuPopover || !slashMenuItems) return;
    slashFilteredList = slashOptions.filter(o => o.title.toLowerCase().includes(filterQuery) || o.desc.toLowerCase().includes(filterQuery));

    if (slashFilteredList.length === 0) {
      closeSlashMenu();
      return;
    }

    if (slashSelectedIndex >= slashFilteredList.length) {
      slashSelectedIndex = 0;
    }

    renderSlashMenuItems();

    const { from } = editor.state.selection;
    slashMenuPopover.classList.remove('hidden');
    isSlashMenuOpen = true;
    positionSlashMenu();
  }

  function positionSlashMenu() {
    if (!slashMenuPopover || !isSlashMenuOpen || !editor) return;
    const coords = editor.view.coordsAtPos(editor.state.selection.from);
    placeFloating(slashMenuPopover, coords, 256);
  }

  function closeSlashMenu() {
    slashMenuPopover?.classList.add('hidden');
    isSlashMenuOpen = false;
    slashSelectedIndex = 0;
  }

  function wordAtOffset(text: string, offset: number) {
    const re = /[\p{L}\p{N}_]+/gu;
    let match: RegExpExecArray | null;
    while ((match = re.exec(text))) {
      const start = match.index;
      const end = start + match[0].length;
      if (offset >= start && offset <= end) return match[0];
    }
    return '';
  }

  function queryFromVisual() {
    const { from, to, empty, $from, $to } = editor.state.selection;
    if (!empty) {
      if (!$from.sameParent($to)) return { query: '', wholeWord: false };
      return { query: editor.state.doc.textBetween(from, to, ''), wholeWord: false };
    }
    if (!$from.parent.isTextblock) return { query: '', wholeWord: false };
    const query = wordAtOffset($from.parent.textContent, $from.parentOffset);
    return { query, wholeWord: Boolean(query) };
  }

  function queryFromMarkdown() {
    if (!markdownTextarea) return { query: '', wholeWord: false };
    const { selectionStart, selectionEnd, value } = markdownTextarea;
    if (selectionStart !== selectionEnd) {
      return { query: value.slice(selectionStart, selectionEnd), wholeWord: false };
    }
    const query = wordAtOffset(value, selectionStart);
    return { query, wholeWord: Boolean(query) };
  }

  function findOptions() {
    const query = (document.getElementById('find-query') as HTMLInputElement | null)?.value ?? '';
    const caseSensitive = (document.getElementById('find-case') as HTMLInputElement | null)?.checked ?? true;
    const wholeWord = (document.getElementById('find-whole') as HTMLInputElement | null)?.checked ?? false;
    return { query, caseSensitive, wholeWord };
  }

  function paintVisualMatches() {
    const tr = editor.state.tr
      .setMeta(findReplaceKey, { matches: findMatches, active: findActive })
      .setMeta('addToHistory', false);
    editor.view.dispatch(tr);
  }

  function clearVisualMatches() {
    const tr = editor.state.tr.setMeta(findReplaceKey, { clear: true }).setMeta('addToHistory', false);
    editor.view.dispatch(tr);
  }

  function queueFindSync() {
    if (findSyncQueued) return;
    findSyncQueued = true;
    queueMicrotask(() => {
      findSyncQueued = false;
      if (findOpen) syncFindHighlights();
    });
  }

  function syncFindHighlights() {
    const { query, caseSensitive, wholeWord } = findOptions();
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      findMatches = findStringMatches(markdownTextarea.value, query, caseSensitive, wholeWord);
      clearVisualMatches();
    } else {
      findMatches = collectDocMatches(editor.state.doc, query, caseSensitive, wholeWord);
      if (findActive >= findMatches.length) findActive = 0;
      paintVisualMatches();
    }
    if (findActive >= findMatches.length) findActive = 0;
    const countEl = document.getElementById('find-count');
    if (countEl) {
      countEl.textContent = findMatches.length ? `${findActive + 1} of ${findMatches.length}` : 'No matches';
    }
  }

  function scrollActiveMatch() {
    const match = findMatches[findActive];
    if (!match) return;
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const active = document.activeElement;
      markdownTextarea.setSelectionRange(match.from, match.to);
      const line = markdownTextarea.value.slice(0, match.from).split('\n').length;
      const lineHeight = parseFloat(getComputedStyle(markdownTextarea).lineHeight) || 22;
      markdownTextarea.scrollTop = Math.max(0, (line - 4) * lineHeight);
      if (active instanceof HTMLElement && active.closest('#contextual-block-toolbar')) active.focus();
      return;
    }
    editor.commands.setTextSelection({ from: match.from, to: match.to });
    const coords = editor.view.coordsAtPos(match.from);
    const canvas = document.getElementById('editor-main-canvas');
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    if (coords.top < rect.top + 48 || coords.bottom > rect.bottom - 48) {
      canvas.scrollTop += coords.top - (rect.top + rect.height / 3);
    }
    paintVisualMatches();
  }

  function selectWordInVisualEditor() {
    const { empty, $from } = editor.state.selection;
    if (!empty || !$from.parent.isTextblock) return;
    const text = $from.parent.textContent;
    const offset = $from.parentOffset;
    const re = /[\p{L}\p{N}_]+/gu;
    let match: RegExpExecArray | null;
    while ((match = re.exec(text))) {
      const start = match.index;
      const end = start + match[0].length;
      if (offset >= start && offset <= end) {
        const from = $from.start() + start;
        editor.commands.setTextSelection({ from, to: from + match[0].length });
        return;
      }
    }
  }

  function showSelectionToolbar() {
    if (!contextualToolbar) return;
    contextualToolbar.classList.remove('hidden');
    contextualToolbar.classList.add('flex');
    document.getElementById('ctx-replace-tools')?.classList.remove('hidden');
    document.getElementById('ctx-replace-tools')?.classList.add('flex');
    document.getElementById('ctx-media-tools')?.classList.add('hidden');
    document.getElementById('ctx-media-tools')?.classList.remove('flex');
  }

  function openFindReplace(focus: 'find' | 'replace' = 'replace') {
    findOpen = true;
    showSelectionToolbar();
    updateContextualToolbar();
    syncFindHighlights();
    const input = document.getElementById('replace-query') as HTMLInputElement | null;
    if (focus === 'replace') {
      input?.focus();
    }
  }

  function closeFindReplace() {
    findOpen = false;
    findMatches = [];
    findActive = 0;
    clearVisualMatches();
    const countEl = document.getElementById('find-count');
    if (countEl) countEl.textContent = '';
  }

  function selectEveryCopy() {
    if (currentEditorMode !== 'markdown') selectWordInVisualEditor();
    const picked = currentEditorMode === 'markdown' ? queryFromMarkdown() : queryFromVisual();
    const queryInput = document.getElementById('find-query') as HTMLInputElement | null;
    const caseBox = document.getElementById('find-case') as HTMLInputElement | null;
    const wholeBox = document.getElementById('find-whole') as HTMLInputElement | null;
    if (caseBox) caseBox.checked = true;
    if (wholeBox) wholeBox.checked = picked.wholeWord;
    if (queryInput && picked.query) queryInput.value = picked.query;
    findActive = 0;
    openFindReplace('replace');
    if (findMatches.length) scrollActiveMatch();
    (document.getElementById('replace-query') as HTMLInputElement | null)?.focus();
  }

  function openFindFromShortcut() {
    const queryInput = document.getElementById('find-query') as HTMLInputElement | null;
    if (queryInput && !queryInput.value) {
      const picked = currentEditorMode === 'markdown' ? queryFromMarkdown() : queryFromVisual();
      if (picked.query) queryInput.value = picked.query;
      const wholeBox = document.getElementById('find-whole') as HTMLInputElement | null;
      if (wholeBox) wholeBox.checked = picked.wholeWord;
    }
    findActive = 0;
    openFindReplace('find');
    if (findMatches.length) scrollActiveMatch();
    queryInput?.focus();
    queryInput?.select();
  }

  function stepMatch(delta: number) {
    if (!findMatches.length) return;
    findActive = (findActive + delta + findMatches.length) % findMatches.length;
    syncFindHighlights();
    scrollActiveMatch();
  }

  function replaceAllMatches() {
    const replacement = (document.getElementById('replace-query') as HTMLInputElement | null)?.value ?? '';
    const { query, caseSensitive, wholeWord } = findOptions();
    if (!query) return;
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const matches = findStringMatches(markdownTextarea.value, query, caseSensitive, wholeWord);
      if (!matches.length) return;
      let next = '';
      let cursor = 0;
      const value = markdownTextarea.value;
      for (const match of matches) {
        next += value.slice(cursor, match.from) + replacement;
        cursor = match.to;
      }
      markdownTextarea.value = next + value.slice(cursor);
      markdownTextarea.dispatchEvent(new Event('input', { bubbles: true }));
    } else {
      const matches = collectDocMatches(editor.state.doc, query, caseSensitive, wholeWord);
      if (!matches.length) return;
      let tr = editor.state.tr;
      for (let i = matches.length - 1; i >= 0; i -= 1) {
        const { from, to } = matches[i];
        if (!replacement) {
          tr = tr.delete(from, to);
        } else {
          const marks = editor.state.doc.resolve(Math.min(from + 1, to)).marks();
          tr = tr.replaceWith(from, to, editor.state.schema.text(replacement, marks));
        }
      }
      editor.view.dispatch(tr);
    }
    findActive = 0;
    syncFindHighlights();
  }

  function replaceActiveMatch() {
    const match = findMatches[findActive];
    if (!match) return;
    const replacement = (document.getElementById('replace-query') as HTMLInputElement | null)?.value ?? '';
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const value = markdownTextarea.value;
      markdownTextarea.value = value.slice(0, match.from) + replacement + value.slice(match.to);
      markdownTextarea.dispatchEvent(new Event('input', { bubbles: true }));
    } else {
      let tr = editor.state.tr;
      if (!replacement) tr = tr.delete(match.from, match.to);
      else {
        const marks = editor.state.doc.resolve(Math.min(match.from + 1, match.to)).marks();
        tr = tr.replaceWith(match.from, match.to, editor.state.schema.text(replacement, marks));
      }
      editor.view.dispatch(tr);
    }
    syncFindHighlights();
    if (findMatches.length) {
      findActive = Math.min(findActive, findMatches.length - 1);
      scrollActiveMatch();
    }
  }

  function findShortcutAllowed(target: EventTarget | null) {
    const el = target as HTMLElement | null;
    if (!el?.tagName) return true;
    const inField = el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' || el.isContentEditable;
    if (!inField) return true;
    return el.id === 'markdown-textarea' || Boolean(el.closest('#contextual-block-toolbar') || el.closest('.ProseMirror'));
  }

  document.getElementById('top-find-btn')?.addEventListener('click', () => openFindFromShortcut());
  document.getElementById('find-close')?.addEventListener('click', () => closeFindReplace());
  document.getElementById('find-prev')?.addEventListener('click', () => stepMatch(-1));
  document.getElementById('find-next')?.addEventListener('click', () => stepMatch(1));
  document.getElementById('replace-one')?.addEventListener('click', () => replaceActiveMatch());
  document.getElementById('replace-all')?.addEventListener('click', () => replaceAllMatches());
  document.getElementById('find-query')?.addEventListener('input', () => {
    findActive = 0;
    if (!findOpen) return;
    syncFindHighlights();
    scrollActiveMatch();
  });
  document.getElementById('find-case')?.addEventListener('change', () => {
    findActive = 0;
    syncFindHighlights();
    scrollActiveMatch();
  });
  document.getElementById('find-whole')?.addEventListener('change', () => {
    findActive = 0;
    syncFindHighlights();
    scrollActiveMatch();
  });
  document.getElementById('replace-query')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      if (e.shiftKey) replaceActiveMatch();
      else replaceAllMatches();
    }
  });
  document.getElementById('find-query')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      stepMatch(e.shiftKey ? -1 : 1);
    }
  });

  // Keyboard navigation for slash menu and Escape handling for drawers/menus
  window.addEventListener('keydown', (e) => {
    const mod = e.ctrlKey || e.metaKey;
    if (mod && !e.altKey && !isSlashMenuOpen && !isInlineMenuOpen && findShortcutAllowed(e.target)) {
      const key = e.key.toLowerCase();
      if (key === 'd' || (key === 'l' && e.shiftKey) || key === 'h' || key === 'f') {
        e.preventDefault();
        e.stopPropagation();
        const inFindBar = (e.target as HTMLElement | null)?.closest?.('#contextual-block-toolbar');
        if ((key === 'd' || key === 'l') && !inFindBar) selectEveryCopy();
        else if (key === 'd' || key === 'l') {
          findActive = 0;
          openFindReplace('replace');
          if (findMatches.length) scrollActiveMatch();
        } else openFindFromShortcut();
        return;
      }
    }

    if (e.key === 'Escape') {
      if (isSlashMenuOpen) {
        e.preventDefault();
        closeSlashMenu();
        return;
      }
      if (isInlineMenuOpen) {
        e.preventDefault();
        closeInlineBlockMenu();
        return;
      }
      if (findOpen) {
        e.preventDefault();
        closeFindReplace();
        return;
      }
      if (headerBlockDropdown && !headerBlockDropdown.classList.contains('hidden')) {
        headerBlockDropdown.classList.add('hidden');
        return;
      }
      if (inserterDrawer && !inserterDrawer.classList.contains('hidden')) {
        inserterDrawer.classList.add('hidden');
        updateDrawerBackdrop();
        return;
      }
      if (outlineDrawer && !outlineDrawer.classList.contains('hidden')) {
        outlineDrawer.classList.add('hidden');
        updateDrawerBackdrop();
        return;
      }
      if (editorSidebar && !editorSidebar.classList.contains('hidden') && window.innerWidth < 1024) {
        editorSidebar.classList.add('hidden');
        updateDrawerBackdrop();
        return;
      }
    }

    if (!isSlashMenuOpen || slashFilteredList.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      slashSelectedIndex = (slashSelectedIndex + 1) % slashFilteredList.length;
      renderSlashHighlight();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      slashSelectedIndex = (slashSelectedIndex - 1 + slashFilteredList.length) % slashFilteredList.length;
      renderSlashHighlight();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      e.stopPropagation();
      executeSlashItem(slashSelectedIndex);
    }
  }, true);

  // ==========================================
  // Inline Block Insertion (Floating '+' button)
  // ==========================================
  
  function updateInlinePlusButton() {
    if (!inlineBlockPlusBtn || currentEditorMode !== 'visual' || isInlineMenuOpen) return;
    if (!editor) return;

    const { state } = editor.view;
    const { selection } = state;
    if (!selection.empty) {
      inlineBlockPlusBtn.classList.add('hidden');
      return;
    }

    const { $from } = selection;
    const nodePos = $from.before(1);
    const node = state.doc.nodeAt(nodePos);
    if (!node) {
      inlineBlockPlusBtn.classList.add('hidden');
      return;
    }

    try {
      const domNode = editor.view.nodeDOM(nodePos) as HTMLElement | null;
      if (domNode && domNode.getBoundingClientRect) {
        const rect = domNode.getBoundingClientRect();
        // Position plus button in left gutter aligned with top of block
        const btnX = Math.max(16, rect.left - 24);
        const btnY = rect.top + 14;

        inlineBlockPlusBtn.style.left = `${btnX}px`;
        inlineBlockPlusBtn.style.top = `${btnY}px`;
        inlineBlockPlusBtn.classList.remove('hidden');
        inlineBlockPlusBtn.classList.add('flex');
        inlineInsertPos = nodePos + node.nodeSize;
        return;
      }
    } catch (_) {}
    inlineBlockPlusBtn.classList.add('hidden');
  }

  // Hover detection over editor blocks
  editorElement?.addEventListener('mousemove', (e) => {
    if (isInlineMenuOpen || currentEditorMode !== 'visual') return;
    const target = e.target as HTMLElement | null;
    const blockEl = target?.closest('#tiptap-editor > .ProseMirror > *') as HTMLElement | null;
    if (!blockEl) return;

    const rect = blockEl.getBoundingClientRect();
    const btnX = Math.max(16, rect.left - 24);
    const btnY = rect.top + 14;

    if (inlineBlockPlusBtn) {
      inlineBlockPlusBtn.style.left = `${btnX}px`;
      inlineBlockPlusBtn.style.top = `${btnY}px`;
      inlineBlockPlusBtn.classList.remove('hidden');
      inlineBlockPlusBtn.classList.add('flex');

      try {
        const pos = editor.view.posAtDOM(blockEl, 0);
        const $pos = editor.state.doc.resolve(pos);
        const topPos = $pos.before(1);
        const topNode = editor.state.doc.nodeAt(topPos);
        if (topNode) {
          inlineInsertPos = topPos + topNode.nodeSize;
        } else {
          inlineInsertPos = pos;
