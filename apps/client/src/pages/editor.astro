  // Insert standard blocks
  function selectedBulletStyle() {
    const value = (document.getElementById('bullet-style-select') as HTMLSelectElement | null)?.value;
    return value === 'circle' || value === 'square' ? value : 'disc';
  }

  function selectedImageAlign() {
    const active = document.querySelector('#article-image-align button[data-selected="true"]') as HTMLButtonElement | null;
    const value = active?.dataset.align;
    return value === 'left' || value === 'right' ? value : 'center';
