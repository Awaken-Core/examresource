<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Link from '@tiptap/extension-link';
  import { ArticleBulletList, ArticleImage } from '../lib/editor-nodes';
  import { collectDocMatches, FindReplace, findReplaceKey, findStringMatches, type FindMatch } from '../lib/find-replace';
  import Youtube from '@tiptap/extension-youtube';
  import { Table, TableRow, TableCell, TableHeader } from '@tiptap/extension-table';
  import Underline from '@tiptap/extension-underline';
  import CharacterCount from '@tiptap/extension-character-count';
  import { marked } from 'marked';
  import TurndownService from 'turndown';
  import DOMPurify from 'dompurify';

  // Configure marked for GitHub flavored markdown with tables and standard rules
  const markedRenderer = new marked.Renderer();
  markedRenderer.heading = function ({ tokens, depth, text }: any) {
    const rawText = (text || this.parser.parseInline(tokens)).replace(/\\+/g, '');
    const cleanText = rawText.replace(/<[^>]*>/g, '');
    const id = cleanText
      .toLowerCase()
      .trim()
      .replace(/\\+/g, '')
      .replace(/\s+/g, '-')
      .replace(/[^\p{L}\p{N}\s\-]+/gu, '')
      .replace(/\-\-+/g, '-')
      .replace(/(^-|-$)/g, '') || `section-${depth}`;
    return `<h${depth} id="${id}">${rawText}</h${depth}>\n`;
  };

  marked.setOptions({
    gfm: true,
    breaks: false, // Standard GitHub Markdown does not convert single soft newlines to <br> unless two spaces or a blank line exist
    pedantic: false,
    renderer: markedRenderer,
  });

  // Safe DOMPurify configuration allowing standard GFM article tags, video iframes, and safe attributes
  const DOMPURIFY_CONFIG = {
    ALLOWED_TAGS: [
      'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
      'p', 'span', 'strong', 'b', 'em', 'i', 'u', 's', 'del', 'strike',
      'blockquote', 'pre', 'code', 'hr', 'br',
      'ul', 'ol', 'li',
      'table', 'thead', 'tbody', 'tfoot', 'tr', 'th', 'td',
      'a', 'img', 'figure', 'figcaption',
      'div', 'iframe'
    ],
    ALLOWED_ATTR: [
      'href', 'src', 'alt', 'title', 'class', 'id', 'target', 'rel',
      'width', 'height', 'loading', 'data-align', 'data-layout', 'data-bullet', 'style',
      'allow', 'allowfullscreen', 'frameborder', 'referrerpolicy'
    ],
    ADD_TAGS: ['iframe'],
    ALLOWED_URI_REGEXP: /^(?:(?:https?|mailto):|[^a-z]|[a-z+.\-]+(?:[^a-z+.\-:]|$))/i,
  };

  // Configure turndown to serialize HTML to clean GitHub-style markdown
  const turndownService = new TurndownService({
    headingStyle: 'atx',
    hr: '---',
    bulletListMarker: '-',
    codeBlockStyle: 'fenced',
  });
  // Prevent turndown from escaping markdown characters (like numbers followed by periods in headings: "1." -> "1\.")
  // which causes cascading backslash accumulation (1\. -> 1\\\. -> 1\\\\\\.) on repeated edits/saves.
  turndownService.escape = (str: string) => str;

  // Custom turndown rule for tables
  turndownService.addRule('table', {
    filter: 'table',
    replacement: function (content, node: any) {
      const rows = Array.from(node.querySelectorAll('tr'));
      if (rows.length === 0) return '';
      let md = '\n\n';
      rows.forEach((row: any, rIdx) => {
        const cells = Array.from(row.querySelectorAll('th, td'));
        const rowStr = cells.map((c: any) => c.textContent.trim().replace(/\|/g, '\\|')).join(' | ');
        md += `| ${rowStr} |\n`;
        if (rIdx === 0) {
          const sep = cells.map(() => '---').join(' | ');
          md += `| ${sep} |\n`;
        }
      });
      return md + '\n';
    },
  });

  // Custom turndown rule for callouts
  turndownService.addRule('callout', {
    filter: function (node) {
      return (
        node.nodeName === 'DIV' &&
        (node.className.includes('callout') || node.className.includes('alert'))
      );
    },
    replacement: function (content) {
      return `\n\n> **Note:** ${content.trim()}\n\n`;
    },
  });

  // Preserve video iframes when converting HTML to Markdown
  turndownService.addRule('iframe', {
    filter: 'iframe',
    replacement: function (_content, node: any) {
      const src = node.getAttribute('src') || '';
      if (!src) return '';
      return `\n\n<div class="aspect-video my-4">\n  <iframe src="${src}" class="w-full h-full rounded-lg border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>\n</div>\n\n`;
    },
  });


  const API_URL = import.meta.env.PUBLIC_API_URL.replace(/\/$/, '');
  const SITE_URL = import.meta.env.PUBLIC_SITE_URL.replace(/\/$/, '');

  async function apiFetch(endpoint: string, options: RequestInit = {}) {
    const headers = new Headers(options.headers || {});
    if (options.body && typeof options.body === 'string' && !headers.has('Content-Type')) headers.set('Content-Type', 'application/json');
    if (options.method && !['GET', 'HEAD'].includes(options.method.toUpperCase())) headers.set('X-CSRF-Protection', '1');
    return fetch(`${API_URL}${endpoint}`, { ...options, headers, credentials: 'include' });
  }

  async function uploadImage(file: File): Promise<string> {
    const signResponse = await apiFetch('/uploads/images/sign', {
      method: 'POST',
      body: JSON.stringify({ contentType: file.type, size: file.size }),
    });
    const signed = await signResponse.json().catch(() => null);
    if (!signResponse.ok || !signed?.uploadUrl || !signed?.publicUrl) {
      throw new Error(signed?.message || 'Unable to prepare the image upload.');
    }
    let uploadResponse: Response;
    try {
      uploadResponse = await fetch(signed.uploadUrl, {
        method: 'PUT', headers: { 'Content-Type': file.type }, body: file,
      });
    } catch {
      throw new Error('Could not reach Cloudflare R2. Add this site to the bucket CORS allowed origins and try again.');
    }
    if (!uploadResponse.ok) throw new Error('R2 rejected the upload. Check the bucket CORS policy and try again.');
    return signed.publicUrl;
  }

  const acceptedImageTypes: Record<string, string> = {
    'image/jpeg': 'jpg',
    'image/png': 'png',
    'image/webp': 'webp',
    'image/gif': 'gif',
  };

  function normalizeImageFile(file: File): File | null {
    let type = (file.type || '').toLowerCase();
    if (type === 'image/jpg') type = 'image/jpeg';
    if (!acceptedImageTypes[type]) {
      const ext = file.name.split('.').pop()?.toLowerCase() || '';
      const byExt: Record<string, string> = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', gif: 'image/gif' };
      type = byExt[ext] || '';
    }
    const extension = acceptedImageTypes[type];
    if (!extension) return null;
    const name = /\.[a-z0-9]+$/i.test(file.name) ? file.name : `pasted-image.${extension}`;
    if (file.type === type && file.name === name) return file;
    return new File([file], name, { type });
  }

  function imageFilesFromTransfer(data: DataTransfer | null): File[] {
    if (!data) return [];
    const found: File[] = [];
    const seen = new Set<string>();
    const push = (file: File | null) => {
      const normalized = file ? normalizeImageFile(file) : null;
      if (!normalized) return;
      const key = `${normalized.type}:${normalized.size}:${normalized.name}`;
      if (seen.has(key)) return;
      seen.add(key);
      found.push(normalized);
    };
    if (data.items?.length) {
      for (const item of Array.from(data.items)) {
        if (item.kind === 'file') push(item.getAsFile());
      }
    }
    if (!found.length) {
      for (const file of Array.from(data.files || [])) push(file);
    }
    return found;
  }

  function fileFromDataUrl(dataUrl: string, name: string): File | null {
    const match = dataUrl.match(/^data:(image\/[a-z0-9.+-]+);base64,([\s\S]+)$/i);
    if (!match) return null;
    const binary = atob(match[2].replace(/\s/g, ''));
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
    return normalizeImageFile(new File([bytes], name || 'pasted-image', { type: match[1].toLowerCase() }));
  }

  async function fileFromImageSource(src: string, name: string): Promise<File | null> {
    if (src.startsWith('data:image/')) return fileFromDataUrl(src, name);
    if (src.startsWith('blob:')) {
      const response = await fetch(src);
      const blob = await response.blob();
      return normalizeImageFile(new File([blob], name || 'pasted-image', { type: blob.type || 'image/png' }));
    }
    return null;
  }

  function localImageSources(html: string): string[] {
    const sources: string[] = [];
    const pattern = /<img\b[^>]*\bsrc=["']([^"']+)["']/gi;
    let match: RegExpExecArray | null;
    while ((match = pattern.exec(html))) {
      const src = match[1];
      if (src.startsWith('data:image/') || src.startsWith('blob:')) sources.push(src);
    }
    return sources;
  }

  let imageUploadChain: Promise<void> = Promise.resolve();

  function trackImageUpload(work: Promise<void>) {
    imageUploadChain = imageUploadChain.then(() => work, () => work);
    return imageUploadChain;
  }

  function setUploadStatus(message: string) {
    if (!saveStatusEl) return;
    saveStatusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span><span>${message}</span>`;
  }

  function revealUploadedImage(url: string) {
    const apply = (img: HTMLImageElement) => {
      const column = editor.view.dom.clientWidth || img.naturalWidth || 620;
      const width = Math.max(80, Math.min(img.naturalWidth || column, column));
      editor.state.doc.descendants((node, pos) => {
        if (node.type.name === 'image' && node.attrs.src === url && node.attrs.width !== width) {
          editor.view.dispatch(editor.state.tr.setNodeMarkup(pos, undefined, { ...node.attrs, width }));
          return false;
        }
        return undefined;
      });
      const shown = editor.view.dom.querySelector(`img[src="${CSS.escape(url)}"]`) as HTMLImageElement | null;
      if (shown) shown.style.width = `${width}px`;
    };
    requestAnimationFrame(() => {
      const img = editor.view.dom.querySelector(`img[src="${CSS.escape(url)}"]`) as HTMLImageElement | null;
      if (!img) return;
      if (img.complete && img.naturalWidth) apply(img);
      else img.addEventListener('load', () => apply(img), { once: true });
    });
  }

  async function placeUploadedImages(files: File[], pos?: number) {
    const accepted = files.filter((file) => file.size <= 10 * 1024 * 1024);
    if (!accepted.length) {
      alert('Only JPEG, PNG, WebP, and GIF images up to 10 MB can be added.');
      return;
    }
    setUploadStatus(accepted.length > 1 ? `Uploading ${accepted.length} images to R2...` : 'Uploading image to R2...');
    const uploaded: { url: string; alt: string }[] = [];
    for (const file of accepted) {
      const url = await uploadImage(file);
      const alt = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ') || 'image';
      uploaded.push({ url, alt });
    }

    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const snippet = uploaded.map(({ url, alt }) => {
        const safeAlt = alt.replace(/"/g, '&quot;');
        return `\n\n<figure class="article-figure" data-align="center" data-layout="full"><img src="${url}" alt="${safeAlt}" data-align="center" data-layout="full" class="article-media" /></figure>\n\n`;
      }).join('');
      const start = markdownTextarea.selectionStart;
      const end = markdownTextarea.selectionEnd;
      const value = markdownTextarea.value;
      markdownTextarea.value = value.slice(0, start) + snippet + value.slice(end);
      markdownTextarea.selectionStart = markdownTextarea.selectionEnd = start + snippet.length;
      markdownTextarea.dispatchEvent(new Event('input', { bubbles: true }));
    } else {
      const nodes = uploaded.flatMap(({ url, alt }) => [
        { type: 'image', attrs: { src: url, alt, title: '', align: 'center', layout: 'full', width: null, height: null } },
        { type: 'paragraph' },
      ]);
      const chain = editor.chain().focus();
      if (typeof pos === 'number') chain.insertContentAt(pos, nodes).run();
      else chain.insertContent(nodes).run();
      uploaded.forEach(({ url }) => revealUploadedImage(url));
    }

    if (accepted.length < files.length) {
      alert('Skipped images larger than 10 MB.');
    }
    if (saveStatusEl) {
      saveStatusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Image added</span>`;
    }
  }

  function queueUploadedImages(files: File[], pos?: number) {
    return trackImageUpload(placeUploadedImages(files, pos).catch((error) => {
      alert(error instanceof Error ? error.message : 'Image upload failed.');
    }));
  }

  async function replaceLocalImagesInEditor() {
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const pattern = /(data:image\/[a-z0-9.+-]+;base64,[A-Za-z0-9+/=\s]+|blob:[^\s)"']+)/gi;
      const sources = markdownTextarea.value.match(pattern) || [];
      let next = markdownTextarea.value;
      for (const src of sources) {
        const file = await fileFromImageSource(src, 'pasted-image');
        if (!file || file.size > 10 * 1024 * 1024) continue;
        const url = await uploadImage(file);
        next = next.split(src).join(url);
      }
      if (next !== markdownTextarea.value) {
        markdownTextarea.value = next;
        markdownTextarea.dispatchEvent(new Event('input', { bubbles: true }));
      }
      return;
    }

    const locals: { pos: number; src: string; alt: string }[] = [];
    editor.state.doc.descendants((node, pos) => {
      if (node.type.name !== 'image') return;
      const src = String(node.attrs.src || '');
      if (src.startsWith('data:image/') || src.startsWith('blob:')) {
        locals.push({ pos, src, alt: String(node.attrs.alt || 'image') });
      }
    });
    for (const item of [...locals].reverse()) {
      const file = await fileFromImageSource(item.src, item.alt);
      if (!file || file.size > 10 * 1024 * 1024) continue;
      const url = await uploadImage(file);
      const node = editor.state.doc.nodeAt(item.pos);
      if (!node || node.type.name !== 'image') continue;
      editor.view.dispatch(editor.state.tr.setNodeMarkup(item.pos, undefined, { ...node.attrs, src: url }));
      revealUploadedImage(url);
    }
  }

  function handleEditorImagePaste(event: ClipboardEvent) {
    const data = event.clipboardData;
    if (!data) return false;
    const files = imageFilesFromTransfer(data);
    const text = data.getData('text/plain').trim();
    const embedded = localImageSources(data.getData('text/html'));
    const filenameOnly = /^[\w.\- ()]+\.(png|jpe?g|webp|gif)$/i.test(text);
    if ((files.length || embedded.length) && (!text || filenameOnly)) {
      event.preventDefault();
      const ready = files.length
        ? Promise.resolve(files)
        : Promise.all(embedded.map((src, index) => fileFromImageSource(src, `pasted-image-${index + 1}`))).then((items) => items.filter((file): file is File => Boolean(file)));
      void ready.then((items) => queueUploadedImages(items));
      return true;
    }
    if (embedded.length) queueMicrotask(() => { void trackImageUpload(replaceLocalImagesInEditor()); });
    return false;
  }

  function handleEditorImageDrop(view: { posAtCoords: (coords: { left: number; top: number }) => { pos: number } | null }, event: DragEvent, moved: boolean) {
