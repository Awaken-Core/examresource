---
import AdminLayout from '../layouts/AdminLayout.astro';
import { siteUrl } from '../data/site';
---

<AdminLayout title="Article Editor" activeNav="new-post" fullWidth={true}>
  <!-- Full-Screen Gutenberg & Markdown Hybrid Workspace -->
  <div class="h-screen w-screen flex flex-col bg-white overflow-hidden text-slate-900 select-none font-sans">
    
    <!-- 1. Compact Top Toolbar -->
    <header class="h-13 bg-white border-b border-slate-200 px-3 flex items-center justify-between shrink-0 z-40 select-none">
      
      <!-- Left side: Back, Inserter (+), Undo, Redo, Document Outline List View -->
      <div class="flex items-center gap-1">
        <!-- Back to Articles -->
        <a 
          href="/admin" 
          id="back-to-posts-btn"
          class="p-2 rounded hover:bg-slate-100 text-slate-700 transition"
          title="Back to All Articles"
          aria-label="Back to All Articles"
        >
          <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>

        <div class="w-px h-5 bg-slate-200 mx-1"></div>

        <!-- Header Plus Button & Compact Dropdown -->
        <div class="relative">
          <button 
            type="button" 
            id="top-inserter-toggle-btn"
            class="w-8 h-8 rounded bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center transition shadow-2xs"
            title="Add block / Toggle block menu"
            aria-label="Add block"
          >
            <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </button>

          <!-- Compact Header Dropdown Block Menu -->
          <div 
            id="header-block-dropdown" 
            class="hidden absolute left-0 top-full mt-2 z-50 bg-white border border-slate-300 rounded-lg shadow-xl w-68 max-h-96 overflow-y-auto py-1 text-xs select-none"
          >
            <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 flex items-center justify-between">
              <span>Quick Add Block</span>
              <button type="button" id="open-full-library-btn" class="text-blue-600 hover:underline font-semibold text-[10px]">Browse all →</button>
            </div>
            <div class="p-1 space-y-0.5">
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="paragraph">
                <span class="w-5 text-center font-serif text-slate-500 font-bold">¶</span>
                <div><strong class="text-slate-800 block">Paragraph</strong><span class="text-[10px] text-slate-400 block">Standard body text</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="h2">
                <span class="w-5 text-center font-bold text-slate-700">H2</span>
                <div><strong class="text-slate-800 block">Heading 2</strong><span class="text-[10px] text-slate-400 block">Major section header</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="h3">
                <span class="w-5 text-center font-bold text-slate-700">H3</span>
                <div><strong class="text-slate-800 block">Heading 3</strong><span class="text-[10px] text-slate-400 block">Subsection header</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="h4">
                <span class="w-5 text-center font-bold text-slate-700">H4</span>
                <div><strong class="text-slate-800 block">Heading 4</strong><span class="text-[10px] text-slate-400 block">Minor section header</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="bulletList">
                <span class="w-5 text-center font-bold text-slate-700">•</span>
                <div><strong class="text-slate-800 block">Bullet List</strong><span class="text-[10px] text-slate-400 block">Unordered bullet points</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="orderedList">
                <span class="w-5 text-center font-bold text-slate-700">1.</span>
                <div><strong class="text-slate-800 block">Numbered List</strong><span class="text-[10px] text-slate-400 block">Sequential numbered steps</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="table">
                <span class="w-5 text-center font-bold text-slate-700">▦</span>
                <div><strong class="text-slate-800 block">Table</strong><span class="text-[10px] text-slate-400 block">Tabular data grid</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="image">
                <span class="w-5 text-center font-bold text-slate-700">🖼</span>
                <div><strong class="text-slate-800 block">Image</strong><span class="text-[10px] text-slate-400 block">Illustration with alt text</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="codeBlock">
                <span class="w-5 text-center font-mono text-slate-700">&lt;/&gt;</span>
                <div><strong class="text-slate-800 block">Code Block</strong><span class="text-[10px] text-slate-400 block">Formatted code snippets</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="blockquote">
                <span class="w-5 text-center font-serif text-slate-700 font-bold">❝</span>
                <div><strong class="text-slate-800 block">Blockquote</strong><span class="text-[10px] text-slate-400 block">Highlighted quote or excerpt</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="callout">
                <span class="w-5 text-center font-bold text-blue-600">ℹ</span>
                <div><strong class="text-slate-800 block">Callout Note</strong><span class="text-[10px] text-slate-400 block">Notice or alert box</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="divider">
                <span class="w-5 text-center font-bold text-slate-400">—</span>
                <div><strong class="text-slate-800 block">Divider</strong><span class="text-[10px] text-slate-400 block">Horizontal separator line</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="video">
                <span class="w-5 text-center font-bold text-red-500">▶</span>
                <div><strong class="text-slate-800 block">Video Embed</strong><span class="text-[10px] text-slate-400 block">YouTube or direct video</span></div>
              </button>
              <button type="button" class="header-insert-opt w-full text-left px-2.5 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2" data-type="toc">
                <span class="w-5 text-center font-bold text-slate-700">📑</span>
                <div><strong class="text-slate-800 block">Table of Contents</strong><span class="text-[10px] text-slate-400 block">Auto-generated links</span></div>
              </button>
            </div>
          </div>
        </div>

        <!-- Undo & Redo -->
        <button 
          type="button" 
          id="top-undo-btn"
          class="p-2 rounded hover:bg-slate-100 text-slate-600 disabled:opacity-30 disabled:pointer-events-none transition"
          title="Undo (Ctrl+Z)"
          aria-label="Undo"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a5 5 0 015 5v2m-15-7l4-4m-4 4l4 4" />
          </svg>
        </button>

        <button 
          type="button" 
          id="top-redo-btn"
          class="p-2 rounded hover:bg-slate-100 text-slate-600 disabled:opacity-30 disabled:pointer-events-none transition"
          title="Redo (Ctrl+Y)"
          aria-label="Redo"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 10H11a5 5 0 00-5 5v2m15-7l-4-4m4 4l-4 4" />
          </svg>
        </button>

        <button
          type="button"
          id="top-find-btn"
          class="p-2 rounded hover:bg-slate-100 text-slate-600 transition"
          title="Replace every copy (Ctrl+D, type, Enter)"
          aria-label="Find and replace"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 20l-3.5-3.5" />
          </svg>
        </button>

        <!-- Document Outline / List View Toggle -->
        <button 
          type="button" 
          id="top-outline-toggle-btn"
          class="p-2 rounded hover:bg-slate-100 text-slate-600 transition"
          title="Document Outline & List View"
          aria-label="Document Outline"
        >
          <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h10M4 14h16M4 18h10" />
          </svg>
        </button>
      </div>

      <!-- Center: Mode Switcher & Language Switcher -->
      <div class="flex items-center gap-2">
        <div class="bg-slate-100 p-0.5 rounded-lg border border-slate-200 flex items-center text-xs shadow-2xs">
          <button 
            type="button" 
            id="mode-visual-btn"
            class="editor-mode-toggle px-3 py-1 rounded-md font-bold text-slate-900 bg-white shadow-xs transition flex items-center gap-1.5 cursor-pointer"
            data-mode="visual"
          >
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Visual Editor</span>
          </button>
          
          <button 
            type="button" 
            id="mode-markdown-btn"
            class="editor-mode-toggle px-3 py-1 rounded-md font-medium text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5 cursor-pointer"
            data-mode="markdown"
          >
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span>Markdown</span>
          </button>

          <button 
            type="button" 
            id="mode-compare-btn"
            class="editor-mode-toggle px-3 py-1 rounded-md font-medium text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5 cursor-pointer"
            data-mode="compare"
            title="Side-by-side comparison of Hindi & English articles"
          >
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            <span>Compare</span>
          </button>
        </div>

        <!-- Language Switcher Pill (Switches active article in Visual & Markdown editors) -->
        <div id="top-lang-pill-container" class="bg-slate-100 p-0.5 rounded-lg border border-slate-200 flex items-center text-xs shadow-2xs">
          <button 
            type="button" 
            id="top-lang-hindi-btn"
            class="px-2.5 py-1 rounded-md font-bold text-slate-900 bg-white shadow-xs transition flex items-center gap-1 cursor-pointer"
            title="Switch editor view to Hindi (हिंदी + Technical Terms)"
          >
            <span>🇮🇳 Hindi</span>
          </button>
          <button 
            type="button" 
            id="top-lang-english-btn"
            class="px-2.5 py-1 rounded-md font-medium text-slate-600 hover:text-slate-900 transition flex items-center gap-1 cursor-pointer"
            title="Switch editor view to English"
          >
            <span>🌐 English</span>
          </button>
        </div>
      </div>

      <!-- Right side: Saved state, Overview, Preview, Save Draft, Publish, Settings toggle, More menu -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Bilingual Mode Shortcut -->
        <button 
          type="button"
          id="top-bilingual-btn"
          class="px-2.5 py-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs transition flex items-center gap-1.5 cursor-pointer shadow-2xs"
          title="Bilingual: Compare Hindi and English articles side-by-side"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span class="hidden sm:inline">Bilingual</span>
        </button>

        <!-- Reference Post Rewriter -->
        <button 
          type="button"
          id="top-ai-writer-btn"
          class="px-2.5 py-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs transition flex items-center gap-1.5 cursor-pointer shadow-2xs"
          title="Reference Rewriter: Paste reference blog/notice to generate Hindi (Devanagari) & English articles"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <span class="hidden sm:inline">Reference Rewriter</span>
        </button>

        <!-- Live Saved Status Indicator -->
        <div id="save-status" class="hidden sm:flex items-center gap-1.5 text-xs text-slate-500 font-medium px-2 py-1">
          <span class="w-2 h-2 rounded-full bg-slate-300"></span>
          <span>Saved</span>
        </div>

        <!-- Word count / Reading time quick indicator -->
        <div id="document-overview-trigger" class="hidden xl:flex items-center gap-1.5 px-2 py-1 rounded hover:bg-slate-100 text-xs text-slate-600 cursor-pointer" title="Document statistics">
          <span id="word-count">0 words</span>
          <span class="text-slate-300">·</span>
          <span id="read-time">1 min read</span>
        </div>

        <!-- Preview Button -->
        <button 
          type="button"
          id="preview-btn"
          class="px-2.5 py-1.5 rounded-md hover:bg-slate-100 text-slate-700 font-medium text-xs flex items-center gap-1.5 transition"
          title="Preview article"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span class="hidden md:inline">Preview</span>
        </button>

        <!-- Save Draft Button -->
        <button 
          type="button"
          id="save-draft-btn"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs transition shadow-2xs disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="save-draft-spinner" class="hidden w-3 h-3 border-2 border-slate-400 border-t-transparent rounded-full animate-spin"></span>
          <span id="save-draft-label">Save Draft</span>
        </button>

        <!-- Publish / Update Button -->
        <button 
          type="button"
          id="publish-btn"
          class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-1.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs shadow-2xs transition disabled:opacity-60 disabled:cursor-not-allowed"
          style="background-color: #2563EB;"
        >
          <span id="publish-spinner" class="hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          <span id="publish-label">Publish</span>
        </button>

        <!-- Settings Sidebar Toggle Button -->
        <button 
          type="button" 
          id="sidebar-toggle-btn"
          class="p-2 rounded hover:bg-slate-100 text-slate-700 transition"
          title="Toggle document settings sidebar"
          aria-label="Settings"
        >
          <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 3v18" />
          </svg>
        </button>

        <!-- More Menu Dropdown -->
        <div class="relative">
          <button 
            type="button" 
            id="more-options-btn"
            class="p-2 rounded hover:bg-slate-100 text-slate-600 transition"
            title="More Options"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="5" r="1" />
              <circle cx="12" cy="12" r="1" />
              <circle cx="12" cy="19" r="1" />
            </svg>
          </button>

          <div 
            id="more-options-menu" 
            class="hidden absolute right-0 mt-1.5 w-56 bg-white border border-slate-200 rounded-lg shadow-lg py-1.5 z-50 text-xs divide-y divide-slate-100"
          >
            <!-- Mobile-only quick actions -->
            <div class="py-1 sm:hidden">
              <button 
                type="button" 
                id="opt-mobile-save-draft" 
                class="w-full text-left px-3.5 py-1.5 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5 font-medium"
              >
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Save Draft</span>
              </button>
            </div>

            <!-- Markdown Import / Export Group -->
            <div class="py-1">
              <button 
                type="button" 
                id="opt-import-md" 
                class="w-full text-left px-3.5 py-1.5 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5 font-medium"
              >
                <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <span>Import Markdown (.md)</span>
              </button>
              
              <button 
                type="button" 
                id="opt-export-md" 
                class="w-full text-left px-3.5 py-1.5 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5"
              >
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Export as .md File</span>
              </button>

              <button 
                type="button" 
                id="opt-copy-md" 
                class="w-full text-left px-3.5 py-1.5 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5"
              >
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span>Copy Markdown to Clipboard</span>
              </button>
            </div>

            <!-- Management Group -->
            <div class="py-1">
              <button 
                type="button" 
                id="opt-revisions" 
                class="w-full text-left px-3.5 py-1.5 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Revision History</span>
              </button>
              
              <button 
                type="button" 
                id="opt-duplicate" 
                class="w-full text-left px-3.5 py-1.5 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
