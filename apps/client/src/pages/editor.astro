      card.innerHTML = `
        <div class="h-24 bg-slate-100 flex items-center justify-center overflow-hidden">
          <img src="${item.url}" alt="${item.filename}" class="w-full h-full object-cover group-hover:scale-105 transition duration-150" loading="lazy" />
        </div>
        <div class="p-1.5 bg-white text-[10px] text-slate-700 truncate" title="${item.filename}">
          ${item.filename}
        </div>
      `;

      card.addEventListener('click', () => {
