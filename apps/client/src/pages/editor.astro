    if (compareEnglishExcerpt && english?.excerpt) compareEnglishExcerpt.value = english.excerpt;
    if (compareEnglishMarkdown && english?.content) compareEnglishMarkdown.value = english.content;

    // Determine active language
    const isEnglish = languageSelect?.value === 'ENGLISH';
    const activeData = isEnglish ? english : hinglish;

    // Also populate primary title/slug and SEO fields in sidebar
    if (titleInput && activeData?.title) titleInput.value = activeData.title;
    if (slugInput && activeData?.slug) slugInput.value = activeData.slug;
    if (excerptInput && activeData?.excerpt) excerptInput.value = activeData.excerpt;

    const metaTitleInput = document.getElementById('field-meta-title') as HTMLInputElement | null;
    const metaDescInput = document.getElementById('field-meta-desc') as HTMLTextAreaElement | null;
    if (metaTitleInput && (activeData?.metaTitle || hinglish?.metaTitle || english?.metaTitle)) {
      metaTitleInput.value = activeData?.metaTitle || hinglish?.metaTitle || english?.metaTitle || '';
    }
    if (metaDescInput && (activeData?.metaDescription || hinglish?.metaDescription || english?.metaDescription)) {
      metaDescInput.value = activeData?.metaDescription || hinglish?.metaDescription || english?.metaDescription || '';
    }

    // Crucial: Populate visual TipTap editor and markdownTextarea immediately!
    const targetMd = activeData?.content || '';
    if (markdownTextarea) {
      markdownTextarea.value = targetMd;
      updateLineNumbers();
    }
    if (targetMd) {
      const cleanHtml = DOMPurify.sanitize(String(await marked.parse(targetMd)), DOMPURIFY_CONFIG);
      editor.commands.setContent(cleanHtml);
    }

    // Category matching if available
    const categorySelect = document.getElementById('field-category') as HTMLSelectElement | null;
    if (categorySelect && detectedCategory) {
      const match = Array.from(categorySelect.options).find(
        (opt) => opt.text.toLowerCase().includes(detectedCategory.toLowerCase()) || opt.value.toLowerCase().includes(detectedCategory.toLowerCase())
      );
      if (match) categorySelect.value = match.value;
    }

    // Auto-match keywords to tags
    const allKeywords = [
      ...(hinglish?.keywords || []),
      ...(english?.keywords || []),
