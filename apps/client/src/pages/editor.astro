  // Contextual Floating Block Toolbar
  function setToolRow(id: string, visible: boolean) {
    const row = document.getElementById(id);
    row?.classList.toggle('hidden', !visible);
    row?.classList.toggle('flex', visible);
  }

  const imageLayoutLabels: Record<string, string> = {
    content: 'None',
    wide: 'Wide width',
    full: 'Full width',
    left: 'Align left',
    center: 'Align center',
    right: 'Align right',
  };

  function syncMediaControls() {
    if (!editor.isActive('image')) return;
    const layout = editor.getAttributes('image').layout || 'full';
    const label = document.getElementById('ctx-layout-label');
    if (label) label.textContent = imageLayoutLabels[layout] || 'Full width';
    document.querySelectorAll<HTMLButtonElement>('.ctx-layout-option').forEach((btn) => {
      const selected = btn.dataset.layout === layout;
      btn.classList.toggle('bg-blue-50', selected);
      btn.classList.toggle('ring-1', selected);
      btn.classList.toggle('ring-blue-500', selected);
    });
  }

  function applyImageLayout(layout: string) {
    if (!editor.isActive('image')) return;
    const align = layout === 'left' || layout === 'right' || layout === 'center' ? layout : 'center';
    const preset = layout === 'content' || layout === 'center' ? 620 : layout === 'wide' ? 1440 : layout === 'left' || layout === 'right' ? 480 : null;
    editor.chain().focus().updateAttributes('image', {
      layout,
      align,
      width: preset,
      height: null,
    }).run();
    const img = editor.view.dom.querySelector('.ProseMirror-selectednode img') as HTMLImageElement | null;
    if (!img) return;
    if (layout === 'full') {
      const frame = img.closest('[data-resize-container]') as HTMLElement | null;
      const px = frame?.clientWidth || 0;
      img.style.width = px > 80 ? `${px}px` : '100%';
    } else if (preset) {
      img.style.width = `${preset}px`;
    }
    img.style.height = 'auto';
    img.style.maxWidth = '100%';
    syncMediaControls();
  }

  function rememberSelectionQuery() {
    if (document.activeElement?.id === 'replace-query') return;
    const picked = queryFromVisual();
    const queryInput = document.getElementById('find-query') as HTMLInputElement | null;
    const wholeBox = document.getElementById('find-whole') as HTMLInputElement | null;
    if (!queryInput || !picked.query || queryInput.value === picked.query) return;
    queryInput.value = picked.query;
    if (wholeBox) wholeBox.checked = picked.wholeWord;
    findActive = 0;
    findOpen = true;
    queueFindSync();
  }

  function updateContextualToolbar() {
    if (!contextualToolbar || !editor || currentEditorMode !== 'visual') return;

    const { selection } = editor.state;
    const imageSelected = editor.isActive('image');
    const editingReplacement = document.activeElement?.id === 'replace-query';
    if (selection.empty && !imageSelected && !editingReplacement) {
      contextualToolbar.classList.add('hidden');
      contextualToolbar.classList.remove('flex');
      return;
    }

    let blockTypeLabel = '¶ Paragraph';
    const ctxTypeLabel = document.getElementById('ctx-block-type-label');
    const tableTools = document.getElementById('ctx-table-tools');

    if (imageSelected) blockTypeLabel = 'Image';
    else if (editor.isActive('heading', { level: 2 })) blockTypeLabel = 'H2 Heading';
    else if (editor.isActive('heading', { level: 3 })) blockTypeLabel = 'H3 Subheading';
    else if (editor.isActive('heading', { level: 4 })) blockTypeLabel = 'H4 Heading';
    else if (editor.isActive('bulletList')) blockTypeLabel = '• Bullet list';
    else if (editor.isActive('orderedList')) blockTypeLabel = '1. Number list';
    else if (editor.isActive('blockquote')) blockTypeLabel = '❝ Blockquote';
    else if (editor.isActive('codeBlock')) blockTypeLabel = '&lt;/&gt; Code';
    else if (editor.isActive('table')) blockTypeLabel = '▦ Table';

    if (ctxTypeLabel) ctxTypeLabel.textContent = blockTypeLabel;

    if (editor.isActive('table')) {
      tableTools?.classList.remove('hidden');
      tableTools?.classList.add('flex');
    } else {
      tableTools?.classList.add('hidden');
      tableTools?.classList.remove('flex');
    }

    setToolRow('ctx-media-tools', imageSelected);
    setToolRow('ctx-replace-tools', !imageSelected && (!selection.empty || editingReplacement));
    if (imageSelected) {
      syncMediaControls();
      if (findOpen) queueMicrotask(() => { if (editor.isActive('image')) closeFindReplace(); });
    } else if (!selection.empty) {
      rememberSelectionQuery();
    }

    const coords = editor.view.coordsAtPos(selection.from);
    contextualToolbar.classList.remove('hidden');
    contextualToolbar.classList.add('flex');
    const toolbarHeight = contextualToolbar.offsetHeight || 40;
    const top = coords.top - toolbarHeight - 8 < 56
      ? coords.bottom + 8
      : coords.top - toolbarHeight - 8;
    contextualToolbar.style.top = `${Math.max(8, top)}px`;
    contextualToolbar.style.left = `${Math.max(8, Math.min(coords.left, window.innerWidth - contextualToolbar.offsetWidth - 8))}px`;
  }

  function placeFloating(el: HTMLElement, anchor: { top: number; bottom: number; left: number }, width: number) {
    const margin = 8;
    const height = el.offsetHeight || 240;
    const spaceBelow = window.innerHeight - anchor.bottom;
    const openAbove = spaceBelow < Math.min(height + margin, 200) && anchor.top > spaceBelow;
    const top = openAbove
      ? Math.max(margin, anchor.top - height - margin)
      : Math.min(anchor.bottom + margin, Math.max(margin, window.innerHeight - height - margin));
    const left = Math.max(margin, Math.min(anchor.left, window.innerWidth - width - margin));
    el.style.top = `${top}px`;
    el.style.left = `${left}px`;
  }

  editorElement?.addEventListener('click', (event) => {
    const img = (event.target as HTMLElement | null)?.closest('img');
    if (!img || currentEditorMode !== 'visual') return;
    const found = editor.view.posAtCoords({ left: event.clientX, top: event.clientY });
    if (!found) return;
    const $pos = editor.state.doc.resolve(found.pos);
    const after = $pos.nodeAfter;
    const before = $pos.nodeBefore;
    if (after?.type.name === 'image') editor.commands.setNodeSelection(found.pos);
    else if (before?.type.name === 'image') editor.commands.setNodeSelection(found.pos - before.nodeSize);
  });

