      document.querySelectorAll<HTMLButtonElement>('.active-image-align-btn').forEach((btn) => {
        const selected = btn.dataset.align === (attrs.align || 'center');
        btn.classList.toggle('border-blue-600', selected);
        btn.classList.toggle('bg-blue-50', selected);
        btn.classList.toggle('text-blue-700', selected);
