    try {
      const res = await apiFetch('/blogs/ai-seo', {
        method: 'POST',
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.message || 'Failed to run SEO audit.');
      }

      const data = await res.json();
      latestSeoSuggestions = data;

      // Update Score Badge
      const score = data.seoScore || 75;
      if (aiSeoScoreBadge) {
        aiSeoScoreBadge.textContent = `Score: ${score}/100`;
        aiSeoScoreBadge.className = `px-2.5 py-0.5 rounded-full text-xs font-bold border ${
          score >= 80
            ? 'bg-emerald-100 text-emerald-800 border-emerald-300'
            : score >= 60
              ? 'bg-amber-100 text-amber-800 border-amber-300'
              : 'bg-red-100 text-red-800 border-red-300'
        }`;
      }

      // Render Recommendations & Guidelines Audit
      if (aiSeoResults) {
        const currentTitle = titleInput?.value.trim() || '';
        const currentDesc = metaDescInput?.value.trim() || excerptInput?.value.trim() || '';
        const currentAlt = imageAltInput?.value.trim() || '';
        const currentContent = effectiveHtml;

        const titleLen = currentTitle.length;
        const titlePass = titleLen >= 40 && titleLen <= 65;

        const descLen = currentDesc.length;
        const descPass = descLen >= 120 && descLen <= 165;

        const hasTables = /<table|\|\s*---/i.test(currentContent);
        const h2Count = (currentContent.match(/<h2|##\s+/gi) || []).length;
        const h2Pass = h2Count >= 2;

        const checkedTagsCount = document.querySelectorAll<HTMLInputElement>('#field-tags input:checked').length;
        const tagsPass = checkedTagsCount >= 2;
        const altPass = Boolean(currentAlt);

        const guidelineItems = [
          {
            name: 'Title Length (CTR Format)',
            status: titlePass ? 'pass' : titleLen === 0 ? 'error' : 'warn',
            metric: `${titleLen}/60 chars`,
            target: 'Ideal 50–60 chars',
            fix: titlePass ? 'Perfect length for Google SERP' : `AI suggested: "${data.metaTitle}"`,
          },
          {
            name: 'Meta Description Format',
            status: descPass ? 'pass' : descLen === 0 ? 'error' : 'warn',
            metric: `${descLen}/160 chars`,
            target: 'Ideal 140–160 chars',
            fix: descPass ? 'Well-balanced summary' : 'AI prepared an action-oriented 150-char description',
          },
          {
            name: 'Structured Exam Tables',
            status: hasTables ? 'pass' : 'warn',
            metric: hasTables ? 'Tables Present' : 'No tables detected',
            target: 'Overview, Dates, Fee tables',
            fix: hasTables ? 'Tables enhance featured snippets' : 'Add Markdown overview & important dates tables',
          },
          {
            name: 'H2 Section Hierarchy',
            status: h2Pass ? 'pass' : 'warn',
            metric: `${h2Count} H2 headings`,
            target: 'At least 2–4 subheadings',
            fix: h2Pass ? 'Clear hierarchy' : 'Break content into Eligibility, Vacancy & Application stages',
          },
          {
            name: 'Image Alt Text',
            status: altPass ? 'pass' : 'warn',
            metric: altPass ? 'Alt Text Set' : 'Missing alt text',
            target: 'Descriptive alt tag',
            fix: altPass ? 'Good for accessibility & Google Images' : `AI suggested: "${data.imageAltSuggestion || 'Exam notification cover'}"`,
          },
          {
            name: 'Tags & Keywords Coverage',
            status: tagsPass ? 'pass' : 'warn',
            metric: `${checkedTagsCount} tags selected`,
            target: '2–5 relevant tags',
            fix: tagsPass ? 'Tagged for taxonomy' : 'AI will auto-match and check relevant tags from catalog',
          },
        ];

        const passedCount = guidelineItems.filter((g) => g.status === 'pass').length;

        aiSeoResults.innerHTML = `
          <!-- Guidelines Format Checklist -->
          <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">SEO &amp; Editorial Guidelines Audit</span>
              <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold ${passedCount >= 5 ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                ${passedCount} of ${guidelineItems.length} Guidelines Passed
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              ${guidelineItems.map((g) => `
                <div class="p-2.5 rounded-lg border bg-white ${
                  g.status === 'pass'
                    ? 'border-emerald-200'
                    : g.status === 'error'
                      ? 'border-red-200'
                      : 'border-amber-200'
                }">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-semibold text-slate-800 text-[11px] truncate">${g.name}</span>
                    <span class="px-1.5 py-0.2 rounded text-[10px] font-bold ${
                      g.status === 'pass'
                        ? 'bg-emerald-50 text-emerald-700'
                        : g.status === 'error'
                          ? 'bg-red-50 text-red-700'
                          : 'bg-amber-50 text-amber-700'
                    }">${g.status === 'pass' ? '✓ PASS' : g.status === 'error' ? '⚠️ FIX' : '⚡ WARN'}</span>
                  </div>
                  <div class="flex items-center justify-between text-[10px] text-slate-400 font-mono mb-1">
                    <span>${g.metric}</span>
                    <span>${g.target}</span>
                  </div>
                  <p class="text-[10px] text-slate-500 line-clamp-1">${g.fix}</p>
                </div>
              `).join('')}
            </div>
          </div>

          <!-- Section A: Optimized Meta Fields -->
          <div class="space-y-3 p-3.5 bg-slate-50 border border-slate-200 rounded-xl">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">AI Recommended Meta Fields (High CTR)</span>
            
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">SEO Title:</span>
                <button type="button" id="apply-ai-title-btn" class="text-[11px] font-bold text-blue-600 hover:text-blue-800 hover:underline">Apply Title</button>
              </div>
              <p class="p-2 bg-white border border-slate-200 rounded text-slate-800 font-medium">${data.metaTitle}</p>
            </div>

            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">Meta Description:</span>
                <button type="button" id="apply-ai-desc-btn" class="text-[11px] font-bold text-blue-600 hover:text-blue-800 hover:underline">Apply Description</button>
              </div>
              <p class="p-2 bg-white border border-slate-200 rounded text-slate-800 leading-relaxed">${data.metaDescription}</p>
            </div>

            ${data.slugSuggestion ? `
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">SEO Slug:</span>
                <button type="button" id="apply-ai-slug-btn" class="text-[11px] font-bold text-blue-600 hover:text-blue-800 hover:underline">Apply Slug</button>
              </div>
              <p class="p-2 bg-white border border-slate-200 rounded text-slate-800 font-mono text-[11px]">/${data.slugSuggestion}</p>
            </div>
            ` : ''}

            ${data.imageAltSuggestion ? `
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">Image Alt Text:</span>
                <button type="button" id="apply-ai-alt-btn" class="text-[11px] font-bold text-blue-600 hover:text-blue-800 hover:underline">Apply Alt Text</button>
              </div>
              <p class="p-2 bg-white border border-slate-200 rounded text-slate-800">${data.imageAltSuggestion}</p>
            </div>
            ` : ''}
          </div>

          <!-- Section B: Keywords & Tags -->
          <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">Identified Search Keywords &amp; Tags</span>
              <button type="button" id="apply-ai-tags-btn" class="text-[11px] font-bold text-blue-600 hover:text-blue-800 hover:underline">Match &amp; Check Tags</button>
            </div>
            <div class="flex flex-wrap gap-1.5">
              ${(data.keywords?.primary || []).map((k: string) => `<span class="px-2 py-0.5 bg-blue-100 text-blue-800 border border-blue-200 rounded-full font-medium text-[11px]">★ ${k}</span>`).join('')}
              ${(data.keywords?.secondary || []).map((k: string) => `<span class="px-2 py-0.5 bg-slate-200/80 text-slate-700 rounded-full text-[11px]">${k}</span>`).join('')}
            </div>
          </div>

          <!-- Section C: Content & Formatting Diagnostics -->
          <div class="space-y-2">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">Content &amp; Structure Diagnostics</span>
            ${(data.formattingIssues || []).length === 0 ? `
              <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 font-medium flex items-center gap-2">
                <span>✓ No critical formatting issues found! Excellent structure.</span>
              </div>
            ` : (data.formattingIssues || []).map((issue: any) => `
              <div class="p-3 rounded-xl border ${
                issue.type === 'error'
                  ? 'bg-red-50 border-red-200 text-red-900'
                  : issue.type === 'warning'
                    ? 'bg-amber-50 border-amber-200 text-amber-900'
                    : 'bg-blue-50 border-blue-200 text-blue-900'
              }">
                <div class="flex items-center gap-1.5 font-bold mb-0.5">
                  <span>${issue.type === 'error' ? '⚠️' : issue.type === 'warning' ? '⚡' : 'ℹ️'}</span>
                  <span>${issue.message}</span>
                </div>
                <p class="text-[11px] opacity-90 pl-5"><strong>Fix:</strong> ${issue.fix}</p>
              </div>
            `).join('')}
          </div>

          <!-- Section D: Ranking Tips -->
          ${(data.suggestions || []).length > 0 ? `
          <div class="p-3.5 bg-indigo-50 border border-indigo-200 rounded-xl space-y-1.5 text-indigo-900">
            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700 block">Ranking &amp; Traffic Suggestions</span>
            <ul class="list-disc list-inside space-y-1 text-[11px]">
              ${data.suggestions.map((s: string) => `<li>${s}</li>`).join('')}
            </ul>
          </div>
          ` : ''}
        `;

        // Wire individual apply buttons
        document.getElementById('apply-ai-title-btn')?.addEventListener('click', () => {
          if (titleInput) titleInput.value = data.metaTitle;
          if (metaTitleInput) metaTitleInput.value = data.metaTitle;
          updateSerp();
          triggerAutosave();
          alert('Applied SEO Title!');
        });

        document.getElementById('apply-ai-desc-btn')?.addEventListener('click', () => {
          if (metaDescInput) metaDescInput.value = data.metaDescription;
          if (excerptInput && !excerptInput.value.trim()) excerptInput.value = data.metaDescription;
          updateSerp();
          triggerAutosave();
          alert('Applied Meta Description!');
        });

        document.getElementById('apply-ai-slug-btn')?.addEventListener('click', () => {
          if (slugInput && data.slugSuggestion) {
            slugInput.value = data.slugSuggestion;
            updateSerp();
            triggerAutosave();
            alert('Applied SEO Slug!');
          }
        });

        document.getElementById('apply-ai-alt-btn')?.addEventListener('click', () => {
          if (imageAltInput && data.imageAltSuggestion) {
            imageAltInput.value = data.imageAltSuggestion;
            triggerAutosave();
            alert('Applied Image Alt Text!');
          }
        });

        document.getElementById('apply-ai-tags-btn')?.addEventListener('click', () => {
          const allKw = [
            ...(data.keywords?.primary || []),
            ...(data.keywords?.secondary || []),
          ];
          applyKeywordsAndTags(allKw);
          triggerAutosave();
          alert('Matched and checked relevant tags!');
        });
      }

      aiSeoLoading?.classList.add('hidden');
      aiSeoResults?.classList.remove('hidden');
      applyAllSeoBtn?.classList.remove('hidden');
      applyAllSeoBtn?.classList.add('flex');
    } catch (err: any) {
      if (aiSeoResults) {
        aiSeoResults.innerHTML = `
          <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-800 space-y-1">
            <p class="font-bold">Audit failed</p>
            <p class="text-xs">${err.message || 'Please ensure GEMINI_API_KEY is configured in apps/server/.env.'}</p>
          </div>
        `;
      }
      aiSeoLoading?.classList.add('hidden');
      aiSeoResults?.classList.remove('hidden');
    }
  });

  // Apply All SEO Recommendations
  applyAllSeoBtn?.addEventListener('click', () => {
    if (!latestSeoSuggestions) return;
    if (titleInput && latestSeoSuggestions.metaTitle) titleInput.value = latestSeoSuggestions.metaTitle;
    if (metaTitleInput && latestSeoSuggestions.metaTitle) metaTitleInput.value = latestSeoSuggestions.metaTitle;
    if (metaDescInput && latestSeoSuggestions.metaDescription) metaDescInput.value = latestSeoSuggestions.metaDescription;
    if (excerptInput && (latestSeoSuggestions.excerptSuggestion || latestSeoSuggestions.metaDescription)) {
      excerptInput.value = latestSeoSuggestions.excerptSuggestion || latestSeoSuggestions.metaDescription;
    }
    if (slugInput && latestSeoSuggestions.slugSuggestion) {
      slugInput.value = latestSeoSuggestions.slugSuggestion;
    }
    if (imageAltInput && latestSeoSuggestions.imageAltSuggestion) {
      imageAltInput.value = latestSeoSuggestions.imageAltSuggestion;
    }

    // Auto-match keywords to tags
    const allKw = [
      ...(latestSeoSuggestions.keywords?.primary || []),
      ...(latestSeoSuggestions.keywords?.secondary || []),
    ];
    applyKeywordsAndTags(allKw);

    updateSerp();
    triggerAutosave();
    closeAiSeoModal();
    alert('Applied all AI SEO recommendations: Title, Description, Slug, Alt Text, and matched Tags.');
  });

  function fillAuthorSelect(authors: { id: string; name: string; role?: string }[], selectedId?: string) {
    const authorSelect = document.getElementById('field-author') as HTMLSelectElement | null;
    if (!authorSelect) return;
    const current = selectedId || authorSelect.value;
    authorSelect.replaceChildren();
    for (const author of authors) {
      const option = document.createElement('option');
      option.value = author.id;
      option.textContent = author.role ? `${author.name} · ${author.role}` : author.name;
      authorSelect.appendChild(option);
    }
    if (current && ![...authorSelect.options].some((option) => option.value === current)) {
      const option = document.createElement('option');
      option.value = current;
      option.textContent = 'Current author';
      authorSelect.appendChild(option);
    }
    if (current) authorSelect.value = current;
  }

  async function init() {
    const authorsRes = await apiFetch('/authors');
    if (authorsRes.ok) fillAuthorSelect(await authorsRes.json());
    const tagsRes = await apiFetch('/tags');
    if (tagsRes.ok) {
      tagCatalog = await tagsRes.json();
      fillTags();
    }

    // 1. Categories
    const catRes = await apiFetch('/categories');
    if (catRes.ok) {
      categoriesCache = await catRes.json();
      if (categorySelect) {
        categorySelect.innerHTML = '<option value="">Select a blog category...</option>' + 
          categoriesCache.map((c: any) => `<option value="${c.id}">${c.name}</option>`).join('');
      }
    }

    // 2. Fetch existing post if editing
    if (editId) {
      const res = await apiFetch(`/me/blogs/${editId}`);
      if (res.ok) {
        const post = await res.json();
        currentVersion = post.version;
        if (titleInput) titleInput.value = post.title || '';
        if (slugInput) slugInput.value = post.slug || '';
        if (excerptInput) excerptInput.value = post.description || '';
        if (categorySelect && post.categoryId) categorySelect.value = post.categoryId;
        if (statusSelect && post.status) {
          statusSelect.value = post.status;
          if (post.status === 'SCHEDULED') scheduleDateGroup?.classList.remove('hidden');
          const publishLabel = document.getElementById('publish-label');
          if (publishLabel && post.status === 'PUBLISHED') {
            publishLabel.textContent = 'Update';
          }
        }
        if (metaTitleInput) metaTitleInput.value = post.metaTitle || '';
        if (metaDescInput) metaDescInput.value = post.metaDescription || '';
        if (coverImageInput) coverImageInput.value = post.coverImage || '';
        if (imageAltInput) imageAltInput.value = post.imageAlt || '';
        if (imageCaptionInput) imageCaptionInput.value = post.imageCaption || '';
        if (canonicalUrlInput) canonicalUrlInput.value = post.canonicalUrl || '';
        if (noindexCheckbox) noindexCheckbox.checked = post.noindex ?? false;
        if (scheduledAtInput && post.scheduledAt) {
          scheduledAtInput.value = new Date(post.scheduledAt).toISOString().slice(0, 16);
        }
        if (languageSelect && post.language) {
          languageSelect.value = post.language;
        }
        if (translationStatusMsg) {
          if (post.translationGroupId) {
            translationStatusMsg.innerHTML = `<span class="text-blue-600 font-semibold">Linked Group:</span> <span class="font-mono text-[10px] text-slate-500">${post.translationGroupId.slice(0, 8)}...</span>`;
          } else {
            translationStatusMsg.textContent = 'No linked translation created yet.';
          }
        }

        const authorSelect = document.getElementById('field-author') as HTMLSelectElement | null;
        if (authorSelect && post.authorId) {
          if (![...authorSelect.options].some((option) => option.value === post.authorId)) {
            const option = document.createElement('option');
            option.value = post.authorId;
            option.textContent = 'Current author';
            authorSelect.appendChild(option);
          }
          authorSelect.value = post.authorId;
        }
        if (Array.isArray(post.tags)) fillTags(post.tags.map((tag: { id: string }) => tag.id));

        if (docVersionDisplay) docVersionDisplay.textContent = `${post.version}`;

        if (post.htmlContent) {
          editor.commands.setContent(post.htmlContent);
          if (markdownTextarea) {
            markdownTextarea.value = turndownService.turndown(post.htmlContent);
            updateLineNumbers();
          }
        }

        currentTranslationGroupId = post.translationGroupId || null;
        const isPostEnglish = post.language === 'ENGLISH';
        if (isPostEnglish) {
          englishBlogId = post.id;
          hinglishBlogId = post.linkedBlog?.id || null;
        } else {
          hinglishBlogId = post.id;
          englishBlogId = post.linkedBlog?.id || null;
        }

        const postMd = post.htmlContent ? turndownService.turndown(post.htmlContent) : '';
        if (isPostEnglish) {
          if (compareEnglishTitle) compareEnglishTitle.value = post.title || '';
          if (compareEnglishSlug) compareEnglishSlug.value = post.slug || '';
          if (compareEnglishExcerpt) compareEnglishExcerpt.value = post.description || '';
          if (compareEnglishMarkdown) compareEnglishMarkdown.value = postMd;
          if (post.linkedBlog) {
            const linkedMd = post.linkedBlog.htmlContent ? turndownService.turndown(post.linkedBlog.htmlContent) : '';
            if (compareHinglishTitle) compareHinglishTitle.value = post.linkedBlog.title || '';
            if (compareHinglishSlug) compareHinglishSlug.value = post.linkedBlog.slug || '';
            if (compareHinglishExcerpt) compareHinglishExcerpt.value = post.linkedBlog.description || '';
            if (compareHinglishMarkdown) compareHinglishMarkdown.value = linkedMd;
          }
        } else {
          if (compareHinglishTitle) compareHinglishTitle.value = post.title || '';
          if (compareHinglishSlug) compareHinglishSlug.value = post.slug || '';
          if (compareHinglishExcerpt) compareHinglishExcerpt.value = post.description || '';
          if (compareHinglishMarkdown) compareHinglishMarkdown.value = postMd;
          if (post.linkedBlog) {
            const linkedMd = post.linkedBlog.htmlContent ? turndownService.turndown(post.linkedBlog.htmlContent) : '';
            if (compareEnglishTitle) compareEnglishTitle.value = post.linkedBlog.title || '';
            if (compareEnglishSlug) compareEnglishSlug.value = post.linkedBlog.slug || '';
            if (compareEnglishExcerpt) compareEnglishExcerpt.value = post.linkedBlog.description || '';
            if (compareEnglishMarkdown) compareEnglishMarkdown.value = linkedMd;
          }
        }
        updateCompareStats();
      }
    }

    updateMetrics();
    updateSerp();
    updateDocumentOutline();
    refreshSidebarSummaries();
  }

  statusSelect?.addEventListener('change', refreshSidebarSummaries);
  slugInput?.addEventListener('input', refreshSidebarSummaries);
  categorySelect?.addEventListener('change', refreshSidebarSummaries);
  document.getElementById('field-author')?.addEventListener('change', refreshSidebarSummaries);
  document.getElementById('focus-excerpt-row')?.addEventListener('click', () => {
    (document.getElementById('field-excerpt') as HTMLTextAreaElement | null)?.focus();
  });
  document.getElementById('block-library-search')?.addEventListener('input', (event) => {
    const query = (event.target as HTMLInputElement).value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('#block-library section').forEach((section) => {
      let visible = 0;
      section.querySelectorAll<HTMLButtonElement>('.library-tile').forEach((btn) => {
        const label = `${btn.dataset.label || ''} ${btn.textContent || ''}`.toLowerCase();
        const show = !query || label.includes(query);
        btn.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      section.classList.toggle('hidden', visible === 0);
    });
  });
  document.getElementById('back-to-block-library')?.addEventListener('click', () => {
    document.getElementById('block-library')?.scrollIntoView({ block: 'start' });
    (document.getElementById('block-library-search') as HTMLInputElement | null)?.focus();
  });

  init();
</script>
