      if (aiResETitle) aiResETitle.textContent = data.english?.title || '';
      if (aiResEExcerpt) aiResEExcerpt.textContent = data.english?.excerpt || '';
      if (aiResESlug) aiResESlug.textContent = `/${data.english?.slug || ''}`;
      if (aiResEWords) {
