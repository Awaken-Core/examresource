---
import Layout from '../layouts/Layout.astro';
import { STATES_LIST, CATEGORIES_LIST } from '../data/portalMockData';
let auth: any = null;
try {
  auth = typeof Astro.locals.auth === 'function' ? Astro.locals.auth() : null;
} catch (_) {}
const userId = auth?.userId;
if (!userId && auth?.redirectToSignIn) return auth.redirectToSignIn();
---

<Layout
  title="Article Editor - ExamPortal"
  description="Create and edit government exam articles, notifications, admit cards, and results."
>
  <script>
    const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';
    const clerk = (window as Window & { Clerk?: { session?: { getToken: () => Promise<string | null> } } }).Clerk;
    const token = await clerk?.session?.getToken();
    const response = await fetch(`${apiUrl}/me`, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
    const user = response.ok ? await response.json() : null;
    if (!user || !['editor', 'admin'].includes(user.role)) window.location.replace('/');
  </script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    
    {/* Editor Header Bar with Actions */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/admin" class="hover:text-blue-700">← Back to Admin Dashboard</a>
          <span>/</span>
          <span class="text-slate-800 font-semibold">Article Editor</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Exam Article Content Editor
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Compose structured government exam articles with headings, tables, guidelines, and instant live preview.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          id="toggle-preview-btn"
          class="px-3.5 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm flex items-center gap-1.5 transition"
        >
          <span>👁️</span>
          <span id="preview-btn-text">Live Preview</span>
        </button>

        <button 
          id="save-draft-btn"
          class="px-3.5 py-2 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold text-xs sm:text-sm transition"
        >
          Save Draft
        </button>

        <button 
          id="publish-btn"
          class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm shadow-xs transition"
        >
          Publish Article
        </button>
      </div>
    </div>

    {/* Toast notification message */}
    <div id="editor-toast" class="hidden my-4 p-3 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-between">
      <span id="editor-toast-text">Article saved successfully!</span>
      <button id="editor-toast-close" class="text-emerald-700 font-bold ml-2">✕</button>
    </div>

    {/* Main Workspace: Split into Form View & Live Preview Panel */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
      
      {/* Editor Fields Column */}
      <div id="editor-form-col" class="lg:col-span-7 space-y-6">
        
        {/* Core Post Metadata Card */}
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-2xs space-y-4">
          <h2 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2 flex items-center gap-2">
            <span>📝</span>
            <span>Article Primary Details</span>
          </h2>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Article Headline / Title *</label>
            <input 
              type="text" 
              id="field-title"
              value="Bihar DECE LE Seat Allotment Result 2026: 1st Round Allotment Letter Download Link"
              class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-sm font-semibold text-slate-900 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">URL Slug</label>
              <input 
                type="text" 
                id="field-slug"
                value="bihar-dece-le-seat-allotment-2026"
                class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-700 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Target State *</label>
              <select 
                id="field-state"
                class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
              >
                {STATES_LIST.map(st => (
                  <option value={st} selected={st === 'Bihar'}>{st}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Category *</label>
              <select 
                id="field-category"
                class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
              >
                {CATEGORIES_LIST.filter(c => c.id !== 'all').map(c => (
                  <option value={c.name} selected={c.name === 'Admission & Counselling'}>{c.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Notice / Advertisement No.</label>
              <input 
                type="text" 
                id="field-notice"
                value="BCECEB(DECE-LE)-2026/08"
                class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-700 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Executive Summary / Intro Paragraph</label>
            <textarea 
              id="field-summary"
              rows="3"
              class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-xs text-slate-800 leading-relaxed focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
            >Bihar Combined Entrance Competitive Examination Board (BCECEB) has officially released the Round 1 Seat Allotment result for Lateral Entry Polytechnic diploma admissions.</textarea>
          </div>
        </div>

        {/* Content Body Editor with Formatting Bar */}
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-2xs space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <span>📄</span>
              <span>Rich Article Content</span>
            </h2>
            <span class="text-[11px] text-slate-400">HTML / Markdown Supported</span>
          </div>

          {/* Editor Quick Insert Toolbar */}
          <div class="flex flex-wrap items-center gap-1.5 p-1.5 bg-slate-100 rounded-lg text-xs">
            <button type="button" class="insert-tag px-2 py-1 bg-white hover:bg-slate-200 rounded font-semibold text-slate-700" data-tag="h2">H2 Heading</button>
            <button type="button" class="insert-tag px-2 py-1 bg-white hover:bg-slate-200 rounded font-semibold text-slate-700" data-tag="h3">H3 Heading</button>
            <button type="button" class="insert-tag px-2 py-1 bg-white hover:bg-slate-200 rounded font-semibold text-slate-700" data-tag="p">Paragraph</button>
            <button type="button" class="insert-tag px-2 py-1 bg-white hover:bg-slate-200 rounded font-semibold text-slate-700" data-tag="list">Bullet List</button>
            <button type="button" class="insert-tag px-2 py-1 bg-white hover:bg-slate-200 rounded font-semibold text-slate-700" data-tag="table">Table Format</button>
            <button type="button" class="insert-tag px-2 py-1 bg-white hover:bg-slate-200 rounded font-semibold text-slate-700" data-tag="link">Direct Link</button>
          </div>

          <textarea 
            id="field-content"
            rows="12"
            class="w-full font-mono bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs leading-relaxed text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
          ><h2>Bihar DECE LE 2026: Important Counselling Schedule</h2>
<p>Candidates can check their college and branch allotment by logging into the official portal using their Roll Number and Password.</p>

<h3>Key Instructions for Document Verification:</h3>
<ul>
  <li>Download 3 clear copies of the provisional allotment order.</li>
  <li>Carry original matriculation and intermediate certificates.</li>
  <li>Report at the allotted nodal center before 16 October 2026.</li>
</ul>

<h3>Direct Verification Links:</h3>
<p><a href="https://bceceboard.bihar.gov.in" target="_blank">Download Round 1 Allotment Letter ↗</a></p></textarea>
        </div>

        {/* SEO & Featured Media Card */}
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-2xs space-y-3">
          <h2 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2 flex items-center gap-2">
            <span>🔍</span>
            <span>SEO & Media Settings</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Featured Image URL</label>
              <input 
                type="text" 
                id="field-image"
                value="/images/bihar-dece-le-allotment-2026.webp"
                class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-700 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Meta Keywords</label>
              <input 
                type="text" 
                id="field-keywords"
                value="bihar dece le allotment, bceceb lateral entry 2026"
                class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs text-slate-700 focus:bg-white focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
              />
            </div>
          </div>
        </div>
      </div>

      {/* Live Preview Panel (5 cols on lg) */}
      <div id="preview-panel-col" class="lg:col-span-5 space-y-4">
        <div class="sticky top-20 bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <h2 class="text-sm font-bold text-slate-900">Live Article Preview</h2>
            </div>
            <span id="preview-status-pill" class="text-[10px] bg-blue-100 text-blue-800 font-semibold px-2 py-0.5 rounded-full">
              Live Rendering
            </span>
          </div>

          {/* Rendered Preview Container */}
          <div class="mt-4 space-y-3">
            <div class="flex items-center gap-2">
              <span id="prev-category" class="bg-blue-50 text-blue-700 text-[10px] font-bold px-2 py-0.5 rounded">
                Admission & Counselling
              </span>
              <span id="prev-state" class="bg-slate-100 text-slate-700 text-[10px] font-semibold px-2 py-0.5 rounded">
                📍 Bihar
              </span>
            </div>

            <h3 id="prev-title" class="text-base font-extrabold text-slate-900 leading-snug">
              Bihar DECE LE Seat Allotment Result 2026: 1st Round Allotment Letter Download Link
            </h3>

            <div class="text-[11px] text-slate-400 pb-2 border-b border-slate-100 flex items-center justify-between">
              <span>By ExamPortal Team</span>
              <span id="prev-date">Today</span>
            </div>

            <div class="bg-blue-50/70 border-l-3 border-blue-600 p-2.5 rounded-r text-xs text-blue-900 font-medium">
              <p id="prev-summary">
                Bihar Combined Entrance Competitive Examination Board (BCECEB) has officially released the Round 1 Seat Allotment result.
              </p>
            </div>

            {/* Injected Content Body */}
            <div id="prev-content" class="text-xs text-slate-700 space-y-2 leading-relaxed pt-2">
              {/* Dynamic live HTML rendered here */}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  const titleInput = document.getElementById('field-title') as HTMLInputElement | null;
  const categoryInput = document.getElementById('field-category') as HTMLSelectElement | null;
  const stateInput = document.getElementById('field-state') as HTMLSelectElement | null;
  const summaryInput = document.getElementById('field-summary') as HTMLTextAreaElement | null;
  const contentInput = document.getElementById('field-content') as HTMLTextAreaElement | null;

  const prevTitle = document.getElementById('prev-title');
  const prevCategory = document.getElementById('prev-category');
  const prevState = document.getElementById('prev-state');
  const prevSummary = document.getElementById('prev-summary');
  const prevContent = document.getElementById('prev-content');

  const toast = document.getElementById('editor-toast');
  const toastText = document.getElementById('editor-toast-text');
  const toastClose = document.getElementById('editor-toast-close');
  const saveDraftBtn = document.getElementById('save-draft-btn');
  const publishBtn = document.getElementById('publish-btn');
  const togglePreviewBtn = document.getElementById('toggle-preview-btn');
  const previewPanel = document.getElementById('preview-panel-col');

  function updateLivePreview() {
    if (prevTitle && titleInput) prevTitle.textContent = titleInput.value || 'Untitled Article';
    if (prevCategory && categoryInput) prevCategory.textContent = categoryInput.value;
    if (prevState && stateInput) prevState.textContent = `📍 ${stateInput.value}`;
    if (prevSummary && summaryInput) prevSummary.textContent = summaryInput.value;
    if (prevContent && contentInput) {
      prevContent.innerHTML = contentInput.value;
    }
  }

  titleInput?.addEventListener('input', updateLivePreview);
  categoryInput?.addEventListener('change', updateLivePreview);
  stateInput?.addEventListener('change', updateLivePreview);
  summaryInput?.addEventListener('input', updateLivePreview);
  contentInput?.addEventListener('input', updateLivePreview);

  // Initial render
  updateLivePreview();

  // Toolbar tag insertion
  document.querySelectorAll<HTMLButtonElement>('.insert-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag;
      if (!contentInput) return;

      let snippet = '';
      if (tag === 'h2') snippet = '\n<h2>Section Title</h2>\n';
      else if (tag === 'h3') snippet = '\n<h3>Subheading Title</h3>\n';
      else if (tag === 'p') snippet = '\n<p>Add detailed descriptive text here.</p>\n';
      else if (tag === 'list') snippet = '\n<ul>\n  <li>Important item 1</li>\n  <li>Important item 2</li>\n</ul>\n';
      else if (tag === 'table') snippet = '\n<table class="w-full text-xs border border-slate-200 my-2">\n  <tr class="bg-slate-100 font-bold"><td>Column 1</td><td>Column 2</td></tr>\n  <tr><td>Value 1</td><td>Value 2</td></tr>\n</table>\n';
      else if (tag === 'link') snippet = '\n<a href="https://example.com" class="text-blue-600 underline font-semibold">Official Link Here ↗</a>\n';

      const start = contentInput.selectionStart;
      const end = contentInput.selectionEnd;
      const text = contentInput.value;
      contentInput.value = text.substring(0, start) + snippet + text.substring(end);
      contentInput.focus();
      updateLivePreview();
    });
  });

  function showEditorToast(message: string) {
    if (toast && toastText) {
      toastText.textContent = message;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }
  }

  toastClose?.addEventListener('click', () => {
    toast?.classList.add('hidden');
  });

  saveDraftBtn?.addEventListener('click', () => {
    showEditorToast('Draft saved successfully to local state!');
  });

  publishBtn?.addEventListener('click', () => {
    showEditorToast('Article published! Live in public portal state filters.');
  });

  // Mobile toggle preview
  togglePreviewBtn?.addEventListener('click', () => {
    if (previewPanel) {
      previewPanel.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>
