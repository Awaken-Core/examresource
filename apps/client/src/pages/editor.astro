  // Save Both Hinglish and English Blogs Together (Linked via translationGroupId)
  async function saveBilingualBlogs() {
    const hTitle = compareHinglishTitle?.value.trim() || '';
    const hMd = compareHinglishMarkdown?.value.trim() || '';
    const eTitle = compareEnglishTitle?.value.trim() || '';
    const eMd = compareEnglishMarkdown?.value.trim() || '';

    if (!hTitle || !hMd) {
      alert('Please provide title and markdown content for the Hinglish blog.');
      return;
    }
    if (!eTitle || !eMd) {
      alert('Please provide title and markdown content for the English blog.');
      return;
    }

    const categorySelect = document.getElementById('field-category') as HTMLSelectElement | null;
    const coverImageInput = document.getElementById('field-cover-image') as HTMLInputElement | null;
    const imageAltInput = document.getElementById('field-image-alt') as HTMLInputElement | null;
    const statusSelect = document.getElementById('field-status') as HTMLSelectElement | null;

    if (compareSaveBilingualBtn) {
      compareSaveBilingualBtn.setAttribute('disabled', 'true');
      compareSaveBilingualBtn.textContent = 'Saving Both...';
    }

    try {
      const hHtml = DOMPurify.sanitize(String(await marked.parse(hMd)), DOMPURIFY_CONFIG);
      const eHtml = DOMPurify.sanitize(String(await marked.parse(eMd)), DOMPURIFY_CONFIG);

      const payload = {
        categoryId: categorySelect?.value || null,
        coverImage: coverImageInput?.value || null,
        imageAlt: imageAltInput?.value || null,
        status: statusSelect?.value || 'DRAFT',
        tagIds: [...document.querySelectorAll<HTMLInputElement>('#field-tags input:checked')].map((input) => input.value),
        translationGroupId: currentTranslationGroupId || undefined,
        hinglish: {
          id: hinglishBlogId || (languageSelect?.value === 'HINGLISH' && currentPostId ? currentPostId : undefined),
          title: hTitle,
          slug: compareHinglishSlug?.value.trim() || hTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') + '-hinglish',
          markdown: hMd,
          htmlContent: hHtml,
          excerpt: compareHinglishExcerpt?.value.trim() || '',
        },
        english: {
          id: englishBlogId || (languageSelect?.value === 'ENGLISH' && currentPostId ? currentPostId : undefined),
          title: eTitle,
          slug: compareEnglishSlug?.value.trim() || eTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') + '-english',
          markdown: eMd,
          htmlContent: eHtml,
          excerpt: compareEnglishExcerpt?.value.trim() || '',
        },
      };

      const res = await apiFetch('/blogs/save-bilingual', {
        method: 'POST',
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.message || `HTTP ${res.status}`);
      }

      const data = await res.json();
      isDirty = false;

      if (data.hinglish?.id) hinglishBlogId = data.hinglish.id;
      if (data.english?.id) englishBlogId = data.english.id;
      if (data.translationGroupId) currentTranslationGroupId = data.translationGroupId;

      if (languageSelect?.value === 'ENGLISH' && data.english?.id) {
        currentPostId = data.english.id;
        window.history.replaceState({}, '', `/editor?edit=${data.english.id}`);
      } else if (data.hinglish?.id) {
        currentPostId = data.hinglish.id;
        window.history.replaceState({}, '', `/editor?edit=${data.hinglish.id}`);
      }

      if (data.hinglish?.slug && compareHinglishSlug) compareHinglishSlug.value = data.hinglish.slug;
      if (data.english?.slug && compareEnglishSlug) compareEnglishSlug.value = data.english.slug;

      if (saveStatusEl) {
        saveStatusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>Saved</span>`;
      }
      if (docLastSavedTime) {
        docLastSavedTime.textContent = `Saved at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
      }

      if (translationStatusMsg && data.translationGroupId) {
        translationStatusMsg.innerHTML = `<span class="text-blue-600 font-semibold">Linked Group:</span> <span class="font-mono text-[10px] text-slate-500">${data.translationGroupId.slice(0, 8)}...</span>`;
      }

      if (compareSyncBadge) {
        compareSyncBadge.className = 'px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
        compareSyncBadge.textContent = 'Both Drafts Persisted';
      }
    } catch (err: any) {
      console.error('Save bilingual failed:', err);
      alert(`Failed to save bilingual articles: ${err.message}`);
    } finally {
      if (compareSaveBilingualBtn) {
        compareSaveBilingualBtn.removeAttribute('disabled');
        compareSaveBilingualBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg><span>Save Both Drafts</span>`;
      }
    }
  }

