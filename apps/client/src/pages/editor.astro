  <!-- Public Layout Realtime Preview Modal -->
  <div id="live-preview-modal" class="fixed inset-0 bg-slate-900/60 z-50 hidden flex-col">
    <div class="h-14 bg-white border-b border-slate-200 px-6 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-bold text-slate-900">Public Article Layout Simulation</span>
      </div>
      <button id="close-preview-modal" class="px-3 py-1.5 text-xs font-semibold border border-slate-200 rounded-md text-slate-700 hover:bg-slate-50">
        Close Preview ✕
      </button>
    </div>
    <div class="flex-1 overflow-y-auto bg-slate-100 p-6 sm:p-12 flex justify-center">
      <article class="max-w-3xl w-full bg-white border border-slate-200 rounded-2xl p-8 sm:p-14 space-y-6 shadow-sm">
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <span class="bg-blue-50 text-blue-700 font-semibold px-2 py-0.5 rounded" id="prev-modal-cat">General</span>
          <span>• Published: Today</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight" id="prev-modal-title">Article Title</h1>
        
        <figure id="prev-modal-cover-box" class="hidden my-4">
          <img id="prev-modal-cover-img" src="" alt="Cover" class="w-full h-auto max-h-96 object-cover rounded-xl" />
          <figcaption id="prev-modal-cover-caption" class="text-xs text-slate-400 text-center mt-2"></figcaption>
        </figure>

        <div class="text-slate-600 leading-relaxed text-sm border-l-2 border-blue-600 pl-3 italic" id="prev-modal-excerpt"></div>
        <div class="prose-markdown markdown-preview-content max-w-none pt-4 border-t border-slate-100 text-slate-800" id="prev-modal-content"></div>
      </article>
    </div>
  </div>
</AdminLayout>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Link from '@tiptap/extension-link';
  import Image from '@tiptap/extension-image';
  import { Table, TableRow, TableCell, TableHeader } from '@tiptap/extension-table';
  import Underline from '@tiptap/extension-underline';
  import CharacterCount from '@tiptap/extension-character-count';
  import { marked } from 'marked';
  import TurndownService from 'turndown';
  import DOMPurify from 'dompurify';

  // Configure marked for GitHub flavored markdown with tables and standard rules
  const markedRenderer = new marked.Renderer();
  markedRenderer.heading = function ({ tokens, depth, text }: any) {
    const rawText = text || this.parser.parseInline(tokens);
    const cleanText = rawText.replace(/<[^>]*>/g, '');
    const id = cleanText.toLowerCase().trim().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-');
    return `<h${depth} id="${id}">${rawText}</h${depth}>\n`;
  };

  marked.setOptions({
    gfm: true,
    breaks: false, // Standard GitHub Markdown does not convert single soft newlines to <br> unless two spaces or a blank line exist
    pedantic: false,
    renderer: markedRenderer,
  });

  // Safe DOMPurify configuration allowing standard GFM article tags and safe attributes
  const DOMPURIFY_CONFIG = {
    ALLOWED_TAGS: [
      'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
      'p', 'span', 'strong', 'b', 'em', 'i', 'u', 's', 'del', 'strike',
      'blockquote', 'pre', 'code', 'hr', 'br',
      'ul', 'ol', 'li',
      'table', 'thead', 'tbody', 'tfoot', 'tr', 'th', 'td',
      'a', 'img', 'figure', 'figcaption',
      'div'
    ],
    ALLOWED_ATTR: [
      'href', 'src', 'alt', 'title', 'class', 'id', 'target', 'rel',
      'width', 'height', 'loading'
    ],
    ALLOWED_URI_REGEXP: /^(?:(?:https?|mailto):|[^a-z]|[a-z+.\-]+(?:[^a-z+.\-:]|$))/i,
  };

  // Configure turndown to serialize HTML to clean GitHub-style markdown
  const turndownService = new TurndownService({
    headingStyle: 'atx',
    hr: '---',
    bulletListMarker: '-',
    codeBlockStyle: 'fenced',
  });

  // Custom turndown rule for tables
  turndownService.addRule('table', {
    filter: 'table',
    replacement: function (content, node: any) {
      const rows = Array.from(node.querySelectorAll('tr'));
      if (rows.length === 0) return '';
      let md = '\n\n';
      rows.forEach((row: any, rIdx) => {
        const cells = Array.from(row.querySelectorAll('th, td'));
        const rowStr = cells.map((c: any) => c.textContent.trim().replace(/\|/g, '\\|')).join(' | ');
        md += `| ${rowStr} |\n`;
        if (rIdx === 0) {
          const sep = cells.map(() => '---').join(' | ');
          md += `| ${sep} |\n`;
        }
      });
      return md + '\n';
    },
  });

  // Custom turndown rule for callouts
  turndownService.addRule('callout', {
    filter: function (node) {
      return (
        node.nodeName === 'DIV' &&
        (node.className.includes('callout') || node.className.includes('alert'))
      );
    },
    replacement: function (content) {
      return `\n\n> **Note:** ${content.trim()}\n\n`;
    },
  });

  const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';

  let authTokenPromise: Promise<string | null> | undefined;

  async function getAuthToken(): Promise<string | null> {
    authTokenPromise ??= (async () => {
      // The page script can run before Clerk finishes restoring its session.
      // Wait briefly so protected requests never leave without a token.
      for (let attempt = 0; attempt < 50; attempt += 1) {
        const clerk = (window as any).Clerk;
        if (clerk?.loaded && clerk.session) {
          return clerk.session.getToken().catch(() => null);
        }
        await new Promise((resolve) => setTimeout(resolve, 100));
      }
      return null;
    })();

    const token = await authTokenPromise;
    if (!token) authTokenPromise = undefined;
    return token;
  }

  async function apiFetch(endpoint: string, options: RequestInit = {}) {
    const token = await getAuthToken();
    const headers = new Headers(options.headers || {});
    if (token) headers.set('Authorization', `Bearer ${token}`);
    if (options.body && typeof options.body === 'string' && !headers.has('Content-Type')) {
      headers.set('Content-Type', 'application/json');
    }
    return fetch(`${API_URL}${endpoint}`, { ...options, headers });
  }

  async function uploadImage(file: File): Promise<string> {
    const signResponse = await apiFetch('/uploads/images/sign', {
      method: 'POST',
      body: JSON.stringify({ contentType: file.type, size: file.size }),
    });
    const signed = await signResponse.json().catch(() => null);
    if (!signResponse.ok || !signed?.uploadUrl || !signed?.publicUrl) {
      throw new Error(signed?.message || 'Unable to prepare the image upload.');
    }
    let uploadResponse: Response;
    try {
      uploadResponse = await fetch(signed.uploadUrl, {
        method: 'PUT', headers: { 'Content-Type': file.type }, body: file,
      });
    } catch {
      throw new Error('Could not reach Cloudflare R2. Add this site to the bucket CORS allowed origins and try again.');
    }
    if (!uploadResponse.ok) throw new Error('R2 rejected the upload. Check the bucket CORS policy and try again.');
    return signed.publicUrl;
  }

  // DOM Elements
  const titleInput = document.getElementById('field-title') as HTMLInputElement | null;
  const slugInput = document.getElementById('field-slug') as HTMLInputElement | null;
  const excerptInput = document.getElementById('field-excerpt') as HTMLTextAreaElement | null;
  const categorySelect = document.getElementById('field-category') as HTMLSelectElement | null;
  const statusSelect = document.getElementById('field-status') as HTMLSelectElement | null;
  const scheduledAtInput = document.getElementById('field-scheduled-at') as HTMLInputElement | null;
  const scheduleDateGroup = document.getElementById('schedule-date-group');
  const coverImageInput = document.getElementById('field-cover-image') as HTMLInputElement | null;
  const coverImageFileInput = document.getElementById('cover-image-file-input') as HTMLInputElement | null;
  const uploadCoverImageBtn = document.getElementById('upload-cover-image-btn') as HTMLButtonElement | null;
  const coverUploadStatus = document.getElementById('cover-upload-status');
  const imageAltInput = document.getElementById('field-image-alt') as HTMLInputElement | null;
  const imageCaptionInput = document.getElementById('field-image-caption') as HTMLInputElement | null;
  const imagePreviewBox = document.getElementById('image-preview-box');
  const imagePreviewEl = document.getElementById('image-preview-el') as HTMLImageElement | null;
  const metaTitleInput = document.getElementById('field-meta-title') as HTMLInputElement | null;
  const metaDescInput = document.getElementById('field-meta-desc') as HTMLTextAreaElement | null;
  const canonicalUrlInput = document.getElementById('field-canonical-url') as HTMLInputElement | null;
  const noindexCheckbox = document.getElementById('field-noindex') as HTMLInputElement | null;
  const resultingUrlPreview = document.getElementById('resulting-url-preview');

  // Top Bar elements
  const saveStatusEl = document.getElementById('save-status');
  const wordCountEl = document.getElementById('word-count');
  const readTimeEl = document.getElementById('read-time');
  const serpTitle = document.getElementById('serp-title');
  const serpUrl = document.getElementById('serp-url');
  const serpDesc = document.getElementById('serp-desc');
  const titleCharEl = document.getElementById('title-char-count');
  const descCharEl = document.getElementById('desc-char-count');
  const docVersionDisplay = document.getElementById('doc-version-display');
  const docLastSavedTime = document.getElementById('doc-last-saved-time');

  // Drawers & Sidebars
  const outlineDrawer = document.getElementById('document-outline-drawer');
  const inserterDrawer = document.getElementById('block-inserter-drawer');
  const editorSidebar = document.getElementById('editor-sidebar');
  const contextualToolbar = document.getElementById('contextual-block-toolbar');
  const slashMenuPopover = document.getElementById('slash-menu-popover');
  const slashMenuItems = document.getElementById('slash-menu-items');
  const inlineBlockPlusBtn = document.getElementById('inline-block-plus-btn');
  const inlinePlusTrigger = document.getElementById('inline-plus-trigger');
  const inlineBlockMenu = document.getElementById('inline-block-menu');
  const closeInlineMenuBtn = document.getElementById('close-inline-menu-btn');
  const headerBlockDropdown = document.getElementById('header-block-dropdown');
  const openFullLibraryBtn = document.getElementById('open-full-library-btn');

  // Mode Switcher Elements
  const modeVisualBtn = document.getElementById('mode-visual-btn');
  const modeMarkdownBtn = document.getElementById('mode-markdown-btn');
  const visualEditorSurface = document.getElementById('visual-editor-surface');
  const markdownEditorSurface = document.getElementById('markdown-editor-surface');
  const markdownPreviewSurface = document.getElementById('markdown-preview-surface');
  const markdownTextarea = document.getElementById('markdown-textarea') as HTMLTextAreaElement | null;
  const mdLineNumbers = document.getElementById('md-line-numbers');
  const mdCursorPos = document.getElementById('md-cursor-pos');
  const mdViewPreviewBtn = document.getElementById('md-view-preview-btn');
  const backToEditorBtn = document.getElementById('back-to-editor-btn');
  const previewSurfaceTitle = document.getElementById('preview-surface-title');
  const previewSurfaceCat = document.getElementById('preview-surface-cat');
  const previewSurfaceExcerpt = document.getElementById('preview-surface-excerpt');
  const previewRenderedBody = document.getElementById('preview-rendered-body');
  const mdFileInput = document.getElementById('md-file-input') as HTMLInputElement | null;

  // Query Params & State
  const urlParams = new URLSearchParams(window.location.search);
  const editId = urlParams.get('edit');
  let currentPostId = editId;
  let currentVersion = 1;
  let isDirty = false;
  let categoriesCache: any[] = [];
  let isSlashMenuOpen = false;
  let slashSelectedIndex = 0;
  let slashFilteredList: any[] = [];
  let inlineInsertPos: number | null = null;
  let isInlineMenuOpen = false;
  let currentEditorMode: 'visual' | 'markdown' = 'visual';

  uploadCoverImageBtn?.addEventListener('click', () => coverImageFileInput?.click());
  coverImageFileInput?.addEventListener('change', async () => {
    const file = coverImageFileInput.files?.[0];
    if (!file || !coverImageInput) return;
    coverUploadStatus?.classList.remove('hidden');
    if (coverUploadStatus) coverUploadStatus.textContent = 'Uploading image...';
    if (uploadCoverImageBtn) uploadCoverImageBtn.disabled = true;
    try {
      coverImageInput.value = await uploadImage(file);
      if (coverUploadStatus) coverUploadStatus.textContent = 'Uploaded to Cloudflare R2.';
      updateSerp();
    } catch (error) {
      if (coverUploadStatus) coverUploadStatus.textContent = error instanceof Error ? error.message : 'Image upload failed.';
    } finally {
      if (uploadCoverImageBtn) uploadCoverImageBtn.disabled = false;
      coverImageFileInput.value = '';
    }
  });

  // Unsaved changes confirmation
  window.addEventListener('beforeunload', (e) => {
    if (isDirty) {
      e.preventDefault();
      e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
      return e.returnValue;
    }
  });

  document.getElementById('back-to-posts-btn')?.addEventListener('click', (e) => {
    if (isDirty && !confirm('You have unsaved changes. Leave anyway?')) {
      e.preventDefault();
    }
  });

  // TipTap Instance Setup
  const editorElement = document.getElementById('tiptap-editor');
  const editor = new Editor({
    element: editorElement!,
    extensions: [
      StarterKit.configure({
        heading: { levels: [1, 2, 3, 4] },
      }),
      Underline,
      Link.configure({
        openOnClick: false,
        autolink: true,
      }),
      Image,
      Table.configure({ resizable: true }),
      TableRow,
      TableHeader,
      TableCell,
      CharacterCount,
    ],
    content: `<p>Start writing, type / for blocks, or use Markdown shortcuts like #, ##, -, 1., >.</p>`,
    onUpdate: () => {
      isDirty = true;
      updateMetrics();
      updateSerp();
      updateDocumentOutline();
      checkSlashCommand();
      triggerAutosave();
    },
    onSelectionUpdate: () => {
      if (currentEditorMode === 'visual') {
        updateContextualToolbar();
        updateBlockSettingsSidebar();
        updateInlinePlusButton();
      }
    },
  });

  // ==========================================
  // Markdown Mode Switching & Synchronization
  // ==========================================

  let lastSavedMarkdownCursorPos = 0;

  function showMarkdownPreview() {
    if (!markdownTextarea || !previewRenderedBody) return;
    
    // Save cursor position
    lastSavedMarkdownCursorPos = markdownTextarea.selectionStart || 0;

    const md = markdownTextarea.value;
    const rawHtml = marked.parse(md) as string;
    const cleanHtml = DOMPurify.sanitize(rawHtml, DOMPURIFY_CONFIG);

    // Check if markdown content already starts with an H1 heading
    const startsWithH1 = /^\s*#\s+/m.test(md);
    const previewHeaderMeta = document.getElementById('preview-header-meta');

    // Update Preview Header Information
    if (previewSurfaceTitle) {
      previewSurfaceTitle.textContent = titleInput?.value.trim() || 'Untitled Article';
    }
    if (previewSurfaceCat) {
      previewSurfaceCat.textContent = categorySelect?.options[categorySelect.selectedIndex]?.text || 'General';
    }
    if (previewSurfaceExcerpt) {
      const excerpt = excerptInput?.value.trim();
      if (excerpt) {
        previewSurfaceExcerpt.textContent = excerpt;
        previewSurfaceExcerpt.classList.remove('hidden');
      } else {
        previewSurfaceExcerpt.classList.add('hidden');
      }
    }

    if (previewHeaderMeta) {
      if (startsWithH1) {
        // If Markdown itself starts with an H1 (e.g. # Java Object Lifecycle),
        // hide the top redundant title box so the Markdown H1 is the primary H1
        previewHeaderMeta.classList.add('hidden');
      } else {
        previewHeaderMeta.classList.remove('hidden');
      }
    }

    // Populate rendered preview body
    previewRenderedBody.innerHTML = cleanHtml || '<p class="text-slate-400 italic">No content to preview.</p>';

    // Hide editor surfaces, show preview surface
    markdownEditorSurface?.classList.add('hidden');
    visualEditorSurface?.classList.add('hidden');
    markdownPreviewSurface?.classList.remove('hidden');
    markdownPreviewSurface?.classList.add('flex');

    // Scroll preview to top smoothly
    const mainCanvas = document.getElementById('editor-main-canvas');
    if (mainCanvas) mainCanvas.scrollTop = 0;
  }

  function hideMarkdownPreview() {
    // Hide preview surface, show markdown writing canvas
    markdownPreviewSurface?.classList.add('hidden');
    markdownPreviewSurface?.classList.remove('flex');
    markdownEditorSurface?.classList.remove('hidden');
    markdownEditorSurface?.classList.add('flex');

    // Restore cursor position and focus
    if (markdownTextarea) {
      markdownTextarea.focus();
      try {
        markdownTextarea.setSelectionRange(lastSavedMarkdownCursorPos, lastSavedMarkdownCursorPos);
      } catch (_) {}
      updateCursorPosition();
    }
  }

  mdViewPreviewBtn?.addEventListener('click', showMarkdownPreview);
  backToEditorBtn?.addEventListener('click', hideMarkdownPreview);

  function switchEditorMode(targetMode: 'visual' | 'markdown') {
    if (currentEditorMode === targetMode) return;

    if (targetMode === 'markdown') {
      // 1. Sync visual HTML to Markdown text
      const html = editor.getHTML();
      const markdown = turndownService.turndown(html);
      if (markdownTextarea) {
        markdownTextarea.value = markdown;
        updateLineNumbers();
      }

      // Hide visual and preview surfaces, show markdown editor surface
      visualEditorSurface?.classList.add('hidden');
      markdownPreviewSurface?.classList.add('hidden');
      markdownPreviewSurface?.classList.remove('flex');
      markdownEditorSurface?.classList.remove('hidden');
      markdownEditorSurface?.classList.add('flex');
      contextualToolbar?.classList.add('hidden');

      // Update button styling
      modeVisualBtn?.classList.remove('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      modeVisualBtn?.classList.add('font-medium', 'text-slate-600');
      modeMarkdownBtn?.classList.add('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      modeMarkdownBtn?.classList.remove('font-medium', 'text-slate-600');

      currentEditorMode = 'markdown';
      markdownTextarea?.focus();
    } else {
      // 2. Sync Markdown text to visual HTML
      const markdown = markdownTextarea?.value || '';
      const rawHtml = marked.parse(markdown) as string;
      const cleanHtml = DOMPurify.sanitize(rawHtml, DOMPURIFY_CONFIG);

      // Populate visual TipTap editor
      editor.commands.setContent(cleanHtml);

      // Hide markdown and preview surfaces, show visual surface
      markdownEditorSurface?.classList.add('hidden');
      markdownEditorSurface?.classList.remove('flex');
      markdownPreviewSurface?.classList.add('hidden');
      markdownPreviewSurface?.classList.remove('flex');
      visualEditorSurface?.classList.remove('hidden');

      // Update button styling
      modeMarkdownBtn?.classList.remove('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      modeMarkdownBtn?.classList.add('font-medium', 'text-slate-600');
      modeVisualBtn?.classList.add('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      modeVisualBtn?.classList.remove('font-medium', 'text-slate-600');

      currentEditorMode = 'visual';
      editor.chain().focus();
    }

    updateMetrics();
    updateDocumentOutline();
    updateSerp();
  }

  modeVisualBtn?.addEventListener('click', () => switchEditorMode('visual'));
  modeMarkdownBtn?.addEventListener('click', () => switchEditorMode('markdown'));

  // Markdown Textarea events (Line numbers & Cursor stats)
  markdownTextarea?.addEventListener('input', () => {
    isDirty = true;
    updateLineNumbers();
    updateMetrics();
    updateDocumentOutline();
    triggerAutosave();
  });

  markdownTextarea?.addEventListener('keyup', updateCursorPosition);
  markdownTextarea?.addEventListener('click', updateCursorPosition);

  function updateCursorPosition() {
    if (!markdownTextarea || !mdCursorPos) return;
    const pos = markdownTextarea.selectionStart;
    const lines = markdownTextarea.value.substring(0, pos).split('\n');
    const lineNum = lines.length;
    const colNum = lines[lines.length - 1].length + 1;
    mdCursorPos.textContent = `Ln ${lineNum}, Col ${colNum}`;
  }

  function updateLineNumbers() {
    if (!markdownTextarea || !mdLineNumbers) return;
    const lines = markdownTextarea.value.split('\n').length;
    const lineArr = Array.from({ length: Math.max(lines, 20) }, (_, i) => i + 1);
    mdLineNumbers.innerHTML = lineArr.join('<br>');
  }

  // ==========================================
  // Markdown Import & Export
  // ==========================================

  // 1. Import .md File
  document.getElementById('opt-import-md')?.addEventListener('click', () => {
    mdFileInput?.click();
  });

  mdFileInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    try {
      const text = await file.text();
      applyImportedMarkdown(text, file.name);
    } catch (err) {
      alert('Failed to read Markdown file. Please check file permissions and format.');
    } finally {
      if (mdFileInput) mdFileInput.value = '';
    }
  });

  function applyImportedMarkdown(rawMarkdown: string, fileName?: string) {
    if (!rawMarkdown || !rawMarkdown.trim()) {
      alert('Selected Markdown file is empty.');
      return;
    }

    let markdown = rawMarkdown;

    // Check if markdown begins with frontmatter (---)
    const frontmatterMatch = markdown.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n/);
    if (frontmatterMatch) {
      const frontmatter = frontmatterMatch[1];
      markdown = markdown.substring(frontmatterMatch[0].length);

      // Parse basic frontmatter (title, description, slug)
      const titleM = frontmatter.match(/title:\s*["']?(.*?)["']?$/m);
      if (titleM && titleInput && !titleInput.value) {
        titleInput.value = titleM[1];
      }
      const descM = frontmatter.match(/description:\s*["']?(.*?)["']?$/m);
      if (descM && excerptInput && !excerptInput.value) {
        excerptInput.value = descM[1];
      }
      const slugM = frontmatter.match(/slug:\s*["']?(.*?)["']?$/m);
      if (slugM && slugInput && !slugInput.value) {
        slugInput.value = slugM[1];
      }
    }

    // Check if the document has a top-level # H1 heading to initialize article title if not set
    const h1Match = markdown.match(/^#\s+(.+)$/m);
    if (h1Match) {
      const detectedH1 = h1Match[1].trim();
      if (titleInput && !titleInput.value) {
        titleInput.value = detectedH1;
      }
    } else if (!titleInput?.value && fileName) {
      // Use filename without extension as default title if title is blank
      const cleanName = fileName.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
      if (titleInput) titleInput.value = cleanName;
    }

    // Parse Markdown to semantic HTML and sanitize
    const rawHtml = marked.parse(markdown) as string;
    const safeHtml = DOMPurify.sanitize(rawHtml, DOMPURIFY_CONFIG);

    // Populate Visual Editor & Markdown Textarea
    editor.commands.setContent(safeHtml);
    if (markdownTextarea) {
      markdownTextarea.value = markdown;
      updateLineNumbers();
    }

    isDirty = true;
    updateMetrics();
    updateSerp();
    updateDocumentOutline();
    triggerAutosave();

    alert('Markdown article successfully imported!');
  }

  // 2. Export / Download Article as .md
  document.getElementById('opt-export-md')?.addEventListener('click', () => {
    let mdContent = '';
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      mdContent = markdownTextarea.value;
    } else {
      mdContent = turndownService.turndown(editor.getHTML());
    }

    const title = titleInput?.value.trim() || 'Untitled Article';
    const excerpt = excerptInput?.value.trim() || '';
    const slug = slugInput?.value.trim() || slugify(title);

    // Prepend standard clean Markdown metadata
    const fullMarkdownDoc = `---
title: "${title}"
slug: "${slug}"
description: "${excerpt}"
date: "${new Date().toISOString()}"
---

# ${title}

${mdContent}
`;

    const blob = new Blob([fullMarkdownDoc], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${slug || 'article'}.md`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  });

