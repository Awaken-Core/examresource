      activeBox?.classList.remove('hidden');
      if (blockName) blockName.textContent = 'Heading Block';
      if (blockTag) blockTag.textContent = 'H2-H4';

      imgSec?.classList.add('hidden');
      listSec?.classList.add('hidden');
      codeSec?.classList.add('hidden');
