  async function executeImageInsertion() {
    let finalImageUrl = '';

    if (activeImageTab === 'upload') {
      if (!selectedFileToUpload) {
        alert('Please choose an image file from your computer to upload.');
        return;
      }
      if (articleImageUploadStatus) {
        articleImageUploadStatus.textContent = 'Uploading image to Cloudflare R2...';
        articleImageUploadStatus.classList.remove('hidden');
      }
      if (insertArticleImageBtn) insertArticleImageBtn.disabled = true;

      try {
        finalImageUrl = await uploadImage(selectedFileToUpload);
      } catch (err: any) {
        if (articleImageUploadStatus) articleImageUploadStatus.textContent = err.message || 'Image upload failed.';
        if (insertArticleImageBtn) insertArticleImageBtn.disabled = false;
        return;
      }
    } else if (activeImageTab === 'library') {
      if (!selectedLibraryUrl) {
        alert('Please select an image from the media library.');
        return;
      }
      finalImageUrl = selectedLibraryUrl;
    } else if (activeImageTab === 'url') {
      finalImageUrl = articleImageUrlInput?.value.trim() || '';
      if (!finalImageUrl) {
        alert('Please enter a valid image URL.');
        return;
      }
    }

    if (!finalImageUrl) return;

    const altText = articleImageAltInput?.value.trim() || 'image';
    const caption = articleImageCaptionInput?.value.trim() || '';
    const align = selectedImageAlign();
    const layout = selectedImageLayout() === 'custom' ? align : selectedImageLayout();
    const width = selectedImageWidth();

    if (currentEditorMode === 'markdown' && markdownTextarea) {
      const start = markdownTextarea.selectionStart;
      const end = markdownTextarea.selectionEnd;
      const val = markdownTextarea.value;
      const widthAttr = width ? ` width="${width}"` : '';
      const captionHtml = caption ? `<figcaption>${caption}</figcaption>` : '';
      const mdSnippet = `\n\n<figure class="article-figure" data-align="${align}" data-layout="${layout}"><img src="${finalImageUrl}" alt="${altText}" data-align="${align}" data-layout="${layout}"${widthAttr} />${captionHtml}</figure>\n\n`;

      markdownTextarea.value = val.substring(0, start) + mdSnippet + val.substring(end);
      markdownTextarea.selectionStart = markdownTextarea.selectionEnd = start + mdSnippet.length;
      markdownTextarea.focus();
      updateLineNumbers();
      isDirty = true;
      triggerAutosave();
    } else if (editor) {
      const attrs = {
        src: finalImageUrl,
        alt: altText,
        title: caption,
        align,
        layout,
        width,
        height: null,
      };
      if (typeof articleImageTargetPos === 'number') {
        editor.chain().focus().insertContentAt(articleImageTargetPos, [
          { type: 'image', attrs },
          { type: 'paragraph' },
        ]).run();
      } else {
        editor.chain().focus().setImage(attrs).run();
      }
      revealUploadedImage(finalImageUrl);
    }

    if (insertArticleImageBtn) insertArticleImageBtn.disabled = false;
    closeArticleImageModal();
  }

