    // 3. Update top pill button styling
    if (targetLang === 'HINGLISH') {
      topLangHindiBtn?.classList.add('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      topLangHindiBtn?.classList.remove('font-medium', 'text-slate-600');
      topLangEnglishBtn?.classList.remove('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      topLangEnglishBtn?.classList.add('font-medium', 'text-slate-600');
    } else {
      topLangEnglishBtn?.classList.add('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      topLangEnglishBtn?.classList.remove('font-medium', 'text-slate-600');
      topLangHindiBtn?.classList.remove('font-bold', 'text-slate-900', 'bg-white', 'shadow-xs');
      topLangHindiBtn?.classList.add('font-medium', 'text-slate-600');
    }

    // 4. Retrieve target language content
    const targetTitle = targetLang === 'ENGLISH'
      ? (compareEnglishTitle?.value || '')
      : (compareHinglishTitle?.value || '');
    const targetSlug = targetLang === 'ENGLISH'
      ? (compareEnglishSlug?.value || '')
      : (compareHinglishSlug?.value || '');
    const targetExcerpt = targetLang === 'ENGLISH'
      ? (compareEnglishExcerpt?.value || '')
      : (compareHinglishExcerpt?.value || '');
    const targetMd = targetLang === 'ENGLISH'
      ? (compareEnglishMarkdown?.value || '')
      : (compareHinglishMarkdown?.value || '');

    if (titleInput && targetTitle) titleInput.value = targetTitle;
    if (slugInput && targetSlug) slugInput.value = targetSlug;
    if (excerptInput && targetExcerpt) excerptInput.value = targetExcerpt;

    // 5. If currently in Compare mode and user clicked a language, switch back to Visual editor for that language
    if (currentEditorMode === 'compare') {
      await switchEditorMode('visual');
      return;
    }

    // 6. Populate current surface
    if (currentEditorMode === 'markdown' && markdownTextarea) {
      markdownTextarea.value = targetMd;
      updateLineNumbers();
    } else if (currentEditorMode === 'visual') {
      const cleanHtml = targetMd ? DOMPurify.sanitize(String(await marked.parse(targetMd)), DOMPURIFY_CONFIG) : '<p></p>';
      editor.commands.setContent(cleanHtml);
    }

    updateSerp();
    updateMetrics();
    updateDocumentOutline();
  }

