  // Generate complete bilingual blog from reference
  async function generateBilingualFromReference() {
    const content = aiRefContent?.value.trim() || '';
    if (content.length < 50) {
      alert('Please paste at least 50 characters of reference content.');
      aiRefContent?.focus();
      return;
    }

    const category = aiRefCategory?.value || 'auto-detect';
    const instructions = aiRefInstructions?.value.trim() || '';

    if (aiRefGenerateBtn) {
      aiRefGenerateBtn.disabled = true;
      if (aiRefBtnLabel) aiRefBtnLabel.textContent = 'Generating Bilingual Articles...';
    }

    aiRefResultsCard?.classList.add('hidden');
    aiRefLoadingCard?.classList.remove('hidden');

    // Multi-step progress animation
    const steps = [
      { id: 'ai-step-1', text: 'Extracting dates, vacancies, eligibility, and fees...' },
      { id: 'ai-step-2', text: 'Drafting Hindi (हिंदी + Technical Terms) with GFM tables...' },
      { id: 'ai-step-3', text: 'Drafting English article with SEO structure...' },
      { id: 'ai-step-4', text: 'Finalizing SEO titles, slugs, and descriptions...' },
    ];
    let currentStep = 0;
    const stepInterval = setInterval(() => {
      currentStep = (currentStep + 1) % steps.length;
      if (aiRefLoadingStatus) aiRefLoadingStatus.textContent = steps[currentStep].text;
      steps.forEach((s, idx) => {
        const el = document.getElementById(s.id);
        if (!el) return;
        if (idx < currentStep) {
          el.className = 'flex items-center gap-2 text-emerald-700 font-medium';
          if (el.firstElementChild) el.firstElementChild.textContent = '✓';
        } else if (idx === currentStep) {
          el.className = 'flex items-center gap-2 text-slate-900 font-semibold';
          if (el.firstElementChild) el.firstElementChild.textContent = '●';
        } else {
          el.className = 'flex items-center gap-2 text-slate-400';
          if (el.firstElementChild) el.firstElementChild.textContent = '○';
        }
      });
    }, 2800);

    try {
      const res = await apiFetch('/blogs/generate-from-reference', {
        method: 'POST',
        body: JSON.stringify({
          referenceContent: content,
          category: category !== 'auto-detect' ? category : undefined,
          additionalInstructions: instructions,
        }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.message || `HTTP ${res.status}`);
      }

      const data = await res.json();
      lastGeneratedBilingual = data;

      // Populate Result Preview Card
      if (aiRefResultCategory) {
        aiRefResultCategory.textContent = data.detectedCategory || category || 'Exam Notification';
