  function handleImageFileSelected(file: File) {
    if (!file.type.startsWith('image/')) {
      alert('Please select a valid image file (JPEG, PNG, WebP, or GIF).');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      alert('Image file size must be less than 10MB.');
      return;
    }

    selectedFileToUpload = file;
    if (uploadFileName) uploadFileName.textContent = file.name;
    if (uploadFileSize) uploadFileSize.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB`;

    const objectUrl = URL.createObjectURL(file);
    if (uploadPreviewThumb) uploadPreviewThumb.src = objectUrl;
    uploadPreviewContainer?.classList.remove('hidden');
    uploadPreviewContainer?.classList.add('flex');

    if (articleImageAltInput && !articleImageAltInput.value) {
      const cleanName = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
      articleImageAltInput.value = cleanName;
    }
  }

