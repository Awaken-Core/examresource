  async function loadMediaLibrary() {
    if (!mediaLibraryGrid) return;
    mediaLibraryGrid.innerHTML = '<p class="text-xs text-slate-400 col-span-3 text-center py-8">Loading media library...</p>';

    try {
      const res = await apiFetch('/uploads/images');
      if (res.ok) {
        const data = await res.json();
        cachedMediaList = data.items || [];
        renderMediaLibrary(cachedMediaList);
      } else {
        mediaLibraryGrid.innerHTML = '<p class="text-xs text-slate-400 col-span-3 text-center py-8">No previous uploads found.</p>';
      }
    } catch (_) {
      mediaLibraryGrid.innerHTML = '<p class="text-xs text-slate-400 col-span-3 text-center py-8">Unable to load media library.</p>';
    }
  }

  function renderMediaLibrary(items: any[]) {
