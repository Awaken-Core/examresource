---
import Layout from '../layouts/Layout.astro';
import { contactEmail, siteName, siteUrl } from '../data/site';
import { formatRupees, loadPassOffer } from '../lib/passOffer';

// Edge CDN caching: 5 minutes
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=900');
Astro.response.headers.set('Vary', 'Accept-Encoding');

const offer = await loadPassOffer();
const price = formatRupees(offer.amountPaise);
const listPrice = formatRupees(offer.listPricePaise);
const save = formatRupees(offer.listPricePaise - offer.amountPaise);
const lastUpdated = 'October 27, 2026';
const pageTitle = `Test Series Pass Pricing | ${siteName}`;
const pageDescription = `The ${siteName} Test Series Pass costs ${price} for ${offer.validityMonths} months and unlocks every published mock test series. One test in each series stays free. Blogs stay free. Books and quizzes are not included.`;
const canonicalUrl = `${siteUrl}/pricing`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Test Series Pass',
  description: pageDescription,
  url: canonicalUrl,
  brand: { '@type': 'Brand', name: siteName },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price: (offer.amountPaise / 100).toFixed(2),
    url: canonicalUrl,
    availability: 'https://schema.org/InStock',
  },
};

const sections = [
  { id: 'what-you-get', title: 'What the pass includes' },
  { id: 'price', title: 'Price' },
  { id: 'free-test', title: 'Free test' },
  { id: 'not-included', title: 'What is not included' },
  { id: 'how-to-buy', title: 'How to buy' },
];
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <div class="min-h-screen bg-canvas text-heading px-4 sm:px-6 lg:px-8 py-7">
    <div class="max-w-[1400px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_310px] xl:grid-cols-[minmax(0,1fr)_330px] gap-8 items-start">
        <div class="min-w-0 space-y-7">
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-muted">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span>/</span>
            <span class="text-white font-medium">Pricing</span>
          </nav>

          <section class="p-6 sm:p-7 bg-surface border border-border rounded-xl shadow-2xs space-y-3">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-raised border border-border text-white text-xs font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
              <span>Test Series Pass</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Pricing</h1>
            <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-3xl">
              One pass unlocks every published mock test series on {siteName} for {offer.validityMonths} months. Articles, exam notices, and the first test in each series stay free.
            </p>
            <p class="text-xs text-muted">Last updated: <strong class="text-white">{lastUpdated}</strong></p>
          </section>

          <main class="space-y-6 text-sm text-muted leading-relaxed">
            <section id="price" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <h2 class="text-base font-bold text-white">Price</h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                <div class="bg-surface-raised/40 border border-border/80 rounded-xl p-3">
                  <span class="text-[11px] text-muted block">Price</span>
                  <span class="text-base font-bold text-slate-900 dark:text-white mt-0.5 block">
                    <span class="line-through text-muted font-medium mr-2">{listPrice}</span>
                    {price}
                  </span>
                </div>
                <div class="bg-surface-raised/40 border border-border/80 rounded-xl p-3">
                  <span class="text-[11px] text-muted block">You save</span>
                  <span class="text-base font-bold text-slate-900 dark:text-white mt-0.5 block">{save}</span>
                </div>
                <div class="bg-surface-raised/40 border border-border/80 rounded-xl p-3 col-span-2 sm:col-span-1">
                  <span class="text-[11px] text-muted block">Validity</span>
                  <span class="text-base font-bold text-slate-900 dark:text-white mt-0.5 block">{offer.validityMonths} months</span>
                </div>
              </div>
              <p>
                The amount charged is {price}. The {listPrice} figure is the list price shown on the page. Payment is collected once through Razorpay. The pass does not renew by itself.
              </p>
            </section>

            <section id="what-you-get" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-3">
              <h2 class="text-base font-bold text-white">What the pass includes</h2>
              <ul class="list-disc pl-5 space-y-2">
                <li>Every published test series on {siteName}, including subject tests, chapter tests, and full mock tests.</li>
                <li>Access for {offer.validityMonths} months from the time the payment is confirmed.</li>
                <li>A later purchase adds another {offer.validityMonths} months onto any time still left.</li>
                <li>The pass is tied to the account that paid. Signing in on a new device signs out the previous device.</li>
              </ul>
            </section>

            <section id="free-test" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-3">
              <h2 class="text-base font-bold text-white">Free test</h2>
              <p>
                A new student can start one test inside each series without paying to sample the examination experience. Reattempting or unlocking further tests in the series requires the pass.
              </p>
            </section>

            <section id="not-included" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-3">
              <h2 class="text-base font-bold text-white">What is not included</h2>
              <ul class="list-disc pl-5 space-y-2">
                <li>Blogs and exam notices stay free for everyone and are not part of the pass.</li>
                <li>Books are not included.</li>
                <li>Quizzes and current-affairs quizzes are not included.</li>
                <li>The pass does not submit an application or pay a fee to any government commission.</li>
              </ul>
            </section>

            <section id="how-to-buy" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-3">
              <h2 class="text-base font-bold text-white">How to buy</h2>
              <p>
                Open any <a href="/test-series" class="text-accent hover:underline">test series</a>, sign in, and choose Buy pass. Razorpay opens the payment window. After a successful payment, the series unlocks on the same account.
              </p>
              <p>
                Refunds are described on the <a href="/refund-policy" class="text-accent hover:underline">refund and cancellation policy</a>. Questions can be sent to <a href={`mailto:${contactEmail}`} class="text-accent hover:underline">{contactEmail}</a> or through <a href="/contact-us" class="text-accent hover:underline">Contact Us</a>.
              </p>
            </section>
          </main>
        </div>

        <aside class="hidden lg:block sticky top-20">
          <nav class="bg-surface border border-border rounded-xl p-4 space-y-2" aria-label="Pricing sections">
            <p class="text-xs font-bold uppercase tracking-wider text-muted">On this page</p>
            {sections.map((section) => (
              <a href={`#${section.id}`} class="block text-xs text-muted hover:text-white py-1">{section.title}</a>
            ))}
          </nav>
        </aside>
      </div>
    </div>
  </div>
</Layout>
