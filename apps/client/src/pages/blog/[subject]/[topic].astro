---
import Layout from '../../../layouts/Layout.astro';
import BlogArticle from '../../../components/blog/BlogArticle.astro';
import TableOfContents from '../../../components/blog/TableOfContents.astro';
import ReadingProgress from '../../../components/blog/ReadingProgress.astro';
import TopicNavigation from '../../../components/blog/TopicNavigation.astro';
import type { TopicDetail } from '../../../data/blogData';

const { subject: subjectParam, topic: topicParam } = Astro.params;
const subjectKey = (subjectParam || 'general').toLowerCase();
const topicKey = (topicParam || '').toLowerCase();

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';

let livePost: any = null;
let redirectUrl: string | null = null;

try {
  const res = await fetch(`${API_URL}/blogs/${topicKey}`);
  if (res.ok) {
    livePost = await res.json();
  } else if (res.status === 404) {
    const errData = await res.json();
    if (errData?.redirectUrl) {
      redirectUrl = errData.redirectUrl;
    }
  }
} catch (e) {}

if (redirectUrl) {
  return Astro.redirect(redirectUrl, 301);
}

// If database returned live post, construct the article object and TOC
let article: TopicDetail;
let tocItems: { id: string; text: string; level: number }[] = [];
let htmlBody: string | null = null;

if (livePost) {
  htmlBody = livePost.htmlContent || '';
  
  // Extract TOC headings from HTML
  const headingRegex = /<h([2-4])\s+id=["']([^"']+)["'][^>]*>(.*?)<\/h\1>/gi;
  let match;
  tocItems.push({ id: 'overview-top', text: livePost.title, level: 2 });
  while ((match = headingRegex.exec(htmlBody)) !== null) {
    tocItems.push({
      level: parseInt(match[1], 10),
      id: match[2],
      text: match[3].replace(/<[^>]*>/g, ''),
    });
  }

  article = {
    slug: livePost.slug,
    title: livePost.title,
    subjectSlug: subjectKey,
    subjectTitle: livePost.category?.name || 'General',
    description: livePost.description || livePost.metaDescription || '',
    readTime: '4 min read',
    difficulty: 'Intermediate',
    category: livePost.category?.name || 'Articles',
    publishedDate: livePost.publishedAt ? new Date(livePost.publishedAt).toISOString().split('T')[0] : '2026-10-13',
    updatedDate: livePost.updatedAt ? new Date(livePost.updatedAt).toISOString().split('T')[0] : '2026-10-13',
    introParagraphs: [
      livePost.description || 'Detailed guide and notification information.',
    ],
    sections: [],
    summaryPoints: [
      `Official publication for ${livePost.title}.`,
      'Review complete eligibility, timelines, and guidelines below.',
    ],
  };
}

if (!livePost) {
  return new Response(null, {
    status: 404,
    statusText: 'Article Not Found',
  });
}

const pageTitle = livePost?.metaTitle || `${article.title} | ${article.subjectTitle} Guide`;
const pageDescription = livePost?.metaDescription || article.description;
const canonicalUrl = livePost?.canonicalUrl || `https://examresource.local/blog/${article.subjectSlug}/${article.slug}`;

// Schema.org Article & Breadcrumbs without fabricated details
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "headline": article.title,
      "description": pageDescription,
      "image": livePost?.coverImage ? [livePost.coverImage] : undefined,
      "datePublished": article.publishedDate,
      "dateModified": article.updatedDate,
      "author": {
        "@type": "Person",
        "name": livePost?.author?.name || "Editorial Team"
      },
      "publisher": {
        "@type": "Organization",
        "name": "ExamPortal",
        "logo": {
          "@type": "ImageObject",
          "url": "https://examresource.local/logo.png"
        }
      },
      "mainEntityOfPage": canonicalUrl
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Articles",
          "item": "https://examresource.local/blog"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": article.subjectTitle,
          "item": `https://examresource.local/blog/${article.subjectSlug}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={livePost?.coverImage || undefined}
  publishedTime={article.publishedDate}
  modifiedTime={article.updatedDate}
  jsonLd={jsonLd}
>
  <div id="overview-top" class="blog-reading-view min-h-screen bg-canvas text-white">
    <!-- Main Reading Container: Wide Center Column + Sticky Right TOC Panel -->
    <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col xl:flex-row gap-10 items-start justify-center">
      
      <!-- Central Reading Area -->
      <main class="w-full flex-1 max-w-3xl min-w-0">
        <!-- Breadcrumbs Navigation -->
        <nav aria-label="Breadcrumb" class="text-xs text-muted mb-4">
          <a href="/" class="hover:text-accent">Home</a>
          <span class="mx-1.5">/</span>
          <a href="/blog" class="hover:text-accent">Articles</a>
          <span class="mx-1.5">/</span>
          <a href={`/blog/${article.subjectSlug}`} class="hover:text-accent">{article.subjectTitle}</a>
          <span class="mx-1.5">/</span>
          <span class="text-white font-medium truncate">{article.title}</span>
        </nav>

        {htmlBody ? (
          <article class="bg-surface border border-border rounded-xl p-6 sm:p-8 space-y-6">
            <header class="border-b border-border/80 pb-6 space-y-3">
              <div class="flex items-center gap-2 text-xs text-muted">
                <span class="bg-accent/10 text-accent font-semibold px-2 py-0.5 rounded">{article.category}</span>
                <span>• Published: {article.publishedDate}</span>
                <span>• Updated: {article.updatedDate}</span>
              </div>
              <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
                {article.title}
              </h1>
              {article.description && (
                <p class="text-sm sm:text-base text-muted leading-relaxed">
                  {article.description}
                </p>
              )}
            </header>

            {livePost.coverImage && (
              <figure class="my-4">
                <img 
                  src={livePost.coverImage} 
                  alt={livePost.imageAlt || article.title} 
                  class="w-full h-auto rounded-lg object-cover max-h-96"
                />
                {livePost.imageCaption && (
                  <figcaption class="text-xs text-muted text-center mt-2">{livePost.imageCaption}</figcaption>
                )}
              </figure>
            )}

            <div class="prose prose-invert max-w-none text-white text-sm sm:text-base leading-relaxed space-y-4" set:html={htmlBody} />
          </article>
        ) : (
          <BlogArticle article={article} />
        )}

        <!-- Previous & Next Topic Nav -->
        <TopicNavigation 
          subjectSlug={article.subjectSlug} 
          prevTopic={article.prevTopic} 
          nextTopic={article.nextTopic} 
        />
      </main>

      <!-- Right Sidebar: Reading Progress & Sticky Table of Contents -->
      <aside aria-label="Table of Contents Sidebar" class="hidden xl:block w-64 shrink-0 sticky top-20 space-y-4">
        <ReadingProgress />

        <div class="bg-surface border border-border rounded-lg p-3.5 shadow-2xs">
          <TableOfContents items={tocItems} />
        </div>
      </aside>
    </div>
  </div>
</Layout>
