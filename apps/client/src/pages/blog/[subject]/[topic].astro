---
import Layout from '../../../layouts/Layout.astro';
import BlogArticle from '../../../components/blog/BlogArticle.astro';
import TableOfContents from '../../../components/blog/TableOfContents.astro';
import ReadingProgress from '../../../components/blog/ReadingProgress.astro';
import TopicNavigation from '../../../components/blog/TopicNavigation.astro';
import { TOPIC_DETAILS_MOCK, SUBJECTS_MOCK, type TopicDetail } from '../../../data/blogData';

const { subject: subjectParam, topic: topicParam } = Astro.params;
const subjectKey = (subjectParam || 'java').toLowerCase();
const topicKey = (topicParam || 'object-lifecycle-in-java').toLowerCase();

const lookupKey = `${subjectKey}/${topicKey}`;
let article: TopicDetail = TOPIC_DETAILS_MOCK[lookupKey];

if (!article) {
  if (topicKey.includes('lifecycle')) {
    article = TOPIC_DETAILS_MOCK['java/object-lifecycle-in-java'];
  } else if (topicKey.includes('binary')) {
    article = TOPIC_DETAILS_MOCK['dsa/binary-search'];
  } else {
    const subjectInfo = SUBJECTS_MOCK[subjectKey] || SUBJECTS_MOCK['java'];
    const matchedSummary = subjectInfo.topics.find((t) => t.slug === topicKey) || subjectInfo.topics[0];
    
    article = {
      slug: matchedSummary.slug,
      title: matchedSummary.title,
      subjectSlug: subjectInfo.slug,
      subjectTitle: subjectInfo.title,
      description: matchedSummary.description,
      readTime: matchedSummary.readTime,
      difficulty: matchedSummary.difficulty || 'Intermediate',
      category: matchedSummary.category || 'Core Concepts',
      publishedDate: '2026-03-15',
      updatedDate: '2026-04-02',
      introParagraphs: [
        `${matchedSummary.title} is an essential concept within ${subjectInfo.title}. This technical guide explores the underlying architectural principles, time complexity considerations, and implementation guidelines.`,
        'Review the code demonstrations below to evaluate the standard execution patterns.',
      ],
      sections: [
        {
          id: 'architectural-overview',
          title: `1. Overview of ${matchedSummary.title}`,
          level: 2,
          content: [
            matchedSummary.description,
            'Understanding the underlying runtime mechanics helps developers optimize resource efficiency and avoid common latency bottlenecks in high-throughput applications.',
          ],
        },
        {
          id: 'implementation-details',
          title: '2. Implementation Details and Constraints',
          level: 2,
          content: [
            'Below is the standard reference implementation demonstrating the fundamental behavior.',
          ],
          codeSnippet: {
            language: subjectInfo.slug === 'java' ? 'java' : subjectInfo.slug === 'sql' ? 'sql' : 'cpp',
            filename: `${matchedSummary.slug}.${subjectInfo.slug === 'java' ? 'java' : subjectInfo.slug === 'sql' ? 'sql' : 'cpp'}`,
            code: `// ${matchedSummary.title} Implementation Pattern
public class Solution {
    public void execute() {
        // Standard production execution flow
    }
}`,
          },
        },
        {
          id: 'summary',
          title: 'Summary',
          level: 2,
          content: [
            `Key takeaways for ${matchedSummary.title} provide a quick reference for system design and code reviews.`,
          ],
        },
      ],
      summaryPoints: [
        `Understand the core runtime mechanics of ${matchedSummary.title}.`,
        'Identify asymptotic complexity tradeoffs and edge cases.',
        'Adopt standard production patterns for error resilience.',
      ],
      prevTopic: undefined,
      nextTopic: undefined,
    };
  }
}

// Prepare TOC items from article sections
const tocItems = [
  { id: 'overview-top', text: article.title, level: 2 },
  ...article.sections.map((sec) => ({
    id: sec.id,
    text: sec.title,
    level: sec.level || 2,
  })),
];

const pageTitle = `${article.title} | ${article.subjectTitle} Technical Guide`;
const pageDescription = article.description;
const canonicalUrl = `https://examresource.local/blog/${article.subjectSlug}/${article.slug}`;

// Schema.org Article & Breadcrumbs without fabricated review dates or fake authors
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": article.title,
      "description": article.description,
      "datePublished": article.publishedDate,
      "dateModified": article.updatedDate,
      "publisher": {
        "@type": "Organization",
        "name": "Technical Engineering Documentation"
      },
      "mainEntityOfPage": canonicalUrl
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Articles",
          "item": "https://examresource.local/blog/java"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": article.subjectTitle,
          "item": `https://examresource.local/blog/${article.subjectSlug}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div id="overview-top" class="blog-reading-view min-h-screen bg-canvas text-white">
    {/* Main Reading Container: Wide Center Column + Sticky Right TOC Panel */}
    <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col xl:flex-row gap-10 items-start justify-center">
      
      {/* Central Reading Area */}
      <main class="w-full flex-1 max-w-3xl min-w-0">
        <BlogArticle article={article} />

        {/* Previous & Next Topic Nav */}
        <TopicNavigation 
          subjectSlug={article.subjectSlug} 
          prevTopic={article.prevTopic} 
          nextTopic={article.nextTopic} 
        />
      </main>

      {/* Right Sidebar: Reading Progress & Sticky Table of Contents */}
      <aside aria-label="Table of Contents Sidebar" class="hidden xl:block w-64 shrink-0 sticky top-20 space-y-4">
        {/* Subtle Reading Progress */}
        <ReadingProgress />

        {/* Table of Contents Container */}
        <div class="bg-surface border border-border rounded-lg p-3.5 shadow-2xs">
          <TableOfContents items={tocItems} />
        </div>
      </aside>
    </div>
  </div>
</Layout>
