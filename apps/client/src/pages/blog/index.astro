---
import Layout from '../../layouts/Layout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';

let livePosts: any[] = [];
try {
  const res = await fetch(`${API_URL}/blogs?limit=50`);
  if (res.ok) {
    livePosts = await res.json();
  }
} catch (e) {}

let categories: any[] = [];
try {
  const catRes = await fetch(`${API_URL}/categories`);
  if (catRes.ok) {
    categories = await catRes.json();
  }
} catch (e) {}

const pageTitle = "Articles, Guides & Exam Notices | ExamPortal";
const pageDescription = "Browse verified articles, official notifications, and guides published via ExamPortal CMS.";
const canonicalUrl = "https://examresource.local/blog";

// Schema.org CollectionPage
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": pageTitle,
      "description": pageDescription,
      "url": canonicalUrl,
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://examresource.local"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Blog Index Header -->
      <div class="border-b border-border/80 pb-6">
        <nav aria-label="Breadcrumb" class="text-xs text-muted mb-2">
          <a href="/" class="hover:text-accent">Home</a>
          <span class="mx-1.5">/</span>
          <span class="text-white font-medium">Articles & Publications</span>
        </nav>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Articles & Reference Guides
        </h1>
        <p class="text-xs sm:text-sm text-muted mt-2 max-w-2xl leading-relaxed">
          In-depth technical guides, official examination notices, lateral entry results, and counselling procedures. Server-rendered for instant indexing.
        </p>
      </div>

      <!-- Categories Navigation Bar -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-border/60 scrollbar-none">
        <a 
          href="/blog" 
          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-accent text-white shadow-2xs whitespace-nowrap"
        >
          All Topics
        </a>
        {categories.length > 0 ? (
          categories.map((c) => (
            <a 
              href={`/blog/${c.slug}`}
              class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-muted hover:text-white hover:bg-surface-raised transition whitespace-nowrap"
            >
              {c.name}
            </a>
          ))
        ) : (
          <span class="text-xs text-muted py-1 px-2">No categories created yet</span>
        )}
      </div>

      <!-- Live Articles Grid -->
      <div class="space-y-4">
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-muted">
          Latest Publications
        </h2>

        {livePosts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {livePosts.map((post) => {
              const catSlug = post.category?.slug || 'general';
              const catName = post.category?.name || 'General';
              const articleHref = `/blog/${catSlug}/${post.slug}`;

              return (
                <article class="bg-surface border border-border rounded-xl p-5 hover:border-accent/40 transition flex flex-col justify-between group">
                  <div>
                    <div class="flex items-center justify-between text-[11px] text-muted mb-2.5">
                      <span class="bg-accent/10 text-accent font-semibold px-2 py-0.5 rounded">
                        {catName}
                      </span>
                      <time datetime={post.publishedAt || post.updatedAt}>
                        {new Date(post.publishedAt || post.updatedAt).toLocaleDateString()}
                      </time>
                    </div>

                    <h3 class="text-base font-bold text-white group-hover:text-accent transition leading-snug line-clamp-2">
                      <a href={articleHref}>{post.title}</a>
                    </h3>

                    <p class="text-xs text-muted mt-2 line-clamp-3 leading-relaxed">
                      {post.description || post.metaDescription || 'Click to view the full guide and instructions.'}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-xs text-muted">
                    <span>By {post.author?.name || 'Editorial Team'}</span>
                    <a href={articleHref} class="text-accent hover:underline font-semibold flex items-center gap-1">
                      Read Guide ↗
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="bg-surface border border-border rounded-xl p-8 text-center text-muted">
            <div class="text-3xl mb-2">📝</div>
            <h3 class="text-base font-bold text-white mb-1">No articles published yet</h3>
            <p class="text-xs text-muted mb-4 max-w-sm mx-auto">
              Create categories and publish your first article from the Admin Studio.
            </p>
            <a 
              href="/editor" 
              class="inline-flex items-center gap-1.5 px-4 py-2 bg-accent hover:bg-accent/90 text-white rounded-lg text-xs font-semibold shadow-xs transition"
            >
              <span>+ Create First Article</span>
            </a>
          </div>
        )}
      </div>

    </div>
  </div>
</Layout>
