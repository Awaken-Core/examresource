---
import Layout from '../../layouts/Layout.astro';

const { subject: subjectParam } = Astro.params;
const subjectKey = (subjectParam || '').toLowerCase();

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';

// Fetch live database articles for this category and all categories for navigation
let liveCategoryPosts: any[] = [];
let categoryInfo: any = null;
let allCategories: any[] = [];

try {
  const [postRes, catRes] = await Promise.all([
    fetch(`${API_URL}/blogs?category=${subjectKey}&limit=50`),
    fetch(`${API_URL}/categories`),
  ]);

  if (postRes.ok) liveCategoryPosts = await postRes.json();
  if (catRes.ok) {
    allCategories = await catRes.json();
    categoryInfo = allCategories.find((c: any) => c.slug === subjectKey);
  }
} catch (e) {}

const categoryTitle = categoryInfo?.name || subjectKey.replace(/-/g, ' ').toUpperCase();
const categoryDesc = categoryInfo?.description || `Browse articles and updates in ${categoryTitle}.`;

const pageTitle = `${categoryTitle} - Exam Guides & Notifications | GovtPariksha`;
const pageDescription = categoryDesc;
const canonicalUrl = `https://govtpariksha.com/blog/${subjectKey}`;

// Schema.org structured data (BreadcrumbList & CollectionPage)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": categoryTitle,
      "description": categoryDesc,
      "url": canonicalUrl,
      "hasPart": liveCategoryPosts.map((t: any) => ({
        "@type": "Article",
        "headline": t.title,
        "description": t.description || t.metaDescription,
        "url": `https://govtpariksha.com/${t.slug}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://govtpariksha.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": categoryTitle,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white pt-5 pb-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb Header -->
      <nav aria-label="Breadcrumb" class="text-xs text-muted mb-4">
        <a href="/" class="hover:text-accent">Home</a>
        <span class="mx-1.5">/</span>
        <a href="/" class="hover:text-accent">Articles</a>
        <span class="mx-1.5">/</span>
        <span class="text-white font-semibold">{categoryTitle}</span>
      </nav>

      <!-- Subject Selector Bar -->
      <nav aria-label="Subject Categories" class="flex items-center flex-wrap gap-1.5 pb-3 mb-6 border-b border-border/70">
        <a
          href="/"
          class="px-3 py-1.5 rounded-lg text-xs font-medium text-muted hover:text-white hover:bg-surface-raised shrink-0 transition"
        >
          All Topics
        </a>
        {allCategories.map((c) => {
          const isActive = c.slug === subjectKey;
          return (
            <a
              href={`/blog/${c.slug}`}
              class={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all shrink-0 flex items-center gap-1.5 ${
                isActive
                  ? 'bg-surface text-accent font-semibold border border-border shadow-2xs'
                  : 'text-muted hover:text-white hover:bg-surface-raised'
              }`}
            >
              <span>{c.name}</span>
            </a>
          );
        })}
      </nav>

      <!-- Header Banner -->
      <div class="border-b border-border/80 pb-6 mb-6">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          {categoryTitle}
        </h1>
        <p class="text-xs sm:text-sm text-muted mt-2 leading-relaxed max-w-2xl">
          {categoryDesc}
        </p>
      </div>

      <!-- Content-First Topic List -->
      <div class="mt-6">
        <div class="flex items-center justify-between pb-3 border-b border-border/80">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-muted">
            Published Articles ({liveCategoryPosts.length})
          </h2>
        </div>

        {liveCategoryPosts.length > 0 ? (
          <div class="divide-y divide-border/60">
            {liveCategoryPosts.map((post) => (
              <a href={`/${post.slug}`} class="block rounded-lg p-3 py-4 transition hover:bg-surface-raised/40">
                <span class="mb-1 flex items-center justify-between text-[11px] text-muted">
                  <span>Updated: {new Date(post.updatedAt).toLocaleDateString()}</span>
                  <span>By {post.author?.name || 'Staff'}</span>
                </span>
                <span class="block text-base font-bold text-white">{post.title}</span>
                <span class="mt-1 line-clamp-2 block text-xs leading-relaxed text-muted">
                  {post.description || post.metaDescription}
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="p-8 text-center bg-surface border border-border rounded-xl mt-4 text-muted">
            <p class="text-sm">No articles published in this category yet.</p>
            <a href="/" class="mt-2 inline-block text-xs font-semibold text-accent hover:underline">Back to all articles</a>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
