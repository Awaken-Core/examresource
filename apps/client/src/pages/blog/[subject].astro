---
import Layout from '../../layouts/Layout.astro';
import SubjectHeader from '../../components/blog/SubjectHeader.astro';
import TopicCard from '../../components/blog/TopicCard.astro';
import { SUBJECTS_MOCK } from '../../data/blogData';

const { subject: subjectParam } = Astro.params;
const subjectKey = (subjectParam || 'java').toLowerCase();

const subject = SUBJECTS_MOCK[subjectKey] || SUBJECTS_MOCK['java'];

const pageTitle = `${subject.title} - Technical Reference & Engineering Guides`;
const pageDescription = subject.shortDescription;
const canonicalUrl = `https://examresource.local/blog/${subject.slug}`;

// All available subjects for the tab switcher
const allSubjects = Object.values(SUBJECTS_MOCK);

// Schema.org structured data (BreadcrumbList & CollectionPage)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": subject.title,
      "description": subject.description,
      "url": canonicalUrl,
      "hasPart": subject.topics.map(t => ({
        "@type": "TechArticle",
        "headline": t.title,
        "description": t.description,
        "url": `https://examresource.local/blog/${subject.slug}/${t.slug}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Articles",
          "item": "https://examresource.local/blog/java"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": subject.title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      {/* Subject Selector Bar */}
      <nav aria-label="Subject Categories" class="flex items-center gap-1 overflow-x-auto pb-3 mb-6 border-b border-border/70 scrollbar-none">
        {allSubjects.map((s) => {
          const isActive = s.slug === subject.slug;
          return (
            <a
              href={`/blog/${s.slug}`}
              class={`px-3.5 py-1.5 rounded-md text-xs font-medium transition-all shrink-0 flex items-center gap-2 ${
                isActive
                  ? 'bg-surface text-accent font-semibold border border-border shadow-2xs'
                  : 'text-muted hover:text-white hover:bg-surface-raised'
              }`}
            >
              <span>{s.title}</span>
              <span class={`text-[10px] font-mono px-1.5 py-0.2 rounded ${isActive ? 'bg-accent/10 text-accent font-bold' : 'text-muted/70'}`}>
                {s.topicsCount}
              </span>
            </a>
          );
        })}
      </nav>

      {/* Subject Header & Search */}
      <SubjectHeader subject={subject} />

      {/* Content-First Topic List */}
      <div class="mt-6">
        <div class="flex items-center justify-between pb-3 border-b border-border/80">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-muted">
            All Articles ({subject.topics.length})
          </h2>
          <span id="search-match-count" class="text-xs font-mono text-muted hidden"></span>
        </div>

        {/* Clean list with unboxed rows */}
        <div id="topics-list" class="divide-y divide-border/60">
          {subject.topics.map((t) => (
            <TopicCard topic={t} subjectSlug={subject.slug} />
          ))}
        </div>

        <div id="no-search-results" class="hidden py-16 text-center text-muted border border-border/80 rounded-lg mt-6 bg-surface">
          <p class="text-sm font-semibold text-white">No articles matched your filter</p>
          <p class="text-xs mt-1 text-muted">Try adjusting your keywords or browse other subjects above.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupTopicSearch() {
    const input = document.getElementById('topic-search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('[data-topic-item]');
    const emptyState = document.getElementById('no-search-results');
    const matchCount = document.getElementById('search-match-count');

    if (!input || !cards.length) return;

    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-topic-title') || '';
        const desc = card.getAttribute('data-topic-desc') || '';
        const category = card.getAttribute('data-topic-category') || '';
        const matches = title.includes(query) || desc.includes(query) || category.includes(query);

        if (matches) {
          card.classList.remove('hidden');
          visible++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (visible === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }

      if (matchCount) {
        if (query) {
          matchCount.textContent = `Showing ${visible} of ${cards.length}`;
          matchCount.classList.remove('hidden');
        } else {
          matchCount.classList.add('hidden');
        }
      }
    });
  }

  setupTopicSearch();
  document.addEventListener('astro:page-load', setupTopicSearch);
</script>
