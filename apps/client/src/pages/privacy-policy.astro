---
import Layout from '../layouts/Layout.astro';
import { contactEmail, siteUrl, siteName } from '../data/site';

const lastUpdated = "October 17, 2026";
const pageTitle = `Privacy Policy | ${siteName}`;
const pageDescription = `Learn how ${siteName} collects, uses, and protects your personal data. Compliant with the IT Act 2000 and DPDP Act 2023.`;
const canonicalUrl = `${siteUrl}/privacy-policy`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy",
  "url": canonicalUrl,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "url": siteUrl,
    "logo": `${siteUrl}/og-image.jpg`
  },
  "breadcrumb": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Privacy Policy",
        "item": canonicalUrl
      }
    ]
  }
};

const sections = [
  { id: "information-we-collect", title: "Information We Collect" },
  { id: "how-we-use", title: "How We Use Information" },
  { id: "data-security", title: "Data Security & Storage" },
  { id: "cookies", title: "Cookies & Local Storage" },
  { id: "third-party", title: "Third-Party Portals" },
  { id: "user-rights", title: "Your Privacy Rights" },
  { id: "grievance", title: "Grievance Redressal" }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-heading px-4 sm:px-6 lg:px-8 py-7 transition-colors duration-200">
    <div class="max-w-[1400px] mx-auto">
      
      {/* 2-Column Grid: Main Reading Stream (Left) + Sticky ToC Rail (Right) */}
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_310px] xl:grid-cols-[minmax(0,1fr)_330px] gap-8 items-start">
        
        {/* MAIN EDITORIAL BODY */}
        <div class="min-w-0 space-y-7">
          
          {/* Breadcrumb */}
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-muted">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span>/</span>
            <span class="text-white font-medium">Privacy Policy</span>
          </nav>

          {/* Hero Banner */}
          <section class="p-6 sm:p-7 bg-surface border border-border rounded-xl shadow-2xs relative overflow-hidden">
            <div class="relative z-10 space-y-3">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-raised border border-border text-white text-xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>DPDP Act 2023 Compliant</span>
              </div>

              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Privacy Policy
              </h1>

              <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-3xl">
                This Privacy Policy explains how <strong class="text-white">{siteName}</strong> ("we", "us", or "our") collects, uses, and safeguards your data in full compliance with India's <strong class="text-white">Digital Personal Data Protection (DPDP) Act, 2023</strong> and the <strong class="text-white">Information Technology Act, 2000</strong>.
              </p>

              <div class="pt-3 border-t border-border/50 flex flex-wrap items-center gap-4 text-xs text-muted">
                <span>Last Updated: <strong class="text-white">{lastUpdated}</strong></span>
                <span>•</span>
                <span>Reading Time: <strong class="text-white">4 min</strong></span>
                <span>•</span>
                <span>Region: <strong class="text-white">India</strong></span>
              </div>
            </div>
          </section>

          {/* Main Legal Sections Feed */}
          <main class="space-y-6 text-sm text-muted leading-relaxed">
            
            {/* 1. Information We Collect */}
            <section id="information-we-collect" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">1</span>
                  <span>Information We Collect</span>
                </h2>
              </div>
              <p>
                We collect only the minimal data essential for delivering exam notifications and maintaining personal study preferences:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                <div class="p-3.5 rounded-lg bg-surface-raised border border-border/60">
                  <p class="font-semibold text-white text-xs mb-1">Account &amp; Auth Details</p>
                  <p class="text-xs text-muted leading-relaxed">Name, email address, and profile avatar received via Google Sign-In or manual registration.</p>
                </div>
                <div class="p-3.5 rounded-lg bg-surface-raised border border-border/60">
                  <p class="font-semibold text-white text-xs mb-1">Preferences &amp; History</p>
                  <p class="text-xs text-muted leading-relaxed">Target exams (e.g. UPSC, SSC, Banking), language selection (English/Hindi), and saved notices.</p>
                </div>
              </div>
              <div class="p-3.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-900 dark:text-emerald-200 text-xs leading-relaxed">
                <span class="font-bold text-emerald-800 dark:text-emerald-300">✓ 100% Free Service:</span> We never ask for or store payment credentials, UPI PINs, or bank account information.
              </div>
            </section>

            {/* 2. How We Use Information */}
            <section id="how-we-use" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">2</span>
                  <span>How We Use Information</span>
                </h2>
              </div>
              <p>We process collected information strictly for genuine platform purposes:</p>
              <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
                <li>To deliver instant exam notifications, syllabi updates, and admit card download links.</li>
                <li>To remember your viewing preferences across sessions (such as theme and language).</li>
                <li>To protect our infrastructure from DDoS attacks, scrapers, and malicious bot activity.</li>
              </ul>
            </section>

            {/* 3. Data Security & Storage */}
            <section id="data-security" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">3</span>
                  <span>Data Security &amp; Storage</span>
                </h2>
              </div>
              <p>
                All data transmission between your browser and our servers is secured using modern TLS 1.3 encryption. Backend databases are stored in compliant cloud facilities with restricted access controls.
              </p>
              <p class="text-xs">
                Your data is retained strictly while your account remains active and will be purged upon deletion request.
              </p>
            </section>

            {/* 4. Cookies & Local Storage */}
            <section id="cookies" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">4</span>
                  <span>Cookies &amp; Local Storage</span>
                </h2>
              </div>
              <p>We use minimal first-party cookies and browser local storage for essential features:</p>
              <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
                <li><strong class="text-white">Preferences:</strong> Storing your chosen theme (Dark / Light) and article language toggle.</li>
                <li><strong class="text-white">Sessions:</strong> Maintaining authenticated state securely without storing plain credentials.</li>
              </ul>
            </section>

            {/* 5. Third-Party Portals */}
            <section id="third-party" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">5</span>
                  <span>Third-Party Government Portals</span>
                </h2>
              </div>
              <p>
                Our notices include verified external links to official commission portals (e.g., UPSC, SSC, RRB). We are not responsible for the privacy policies or practices of external government portals. Always review their respective policies when submitting official exam forms.
              </p>
            </section>

            {/* 6. Your Privacy Rights */}
            <section id="user-rights" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">6</span>
                  <span>Your Privacy Rights (DPDP Act)</span>
                </h2>
              </div>
              <p>
                Under the DPDP Act 2023, you hold full rights to access, rectify, or request complete deletion of your personal account data at any time.
              </p>
              <p class="text-xs">
                To exercise any of these rights, contact us at <a href={`mailto:${contactEmail}`} class="text-accent hover:underline font-semibold">{contactEmail}</a> or submit a message via our support portal.
              </p>
            </section>

            {/* 7. Grievance Redressal */}
            <section id="grievance" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">7</span>
                  <span>Grievance Redressal Officer</span>
                </h2>
              </div>
              <p>For inquiries, privacy concerns, or grievance redressal, reach out to our desk:</p>
              <div class="p-4 rounded-lg bg-surface-raised border border-border/80 text-xs space-y-1.5 text-white">
                <p><span class="text-muted">Platform:</span> <strong>{siteName}</strong></p>
                <p><span class="text-muted">Website:</span> <a href={`${siteUrl}/`} class="text-accent hover:underline">{siteUrl}/</a></p>
                <p><span class="text-muted">Email:</span> <a href={`mailto:${contactEmail}`} class="text-accent hover:underline">{contactEmail}</a></p>
              </div>
            </section>

          </main>

        </div>

        {/* RIGHT SIDEBAR (Sticky Quick ToC & Contact Card) */}
        <aside class="space-y-6 hidden lg:block sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto scrollbar-none">
          
          {/* Table of Contents Box */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3 transition-colors">
            <h3 class="text-xs font-bold uppercase tracking-wider text-muted pb-1 border-b border-border/50">
              Page Contents
            </h3>
            <nav class="space-y-1 text-xs">
              {sections.map((s, idx) => (
                <a
                  href={`#${s.id}`}
                  class="flex items-center gap-2 py-1.5 px-2 rounded hover:bg-surface-raised text-muted hover:text-white transition group"
                >
                  <span class="w-4 text-[10px] text-muted group-hover:text-accent font-mono">{idx + 1}.</span>
                  <span class="truncate">{s.title}</span>
                </a>
              ))}
            </nav>
          </div>

          {/* Quick Help Card */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-2.5 transition-colors text-xs text-muted">
            <p class="font-bold text-white text-sm">Need Help?</p>
            <p class="leading-relaxed">Have questions regarding your personal data or wish to request data erasure?</p>
            <div class="pt-2">
              <a
                href="/contact-us"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-surface-raised border border-border hover:border-accent text-white font-medium text-xs transition"
              >
                <span>Contact Desk</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </div>
</Layout>
