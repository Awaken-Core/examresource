  ---
import Layout from '../layouts/Layout.astro';
import { fetchPublicJson } from '../lib/publicFetch';
import { Image } from 'astro:assets';
import { siteFaqs, telegramChannel, whatsappChannel, siteUrl, siteName, siteDomain } from '../data/site';
import {
  appLangToBlogLanguage,
  articleHref,
  preferredLangFromCookieHeader,
} from '../lib/preferred-lang';


const preferredAppLang = preferredLangFromCookieHeader(Astro.request.headers.get('cookie'));
const listLanguage = appLangToBlogLanguage(preferredAppLang);

// Edge CDN caching: cache for 60s, serve stale up to 300s while revalidating in background
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('Vary', 'Accept-Encoding');

const livePosts = (await fetchPublicJson<any[]>(`/blogs?limit=60&language=${listLanguage}&includeImages=false`, 60_000)) || [];

// Map only REAL live database articles
const THREE_DAYS_MS = 3 * 24 * 60 * 60 * 1000;
const nowTime = Date.now();
const displayArticles = (livePosts || []).map((p) => {
  const title = p.title || 'Untitled Notification';
  const categoryName = p.category?.name || p.categories?.[0]?.name || 'Central Government';
  const categorySlug = p.category?.slug || p.categories?.[0]?.slug || 'central-government';
  const pubTime = new Date(p.publishedAt || p.updatedAt || Date.now()).getTime();
  
  // NEW tag ONLY on blogs published within the last 3 days
  const isNew = (nowTime - pubTime) >= 0 && (nowTime - pubTime) <= THREE_DAYS_MS;

  return {
    title,
    slugKey: p.slug,
    slug: articleHref(p.slug, preferredAppLang),
    category: categoryName,
    categorySlug,
    categories: p.categories || (p.category ? [p.category] : []),
    summary: p.description || p.metaDescription || '',
    date: new Date(pubTime).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
    isNew,
  };
});

// 9 Curated Authentic Government Exam Streams (3x3 Grid)
const streamCategories = [
  {
    id: 'central-govt',
    name: 'Central Govt & UPSC',
    shortName: 'Central & UPSC',
    slug: 'central-government',
    coverage: 'UPSC Civil Services, EPFO, Central Ministries & National Agencies',
    keywords: ['central', 'upsc', 'ias', 'ips', 'ministry', 'epfo', 'ncs'],
    iconType: 'monument',
  },
  {
    id: 'ssc',
    name: 'SSC Exams',
    shortName: 'SSC Exams',
    slug: 'ssc',
    coverage: 'Staff Selection Commission (CGL, CHSL, MTS, GD, CPO, Steno)',
    keywords: ['ssc', 'cgl', 'chsl', 'mts', 'staff selection', 'cpo', 'stenographer', 'gd constable'],
    iconType: 'document',
  },
  {
    id: 'railways',
    name: 'Railway Exams (RRB)',
    shortName: 'Railway Exams',
    slug: 'railways',
    coverage: 'Railway Recruitment Boards (NTPC, Group D, ALP, Technician, RPF)',
    keywords: ['railway', 'railways', 'rrb', 'ntpc', 'group d', 'alp', 'rpf', 'technician'],
    iconType: 'train',
  },
  {
    id: 'banking',
    name: 'Banking & Insurance Exams',
    shortName: 'Banking Exams',
    slug: 'banking',
    coverage: 'SBI, IBPS PO/Clerk, RBI Grade B, LIC & Public Sector Banks',
    keywords: ['bank', 'banking', 'sbi', 'ibps', 'rbi', 'lic', 'clerk', 'po', 'nabard', 'insurance'],
    iconType: 'bank',
  },
  {
    id: 'latest-jobs',
    name: 'Latest Govt Jobs',
    shortName: 'Latest Govt Jobs',
    slug: 'latest-jobs',
    coverage: 'State PSCs, Central Ministries, Public Sector Undertakings & National Recruitment',
    keywords: ['latest-jobs', 'latest-job', 'job', 'jobs', 'recruitment', 'vacancy', 'vacancies', 'bharti', 'sarkari', 'state', 'uppsc', 'bpsc', 'mpsc', 'rpsc', 'mppsc', 'pcs', 'patwari', 'lekhpal', 'psc', 'vyapam'],
    iconType: 'building',
  },
  {
    id: 'defence',
    name: 'Defence & Paramilitary Exams',
    shortName: 'Defence Exams',
    slug: 'defence',
    coverage: 'Indian Armed Forces (Army, Navy, Air Force), NDA, CDS, AFCAT, CAPF, Coast Guard',
    keywords: ['defence', 'defense', 'army', 'navy', 'air force', 'nda', 'cds', 'afcat', 'capf', 'coast guard', 'cgept', 'navik', 'agniveer'],
    iconType: 'shield',
  },
  {
    id: 'police',
    name: 'Police Recruitment Exams',
    shortName: 'Police Exams',
    slug: 'police',
    coverage: 'State Police Sub-Inspector (SI), Constable, ASI & Driver Drives',
    keywords: ['police', 'constable', 'si', 'sub-inspector', 'driver', 'delhi police', 'mp police', 'mpesb'],
    iconType: 'badge',
  },
  {
    id: 'teaching',
    name: 'Teaching & Education Exams',
    shortName: 'Teaching Exams',
    slug: 'teaching',
    coverage: 'CTET, State TETs, KVS, NVS, DSSSB, Assistant Professor & PGT/TGT/PRT',
    keywords: ['teach', 'teacher', 'ctet', 'tet', 'kvs', 'nvs', 'dsssb', 'ugc', 'net', 'pgt', 'tgt', 'prt', 'upessc'],
    iconType: 'book',
  },
  {
    id: 'psu-engineering',
    name: 'PSU & Engineering Exams',
    shortName: 'PSU & Engineering',
    slug: 'psu-engineering',
    coverage: 'BHEL, ISRO, DRDO, GATE, State Engineering Services & Technical Drives',
    keywords: ['psu', 'engineering', 'gate', 'isro', 'drdo', 'bhel', 'bel', 'sail', 'iocl', 'polytechnic', 'jeecup', 'artisan', 'technical', 'diploma'],
    iconType: 'gear',
  },
];

// Combine ONLY real database articles per category (NO fake fallback data)
const bentoGridData = streamCategories.map((cat) => {
  const matchedLive = displayArticles.filter((art) => {
    const artCategories = (art.categories || []).map((c: any) => (c.slug || '').toLowerCase());
    const artCategoryNames = (art.categories || []).map((c: any) => (c.name || '').toLowerCase());
    const artCatSlug = (art.categorySlug || '').toLowerCase();
    const artCatName = (art.category || '').toLowerCase();
    const artTitle = (art.title || '').toLowerCase();

    // Check direct slug/name match against primary or any attached category
    if (artCatSlug === cat.slug || artCatName === cat.name.toLowerCase()) return true;
    if (artCategories.includes(cat.slug) || artCategoryNames.includes(cat.name.toLowerCase())) return true;

    // Support category-specific alias mappings
    if (cat.slug === 'latest-jobs' && (artCatSlug === 'state-exams' || artCategories.includes('state-exams'))) return true;
    if (cat.slug === 'psu-engineering' && (artCatSlug === 'admissions' || artCategories.includes('admissions') || artCatName.includes('admission'))) return true;

    // Keyword matching across title, category slug, category name, and attached categories
    return cat.keywords.some((kw) => artCatSlug.includes(kw) || artCatName.includes(kw) || artTitle.includes(kw) || artCategories.some((cs: string) => cs.includes(kw)));
  });

  return {
    ...cat,
    articles: matchedLive.slice(0, 4),
    totalCount: matchedLive.length,
  };
});

// Official Portals for rapid reference
const R2_PORTAL_BASE = 'https://pub-68568854a58845bc975b176de76b1ad5.r2.dev/portals';
const verifiedPortals = [
  { name: 'UPSC', url: 'upsc.gov.in', href: 'https://www.upsc.gov.in/', logo: `${R2_PORTAL_BASE}/upsc.svg`, initial: 'U', bg: 'bg-[#0C2340]', text: 'text-[#E2B13C]' },
  { name: 'SSC', url: 'ssc.gov.in', href: 'https://ssc.gov.in/', logo: `${R2_PORTAL_BASE}/ssc.svg`, initial: 'S', bg: 'bg-[#8B0000]', text: 'text-[#FFD700]' },
  { name: 'Railways', url: 'rrb.indianrailways.gov.in', href: 'https://rrb.indianrailways.gov.in/', logo: `${R2_PORTAL_BASE}/railways.svg`, initial: 'R', bg: 'bg-[#003366]', text: 'text-[#E5A823]' },
  { name: 'UPPSC', url: 'uppsc.up.nic.in', href: 'https://uppsc.up.nic.in/', logo: `${R2_PORTAL_BASE}/uppsc.svg`, initial: 'UP', bg: 'bg-[#14532D]', text: 'text-[#FEF08A]' },
  { name: 'SBI Careers', url: 'sbi.co.in', href: 'https://sbi.co.in/web/careers', logo: `${R2_PORTAL_BASE}/sbi.svg`, initial: 'SBI', bg: 'bg-[#0080C7]', text: 'text-white' },
  { name: 'IBPS', url: 'ibps.in', href: 'https://www.ibps.in/', logo: `${R2_PORTAL_BASE}/ibps.svg`, initial: 'I', bg: 'bg-[#312E81]', text: 'text-[#F59E0B]' },
];

const pageTitle = `${siteName} | SARKARI JOBS, EXAM NOTIFICATIONS & RESULTS`;
const pageDescription = `${siteName} (${siteDomain}) delivers verified government examination notices, admit cards, answer keys, syllabi, and direct official commission portal links across India.`;
const canonicalUrl = `${siteUrl}/blogs`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: siteName,
      alternateName: [siteName, siteDomain, `${siteName} Sarkari Portal`],
      url: canonicalUrl,
      description: pageDescription,
      inLanguage: ['en-IN', 'hi-Latn'],
      about: [
        { '@type': 'Thing', name: 'Government Examinations in India' },
        { '@type': 'Thing', name: 'Sarkari Naukri Notifications' },
        { '@type': 'Thing', name: 'Civil Services Examination' },
        { '@type': 'Thing', name: 'Staff Selection Commission' },
        { '@type': 'Thing', name: 'Railway Recruitment Boards' },
      ],
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteUrl}/blogs?search={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: siteName,
      alternateName: [siteName, siteDomain],
      url: canonicalUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/logo.png`,
        width: 512,
        height: 512,
        caption: `${siteName} Logo`,
      },
      image: `${siteUrl}/og-image.jpg`,
      sameAs: [whatsappChannel, telegramChannel].filter(Boolean),
      description: 'Verified government exam notifications, Sarkari job updates, admit cards, answer keys, and counselling results portal across India.',
      knowsAbout: [
        'Government Exams in India',
        'Sarkari Naukri Alerts',
        'UPSC Civil Services Examination',
        'Staff Selection Commission (SSC)',
        'Railway Recruitment Control Board (RRB)',
        'Institute of Banking Personnel Selection (IBPS)',
        'State Public Service Commissions',
        'Admit Cards & Answer Keys',
        'Exam Syllabi & Cut-off Marks',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: siteFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={`${siteUrl}/og-image.jpg`}
  ogType="website"
  jsonLd={jsonLd}
  isEditorialTheme={true}
>
  <div class="relative min-h-screen bg-editorial-bg text-editorial-text selection:bg-editorial-accent/20 selection:text-editorial-accent">

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8 lg:px-12 pt-5 sm:pt-6 pb-20">

      <h1 class="sr-only">GovtPariksha | Verified Government Exam Notifications, Admit Cards &amp; Results</h1>

      {/* ══════════════════════════════════════════════════════════
          1. HERO SECTION (Compact, Homepage Typography & Spacing)
          ══════════════════════════════════════════════════════════ */}
      <section class="text-center pt-1 sm:pt-2 pb-0 max-w-3xl mx-auto" aria-label="Hero Introduction">
        <p class="font-['Geist'] text-[11px] font-semibold tracking-[0.2em] text-editorial-accent uppercase mb-2.5">
          THE EXAM NOTICE DESK
        </p>

        <h2 class="font-['EB_Garamond'] text-[clamp(2.35rem,3.8vw,3.75rem)] font-normal leading-[1.02] tracking-[-0.035em] text-editorial-heading">
          Find your next opportunity.<br />
          <span class="text-editorial-subheading">All in one place.</span>
        </h2>

        <p class="mt-2.5 sm:mt-3 text-[13.5px] sm:text-[14.5px] leading-relaxed text-editorial-muted max-w-lg mx-auto font-['Geist'] font-normal">
          Verified exam updates, admit cards, results, and important notices from all major government exams in one place.
        </p>

        {/* ══════════════════════════════════════════════════════════
            2. INTEGRATED EXAM SEARCH & FILTER BAR
            ══════════════════════════════════════════════════════════ */}
        <div class="mt-5 sm:mt-5.5 relative z-40 max-w-2xl mx-auto" id="command-search-wrapper">
          <div class="bg-editorial-surface border border-editorial-border rounded-2xl sm:rounded-full p-1.5 sm:p-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3 shadow-[0_2px_10px_rgba(25,22,19,0.04)] hover:border-editorial-accent/40 focus-within:border-editorial-accent focus-within:ring-2 focus-within:ring-editorial-accent/10 transition-all">

            {/* Category Filter Dropdown */}
            <div class="relative shrink-0" id="category-dropdown-container">
              <button
                id="category-dropdown-btn"
                type="button"
                class="w-full sm:w-auto flex items-center justify-between sm:justify-start gap-2 px-3.5 py-2 rounded-xl sm:rounded-full bg-editorial-surface-raised hover:bg-editorial-accent-soft text-editorial-heading text-[12.5px] font-medium font-['Geist'] cursor-pointer transition-colors border border-editorial-border"
                aria-expanded="false"
                aria-haspopup="listbox"
                title="Filter by Exam Category"
              >
                <svg class="w-4 h-4 text-editorial-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" />
                  <rect x="14" y="3" width="7" height="7" rx="1.5" />
                  <rect x="14" y="14" width="7" height="7" rx="1.5" />
                  <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
                <span id="category-dropdown-label" class="truncate max-w-[130px]">All exam streams</span>
                <svg id="category-dropdown-arrow" class="w-3.5 h-3.5 text-editorial-muted transition-transform duration-200 shrink-0 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              {/* Category Dropdown Menu */}
              <div
                id="category-dropdown-menu"
                class="hidden absolute left-0 top-full mt-2 w-64 max-h-80 overflow-y-auto bg-editorial-surface border border-editorial-border rounded-2xl shadow-xl py-1.5 z-[100] scrollbar-none font-['Geist']"
                role="listbox"
              >
                <button
                  type="button"
                  data-stream-option="all"
                  data-stream-name="All exam streams"
                  class="category-option-btn w-full flex items-center justify-between px-4 py-2 text-[12.5px] font-semibold text-editorial-heading hover:bg-editorial-accent-soft transition-colors text-left cursor-pointer"
                  role="option"
                  aria-selected="true"
                >
                  <span class="flex items-center gap-2 truncate">
                    <span class="w-1.5 h-1.5 rounded-full bg-editorial-accent"></span>
                    All exam streams
                  </span>
                  <span class="category-check text-editorial-accent font-bold text-xs shrink-0">✓</span>
                </button>
                <div class="h-px bg-editorial-border my-1 mx-3"></div>
                {streamCategories.map((cat) => (
                  <button
                    type="button"
                    data-stream-option={cat.slug}
                    data-stream-name={cat.name}
                    class="category-option-btn w-full flex items-center justify-between px-4 py-2 text-[12.5px] font-medium text-editorial-muted hover:text-editorial-heading hover:bg-editorial-accent-soft transition-colors text-left cursor-pointer"
                    role="option"
                    aria-selected="false"
                  >
                    <span class="truncate">{cat.name}</span>
                    <span class="category-check hidden text-editorial-accent font-bold text-xs shrink-0">✓</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Subtle Divider (Desktop) */}
            <div class="hidden sm:block w-px h-5 bg-editorial-border shrink-0"></div>

            {/* Search Input Field */}
            <div class="flex-1 flex items-center min-w-0 px-2 sm:px-1 gap-2">
              <svg class="w-4 h-4 text-editorial-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <path stroke-linecap="round" d="m21 21-4.35-4.35" />
              </svg>

              <input
                id="command-search-input"
                type="text"
                autocomplete="off"
                spellcheck="false"
                placeholder="Search exam, post, admit card, result..."
                class="w-full bg-transparent text-[13px] sm:text-[13.5px] text-editorial-heading placeholder:text-editorial-muted/60 focus:outline-none py-1 font-['Geist']"
                aria-label="Search exam, post, admit card, result"
              />

              <button
                id="command-search-clear"
                type="button"
                class="hidden p-1 text-editorial-muted hover:text-editorial-heading transition-colors cursor-pointer shrink-0"
                title="Clear search"
                aria-label="Clear search text"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            {/* Orange Search CTA Button */}
            <button
              id="editorial-search-submit"
              type="button"
              class="inline-flex items-center justify-center gap-2 px-5 py-2 rounded-xl sm:rounded-full bg-editorial-accent hover:bg-editorial-accent-hover text-white text-[13px] font-semibold font-['Geist'] transition-all shadow-xs cursor-pointer shrink-0"
            >
              <span>Search</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </button>
          </div>
        </div>
      </section>

      {/* ══════════════════════════════════════════════════════════
          3. EXAM STREAMS — 3-COLUMN EDITORIAL SECTION
          ══════════════════════════════════════════════════════════ */}
      <section id="bento-grid-section" class="mt-5 sm:mt-6 mb-16" aria-label="Exam Streams">

        {/* Section Header */}
        <div class="flex items-center gap-3 sm:gap-4 mb-6">
          <div class="flex items-center gap-2.5 shrink-0">
            <span class="w-1.5 h-4.5 bg-editorial-accent rounded-full inline-block"></span>
            <h2 class="font-['EB_Garamond'] text-2xl sm:text-[26px] font-normal text-editorial-heading tracking-tight whitespace-nowrap">
              Exam Streams
            </h2>
          </div>
          <div class="h-px flex-1 bg-editorial-border" aria-hidden="true"></div>
          <span 
            id="active-notices-badge"
            class="text-[11px] sm:text-[11.5px] font-medium font-['Geist'] text-editorial-accent bg-editorial-accent-badge px-3 py-0.5 rounded-full border border-editorial-accent/20 tabular-nums shrink-0 whitespace-nowrap"
          >
            {displayArticles.length} active notices
          </span>
        </div>

        {/* 3-Column Editorial Grid (Matching Reference Columns) */}
        <div 
          id="bento-cards-container" 
          class="editorial-stream-grid"
        >
          {bentoGridData.map((cat) => (
            <article
              data-bento-card
              data-stream-slug={cat.slug}
              data-stream-name={cat.name.toLowerCase()}
              data-stream-keywords={cat.keywords.join(' ')}
              class="editorial-stream-card flex flex-col justify-between"
            >
              {/* Stream Header */}
              <div class="flex items-start gap-3.5 mb-3">
                <div class="w-9 h-9 rounded-full border border-editorial-border bg-editorial-surface flex items-center justify-center text-editorial-accent shrink-0 shadow-2xs mt-0.5">
                  {cat.iconType === 'monument' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 14v5m4-5v5m4-5v5M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                    </svg>
                  )}
                  {cat.iconType === 'train' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                      <rect x="4" y="3" width="16" height="14" rx="3" stroke-width="1.8"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h16M8 14h.01M16 14h.01M7 21l2-4m8 4l-2-4" />
                    </svg>
                  )}
                  {cat.iconType === 'bank' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l9-4 9 4v2H3V6zm2 4h2v8H5v-8zm6 0h2v8h-2v-8zm6 0h2v8h-2v-8zM2 20h20v2H2v-2z" />
                    </svg>
                  )}
                  {cat.iconType === 'building' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  )}
                  {cat.iconType === 'book' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                  )}
                  {cat.iconType === 'shield' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  )}
