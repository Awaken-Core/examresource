  {/* Client-Side Command Controller for Real-Time Search & Stream Filter — PRESERVED EXACTLY */}
  <script is:inline>
    (function () {
      function setupCommandSearch() {
        const searchInput = document.getElementById('command-search-input');
        const clearBtn = document.getElementById('command-search-clear');
        const dropdownContainer = document.getElementById('category-dropdown-container');
        const dropdownBtn = document.getElementById('category-dropdown-btn');
        const dropdownMenu = document.getElementById('category-dropdown-menu');
        const dropdownLabel = document.getElementById('category-dropdown-label');
        const dropdownArrow = document.getElementById('category-dropdown-arrow');
        const optionBtns = document.querySelectorAll('.category-option-btn');
        const cards = document.querySelectorAll('[data-bento-card]');
        const emptyState = document.getElementById('bento-empty-state');
        const resetAllBtn = document.getElementById('bento-reset-all-btn');

        if (!searchInput || !cards.length) return;

        let activeStream = 'all';

        function toggleDropdown(forceClose) {
          if (!dropdownMenu) return;
          const isCurrentlyHidden = dropdownMenu.classList.contains('hidden') || dropdownMenu.style.display === 'none';
          const shouldOpen = forceClose === undefined ? isCurrentlyHidden : !forceClose;

          if (shouldOpen) {
            dropdownMenu.classList.remove('hidden');
            dropdownMenu.style.display = 'block';
            dropdownBtn?.setAttribute('aria-expanded', 'true');
            dropdownArrow?.classList.add('rotate-180');
          } else {
            dropdownMenu.classList.add('hidden');
            dropdownMenu.style.display = 'none';
            dropdownBtn?.setAttribute('aria-expanded', 'false');
            dropdownArrow?.classList.remove('rotate-180');
          }
        }

        if (dropdownBtn) {
          dropdownBtn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
            toggleDropdown();
          };
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
          if (dropdownContainer && !dropdownContainer.contains(e.target)) {
            toggleDropdown(true);
          }
        });

        // Close dropdown on Escape
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && dropdownMenu && !dropdownMenu.classList.contains('hidden')) {
            toggleDropdown(true);
          }
        });

        function executeFilter() {
          const query = searchInput.value.trim().toLowerCase();

          if (clearBtn) {
            clearBtn.classList.toggle('hidden', query.length === 0);
          }

          let visibleCards = 0;
          let visibleRows = 0;

          cards.forEach((card) => {
            const streamSlug = card.getAttribute('data-stream-slug') || '';
            const streamName = card.getAttribute('data-stream-name') || '';
            const streamKeywords = card.getAttribute('data-stream-keywords') || '';
            const rows = card.querySelectorAll('[data-stream-item]');

            const matchesStream = activeStream === 'all' || streamSlug === activeStream;

            if (!matchesStream) {
              card.classList.add('hidden');
              return;
            }

            if (query.length > 0) {
              const cardMatches = streamName.includes(query) || streamKeywords.includes(query);
              let rowMatched = false;

              rows.forEach((row) => {
                const title = row.getAttribute('data-stream-title') || '';
                if (title.includes(query) || cardMatches) {
                  row.classList.remove('hidden');
                  rowMatched = true;
                  visibleRows++;
                } else {
                  row.classList.add('hidden');
                }
              });

              if (rowMatched || cardMatches || rows.length === 0) {
                card.classList.remove('hidden');
                visibleCards++;
              } else {
                card.classList.add('hidden');
              }
            } else {
              card.classList.remove('hidden');
              rows.forEach((row) => {
                row.classList.remove('hidden');
                visibleRows++;
              });
              visibleCards++;
            }
          });

          if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCards > 0);
          }
        }

        searchInput.addEventListener('input', executeFilter);

        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            searchInput.value = '';
            searchInput.focus();
            executeFilter();
          });
        }

        const searchSubmitBtn = document.getElementById('editorial-search-submit');
        if (searchSubmitBtn) {
          searchSubmitBtn.addEventListener('click', function () {
            executeFilter();
            searchInput.focus();
          });
        }

        searchInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            executeFilter();
          }
        });

        optionBtns.forEach((btn) => {
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            const optionSlug = this.getAttribute('data-stream-option') || 'all';
            const optionName = this.getAttribute('data-stream-name') || 'All exam streams';

            activeStream = optionSlug;

            if (dropdownLabel) {
              dropdownLabel.textContent = optionName;
            }

            optionBtns.forEach((b) => {
              const isSelected = (b.getAttribute('data-stream-option') || '') === optionSlug;
              b.setAttribute('aria-selected', isSelected ? 'true' : 'false');
              b.classList.toggle('text-editorial-heading', isSelected);
              b.classList.toggle('font-semibold', isSelected);
              b.classList.toggle('text-editorial-muted', !isSelected);
              b.classList.toggle('font-medium', !isSelected);

              const checkIcon = b.querySelector('.category-check');
              if (checkIcon) {
                checkIcon.classList.toggle('hidden', !isSelected);
              }
            });

            toggleDropdown(true);
            executeFilter();
          });
        });

        function resetAll() {
          searchInput.value = '';
          activeStream = 'all';

          if (dropdownLabel) {
            dropdownLabel.textContent = 'All exam streams';
          }

          optionBtns.forEach((b) => {
            const isAll = (b.getAttribute('data-stream-option') || '') === 'all';
            b.setAttribute('aria-selected', isAll ? 'true' : 'false');
            b.classList.toggle('text-editorial-heading', isAll);
            b.classList.toggle('font-semibold', isAll);
            b.classList.toggle('text-editorial-muted', !isAll);
            b.classList.toggle('font-medium', !isAll);

            const checkIcon = b.querySelector('.category-check');
            if (checkIcon) {
              checkIcon.classList.toggle('hidden', !isAll);
            }
          });

          executeFilter();
          searchInput.focus();
        }

        if (resetAllBtn) resetAllBtn.addEventListener('click', resetAll);

        // Global hotkey: '/' or Ctrl+K focuses the hero search input
        window.addEventListener('keydown', function (e) {
          if ((e.ctrlKey && e.key.toLowerCase() === 'k') || (e.key === '/' && document.activeElement?.tagName !== 'INPUT')) {
            e.preventDefault();
            searchInput.focus();
            searchInput.select();
          } else if (e.key === 'Escape' && document.activeElement === searchInput) {
            searchInput.value = '';
            executeFilter();
            searchInput.blur();
          }
        });
        // Synchronize stream search titles when language switcher updates article titles in place
        try {
          const titleObserver = new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
              const el = m.target;
              const link = el instanceof Element ? el.closest('[data-stream-item]') : el.parentElement?.closest('[data-stream-item]');
              if (link) {
                const titleText = link.querySelector('[data-article-title]')?.textContent || '';
                link.setAttribute('data-stream-title', titleText.toLowerCase().trim());
              }
            });
          });

          document.querySelectorAll('[data-article-title]').forEach(function (el) {
            titleObserver.observe(el, { childList: true, characterData: true, subtree: true });
          });
        } catch (e) {}
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupCommandSearch);
      } else {
        setupCommandSearch();
      }

      document.addEventListener('astro:page-load', setupCommandSearch);
    })();
  </script>

  {/* Cache top articles for instant 0ms access when opening article pages */}
  <script is:inline define:vars={{ cachedPosts: (livePosts || []).slice(0, 10).map((p: any) => ({
    slug: p.slug,
    title: p.title,
    description: p.description || p.metaDescription || '',
    publishedAt: p.publishedAt,
    category: p.category ? { name: p.category.name, slug: p.category.slug } : null,
  })), cacheLang: listLanguage }}>
    try {
      if (Array.isArray(cachedPosts) && cachedPosts.length > 0) {
        sessionStorage.setItem('recent_posts_' + cacheLang, JSON.stringify(cachedPosts));
      }
    } catch (e) {}
  </script>


  {/* Scoped CSS for the 3-column editorial grid: clean alignment, zero !important, responsive dividers */}
  <style>
    .editorial-stream-grid {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 2.5rem;
    }

    .editorial-stream-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
    }

    @media (min-width: 768px) and (max-width: 1023px) {
      .editorial-stream-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: 2.5rem;
        column-gap: 0;
      }
      .editorial-stream-card {
        padding-left: 1.5rem;
        padding-right: 1.5rem;
        border-right: 1px solid var(--color-editorial-border);
      }
      .editorial-stream-card:nth-child(2n) {
        border-right: none;
        padding-right: 0;
      }
      .editorial-stream-card:nth-child(2n + 1) {
        padding-left: 0;
      }
      .editorial-stream-card:nth-child(n + 3) {
        border-top: 1px solid var(--color-editorial-border);
        padding-top: 2rem;
      }
    }

    @media (min-width: 1024px) {
