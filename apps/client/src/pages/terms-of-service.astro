---
import Layout from '../layouts/Layout.astro';
import { contactEmail, siteUrl, siteName } from '../data/site';

const lastUpdated = "October 17, 2026";
const pageTitle = `Terms of Service | ${siteName}`;
const pageDescription = `Terms and conditions for using ${siteName}. Understand user guidelines, disclaimer of warranties, and non-affiliation notice.`;
const canonicalUrl = `${siteUrl}/terms-of-service`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service",
  "url": canonicalUrl,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "url": siteUrl,
    "logo": `${siteUrl}/og-image.jpg`
  },
  "breadcrumb": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terms of Service",
        "item": canonicalUrl
      }
    ]
  }
};

const sections = [
  { id: "free-service", title: "Free content and the paid pass" },
  { id: "disclaimer", title: "Non-Government Disclaimer" },
  { id: "intellectual-property", title: "Intellectual Property" },
  { id: "user-conduct", title: "User Conduct & Fair Play" },
  { id: "limitation", title: "Limitation of Liability" },
  { id: "governing-law", title: "Governing Law" },
  { id: "contact-info", title: "Contact Information" }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white px-4 sm:px-6 lg:px-8 py-7 transition-colors duration-200">
    <div class="max-w-[1400px] mx-auto">
      
      {/* 2-Column Grid: Main Terms (Left) + Sticky ToC Rail (Right) */}
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_310px] xl:grid-cols-[minmax(0,1fr)_330px] gap-8 items-start">
        
        {/* MAIN EDITORIAL BODY */}
        <div class="min-w-0 space-y-7">
          
          {/* Breadcrumb */}
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-muted">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span>/</span>
            <span class="text-white font-medium">Terms of Service</span>
          </nav>

          {/* Hero Banner */}
          <section class="p-6 sm:p-7 bg-surface border border-border rounded-xl shadow-2xs relative overflow-hidden">
            <div class="relative z-10 space-y-3">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-raised border border-border text-white text-xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <span>User Agreement</span>
              </div>

              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Terms of Service
              </h1>

              <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-3xl">
                Please read these Terms of Service carefully before browsing or using <strong class="text-white">{siteName}</strong> ("Platform", "we", or "us"). By accessing or using our services, you agree to comply with and be bound by these terms.
              </p>

              <div class="pt-3 border-t border-border/50 flex flex-wrap items-center gap-4 text-xs text-muted">
                <span>Last Updated: <strong class="text-white">{lastUpdated}</strong></span>
                <span>•</span>
                <span>Jurisdiction: <strong class="text-white">India</strong></span>
              </div>
            </div>
          </section>

          {/* Main Legal Sections Feed */}
          <main class="space-y-6 text-sm text-muted leading-relaxed">
            
            {/* 1. Free Educational Resource */}
            <section id="free-service" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">1</span>
                  <span>What is free, and what is paid</span>
                </h2>
              </div>
              <p>
                {siteName} publishes exam notices, articles, and study guides free of charge. One test inside each test series is also free. A Test Series Pass is a separate paid product. Its price, duration, and limits are on the <a href="/pricing" class="text-accent hover:underline">pricing page</a>. Refunds for that pass are on the <a href="/refund-policy" class="text-accent hover:underline">refund and cancellation policy</a>.
              </p>
              <div class="p-3.5 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-900 dark:text-amber-200 text-xs leading-relaxed">
                <span class="font-bold text-amber-800 dark:text-amber-300">Fraud warning:</span> Pay for the Test Series Pass only on this website, through the Razorpay window opened by the Buy pass button. {siteName} does not ask for payment on WhatsApp, Telegram, or a personal UPI account. If someone does, do not pay, and write to <a href={`mailto:${contactEmail}`} class="underline font-semibold hover:text-amber-700 dark:hover:text-amber-100">{contactEmail}</a>.
              </div>
            </section>

            {/* 2. Non-Government Disclaimer */}
            <section id="disclaimer" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">2</span>
                  <span>Non-Government Disclaimer (Important Notice)</span>
                </h2>
              </div>
              <p>
                <strong class="text-white">{siteName} is an independent educational portal.</strong> We are not affiliated with, authorized by, endorsed by, or in any way officially associated with the Government of India, any State Government, or any recruitment commission (such as UPSC, SSC, IBPS, RRB, NTA, or State PSCs).
              </p>
              <p class="text-xs">
                All official recruitment notifications, exam schedules, admit cards, and results are issued exclusively by the respective recruiting bodies on their official web domains. Always verify all dates and instructions with the official government PDFs.
              </p>
            </section>

            {/* 3. Intellectual Property */}
            <section id="intellectual-property" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">3</span>
                  <span>Intellectual Property &amp; Acceptable Use</span>
                </h2>
              </div>
              <p>
                All platform styling, curated summaries, visual assets, and application software are the intellectual property of {siteName}.
              </p>
              <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
                <li>You are permitted to access and read the platform solely for your personal, non-commercial exam preparation.</li>
                <li>You may not run automated scrapers, crawlers, or harvesting bots against our servers without prior written authorization.</li>
              </ul>
            </section>

            {/* 4. User Conduct */}
            <section id="user-conduct" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">4</span>
                  <span>User Conduct &amp; Community Standards</span>
                </h2>
              </div>
              <p>When using our site or submitting feedback via our contact channels, you agree:</p>
              <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
                <li>To provide accurate details and communicate respectfully with our support staff.</li>
                <li>Not to transmit spam, unsolicited commercial messages, or malicious payloads.</li>
                <li>Not to attempt penetration testing, service interruption, or unauthorized access to platform databases.</li>
              </ul>
            </section>

            {/* 5. Limitation of Liability */}
            <section id="limitation" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">5</span>
                  <span>Disclaimer of Warranties &amp; Limitation of Liability</span>
                </h2>
              </div>
              <p>
                Content on this website is provided on an "as-is" and "as-available" basis for general guidance. While our team works continuously to verify every notification against official commission gazettes, official exam dates or eligibility rules can change at short notice.
              </p>
              <p class="text-xs">
                {siteName} shall not be held liable for any damages, errors, or losses arising from reliance on information published on the site.
              </p>
            </section>

            {/* 6. Governing Law */}
            <section id="governing-law" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">6</span>
                  <span>Governing Law &amp; Jurisdiction</span>
                </h2>
              </div>
              <p>
                These Terms of Service are governed by and construed under the laws of India. Any legal dispute or claim arising out of your use of the website shall be subject to the exclusive jurisdiction of the competent courts in India.
              </p>
            </section>

            {/* 7. Contact Info */}
            <section id="contact-info" class="p-6 bg-surface border border-border rounded-xl shadow-2xs scroll-mt-24 space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  <span class="w-6 h-6 rounded-md bg-surface-raised text-white text-xs font-bold flex items-center justify-center border border-border">7</span>
                  <span>Contact Information</span>
                </h2>
              </div>
              <p>For questions or notices regarding these Terms, contact our legal desk:</p>
              <div class="p-4 rounded-lg bg-surface-raised border border-border/80 text-xs space-y-1.5 text-white">
                <p><span class="text-muted">Platform:</span> <strong>{siteName}</strong></p>
                <p><span class="text-muted">Website:</span> <a href={`${siteUrl}/`} class="text-accent hover:underline">{siteUrl}/</a></p>
                <p><span class="text-muted">Email:</span> <a href={`mailto:${contactEmail}`} class="text-accent hover:underline">{contactEmail}</a></p>
              </div>
            </section>

          </main>

        </div>

        {/* RIGHT SIDEBAR (Sticky Quick ToC & Contact Card) */}
        <aside class="space-y-6 hidden lg:block sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto scrollbar-none">
          
          {/* Table of Contents Box */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3 transition-colors">
            <h3 class="text-xs font-bold uppercase tracking-wider text-muted pb-1 border-b border-border/50">
              Terms Navigation
            </h3>
            <nav class="space-y-1 text-xs">
              {sections.map((s, idx) => (
                <a
                  href={`#${s.id}`}
                  class="flex items-center gap-2 py-1.5 px-2 rounded hover:bg-surface-raised text-muted hover:text-white transition group"
                >
                  <span class="w-4 text-[10px] text-muted group-hover:text-accent font-mono">{idx + 1}.</span>
                  <span class="truncate">{s.title}</span>
                </a>
              ))}
            </nav>
          </div>

          {/* Contact Support */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-2.5 transition-colors text-xs text-muted">
            <p class="font-bold text-white text-sm">Have Questions?</p>
            <p class="leading-relaxed">Need clarification on any part of our terms and policies?</p>
            <div class="pt-2">
              <a
                href="/contact-us"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-surface-raised border border-border hover:border-accent text-white font-medium text-xs transition"
              >
                <span>Write to Us</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </div>
</Layout>
