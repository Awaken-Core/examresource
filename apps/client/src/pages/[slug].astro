---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BlogArticle from '../components/blog/BlogArticle.astro';
import TopicNavigation from '../components/blog/TopicNavigation.astro';
import Comments from '../components/blog/Comments.astro';
import ArticleCard from '../components/blog/ArticleCard.astro';
import type { TopicDetail } from '../data/blogData';
import { API_URL } from '../lib/api';
import { getRecentPosts, getCachedRecentPostsSync, type ListingPost } from '../lib/recent-posts';
import { siteUrl, siteName, siteDomain } from '../data/site';
import { buildLangVersion, processArticleHtml, type ArticleLangBundle } from '../lib/article-lang';
import { blogLanguageToAppLang, resolveArticleLanguage } from '../lib/preferred-lang';
import { ProfileHub } from '../components/profile/ProfileHub';

const { slug: slugParam } = Astro.params;
const slugKey = (slugParam || '').toLowerCase();
const isProfile = slugKey === 'profile';

// Automatic 301 redirect for legacy -english or -hinglish URLs to clean slug
const cleanSlugMatch = slugKey.match(/^(.*?)-(english|hinglish)$/i);
if (cleanSlugMatch && cleanSlugMatch[1]) {
  return Astro.redirect(`/${cleanSlugMatch[1]}`, 301);
}

// Legacy or malformed sitemap and XML requests redirect cleanly to /sitemap.xml
if (slugKey.endsWith('-sitemap.xml') || slugKey.endsWith('.xml')) {
  return Astro.redirect('/sitemap.xml', 301);
}

// URL ?lang= wins; otherwise honor preferred_lang cookie so toggle & content stay in sync
const langParam = Astro.url.searchParams.get('lang');
const requestedLanguage = resolveArticleLanguage({
  langParam,
  cookieHeader: Astro.request.headers.get('cookie'),
});

let livePost: any = isProfile ? { htmlContent: '', slug: '', title: '' } : null;
let alternatePost: any = null;
let redirectUrl: string | null = null;

// Fetch primary article AND recent posts concurrently during SSR for instant TTFB & reliable layout
let recentPosts: ListingPost[] = [];

try {
  const [primaryRes, fetchedRecent] = await Promise.all([
    fetch(`${API_URL}/blogs/${slugKey}?language=${requestedLanguage}`, {
      signal: AbortSignal.timeout(5000),
    }),
    getRecentPosts(requestedLanguage, slugKey).catch(() => []),
  ]);

  recentPosts = Array.isArray(fetchedRecent) && fetchedRecent.length > 0 
    ? fetchedRecent 
    : getCachedRecentPostsSync(requestedLanguage, slugKey);

  if (primaryRes.ok) {
    livePost = await primaryRes.json();
    const alt = livePost?.alternateArticle;
    if (alt?.language && alt.language !== livePost?.language && alt.htmlContent != null) {
      alternatePost = alt;
    }
  } else if (primaryRes.status === 404) {
    try {
      const errData = await primaryRes.json();
      if (errData?.redirectUrl) redirectUrl = errData.redirectUrl;
    } catch {}
  }
} catch (e) {
  recentPosts = getCachedRecentPostsSync(requestedLanguage, slugKey);
}

if (redirectUrl) {
  return Astro.redirect(redirectUrl, 301);
}

if (!livePost && !isProfile) {
  return Astro.rewrite('/404');
}

const { htmlBody } = processArticleHtml(livePost.htmlContent || '', livePost.title);

const subjectSlug = livePost.category?.slug || 'general';

const article: TopicDetail = {
  slug: livePost.slug,
  title: livePost.title,
  subjectSlug,
  subjectTitle: livePost.category?.name || 'General',
  description: livePost.description || livePost.metaDescription || '',
  readTime: '4 min read',
  difficulty: 'Intermediate',
  category: livePost.category?.name || 'Articles',
  publishedDate: livePost.publishedAt ? new Date(livePost.publishedAt).toISOString().split('T')[0] : '2026-10-13',
  updatedDate: livePost.updatedAt ? new Date(livePost.updatedAt).toISOString().split('T')[0] : '2026-10-13',
  introParagraphs: [
    livePost.description || 'Detailed guide and notification information.',
  ],
  sections: [],
  summaryPoints: [
    `Official publication for ${livePost.title}.`,
    'Review complete eligibility, timelines, and guidelines below.',
  ],
};

const plainText = (htmlBody || article.introParagraphs.join(' ')).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const wordCount = plainText ? plainText.split(' ').length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

// Edge CDN caching: cache article HTML for 5 minutes, serve stale up to 15 minutes
Astro.response.headers.set(
  'Cache-Control',
  isProfile
    ? 'private, no-store'
    : 'public, max-age=0, s-maxage=300, stale-while-revalidate=900',
);

function makePageTitle(metaTitle: string | undefined, title: string) {
  const base = metaTitle || title;
  const brandSuffix = base.toLowerCase().includes(siteName.toLowerCase()) ? '' : ` | ${siteName}`;
  return `${base}${brandSuffix}`;
}

function makePageDescription(post: any, title: string, description: string) {
  const rawDesc = post?.metaDescription || description || '';
  return rawDesc.trim().length > 0
    ? rawDesc.trim()
    : `Read complete official notification details, eligibility, exam dates, syllabus, and direct application links for ${title} on ${siteName} (${siteDomain}).`;
}

const pageTitle = makePageTitle(livePost?.metaTitle, article.title);
const pageDescription = makePageDescription(livePost, article.title, article.description);

// Canonical URL is always the slug without query params (/{slug})
let canonicalUrl = `${siteUrl}/${article.slug}`;
if (livePost?.canonicalUrl) {
  const custom = String(livePost.canonicalUrl).trim();
  if (custom && !custom.includes('.local') && !custom.includes('localhost') && /^https?:\/\//i.test(custom)) {
    canonicalUrl = custom;
  }
}

const postCover = livePost?.coverImage || livePost?.firstImage || `${siteUrl}/og-image.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["NewsArticle", "BlogPosting"],
      "@id": `${canonicalUrl}#article`,
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["[data-article-title]", "h1", "nav[aria-label='Breadcrumb']", "[data-article-description]"]
      },
      "isPartOf": {
        "@type": "WebPage",
        "@id": canonicalUrl,
        "url": canonicalUrl,
        "name": pageTitle,
        "description": pageDescription
      },
      "headline": article.title,
      "name": article.title,
      "description": pageDescription,
      "about": [
        {
          "@type": "Thing",
          "name": article.subjectTitle
        },
        {
          "@type": "Thing",
          "name": "Government Recruitment"
        }
      ],
      "mentions": [
        {
          "@type": "Thing",
          "name": article.category
        }
      ],
      "image": [postCover],
      "datePublished": article.publishedDate,
      "dateModified": article.updatedDate,
      "author": {
        "@type": "Organization",
        "name": livePost?.author?.name || `${siteName} Editorial Team`,
        "url": siteUrl
      },
      "publisher": {
        "@type": "Organization",
        "name": siteName,
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/logo.png`,
          "width": 512,
          "height": 512
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "articleSection": article.subjectTitle,
      "inLanguage": requestedLanguage === 'ENGLISH' ? 'en-IN' : 'hi-Latn',
      "wordCount": wordCount,
      "isAccessibleForFree": "True",
      "keywords": [
        article.title,
        article.subjectTitle,
        siteName,
        "Government Exam",
        "Sarkari Naukri",
        "Recruitment Notification"
      ].join(', ')
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": article.subjectTitle,
          "item": `${siteUrl}/category/${article.subjectSlug}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};

const currentLanguage = (livePost?.language || requestedLanguage) as 'HINGLISH' | 'ENGLISH';
const alternateLanguage = (
  alternatePost?.language === 'ENGLISH' || alternatePost?.language === 'HINGLISH'
    ? alternatePost.language
    : currentLanguage === 'ENGLISH'
      ? 'HINGLISH'
      : 'ENGLISH'
) as 'HINGLISH' | 'ENGLISH';
const hasAlternateLanguage = Boolean(alternatePost);

const siteOrigin = siteUrl;
const alternateLinks: { hreflang: string; href: string }[] = [];
alternateLinks.push({ hreflang: 'hi-Latn', href: `${siteOrigin}/${article.slug}` });
alternateLinks.push({ hreflang: 'x-default', href: `${siteOrigin}/${article.slug}` });
if (hasAlternateLanguage) {
  alternateLinks.push({ hreflang: 'en', href: `${siteOrigin}/${article.slug}` });
}

// Embed both language versions for instant client-side swap (no navigation)
const langBundle: ArticleLangBundle = {};
langBundle[currentLanguage] = buildLangVersion({
  language: currentLanguage,
  title: article.title,
  description: article.description,
  pageTitle,
  pageDescription,
  htmlBody: htmlBody || '',
  updatedDate: article.updatedDate,
  coverImage: livePost?.coverImage || null,
  imageAlt: livePost?.imageAlt || null,
  imageCaption: livePost?.imageCaption || null,
  slug: article.slug,
});

if (alternatePost) {
  const altProcessed = processArticleHtml(alternatePost.htmlContent || '', alternatePost.title);
  const altTitle = alternatePost.title;
  const altDesc = alternatePost.description || alternatePost.metaDescription || '';
  const altUpdated = alternatePost.updatedAt
    ? new Date(alternatePost.updatedAt).toISOString().split('T')[0]
    : article.updatedDate;
  langBundle[alternateLanguage] = buildLangVersion({
    language: alternateLanguage,
    title: altTitle,
    description: altDesc,
    pageTitle: makePageTitle(alternatePost.metaTitle, altTitle),
    pageDescription: makePageDescription(alternatePost, altTitle, altDesc),
    htmlBody: altProcessed.htmlBody,
    updatedDate: altUpdated,
    // Prefer alt cover; fall back to primary (images are synced across the group)
    coverImage: alternatePost.coverImage || livePost?.coverImage || null,
    imageAlt: alternatePost.imageAlt || livePost?.imageAlt || null,
    imageCaption: alternatePost.imageCaption || livePost?.imageCaption || null,
    slug: article.slug,
  });
}

const langBundleJson = JSON.stringify(langBundle).replace(/</g, '\\u003c');

// Helper: is article published within last 3 days?
const THREE_DAYS_MS = 3 * 24 * 60 * 60 * 1000;
function computeIsNew(publishedAt: string | null | undefined): boolean {
  if (!publishedAt) return false;
  return Date.now() - new Date(publishedAt).getTime() < THREE_DAYS_MS;
}
---

{isProfile ? (
  <Layout title={`My Preparation | ${siteName}`} noindex>
    <main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
      <ProfileHub client:load />
    </main>
  </Layout>
) : (
<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={postCover}
  publishedTime={article.publishedDate}
  modifiedTime={article.updatedDate}
  jsonLd={jsonLd}
  alternateLinks={alternateLinks}
  noindex={Boolean(livePost?.noindex)}
>
  <script type="application/json" id="article-lang-data" set:html={langBundleJson} />

  <div
    id="overview-top"
    class="blog-reading-view min-h-screen bg-canvas text-heading"
    data-article-lang={blogLanguageToAppLang(currentLanguage)}
  >
    <article
      class="w-full px-3.5 py-3 sm:px-6 sm:py-6 lg:px-8 max-w-7xl mx-auto flex flex-col gap-3.5 sm:gap-6 xl:grid xl:grid-cols-[minmax(0,1fr)_300px] xl:gap-x-8 xl:gap-y-5 xl:items-start"
      itemscope
      itemtype="https://schema.org/Article"
    >
      <header class="min-w-0 xl:col-start-1 xl:row-start-1">
        <nav aria-label="Breadcrumb" class="mb-2 sm:mb-3 flex items-center gap-1.5 text-[11px] sm:text-xs text-muted overflow-x-auto scrollbar-none whitespace-nowrap py-0.5">
          <a href="/" class="hover:text-accent shrink-0">Home</a>
          <span class="text-muted/40 shrink-0">/</span>
          <a href="/" class="hover:text-accent shrink-0">Articles</a>
          <span class="text-muted/40 shrink-0">/</span>
          <a href={`/category/${article.subjectSlug}`} target="_blank" rel="noopener" data-astro-prefetch="false" class="hover:text-accent shrink-0">{article.subjectTitle}</a>
          <span class="text-muted/40 shrink-0">/</span>
          <span class="truncate font-medium text-heading max-w-[170px] sm:max-w-xs md:max-w-none" data-article-crumb-title>{article.title}</span>
        </nav>
        <div class="mb-3 sm:mb-5 flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 text-xs text-muted">
          <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap min-w-0 text-[11px] sm:text-xs">
            <span class="rounded bg-accent/10 px-2 py-0.5 font-semibold text-accent border border-accent/20 shrink-0">{article.category}</span>
            <span class="text-muted/60">•</span>
            <span data-article-read-time class="shrink-0">{readMinutes} min read</span>
            <span class="text-muted/60 hidden xs:inline">•</span>
            <span data-article-updated class="hidden xs:inline shrink-0">Updated {article.updatedDate}</span>
          </div>

          {/* Article Action Buttons: Favorite (localStorage) & Share */}
          <div class="inline-flex items-center gap-1.5 shrink-0 ml-auto sm:ml-0">
            <button 
              type="button" 
              data-favorite-slug={article.slug}
              data-favorite-title={article.title}
              data-favorite-category={article.category}
              data-favorite-url={canonicalUrl}
              class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 rounded-lg bg-surface-raised/50 hover:bg-surface-raised border border-border/70 hover:border-red-500/50 text-muted hover:text-heading transition-all text-xs font-medium cursor-pointer shadow-2xs group shrink-0"
              title="Add article to favorites"
              aria-label="Add article to favorites"
            >
              <svg class="favorite-icon w-3.5 h-3.5 text-muted group-hover:text-red-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              <span class="favorite-label font-medium hidden xs:inline">Favorite</span>
            </button>

            <button 
              type="button" 
              data-share-btn
              data-share-url={canonicalUrl}
              data-share-title={article.title}
              class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3 rounded-lg bg-surface-raised/50 hover:bg-surface-raised border border-border/70 hover:border-accent/50 text-muted hover:text-heading transition-all text-xs font-medium cursor-pointer shadow-2xs group shrink-0"
              title="Share this article"
              aria-label="Share this article"
            >
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition fill-current" viewBox="0 0 24 24">
                <path d="M14 5v4C7 10 4 15 3 20c2.5-3.5 6-5.1 11-5.1V19l8-7-8-7z" />
              </svg>
              <span class="font-medium">Share</span>
            </button>
          </div>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold tracking-tight text-heading leading-snug sm:leading-tight" data-article-title itemprop="headline">{article.title}</h1>
        <p
          class="mt-1.5 sm:mt-2.5 max-w-4xl text-xs sm:text-sm md:text-base leading-relaxed text-muted"
          data-article-description
          itemprop="description"
          hidden={!article.description}
        >{article.description}</p>
      </header>

      {/* Desktop Right Rail: Recent Posts */}
      <aside aria-label="Recent posts" class="hidden xl:flex xl:flex-col xl:col-start-2 xl:row-start-1 xl:row-span-2 xl:sticky xl:top-20 xl:max-h-[calc(100dvh-6rem)] xl:overflow-y-auto xl:pb-4">
        <div id="recent-posts-rail" class="w-full">
          {recentPosts.length > 0 && (
            <div class="rounded-xl border border-border bg-surface p-4 flex flex-col shadow-xs w-full">
              <div class="flex items-center justify-between pb-2.5 border-b border-border/60 mb-2">
                <h3 class="text-xs font-bold uppercase tracking-wider text-heading flex items-center gap-2">
                  <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                  Recent Posts
                </h3>
              </div>
              <div class="space-y-1">
                {recentPosts.slice(0, 5).map((post) => (
                  <ArticleCard
                    variant="compact"
                    title={post.title}
                    slug={post.slug}
                    href={`/${post.slug}`}
                    category={post.category?.name || 'Latest Updates'}
                    publishedAt={post.publishedAt}
                    headingLevel="h4"
                  />
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>

      <div class="min-w-0 xl:col-start-1 xl:row-start-2">
        {htmlBody ? (
          <div id="article-body" class="space-y-4 sm:space-y-6" itemprop="articleBody">
            {livePost.coverImage && (
              <figure class="my-1 sm:my-3" data-article-cover>
                <Image
                  src={livePost.coverImage}
                  alt={livePost.imageAlt || article.title}
                  class="max-h-56 sm:max-h-80 md:max-h-[28rem] w-full rounded-xl border border-border object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width={800}
                  height={420}
                />
                {livePost.imageCaption && (
                  <figcaption class="mt-1.5 text-center text-xs text-muted">{livePost.imageCaption}</figcaption>
                )}
              </figure>
            )}
            <div class="prose-markdown markdown-preview-content max-w-none" data-article-html set:html={htmlBody} />
          </div>
        ) : (
          <div id="article-body" itemprop="articleBody">
            <BlogArticle article={article} />
          </div>
        )}

        {/* End of Article Share Bar */}
        <div class="mt-6 sm:mt-10 p-3 sm:p-4 rounded-xl border border-border/80 bg-surface/90 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-2xs">
          <div class="flex items-center gap-2.5 text-center sm:text-left w-full sm:w-auto">
            <div class="w-8 h-8 rounded-lg bg-accent/15 border border-accent/30 text-accent flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M14 5v4C7 10 4 15 3 20c2.5-3.5 6-5.1 11-5.1V19l8-7-8-7z" />
              </svg>
            </div>
            <div>
              <p class="text-xs sm:text-sm font-semibold text-heading">Share this article</p>
              <p class="text-[11px] text-muted">Spread the update with fellow aspirants</p>
            </div>
          </div>

          <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
            <button
              type="button"
              data-share-btn
              data-share-url={canonicalUrl}
              data-share-title={article.title}
              class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent hover:bg-accent/90 text-white font-semibold text-xs transition cursor-pointer shadow-2xs"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M14 5v4C7 10 4 15 3 20c2.5-3.5 6-5.1 11-5.1V19l8-7-8-7z" />
              </svg>
              <span>Share</span>
            </button>
            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' ' + canonicalUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#25D366]/15 hover:bg-[#25D366]/25 border border-[#25D366]/30 text-[#25D366] font-semibold text-xs transition cursor-pointer"
              title="Share on WhatsApp"
              aria-label="Share on WhatsApp"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span class="hidden sm:inline">WhatsApp</span>
            </a>
            <a
              href={`https://t.me/share/url?url=${encodeURIComponent(canonicalUrl)}&text=${encodeURIComponent(article.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#2AABEE]/15 hover:bg-[#2AABEE]/25 border border-[#2AABEE]/30 text-[#2AABEE] font-semibold text-xs transition cursor-pointer"
              title="Share on Telegram"
              aria-label="Share on Telegram"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              <span class="hidden sm:inline">Telegram</span>
            </a>
          </div>
        </div>

        <div id="recent-posts-bottom">
          {recentPosts.length > 0 && (
            <section class="mt-8 pt-6 sm:mt-12 sm:pt-8 border-t border-border/80 xl:hidden" aria-label="Recent posts">
              <div class="flex items-center justify-between gap-3 mb-3.5 sm:mb-4">
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-accent/15 border border-accent/30 text-accent flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <h2 class="text-sm sm:text-base font-bold text-heading tracking-tight leading-tight">Recent Posts</h2>
                    <p class="text-[11px] text-muted truncate">Latest notifications and announcements</p>
                  </div>
                </div>
                <a
                  href="/"
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-surface-raised/60 hover:bg-surface-raised border border-border/70 hover:border-accent/40 text-[11px] sm:text-xs font-semibold text-accent transition-all shrink-0"
                  aria-label="View all posts"
                >
                  <span>View all</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-3.5">
                {recentPosts.slice(0, 4).map((post) => (
                  <ArticleCard
                    variant="standard"
                    title={post.title}
                    slug={post.slug}
                    href={`/${post.slug}`}
                    category={post.category?.name || 'Latest Updates'}
                    publishedAt={post.publishedAt}
                    summary={post.description || post.metaDescription}
                    headingLevel="h3"
                  />
                ))}
              </div>
            </section>
          )}
        </div>

        <Comments slug={article.slug} language={requestedLanguage} />

        <TopicNavigation
          subjectSlug={article.subjectSlug}
          prevTopic={article.prevTopic}
          nextTopic={article.nextTopic}
        />
      </div>
    </article>
  </div>

  <script>
    import { bindArticleReading } from '../lib/article-reading';
    bindArticleReading();
    document.addEventListener('astro:page-load', bindArticleReading);
  </script>

  {/* Clean query params from address bar without page reload */}
  <script is:inline>
    try {
      if (window.location.search && window.location.search.indexOf('lang=') !== -1) {
        window.history.replaceState(null, '', window.location.pathname);
      }
    } catch (e) {}
  </script>
</Layout>
)}
