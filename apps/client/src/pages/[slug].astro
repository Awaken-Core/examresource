---
import Layout from '../layouts/Layout.astro';
import BlogArticle from '../components/blog/BlogArticle.astro';
import TopicNavigation from '../components/blog/TopicNavigation.astro';
import AdSlot from '../components/blog/AdSlot.astro';
import LanguageSwitcher from '../components/blog/LanguageSwitcher.astro';
import type { TopicDetail } from '../data/blogData';

const { slug: slugParam } = Astro.params;
const slugKey = (slugParam || '').toLowerCase();

// Language is determined by ?lang= query param (default: HINGLISH)
const langParam = Astro.url.searchParams.get('lang');
const requestedLanguage: 'HINGLISH' | 'ENGLISH' =
  langParam === 'en' || langParam === 'english' || langParam === 'ENGLISH'
    ? 'ENGLISH'
    : 'HINGLISH';

import { API_URL } from '../lib/api';
import { siteUrl, siteName, siteDomain } from '../data/site';

let livePost: any = null;
let redirectUrl: string | null = null;

try {
  const res = await fetch(`${API_URL}/blogs/${slugKey}?language=${requestedLanguage}`);
  if (res.ok) {
    livePost = await res.json();
  } else if (res.status === 404) {
    const errData = await res.json();
    if (errData?.redirectUrl) {
      redirectUrl = errData.redirectUrl;
    }
  }
} catch (e) {}

if (redirectUrl) {
  return Astro.redirect(redirectUrl, 301);
}

// If database returned live post, construct the article object and TOC
let article: TopicDetail;
let tocItems: { id: string; text: string; level: number }[] = [];
let htmlBody: string | null = null;

function toHeadingSlug(text: string): string {
  const s = text
    .toString()
    .toLowerCase()
    .trim()
    .replace(/\\+/g, '')
    .replace(/[^\p{L}\p{N}\s\-]+/gu, '')
    .replace(/\s+/g, '-')
    .replace(/\-+/g, '-')
    .replace(/^-+/, '')
    .replace(/-+$/, '');
  return s || 'section';
}

if (livePost) {
  htmlBody = livePost.htmlContent || '';
  
  // Extract TOC headings from HTML and ensure all headings have an id attribute
  const headingRegex = /<h([2-4])(?:\s+([^>]*))>([\s\S]*?)<\/h\1>/gi;
  let match;
  tocItems.push({ id: 'overview-top', text: livePost.title, level: 2 });
  let hIdx = 0;
  while ((match = headingRegex.exec(htmlBody)) !== null) {
    const level = parseInt(match[1], 10);
    const attrs = match[2] || '';
    const innerContent = match[3] || '';
    const cleanText = innerContent.replace(/<[^>]*>/g, '').replace(/\\+/g, '').trim();
    if (!cleanText) continue;
    const idMatch = attrs.match(/id=["']([^"']+)["']/i);
    const id = idMatch ? idMatch[1] : (toHeadingSlug(cleanText) || `heading-${++hIdx}`);
    tocItems.push({
      level,
      id,
      text: cleanText,
    });
  }

  // Ensure headings in htmlBody have valid id tags matching TOC
  htmlBody = htmlBody.replace(/<h([2-4])(?:\s+([^>]*))?>([\s\S]*?)<\/h\1>/gi, (_full, lvl, attrs = '', content = '') => {
    const cleanText = content.replace(/<[^>]*>/g, '').replace(/\\+/g, '').trim();
    const idMatch = attrs.match(/id=["']([^"']+)["']/i);
    const id = idMatch ? idMatch[1] : (toHeadingSlug(cleanText) || `heading-${++hIdx}`);
    const cleanAttrs = attrs.replace(/id=["'][^"']*["']/i, '').trim();
    return `<h${lvl} id="${id}"${cleanAttrs ? ' ' + cleanAttrs : ''}>${content.replace(/\\+/g, '')}</h${lvl}>`;
  });

  const subjectSlug = livePost.category?.slug || 'general';

  article = {
    slug: livePost.slug,
    title: livePost.title,
    subjectSlug,
    subjectTitle: livePost.category?.name || 'General',
    description: livePost.description || livePost.metaDescription || '',
    readTime: '4 min read',
    difficulty: 'Intermediate',
    category: livePost.category?.name || 'Articles',
    publishedDate: livePost.publishedAt ? new Date(livePost.publishedAt).toISOString().split('T')[0] : '2026-10-13',
    updatedDate: livePost.updatedAt ? new Date(livePost.updatedAt).toISOString().split('T')[0] : '2026-10-13',
    introParagraphs: [
      livePost.description || 'Detailed guide and notification information.',
    ],
    sections: [],
    summaryPoints: [
      `Official publication for ${livePost.title}.`,
      'Review complete eligibility, timelines, and guidelines below.',
    ],
  };
}

if (!livePost) {
  return new Response(null, {
    status: 404,
    statusText: 'Article Not Found',
  });
}

const plainText = (htmlBody || article.introParagraphs.join(' ')).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const wordCount = plainText ? plainText.split(' ').length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

type ListingPost = {
  slug: string;
  title: string;
  description?: string | null;
  metaDescription?: string | null;
  coverImage?: string | null;
  imageAlt?: string | null;
  publishedAt?: string | null;
  updatedAt?: string | null;
  category?: { slug?: string; name?: string } | null;
};

let recentPosts: ListingPost[] = [];
try {
  const listRes = await fetch(`${API_URL}/blogs?limit=12`);
  if (listRes.ok) {
    const all = (await listRes.json()) as ListingPost[];
    recentPosts = all.filter((post) => post.slug !== livePost.slug);
  }
} catch {
  recentPosts = [];
}

const baseTitle = livePost?.metaTitle || article.title;
const brandSuffix = baseTitle.toLowerCase().includes(siteName.toLowerCase()) ? '' : ` | ${siteName}`;
const pageTitle = `${baseTitle}${brandSuffix}`;

const rawDesc = livePost?.metaDescription || article.description || article.introParagraphs?.[0] || '';
const pageDescription = rawDesc.trim().length > 0
  ? rawDesc.trim()
  : `Read complete official notification details, eligibility, exam dates, syllabus, and direct application links for ${article.title} on ${siteName} (${siteDomain}).`;

// Canonical URL is always the slug without query params (/{slug})
let canonicalUrl = `${siteUrl}/${article.slug}`;
if (livePost?.canonicalUrl) {
  const custom = String(livePost.canonicalUrl).trim();
  if (custom && !custom.includes('.local') && !custom.includes('localhost') && /^https?:\/\//i.test(custom)) {
    canonicalUrl = custom;
  }
}

const postCover = livePost?.coverImage || livePost?.firstImage || `${siteUrl}/og-image.jpg`;

// Schema.org Article & Breadcrumbs
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebPage",
        "@id": canonicalUrl,
        "url": canonicalUrl,
        "name": pageTitle,
        "description": pageDescription
      },
      "headline": article.title,
      "name": article.title,
      "description": pageDescription,
      "image": [postCover],
      "datePublished": article.publishedDate,
      "dateModified": article.updatedDate,
      "author": {
        "@type": "Organization",
        "name": livePost?.author?.name || `${siteName} Editorial Team`,
        "url": siteUrl
      },
      "publisher": {
        "@type": "Organization",
        "name": siteName,
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/logo.png`,
          "width": 512,
          "height": 512
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "articleSection": article.subjectTitle,
      "inLanguage": requestedLanguage === 'ENGLISH' ? 'en-IN' : 'hi-Latn',
      "wordCount": wordCount,
      "isAccessibleForFree": "True",
      "keywords": [
        article.title,
        article.subjectTitle,
        siteName,
        "Government Exam",
        "Sarkari Naukri",
        "Recruitment Notification"
      ].join(', ')
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": article.subjectTitle,
          "item": `${siteUrl}/category/${article.subjectSlug}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};

const currentLanguage = livePost?.language || 'HINGLISH';
const isHinglish = currentLanguage === 'HINGLISH';
const hasAlternateLanguage = livePost?.hasAlternateLanguage ?? false;

// Both language versions share the same slug — language is toggled via ?lang= param
const hinglishUrl = `/${article.slug}`;
const englishUrl = hasAlternateLanguage ? `/${article.slug}?lang=en` : null;

const siteOrigin = siteUrl;
const alternateLinks: { hreflang: string; href: string }[] = [];

// Hinglish is always available (it's the default)
alternateLinks.push({ hreflang: 'hi-Latn', href: `${siteOrigin}/${article.slug}` });
alternateLinks.push({ hreflang: 'x-default', href: `${siteOrigin}/${article.slug}` });
if (hasAlternateLanguage) {
  alternateLinks.push({ hreflang: 'en', href: `${siteOrigin}/${article.slug}?lang=en` });
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={postCover}
  publishedTime={article.publishedDate}
  modifiedTime={article.updatedDate}
  jsonLd={jsonLd}
  alternateLinks={alternateLinks}
  noindex={Boolean(livePost?.noindex)}
>
  <div id="overview-top" class="blog-reading-view min-h-screen bg-canvas text-white">
    <div class="article-shell w-full px-4 pt-5 pb-10 sm:px-6 lg:px-8">
      <header class="article-shell-head min-w-0">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-muted">
          <a href="/" class="hover:text-accent">Home</a>
          <span>/</span>
          <a href="/" class="hover:text-accent">Articles</a>
          <span>/</span>
          <a href={`/category/${article.subjectSlug}`} class="hover:text-accent">{article.subjectTitle}</a>
          <span>/</span>
          <span class="truncate font-medium text-white">{article.title}</span>
        </nav>
        <div class="mb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-muted">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded bg-accent/10 px-2.5 py-0.5 font-semibold text-accent">{article.category}</span>
            <span class="text-muted/60">•</span>
            <span>{readMinutes} min read</span>
            <span class="text-muted/60">•</span>
            <span>Updated {article.updatedDate}</span>
          </div>
          <div class="flex items-center shrink-0">
            <LanguageSwitcher currentLanguage={currentLanguage} hinglishUrl={hinglishUrl} englishUrl={englishUrl} />
          </div>
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white">{article.title}</h1>
        {article.description && (
          <p class="mt-3 max-w-4xl text-base leading-relaxed text-muted">{article.description}</p>
        )}
      </header>

      {/* Desktop Right Rail: Recent Posts */}
      <aside aria-label="Recent posts" class="article-shell-rail hidden xl:flex">
        {/* Desktop Recent Posts Section (Right Side) */}
        {recentPosts.length > 0 && (
          <div class="rounded-xl border border-border bg-surface p-4 flex flex-col shadow-xs w-full">
            <div class="flex items-center justify-between pb-2.5 border-b border-border/60 mb-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-white flex items-center gap-2">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                Recent Posts
              </h3>
            </div>
            <div class="space-y-2.5">
              {recentPosts.slice(0, 5).map((post) => {
                const targetUrl = requestedLanguage === 'ENGLISH' ? `/${post.slug}?lang=en` : `/${post.slug}`;
                return (
                  <a
                    href={targetUrl}
                    class="group flex items-start p-2 rounded-lg hover:bg-surface-raised transition border border-transparent hover:border-border/60"
                  >
                    <div class="min-w-0 flex-1">
                      <span class="inline-block text-[10px] font-semibold text-accent leading-none mb-1">
                        {post.category?.name || 'Latest Updates'}
                      </span>
                      <h4 class="text-xs font-semibold text-white group-hover:text-accent line-clamp-2 leading-snug transition-colors">
                        {post.title}
                      </h4>
                      {post.publishedAt && (
                        <p class="text-[10px] text-muted mt-1">
                          {new Date(post.publishedAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <AdSlot class="mt-3 hidden shrink-0 xl:block" />
      </aside>

      <div class="article-shell-body min-w-0">
        {htmlBody ? (
          <article id="article-body" class="space-y-6">
            {livePost.coverImage && (
              <figure class="my-2">
                <img
                  src={livePost.coverImage}
                  alt={livePost.imageAlt || article.title}
                  class="max-h-[28rem] w-full rounded-xl border border-border object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width="800"
                  height="420"
                />
                {livePost.imageCaption && (
                  <figcaption class="mt-2 text-center text-xs text-muted">{livePost.imageCaption}</figcaption>
                )}
              </figure>
            )}
            <div class="prose-markdown markdown-preview-content max-w-none" set:html={htmlBody} />
          </article>
        ) : (
          <div id="article-body">
            <BlogArticle article={article} />
          </div>
        )}

        {/* Recent Posts Section on Smaller Devices (Mobile / Tablet Bottom) */}
        {recentPosts.length > 0 && (
          <section class="mt-10 border-t border-border/80 pt-8 xl:hidden" aria-label="Recent posts">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                Recent Posts
              </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              {recentPosts.slice(0, 4).map((post) => {
                const targetUrl = requestedLanguage === 'ENGLISH' ? `/${post.slug}?lang=en` : `/${post.slug}`;
                return (
                  <a
                    href={targetUrl}
                    class="group flex flex-col justify-between rounded-xl border border-border bg-surface p-4 hover:border-accent/40 transition shadow-xs"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="rounded bg-accent/10 px-2 py-0.5 text-[10px] font-semibold text-accent">
                          {post.category?.name || 'Latest Updates'}
                        </span>
                        {post.publishedAt && (
                          <span class="text-[11px] text-muted">
                            {new Date(post.publishedAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
                          </span>
                        )}
                      </div>
                      <h3 class="font-bold text-sm text-white group-hover:text-accent transition-colors line-clamp-2 leading-snug">
                        {post.title}
                      </h3>
                      {(post.description || post.metaDescription) && (
                        <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted">
                          {post.description || post.metaDescription}
                        </p>
                      )}
                    </div>
                    <div class="mt-3 flex items-center text-xs font-semibold text-accent group-hover:underline gap-1">
                      <span>Read article</span>
                      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <TopicNavigation
          subjectSlug={article.subjectSlug}
          prevTopic={article.prevTopic}
          nextTopic={article.nextTopic}
        />
      </div>
    </div>
  </div>
</Layout>
