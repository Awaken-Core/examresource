---
import Layout from '../layouts/Layout.astro';
import BlogArticle from '../components/blog/BlogArticle.astro';
import TopicNavigation from '../components/blog/TopicNavigation.astro';
import AdSlot from '../components/blog/AdSlot.astro';
import ArticleCard from '../components/blog/ArticleCard.astro';
import type { TopicDetail } from '../data/blogData';
import { API_URL } from '../lib/api';
import { getRecentPosts, type ListingPost } from '../lib/recent-posts';
import { siteUrl, siteName, siteDomain } from '../data/site';
import { buildLangVersion, processArticleHtml, type ArticleLangBundle } from '../lib/article-lang';
import { blogLanguageToAppLang, resolveArticleLanguage } from '../lib/preferred-lang';

const { slug: slugParam } = Astro.params;
const slugKey = (slugParam || '').toLowerCase();

// URL ?lang= wins; otherwise honor preferred_lang cookie so toggle & content stay in sync
const langParam = Astro.url.searchParams.get('lang');
const requestedLanguage = resolveArticleLanguage({
  langParam,
  cookieHeader: Astro.request.headers.get('cookie'),
});

let livePost: any = null;
let alternatePost: any = null;
let redirectUrl: string | null = null;
let recentPosts: ListingPost[] = [];

// Fetch primary article and cached recent posts in parallel (memory cached for instant 0ms response)
try {
  const [primaryRes, recent] = await Promise.all([
    fetch(`${API_URL}/blogs/${slugKey}?language=${requestedLanguage}`, {
      signal: AbortSignal.timeout(6000),
    }),
    getRecentPosts(requestedLanguage, slugKey),
  ]);

  recentPosts = recent;

  if (primaryRes.ok) {
    livePost = await primaryRes.json();
    const alt = livePost?.alternateArticle;
    if (alt?.language && alt.language !== livePost?.language && alt.htmlContent != null) {
      alternatePost = alt;
    }
  } else if (primaryRes.status === 404) {
    try {
      const errData = await primaryRes.json();
      if (errData?.redirectUrl) redirectUrl = errData.redirectUrl;
    } catch {}
  }
} catch (e) {}

if (redirectUrl) {
  return Astro.redirect(redirectUrl, 301);
}

if (!livePost) {
  return Astro.rewrite('/404');
}

let tocItems: { id: string; text: string; level: number }[] = [];
let htmlBody: string | null = null;

const processed = processArticleHtml(livePost.htmlContent || '', livePost.title);
htmlBody = processed.htmlBody;
tocItems = processed.tocItems;

const subjectSlug = livePost.category?.slug || 'general';

const article: TopicDetail = {
  slug: livePost.slug,
  title: livePost.title,
  subjectSlug,
  subjectTitle: livePost.category?.name || 'General',
  description: livePost.description || livePost.metaDescription || '',
  readTime: '4 min read',
  difficulty: 'Intermediate',
  category: livePost.category?.name || 'Articles',
  publishedDate: livePost.publishedAt ? new Date(livePost.publishedAt).toISOString().split('T')[0] : '2026-10-13',
  updatedDate: livePost.updatedAt ? new Date(livePost.updatedAt).toISOString().split('T')[0] : '2026-10-13',
  introParagraphs: [
    livePost.description || 'Detailed guide and notification information.',
  ],
  sections: [],
  summaryPoints: [
    `Official publication for ${livePost.title}.`,
    'Review complete eligibility, timelines, and guidelines below.',
  ],
};

const plainText = (htmlBody || article.introParagraphs.join(' ')).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const wordCount = plainText ? plainText.split(' ').length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

// Edge CDN caching: cache article HTML for 5 minutes, serve stale up to 15 minutes
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=900');

function makePageTitle(metaTitle: string | undefined, title: string) {
  const base = metaTitle || title;
  const brandSuffix = base.toLowerCase().includes(siteName.toLowerCase()) ? '' : ` | ${siteName}`;
  return `${base}${brandSuffix}`;
}

function makePageDescription(post: any, title: string, description: string) {
  const rawDesc = post?.metaDescription || description || '';
  return rawDesc.trim().length > 0
    ? rawDesc.trim()
    : `Read complete official notification details, eligibility, exam dates, syllabus, and direct application links for ${title} on ${siteName} (${siteDomain}).`;
}

const pageTitle = makePageTitle(livePost?.metaTitle, article.title);
const pageDescription = makePageDescription(livePost, article.title, article.description);

// Canonical URL is always the slug without query params (/{slug})
let canonicalUrl = `${siteUrl}/${article.slug}`;
if (livePost?.canonicalUrl) {
  const custom = String(livePost.canonicalUrl).trim();
  if (custom && !custom.includes('.local') && !custom.includes('localhost') && /^https?:\/\//i.test(custom)) {
    canonicalUrl = custom;
  }
}

const postCover = livePost?.coverImage || livePost?.firstImage || `${siteUrl}/og-image.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebPage",
        "@id": canonicalUrl,
        "url": canonicalUrl,
        "name": pageTitle,
        "description": pageDescription
      },
      "headline": article.title,
      "name": article.title,
      "description": pageDescription,
      "image": [postCover],
      "datePublished": article.publishedDate,
      "dateModified": article.updatedDate,
      "author": {
        "@type": "Organization",
        "name": livePost?.author?.name || `${siteName} Editorial Team`,
        "url": siteUrl
      },
      "publisher": {
        "@type": "Organization",
        "name": siteName,
        "url": siteUrl,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteUrl}/logo.png`,
          "width": 512,
          "height": 512
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "articleSection": article.subjectTitle,
      "inLanguage": requestedLanguage === 'ENGLISH' ? 'en-IN' : 'hi-Latn',
      "wordCount": wordCount,
      "isAccessibleForFree": "True",
      "keywords": [
        article.title,
        article.subjectTitle,
        siteName,
        "Government Exam",
        "Sarkari Naukri",
        "Recruitment Notification"
      ].join(', ')
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": article.subjectTitle,
          "item": `${siteUrl}/category/${article.subjectSlug}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": canonicalUrl
        }
      ]
    }
  ]
};

const currentLanguage = (livePost?.language || requestedLanguage) as 'HINGLISH' | 'ENGLISH';
const alternateLanguage = (
  alternatePost?.language === 'ENGLISH' || alternatePost?.language === 'HINGLISH'
    ? alternatePost.language
    : currentLanguage === 'ENGLISH'
      ? 'HINGLISH'
      : 'ENGLISH'
) as 'HINGLISH' | 'ENGLISH';
const hasAlternateLanguage = Boolean(alternatePost);

const siteOrigin = siteUrl;
const alternateLinks: { hreflang: string; href: string }[] = [];
alternateLinks.push({ hreflang: 'hi-Latn', href: `${siteOrigin}/${article.slug}` });
alternateLinks.push({ hreflang: 'x-default', href: `${siteOrigin}/${article.slug}` });
if (hasAlternateLanguage) {
  alternateLinks.push({ hreflang: 'en', href: `${siteOrigin}/${article.slug}?lang=en` });
}

// Embed both language versions for instant client-side swap (no navigation)
const langBundle: ArticleLangBundle = {};
langBundle[currentLanguage] = buildLangVersion({
  language: currentLanguage,
  title: article.title,
  description: article.description,
  pageTitle,
  pageDescription,
  htmlBody: htmlBody || '',
  updatedDate: article.updatedDate,
  coverImage: livePost?.coverImage || null,
  imageAlt: livePost?.imageAlt || null,
  imageCaption: livePost?.imageCaption || null,
  slug: article.slug,
});

if (alternatePost) {
  const altProcessed = processArticleHtml(alternatePost.htmlContent || '', alternatePost.title);
  const altTitle = alternatePost.title;
  const altDesc = alternatePost.description || alternatePost.metaDescription || '';
  const altUpdated = alternatePost.updatedAt
    ? new Date(alternatePost.updatedAt).toISOString().split('T')[0]
    : article.updatedDate;
  langBundle[alternateLanguage] = buildLangVersion({
    language: alternateLanguage,
    title: altTitle,
    description: altDesc,
    pageTitle: makePageTitle(alternatePost.metaTitle, altTitle),
    pageDescription: makePageDescription(alternatePost, altTitle, altDesc),
    htmlBody: altProcessed.htmlBody,
    updatedDate: altUpdated,
    // Prefer alt cover; fall back to primary (images are synced across the group)
    coverImage: alternatePost.coverImage || livePost?.coverImage || null,
    imageAlt: alternatePost.imageAlt || livePost?.imageAlt || null,
    imageCaption: alternatePost.imageCaption || livePost?.imageCaption || null,
    slug: article.slug,
  });
}

const langBundleJson = JSON.stringify(langBundle).replace(/</g, '\\u003c');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={postCover}
  publishedTime={article.publishedDate}
  modifiedTime={article.updatedDate}
  jsonLd={jsonLd}
  alternateLinks={alternateLinks}
  noindex={Boolean(livePost?.noindex)}
>
  <script type="application/json" id="article-lang-data" set:html={langBundleJson} />

  <div
    id="overview-top"
    class="blog-reading-view min-h-screen bg-canvas text-white"
    data-article-lang={blogLanguageToAppLang(currentLanguage)}
  >
    <div class="article-shell w-full px-4 pt-5 pb-10 sm:px-6 lg:px-8">
      <header class="article-shell-head min-w-0">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1.5 text-xs text-muted">
          <a href="/" class="hover:text-accent">Home</a>
          <span>/</span>
          <a href="/" class="hover:text-accent">Articles</a>
          <span>/</span>
          <a href={`/category/${article.subjectSlug}`} class="hover:text-accent">{article.subjectTitle}</a>
          <span>/</span>
          <span class="truncate font-medium text-white" data-article-crumb-title>{article.title}</span>
        </nav>
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3 text-xs text-muted">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded bg-accent/10 px-2.5 py-0.5 font-semibold text-accent">{article.category}</span>
            <span class="text-muted/60">•</span>
            <span data-article-read-time>{readMinutes} min read</span>
            <span class="text-muted/60">•</span>
            <span data-article-updated>Updated {article.updatedDate}</span>
          </div>

          {/* Article Bookmark / Favourite Toggle Button */}
          <button 
            type="button" 
            data-bookmark-slug={article.slug}
            data-bookmark-title={article.title}
            data-bookmark-category={article.category}
            data-bookmark-url={canonicalUrl}
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-surface-raised/50 hover:bg-surface-raised border border-border/70 hover:border-accent/50 text-muted hover:text-white transition-all text-xs font-medium cursor-pointer shadow-2xs group"
            title="Save article to bookmarks"
            aria-label="Save article to bookmarks"
          >
            <svg class="bookmark-icon w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
            <span class="bookmark-label font-medium">Bookmark</span>
          </button>
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white" data-article-title transition:name="article-title">{article.title}</h1>
        <p
          class="mt-3 max-w-4xl text-base leading-relaxed text-muted"
          data-article-description
          hidden={!article.description}
        >{article.description}</p>
      </header>

      {/* Desktop Right Rail: Recent Posts */}
      <aside aria-label="Recent posts" class="article-shell-rail hidden xl:flex">
        {recentPosts.length > 0 && (
          <div class="rounded-xl border border-border bg-surface p-4 flex flex-col shadow-xs w-full">
            <div class="flex items-center justify-between pb-2.5 border-b border-border/60 mb-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-white flex items-center gap-2">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                Recent Posts
              </h3>
            </div>
            <div class="space-y-1">
              {recentPosts.slice(0, 5).map((post) => (
                <ArticleCard
                  variant="compact"
                  title={post.title}
                  slug={post.slug}
                  href={requestedLanguage === 'ENGLISH' ? `/${post.slug}?lang=en` : `/${post.slug}`}
                  category={post.category?.name || 'Latest Updates'}
                  publishedAt={post.publishedAt}
                  headingLevel="h4"
                />
              ))}
            </div>
          </div>
        )}

        <AdSlot class="mt-3 hidden shrink-0 xl:block" />
      </aside>

      <div class="article-shell-body min-w-0">
        {htmlBody ? (
          <article id="article-body" class="space-y-6" transition:name="article-body">
            {livePost.coverImage && (
              <figure class="my-2" data-article-cover>
                <img
                  src={livePost.coverImage}
                  alt={livePost.imageAlt || article.title}
                  class="max-h-[28rem] w-full rounded-xl border border-border object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width="800"
                  height="420"
                />
                {livePost.imageCaption && (
                  <figcaption class="mt-2 text-center text-xs text-muted">{livePost.imageCaption}</figcaption>
                )}
              </figure>
            )}
            <div class="prose-markdown markdown-preview-content max-w-none" data-article-html set:html={htmlBody} />
          </article>
        ) : (
          <div id="article-body" transition:name="article-body">
            <BlogArticle article={article} />
          </div>
        )}

        {recentPosts.length > 0 && (
          <section class="mt-10 border-t border-border/80 pt-8 xl:hidden" aria-label="Recent posts">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                Recent Posts
              </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              {recentPosts.slice(0, 4).map((post) => (
                <ArticleCard
                  variant="standard"
                  title={post.title}
                  slug={post.slug}
                  href={requestedLanguage === 'ENGLISH' ? `/${post.slug}?lang=en` : `/${post.slug}`}
                  category={post.category?.name || 'Latest Updates'}
                  publishedAt={post.publishedAt}
                  summary={post.description || post.metaDescription}
                  headingLevel="h3"
                />
              ))}
            </div>
          </section>
        )}

        <TopicNavigation
          subjectSlug={article.subjectSlug}
          prevTopic={article.prevTopic}
          nextTopic={article.nextTopic}
        />
      </div>
    </div>
  </div>
</Layout>
