---
import Layout from '../layouts/Layout.astro';
import { INITIAL_MOCK_POSTS, STATES_LIST, CATEGORIES_LIST } from '../data/portalMockData';
const auth = typeof Astro.locals.auth === 'function' ? Astro.locals.auth() : null;
const userId = auth?.userId;
if (!userId && auth?.redirectToSignIn) return auth.redirectToSignIn();

// Calculate initial metrics
const totalArticles = INITIAL_MOCK_POSTS.length;
const publishedCount = INITIAL_MOCK_POSTS.filter(p => p.status === 'Published').length;
const draftsCount = INITIAL_MOCK_POSTS.filter(p => p.status === 'Draft').length;
const totalViews = INITIAL_MOCK_POSTS.reduce((sum, p) => sum + p.views, 0);
---

<Layout
  title="Admin Dashboard - ExamPortal"
  description="Manage government exam articles, publication status, categories, and site settings."
>
  <script>
    const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:4000/api/v1';
    const clerk = (window as Window & { Clerk?: { session?: { getToken: () => Promise<string | null> } } }).Clerk;
    const token = await clerk?.session?.getToken();
    const response = await fetch(`${apiUrl}/me`, { headers: token ? { Authorization: `Bearer ${token}` } : {} });
    const user = response.ok ? await response.json() : null;
    if (user?.role !== 'admin') window.location.replace('/home');
  </script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    
    {/* Admin Header with Breadcrumbs & Actions */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/" class="hover:text-blue-700">ExamPortal</a>
          <span>/</span>
          <span class="text-slate-800 font-semibold">Admin Dashboard</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Exam Portal Administration
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Frontend prototype for managing exam publications, drafts, categories, and article states.
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <a 
          href="/editor" 
          class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs sm:text-sm rounded-lg shadow-xs transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Write New Article</span>
        </a>
        <a 
          href="/" 
          class="inline-flex items-center gap-1 px-3 py-2.5 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium text-xs sm:text-sm rounded-lg transition"
        >
          <span>View Site ↗</span>
        </a>
      </div>
    </div>

    {/* Metric Overview Cards */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
      <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Articles</span>
          <span class="p-2 bg-blue-50 text-blue-700 rounded-lg text-lg">📄</span>
        </div>
        <div id="stat-total" class="text-2xl font-bold text-slate-900 mt-2">{totalArticles}</div>
        <span class="text-[11px] text-emerald-600 font-semibold">Live catalog</span>
      </div>

      <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Published</span>
          <span class="p-2 bg-emerald-50 text-emerald-700 rounded-lg text-lg">✅</span>
        </div>
        <div id="stat-published" class="text-2xl font-bold text-slate-900 mt-2">{publishedCount}</div>
        <span class="text-[11px] text-slate-500">Live on public portal</span>
      </div>

      <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Drafts</span>
          <span class="p-2 bg-amber-50 text-amber-700 rounded-lg text-lg">📝</span>
        </div>
        <div id="stat-drafts" class="text-2xl font-bold text-slate-900 mt-2">{draftsCount}</div>
        <span class="text-[11px] text-amber-600 font-semibold">Pending editorial review</span>
      </div>

      <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-2xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Impressions</span>
          <span class="p-2 bg-purple-50 text-purple-700 rounded-lg text-lg">📈</span>
        </div>
        <div class="text-2xl font-bold text-slate-900 mt-2">{totalViews.toLocaleString()}</div>
        <span class="text-[11px] text-slate-500">Candidate article views</span>
      </div>
    </div>

    {/* Main Content Area: Article Management + Category Management Sidepanel */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-8">
      
      {/* Article Listing & Table (8 cols on lg) */}
      <div class="lg:col-span-8 space-y-4">
        <div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-2xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span>📚</span>
              <span>Article Repository</span>
            </h2>

            {/* Table Filters: Search, Status, Category */}
            <div class="flex flex-wrap items-center gap-2">
              <input 
                type="text" 
                id="admin-search-input"
                placeholder="Search articles..."
                class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-800 placeholder:text-slate-400 focus:outline-hidden focus:ring-2 focus:ring-blue-600"
              />
              <select 
                id="admin-status-filter"
                class="bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-700 focus:outline-hidden focus:ring-2 focus:ring-blue-600"
              >
                <option value="ALL">All Statuses</option>
                <option value="Published">Published</option>
                <option value="Draft">Draft</option>
              </select>
            </div>
          </div>

          {/* Action Notification Banner */}
          <div id="admin-toast" class="hidden my-3 p-3 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-between">
            <span id="admin-toast-text">Action performed successfully.</span>
            <button id="admin-toast-close" class="text-emerald-700 hover:text-emerald-900 font-bold ml-2">✕</button>
          </div>

          {/* Table Container */}
          <div class="overflow-x-auto mt-3">
            <table class="min-w-full text-xs text-left">
              <thead class="bg-slate-50 text-slate-600 uppercase font-semibold border-b border-slate-200 text-[11px]">
                <tr>
                  <th class="py-3 px-3">Title & Summary</th>
                  <th class="py-3 px-2">State</th>
                  <th class="py-3 px-2">Category</th>
                  <th class="py-3 px-2">Status</th>
                  <th class="py-3 px-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="admin-articles-tbody" class="divide-y divide-slate-100">
                {INITIAL_MOCK_POSTS.map((post) => (
                  <tr class="admin-row hover:bg-slate-50/80 transition" data-id={post.id} data-status={post.status} data-title={post.title.toLowerCase()}>
                    <td class="py-3 px-3 max-w-xs">
                      <div class="font-bold text-slate-900 leading-snug line-clamp-1">{post.title}</div>
                      <div class="text-[10px] text-slate-400 mt-0.5">Updated: {post.updatedDate} • {post.views} views</div>
                    </td>
                    <td class="py-3 px-2 whitespace-nowrap text-slate-600 font-medium">{post.state}</td>
                    <td class="py-3 px-2 whitespace-nowrap text-slate-600">{post.category}</td>
                    <td class="py-3 px-2 whitespace-nowrap">
                      <span class={`status-badge px-2 py-0.5 rounded-full text-[10px] font-bold ${
                        post.status === 'Published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
                      }`}>
                        {post.status}
                      </span>
                    </td>
                    <td class="py-3 px-3 text-right whitespace-nowrap space-x-1">
                      <button 
                        class="toggle-status-btn px-2 py-1 rounded border border-slate-200 hover:bg-slate-100 text-slate-700 transition text-[11px]"
                        data-id={post.id}
                      >
                        {post.status === 'Published' ? 'Unpublish' : 'Publish'}
                      </button>
                      <a 
                        href={`/editor?edit=${post.id}`} 
                        class="inline-block px-2 py-1 rounded bg-blue-50 text-blue-700 hover:bg-blue-100 font-semibold transition text-[11px]"
                      >
                        Edit
                      </a>
                      <button 
                        class="delete-btn px-2 py-1 rounded bg-red-50 text-red-600 hover:bg-red-100 font-semibold transition text-[11px]"
                        data-id={post.id}
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Category Management Side Widget (4 cols on lg) */}
      <div class="lg:col-span-4 space-y-4">
        <div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-2xs">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <span>🏷️</span>
              <span>Category Management</span>
            </h2>
            <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-medium">UI Prototype</span>
          </div>

          <div class="mt-3.5 space-y-2">
            {CATEGORIES_LIST.filter(c => c.id !== 'all').map((cat) => (
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-100 text-xs">
                <div class="font-medium text-slate-800">{cat.name}</div>
                <div class="flex items-center gap-2">
                  <span class="text-[10px] bg-blue-100 text-blue-800 font-semibold px-2 py-0.5 rounded-full">{cat.count} Posts</span>
                  <button class="text-slate-400 hover:text-slate-600 text-xs font-bold" title="Edit Category">✎</button>
                </div>
              </div>
            ))}
          </div>

          {/* Add Category Form Mockup */}
          <div class="mt-4 pt-3 border-t border-slate-100">
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">Add New Category</label>
            <div class="flex gap-2">
              <input 
                type="text" 
                id="new-category-input"
                placeholder="Category name..." 
                class="flex-1 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs focus:ring-2 focus:ring-blue-600 focus:outline-hidden"
              />
              <button 
                id="add-category-btn"
                class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold transition"
              >
                Add
              </button>
            </div>
          </div>
        </div>

        {/* Quick Quicklinks Help Card */}
        <div class="bg-blue-50/60 rounded-xl border border-blue-200 p-4 text-xs text-blue-900">
          <h3 class="font-bold flex items-center gap-1.5 mb-1.5">
            <span>ℹ️</span>
            <span>Editorial Workflow Rules</span>
          </h3>
          <p class="leading-relaxed text-blue-800 text-[11px]">
            Articles marked as <strong>Published</strong> immediately appear in search feeds and state filters. Draft posts remain visible in the editor preview mode only.
          </p>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  // Interactive prototype actions for Admin Dashboard
  const searchInput = document.getElementById('admin-search-input') as HTMLInputElement | null;
  const statusFilter = document.getElementById('admin-status-filter') as HTMLSelectElement | null;
  const rows = document.querySelectorAll<HTMLElement>('.admin-row');
  const toast = document.getElementById('admin-toast');
  const toastText = document.getElementById('admin-toast-text');
  const toastClose = document.getElementById('admin-toast-close');
  const statPublished = document.getElementById('stat-published');
  const statDrafts = document.getElementById('stat-drafts');
  const statTotal = document.getElementById('stat-total');

  function showToast(msg: string) {
    if (toast && toastText) {
      toastText.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3500);
    }
  }

  toastClose?.addEventListener('click', () => {
    toast?.classList.add('hidden');
  });

  function filterAdminTable() {
    const q = searchInput?.value.toLowerCase().trim() || '';
    const st = statusFilter?.value || 'ALL';

    rows.forEach((row) => {
      const title = row.dataset.title || '';
      const status = row.dataset.status || '';

      const matchesSearch = !q || title.includes(q);
      const matchesStatus = st === 'ALL' || status === st;

      row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', filterAdminTable);
  statusFilter?.addEventListener('change', filterAdminTable);

  // Toggle publish / unpublish status
  document.querySelectorAll<HTMLButtonElement>('.toggle-status-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const row = target.closest<HTMLElement>('.admin-row');
      if (!row) return;

      const currentStatus = row.dataset.status;
      const badge = row.querySelector('.status-badge');

      if (currentStatus === 'Published') {
        row.dataset.status = 'Draft';
        target.textContent = 'Publish';
        if (badge) {
          badge.textContent = 'Draft';
          badge.className = 'status-badge px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800';
        }
        showToast('Article status updated to Draft.');
      } else {
        row.dataset.status = 'Published';
        target.textContent = 'Unpublish';
        if (badge) {
          badge.textContent = 'Published';
          badge.className = 'status-badge px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800';
        }
        showToast('Article published to public portal.');
      }
      updateCounts();
    });
  });

  // Delete article handler
  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const row = target.closest<HTMLElement>('.admin-row');
      if (!row) return;

      if (confirm('Are you sure you want to delete this article?')) {
        row.remove();
        showToast('Article removed from catalog.');
        updateCounts();
      }
    });
  });

  function updateCounts() {
    const activeRows = document.querySelectorAll<HTMLElement>('.admin-row');
    let pub = 0;
    let drf = 0;
    activeRows.forEach(r => {
      if (r.dataset.status === 'Published') pub++;
      else drf++;
    });
    if (statTotal) statTotal.textContent = activeRows.length.toString();
    if (statPublished) statPublished.textContent = pub.toString();
    if (statDrafts) statDrafts.textContent = drf.toString();
  }

  // Add Category Handler Mock
  const addCatBtn = document.getElementById('add-category-btn');
  const newCatInput = document.getElementById('new-category-input') as HTMLInputElement | null;
  addCatBtn?.addEventListener('click', () => {
    if (newCatInput && newCatInput.value.trim()) {
      showToast(`Category "${newCatInput.value.trim()}" added successfully.`);
      newCatInput.value = '';
    }
  });
</script>
