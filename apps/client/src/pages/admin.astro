---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Articles" activeNav="posts">
  <!-- Top Header Action -->
  <div slot="header-actions" class="flex items-center gap-2">
    <button 
      id="top-open-cat-btn"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-md shadow-2xs transition"
    >
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Create a Blog Category</span>
    </button>
    <a 
      href="/editor" 
      class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-md shadow-2xs transition"
      style="background-color: #2563EB;"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Write an Article</span>
    </a>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <!-- Page Heading & 2 Clear Primary Actions -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-2xs">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Content Management</h1>
          <p class="text-xs text-slate-500 mt-1">
            Create blog categories (sections like Java, Civil Engineering, Government Jobs) and write articles inside them.
          </p>
        </div>

        <!-- 2 Clearly Separated Primary Actions -->
        <div class="flex flex-wrap items-center gap-3">
          <button 
            id="hero-open-cat-btn"
            class="inline-flex items-center gap-2 px-4 py-2 border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 font-semibold text-xs rounded-lg shadow-2xs transition"
          >
            <svg class="w-4 h-4 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>Create a Blog Category</span>
          </button>

          <a 
            href="/editor" 
            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-lg shadow-2xs transition"
            style="background-color: #2563EB;"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Write an Article</span>
          </a>
        </div>
      </div>

      <!-- Restrained counts -->
      <div class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-3 text-xs text-slate-600 font-medium">
        <div>
          <span class="text-slate-400">Total Articles:</span> 
          <span id="stat-total" class="font-semibold text-slate-900 ml-1">0</span>
        </div>
        <span class="text-slate-200">|</span>
        <div>
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1"></span>
          <span class="text-slate-500">Published:</span> 
          <span id="stat-published" class="font-semibold text-slate-900 ml-1">0</span>
        </div>
        <span class="text-slate-200">|</span>
        <div>
          <span class="inline-block w-2 h-2 rounded-full bg-amber-400 mr-1"></span>
          <span class="text-slate-500">Drafts:</span> 
          <span id="stat-drafts" class="font-semibold text-slate-900 ml-1">0</span>
        </div>
        <span class="text-slate-200">|</span>
        <div>
          <span class="inline-block w-2 h-2 rounded-full bg-purple-400 mr-1"></span>
          <span class="text-slate-500">Scheduled:</span> 
          <span id="stat-scheduled" class="font-semibold text-slate-900 ml-1">0</span>
        </div>
      </div>
    </div>

    <!-- Toast Notification Banner -->
    <div id="admin-toast" class="hidden p-3 rounded-lg text-xs font-medium border flex items-center justify-between transition">
      <span id="admin-toast-text"></span>
      <button id="admin-toast-close" class="font-bold ml-2">✕</button>
    </div>

    <!-- Error Banner with Retry button if API request fails -->
    <div id="admin-error-banner" class="hidden p-3.5 bg-red-50 border border-red-200 rounded-lg text-xs text-red-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-red-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span id="admin-error-message">Unable to connect to the backend API server.</span>
      </div>
      <button id="admin-retry-btn" class="px-2.5 py-1 bg-red-100 hover:bg-red-200 text-red-800 font-semibold rounded text-xs transition">
        Retry
      </button>
    </div>

    <!-- Clean Articles Section Header & Toolbar -->
    <div class="space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <h2 class="text-base font-bold text-slate-900 tracking-tight">Articles</h2>
        
        <!-- Filter Toolbar -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Search Input -->
          <div class="relative">
            <input 
              type="text" 
              id="search-input"
              placeholder="Search title, slug..."
              class="w-48 sm:w-56 bg-white border border-slate-200 rounded-md pl-7 pr-3 py-1.5 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-600"
            />
            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2 top-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <!-- Category Select Filter -->
          <select 
            id="category-filter"
            class="bg-white border border-slate-200 rounded-md px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-600"
          >
            <option value="ALL">All Categories</option>
          </select>
        </div>
      </div>

      <!-- Status Tabs -->
      <div class="bg-white border border-slate-200 rounded-lg p-1.5 flex items-center gap-1 overflow-x-auto text-xs shadow-2xs">
        <button class="status-tab px-3 py-1.5 rounded-md font-semibold text-slate-900 bg-slate-100 transition" data-status="ALL">All Articles</button>
        <button class="status-tab px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition" data-status="PUBLISHED">Published</button>
        <button class="status-tab px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition" data-status="DRAFT">Drafts</button>
        <button class="status-tab px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition" data-status="SCHEDULED">Scheduled</button>
        <button class="status-tab px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition" data-status="ARCHIVED">Archived</button>
      </div>
    </div>

    <!-- Article Table Container (Strict light mode) -->
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-2xs">
      <table class="min-w-full text-xs text-left divide-y divide-slate-100">
        <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">Article Title</th>
            <th class="py-3 px-3">Blog Category</th>
            <th class="py-3 px-3">Status</th>
            <th class="py-3 px-3">Last Updated</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="posts-table-body" class="divide-y divide-slate-100 bg-white text-slate-800">
          <!-- Light Skeleton Loading State -->
          <tr class="animate-pulse">
            <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-100 rounded w-48"></div></td>
            <td class="py-3.5 px-3"><div class="h-3 bg-slate-100 rounded w-20"></div></td>
            <td class="py-3.5 px-3"><div class="h-4 bg-slate-100 rounded-full w-16"></div></td>
            <td class="py-3.5 px-3"><div class="h-3 bg-slate-100 rounded w-20"></div></td>
            <td class="py-3.5 px-4 text-right"><div class="h-5 bg-slate-100 rounded w-20 ml-auto"></div></td>
          </tr>
        </tbody>
      </table>

      <!-- Pagination Bar -->
      <div class="px-4 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <span id="pagination-info">Showing articles</span>
        <div class="flex gap-1.5">
          <button id="prev-btn" class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 transition" disabled>Previous</button>
          <button id="next-btn" class="px-2.5 py-1 rounded border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 transition" disabled>Next</button>
        </div>
      </div>
    </div>

    <!-- Category Management Section (Clear subject sections) -->
    <div id="categories-section" class="pt-6 border-t border-slate-200 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-base font-bold text-slate-900 tracking-tight">Blog Categories</h2>
          <p class="text-xs text-slate-500">
            A Blog Category is a subject or section that contains multiple articles (e.g. Java, Civil Engineering, Government Jobs).
          </p>
        </div>
        <button 
          id="section-open-cat-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-md text-xs font-semibold shadow-2xs transition self-start sm:self-auto"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Create Category</span>
        </button>
      </div>

      <!-- Categories Table List -->
      <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-2xs">
        <table class="min-w-full text-xs text-left divide-y divide-slate-100">
          <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">Category Name</th>
              <th class="py-3 px-3">URL Slug</th>
              <th class="py-3 px-3">Description</th>
              <th class="py-3 px-3">Articles</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="categories-table-body" class="divide-y divide-slate-100 bg-white text-slate-800">
            <tr>
              <td colspan="5" class="py-6 text-center text-slate-400">Loading categories...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Dedicated Category Modal (Create & Edit) -->
  <div id="category-modal" class="fixed inset-0 bg-slate-900/40 z-50 hidden items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-xl max-w-lg w-full p-6 space-y-4 shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h3 id="category-modal-title" class="text-sm font-bold text-slate-900">Create a Blog Category</h3>
          <p class="text-xs text-slate-500 mt-0.5">Creating a category creates a section where multiple articles can be published.</p>
        </div>
        <button id="close-cat-modal-btn" class="text-slate-400 hover:text-slate-600 font-bold p-1">✕</button>
      </div>

      <div id="cat-modal-error" class="hidden p-2.5 bg-red-50 border border-red-200 rounded-md text-xs text-red-700"></div>

      <form id="cat-modal-form" class="space-y-4">
        <input type="hidden" id="cat-modal-id" value="" />

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Category Name <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="cat-modal-name" 
            placeholder="e.g. Java, Civil Engineering, Government Jobs" 
            required
            class="w-full bg-white border border-slate-300 rounded-md px-3 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-600"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            URL Slug <span class="text-red-500">*</span>
          </label>
          <div class="flex items-center bg-white border border-slate-300 rounded-md px-2.5 py-1.5 text-xs">
            <span class="text-slate-400 select-none font-mono">/blog/</span>
            <input 
              type="text" 
              id="cat-modal-slug" 
              placeholder="java" 
              required
              class="w-full bg-transparent font-mono text-slate-800 outline-none pl-1"
            />
          </div>
          <p class="text-[11px] text-slate-400 mt-1">Articles are reachable directly at: <code class="text-slate-600 font-mono">/[article-slug]</code></p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Short Description <span class="text-slate-400 font-normal">(Optional)</span>
          </label>
          <textarea 
            id="cat-modal-desc" 
            rows="2"
            placeholder="Brief overview of what readers can find in this section..."
            class="w-full bg-white border border-slate-300 rounded-md px-3 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-600 resize-none"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
          <button 
            type="button" 
            id="cancel-cat-modal-btn"
            class="px-3.5 py-2 border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-md text-xs font-semibold transition"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            id="save-cat-modal-btn"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-xs font-semibold shadow-2xs transition"
          >
            Save Category
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Dedicated Delete Confirmation Modal (Non-blocking, never suppressed by browser) -->
  <div id="delete-confirm-modal" class="fixed inset-0 bg-slate-900/40 z-50 hidden items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-xl max-w-sm w-full p-5 space-y-4 shadow-xl">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-full bg-red-100 flex items-center justify-center shrink-0 text-red-600">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h3 id="delete-modal-title" class="text-sm font-bold text-slate-900">Delete Article</h3>
          <p id="delete-modal-target-title" class="text-xs font-semibold text-slate-700 mt-1 line-clamp-2 break-words"></p>
          <p id="delete-modal-warning" class="text-xs text-slate-500 mt-1">Are you sure you want to permanently delete this? This action cannot be undone.</p>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button 
          type="button" 
          id="cancel-delete-modal-btn" 
          class="px-3.5 py-1.5 border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-md text-xs font-semibold transition"
        >
          Cancel
        </button>
        <button 
          type="button" 
          id="confirm-delete-modal-btn" 
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-md text-xs font-semibold shadow-2xs transition disabled:opacity-50"
        >
          <span id="confirm-delete-spinner" class="hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          <span id="confirm-delete-label">Delete</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Dedicated Assign Categories Modal (Multi-Category Assignment) -->
  <div id="assign-categories-modal" class="fixed inset-0 bg-slate-900/40 z-50 hidden items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-xl max-w-md w-full p-5 space-y-4 shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="min-w-0 pr-2">
          <h3 class="text-sm font-bold text-slate-900 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            <span>Assign Categories</span>
          </h3>
          <p id="assign-cat-blog-title" class="text-xs font-semibold text-slate-700 mt-1 line-clamp-1 break-words"></p>
        </div>
        <button id="close-assign-cat-modal-btn" class="text-slate-400 hover:text-slate-600 font-bold p-1">✕</button>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span>Select all categories that apply to this article:</span>
          <div class="space-x-2">
            <button type="button" id="assign-cat-select-all" class="text-blue-600 hover:underline font-medium text-[11px]">Select All</button>
            <span class="text-slate-300">|</span>
            <button type="button" id="assign-cat-clear-all" class="text-slate-500 hover:underline font-medium text-[11px]">Clear All</button>
          </div>
        </div>

        <div id="assign-cat-list" class="max-h-60 overflow-y-auto divide-y divide-slate-100 border border-slate-200 rounded-lg p-1 bg-slate-50/50">
          <!-- Populated via JavaScript -->
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button 
          type="button" 
          id="cancel-assign-cat-modal-btn" 
          class="px-3.5 py-1.5 border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-md text-xs font-semibold transition"
        >
          Cancel
        </button>
        <button 
          type="button" 
          id="save-assign-cat-modal-btn" 
          class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-xs font-semibold shadow-2xs transition disabled:opacity-50"
        >
          <span id="save-assign-cat-spinner" class="hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          <span id="save-assign-cat-label">Save Categories</span>
        </button>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  const API_URL = (import.meta.env.PUBLIC_API_URL || 'https://govtpariksha.com/api/v1').replace(/\/$/, '');

  let authTokenPromise: Promise<string | null> | undefined;

  async function getAuthToken(forceRefresh = false): Promise<string | null> {
    if (forceRefresh) authTokenPromise = undefined;
    authTokenPromise ??= (async () => {
      // The page script can run before Clerk finishes restoring its session.
      // Wait briefly so protected requests never leave without a token.
      for (let attempt = 0; attempt < 50; attempt += 1) {
        const clerk = (window as any).Clerk;
        if (clerk?.loaded && clerk.session) {
          return clerk.session.getToken({ skipCache: forceRefresh }).catch(() => null);
        }
        await new Promise((resolve) => setTimeout(resolve, 100));
      }
      return null;
    })();

    const token = await authTokenPromise;
    if (!token) authTokenPromise = undefined;
    return token;
  }

  async function apiFetch(endpoint: string, options: RequestInit = {}) {
    const send = (token: string | null) => {
      const headers = new Headers(options.headers || {});
      if (token) headers.set('Authorization', `Bearer ${token}`);
      if (options.body && typeof options.body === 'string' && !headers.has('Content-Type')) {
        headers.set('Content-Type', 'application/json');
      }
      return fetch(`${API_URL}${endpoint}`, { ...options, headers });
    };

    let response = await send(await getAuthToken());
    if (response.status === 401) {
      response = await send(await getAuthToken(true));
    }
    return response;
  }

  // State
  let posts: any[] = [];
  let categories: any[] = [];
  let currentStatus = 'ALL';
  let page = 0;
  const limit = 20;

  // DOM Elements
  const tbody = document.getElementById('posts-table-body');
  const catTbody = document.getElementById('categories-table-body');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null;
  const statTotal = document.getElementById('stat-total');
  const statPublished = document.getElementById('stat-published');
  const statDrafts = document.getElementById('stat-drafts');
  const statScheduled = document.getElementById('stat-scheduled');
  const errorBanner = document.getElementById('admin-error-banner');
  const errorMessage = document.getElementById('admin-error-message');
  const retryBtn = document.getElementById('admin-retry-btn');
  const toastEl = document.getElementById('admin-toast');
  const toastText = document.getElementById('admin-toast-text');

  // Category Modal Elements
  const catModal = document.getElementById('category-modal');
  const catModalTitle = document.getElementById('category-modal-title');
  const catModalForm = document.getElementById('cat-modal-form');
  const catModalId = document.getElementById('cat-modal-id') as HTMLInputElement;
  const catModalName = document.getElementById('cat-modal-name') as HTMLInputElement;
  const catModalSlug = document.getElementById('cat-modal-slug') as HTMLInputElement;
  const catModalDesc = document.getElementById('cat-modal-desc') as HTMLTextAreaElement;
  const catModalError = document.getElementById('cat-modal-error');
  const closeCatModalBtn = document.getElementById('close-cat-modal-btn');
  const cancelCatModalBtn = document.getElementById('cancel-cat-modal-btn');
  const saveCatModalBtn = document.getElementById('save-cat-modal-btn') as HTMLButtonElement;

  // Delete Modal Elements
  const deleteModal = document.getElementById('delete-confirm-modal');
  const deleteModalTitle = document.getElementById('delete-modal-title');
  const deleteModalTargetTitle = document.getElementById('delete-modal-target-title');
  const deleteModalWarning = document.getElementById('delete-modal-warning');
  const cancelDeleteModalBtn = document.getElementById('cancel-delete-modal-btn');
  const confirmDeleteModalBtn = document.getElementById('confirm-delete-modal-btn') as HTMLButtonElement | null;
  const confirmDeleteSpinner = document.getElementById('confirm-delete-spinner');
  const confirmDeleteLabel = document.getElementById('confirm-delete-label');

  let pendingDeleteType: 'post' | 'category' | null = null;
  let pendingDeleteId: string | null = null;
  let pendingDeleteRow: HTMLElement | null = null;

  function openDeleteModal(type: 'post' | 'category', id: string, name: string, rowEl?: HTMLElement | null) {
    if (!deleteModal) return;
    pendingDeleteType = type;
    pendingDeleteId = id;
    pendingDeleteRow = rowEl || null;

    if (deleteModalTitle) {
      deleteModalTitle.textContent = type === 'post' ? 'Delete Article' : 'Delete Category';
    }
    if (deleteModalTargetTitle) {
      deleteModalTargetTitle.textContent = name;
    }
    if (deleteModalWarning) {
      deleteModalWarning.textContent = type === 'post'
        ? 'Are you sure you want to permanently delete this article? This action cannot be undone.'
        : 'Are you sure you want to delete this category? Articles assigned to it might lose their category reference.';
    }
    if (confirmDeleteModalBtn) {
      confirmDeleteModalBtn.disabled = false;
    }
    if (confirmDeleteSpinner) {
      confirmDeleteSpinner.classList.add('hidden');
    }
    if (confirmDeleteLabel) {
      confirmDeleteLabel.textContent = 'Delete';
    }

    deleteModal.classList.remove('hidden');
    deleteModal.classList.add('flex');
  }

  function closeDeleteModal() {
    if (!deleteModal) return;
    deleteModal.classList.add('hidden');
    deleteModal.classList.remove('flex');
    pendingDeleteType = null;
    pendingDeleteId = null;
    pendingDeleteRow = null;
  }

  cancelDeleteModalBtn?.addEventListener('click', closeDeleteModal);
  deleteModal?.addEventListener('click', (e) => {
    if (e.target === deleteModal) closeDeleteModal();
  });

  confirmDeleteModalBtn?.addEventListener('click', async () => {
    if (!pendingDeleteId || !pendingDeleteType) return;
    if (confirmDeleteModalBtn) confirmDeleteModalBtn.disabled = true;
    if (confirmDeleteSpinner) confirmDeleteSpinner.classList.remove('hidden');
    if (confirmDeleteLabel) confirmDeleteLabel.textContent = 'Deleting...';

    try {
      const endpoint = pendingDeleteType === 'post' 
        ? `/blogs/${pendingDeleteId}` 
        : `/categories/${pendingDeleteId}`;
      const res = await apiFetch(endpoint, { method: 'DELETE' });

      if (res.ok) {
        showToast(pendingDeleteType === 'post' ? 'Article deleted successfully.' : 'Category deleted successfully.');
        if (pendingDeleteRow) {
          pendingDeleteRow.remove();
        }
        closeDeleteModal();
        if (pendingDeleteType === 'post') {
          await fetchPosts();
        } else {
          await loadAll();
        }
      } else {
        const err = await res.json().catch(() => ({}));
        showToast(err.message || `Failed to delete ${pendingDeleteType} (${res.status})`, true);
      }
    } catch (err: any) {
      showToast(err.message || `Error deleting ${pendingDeleteType}`, true);
    } finally {
      if (confirmDeleteModalBtn) confirmDeleteModalBtn.disabled = false;
      if (confirmDeleteSpinner) confirmDeleteSpinner.classList.add('hidden');
      if (confirmDeleteLabel) confirmDeleteLabel.textContent = 'Delete';
    }
  });

  // Assign Categories Modal Elements & Handlers
  const assignCatModal = document.getElementById('assign-categories-modal');
  const assignCatBlogTitle = document.getElementById('assign-cat-blog-title');
  const assignCatList = document.getElementById('assign-cat-list');
  const closeAssignCatModalBtn = document.getElementById('close-assign-cat-modal-btn');
  const cancelAssignCatModalBtn = document.getElementById('cancel-assign-cat-modal-btn');
  const saveAssignCatModalBtn = document.getElementById('save-assign-cat-modal-btn') as HTMLButtonElement | null;
  const saveAssignCatSpinner = document.getElementById('save-assign-cat-spinner');
  const saveAssignCatLabel = document.getElementById('save-assign-cat-label');
  const assignCatSelectAll = document.getElementById('assign-cat-select-all');
  const assignCatClearAll = document.getElementById('assign-cat-clear-all');
  let currentAssignBlogId: string | null = null;

  function openAssignCategoriesModal(blogId: string) {
    const post = posts.find((p) => p.id === blogId);
    if (!post || !assignCatModal) return;

    currentAssignBlogId = blogId;
    if (assignCatBlogTitle) {
      assignCatBlogTitle.textContent = post.title || 'Untitled Article';
    }

    const currentAttachedIds = new Set<string>();
    if (post.categoryId) currentAttachedIds.add(post.categoryId);
    if (Array.isArray(post.categories)) {
      post.categories.forEach((c: any) => {
        if (c?.id) currentAttachedIds.add(c.id);
      });
    }

    if (assignCatList) {
      if (categories.length === 0) {
        assignCatList.innerHTML = `<p class="p-4 text-xs text-slate-400 text-center">No categories exist yet. Create a category in the section below first.</p>`;
      } else {
        assignCatList.innerHTML = categories.map((cat) => {
          const isChecked = currentAttachedIds.has(cat.id);
          return `
            <label class="flex items-start gap-2.5 p-2 rounded hover:bg-white cursor-pointer transition select-none">
              <input 
                type="checkbox" 
                class="assign-cat-checkbox mt-0.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500" 
                value="${cat.id}"
                ${isChecked ? 'checked' : ''}
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-slate-800">${escapeHtml(cat.name)}</span>
                  <span class="text-[10px] font-mono text-slate-400">/blog/${cat.slug}</span>
                </div>
                ${cat.description ? `<p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">${escapeHtml(cat.description)}</p>` : ''}
              </div>
            </label>
          `;
        }).join('');
      }
    }

    assignCatModal.classList.remove('hidden');
    assignCatModal.classList.add('flex');
  }

  function closeAssignCategoriesModal() {
    if (!assignCatModal) return;
    assignCatModal.classList.add('hidden');
    assignCatModal.classList.remove('flex');
    currentAssignBlogId = null;
  }

  closeAssignCatModalBtn?.addEventListener('click', closeAssignCategoriesModal);
  cancelAssignCatModalBtn?.addEventListener('click', closeAssignCategoriesModal);
  assignCatModal?.addEventListener('click', (e) => {
    if (e.target === assignCatModal) closeAssignCategoriesModal();
  });

  assignCatSelectAll?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('.assign-cat-checkbox').forEach((cb) => {
      cb.checked = true;
    });
  });

  assignCatClearAll?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('.assign-cat-checkbox').forEach((cb) => {
      cb.checked = false;
    });
  });

  saveAssignCatModalBtn?.addEventListener('click', async () => {
    if (!currentAssignBlogId) return;
    const selectedIds: string[] = [];
    document.querySelectorAll<HTMLInputElement>('.assign-cat-checkbox:checked').forEach((cb) => {
      selectedIds.push(cb.value);
    });

    if (saveAssignCatModalBtn) saveAssignCatModalBtn.disabled = true;
    if (saveAssignCatSpinner) saveAssignCatSpinner.classList.remove('hidden');
    if (saveAssignCatLabel) saveAssignCatLabel.textContent = 'Saving...';

    try {
      const res = await apiFetch(`/blogs/${currentAssignBlogId}`, {
        method: 'PATCH',
        body: JSON.stringify({
          categoryIds: selectedIds,
          categoryId: selectedIds[0] || null,
        }),
      });

      if (res.ok) {
        showToast('Categories updated successfully.');
        closeAssignCategoriesModal();
        await fetchPosts();
      } else {
        const err = await res.json().catch(() => ({}));
        showToast(err.message || 'Failed to update categories', true);
      }
    } catch (err: any) {
      showToast(err.message || 'Network error updating categories', true);
    } finally {
      if (saveAssignCatModalBtn) saveAssignCatModalBtn.disabled = false;
      if (saveAssignCatSpinner) saveAssignCatSpinner.classList.add('hidden');
      if (saveAssignCatLabel) saveAssignCatLabel.textContent = 'Save Categories';
    }
  });

  function showToast(msg: string, isError = false) {
    if (!toastEl || !toastText) return;
    toastText.textContent = msg;
    toastEl.className = isError 
      ? 'p-3 rounded-lg text-xs font-medium border bg-red-50 text-red-800 border-red-200 flex items-center justify-between transition'
      : 'p-3 rounded-lg text-xs font-medium border bg-emerald-50 text-emerald-800 border-emerald-200 flex items-center justify-between transition';
    toastEl.classList.remove('hidden');
    setTimeout(() => { toastEl.classList.add('hidden'); }, 4000);
  }

  document.getElementById('admin-toast-close')?.addEventListener('click', () => {
    toastEl?.classList.add('hidden');
  });

  function showError(msg: string) {
    if (errorBanner && errorMessage) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function hideError() {
    errorBanner?.classList.add('hidden');
  }

  retryBtn?.addEventListener('click', () => {
    hideError();
    loadAll();
  });

  async function loadAll() {
    renderLoadingSkeleton();
    try {
      const catRes = await apiFetch('/categories');
      if (catRes.ok) {
        categories = await catRes.json();
        renderCategories();
        renderCategoryFilter();
      }

      await fetchPosts();
    } catch (e: any) {
      showError('Unable to connect to the backend server. Verify the server is running on port 5000.');
      renderEmpty('Connection to backend failed. Click Retry to reconnect.');
    }
  }

  function renderLoadingSkeleton() {
    if (!tbody) return;
    tbody.innerHTML = `
      <tr class="animate-pulse">
        <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-100 rounded w-48"></div></td>
        <td class="py-3.5 px-3"><div class="h-3 bg-slate-100 rounded w-20"></div></td>
        <td class="py-3.5 px-3"><div class="h-4 bg-slate-100 rounded-full w-16"></div></td>
        <td class="py-3.5 px-3"><div class="h-3 bg-slate-100 rounded w-20"></div></td>
        <td class="py-3.5 px-4 text-right"><div class="h-5 bg-slate-100 rounded w-20 ml-auto"></div></td>
      </tr>
      <tr class="animate-pulse">
        <td class="py-3.5 px-4"><div class="h-3.5 bg-slate-100 rounded w-64"></div></td>
        <td class="py-3.5 px-3"><div class="h-3 bg-slate-100 rounded w-24"></div></td>
        <td class="py-3.5 px-3"><div class="h-4 bg-slate-100 rounded-full w-16"></div></td>
        <td class="py-3.5 px-3"><div class="h-3 bg-slate-100 rounded w-20"></div></td>
        <td class="py-3.5 px-4 text-right"><div class="h-5 bg-slate-100 rounded w-20 ml-auto"></div></td>
      </tr>
    `;
  }

  async function fetchPosts() {
    const q = encodeURIComponent(searchInput?.value.trim() || '');
    const cat = categoryFilter?.value || 'ALL';

    const params = new URLSearchParams();
    if (q) params.set('search', q);
    if (currentStatus !== 'ALL') params.set('status', currentStatus);
    if (cat !== 'ALL') params.set('categoryId', cat);
    params.set('limit', String(limit));
    params.set('offset', String(page * limit));

    try {
      const res = await apiFetch(`/me/blogs?${params.toString()}`);
      if (res.ok) {
        posts = await res.json();
        hideError();
        renderTable();
        updateCounters();
      } else {
        const err = await res.json().catch(() => ({}));
        showError(err.message || 'Error loading articles from server.');
        renderEmpty(err.message || 'Error loading articles.');
      }
    } catch (err: any) {
      showError('Network error: Unable to reach the API server.');
      renderEmpty('Network error while fetching articles.');
    }
  }

  function updateCounters() {
    let pub = 0, drf = 0, sch = 0;
    posts.forEach((p) => {
      if (p.status === 'PUBLISHED') pub++;
      else if (p.status === 'DRAFT') drf++;
      else if (p.status === 'SCHEDULED') sch++;
    });
    if (statTotal) statTotal.textContent = String(posts.length);
    if (statPublished) statPublished.textContent = String(pub);
    if (statDrafts) statDrafts.textContent = String(drf);
    if (statScheduled) statScheduled.textContent = String(sch);
  }

  function renderTable() {
    if (!tbody) return;
    if (posts.length === 0) {
      renderEmpty('No articles found. Click "Write an Article" to create your first post.');
      return;
    }

    tbody.innerHTML = posts.map((post) => {
      const primaryCatId = post.categoryId || (post.category?.id) || '';
      const attachedCategories = (Array.isArray(post.categories) && post.categories.length > 0)
        ? post.categories
        : (post.category ? [post.category] : []);
      const extraCount = attachedCategories.length > 1 ? attachedCategories.length - 1 : 0;
      const publicUrl = `/${post.slug}`;

      const statusBadge = 
        post.status === 'PUBLISHED' ? 'text-emerald-700 bg-emerald-50 border-emerald-200' :
        post.status === 'SCHEDULED' ? 'text-purple-700 bg-purple-50 border-purple-200' :
        post.status === 'ARCHIVED' ? 'text-slate-600 bg-slate-100 border-slate-200' : 'text-amber-700 bg-amber-50 border-amber-200';

      const dateStr = post.updatedAt ? new Date(post.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';

      return `
        <tr class="hover:bg-slate-50/80 transition" data-id="${post.id}">
          <td class="py-3 px-4 max-w-sm">
            <a href="/editor?edit=${post.id}" class="font-semibold text-slate-900 hover:text-blue-600 transition block truncate">
              ${escapeHtml(post.title)}
            </a>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="text-[10px] text-slate-400 font-mono truncate">${publicUrl}</span>
              <span class="inline-flex items-center gap-1 shrink-0">
                ${(post.languages || [{ language: post.language || 'HINGLISH', id: post.id }]).map((l) => `
                  <a href="/editor?edit=${l.id}" title="Edit ${l.language === 'ENGLISH' ? 'English' : 'Hinglish'} draft" class="px-1.5 py-0.2 rounded text-[9px] font-bold transition hover:opacity-80 ${
                    l.language === 'ENGLISH' 
                      ? 'bg-blue-50 text-blue-700 border border-blue-200' 
                      : 'bg-amber-50 text-amber-700 border border-amber-200'
                  }">
                    ${l.language === 'ENGLISH' ? '🌐 EN' : '🇮🇳 HI'}
                  </a>
                `).join('')}
              </span>
            </div>
          </td>
          <td class="py-3 px-3">
            <div class="flex flex-col gap-1 min-w-[150px]">
              <select 
                class="row-category-select text-[11px] bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 hover:border-slate-300 focus:border-blue-500 rounded px-2 py-1 text-slate-700 font-medium transition outline-none cursor-pointer"
                data-id="${post.id}"
                data-prev="${primaryCatId}"
                title="Change Primary Category"
              >
                <option value="">-- No Category --</option>
                ${categories.map((c) => `
                  <option value="${c.id}" ${primaryCatId === c.id ? 'selected' : ''}>
                    ${escapeHtml(c.name)}
                  </option>
                `).join('')}
              </select>
              <div class="flex items-center gap-1.5 flex-wrap">
                ${extraCount > 0 ? `
                  <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-semibold bg-blue-50 text-blue-700 border border-blue-200" title="${escapeHtml(attachedCategories.map((c: any) => c.name).join(', '))}">
                    +${extraCount} more
                  </span>
                ` : ''}
                <button 
                  type="button" 
                  class="manage-categories-btn text-[10px] text-blue-600 hover:text-blue-800 font-medium hover:underline inline-flex items-center gap-0.5 cursor-pointer"
                  data-id="${post.id}"
                  data-title="${escapeHtml(post.title)}"
                  title="Assign to multiple categories"
                >
                  <svg class="w-3 h-3 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                  </svg>
                  Categories (${attachedCategories.length})
                </button>
              </div>
            </div>
          </td>
          <td class="py-3 px-3 whitespace-nowrap">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium border ${statusBadge}">
              ${post.status}
            </span>
          </td>
          <td class="py-3 px-3 whitespace-nowrap text-slate-400 font-mono text-[11px]">${dateStr}</td>
          <td class="py-3 px-4 text-right whitespace-nowrap space-x-1">
            <a 
              href="/editor?edit=${post.id}" 
              class="px-2.5 py-1 rounded border border-slate-200 text-slate-700 hover:bg-slate-100 font-semibold transition text-[11px]"
            >
              Edit
            </a>
            <a 
              href="${publicUrl}" 
              target="_blank"
              class="px-2.5 py-1 rounded border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition text-[11px]"
            >
              Preview ↗
            </a>
            <button 
              type="button"
              class="toggle-status-btn px-2 py-1 rounded text-slate-600 hover:bg-slate-100 transition text-[11px] cursor-pointer"
              data-id="${post.id}"
              data-status="${post.status}"
            >
              ${post.status === 'PUBLISHED' ? 'Unpublish' : 'Publish'}
            </button>
            <button 
              type="button"
              class="del-btn p-1.5 rounded-md text-slate-400 hover:text-red-600 hover:bg-red-50 transition inline-flex items-center justify-center cursor-pointer align-middle"
              data-id="${post.id}"
              data-title="${escapeHtml(post.title)}"
              title="Delete Article"
              aria-label="Delete Article"
            >
              <svg class="w-4 h-4 pointer-events-none text-red-500 hover:text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16" />
              </svg>
            </button>
          </td>
        </tr>
      `;
    }).join('');

    attachRowEvents();
  }

  function renderEmpty(message: string) {
    if (!tbody) return;
    tbody.innerHTML = `
      <tr>
        <td colspan="5" class="py-12 text-center text-slate-400 text-xs">
          ${message}
        </td>
      </tr>
    `;
  }

  function attachRowEvents() {
    document.querySelectorAll<HTMLSelectElement>('.row-category-select').forEach((sel) => {
      sel.onchange = async () => {
        const id = sel.dataset.id;
        const newCatId = sel.value;
        const prevCatId = sel.dataset.prev || '';
        if (!id) return;
        sel.disabled = true;

        try {
          const res = await apiFetch(`/blogs/${id}`, {
            method: 'PATCH',
            body: JSON.stringify({
              categoryId: newCatId || null,
              categoryIds: newCatId ? [newCatId] : [],
            }),
          });
          if (res.ok) {
            const catObj = categories.find((c) => c.id === newCatId);
            showToast(`Category updated to "${catObj ? catObj.name : 'Uncategorized'}".`);
            await fetchPosts();
          } else {
            const err = await res.json().catch(() => ({}));
            showToast(err.message || 'Failed to update category', true);
            sel.value = prevCatId;
            sel.disabled = false;
          }
        } catch {
          showToast('Failed to update category', true);
          sel.value = prevCatId;
          sel.disabled = false;
        }
      };
    });

    document.querySelectorAll<HTMLButtonElement>('.manage-categories-btn').forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.dataset.id;
        if (!id) return;
        openAssignCategoriesModal(id);
      };
    });

    document.querySelectorAll<HTMLButtonElement>('.toggle-status-btn').forEach((btn) => {
      btn.onclick = async () => {
        const id = btn.dataset.id;
        const current = btn.dataset.status;
        const nextStatus = current === 'PUBLISHED' ? 'DRAFT' : 'PUBLISHED';
        btn.disabled = true;
        try {
          const res = await apiFetch(`/blogs/${id}`, {
            method: 'PATCH',
            body: JSON.stringify({ status: nextStatus }),
          });
          if (res.ok) {
            showToast(`Article marked as ${nextStatus}.`);
            fetchPosts();
          } else {
            showToast('Failed to update status', true);
            btn.disabled = false;
          }
        } catch {
          showToast('Failed to update status', true);
          btn.disabled = false;
        }
      };
    });

    document.querySelectorAll<HTMLButtonElement>('.del-btn').forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.dataset.id;
        const title = btn.dataset.title || 'Untitled Article';
        if (!id) return;
        openDeleteModal('post', id, title, btn.closest('tr'));
      };
    });
  }

  // Delegated post table events as robust fallback
  tbody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const catBtn = target.closest<HTMLButtonElement>('.manage-categories-btn');
    if (catBtn) {
      e.preventDefault();
      e.stopPropagation();
      const id = catBtn.dataset.id;
      if (id) openAssignCategoriesModal(id);
      return;
    }
    const delBtn = target.closest<HTMLButtonElement>('.del-btn');
    if (delBtn) {
      e.preventDefault();
      e.stopPropagation();
      const id = delBtn.dataset.id;
      const title = delBtn.dataset.title || 'Untitled Article';
      if (!id) return;
      openDeleteModal('post', id, title, delBtn.closest('tr'));
    }
  });

  function renderCategoryFilter() {
    if (!categoryFilter) return;
    categoryFilter.innerHTML = '<option value="ALL">All Categories</option>' + categories.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
  }

  function renderCategories() {
    if (!catTbody) return;
    if (categories.length === 0) {
      catTbody.innerHTML = `
        <tr>
          <td colspan="5" class="py-8 text-center text-slate-400 text-xs">
            No categories yet. Click "Create a Blog Category" to add one.
          </td>
        </tr>
      `;
      return;
    }

    catTbody.innerHTML = categories.map((c) => `
      <tr class="hover:bg-slate-50 transition" data-id="${c.id}">
        <td class="py-3 px-4 font-semibold text-slate-900">${escapeHtml(c.name)}</td>
        <td class="py-3 px-3 font-mono text-[11px] text-slate-500">/blog/${escapeHtml(c.slug)}</td>
        <td class="py-3 px-3 text-slate-500 text-xs max-w-xs truncate">${escapeHtml(c.description || '—')}</td>
        <td class="py-3 px-3 font-mono text-slate-600 text-xs">${c.postCount || 0}</td>
        <td class="py-3 px-4 text-right whitespace-nowrap space-x-1">
          <button 
            type="button"
            class="edit-cat-btn px-2.5 py-1 rounded border border-slate-200 text-slate-700 hover:bg-slate-100 font-medium transition text-[11px] cursor-pointer"
            data-id="${c.id}"
            data-name="${escapeHtml(c.name)}"
            data-slug="${escapeHtml(c.slug)}"
            data-desc="${escapeHtml(c.description || '')}"
          >
            Edit
          </button>
          <a 
            href="/blog/${c.slug}" 
            target="_blank"
            class="px-2.5 py-1 rounded border border-slate-200 text-slate-600 hover:bg-slate-100 transition text-[11px]"
          >
            View ↗
          </a>
          <button 
            type="button"
            class="del-cat-btn p-1.5 rounded-md text-slate-400 hover:text-red-600 hover:bg-red-50 transition inline-flex items-center justify-center cursor-pointer align-middle"
            data-id="${c.id}"
            data-name="${escapeHtml(c.name)}"
            title="Delete Category"
            aria-label="Delete Category"
          >
            <svg class="w-4 h-4 pointer-events-none text-red-500 hover:text-red-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16" />
            </svg>
          </button>
        </td>
      </tr>
    `).join('');

    // Attach Edit & Delete events for categories
    document.querySelectorAll<HTMLButtonElement>('.edit-cat-btn').forEach((btn) => {
      btn.onclick = () => {
        openCategoryModal({
          id: btn.dataset.id,
          name: btn.dataset.name,
          slug: btn.dataset.slug,
          description: btn.dataset.desc,
        });
      };
    });

    document.querySelectorAll<HTMLButtonElement>('.del-cat-btn').forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.dataset.id;
        const name = btn.dataset.name || 'Category';
        if (!id) return;
        openDeleteModal('category', id, name, btn.closest('tr'));
      };
    });
  }

  // Delegated category table events as robust fallback
  catTbody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const delBtn = target.closest<HTMLButtonElement>('.del-cat-btn');
    if (delBtn) {
      e.preventDefault();
      e.stopPropagation();
      const id = delBtn.dataset.id;
      const name = delBtn.dataset.name || 'Category';
      if (!id) return;
      openDeleteModal('category', id, name, delBtn.closest('tr'));
    }
  });

  // Category Modal Handlers
  function openCategoryModal(cat?: { id?: string; name?: string; slug?: string; description?: string }) {
    if (!catModal) return;
    catModalError?.classList.add('hidden');
    if (cat?.id) {
      if (catModalTitle) catModalTitle.textContent = 'Edit Blog Category';
      if (catModalId) catModalId.value = cat.id;
      if (catModalName) catModalName.value = cat.name || '';
      if (catModalSlug) catModalSlug.value = cat.slug || '';
      if (catModalDesc) catModalDesc.value = cat.description || '';
      if (saveCatModalBtn) saveCatModalBtn.textContent = 'Update Category';
    } else {
      if (catModalTitle) catModalTitle.textContent = 'Create a Blog Category';
      if (catModalId) catModalId.value = '';
      if (catModalName) catModalName.value = '';
      if (catModalSlug) catModalSlug.value = '';
      if (catModalDesc) catModalDesc.value = '';
      if (saveCatModalBtn) saveCatModalBtn.textContent = 'Save Category';
    }
    catModal.classList.remove('hidden');
    catModal.classList.add('flex');
    catModalName?.focus();
  }

  function closeCategoryModal() {
    catModal?.classList.add('hidden');
    catModal?.classList.remove('flex');
    if (catModalError) catModalError.classList.add('hidden');
  }

  document.getElementById('top-open-cat-btn')?.addEventListener('click', () => openCategoryModal());
  document.getElementById('hero-open-cat-btn')?.addEventListener('click', () => openCategoryModal());
  document.getElementById('section-open-cat-btn')?.addEventListener('click', () => openCategoryModal());
  closeCatModalBtn?.addEventListener('click', closeCategoryModal);
  cancelCatModalBtn?.addEventListener('click', closeCategoryModal);

  // Auto-slugify in modal unless manually edited
  catModalName?.addEventListener('input', () => {
    if (!catModalId.value || !catModalSlug.value) {
      catModalSlug.value = slugify(catModalName.value);
    }
  });

  catModalForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = catModalId?.value;
    const name = catModalName?.value.trim();
    const slug = slugify(catModalSlug?.value.trim() || name);
    const description = catModalDesc?.value.trim() || null;

    if (!name || !slug) {
      if (catModalError) {
        catModalError.textContent = 'Please fill out category name and slug.';
        catModalError.classList.remove('hidden');
      }
      return;
    }

    if (saveCatModalBtn) {
      saveCatModalBtn.disabled = true;
      saveCatModalBtn.textContent = 'Saving...';
    }

    try {
      let res: Response;
      if (id) {
        res = await apiFetch(`/categories/${id}`, {
          method: 'PATCH',
          body: JSON.stringify({ name, slug, description }),
        });
      } else {
        res = await apiFetch('/categories', {
          method: 'POST',
          body: JSON.stringify({ name, slug, description }),
        });
      }

      if (res.ok) {
        closeCategoryModal();
        showToast(id ? `Category "${name}" updated.` : `Category "${name}" created.`);
        loadAll();
      } else {
        const err = await res.json().catch(() => ({}));
        if (catModalError) {
          catModalError.textContent = err.message || 'Error saving category. The name or slug might already exist.';
          catModalError.classList.remove('hidden');
        }
      }
    } catch (e: any) {
      if (catModalError) {
        catModalError.textContent = 'Network error saving category.';
        catModalError.classList.remove('hidden');
      }
    } finally {
      if (saveCatModalBtn) {
        saveCatModalBtn.disabled = false;
        saveCatModalBtn.textContent = id ? 'Update Category' : 'Save Category';
      }
    }
  });

  // Filter Tabs
  document.querySelectorAll<HTMLButtonElement>('.status-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.status-tab').forEach((t) => {
        t.className = 'status-tab px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition';
      });
      tab.className = 'status-tab px-3 py-1.5 rounded-md font-semibold text-slate-900 bg-slate-100 transition';
      currentStatus = tab.dataset.status || 'ALL';
      page = 0;
      fetchPosts();
    });
  });

  searchInput?.addEventListener('input', () => { page = 0; fetchPosts(); });
  categoryFilter?.addEventListener('change', () => { page = 0; fetchPosts(); });

  function slugify(text: string): string {
    return text.toLowerCase().trim().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-');
  }

  function escapeHtml(str: string): string {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  loadAll();
</script>
