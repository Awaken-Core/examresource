---
import Layout from '../layouts/Layout.astro';
import { INITIAL_MOCK_POSTS, STATES_LIST, CATEGORIES_LIST } from '../data/portalMockData';
// Auth is enforced on the client below (Clerk's SSR session isn't reliably
// resolved on the first dev-mode request due to its handshake flow).

// Calculate initial metrics
const totalArticles = INITIAL_MOCK_POSTS.length;
const publishedCount = INITIAL_MOCK_POSTS.filter(p => p.status === 'Published').length;
const draftsCount = INITIAL_MOCK_POSTS.filter(p => p.status === 'Draft').length;
const totalViews = INITIAL_MOCK_POSTS.reduce((sum, p) => sum + p.views, 0);
---

<Layout
  title="Admin Dashboard - govtpariksha.com"
  description="Manage government exam articles, publication status, categories, and site settings."
  hideHeaderFooter={true}
  disableTransitions={true}
>
  <script>
    import { waitForClerkToken, fetchCurrentUser } from '../lib/clerk-session';

    const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';
    const token = await waitForClerkToken();
    if (!token) {
      window.location.replace('/login?redirect_url=/admin');
    } else {
      const { user } = await fetchCurrentUser(apiUrl, token);
      if (!user) window.location.replace('/login?redirect_url=/admin');
      else if (!['editor', 'admin'].includes(user.role)) window.location.replace('/');
    }
  </script>
  <div class="min-h-screen bg-canvas text-white px-4 sm:px-6 lg:px-8 py-6">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col gap-4 pb-6 border-b border-border sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2 text-caption-sm text-muted">
          <a href="/" class="hover:text-accent">govtpariksha.com</a>
          <span>/</span>
          <span class="text-white font-medium">Admin</span>
        </div>
        <h1 class="text-heading-md font-bold text-white mt-2">
          Exam portal administration
        </h1>
        <p class="text-body-sm text-muted mt-1">
          Manage publications, drafts, categories, and article status.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a href="/admin/dashboard" class="btn-primary inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Open blog studio</span>
        </a>
        <a href="/" class="btn-outline inline-flex items-center">
          View site
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
      <div class="card-flat p-4 sm:p-5">
        <span class="text-caption-sm font-medium text-muted">Total articles</span>
        <div id="stat-total" class="text-heading-md font-bold text-white mt-2">{totalArticles}</div>
        <span class="text-caption-xs text-success">Live catalog</span>
      </div>

      <div class="card-flat p-4 sm:p-5">
        <span class="text-caption-sm font-medium text-muted">Published</span>
        <div id="stat-published" class="text-heading-md font-bold text-white mt-2">{publishedCount}</div>
        <span class="text-caption-xs text-muted">Live on the public site</span>
      </div>

      <div class="card-flat p-4 sm:p-5">
        <span class="text-caption-sm font-medium text-muted">Drafts</span>
        <div id="stat-drafts" class="text-heading-md font-bold text-white mt-2">{draftsCount}</div>
        <span class="text-caption-xs text-muted">Waiting for review</span>
      </div>

      <div class="card-flat p-4 sm:p-5">
        <span class="text-caption-sm font-medium text-muted">Impressions</span>
        <div class="text-heading-md font-bold text-white mt-2">{totalViews.toLocaleString()}</div>
        <span class="text-caption-xs text-muted">Article views</span>
      </div>
    </div>

    {/* Main Content Area: Article Management + Category Management Sidepanel */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-8">
      
      {/* Article Listing & Table (8 cols on lg) */}
      <div class="lg:col-span-8 space-y-4">
        <div class="card-flat p-4 sm:p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-border">
            <h2 class="text-heading-sm font-semibold text-white">Articles</h2>

            <div class="flex flex-wrap items-center gap-2">
              <input
                type="text"
                id="admin-search-input"
                placeholder="Search articles"
                class="input w-auto py-1.5 text-body-sm"
              />
              <select
                id="admin-status-filter"
                class="input w-auto py-1.5 text-body-sm"
              >
                <option value="ALL">All statuses</option>
                <option value="Published">Published</option>
                <option value="Draft">Draft</option>
              </select>
            </div>
          </div>

          <div id="admin-toast" class="hidden my-3 p-3 rounded-xl text-body-sm font-medium bg-surface text-success border border-success/40 flex items-center justify-between">
            <span id="admin-toast-text">Action performed successfully.</span>
            <button id="admin-toast-close" class="text-muted hover:text-white font-bold ml-2">✕</button>
          </div>

          <div class="overflow-x-auto mt-3">
            <table class="min-w-full text-body-xs text-left">
              <thead class="text-muted font-medium border-b border-border text-caption-sm">
                <tr>
                  <th class="py-3 px-3 font-medium">Title</th>
                  <th class="py-3 px-2 font-medium">State</th>
                  <th class="py-3 px-2 font-medium">Category</th>
                  <th class="py-3 px-2 font-medium">Status</th>
                  <th class="py-3 px-3 text-right font-medium">Actions</th>
                </tr>
              </thead>
              <tbody id="admin-articles-tbody" class="divide-y divide-border">
                {INITIAL_MOCK_POSTS.map((post) => (
                  <tr class="admin-row hover:bg-surface-raised transition" data-id={post.id} data-status={post.status} data-title={post.title.toLowerCase()}>
                    <td class="py-3 px-3 max-w-xs">
                      <div class="font-semibold text-white leading-snug line-clamp-1">{post.title}</div>
                      <div class="text-caption-xs text-muted mt-0.5">Updated {post.updatedDate} · {post.views} views</div>
                    </td>
                    <td class="py-3 px-2 whitespace-nowrap text-muted font-medium">{post.state}</td>
                    <td class="py-3 px-2 whitespace-nowrap text-muted">{post.category}</td>
                    <td class="py-3 px-2 whitespace-nowrap">
                      <span class={post.status === 'Published' ? 'status-badge badge-accent' : 'status-badge badge-outline'}>
                        {post.status}
                      </span>
                    </td>
                    <td class="py-3 px-3 text-right whitespace-nowrap space-x-1">
                      <button
                        class="toggle-status-btn btn-ghost text-button-xs h-7"
                        data-id={post.id}
                      >
                        {post.status === 'Published' ? 'Unpublish' : 'Publish'}
                      </button>
                      <a
                        href={`/editor?edit=${post.id}`}
                        class="btn-outline inline-flex items-center text-button-xs h-7"
                      >
                        Edit
                      </a>
                      <button
                        class="delete-btn btn-ghost text-button-xs h-7 text-error"
                        data-id={post.id}
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Category Management Side Widget (4 cols on lg) */}
      <div class="lg:col-span-4 space-y-4">
        <div class="card-flat p-4 sm:p-5">
          <div class="flex items-center justify-between pb-3 border-b border-border">
            <h2 class="text-heading-sm font-semibold text-white">Categories</h2>
            <span class="badge-outline">Preview</span>
          </div>

          <div class="mt-3.5 space-y-2">
            {CATEGORIES_LIST.filter(c => c.id !== 'all').map((cat) => (
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-canvas border border-border text-body-sm">
                <div class="font-medium text-white">{cat.name}</div>
                <div class="flex items-center gap-2">
                  <span class="badge-outline">{cat.count}</span>
                  <button class="btn-icon text-muted" title="Edit category">✎</button>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-4 pt-3 border-t border-border">
            <label class="block text-label font-medium text-white mb-1.5">Add a category</label>
            <div class="flex gap-2">
              <input
                type="text"
                id="new-category-input"
                placeholder="Category name"
                class="input flex-1 py-1.5 text-body-sm"
              />
              <button id="add-category-btn" class="btn-primary">
                Add
              </button>
            </div>
          </div>
        </div>

        <div class="card-flat p-4">
          <h3 class="text-heading-sm font-semibold text-white mb-1.5">Editorial workflow</h3>
          <p class="text-body-sm text-muted leading-relaxed">
            Published articles appear in search and state filters. Drafts stay in the editor until you publish them.
          </p>
        </div>
      </div>

    </div>
  </div>
  </div>
</Layout>

<script>
  // Interactive prototype actions for Admin Dashboard
  const searchInput = document.getElementById('admin-search-input') as HTMLInputElement | null;
  const statusFilter = document.getElementById('admin-status-filter') as HTMLSelectElement | null;
  const rows = document.querySelectorAll<HTMLElement>('.admin-row');
  const toast = document.getElementById('admin-toast');
  const toastText = document.getElementById('admin-toast-text');
  const toastClose = document.getElementById('admin-toast-close');
  const statPublished = document.getElementById('stat-published');
  const statDrafts = document.getElementById('stat-drafts');
  const statTotal = document.getElementById('stat-total');

  function showToast(msg: string) {
    if (toast && toastText) {
      toastText.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3500);
    }
  }

  toastClose?.addEventListener('click', () => {
    toast?.classList.add('hidden');
  });

  function filterAdminTable() {
    const q = searchInput?.value.toLowerCase().trim() || '';
    const st = statusFilter?.value || 'ALL';

    rows.forEach((row) => {
      const title = row.dataset.title || '';
      const status = row.dataset.status || '';

      const matchesSearch = !q || title.includes(q);
      const matchesStatus = st === 'ALL' || status === st;

      row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', filterAdminTable);
  statusFilter?.addEventListener('change', filterAdminTable);

  // Toggle publish / unpublish status
  document.querySelectorAll<HTMLButtonElement>('.toggle-status-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const row = target.closest<HTMLElement>('.admin-row');
      if (!row) return;

      const currentStatus = row.dataset.status;
      const badge = row.querySelector('.status-badge');

      if (currentStatus === 'Published') {
        row.dataset.status = 'Draft';
        target.textContent = 'Publish';
        if (badge) {
          badge.textContent = 'Draft';
          badge.className = 'status-badge badge-outline';
        }
        showToast('Article status updated to Draft.');
      } else {
        row.dataset.status = 'Published';
        target.textContent = 'Unpublish';
        if (badge) {
          badge.textContent = 'Published';
          badge.className = 'status-badge badge-accent';
        }
        showToast('Article published to public portal.');
      }
      updateCounts();
    });
  });

  // Delete article handler
  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const row = target.closest<HTMLElement>('.admin-row');
      if (!row) return;

      if (confirm('Are you sure you want to delete this article?')) {
        row.remove();
        showToast('Article removed from catalog.');
        updateCounts();
      }
    });
  });

  function updateCounts() {
    const activeRows = document.querySelectorAll<HTMLElement>('.admin-row');
    let pub = 0;
    let drf = 0;
    activeRows.forEach(r => {
      if (r.dataset.status === 'Published') pub++;
      else drf++;
    });
    if (statTotal) statTotal.textContent = activeRows.length.toString();
    if (statPublished) statPublished.textContent = pub.toString();
    if (statDrafts) statDrafts.textContent = drf.toString();
  }

  // Add Category Handler Mock
  const addCatBtn = document.getElementById('add-category-btn');
  const newCatInput = document.getElementById('new-category-input') as HTMLInputElement | null;
  addCatBtn?.addEventListener('click', () => {
    if (newCatInput && newCatInput.value.trim()) {
      showToast(`Category "${newCatInput.value.trim()}" added successfully.`);
      newCatInput.value = '';
    }
  });
</script>
