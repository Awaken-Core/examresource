---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Notifications" activeNav="notifications">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-5">
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-2xs">
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">Notifications</h1>
      <p class="text-xs text-slate-500 mt-1">
        Send a message to every signed-in user. Publishing an article also sends a notification automatically, and new accounts receive a welcome message.
      </p>
    </div>

    <div id="notice-error" class="hidden p-3 rounded-lg border border-red-200 bg-red-50 text-xs text-red-800"></div>
    <div id="notice-success" class="hidden p-3 rounded-lg border border-emerald-200 bg-emerald-50 text-xs text-emerald-800"></div>

    <form id="notice-form" class="bg-white border border-slate-200 rounded-xl p-5 shadow-2xs space-y-4">
      <div>
        <label for="notice-title" class="block text-xs font-semibold text-slate-700 mb-1.5">Title</label>
        <input
          id="notice-title"
          name="title"
          type="text"
          maxlength="120"
          required
          placeholder="Exam update"
          class="w-full bg-white border border-slate-200 rounded-md px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-600"
        />
      </div>
      <div>
        <label for="notice-body" class="block text-xs font-semibold text-slate-700 mb-1.5">Message</label>
        <textarea
          id="notice-body"
          name="body"
          maxlength="500"
          required
          rows="4"
          placeholder="Admit cards for SSC GD are now available."
          class="w-full bg-white border border-slate-200 rounded-md px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-600"
        ></textarea>
      </div>
      <div>
        <label for="notice-href" class="block text-xs font-semibold text-slate-700 mb-1.5">Link <span class="font-normal text-slate-400">(optional)</span></label>
        <input
          id="notice-href"
          name="href"
          type="text"
          placeholder="/blog/government-jobs/ssc-gd-2026 or https://..."
          class="w-full bg-white border border-slate-200 rounded-md px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-600"
        />
      </div>
      <div class="flex items-center justify-end">
        <button
          type="submit"
          id="notice-submit"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-lg shadow-2xs transition disabled:opacity-60"
          style="background-color: #2563EB;"
        >
          Push notification
        </button>
      </div>
    </form>

    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-2xs">
      <div class="px-4 py-3 border-b border-slate-100">
        <h2 class="text-sm font-bold text-slate-900">Recent notifications</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-xs text-left divide-y divide-slate-100">
          <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">Message</th>
              <th class="py-3 px-3">Type</th>
              <th class="py-3 px-3">Sent</th>
              <th class="py-3 px-4">From</th>
            </tr>
          </thead>
          <tbody id="notice-table" class="divide-y divide-slate-100 text-slate-800">
            <tr><td colspan="4" class="py-8 text-center text-slate-400">Loading notifications...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const apiUrl = (import.meta.env.PUBLIC_API_URL || 'https://govtpariksha.com/api/v1').replace(/\/$/, '');
  const form = document.getElementById('notice-form') as HTMLFormElement | null;
  const table = document.getElementById('notice-table');
  const errorBanner = document.getElementById('notice-error');
  const successBanner = document.getElementById('notice-success');
  const submitButton = document.getElementById('notice-submit') as HTMLButtonElement | null;

  type Notice = {
    id: string;
    kind: 'welcome' | 'blog' | 'broadcast';
    title: string;
    body: string;
    href: string | null;
    createdAt: string;
    authorName: string | null;
  };

  function showMessage(element: HTMLElement | null, message: string) {
    if (!element) return;
    element.textContent = message;
    element.classList.remove('hidden');
  }

  function hideMessage(element: HTMLElement | null) {
    element?.classList.add('hidden');
  }

  async function getToken() {
    for (let attempt = 0; attempt < 50; attempt += 1) {
      const clerk = (window as any).Clerk;
      if (clerk?.loaded && clerk.session) return clerk.session.getToken().catch(() => null);
      await new Promise((resolve) => setTimeout(resolve, 100));
    }
    return null;
  }

  async function apiFetch(path: string, options: RequestInit = {}) {
    const token = await getToken();
    const headers = new Headers(options.headers);
    if (token) headers.set('Authorization', `Bearer ${token}`);
    if (options.body && !headers.has('Content-Type')) headers.set('Content-Type', 'application/json');
    return fetch(`${apiUrl}${path}`, { ...options, headers });
  }

  function escapeHtml(value: string) {
    const node = document.createElement('div');
    node.textContent = value;
    return node.innerHTML;
  }

  function kindLabel(kind: Notice['kind']) {
    if (kind === 'blog') return 'Article';
    if (kind === 'welcome') return 'Welcome';
    return 'Broadcast';
  }

  function renderNotices(notices: Notice[]) {
    if (!table) return;
    if (!notices.length) {
      table.innerHTML = '<tr><td colspan="4" class="py-8 text-center text-slate-400">No notifications sent yet.</td></tr>';
      return;
    }
    table.innerHTML = notices.map((notice) => {
      const when = new Date(notice.createdAt).toLocaleString();
      const link = notice.href
        ? `<a href="${escapeHtml(notice.href)}" class="block text-blue-600 hover:underline mt-1 truncate max-w-xs">${escapeHtml(notice.href)}</a>`
        : '';
      return `<tr>
        <td class="py-3 px-4">
          <div class="font-semibold text-slate-900">${escapeHtml(notice.title)}</div>
          <div class="text-slate-500 mt-0.5 max-w-md">${escapeHtml(notice.body)}</div>
          ${link}
        </td>
        <td class="py-3 px-3">${kindLabel(notice.kind)}</td>
        <td class="py-3 px-3 whitespace-nowrap">${escapeHtml(when)}</td>
        <td class="py-3 px-4">${escapeHtml(notice.authorName || 'System')}</td>
      </tr>`;
    }).join('');
  }

  async function loadNotices() {
    const response = await apiFetch('/notifications');
    if (!response.ok) {
      showMessage(errorBanner, 'Unable to load notifications.');
      return;
    }
    renderNotices(await response.json());
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    hideMessage(errorBanner);
    hideMessage(successBanner);
    if (!form) return;
    const data = new FormData(form);
    const payload = {
      title: String(data.get('title') || ''),
      body: String(data.get('body') || ''),
      href: String(data.get('href') || ''),
    };
    if (submitButton) submitButton.disabled = true;
    try {
      const response = await apiFetch('/notifications', {
        method: 'POST',
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        showMessage(errorBanner, result.message || 'Unable to send the notification.');
        return;
      }
      form.reset();
      showMessage(successBanner, 'Notification sent to users.');
      await loadNotices();
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });

  loadNotices();
</script>
