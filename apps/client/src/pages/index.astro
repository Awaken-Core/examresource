---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import { examPortals, govPortals, siteFaqs, telegramChannel, whatsappChannel } from '../data/site';

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';

let livePosts: any[] = [];
try {
  const res = await fetch(`${API_URL}/blogs?limit=50`);
  if (res.ok) livePosts = await res.json();
} catch {
  livePosts = [];
}

let categories: any[] = [];
try {
  const catRes = await fetch(`${API_URL}/categories`);
  if (catRes.ok) categories = await catRes.json();
} catch {
  categories = [];
}

const slides = livePosts.filter((post) => post.coverImage).slice(0, 6);
const pageTitle = 'Govt exam notices, admit cards and results | govtpariksha.com';
const pageDescription = 'Read verified exam guides and open the official government and exam portals for applications, admit cards, and results.';
const canonicalUrl = 'https://govtpariksha.com/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'govtpariksha.com',
      url: canonicalUrl,
      description: pageDescription,
    },
    {
      '@type': 'FAQPage',
      mainEntity: siteFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <div class="min-h-screen bg-canvas px-4 sm:px-6 pt-5 pb-10 text-white">
    <div class="w-full max-w-5xl mx-auto space-y-8">
      <header class="border-b border-border/80 pb-5">
        <h1 class="text-xl sm:text-2xl lg:text-4xl font-extrabold tracking-tight text-white">Exam notices and official portals</h1>
      </header>


      <section aria-label="Alert channels" class="hidden lg:grid gap-3 sm:grid-cols-2">
        <a href={whatsappChannel} class="flex items-center justify-between rounded-xl border border-border bg-surface px-4 py-3 hover:border-[#25D366]/40 transition group" rel="noopener noreferrer" target="_blank">
          <span class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-[#25D366]/10 border border-[#25D366]/20 flex items-center justify-center shrink-0 group-hover:bg-[#25D366]/20 transition">
              <svg class="w-5 h-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </span>
            <span>
              <span class="block text-sm font-bold text-white">WhatsApp channel</span>
              <span class="mt-1 block text-xs text-muted">New notice alerts on WhatsApp</span>
            </span>
          </span>
          <span class="text-sm font-semibold text-[#25D366]">Join</span>
        </a>
        <a href={telegramChannel} class="flex items-center justify-between rounded-xl border border-border bg-surface px-4 py-3 hover:border-[#2AABEE]/40 transition group" rel="noopener noreferrer" target="_blank">
          <span class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-[#2AABEE]/10 border border-[#2AABEE]/20 flex items-center justify-center shrink-0 group-hover:bg-[#2AABEE]/20 transition">
              <svg class="w-5 h-5 text-[#2AABEE]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
            </span>
            <span>
              <span class="block text-sm font-bold text-white">Telegram channel</span>
              <span class="mt-1 block text-xs text-muted">New notice alerts on Telegram</span>
            </span>
          </span>
          <span class="text-sm font-semibold text-[#2AABEE]">Join</span>
        </a>
      </section>

      <div class="flex items-center flex-wrap gap-1.5 border-b border-border/60 pb-3">
        <a href="/" class="whitespace-nowrap rounded-lg bg-accent px-3.5 py-1.5 text-xs font-semibold text-white">All topics</a>
        {categories.map((category) => (
          <a href={`/blog/${category.slug}`} class="whitespace-nowrap rounded-lg px-3.5 py-1.5 text-xs font-medium text-muted hover:bg-surface-raised hover:text-white transition">
            {category.name}
          </a>
        ))}
      </div>

      {slides.length > 0 && (
        <section id="blog-slides" aria-label="Featured articles" class="relative overflow-hidden rounded-xl border border-border bg-surface">
          {slides.map((post, index) => {
            const href = `/blog/${post.category?.slug || 'general'}/${post.slug}`;
            return (
              <a href={href} class:list={['blog-slide grid md:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)]', index > 0 && 'hidden']} data-slide={index}>
                <img src={post.coverImage} alt={post.imageAlt || post.title} class="h-full max-h-[340px] w-full object-cover" loading="lazy" decoding="async" />
                <span class="flex flex-col justify-center p-5 sm:p-7">
                  <time class="text-[11px] font-semibold uppercase tracking-wider text-muted" datetime={post.publishedAt || post.updatedAt}>
                    {new Date(post.publishedAt || post.updatedAt).toLocaleDateString()}
                  </time>
                  <span class="mt-2 text-2xl font-extrabold tracking-tight text-white">{post.title}</span>
                  <span class="mt-3 line-clamp-4 text-sm leading-relaxed text-muted">{post.description || post.metaDescription || 'Open the full article.'}</span>
                  <span class="mt-5 text-sm font-semibold text-accent">Read article</span>
                </span>
              </a>
            );
          })}
          {slides.length > 1 && (
            <div class="absolute bottom-3 right-3 flex gap-2">
              <button type="button" data-slide-prev class="rounded-full border border-border bg-canvas/90 px-3 py-1 text-xs font-semibold text-white" aria-label="Previous slide">Prev</button>
              <button type="button" data-slide-next class="rounded-full border border-border bg-canvas/90 px-3 py-1 text-xs font-semibold text-white" aria-label="Next slide">Next</button>
            </div>
          )}
        </section>
      )}

      <section class="space-y-4" aria-labelledby="latest-articles-heading">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-accent">Stay informed</p>
            <h2 id="latest-articles-heading" class="mt-1 text-xl font-bold text-white">Latest articles</h2>
          </div>
        </div>
        {livePosts.length > 0 ? (
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {livePosts.map((post) => {
              const articleHref = `/blog/${post.category?.slug || 'general'}/${post.slug}`;
              return (
                <a href={articleHref} class="flex h-full flex-col justify-between rounded-xl border border-border bg-surface p-5 transition hover:border-accent/40">
                  <span>
                    <span class="mb-2.5 flex items-center justify-between text-[11px] text-muted">
                      <span class="rounded bg-accent/10 px-2 py-0.5 font-semibold text-accent">{post.category?.name || 'General'}</span>
                      <time datetime={post.publishedAt || post.updatedAt}>{new Date(post.publishedAt || post.updatedAt).toLocaleDateString()}</time>
                    </span>
                    <span class="line-clamp-2 block text-base font-bold leading-snug text-white">{post.title}</span>
                    <span class="mt-2 line-clamp-3 block text-xs leading-relaxed text-muted">{post.description || post.metaDescription || 'Open the full article.'}</span>
                  </span>
                  <span class="mt-4 flex items-center justify-between border-t border-border/60 pt-3 text-xs text-muted">
                    <span>By {post.author?.name || 'Editorial Team'}</span>
                    <span class="font-semibold text-accent">Read article</span>
                  </span>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="rounded-card border border-dashed border-border bg-surface px-5 py-10 text-center sm:px-8 sm:py-12">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10 text-accent">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 3h9l3 3v15H6V3Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 11h6M9 15h6M15 3v4h4" /></svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-white">New exam guides are on the way</h3>
            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-muted">In the meantime, use the verified portal directory below or join an alert channel so you do not miss the next update.</p>
            <a href="#important-links" class="mt-5 inline-flex min-h-10 items-center justify-center rounded-pill border border-border bg-canvas px-4 py-2 text-sm font-semibold text-white transition hover:border-accent/40 hover:text-accent">View official portals</a>
          </div>
        )}
      </section>

      <section id="important-links" class="scroll-mt-28 space-y-5">
        <div class="border-b border-border/80 pb-5">
          <p class="text-xs font-bold uppercase tracking-wider text-accent">Verified destinations</p>
          <h2 class="mt-1 text-xl font-bold text-white">Official portal directory</h2>
          <p class="mt-1 text-sm text-muted">Use these direct links for applications, results, documents, and government services.</p>
        </div>
        <div class="grid gap-6 lg:grid-cols-2">
          <div>
            <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Government portals</h3>
            <ul class="divide-y divide-border/70 overflow-hidden rounded-xl border border-border bg-surface">
              {govPortals.map((portal) => (
                <li>
                  <a href={portal.href} class="group flex min-h-16 items-center justify-between gap-3 px-4 py-3 transition hover:bg-surface-raised" rel="noopener noreferrer" target="_blank">
                    <span>
                      <span class="block text-sm font-semibold text-white">{portal.name}</span>
                      <span class="block text-xs text-muted">{portal.note}</span>
                    </span>
                    <span class="shrink-0 rounded-pill bg-accent/10 px-3 py-1.5 text-xs font-semibold text-accent transition group-hover:bg-accent group-hover:text-on-accent">Open ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Exam portals</h3>
            <ul class="divide-y divide-border/70 overflow-hidden rounded-xl border border-border bg-surface">
              {examPortals.map((portal) => (
                <li>
                  <a href={portal.href} class="group flex min-h-16 items-center justify-between gap-3 px-4 py-3 transition hover:bg-surface-raised" rel="noopener noreferrer" target="_blank">
                    <span>
                      <span class="block text-sm font-semibold text-white">{portal.name}</span>
                      <span class="block text-xs text-muted">{portal.note}</span>
                    </span>
                    <span class="shrink-0 rounded-pill bg-accent/10 px-3 py-1.5 text-xs font-semibold text-accent transition group-hover:bg-accent group-hover:text-on-accent">Open ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <FAQSection faqs={siteFaqs} />


    </div>
  </div>
  <script>
    function bindBlogSlides() {
      const root = document.getElementById('blog-slides');
      if (!root || root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
      if (slides.length < 2) return;
      let current = 0;
      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => slide.classList.toggle('hidden', slideIndex !== current));
      };
      root.querySelector('[data-slide-prev]')?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        show(current - 1);
      });
      root.querySelector('[data-slide-next]')?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        show(current + 1);
      });
    }
    bindBlogSlides();
    document.addEventListener('astro:page-load', bindBlogSlides);
  </script>
</Layout>
