];

// Popular this week items derived from live posts
const popularUpdates = displayArticles.slice(0, 5).map((item, idx) => ({
  rank: idx + 1,
  title: item.title,
  href: item.slug,
  slugKey: item.slugKey,
}));

const pageTitle = `${siteName} | Sarkari Jobs, Exam Notifications & Results`;
const pageDescription = `${siteName} (${siteDomain}) provides latest government exam notifications, Sarkari job alerts, admit cards, answer keys, and results.`;
const canonicalUrl = `${siteUrl}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: siteName,
      alternateName: [siteName, siteDomain, `${siteName} Exam Updates`],
      url: canonicalUrl,
      description: pageDescription,
      inLanguage: ['en-IN', 'hi-Latn'],
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteUrl}/?search={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: siteName,
      alternateName: [siteName, siteDomain],
      url: canonicalUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/logo.png`,
        width: 512,
        height: 512,
        caption: `${siteName} Logo`,
      },
      image: `${siteUrl}/og-image.jpg`,
      sameAs: [whatsappChannel, telegramChannel].filter(Boolean),
      description: 'Verified government exam notifications, Sarkari job updates, admit cards, answer keys, and counselling results portal across India.',
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: siteFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

