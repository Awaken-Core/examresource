  @media (prefers-reduced-motion: reduce) {
    .service-demo-header em,
    .service-countdown b,
    .service-question-count b,
    .service-question-slide,
    .service-news-list div,
    .service-test-question .active,
    .service-test-question .active i,
    .service-progress span,
    .service-quiz-question .correct,
    .service-quiz-question i {
      animation: none;
