---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import ArticleCard from '../components/blog/ArticleCard.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { Image } from 'astro:assets';
import { examPortals, govPortals, siteFaqs, telegramChannel, whatsappChannel, siteUrl, siteName, siteDomain } from '../data/site';
import {
  appLangToBlogLanguage,
  articleHref,
  preferredLangFromCookieHeader,
} from '../lib/preferred-lang';

const API_URL = import.meta.env.PUBLIC_API_URL.replace(/\/$/, '');
const preferredAppLang = preferredLangFromCookieHeader(Astro.request.headers.get('cookie'));
const listLanguage = appLangToBlogLanguage(preferredAppLang);

// Edge CDN caching: cache for 60s, serve stale up to 300s while revalidating in background
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('Vary', 'Cookie, Accept-Encoding');

let livePosts: any[] = [];
let fetchError: { type: 'network' | 'http' | 'json' | 'empty'; message?: string; status?: number; durationMs: number } | null = null;

const fetchStart = performance.now();
try {
  const res = await fetch(`${API_URL}/blogs?limit=50&language=${listLanguage}&includeImages=false`, {
    signal: AbortSignal.timeout(6000),
  });
  const durationMs = Math.round(performance.now() - fetchStart);

  if (!res.ok) {
    fetchError = { type: 'http', status: res.status, durationMs };
    console.error(`[Index SSR] /blogs?limit=50&language=${listLanguage} failed with HTTP ${res.status} in ${durationMs}ms`);
  } else {
    try {
      const data = await res.json();
      if (Array.isArray(data)) {
        livePosts = data;
        if (data.length === 0) {
          fetchError = { type: 'empty', status: res.status, durationMs };
        }
        console.info(`[Index SSR] /blogs?limit=50&language=${listLanguage} fetched ${data.length} articles in ${durationMs}ms`);
      } else {
        fetchError = { type: 'json', message: 'Payload is not an array', status: res.status, durationMs };
        console.error(`[Index SSR] /blogs?limit=50 invalid JSON structure in ${durationMs}ms`);
      }
    } catch (parseErr: any) {
      fetchError = { type: 'json', message: parseErr?.message, status: res.status, durationMs };
      console.error(`[Index SSR] /blogs?limit=50 JSON parse error: ${parseErr?.message}`);
    }
  }
} catch (netErr: any) {
  const durationMs = Math.round(performance.now() - fetchStart);
  fetchError = { type: 'network', message: netErr?.message, durationMs };
  console.error(`[Index SSR] /blogs?limit=50 network fetch failed in ${durationMs}ms: ${netErr?.message}`);
}

const displayArticles = (livePosts || []).map(p => ({
  title: p.title,
  slugKey: p.slug,
  slug: articleHref(p.slug, preferredAppLang),
  category: p.category?.name || p.categories?.[0]?.name || 'Latest Updates',
  categories: p.categories || (p.category ? [p.category] : []),
  summary: p.description || p.metaDescription || 'Check complete official notification details and direct application links.',
  date: new Date(p.publishedAt || p.updatedAt || Date.now()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
}));

// CBT Simulation & Mock Test Landing Data (Stitch Blueprint)
const trendingTests = [
  { name: 'SSC CGL Tier 1', href: '/category/ssc-railways' },
  { name: 'RRB NTPC CBT 1', href: '/category/ssc-railways' },
  { name: 'IBPS PO Prelims', href: '/category/banking' },
  { name: 'SBI Clerk 2025', href: '/category/banking' },
  { name: 'CTET Paper 1', href: '/category/teaching' },
  { name: 'UGC NET', href: '/category/central-government' },
];

const statsData = [
  { value: '9.1+ Cr', label: 'Registered Aspirants' },
  { value: '242+ Cr', label: 'Tests Attempted' },
  { value: '4.2+ Lakh', label: 'Verified Selections' },
];

const curatedInsights = [
  {
    tag: 'Exam Strategy',
    tagClass: 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200/60 dark:border-blue-800/50',
    title: 'SSC CGL 2026 Tier 1 Syllabus Changes & High-Scoring Topics',
    summary: 'Comprehensive breakdown of recent negative marking distribution and official exam blueprints.',
    author: 'By AIR 2 Topper Team',
    href: '/category/ssc-railways',
  },
  {
    tag: 'CBT Tips',
    tagClass: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200/60 dark:border-emerald-800/50',
    title: 'RRB NTPC CBT-2: Negative Marking Avoidance & Speed Benchmarks',
    summary: 'Proven time allocation frameworks and question skipping for top-ranking candidates.',
    author: 'By GovtPariksha Editorial',
    href: '/category/ssc-railways',
  },
  {
    tag: 'Subject Notes',
    tagClass: 'bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border-purple-200/60 dark:border-purple-800/50',
    title: 'Banking Quant: Fast Calculation Shortcuts for Quadratic Equations',
    summary: 'Step-by-step methods to deduce sign relations and factorize in <15 seconds per question.',
    author: 'By Quant Faculty',
    href: '/category/banking',
  },
];

const insightArticles = displayArticles.length >= 3
  ? displayArticles.slice(0, 3).map((art, idx) => ({
      tag: art.category || curatedInsights[idx % curatedInsights.length].tag,
      tagClass: idx === 0
        ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200/60 dark:border-blue-800/50'
        : idx === 1
        ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200/60 dark:border-emerald-800/50'
        : 'bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border-purple-200/60 dark:border-purple-800/50',
      title: art.title,
      summary: art.summary,
      author: curatedInsights[idx % curatedInsights.length].author,
      href: art.slug,
    }))
