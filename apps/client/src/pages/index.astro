---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import ArticleCard from '../components/blog/ArticleCard.astro';
import BrandLogo from '../components/BrandLogo.astro';
import ProfileDropdown from '../components/ProfileDropdown.astro';
import NotificationPopup from '../components/NotificationPopup.astro';
import FavoritesDropdown from '../components/FavoritesDropdown.astro';
import { Image } from 'astro:assets';
import { siteFaqs, telegramChannel, whatsappChannel, siteUrl, siteName, siteDomain } from '../data/site';
import {
  appLangToBlogLanguage,
  articleHref,
  preferredLangFromCookieHeader,
} from '../lib/preferred-lang';

const [brandPrefix, ...brandRest] = siteDomain.split('.');
const brandSuffix = brandRest.length > 0 ? `.${brandRest.join('.')}` : '';

const API_URL = import.meta.env.PUBLIC_API_URL.replace(/\/$/, '');
const preferredAppLang = preferredLangFromCookieHeader(Astro.request.headers.get('cookie'));
const listLanguage = appLangToBlogLanguage(preferredAppLang);

// Edge CDN caching: cache for 60s, serve stale up to 300s while revalidating in background
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('Vary', 'Cookie, Accept-Encoding');

let livePosts: any[] = [];
let fetchError: { type: 'network' | 'http' | 'json' | 'empty'; message?: string; status?: number; durationMs: number } | null = null;

const fetchStart = performance.now();
try {
  const res = await fetch(`${API_URL}/blogs?limit=60&language=${listLanguage}&includeImages=false`, {
    signal: AbortSignal.timeout(6000),
  });
  const durationMs = Math.round(performance.now() - fetchStart);

  if (!res.ok) {
    fetchError = { type: 'http', status: res.status, durationMs };
  } else {
    try {
      const data = await res.json();
      if (Array.isArray(data)) {
        livePosts = data;
        if (data.length === 0) {
          fetchError = { type: 'empty', status: res.status, durationMs };
        }
      } else {
        fetchError = { type: 'json', message: 'Payload is not an array', status: res.status, durationMs };
      }
    } catch (parseErr: any) {
      fetchError = { type: 'json', message: parseErr?.message, status: res.status, durationMs };
    }
  }
} catch (netErr: any) {
  const durationMs = Math.round(performance.now() - fetchStart);
  fetchError = { type: 'network', message: netErr?.message, durationMs };
}

// Map only REAL live database articles
const THREE_DAYS_MS = 3 * 24 * 60 * 60 * 1000;
const nowTime = Date.now();
const displayArticles = (livePosts || []).map((p) => {
  const title = p.title || 'Untitled Notification';
  const categoryName = p.category?.name || p.categories?.[0]?.name || 'Central Government';
  const categorySlug = p.category?.slug || p.categories?.[0]?.slug || 'central-government';
  const pubTime = new Date(p.publishedAt || p.updatedAt || Date.now()).getTime();
  
  // NEW tag ONLY on blogs published within the last 3 days
  const isNew = (nowTime - pubTime) >= 0 && (nowTime - pubTime) <= THREE_DAYS_MS;

  return {
    title,
    slugKey: p.slug,
    slug: articleHref(p.slug, preferredAppLang),
    category: categoryName,
    categorySlug,
    categories: p.categories || (p.category ? [p.category] : []),
    summary: p.description || p.metaDescription || '',
    date: new Date(pubTime).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
    isNew,
  };
});

// 9 Curated Authentic Government Exam Streams (3x3 Grid)
const streamCategories = [
  {
    id: 'central-govt',
    name: 'Central Govt & UPSC',
    shortName: 'Central & UPSC',
    slug: 'central-government',
    coverage: 'UPSC Civil Services, EPFO, Central Ministries & National Agencies',
    keywords: ['central', 'upsc', 'ias', 'ips', 'ministry', 'epfo', 'ncs'],
    iconType: 'monument',
  },
  {
    id: 'ssc',
    name: 'SSC Exams',
    shortName: 'SSC Exams',
    slug: 'ssc',
    coverage: 'Staff Selection Commission (CGL, CHSL, MTS, GD, CPO, Steno)',
    keywords: ['ssc', 'cgl', 'chsl', 'mts', 'staff selection', 'cpo', 'stenographer', 'gd constable'],
    iconType: 'document',
  },
  {
    id: 'railways',
    name: 'Railway Exams (RRB)',
    shortName: 'Railway Exams',
    slug: 'railways',
    coverage: 'Railway Recruitment Boards (NTPC, Group D, ALP, Technician, RPF)',
    keywords: ['railway', 'railways', 'rrb', 'ntpc', 'group d', 'alp', 'rpf', 'technician'],
    iconType: 'train',
  },
  {
    id: 'banking',
    name: 'Banking & Insurance Exams',
    shortName: 'Banking Exams',
    slug: 'banking',
    coverage: 'SBI, IBPS PO/Clerk, RBI Grade B, LIC & Public Sector Banks',
    keywords: ['bank', 'banking', 'sbi', 'ibps', 'rbi', 'lic', 'clerk', 'po', 'nabard', 'insurance'],
    iconType: 'bank',
  },
  {
    id: 'state-exams',
    name: 'Latest Govt Jobs',
    shortName: 'Latest Govt Jobs',
    slug: 'state-exams',
    coverage: 'State PSCs (UPPSC, BPSC, MPPSC, MPSC, RPSC) & State Boards',
    keywords: ['state', 'uppsc', 'bpsc', 'mpsc', 'rpsc', 'mppsc', 'pcs', 'patwari', 'lekhpal', 'psc', 'vyapam', 'jobs', 'sarkari'],
    iconType: 'building',
  },
  {
    id: 'defence',
    name: 'Defence & Paramilitary Exams',
    shortName: 'Defence Exams',
    slug: 'defence',
    coverage: 'Indian Armed Forces (Army, Navy, Air Force), NDA, CDS, AFCAT, CAPF, Coast Guard',
    keywords: ['defence', 'defense', 'army', 'navy', 'air force', 'nda', 'cds', 'afcat', 'capf', 'coast guard', 'cgept', 'navik', 'agniveer'],
    iconType: 'shield',
  },
  {
    id: 'police',
    name: 'Police Recruitment Exams',
    shortName: 'Police Exams',
    slug: 'police',
    coverage: 'State Police Sub-Inspector (SI), Constable, ASI & Driver Drives',
    keywords: ['police', 'constable', 'si', 'sub-inspector', 'driver', 'delhi police', 'mp police', 'mpesb'],
    iconType: 'badge',
  },
  {
    id: 'teaching',
    name: 'Teaching & Education Exams',
    shortName: 'Teaching Exams',
    slug: 'teaching',
    coverage: 'CTET, State TETs, KVS, NVS, DSSSB, Assistant Professor & PGT/TGT/PRT',
    keywords: ['teach', 'teacher', 'ctet', 'tet', 'kvs', 'nvs', 'dsssb', 'ugc', 'net', 'pgt', 'tgt', 'prt', 'upessc'],
    iconType: 'book',
  },
  {
    id: 'psu-engineering',
    name: 'PSU & Engineering Exams',
    shortName: 'PSU & Engineering',
    slug: 'psu-engineering',
    coverage: 'BHEL, ISRO, DRDO, GATE, State Engineering Services & Technical Drives',
    keywords: ['psu', 'engineering', 'gate', 'isro', 'drdo', 'bhel', 'bel', 'sail', 'iocl', 'polytechnic', 'jeecup', 'artisan', 'technical', 'diploma'],
    iconType: 'gear',
  },
];

// Combine ONLY real database articles per category (NO fake fallback data)
const bentoGridData = streamCategories.map((cat) => {
  const matchedLive = displayArticles.filter((art) => {
    const artCatSlug = (art.categorySlug || '').toLowerCase();
    const artCatName = (art.category || '').toLowerCase();
    const artTitle = (art.title || '').toLowerCase();

    if (artCatSlug === cat.slug || artCatName === cat.name.toLowerCase()) return true;
    if (cat.slug === 'psu-engineering' && (artCatSlug === 'admissions' || artCatName.includes('admission'))) return true;
    return cat.keywords.some((kw) => artCatSlug.includes(kw) || artCatName.includes(kw) || artTitle.includes(kw));
  });

  return {
    ...cat,
    articles: matchedLive.slice(0, 4),
    totalCount: matchedLive.length,
  };
});

// Official Portals for rapid reference
const R2_PORTAL_BASE = 'https://pub-68568854a58845bc975b176de76b1ad5.r2.dev/portals';
const verifiedPortals = [
  { name: 'UPSC', url: 'upsc.gov.in', href: 'https://www.upsc.gov.in/', logo: `${R2_PORTAL_BASE}/upsc.svg`, initial: 'U', bg: 'bg-[#0C2340]', text: 'text-[#E2B13C]' },
  { name: 'SSC', url: 'ssc.gov.in', href: 'https://ssc.gov.in/', logo: `${R2_PORTAL_BASE}/ssc.svg`, initial: 'S', bg: 'bg-[#8B0000]', text: 'text-[#FFD700]' },
  { name: 'Railways', url: 'rrb.indianrailways.gov.in', href: 'https://rrb.indianrailways.gov.in/', logo: `${R2_PORTAL_BASE}/railways.svg`, initial: 'R', bg: 'bg-[#003366]', text: 'text-[#E5A823]' },
  { name: 'UPPSC', url: 'uppsc.up.nic.in', href: 'https://uppsc.up.nic.in/', logo: `${R2_PORTAL_BASE}/uppsc.svg`, initial: 'UP', bg: 'bg-[#14532D]', text: 'text-[#FEF08A]' },
  { name: 'SBI Careers', url: 'sbi.co.in', href: 'https://sbi.co.in/web/careers', logo: `${R2_PORTAL_BASE}/sbi.svg`, initial: 'SBI', bg: 'bg-[#0080C7]', text: 'text-white' },
  { name: 'IBPS', url: 'ibps.in', href: 'https://www.ibps.in/', logo: `${R2_PORTAL_BASE}/ibps.svg`, initial: 'I', bg: 'bg-[#312E81]', text: 'text-[#F59E0B]' },
];

const pageTitle = `${siteName} — Official Government Exam Intelligence & Sarkari Portals`;
const pageDescription = `${siteName} (${siteDomain}) delivers verified government examination notices, admit cards, answer keys, syllabi, and direct official commission portal links across India.`;
const canonicalUrl = `${siteUrl}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: siteName,
      alternateName: [siteName, siteDomain, `${siteName} Sarkari Portal`],
      url: canonicalUrl,
      description: pageDescription,
      inLanguage: ['en-IN', 'hi-Latn'],
      about: [
        { '@type': 'Thing', name: 'Government Examinations in India' },
        { '@type': 'Thing', name: 'Sarkari Naukri Notifications' },
        { '@type': 'Thing', name: 'Civil Services Examination' },
        { '@type': 'Thing', name: 'Staff Selection Commission' },
        { '@type': 'Thing', name: 'Railway Recruitment Boards' },
      ],
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteUrl}/?search={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: siteName,
      alternateName: [siteName, siteDomain],
      url: canonicalUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/logo.png`,
        width: 512,
        height: 512,
        caption: `${siteName} Logo`,
      },
      image: `${siteUrl}/og-image.jpg`,
      sameAs: [whatsappChannel, telegramChannel].filter(Boolean),
      description: 'Verified government exam notifications, Sarkari job updates, admit cards, answer keys, and counselling results portal across India.',
      knowsAbout: [
        'Government Exams in India',
        'Sarkari Naukri Alerts',
        'UPSC Civil Services Examination',
        'Staff Selection Commission (SSC)',
        'Railway Recruitment Control Board (RRB)',
        'Institute of Banking Personnel Selection (IBPS)',
        'State Public Service Commissions',
        'Admit Cards & Answer Keys',
        'Exam Syllabi & Cut-off Marks',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: siteFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={`${siteUrl}/og-image.jpg`}
  ogType="website"
  jsonLd={jsonLd}
  hideHeader={true}
  hideDesktopSidebar={true}
>
  <div class="min-h-screen bg-canvas text-white transition-colors duration-200 relative overflow-hidden">
    
    {/* Horizon Ambient Radial Glow */}
    <div class="pointer-events-none absolute -top-48 left-1/2 -translate-x-1/2 w-[850px] h-[450px] bg-gradient-to-b from-[#0a58ca]/20 via-[#38b6ff]/5 to-transparent blur-[120px] rounded-full select-none" aria-hidden="true"></div>

    <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-20 relative z-10">

      {/* ══════════════════════════════════════════════════════════
          1. TOP HOMEPAGE NAVBAR: BRAND (govtpariksha.com) + HEADER TOOLS
          ══════════════════════════════════════════════════════════ */}
      <h1 class="sr-only">GovtPariksha — Verified Government Exam Notifications, Admit Cards & Results</h1>

      <div class="flex items-center justify-between gap-3 py-3 border-b border-border/50 mb-6">
        
        {/* Left: Mobile Drawer Trigger + Brand Identity */}
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          {/* Mobile Drawer Button for Phone screens */}
          <button 
            id="mobile-drawer-toggle-btn"
            data-sidebar-toggle
            type="button"
            class="lg:hidden text-muted hover:text-white p-2 rounded-xl hover:bg-surface-raised border border-border/60 transition cursor-pointer flex items-center justify-center shrink-0"
            title="Open Menu"
            aria-label="Open Navigation Menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          {/* Brand Logo & Name */}
          <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label={`${siteDomain} home`}>
            <BrandLogo size={32} class="group-hover:scale-105 transition-transform shrink-0" />
            <span class="flex items-center font-bold text-base sm:text-lg tracking-tight text-white">
              {brandPrefix}<span class="text-accent">{brandSuffix}</span>
            </span>
          </a>
        </div>

        {/* Right Toolbar Items: Language, Theme, Favorites, Notifications, Profile / Login */}
        <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
          {/* Language Switcher Pill */}
          <div class="hidden sm:inline-flex items-center p-0.5 bg-surface border border-border/80 rounded-xl text-xs font-semibold select-none shrink-0" role="group" aria-label="Language selection">
            <button
              type="button"
              data-app-lang="hinglish"
              class="app-lang-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold cursor-pointer bg-accent !text-white"
              title="Switch to Hinglish"
              aria-pressed="true"
            >
              HI
            </button>
            <button
              type="button"
              data-app-lang="en"
              class="app-lang-btn px-2.5 py-1 rounded-lg text-[11px] font-semibold cursor-pointer text-muted hover:text-white"
              title="Switch to English"
              aria-pressed="false"
            >
              EN
            </button>
          </div>

          {/* Theme Toggle Button */}
          <button
            type="button"
            class="theme-toggle-btn relative w-12 sm:w-13 h-7 bg-surface border border-border/80 hover:border-accent/40 rounded-pill p-0.5 flex items-center cursor-pointer transition-colors focus:outline-none shrink-0"
            title="Toggle Dark and Light Mode"
            aria-label="Toggle Dark and Light Mode"
          >
            <span
              class="theme-toggle-knob w-5 h-5 rounded-full bg-surface-raised border border-border text-white flex items-center justify-center text-xs shadow-2xs transition-transform duration-200 translate-x-0.5"
            >
              <span class="light-icon text-[11px] select-none leading-none">☀️</span>
              <span class="dark-icon text-[11px] select-none leading-none hidden">🌙</span>
            </span>
          </button>

          {/* Bookmarks / Favorites Button & Dropdown */}
          <div class="relative z-[1090] flex items-center">
            <button 
              id="header-favorites-btn"
              type="button"
              class="relative w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-xl bg-surface border border-border/80 hover:border-accent/40 text-muted hover:text-white transition cursor-pointer shadow-2xs focus:outline-none hover:bg-surface-raised"
              title="Saved Favorites"
              aria-label="Saved Favorites"
              aria-haspopup="dialog"
              aria-expanded="false"
            >
              <svg class="w-4 h-4 text-muted hover:text-rose-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              <span class="favorites-count-badge hidden absolute -top-1 -right-1 px-1 min-w-[16px] h-4 rounded-full bg-rose-500 text-[9px] font-bold text-white flex items-center justify-center leading-none shadow-xs border border-surface">
                0
              </span>
            </button>

            {/* Dropdown Container */}
            <FavoritesDropdown id="header-favorites-dropdown" />
          </div>

          {/* Notifications Button & Dropdown */}
          <div class="relative z-[1090] flex items-center">
            <button 
              id="header-notification-btn"
              data-notification-trigger="header-notification-popup"
              type="button"
              class="group relative w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-xl bg-surface border border-border/80 hover:border-accent/40 text-muted hover:text-white transition cursor-pointer shadow-2xs focus:outline-none hover:bg-surface-raised"
              title="Notifications"
              aria-label="Notifications"
              aria-haspopup="dialog"
              aria-expanded="false"
            >
              <svg class="w-4 h-4 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              <span class="notification-dot-indicator absolute top-1.5 right-1.5 flex h-2 w-2 hidden pointer-events-none z-10">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
              </span>
              <span class="notification-badge-count sr-only">0</span>
            </button>

            {/* Header Notification Popover */}
            <NotificationPopup id="header-notification-popup" prefix="header" />
          </div>

          {/* Profile Dropdown for Logged In User */}
          <div id="header-profile-section" class="header-auth-logged-in hidden relative z-[1100]">
            <button 
              id="header-profile-trigger"
              data-profile-trigger="header-profile-dropdown"
              type="button"
              class="header-profile-avatar-btn w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-surface-raised border border-border text-white font-bold flex items-center justify-center transition cursor-pointer shadow-xs focus:outline-none focus:ring-2 focus:ring-accent/40 select-none overflow-hidden shrink-0 hover:border-accent/40"
              aria-label="Open User Profile Menu"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="user-avatar-initials header-profile-initials inline-flex items-center justify-center text-center text-xs sm:text-[13px] font-bold leading-none uppercase">U</span>
            </button>

            <ProfileDropdown id="header-profile-dropdown" position="top" />
          </div>

          {/* Login / Get Started Button for Logged Out User */}
          <div class="header-auth-logged-out flex items-center">
            <a 
              href="/login"
              id="header-login-btn"
              class="group inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-1.5 rounded-xl bg-accent hover:bg-accent/90 text-[#ffffff] font-semibold text-xs shadow-xs hover:shadow-sm transition-all duration-150 shrink-0 cursor-pointer"
              title="Log in / Get Started"
            >
              <span class="tracking-tight sm:hidden">Log in</span>
              <span class="tracking-tight hidden sm:inline">Get Started</span>
              <svg 
                class="w-3.5 h-3.5 text-[#ffffff] transition-transform duration-200 ease-out group-hover:translate-x-1" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2.5" 
                stroke-linecap="round" 
                stroke-linejoin="round"
              >
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>

      </div>

      {/* ══════════════════════════════════════════════════════════
          2. SECOND: COMMAND SEARCHBAR WITH INTEGRATED CATEGORY DROPDOWN
          ══════════════════════════════════════════════════════════ */}
      <section class="max-w-3xl mx-auto mb-10 pt-1 relative z-40" aria-label="Exam Search and Category Filter">
        
        {/* Spotlight Command Bar with Attached Category Dropdown */}
        <div class="relative group z-40">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-accent/30 via-sky-500/20 to-blue-600/30 rounded-2xl blur-xs opacity-0 group-focus-within:opacity-100 transition-opacity duration-200 pointer-events-none"></div>

          <div class="relative flex items-center bg-surface border border-border/80 group-focus-within:border-accent rounded-2xl px-2 sm:px-3 py-1.5 sm:py-2 shadow-2xs transition-all duration-200 gap-1.5 sm:gap-2">
            
            {/* Attached Category Dropdown Trigger */}
            <div class="relative shrink-0 z-50" id="category-dropdown-container">
              <button
                id="category-dropdown-btn"
                type="button"
                class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-surface-raised/80 hover:bg-surface-raised border border-border/80 text-white text-xs font-semibold cursor-pointer transition select-none"
                aria-expanded="false"
                aria-haspopup="listbox"
                title="Filter by Exam Category"
              >
                <span id="category-dropdown-label" class="truncate max-w-[100px] sm:max-w-[150px]">All Streams</span>
                <svg id="category-dropdown-arrow" class="w-3.5 h-3.5 text-muted transition-transform duration-200 shrink-0 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              {/* Category Dropdown Menu */}
              <div
                id="category-dropdown-menu"
                class="hidden absolute left-0 top-full mt-2 w-64 max-h-84 overflow-y-auto bg-surface border border-border rounded-2xl shadow-2xl py-1.5 z-[100] backdrop-blur-xl scrollbar-none"
                role="listbox"
              >
                <button
                  type="button"
                  data-stream-option="all"
                  data-stream-name="All Streams"
                  class="category-option-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-semibold text-white hover:bg-surface-raised transition text-left cursor-pointer"
                  role="option"
                  aria-selected="true"
                >
                  <span class="flex items-center gap-2 truncate">
                    <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
