---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import videoBg from '../assets/video-bg.png';
import BrandLogo from '../components/BrandLogo.astro';
import InkOrbitFeatures from '../components/ui/ink-orbit-features';
import { Avatar, Style } from '@dicebear/core';
import lorelei from '@dicebear/styles/lorelei.json' with { type: 'json' };
import {
  contactEmail,
  examPortals,
  siteDomain,
  siteFaqs,
  siteName,
  siteSlogan,
  telegramChannel,
  whatsappChannel,
  siteUrl,
} from '../data/site';

const avatarStyle = new Style(lorelei);
const studentPerspectives = [
  {
    title: 'Find deadlines faster',
    body: 'Clear dates, concise summaries, and direct official links make important updates easier to act on.',
    seed: 'exam-planner',
  },
  {
    title: 'Prepare in one place',
    body: 'Exam streams and focused resources keep preparation organised without jumping between scattered sources.',
    seed: 'focused-learner',
  },
  {
    title: 'Verify before applying',
    body: 'Every guide points back to the relevant official portal so critical details can be checked confidently.',
    seed: 'careful-candidate',
  },
].map((item) => ({
  ...item,
  avatar: new Avatar(avatarStyle, {
    seed: item.seed,
    size: 96,
    borderRadius: 50,
    backgroundColor: ['#FFE1D3', '#F1E7DB', '#FFD0BA'],
  }).toDataUri(),
}));

const groups = [
  {
    title: 'Explore',
    links: [
      ['Exam updates', '/blogs'],
      ['Latest notifications', '/blogs#latest-updates'],
      ['Exam categories', '/blogs#categories'],
      ['Test series', '/test-series'],
      ['Bookmarks', '/bookmarks'],
      ['Favorites', '/favorites'],
      ['Notifications', '/notifications'],
    ],
  },
  {
    title: 'Exam streams',
    links: [
      ['Central Govt & UPSC', '/category/central-government'],
      ['SSC exams', '/category/ssc'],
      ['Railway exams', '/category/railways'],
      ['Banking exams', '/category/banking'],
      ['Latest govt jobs', '/category/latest-jobs'],
      ['Defence exams', '/category/defence'],
      ['Police recruitment', '/category/police'],
      ['Teaching exams', '/category/teaching'],
      ['PSU & engineering', '/category/psu-engineering'],
    ],
  },
  { title: 'Resources', links: examPortals.slice(0, 9).map(({ name, href }) => [name, href]) },
  {
    title: 'Company',
    links: [
      ['About our portal', '/blogs#faqs'],
      ['Contact us', '/contact-us'],
      ['Pricing', '/pricing'],
      ['Refund policy', '/refund-policy'],
      ['Privacy policy', '/privacy-policy'],
      ['Terms of service', '/terms-of-service'],
      ['Sitemap', '/sitemap'],
      ['RSS feed', '/rss.xml'],
      ['Log in', '/login'],
      ['Create account', '/signup'],
    ],
  },
];

const ctaBarHeights = [
  190, 170, 150, 132, 114, 98, 82, 68, 56, 46, 38, 32, 32, 38, 46, 56, 68, 82, 98, 114, 132, 150,
  170, 190,
];
---

<Layout
  title={`${siteName} — Explore exam resources`}
  description={`${siteName} links, exam resources, official portals, policies, and community channels.`}
  canonicalUrl={`${siteUrl}/`}
  ogImage={`${siteUrl}/og-image.jpg`}
  ogType="website"
  isEditorialTheme={true}
  hideHeader={true}
  hideDesktopSidebar={true}
  hideFooter={true}
>
  <div class="relative min-h-screen overflow-x-clip bg-editorial-bg text-editorial-text selection:bg-editorial-accent/20 selection:text-editorial-accent transition-colors duration-200">
    <section
      class="border-t border-[#191613]/15 dark:border-white/10 bg-editorial-bg text-[#191613] dark:text-[#E7E0D8] transition-colors duration-200 relative z-30 overflow-x-clip"
      aria-labelledby="landing-heading"
    >
      <nav
        class="mx-auto flex h-15 sm:h-18 max-w-[1180px] w-full items-center justify-between px-3 sm:px-6 md:px-8 relative z-40"
        aria-label="Landing navigation"
      >
        <a
          href="/"
          class="flex items-center gap-1.5 sm:gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-3 shrink-0"
          aria-label={`${siteName} home`}
        >
          <BrandLogo size={26} class="sm:hidden" />
          <BrandLogo size={34} class="hidden sm:block" />
          <span class="font-['EB_Garamond'] text-[17px] min-[360px]:text-[19px] sm:text-[24px] leading-none font-medium tracking-tight text-[#191613] dark:text-[#F5EEE6] whitespace-nowrap"
            >{siteName}</span
          >
        </a>
        <div
          class="hidden items-center gap-7 font-['Geist'] text-[12px] font-medium text-[#514A44] dark:text-[#A89D92] md:flex"
        >
          <a href="/blogs" data-astro-prefetch="hover" class="transition-colors hover:text-[#FF4D00]">Blogs</a>
          <a href="/test-series" data-astro-prefetch="hover" class="transition-colors hover:text-[#FF4D00]">Live tests</a>
          <a href="/test-series" data-astro-prefetch="hover" class="transition-colors hover:text-[#FF4D00]">Quizzes</a>
        </div>
        <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
          {/* Logged-out navbar actions */}
          <div id="home-nav-logged-out" class="header-auth-logged-out flex items-center gap-1 sm:gap-2 shrink-0">
            <a
              href="/login"
              data-astro-prefetch="hover"
              class="min-h-[34px] sm:min-h-9 inline-flex items-center justify-center px-2 sm:px-3 font-['Geist'] text-[11px] sm:text-[12px] font-semibold text-[#514A44] dark:text-[#A89D92] transition-colors hover:text-[#191613] dark:hover:text-white rounded-full hover:bg-black/5 dark:hover:bg-white/5 whitespace-nowrap touch-manipulation"
              >Log in</a
            >
            <a
              href="/blogs"
              data-astro-prefetch="hover"
              class="inline-flex min-h-[34px] sm:min-h-9 items-center justify-center rounded-full bg-[#FF4D00] px-2.5 sm:px-4 font-['Geist'] text-[11px] sm:text-[12px] font-semibold text-white transition-colors hover:bg-[#D94100] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-2 shadow-xs whitespace-nowrap touch-manipulation"
            >
              <span class="nav-btn-long-text">Explore blogs</span>
              <span class="nav-btn-short-text">Explore</span>
            </a>
          </div>

          {/* Logged-in profile trigger & dropdown */}
          <div id="home-nav-logged-in" class="header-auth-logged-in hidden flex items-center gap-1.5 sm:gap-2.5 relative shrink-0">
            <a
              href="/blogs"
              data-astro-prefetch="hover"
              class="hidden sm:inline-flex min-h-9 items-center rounded-full border border-[#191613]/15 dark:border-white/15 bg-white dark:bg-[#1C1A18] px-3.5 font-['Geist'] text-[11px] font-semibold text-[#514A44] dark:text-[#A89D92] transition-colors hover:border-[#FF4D00]/40 hover:text-[#191613] dark:hover:text-white shadow-2xs whitespace-nowrap"
              >Blogs</a
            >
            <div class="relative">
              <button
                id="home-profile-trigger"
                data-profile-trigger="home-profile-dropdown"
                type="button"
                aria-expanded="false"
                aria-haspopup="menu"
                aria-label="Open user profile menu"
                class="group relative size-9 sm:size-9.5 rounded-full border border-[#191613]/15 dark:border-white/15 bg-white dark:bg-[#1C1A18] flex items-center justify-center shadow-xs hover:border-[#FF4D00]/50 hover:shadow-sm transition-all duration-150 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#FF4D00]/30 select-none touch-manipulation"
              >
                <span
                  class="user-avatar-initials pointer-events-none size-7.5 sm:size-8 rounded-full bg-gradient-to-br from-[#FF6A00] to-[#FF4D00] text-white font-bold flex items-center justify-center text-[11px] sm:text-[12px] uppercase shadow-xs shrink-0 select-none"
                  >U</span
                >
              </button>

              {/* Profile Dropdown */}
              <div
                id="home-profile-dropdown"
                role="menu"
                aria-orientation="vertical"
                class="hidden absolute right-0 top-full mt-2 w-72 max-w-[calc(100vw-24px)] rounded-2xl border border-[#191613]/15 dark:border-white/15 bg-white dark:bg-[#1C1A18] p-2.5 shadow-[0_16px_40px_rgba(25,22,19,0.16)] z-[9999] transition-all duration-150 transform scale-95 opacity-0 select-none"
              >
                {/* User Profile Header Card */}
                <a
                  href="/profile"
                  data-astro-prefetch="hover"
                  class="group/card flex items-center gap-3 p-2.5 rounded-xl bg-[#FFF8F1] dark:bg-[#25221F] border border-[#FF4D00]/15 mb-2 hover:bg-[#FFEBD4] dark:hover:bg-[#2F2B27] hover:border-[#FF4D00]/30 transition-colors cursor-pointer select-none"
                  title="View My Profile"
                >
                  <div
                    class="user-avatar-initials size-10 rounded-full bg-gradient-to-br from-[#FF6A00] to-[#FF4D00] text-white font-bold flex items-center justify-center text-[13px] uppercase shadow-xs shrink-0 group-hover/card:scale-105 transition-transform"
                  >
                    U
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5">
                      <p class="user-display-name font-['Geist'] text-[13px] font-bold text-[#191613] dark:text-[#F5EEE6] truncate group-hover/card:text-[#FF4D00] transition-colors">
                        User
                      </p>
                      <span
                        class="user-role-badge inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-[#FF4D00]/10 text-[#FF4D00]"
                        >Aspirant</span
                      >
                    </div>
                    <p class="user-display-email font-['Geist'] text-[11px] text-[#675F58] dark:text-[#A89D92] truncate">
                      user@example.com
                    </p>
                  </div>
                  <svg class="size-4 shrink-0 text-[#675F58] dark:text-[#A89D92] group-hover/card:text-[#FF4D00] group-hover/card:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>

                {/* Options */}
                <div class="space-y-0.5 font-['Geist'] text-[12px]">
                  <a
                    href="/profile"
                    data-astro-prefetch="hover"
                    role="menuitem"
                    class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] dark:text-[#E7E0D8] hover:bg-[#FFF8F1] dark:hover:bg-[#25221F] hover:text-[#FF4D00] transition-colors"
                  >
                    <svg class="size-4 shrink-0 text-[#675F58] dark:text-[#A89D92]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span class="font-medium">My Profile</span>
                  </a>

                  <a
                    href="/test-series"
                    data-astro-prefetch="hover"
                    role="menuitem"
                    class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] dark:text-[#E7E0D8] hover:bg-[#FFF8F1] dark:hover:bg-[#25221F] hover:text-[#FF4D00] transition-colors"
                  >
                    <svg class="size-4 shrink-0 text-[#675F58] dark:text-[#A89D92]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="font-medium">Live Tests & Mock Series</span>
                  </a>

                  <a
                    href="/favorites"
                    data-astro-prefetch="hover"
                    role="menuitem"
                    class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] dark:text-[#E7E0D8] hover:bg-[#FFF8F1] dark:hover:bg-[#25221F] hover:text-[#FF4D00] transition-colors"
                  >
                    <svg class="size-4 shrink-0 text-[#675F58] dark:text-[#A89D92]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <span class="font-medium">Saved Bookmarks</span>
                  </a>

                  <a
                    href="/notifications"
                    role="menuitem"
                    class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] dark:text-[#E7E0D8] hover:bg-[#FFF8F1] dark:hover:bg-[#25221F] hover:text-[#FF4D00] transition-colors"
                  >
                    <svg class="size-4 shrink-0 text-[#675F58] dark:text-[#A89D92]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                    </svg>
                    <span class="font-medium">Notifications</span>
                  </a>

                  <a
                    id="home-admin-link"
                    href="/administrator"
                    role="menuitem"
                    class="admin-panel-link hidden w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] dark:text-[#E7E0D8] hover:bg-[#FFF8F1] dark:hover:bg-[#25221F] hover:text-[#FF4D00] transition-colors"
                  >
                    <svg class="size-4 shrink-0 text-[#675F58] dark:text-[#A89D92]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 4.55-2.99 7.9-7 9-4.01-1.1-7-4.45-7-9V7l7-4z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12l1.5 1.5 3.5-3.5"></path>
                    </svg>
                    <span class="font-medium">Open Admin Desk</span>
                  </a>

                  {/* Preferences: Theme & Language Switcher */}
                  <div class="my-1.5 p-2 rounded-xl bg-[#FFF8F1] dark:bg-[#25221F] border border-[#191613]/10 dark:border-white/10 space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="flex items-center gap-2 text-xs font-medium text-[#675F58] dark:text-[#A89D92]">
                        <svg class="size-3.5 text-[#514A44] dark:text-[#A89D92]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <span>Theme</span>
                      </span>
                      <button
                        type="button"
                        class="theme-toggle-btn relative w-12 h-6.5 bg-white dark:bg-[#1C1A18] border border-[#191613]/15 dark:border-white/15 hover:border-[#FF4D00]/50 rounded-full p-0.5 flex items-center cursor-pointer transition-all duration-150 focus:outline-none shrink-0"
                        title="Toggle Dark and Light Mode"
                        aria-label="Toggle Dark and Light Mode"
                      >
                        <span class="theme-toggle-knob w-5 h-5 rounded-full bg-gradient-to-br from-[#FF6A00] to-[#FF4D00] text-white flex items-center justify-center text-[10px] shadow-xs transition-transform duration-200 translate-x-0.5">
                          <span class="light-icon text-[10px] select-none leading-none">☀️</span>
                          <span class="dark-icon text-[10px] select-none leading-none hidden">🌙</span>
                        </span>
                      </button>
                    </div>

                    <div class="flex items-center justify-between pt-1 border-t border-[#191613]/10 dark:border-white/10">
                      <span class="flex items-center gap-2 text-xs font-medium text-[#675F58] dark:text-[#A89D92]">
                        <svg class="size-3.5 text-[#514A44] dark:text-[#A89D92]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                        </svg>
                        <span>Language</span>
                      </span>
                      <div
                        class="inline-flex items-center p-0.5 bg-white dark:bg-[#1C1A18] border border-[#191613]/15 dark:border-white/15 rounded-lg select-none shrink-0"
                        role="group"
                        aria-label="Language selection"
                      >
                        <button
                          type="button"
                          data-app-lang="hinglish"
                          class="app-lang-btn px-2 py-0.5 rounded-md text-[10px] font-bold cursor-pointer transition-colors"
                          title="Switch to Hinglish"
                          aria-pressed="true"
                        >
                          HI
                        </button>
                        <button
                          type="button"
                          data-app-lang="en"
                          class="app-lang-btn px-2 py-0.5 rounded-md text-[10px] font-semibold cursor-pointer transition-colors"
                          title="Switch to English"
                          aria-pressed="false"
                        >
                          EN
                        </button>
                      </div>
                    </div>
                  </div>

                  <div class="my-1 border-t border-[#191613]/10 dark:border-white/10"></div>

                  <button
                    type="button"
                    id="home-logout-btn"
                    data-auth-action="logout"
                    role="menuitem"
                    class="auth-logout-btn flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-left font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer"
                  >
                    <svg class="size-4 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    <span>Log out</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <div class="mx-auto max-w-[1180px] px-5 pb-0 pt-16 sm:pt-20 text-center sm:px-8">
        <p
          class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.18em] text-[#FF4D00]"
        >
          Government exam preparation, simplified
        </p>
        <h1
          id="landing-heading"
          class="mx-auto mt-5 max-w-[920px] font-['EB_Garamond'] text-[clamp(3.25rem,5vw,6.5rem)] font-normal leading-[0.92] tracking-[-0.045em] text-[#191613] dark:text-[#F5EEE6]"
        >
          Prepare smarter.<br />Perform with confidence.
        </h1>
          <p
            class="mx-auto mt-7 max-w-[650px] font-['Geist'] text-[14px] leading-7 text-[#675F58] dark:text-[#A89D92] sm:text-[16px]"
          >
            Verified exam updates, focused quizzes, and live tests—brought together to keep your
            preparation clear and measurable.
          </p>
          <div class="mt-8 flex justify-center">
            <a
              href="/test-series"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#FF4D00] px-7 font-['Geist'] text-[13px] font-semibold text-white transition-colors hover:bg-[#D94100] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-3"
            >
              Explore tests
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
                ></path></svg
              >
            </a>
          </div>

          <div class="relative mx-auto mb-8 mt-16 max-w-[1080px] translate-y-px text-left sm:mt-20">
            <div
              class="relative rounded-[20px] border border-black/80 dark:border-white/20 bg-[#111111] dark:bg-[#1C1A18] p-[7px] sm:p-[9px]"
            >
              <div class="relative aspect-[16/10] overflow-hidden rounded-[13px] bg-[#111111]">
                <Image
                  src={videoBg}
                  alt="GovtPariksha platform preview"
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover object-center"
                />
                <span
                  class="absolute left-1/2 top-0 h-[15px] w-[74px] -translate-x-1/2 rounded-b-[9px] bg-[#111111] sm:h-[18px] sm:w-[98px]"
                  aria-hidden="true"></span>
                <div
                  class="absolute bottom-2 left-1/2 flex -translate-x-1/2 items-end gap-1 rounded-[12px] border border-white/35 bg-white/45 p-1.5 shadow-[0_8px_24px_rgba(0,0,0,0.18)] backdrop-blur-xl sm:bottom-4 sm:gap-1.5 sm:rounded-[18px] sm:p-2"
                  aria-hidden="true"
                >
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-white/90 sm:size-10 sm:rounded-[10px]"
                  >
                    <span class="grid grid-cols-3 gap-[2px] sm:gap-[3px]">
                      <i class="size-[4px] rounded-[1px] bg-[#77DF2F] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FFD21E] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF8A00] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#DC3C72] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#5E6F75] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF4E62] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#804CD9] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#385CE5] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#55C9AA] sm:size-[6px]"></i>
                    </span>
                  </span>
                  <span
                    class="relative grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#5AE5FF] to-[#1976F3] text-white sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[72%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="1.5"
                      ></circle><path d="m18.2 13.8-7 7 2.6-9.6 9-2-4.6 4.6Z" fill="white"
                      ></path><path d="m13.8 18.2 7-7-2.6 9.6-9 2 4.6-4.6Z" fill="#FF4D4D"
                      ></path></svg
                    >
                    <i
