---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import { Avatar, Style } from '@dicebear/core';
import lorelei from '@dicebear/styles/lorelei.json' with { type: 'json' };
import {
  contactEmail,
  examPortals,
  siteDomain,
  siteFaqs,
  siteName,
  siteSlogan,
  telegramChannel,
  whatsappChannel,
} from '../data/site';

const avatarStyle = new Style(lorelei);
const studentPerspectives = [
  {
    title: 'Find deadlines faster',
    body: 'Clear dates, concise summaries, and direct official links make important updates easier to act on.',
    seed: 'exam-planner',
  },
  {
    title: 'Prepare in one place',
    body: 'Exam streams and focused resources keep preparation organised without jumping between scattered sources.',
    seed: 'focused-learner',
  },
  {
    title: 'Verify before applying',
    body: 'Every guide points back to the relevant official portal so critical details can be checked confidently.',
    seed: 'careful-candidate',
  },
].map((item) => ({
  ...item,
  avatar: new Avatar(avatarStyle, {
    seed: item.seed,
    size: 96,
    borderRadius: 50,
    backgroundColor: ['#FFE1D3', '#F1E7DB', '#FFD0BA'],
  }).toDataUri(),
}));

const groups = [
  {
    title: 'Explore',
    links: [
      ['Exam updates', '/blogs'],
      ['Latest notifications', '/blogs#latest-updates'],
      ['Exam categories', '/blogs#categories'],
      ['Test series', '/test-series'],
      ['Bookmarks', '/bookmarks'],
      ['Favorites', '/favorites'],
      ['Notifications', '/notifications'],
    ],
  },
  {
    title: 'Exam streams',
    links: [
      ['Central Govt & UPSC', '/category/central-government'],
      ['SSC exams', '/category/ssc'],
      ['Railway exams', '/category/railways'],
      ['Banking exams', '/category/banking'],
      ['Latest govt jobs', '/category/latest-jobs'],
      ['Defence exams', '/category/defence'],
      ['Police recruitment', '/category/police'],
      ['Teaching exams', '/category/teaching'],
      ['PSU & engineering', '/category/psu-engineering'],
    ],
  },
  { title: 'Resources', links: examPortals.slice(0, 9).map(({ name, href }) => [name, href]) },
  {
    title: 'Company',
    links: [
      ['About our portal', '/blogs#faqs'],
      ['Contact us', '/contact-us'],
      ['Privacy policy', '/privacy-policy'],
      ['Terms of service', '/terms-of-service'],
      ['Sitemap', '/sitemap'],
      ['RSS feed', '/rss.xml'],
      ['Log in', '/login'],
      ['Create account', '/signup'],
    ],
  },
];

const ctaBarHeights = [
  190, 170, 150, 132, 114, 98, 82, 68, 56, 46, 38, 32, 32, 38, 46, 56, 68, 82, 98, 114, 132, 150,
  170, 190,
];
---

<!doctype html>
<html lang="en" class="theme-dark bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta
      name="description"
      content={`${siteName} links, exam resources, official portals, policies, and community channels.`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteName} — Explore exam resources</title>
  </head>
  <body class="min-h-screen bg-black text-white antialiased">
    <main class="min-h-screen">
      <section
        class="overflow-hidden border-t border-[#191613]/15 bg-[#FFF8F1] text-[#191613]"
        aria-labelledby="landing-heading"
      >
        <nav
          class="mx-auto flex h-18 max-w-[1180px] items-center justify-between px-5 sm:px-8"
          aria-label="Landing navigation"
        >
          <a
            href="/"
            class="flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-3"
            aria-label={`${siteName} home`}
          >
            <BrandLogo size={34} />
            <span class="font-['EB_Garamond'] text-[24px] leading-none font-medium tracking-tight text-[#191613]"
              >{siteName}</span
            >
          </a>
          <div
            class="hidden items-center gap-7 font-['Geist'] text-[12px] font-medium text-[#514A44] md:flex"
          >
            <a href="/blogs" class="transition-colors hover:text-[#FF4D00]">Blogs</a>
            <a href="/test-series" class="transition-colors hover:text-[#FF4D00]">Live tests</a>
            <a href="/test-series" class="transition-colors hover:text-[#FF4D00]">Quizzes</a>
          </div>
          <div class="flex items-center gap-2.5">
            <a
              href="/login"
              class="hidden min-h-10 items-center px-3 font-['Geist'] text-[11px] font-semibold text-[#514A44] transition-colors hover:text-[#191613] sm:inline-flex"
              >Log in</a
            >
            <a
              href="/"
              class="inline-flex min-h-10 items-center rounded-full bg-[#FF4D00] px-4 font-['Geist'] text-[11px] font-semibold text-white transition-colors hover:bg-[#D94100] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-2"
              >Explore blogs</a
            >
          </div>
        </nav>

        <div class="mx-auto max-w-[1180px] px-5 pb-0 pt-20 text-center sm:px-8">
          <p
            class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.18em] text-[#FF4D00]"
          >
            Government exam preparation, simplified
          </p>
          <h1
            id="landing-heading"
            class="mx-auto mt-5 max-w-[920px] font-['EB_Garamond'] text-[clamp(3.25rem,5vw,6.5rem)] font-normal leading-[0.92] tracking-[-0.045em] text-[#191613]"
          >
            Prepare smarter.<br />Perform with confidence.
          </h1>
          <p
            class="mx-auto mt-7 max-w-[650px] font-['Geist'] text-[14px] leading-7 text-[#675F58] sm:text-[16px]"
          >
            Verified exam updates, focused quizzes, and live tests—brought together to keep your
            preparation clear and measurable.
          </p>
          <div class="mt-8 flex justify-center">
            <a
              href="/test-series"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#FF4D00] px-7 font-['Geist'] text-[13px] font-semibold text-white transition-colors hover:bg-[#D94100] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-3"
            >
              Explore tests
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
                ></path></svg
              >
            </a>
          </div>

          <div class="relative mx-auto mb-8 mt-16 max-w-[1080px] translate-y-px text-left sm:mt-20">
            <div
              class="relative rounded-[20px] border border-black/80 bg-[#111111] p-[7px] sm:p-[9px]"
            >
              <div class="relative aspect-[16/10] overflow-hidden rounded-[13px] bg-[#111111]">
                <img
                  src="/video-bg.png"
                  alt="GovtPariksha platform preview"
                  width="4096"
                  height="2304"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="h-full w-full object-cover object-center"
                />
                <span
                  class="absolute left-1/2 top-0 h-[15px] w-[74px] -translate-x-1/2 rounded-b-[9px] bg-[#111111] sm:h-[18px] sm:w-[98px]"
                  aria-hidden="true"></span>
                <div
                  class="absolute bottom-2 left-1/2 flex -translate-x-1/2 items-end gap-1 rounded-[12px] border border-white/35 bg-white/45 p-1.5 shadow-[0_8px_24px_rgba(0,0,0,0.18)] backdrop-blur-xl sm:bottom-4 sm:gap-1.5 sm:rounded-[18px] sm:p-2"
                  aria-hidden="true"
                >
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-white/90 sm:size-10 sm:rounded-[10px]"
                  >
                    <span class="grid grid-cols-3 gap-[2px] sm:gap-[3px]">
                      <i class="size-[4px] rounded-[1px] bg-[#77DF2F] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FFD21E] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF8A00] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#DC3C72] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#5E6F75] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF4E62] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#804CD9] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#385CE5] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#55C9AA] sm:size-[6px]"></i>
                    </span>
                  </span>
                  <span
                    class="relative grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#5AE5FF] to-[#1976F3] text-white sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[72%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="1.5"
                      ></circle><path d="m18.2 13.8-7 7 2.6-9.6 9-2-4.6 4.6Z" fill="white"
                      ></path><path d="m13.8 18.2 7-7-2.6 9.6-9 2 4.6-4.6Z" fill="#FF4D4D"
                      ></path></svg
                    >
                    <i
                      class="absolute -bottom-1 h-0.5 w-0.5 rounded-full bg-black/70 sm:-bottom-1.5"
                    ></i>
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#E8ECED] to-[#858B8D] text-[#333] sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[76%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="9.2" stroke="currentColor" stroke-width="3"
                      ></circle><circle
                        cx="16"
                        cy="16"
                        r="3.5"
                        stroke="currentColor"
                        stroke-width="2"></circle><path
                        d="M16 3v5M16 24v5M3 16h5M24 16h5M6.8 6.8l3.6 3.6M21.6 21.6l3.6 3.6M25.2 6.8l-3.6 3.6M10.4 21.6l-3.6 3.6"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"></path></svg
                    >
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#168EFF] to-[#0758D7] font-['Geist'] text-[8px] font-semibold tracking-[-0.06em] text-white sm:size-10 sm:rounded-[10px] sm:text-[12px]"
                  >
                    zoom
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#76CBFF] to-[#3896E8] text-white sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[72%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="2"
                      ></circle><path
                        d="m9 20.5 7-10 1.5 7.5 5.5-4.5"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path></svg
                    >
                  </span>
                  <span class="mx-0.5 h-6 w-px bg-black/20 sm:h-9"></span>
                  <span class="grid size-7 place-items-center sm:size-10">
                    <svg class="h-full w-[80%] drop-shadow-sm" viewBox="0 0 32 38" fill="none"
                      ><path
                        d="M7 7.5h18l-1.6 27H8.6L7 7.5Z"
                        fill="url(#trash-body)"
                        stroke="#D4D0CC"></path><path
                        d="M5 7.5h22M11 4h10"
                        stroke="#D4D0CC"
                        stroke-width="2"
                        stroke-linecap="round"></path><path
                        d="M12 12v17M16 12v17M20 12v17"
                        stroke="#D7D2CD"></path><defs
                        ><linearGradient
                          id="trash-body"
                          x1="16"
                          y1="7.5"
                          x2="16"
                          y2="34.5"
                          gradientUnits="userSpaceOnUse"
                          ><stop stop-color="#FFF"></stop><stop offset="1" stop-color="#E9E4DE"
                          ></stop></linearGradient
                        ></defs
                      ></svg
                    >
                  </span>
                </div>
              </div>
            </div>
            <div
              class="relative left-1/2 h-[9px] w-[103%] -translate-x-1/2 rounded-b-[55%] border border-t-0 border-[#B8B5AF] bg-[#D9D7D2] sm:h-3"
              aria-hidden="true"
            >
              <span class="mx-auto block h-[3px] w-16 rounded-b-full bg-[#AAA7A1] sm:w-24"></span>
            </div>
          </div>
        </div>
      </section>

      <section
        class="bg-[#FFF8F1] px-5 py-14 text-[#191613] sm:px-8 sm:py-16 lg:px-10 lg:py-20"
        aria-labelledby="services-heading"
      >
        <div class="mx-auto max-w-[1120px]">
          <div class="text-center">
            <p
              class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FF4D00]"
            >
              What we serve
            </p>
            <h2
              id="services-heading"
              class="mt-2 font-['EB_Garamond'] text-4xl font-normal leading-tight tracking-[-0.02em] text-[#191613] sm:text-5xl"
            >
              Learn, practise, and test yourself
            </h2>
            <p class="mx-auto mt-3 max-w-xl font-['Geist'] text-[13px] leading-6 text-[#675F58]">
              Three focused ways to stay informed and make steady progress toward your exam.
            </p>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-3 lg:gap-5">
            <article class="service-card text-center">
              <div class="service-visual" aria-hidden="true">
                <div class="service-demo">
                  <div class="service-demo-header"><span>Latest updates</span><i>3 new</i></div>
                  <div class="service-news-list">
                    <div><b>SSC</b><span>CGL notification released</span><small>Today</small></div>
                    <div><b>UPSC</b><span>Exam dates announced</span><small>1d</small></div>
                    <div><b>RRB</b><span>New vacancy update</span><small>2d</small></div>
                  </div>
                </div>
              </div>
              <p class="font-['Geist'] text-[10px] font-semibold tracking-[0.18em] text-[#FF4D00]">
                01
              </p>
              <h3 class="mt-1.5 font-['EB_Garamond'] text-[24px] font-medium text-[#191613]">
                Blogs
              </h3>
              <p
                class="mx-auto mt-2 max-w-[280px] font-['Geist'] text-[12px] leading-5 text-[#675F58]"
              >
                Clear exam updates, recruitment guides, deadlines, and official notification
                summaries.
              </p>
              <a
                href="/blogs"
                class="mt-3 inline-flex items-center gap-1.5 font-['Geist'] text-[11px] font-semibold text-[#FF4D00] hover:text-[#D94100]"
                >Read updates <span aria-hidden="true">→</span></a
              >
            </article>

            <article class="service-card text-center">
              <div class="service-visual" aria-hidden="true">
                <div class="service-demo">
                  <div class="service-demo-header">
                    <span><em></em> Live test</span><i class="service-countdown"
                      ><b>29:58</b><b>29:57</b></i>
                  </div>
                  <div class="service-question-carousel">
                    <div class="service-test-question service-question-slide">
                      <small>Question 12 of 25</small>
                      <strong>Which body conducts the Civil Services Exam?</strong>
                      <div><span>A</span> SSC</div><div class="active">
                        <span>B</span> UPSC <i>Selected</i>
                      </div>
                    </div>
                    <div class="service-test-question service-question-slide">
                      <small>Question 13 of 25</small>
                      <strong>Which exam recruits for Indian Railways?</strong>
                      <div class="active"><span>A</span> RRB NTPC <i>Selected</i></div><div>
                        <span>B</span> IBPS PO
                      </div>
                    </div>
                  </div>
                  <div class="service-progress"><span></span></div>
                </div>
              </div>
              <p class="font-['Geist'] text-[10px] font-semibold tracking-[0.18em] text-[#FF4D00]">
                02
              </p>
              <h3 class="mt-1.5 font-['EB_Garamond'] text-[24px] font-medium text-[#191613]">
                Live tests
              </h3>
              <p
                class="mx-auto mt-2 max-w-[280px] font-['Geist'] text-[12px] leading-5 text-[#675F58]"
              >
                Timed test sessions that recreate exam pressure and help you measure real progress.
              </p>
              <a
                href="/test-series"
                class="mt-3 inline-flex items-center gap-1.5 font-['Geist'] text-[11px] font-semibold text-[#FF4D00] hover:text-[#D94100]"
                >View live tests <span aria-hidden="true">→</span></a
              >
            </article>

            <article class="service-card text-center">
              <div class="service-visual" aria-hidden="true">
                <div class="service-demo">
                  <div class="service-demo-header">
                    <span>Daily quiz</span><i class="service-question-count"
                      ><b>3 / 10</b><b>4 / 10</b></i>
                  </div>
                  <div class="service-question-carousel">
                    <div class="service-quiz-question service-question-slide">
                      <strong>The Constitution of India came into effect in:</strong>
                      <div><span>A</span> 1947</div><div class="correct">
                        <span>B</span> 1950 <i>Correct ✓</i>
                      </div><div><span>C</span> 1952</div>
                    </div>
                    <div class="service-quiz-question service-question-slide">
                      <strong>India's central bank is:</strong>
                      <div><span>A</span> SBI</div><div class="correct">
                        <span>B</span> RBI <i>Correct ✓</i>
                      </div><div><span>C</span> NABARD</div>
                    </div>
                  </div>
                </div>
              </div>
              <p class="font-['Geist'] text-[10px] font-semibold tracking-[0.18em] text-[#FF4D00]">
                03
              </p>
              <h3 class="mt-1.5 font-['EB_Garamond'] text-[24px] font-medium text-[#191613]">
                Quizzes
              </h3>
              <p
                class="mx-auto mt-2 max-w-[280px] font-['Geist'] text-[12px] leading-5 text-[#675F58]"
              >
                Quick topic-wise practice for strengthening recall and identifying weak areas early.
              </p>
              <a
                href="/test-series"
                class="mt-3 inline-flex items-center gap-1.5 font-['Geist'] text-[11px] font-semibold text-[#FF4D00] hover:text-[#D94100]"
                >Explore quizzes <span aria-hidden="true">→</span></a
              >
            </article>
          </div>
        </div>
      </section>

      <section
        class="bg-[#FFFCF8] px-5 py-20 text-[#191613] sm:px-8 sm:py-24 lg:px-10 lg:py-28"
        aria-labelledby="student-perspectives-heading"
      >
        <div class="mx-auto max-w-[1040px]">
          <div class="text-center">
            <p
              class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FF4D00]"
            >
              Student-first by design
            </p>
            <h2
              id="student-perspectives-heading"
              class="mt-3 font-['EB_Garamond'] text-4xl font-normal leading-tight tracking-[-0.02em] text-[#191613] sm:text-5xl"
            >
              Made for students everywhere
            </h2>
            <p class="mx-auto mt-4 max-w-xl font-['Geist'] text-[13px] leading-6 text-[#675F58]">
              Three principles shaping a clearer, calmer way to discover and verify exam
              information.
            </p>
          </div>

          <div class="student-marquee mt-12 overflow-hidden" aria-label="Student perspectives">
            <div class="student-marquee-track">
              {
                [false, true].map((duplicate) => (
                  <div class="student-marquee-group" aria-hidden={duplicate ? 'true' : undefined}>
                    {studentPerspectives.map((item) => (
                      <article class="flex min-h-[220px] w-[min(82vw,340px)] shrink-0 flex-col rounded-xl border border-[#191613]/15 bg-[#fffaf1] p-6 sm:w-[340px] sm:p-7 lg:w-[360px]">
                        <div class="flex items-center gap-3">
                          <img
                            src={item.avatar}
                            width="40"
                            height="40"
                            alt=""
                            class="h-10 w-10 rounded-full border border-[#191613]/10 bg-[#FFF1E8]"
                            loading="lazy"
                            decoding="async"
                          />
                          <div>
                            <h3 class="font-['EB_Garamond'] text-xl font-normal leading-tight text-[#191613]">
                              {item.title}
                            </h3>
                            <p class="mt-0.5 font-['Geist'] text-[10px] font-semibold uppercase tracking-[0.12em] text-[#FF4D00]">
                              Student perspective
                            </p>
                          </div>
                        </div>
                        <p class="mt-6 font-['Geist'] text-[13px] leading-6 text-[#514A44]">
                          {item.body}
                        </p>
                      </article>
                    ))}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section
        class="bg-[#FFFCF8] px-5 py-20 text-[#191613] sm:px-8 sm:py-24 lg:px-10 lg:py-28"
        aria-labelledby="faq-heading"
      >
        <div class="mx-auto max-w-[920px] space-y-40">
          <div class="mx-auto max-w-[680px]">
            <p
              class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FF4D00]"
            >
              Need clarity?
            </p>
            <h2
              id="faq-heading"
              class="mt-3 font-['EB_Garamond'] text-4xl font-normal leading-tight tracking-[-0.02em] text-[#191613] sm:text-5xl"
            >
              Frequently asked questions
            </h2>

            <div class="mt-10 border-t border-[#191613]/20">
              {
                siteFaqs.map((faq) => (
                  <details class="faq-item group border-b border-[#191613]/20">
                    <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 font-['Geist'] text-[15px] font-medium text-[#25221f] marker:content-none tracking-tight">
                      <span>{faq.question}</span>
                      <svg
                        class="h-4 w-4 shrink-0 text-[#191613]/55 transition-transform duration-200 group-open:rotate-180"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <p class="max-w-[620px] pb-5 pr-10 font-['Geist'] text-[13px] leading-6 text-[#514A44]">
                      {faq.answer}
                    </p>
                  </details>
                ))
              }
            </div>
          </div>

          <div
            class="relative flex min-h-[400px] items-center justify-center overflow-hidden rounded-3xl border border-[#191613]/15 bg-[#fffaf1] px-6 py-20 text-center sm:px-10"
          >
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end gap-1 sm:gap-1.5"
              aria-hidden="true"
            >
              {
                ctaBarHeights.map((height) => (
                  <span
