<script>
  function syncLandingAuthUI() {
    const loggedOutNav = document.getElementById('home-nav-logged-out');
    const loggedInNav = document.getElementById('home-nav-logged-in');
    const ctaAuthBtn = document.getElementById('home-cta-auth-btn') as HTMLAnchorElement | null;
    const adminLink = document.getElementById('home-admin-link');
    const searchParams = new URLSearchParams(window.location.search);
    const isLoginSuccess = searchParams.has('login');
    const isAuth =
      isLoginSuccess ||
      localStorage.getItem('auth_active') === '1' ||
      document.cookie.includes('logged_in=1') ||
      document.documentElement.getAttribute('data-authenticated') === 'true';

    if (isAuth) {
      loggedOutNav?.classList.add('hidden');
      loggedOutNav?.classList.remove('flex');
      loggedInNav?.classList.remove('hidden');
      loggedInNav?.classList.add('flex');

      try {
        const rawUser = localStorage.getItem('auth_user');
        if (rawUser) {
          const user = JSON.parse(rawUser);
          const fullName = (user.name || 'User').trim();
          const email = user.email || 'Aspirant';
          const role = user.role || 'student';
          const parts = fullName.split(/\s+/).filter(Boolean);
          const initials =
            parts.length > 1
              ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
              : fullName.slice(0, 2).toUpperCase() || 'U';

          document.querySelectorAll('.user-display-name').forEach((el) => (el.textContent = fullName));
          document.querySelectorAll('.user-display-email').forEach((el) => (el.textContent = email));
          document.querySelectorAll('.user-avatar-initials').forEach((el) => (el.textContent = initials));
          document.querySelectorAll('.user-display-role').forEach((el) => {
            el.textContent = role === 'admin' ? 'Administrator' : role === 'editor' ? 'Editor' : 'Aspirant';
          });
          document.querySelectorAll('.user-role-badge').forEach((el) => {
            el.textContent = role === 'admin' ? 'Admin' : role === 'editor' ? 'Editor' : 'Aspirant';
          });
          if (adminLink && (role === 'admin' || role === 'editor')) {
            adminLink.classList.remove('hidden');
            adminLink.classList.add('flex');
          }
        }
      } catch (e) {}

      if (ctaAuthBtn) {
        ctaAuthBtn.href = '/profile';
        ctaAuthBtn.textContent = 'My Preparation Hub';
      }
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/login"]').forEach((el) => {
        el.href = '/profile';
        el.textContent = 'My profile';
      });
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/signup"]').forEach((el) => {
        if (el.textContent === 'Create account') {
          el.href = '/test-series';
          el.textContent = 'Test series';
        }
      });
    } else {
      loggedInNav?.classList.add('hidden');
      loggedInNav?.classList.remove('flex');
      loggedOutNav?.classList.remove('hidden');
      loggedOutNav?.classList.add('flex');

      if (ctaAuthBtn) {
        ctaAuthBtn.href = '/signup';
        ctaAuthBtn.textContent = 'Create an account';
      }
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/profile"]').forEach((el) => {
        el.href = '/login';
        el.textContent = 'Log in';
      });
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/test-series"]').forEach((el) => {
        if (el.textContent === 'Test series') {
          el.href = '/signup';
          el.textContent = 'Create account';
        }
      });
    }

    // Sync theme knob on landing dropdown
    const isLight = !document.documentElement.classList.contains('theme-dark');
    document.querySelectorAll('.theme-toggle-knob').forEach((knob) => {
      if (isLight) {
        knob.classList.remove('translate-x-6');
        knob.classList.add('translate-x-0.5');
      } else {
        knob.classList.remove('translate-x-0.5');
        knob.classList.add('translate-x-6');
      }
    });
    document.querySelectorAll('.dark-icon').forEach((icon) => icon.classList.toggle('hidden', isLight));
    document.querySelectorAll('.light-icon').forEach((icon) => icon.classList.toggle('hidden', !isLight));

    // Sync language buttons on landing dropdown
    const currentLang = (localStorage.getItem('preferred_exam_lang') || localStorage.getItem('site_language') || 'hinglish').toLowerCase();
    document.querySelectorAll<HTMLElement>('[data-app-lang]').forEach((btn) => {
      const btnLang = (btn.getAttribute('data-app-lang') || '').toLowerCase();
      const isActive = btnLang === currentLang || (currentLang.startsWith('hi') && btnLang === 'hinglish') || (currentLang.startsWith('en') && btnLang === 'en');
      if (isActive) {
        btn.classList.add('bg-[#FF4D00]', 'text-white', 'shadow-xs');
        btn.classList.remove('text-[#675F58]', 'dark:text-[#A89D92]');
        btn.setAttribute('aria-pressed', 'true');
      } else {
        btn.classList.remove('bg-[#FF4D00]', 'text-white', 'shadow-xs');
        btn.classList.add('text-[#675F58]', 'dark:text-[#A89D92]');
        btn.setAttribute('aria-pressed', 'false');
      }
    });

    // Check for login=success toast
    if (searchParams.has('login')) {
      const toast = document.getElementById('global-toast');
      const toastMsg = document.getElementById('global-toast-msg');
      if (toast && toastMsg) {
        toastMsg.textContent = 'Welcome back! Successfully signed in.';
        toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
        }, 4000);
      }
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('login');
        window.history.replaceState({}, document.title, url.pathname + (url.search || ''));
      } catch (e) {}
    }
  }

  document.addEventListener('astro:page-load', syncLandingAuthUI);
  document.addEventListener('astro:after-swap', syncLandingAuthUI);
  window.addEventListener('auth:change', syncLandingAuthUI);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncLandingAuthUI);
  } else {
    syncLandingAuthUI();
  }
</script>
