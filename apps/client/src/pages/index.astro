---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import ArticleCard from '../components/blog/ArticleCard.astro';
import { Image } from 'astro:assets';
import { examPortals, govPortals, siteFaqs, telegramChannel, whatsappChannel, siteUrl, siteName, siteDomain } from '../data/site';
import {
  appLangToBlogLanguage,
  articleHref,
  preferredLangFromCookieHeader,
} from '../lib/preferred-lang';

const API_URL = import.meta.env.PUBLIC_API_URL.replace(/\/$/, '');
const preferredAppLang = preferredLangFromCookieHeader(Astro.request.headers.get('cookie'));
const listLanguage = appLangToBlogLanguage(preferredAppLang);

// Edge CDN caching: cache for 60s, serve stale up to 300s while revalidating in background
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('Vary', 'Cookie, Accept-Encoding');

let livePosts: any[] = [];
let fetchError: { type: 'network' | 'http' | 'json' | 'empty'; message?: string; status?: number; durationMs: number } | null = null;

const fetchStart = performance.now();
try {
  const res = await fetch(`${API_URL}/blogs?limit=50&language=${listLanguage}&includeImages=false`, {
    signal: AbortSignal.timeout(6000),
  });
  const durationMs = Math.round(performance.now() - fetchStart);

  if (!res.ok) {
    fetchError = { type: 'http', status: res.status, durationMs };
    console.error(`[Index SSR] /blogs?limit=50&language=${listLanguage} failed with HTTP ${res.status} in ${durationMs}ms`);
  } else {
    try {
      const data = await res.json();
      if (Array.isArray(data)) {
        livePosts = data;
        if (data.length === 0) {
          fetchError = { type: 'empty', status: res.status, durationMs };
        }
        console.info(`[Index SSR] /blogs?limit=50&language=${listLanguage} fetched ${data.length} articles in ${durationMs}ms`);
      } else {
        fetchError = { type: 'json', message: 'Payload is not an array', status: res.status, durationMs };
        console.error(`[Index SSR] /blogs?limit=50 invalid JSON structure in ${durationMs}ms`);
      }
    } catch (parseErr: any) {
      fetchError = { type: 'json', message: parseErr?.message, status: res.status, durationMs };
      console.error(`[Index SSR] /blogs?limit=50 JSON parse error: ${parseErr?.message}`);
    }
  }
} catch (netErr: any) {
  const durationMs = Math.round(performance.now() - fetchStart);
  fetchError = { type: 'network', message: netErr?.message, durationMs };
  console.error(`[Index SSR] /blogs?limit=50 network fetch failed in ${durationMs}ms: ${netErr?.message}`);
}

const displayArticles = (livePosts || []).map(p => ({
  title: p.title,
  slugKey: p.slug,
  slug: articleHref(p.slug, preferredAppLang),
  category: p.category?.name || p.categories?.[0]?.name || 'Latest Updates',
  categories: p.categories || (p.category ? [p.category] : []),
  summary: p.description || p.metaDescription || 'Check complete official notification details and direct application links.',
  date: new Date(p.publishedAt || p.updatedAt || Date.now()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
}));

// Exam Categories matching Reference Image 2
const examCategories = [
  {
    name: 'Central Government',
    subtitle: 'UPSC, SSC, Railways and more',
    iconColor: 'text-blue-600 dark:text-blue-400',
    iconBg: 'bg-blue-50 dark:bg-blue-950/60',
    borderColor: 'hover:border-blue-500/40',
    slug: 'central-government',
    icon: 'monument'
  },
  {
    name: 'State Exams',
    subtitle: 'UPPSC, BPSC, MPSC and more',
    iconColor: 'text-orange-600 dark:text-orange-400',
    iconBg: 'bg-orange-50 dark:bg-orange-950/60',
    borderColor: 'hover:border-orange-500/40',
    slug: 'state-exams',
    icon: 'building'
  },
  {
    name: 'Banking',
    subtitle: 'IBPS, SBI, RBI and more',
    iconColor: 'text-purple-600 dark:text-purple-400',
    iconBg: 'bg-purple-50 dark:bg-purple-950/60',
    borderColor: 'hover:border-purple-500/40',
    slug: 'banking',
    icon: 'bank'
  },
  {
    name: 'SSC & Railways',
    subtitle: 'SSC, RRB, RPF and more',
    iconColor: 'text-emerald-600 dark:text-emerald-400',
    iconBg: 'bg-emerald-50 dark:bg-emerald-950/60',
    borderColor: 'hover:border-emerald-500/40',
    slug: 'ssc-railways',
    icon: 'train'
  },
  {
    name: 'Teaching',
    subtitle: 'CTET, UPTET and more',
    iconColor: 'text-rose-600 dark:text-rose-400',
    iconBg: 'bg-rose-50 dark:bg-rose-950/60',
    borderColor: 'hover:border-rose-500/40',
    slug: 'teaching',
    icon: 'book'
  },
  {
    name: 'Defence',
    subtitle: 'NDA, CDS, AFCAT and more',
    iconColor: 'text-blue-700 dark:text-blue-400',
    iconBg: 'bg-blue-50 dark:bg-blue-950/60',
    borderColor: 'hover:border-blue-500/40',
    slug: 'defence',
    icon: 'shield'
  }
];

// Important Portals matching Reference Right Sidebar
const R2_PORTAL_BASE = 'https://pub-68568854a58845bc975b176de76b1ad5.r2.dev/portals';

const rightPortals = [
  {
    name: 'UPSC',
    url: 'upsc.gov.in',
    href: 'https://www.upsc.gov.in/',
    logo: `${R2_PORTAL_BASE}/upsc.svg`,
    initial: 'U',
    bg: 'bg-[#0C2340]',
    textColor: 'text-[#E2B13C]'
  },
  {
    name: 'SSC',
    url: 'ssc.gov.in',
    href: 'https://ssc.gov.in/',
    logo: `${R2_PORTAL_BASE}/ssc.svg`,
    initial: 'S',
    bg: 'bg-[#8B0000]',
    textColor: 'text-[#FFD700]'
  },
  {
    name: 'Railways',
    url: 'rrb.indianrailways.gov.in',
    href: 'https://rrb.indianrailways.gov.in/',
    logo: `${R2_PORTAL_BASE}/railways.svg`,
    initial: 'R',
    bg: 'bg-[#003366]',
    textColor: 'text-[#E5A823]'
  },
  {
    name: 'UPPSC',
    url: 'uppsc.up.nic.in',
    href: 'https://uppsc.up.nic.in/',
    logo: `${R2_PORTAL_BASE}/uppsc.svg`,
    initial: 'UP',
    bg: 'bg-[#14532D]',
    textColor: 'text-[#FEF08A]'
  },
  {
    name: 'SBI',
    url: 'sbi.co.in',
    href: 'https://sbi.co.in/web/careers',
    logo: `${R2_PORTAL_BASE}/sbi.svg`,
    initial: 'SBI',
    bg: 'bg-[#0080C7]',
    textColor: 'text-white'
  },
  {
    name: 'IBPS',
    url: 'ibps.in',
    href: 'https://www.ibps.in/',
    logo: `${R2_PORTAL_BASE}/ibps.svg`,
    initial: 'I',
    bg: 'bg-[#312E81]',
    textColor: 'text-[#F59E0B]'
  }
];

// Popular this week items derived from live posts
const popularUpdates = displayArticles.slice(0, 5).map((item, idx) => ({
  rank: idx + 1,
  title: item.title,
  href: item.slug,
  slugKey: item.slugKey,
}));

const pageTitle = `${siteName} | Sarkari Jobs, Exam Notifications & Results`;
const pageDescription = `${siteName} (${siteDomain}) provides latest government exam notifications, Sarkari job alerts, admit cards, answer keys, and results.`;
const canonicalUrl = `${siteUrl}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: siteName,
      alternateName: [siteName, siteDomain, `${siteName} Exam Updates`],
      url: canonicalUrl,
      description: pageDescription,
      inLanguage: ['en-IN', 'hi-Latn'],
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteUrl}/?search={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: siteName,
      alternateName: [siteName, siteDomain],
      url: canonicalUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/logo.png`,
        width: 512,
        height: 512,
        caption: `${siteName} Logo`,
      },
      image: `${siteUrl}/og-image.jpg`,
      sameAs: [whatsappChannel, telegramChannel].filter(Boolean),
      description: 'Verified government exam notifications, Sarkari job updates, admit cards, answer keys, and counselling results portal across India.',
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: siteFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={`${siteUrl}/og-image.jpg`}
  ogType="website"
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white px-4 sm:px-6 lg:px-8 py-7 transition-colors duration-200">
    <div class="max-w-[1400px] mx-auto">
      
      {/* 2-Column Grid: Main Feed (Left) + Right Sidebar (Portals & Popular) */}
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_310px] xl:grid-cols-[minmax(0,1fr)_330px] gap-8 items-start">
        
        {/* MAIN FEED CONTENT */}
        <div class="min-w-0 space-y-7" transition:name="main-content">
          
          {/* 1. Main Headline */}
          <div transition:name="page-hero">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent text-xs font-semibold mb-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              Verified Government Exam &amp; Sarkari Naukri Portal
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-[2.25rem] font-bold text-white tracking-tight font-serif leading-tight">
              {siteName} | Government Exam Updates &amp; Sarkari Jobs
            </h1>
            <p class="mt-2 text-sm sm:text-base text-muted max-w-3xl leading-relaxed">
              {siteName} ({siteDomain}) provides verified central &amp; state government exam notifications, admit cards, answer keys, syllabi, and direct official commission portal links across India.
            </p>
          </div>



          {/* 3. Browse by Category */}
          <section id="categories" class="space-y-3.5">
            <div class="flex items-center justify-between">
              <h2 class="text-base sm:text-lg font-bold text-white">
                Browse by category
              </h2>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3">
              {examCategories.map((cat) => (
                <a 
                  href={`/category/${cat.slug}`}
                  class={`flex flex-col justify-between p-3.5 bg-surface rounded-lg border border-border hover:shadow-xs ${cat.borderColor} transition duration-150 group cursor-pointer`}
                >
                  <div class="flex items-start justify-between">
                    <div class={`w-7 h-7 rounded-md ${cat.iconBg} ${cat.iconColor} flex items-center justify-center shrink-0`}>
                      {cat.icon === 'monument' && (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 14v5m4-5v5m4-5v5M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                        </svg>
                      )}
                      {cat.icon === 'building' && (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                      )}
                      {cat.icon === 'bank' && (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l9-4 9 4v2H3V6zm2 4h2v8H5v-8zm6 0h2v8h-2v-8zm6 0h2v8h-2v-8zM2 20h20v2H2v-2z" />
                        </svg>
                      )}
                      {cat.icon === 'train' && (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <rect x="4" y="3" width="16" height="14" rx="3" stroke-width="2"/>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h16M8 14h.01M16 14h.01M7 21l2-4m8 4l-2-4" />
                        </svg>
                      )}
                      {cat.icon === 'book' && (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                      )}
                      {cat.icon === 'shield' && (
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                      )}
                    </div>
                    <svg class="w-3.5 h-3.5 text-muted group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                  <div class="mt-4">
                    <h3 class="text-xs font-bold text-white leading-tight">
                      {cat.name}
                    </h3>
                    <p class="mt-1 text-[11px] text-muted leading-tight line-clamp-2">
                      {cat.subtitle}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>



          {/* 5. Latest Updates — all articles, independent of category navigation */}
          <section id="latest-updates" class="space-y-3.5">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-white">
                  All Latest Articles
                </h2>
                <p class="mt-0.5 text-xs text-muted">Newest posts across every category</p>
              </div>
            </div>

            <div class="space-y-3">
              {displayArticles.length > 0 ? (
                displayArticles.map((article) => (
                  <ArticleCard
                    variant="standard"
                    title={article.title}
                    slug={article.slugKey}
                    href={article.slug}
                    category={article.category}
                    categories={article.categories}
                    date={article.date}
                    summary={article.summary}
                    headingLevel="h3"
                  />
                ))
              ) : fetchError && fetchError.type !== 'empty' ? (
                <div class="p-8 text-center bg-surface border border-border/80 rounded-lg space-y-2">
                  <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-amber-500/10 text-amber-500 mb-1">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                  </div>
                  <h3 class="text-sm font-semibold text-white">Temporarily unable to load latest updates</h3>
                  <p class="text-xs text-muted max-w-md mx-auto">
                    We are experiencing a temporary connection issue. Please refresh the page or check our Telegram/WhatsApp channels for immediate notices.
                  </p>
                </div>
              ) : (
                <div class="p-8 text-center bg-surface border border-border rounded-lg">
                  <p class="text-sm text-muted">No updates published yet. Please check back soon.</p>
                </div>
              )}
            </div>
          </section>

          {/* 6. FAQ Accordion Section */}
          <div id="faqs" class="pt-4">
            <FAQSection faqs={siteFaqs} />
          </div>

        </div>

        {/* RIGHT SIDEBAR (Important Portals + Popular this week) - Sticky to viewport */}
        <aside class="space-y-6 hidden lg:block sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto scrollbar-none">
          
          {/* Important Portals Box */}
          <div id="important-links" class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3.5 transition-colors">
            <div class="flex items-center justify-between pb-1 border-b border-border/50">
              <h3 class="text-sm font-bold text-white">
                Important portals
              </h3>
            </div>

            <div class="divide-y divide-border/50">
              {rightPortals.map((portal) => (
                <a 
                  href={portal.href} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex items-center justify-between py-2.5 px-1 hover:bg-surface-raised rounded transition group cursor-pointer"
                  title={`Open official ${portal.name} portal`}
                  aria-label={`Open official ${portal.name} portal (opens in new tab)`}
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8 h-8 rounded-full bg-surface-raised border border-border flex items-center justify-center p-1 shrink-0 overflow-hidden relative">
                      <Image 
                        src={portal.logo} 
                        alt={`${portal.name} official emblem logo`} 
                        class="w-full h-full object-contain" 
                        loading="eager"
                        decoding="async"
                        width={32}
                        height={32}
                        onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                      />
                      <div class={`w-full h-full rounded-full ${portal.bg} ${portal.textColor} hidden items-center justify-center font-bold text-[10px] select-none tracking-tight`}>
                        {portal.initial}
                      </div>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-white group-hover:text-accent transition truncate leading-tight">
                        {portal.name}
                      </p>
                      <p class="text-[11px] text-muted truncate leading-tight mt-0.5">
                        {portal.url}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          {/* Popular This Week Box */}
          {popularUpdates.length > 0 && (
            <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3.5 transition-colors">
              <div class="flex items-center gap-2 pb-1 border-b border-border/50">
                <span class="text-[#EF4444]">🔥</span>
                <h3 class="text-sm font-bold text-white">
                  Popular this week
                </h3>
              </div>

              <div class="space-y-2.5">
                {popularUpdates.map((item) => (
                  <a 
                    href={item.href} 
                    data-article-link={item.slugKey}
                    class="flex items-center gap-3 p-1.5 rounded hover:bg-surface-raised transition group cursor-pointer"
                  >
                    <span class="w-5 h-5 rounded-full bg-surface-raised text-muted group-hover:bg-accent/15 group-hover:text-accent flex items-center justify-center text-[10px] font-bold shrink-0 transition">
                      {item.rank}
                    </span>
                    <p class="text-xs font-medium text-white/90 group-hover:text-accent transition leading-snug truncate" data-article-title>
                      {item.title}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )}

        </aside>

      </div>
    </div>
  </div>

  {/* Cache top articles for instant 0ms access when opening article pages */}
  <script is:inline define:vars={{ cachedPosts: (livePosts || []).slice(0, 10).map((p: any) => ({
    slug: p.slug,
    title: p.title,
    description: p.description || p.metaDescription || '',
    publishedAt: p.publishedAt,
    category: p.category ? { name: p.category.name, slug: p.category.slug } : null,
  })), cacheLang: listLanguage }}>
    try {
      if (Array.isArray(cachedPosts) && cachedPosts.length > 0) {
        sessionStorage.setItem('recent_posts_' + cacheLang, JSON.stringify(cachedPosts));
      }
    } catch (e) {}
  </script>
</Layout>
