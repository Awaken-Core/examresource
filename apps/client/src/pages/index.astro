  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .social-link {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.1);
    color: rgb(255 255 255 / 0.72);
    transition:
      color 150ms,
      background-color 150ms;
  }
  .social-link:hover {
    color: white;
  }
  .social-link:focus-visible {
    outline-width: 2px;
    outline-style: solid;
    outline-offset: 2px;
  }
</style>

<script>
  import { API_URL } from '../lib/api';
  import { initLenis, destroyLenis } from '../lib/lenis';

  function initHomeAuth() {
    const loggedOutNav = document.getElementById('home-nav-logged-out');
    const loggedInNav = document.getElementById('home-nav-logged-in');
    const profileTrigger = document.getElementById('home-profile-trigger');
    const profileDropdown = document.getElementById('home-profile-dropdown');
    const logoutBtn = document.getElementById('home-logout-btn');
    const adminLink = document.getElementById('home-admin-link');
    const ctaAuthBtn = document.getElementById('home-cta-auth-btn') as HTMLAnchorElement | null;
    const toast = document.getElementById('home-login-toast');
    const toastClose = document.getElementById('home-toast-close');
    const toastWelcome = document.getElementById('home-toast-welcome-msg');

    const searchParams = new URLSearchParams(window.location.search);
    const isLoginSuccess = searchParams.has('login');

    if (isLoginSuccess) {
      try {
        localStorage.setItem('auth_active', '1');
      } catch (e) {}
    }

    const cachedAuth = (function () {
      try {
        return localStorage.getItem('auth_active') === '1' || document.cookie.includes('logged_in=1');
      } catch (e) {
        return false;
      }
    })();

    // Fast optimistic UI update if cached or fresh login success
    if (cachedAuth || isLoginSuccess) {
      loggedOutNav?.classList.add('hidden');
      loggedOutNav?.classList.remove('flex');
      loggedInNav?.classList.remove('hidden');
      loggedInNav?.classList.add('flex');
      if (ctaAuthBtn) {
        ctaAuthBtn.href = '/profile';
        ctaAuthBtn.textContent = 'My Preparation Hub';
      }
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/login"]').forEach((el) => {
        el.href = '/profile';
        el.textContent = 'My profile';
      });
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/signup"]').forEach((el) => {
        el.href = '/test-series';
        el.textContent = 'Test series';
      });

      // Instantly restore cached user initials and name to avoid guest flash
      try {
        const rawUser = localStorage.getItem('auth_user');
        if (rawUser) {
          const u = JSON.parse(rawUser);
          const fullName = (u.name || 'User').trim();
          const email = u.email || 'Aspirant';
          const role = u.role || 'student';
          const parts = fullName.split(/\s+/).filter(Boolean);
          const initials =
            parts.length > 1
              ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
              : fullName.slice(0, 2).toUpperCase() || 'U';

          document.querySelectorAll('.user-display-name').forEach((el) => (el.textContent = fullName));
          document.querySelectorAll('.user-display-email').forEach((el) => (el.textContent = email));
          document.querySelectorAll('.user-avatar-initials').forEach((el) => (el.textContent = initials));
          document.querySelectorAll('.user-display-role').forEach((el) => {
            el.textContent = role === 'admin' ? 'Administrator' : role === 'editor' ? 'Editor' : 'Aspirant';
          });
          document.querySelectorAll('.user-role-badge').forEach((el) => {
            el.textContent = role === 'admin' ? 'Admin' : role === 'editor' ? 'Editor' : 'Aspirant';
          });
          if (adminLink && (role === 'admin' || role === 'editor')) {
            adminLink.classList.remove('hidden');
            adminLink.classList.add('flex');
          }
        }
      } catch (e) {}
    }

    // Toggle dropdown
    function closeDropdown() {
      if (!profileDropdown || !profileTrigger) return;
      profileDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
      profileDropdown.classList.remove('scale-100', 'opacity-100');
      profileTrigger.setAttribute('aria-expanded', 'false');
    }

    function openDropdown() {
      if (!profileDropdown || !profileTrigger) return;
      profileDropdown.classList.remove('hidden');
      requestAnimationFrame(() => {
        profileDropdown.classList.remove('scale-95', 'opacity-0');
        profileDropdown.classList.add('scale-100', 'opacity-100');
      });
      profileTrigger.setAttribute('aria-expanded', 'true');
    }

    if (profileTrigger && !profileTrigger.dataset.dropdownBound) {
      profileTrigger.dataset.dropdownBound = 'true';
      profileTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = profileTrigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeDropdown();
        } else {
          openDropdown();
        }
      });
    }

    // Close dropdown immediately when any link inside it is clicked
    profileDropdown?.querySelectorAll('a').forEach((link) => {
      if (!link.dataset.closeBound) {
        link.dataset.closeBound = 'true';
        link.addEventListener('click', () => {
          closeDropdown();
        });
      }
    });

    if (!(window as any).__homeAuthDocBound) {
      (window as any).__homeAuthDocBound = true;
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest('#home-profile-dropdown') && !target.closest('#home-profile-trigger')) {
          const currentDropdown = document.getElementById('home-profile-dropdown');
          const currentTrigger = document.getElementById('home-profile-trigger');
          if (currentDropdown && currentTrigger) {
            currentDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            currentDropdown.classList.remove('scale-100', 'opacity-100');
            currentTrigger.setAttribute('aria-expanded', 'false');
          }
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const currentDropdown = document.getElementById('home-profile-dropdown');
          const currentTrigger = document.getElementById('home-profile-trigger');
          if (currentDropdown && currentTrigger) {
            currentDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            currentDropdown.classList.remove('scale-100', 'opacity-100');
            currentTrigger.setAttribute('aria-expanded', 'false');
          }
        }
      });
    }

    // Logout handling
    if (logoutBtn && !logoutBtn.dataset.bound) {
      logoutBtn.dataset.bound = 'true';
      logoutBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          localStorage.removeItem('auth_active');
        } catch (err) {}
        closeDropdown();
        await fetch(`${API_URL}/auth/logout`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'X-CSRF-Protection': '1' },
        } as any).catch(() => null);

      // Revert UI to logged-out
      loggedInNav?.classList.add('hidden');
      loggedInNav?.classList.remove('flex');
      loggedOutNav?.classList.remove('hidden');
      loggedOutNav?.classList.add('flex');
      if (ctaAuthBtn) {
        ctaAuthBtn.href = '/signup';
        ctaAuthBtn.textContent = 'Create an account';
      }
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/profile"]').forEach((el) => {
        el.href = '/login';
        el.textContent = 'Log in';
      });
      document.querySelectorAll<HTMLAnchorElement>('footer a[href="/test-series"]').forEach((el) => {
        if (el.textContent === 'Test series') {
          el.href = '/signup';
          el.textContent = 'Create account';
        }
      });
    });
  }

    // Fetch user profile from /me
    // Only a definitive HTTP 401 proves the session has expired.
    // 5xx, CORS failures, or network errors must NOT wipe auth_active to
    // prevent the "logout flash" when the sidebar logo navigates back to Home.
    fetch(`${API_URL}/me`, { priority: 'high', credentials: 'include' } as any)
      .then(async (res) => {
        // If server failed or network blip, never wipe optimistic state
        if (!res || res.status >= 500) return;

        if (res.status === 401) {
          try {
            localStorage.removeItem('auth_active');
            localStorage.removeItem('auth_user');
          } catch (e) {}
          loggedInNav?.classList.add('hidden');
          loggedInNav?.classList.remove('flex');
          loggedOutNav?.classList.remove('hidden');
          loggedOutNav?.classList.add('flex');
          if (ctaAuthBtn) {
            ctaAuthBtn.href = '/signup';
            ctaAuthBtn.textContent = 'Create an account';
          }
          return;
        }

        const user = res.ok ? await res.json().catch(() => null) : null;
        if (user && user.id) {
          try {
            localStorage.setItem('auth_active', '1');
            localStorage.setItem('auth_user', JSON.stringify({
              id: user.id,
              name: user.name,
              email: user.email,
              role: user.role,
            }));
          } catch (e) {}

          const fullName = (user.name || 'User').trim();
          const email = user.email || 'Aspirant';
          const role = user.role || 'student';
          const parts = fullName.split(/\s+/).filter(Boolean);
          const initials =
            parts.length > 1
              ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
              : fullName.slice(0, 2).toUpperCase() || 'U';

          // Update avatar & text
          document.querySelectorAll('.user-display-name').forEach((el) => (el.textContent = fullName));
          document.querySelectorAll('.user-display-email').forEach((el) => (el.textContent = email));
          document.querySelectorAll('.user-avatar-initials').forEach((el) => (el.textContent = initials));
          document.querySelectorAll('.user-display-role').forEach((el) => {
            el.textContent = role === 'admin' ? 'Administrator' : role === 'editor' ? 'Editor' : 'Aspirant';
          });
          document.querySelectorAll('.user-role-badge').forEach((el) => {
            el.textContent = role === 'admin' ? 'Admin' : role === 'editor' ? 'Editor' : 'Aspirant';
          });

          // Show admin link if role permitted
          if (adminLink && (role === 'admin' || role === 'editor')) {
            adminLink.classList.remove('hidden');
            adminLink.classList.add('flex');
          }

          // Show logged-in UI, hide logged-out UI
          loggedOutNav?.classList.add('hidden');
          loggedOutNav?.classList.remove('flex');
          loggedInNav?.classList.remove('hidden');
          loggedInNav?.classList.add('flex');

          if (ctaAuthBtn) {
            ctaAuthBtn.href = '/profile';
            ctaAuthBtn.textContent = 'My Preparation Hub';
          }
          document.querySelectorAll<HTMLAnchorElement>('footer a[href="/login"]').forEach((el) => {
            el.href = '/profile';
            el.textContent = 'My profile';
          });
          document.querySelectorAll<HTMLAnchorElement>('footer a[href="/signup"]').forEach((el) => {
            el.href = '/test-series';
            el.textContent = 'Test series';
          });

          // Show Toast if login=success
          if (isLoginSuccess && toast) {
            if (toastWelcome) {
              toastWelcome.textContent = `Welcome back, ${fullName}!`;
            }
            toast.classList.remove('-translate-y-4', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            // Clean query parameter from URL without reloading
            try {
              const url = new URL(window.location.href);
              url.searchParams.delete('login');
              window.history.replaceState({}, document.title, url.pathname + (url.search || ''));
            } catch (err) {}

            const hideTimer = setTimeout(() => {
              toast.classList.add('-translate-y-4', 'opacity-0');
              toast.classList.remove('translate-y-0', 'opacity-100');
            }, 4500);

            toastClose?.addEventListener(
              'click',
              () => {
                clearTimeout(hideTimer);
                toast.classList.add('-translate-y-4', 'opacity-0');
                toast.classList.remove('translate-y-0', 'opacity-100');
              },
              { once: true },
            );
          }
        } else if (res.ok && !user) {
          // Explicit unauthenticated session from server
          try {
            localStorage.removeItem('auth_active');
            localStorage.removeItem('auth_user');
          } catch (e) {}
          loggedInNav?.classList.add('hidden');
          loggedInNav?.classList.remove('flex');
          loggedOutNav?.classList.remove('hidden');
          loggedOutNav?.classList.add('flex');
          if (ctaAuthBtn) {
            ctaAuthBtn.href = '/signup';
            ctaAuthBtn.textContent = 'Create an account';
          }
        }
      })
      .catch(() => {
        // Network error — never reset login state. The session may still be valid.
      });
  }

  function setupSmoothScroll() {
    initLenis({ headerOffset: -80 });
  }

  // Support both normal load and client transitions
  document.addEventListener('astro:after-swap', () => {
    initHomeAuth();
  });
  document.addEventListener('astro:page-load', () => {
    initHomeAuth();
    setupSmoothScroll();
  });
  document.addEventListener('astro:before-swap', destroyLenis);

  // Fallback if client router is ever bypassed or DOM is already ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initHomeAuth();
      setupSmoothScroll();
    });
  } else {
    initHomeAuth();
    setupSmoothScroll();
  }
</script>
