                  loading="lazy"
                  decoding="async"
                  width={32}
                  height={32}
                  onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                />
                <div class={`w-full h-full rounded-full ${portal.bg} ${portal.text} hidden items-center justify-center font-bold text-xs select-none`}>
                  {portal.initial}
