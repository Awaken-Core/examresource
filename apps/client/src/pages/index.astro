---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import videoBg from '../assets/video-bg.png';
import BrandLogo from '../components/BrandLogo.astro';
import { Avatar, Style } from '@dicebear/core';
import lorelei from '@dicebear/styles/lorelei.json' with { type: 'json' };
import {
  contactEmail,
  examPortals,
  siteDomain,
  siteFaqs,
  siteName,
  siteSlogan,
  telegramChannel,
  whatsappChannel,
} from '../data/site';

const avatarStyle = new Style(lorelei);
const studentPerspectives = [
  {
    title: 'Find deadlines faster',
    body: 'Clear dates, concise summaries, and direct official links make important updates easier to act on.',
    seed: 'exam-planner',
  },
  {
    title: 'Prepare in one place',
    body: 'Exam streams and focused resources keep preparation organised without jumping between scattered sources.',
    seed: 'focused-learner',
  },
  {
    title: 'Verify before applying',
    body: 'Every guide points back to the relevant official portal so critical details can be checked confidently.',
    seed: 'careful-candidate',
  },
].map((item) => ({
  ...item,
  avatar: new Avatar(avatarStyle, {
    seed: item.seed,
    size: 96,
    borderRadius: 50,
    backgroundColor: ['#FFE1D3', '#F1E7DB', '#FFD0BA'],
  }).toDataUri(),
}));

const groups = [
  {
    title: 'Explore',
    links: [
      ['Exam updates', '/blogs'],
      ['Latest notifications', '/blogs#latest-updates'],
      ['Exam categories', '/blogs#categories'],
      ['Test series', '/test-series'],
      ['Bookmarks', '/bookmarks'],
      ['Favorites', '/favorites'],
      ['Notifications', '/notifications'],
    ],
  },
  {
    title: 'Exam streams',
    links: [
      ['Central Govt & UPSC', '/category/central-government'],
      ['SSC exams', '/category/ssc'],
      ['Railway exams', '/category/railways'],
      ['Banking exams', '/category/banking'],
      ['Latest govt jobs', '/category/latest-jobs'],
      ['Defence exams', '/category/defence'],
      ['Police recruitment', '/category/police'],
      ['Teaching exams', '/category/teaching'],
      ['PSU & engineering', '/category/psu-engineering'],
    ],
  },
  { title: 'Resources', links: examPortals.slice(0, 9).map(({ name, href }) => [name, href]) },
  {
    title: 'Company',
    links: [
      ['About our portal', '/blogs#faqs'],
      ['Contact us', '/contact-us'],
      ['Privacy policy', '/privacy-policy'],
      ['Terms of service', '/terms-of-service'],
      ['Sitemap', '/sitemap'],
      ['RSS feed', '/rss.xml'],
      ['Log in', '/login'],
      ['Create account', '/signup'],
    ],
  },
];

const ctaBarHeights = [
  190, 170, 150, 132, 114, 98, 82, 68, 56, 46, 38, 32, 32, 38, 46, 56, 68, 82, 98, 114, 132, 150,
  170, 190,
];
---

<!doctype html>
<html lang="en" class="theme-dark bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta
      name="description"
      content={`${siteName} links, exam resources, official portals, policies, and community channels.`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteName} — Explore exam resources</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-black text-white antialiased">
    <main class="min-h-screen">
      <section
        class="overflow-hidden border-t border-[#191613]/15 bg-[#FFF8F1] text-[#191613]"
        aria-labelledby="landing-heading"
      >
        <nav
          class="mx-auto flex h-18 max-w-[1180px] items-center justify-between px-5 sm:px-8"
          aria-label="Landing navigation"
        >
          <a
            href="/"
            class="flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-3"
            aria-label={`${siteName} home`}
          >
            <BrandLogo size={34} />
            <span class="font-['EB_Garamond'] text-[24px] leading-none font-medium tracking-tight text-[#191613]"
              >{siteName}</span
            >
          </a>
          <div
            class="hidden items-center gap-7 font-['Geist'] text-[12px] font-medium text-[#514A44] md:flex"
          >
            <a href="/blogs" data-astro-prefetch="hover" class="transition-colors hover:text-[#FF4D00]">Blogs</a>
            <a href="/test-series" data-astro-prefetch="hover" class="transition-colors hover:text-[#FF4D00]">Live tests</a>
            <a href="/test-series" data-astro-prefetch="hover" class="transition-colors hover:text-[#FF4D00]">Quizzes</a>
          </div>
          <div class="flex items-center gap-2.5">
            {/* Logged-out navbar actions */}
            <div id="home-nav-logged-out" class="flex items-center gap-2.5">
              <a
                href="/login"
                data-astro-prefetch="hover"
                class="min-h-10 inline-flex items-center px-3 font-['Geist'] text-[12px] font-semibold text-[#514A44] transition-colors hover:text-[#191613]"
                >Log in</a
              >
              <a
                href="/blogs"
                data-astro-prefetch="hover"
                class="inline-flex min-h-10 items-center rounded-full bg-[#FF4D00] px-4 font-['Geist'] text-[12px] font-semibold text-white transition-colors hover:bg-[#D94100] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-2"
                >Explore blogs</a
              >
            </div>

            {/* Logged-in profile trigger & dropdown */}
            <div id="home-nav-logged-in" class="hidden items-center gap-2.5 relative">
              <a
                href="/blogs"
                data-astro-prefetch="hover"
                class="hidden sm:inline-flex min-h-9 items-center rounded-full border border-[#191613]/15 bg-white px-3.5 font-['Geist'] text-[11px] font-semibold text-[#514A44] transition-colors hover:border-[#FF4D00]/40 hover:text-[#191613] shadow-2xs"
                >Blogs</a
              >
              <div class="relative">
                <button
                  id="home-profile-trigger"
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="menu"
                  aria-label="Open user profile menu"
                  class="group flex items-center gap-2 rounded-full border border-[#191613]/15 bg-white pl-1 pr-2.5 sm:pr-3 py-1 shadow-xs hover:border-[#FF4D00]/50 hover:shadow-sm transition-all duration-150 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#FF4D00]/30 select-none"
                >
                  <span
                    class="user-avatar-initials size-8 rounded-full bg-gradient-to-br from-[#FF6A00] to-[#FF4D00] text-white font-bold flex items-center justify-center text-[11px] uppercase shadow-xs shrink-0 select-none"
                    >U</span
                  >
                  <div class="hidden sm:flex flex-col text-left leading-none">
                    <span class="user-display-name font-['Geist'] text-[12px] font-bold text-[#191613] max-w-[110px] truncate"
                      >User</span
                    >
                    <span class="user-display-role font-['Geist'] text-[10px] text-[#675F58] capitalize mt-0.5"
                      >Aspirant</span
                    >
                  </div>
                  <svg
                    class="size-3.5 text-[#514A44] transition-transform duration-200 group-aria-expanded:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                      clip-rule="evenodd"></path>
                  </svg>
                </button>

                {/* Profile Dropdown */}
                <div
                  id="home-profile-dropdown"
                  role="menu"
                  aria-orientation="vertical"
                  class="hidden absolute right-0 top-full mt-2 w-72 rounded-2xl border border-[#191613]/15 bg-white p-2.5 shadow-[0_16px_40px_rgba(25,22,19,0.16)] z-[9999] transition-all duration-150 transform scale-95 opacity-0 select-none"
                >
                  {/* User Profile Header Card (Clickable to open profile) */}
                  <a
                    href="/profile"
                    data-astro-prefetch="hover"
                    class="group/card flex items-center gap-3 p-2.5 rounded-xl bg-[#FFF8F1] border border-[#FF4D00]/15 mb-2 hover:bg-[#FFEBD4] hover:border-[#FF4D00]/30 transition-colors cursor-pointer select-none"
                    title="View My Profile"
                  >
                    <div
                      class="user-avatar-initials size-10 rounded-full bg-gradient-to-br from-[#FF6A00] to-[#FF4D00] text-white font-bold flex items-center justify-center text-[13px] uppercase shadow-xs shrink-0 group-hover/card:scale-105 transition-transform"
                    >
                      U
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-1.5">
                        <p class="user-display-name font-['Geist'] text-[13px] font-bold text-[#191613] truncate group-hover/card:text-[#FF4D00] transition-colors">
                          User
                        </p>
                        <span
                          class="user-role-badge inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-[#FF4D00]/10 text-[#FF4D00]"
                          >Aspirant</span
                        >
                      </div>
                      <p class="user-display-email font-['Geist'] text-[11px] text-[#675F58] truncate">
                        user@example.com
                      </p>
                    </div>
                    <svg class="size-4 shrink-0 text-[#675F58] group-hover/card:text-[#FF4D00] group-hover/card:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>

                  {/* Options */}
                  <div class="space-y-0.5 font-['Geist'] text-[12px]">
                    <a
                      href="/profile"
                      data-astro-prefetch="hover"
                      role="menuitem"
                      class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] hover:bg-[#FFF8F1] hover:text-[#FF4D00] transition-colors"
                    >
                      <svg class="size-4 shrink-0 text-[#675F58]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                      </svg>
                      <span class="font-medium">My Profile</span>
                    </a>

                    <a
                      href="/test-series"
                      data-astro-prefetch="hover"
                      role="menuitem"
                      class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] hover:bg-[#FFF8F1] hover:text-[#FF4D00] transition-colors"
                    >
                      <svg class="size-4 shrink-0 text-[#675F58]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <span class="font-medium">Live Tests & Mock Series</span>
                    </a>

                    <a
                      href="/favorites"
                      data-astro-prefetch="hover"
                      role="menuitem"
                      class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] hover:bg-[#FFF8F1] hover:text-[#FF4D00] transition-colors"
                    >
                      <svg class="size-4 shrink-0 text-[#675F58]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                      </svg>
                      <span class="font-medium">Saved Bookmarks</span>
                    </a>

                    <a
                      href="/notifications"
                      role="menuitem"
                      class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] hover:bg-[#FFF8F1] hover:text-[#FF4D00] transition-colors"
                    >
                      <svg class="size-4 shrink-0 text-[#675F58]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                      </svg>
                      <span class="font-medium">Notifications</span>
                    </a>

                    <a
                      id="home-admin-link"
                      href="/administrator"
                      role="menuitem"
                      class="hidden w-full items-center gap-2.5 rounded-xl px-3 py-2 text-[#191613] hover:bg-[#FFF8F1] hover:text-[#FF4D00] transition-colors"
                    >
                      <svg class="size-4 shrink-0 text-[#675F58]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 4.55-2.99 7.9-7 9-4.01-1.1-7-4.45-7-9V7l7-4z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12l1.5 1.5 3.5-3.5"></path>
                      </svg>
                      <span class="font-medium">Open Admin Desk</span>
                    </a>

                    <div class="my-1 border-t border-[#191613]/10"></div>

                    <button
                      type="button"
                      id="home-logout-btn"
                      role="menuitem"
                      class="flex w-full items-center gap-2.5 rounded-xl px-3 py-2 text-left font-medium text-red-600 hover:bg-red-50 transition-colors cursor-pointer"
                    >
                      <svg class="size-4 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                      </svg>
                      <span>Log out</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </nav>

        <div class="mx-auto max-w-[1180px] px-5 pb-0 pt-20 text-center sm:px-8">
          <p
            class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.18em] text-[#FF4D00]"
          >
            Government exam preparation, simplified
          </p>
          <h1
            id="landing-heading"
            class="mx-auto mt-5 max-w-[920px] font-['EB_Garamond'] text-[clamp(3.25rem,5vw,6.5rem)] font-normal leading-[0.92] tracking-[-0.045em] text-[#191613]"
          >
            Prepare smarter.<br />Perform with confidence.
          </h1>
          <p
            class="mx-auto mt-7 max-w-[650px] font-['Geist'] text-[14px] leading-7 text-[#675F58] sm:text-[16px]"
          >
            Verified exam updates, focused quizzes, and live tests—brought together to keep your
            preparation clear and measurable.
          </p>
          <div class="mt-8 flex justify-center">
            <a
              href="/test-series"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#FF4D00] px-7 font-['Geist'] text-[13px] font-semibold text-white transition-colors hover:bg-[#D94100] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-3"
            >
              Explore tests
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
                ></path></svg
              >
            </a>
          </div>

          <div class="relative mx-auto mb-8 mt-16 max-w-[1080px] translate-y-px text-left sm:mt-20">
            <div
              class="relative rounded-[20px] border border-black/80 bg-[#111111] p-[7px] sm:p-[9px]"
            >
              <div class="relative aspect-[16/10] overflow-hidden rounded-[13px] bg-[#111111]">
                <Image
                  src={videoBg}
                  alt="GovtPariksha platform preview"
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover object-center"
                />
                <span
                  class="absolute left-1/2 top-0 h-[15px] w-[74px] -translate-x-1/2 rounded-b-[9px] bg-[#111111] sm:h-[18px] sm:w-[98px]"
                  aria-hidden="true"></span>
                <div
                  class="absolute bottom-2 left-1/2 flex -translate-x-1/2 items-end gap-1 rounded-[12px] border border-white/35 bg-white/45 p-1.5 shadow-[0_8px_24px_rgba(0,0,0,0.18)] backdrop-blur-xl sm:bottom-4 sm:gap-1.5 sm:rounded-[18px] sm:p-2"
                  aria-hidden="true"
                >
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-white/90 sm:size-10 sm:rounded-[10px]"
                  >
                    <span class="grid grid-cols-3 gap-[2px] sm:gap-[3px]">
                      <i class="size-[4px] rounded-[1px] bg-[#77DF2F] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FFD21E] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF8A00] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#DC3C72] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#5E6F75] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF4E62] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#804CD9] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#385CE5] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#55C9AA] sm:size-[6px]"></i>
                    </span>
                  </span>
                  <span
                    class="relative grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#5AE5FF] to-[#1976F3] text-white sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[72%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="1.5"
                      ></circle><path d="m18.2 13.8-7 7 2.6-9.6 9-2-4.6 4.6Z" fill="white"
                      ></path><path d="m13.8 18.2 7-7-2.6 9.6-9 2 4.6-4.6Z" fill="#FF4D4D"
                      ></path></svg
                    >
                    <i
                      class="absolute -bottom-1 h-0.5 w-0.5 rounded-full bg-black/70 sm:-bottom-1.5"
                    ></i>
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#E8ECED] to-[#858B8D] text-[#333] sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[76%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="9.2" stroke="currentColor" stroke-width="3"
                      ></circle><circle
                        cx="16"
                        cy="16"
                        r="3.5"
                        stroke="currentColor"
                        stroke-width="2"></circle><path
                        d="M16 3v5M16 24v5M3 16h5M24 16h5M6.8 6.8l3.6 3.6M21.6 21.6l3.6 3.6M25.2 6.8l-3.6 3.6M10.4 21.6l-3.6 3.6"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"></path></svg
                    >
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#168EFF] to-[#0758D7] font-['Geist'] text-[8px] font-semibold tracking-[-0.06em] text-white sm:size-10 sm:rounded-[10px] sm:text-[12px]"
                  >
                    zoom
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#76CBFF] to-[#3896E8] text-white sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[72%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="2"
                      ></circle><path
                        d="m9 20.5 7-10 1.5 7.5 5.5-4.5"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path></svg
                    >
                  </span>
                  <span class="mx-0.5 h-6 w-px bg-black/20 sm:h-9"></span>
                  <span class="grid size-7 place-items-center sm:size-10">
                    <svg class="h-full w-[80%] drop-shadow-sm" viewBox="0 0 32 38" fill="none"
                      ><path
                        d="M7 7.5h18l-1.6 27H8.6L7 7.5Z"
                        fill="url(#trash-body)"
                        stroke="#D4D0CC"></path><path
                        d="M5 7.5h22M11 4h10"
                        stroke="#D4D0CC"
                        stroke-width="2"
                        stroke-linecap="round"></path><path
                        d="M12 12v17M16 12v17M20 12v17"
                        stroke="#D7D2CD"></path><defs
                        ><linearGradient
                          id="trash-body"
                          x1="16"
                          y1="7.5"
                          x2="16"
                          y2="34.5"
                          gradientUnits="userSpaceOnUse"
                          ><stop stop-color="#FFF"></stop><stop offset="1" stop-color="#E9E4DE"
                          ></stop></linearGradient
                        ></defs
                      ></svg
                    >
                  </span>
                </div>
              </div>
            </div>
            <div
              class="relative left-1/2 h-[9px] w-[103%] -translate-x-1/2 rounded-b-[55%] border border-t-0 border-[#B8B5AF] bg-[#D9D7D2] sm:h-3"
              aria-hidden="true"
            >
              <span class="mx-auto block h-[3px] w-16 rounded-b-full bg-[#AAA7A1] sm:w-24"></span>
            </div>
          </div>
        </div>
      </section>

      <section
        class="bg-[#FFF8F1] px-5 py-14 text-[#191613] sm:px-8 sm:py-16 lg:px-10 lg:py-20"
        aria-labelledby="services-heading"
      >
        <div class="mx-auto max-w-[1120px]">
          <div class="text-center">
            <p
              class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FF4D00]"
            >
              What we serve
            </p>
            <h2
              id="services-heading"
              class="mt-2 font-['EB_Garamond'] text-4xl font-normal leading-tight tracking-[-0.02em] text-[#191613] sm:text-5xl"
            >
              Learn, practise, and test yourself
            </h2>
            <p class="mx-auto mt-3 max-w-xl font-['Geist'] text-[13px] leading-6 text-[#675F58]">
              Three focused ways to stay informed and make steady progress toward your exam.
            </p>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-3 lg:gap-5">
            <article class="service-card text-center">
              <div class="service-visual" aria-hidden="true">
                <div class="service-demo">
