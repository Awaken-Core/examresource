---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import videoBg from '../assets/video-bg.png';
import BrandLogo from '../components/BrandLogo.astro';
import InkOrbitFeatures from '../components/ui/ink-orbit-features';
import { Avatar, Style } from '@dicebear/core';
import lorelei from '@dicebear/styles/lorelei.json' with { type: 'json' };
import {
  contactEmail,
  examPortals,
  siteDomain,
  siteFaqs,
  siteName,
  siteSlogan,
  telegramChannel,
  whatsappChannel,
  siteUrl,
} from '../data/site';

const avatarStyle = new Style(lorelei);
const studentPerspectives = [
  {
    title: 'Find deadlines faster',
    body: 'Clear dates, concise summaries, and direct official links make important updates easier to act on.',
    seed: 'exam-planner',
  },
  {
    title: 'Prepare in one place',
    body: 'Exam streams and focused resources keep preparation organised without jumping between scattered sources.',
    seed: 'focused-learner',
  },
  {
    title: 'Verify before applying',
    body: 'Every guide points back to the relevant official portal so critical details can be checked confidently.',
    seed: 'careful-candidate',
  },
].map((item) => ({
  ...item,
  avatar: new Avatar(avatarStyle, {
    seed: item.seed,
    size: 96,
    borderRadius: 50,
    backgroundColor: ['#FFE1D3', '#F1E7DB', '#FFD0BA'],
  }).toDataUri(),
}));

const groups = [
  {
    title: 'Explore',
    links: [
      ['Exam updates', '/blogs'],
      ['Latest notifications', '/blogs#latest-updates'],
      ['Exam categories', '/blogs#categories'],
      ['Test series', '/test-series'],
      ['Bookmarks', '/bookmarks'],
      ['Favorites', '/favorites'],
      ['Notifications', '/notifications'],
    ],
  },
  {
    title: 'Exam streams',
    links: [
      ['Central Govt & UPSC', '/category/central-government'],
      ['SSC exams', '/category/ssc'],
      ['Railway exams', '/category/railways'],
      ['Banking exams', '/category/banking'],
      ['Latest govt jobs', '/category/latest-jobs'],
      ['Defence exams', '/category/defence'],
      ['Police recruitment', '/category/police'],
      ['Teaching exams', '/category/teaching'],
      ['PSU & engineering', '/category/psu-engineering'],
    ],
  },
  { title: 'Resources', links: examPortals.slice(0, 9).map(({ name, href }) => [name, href]) },
  {
    title: 'Company',
    links: [
      ['About our portal', '/blogs#faqs'],
      ['Contact us', '/contact-us'],
      ['Pricing', '/pricing'],
      ['Refund policy', '/refund-policy'],
      ['Privacy policy', '/privacy-policy'],
      ['Terms of service', '/terms-of-service'],
      ['Sitemap', '/sitemap'],
      ['RSS feed', '/rss.xml'],
      ['Log in', '/login'],
      ['Create account', '/signup'],
    ],
  },
];

const ctaBarHeights = [
  190, 170, 150, 132, 114, 98, 82, 68, 56, 46, 38, 32, 32, 38, 46, 56, 68, 82, 98, 114, 132, 150,
  170, 190,
];

const homeCoverVideoUrl = import.meta.env.PUBLIC_HOME_COVER_VIDEO_URL;

// Edge CDN caching: cache homepage for 300s (5m), serve stale up to 900s (15m) while revalidating
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=900');
---

<Layout
  title={`${siteName} | Sarkari Exam Resources, Mock Tests & Daily Quiz`}
  description={`${siteName} links, exam resources, official portals, policies, and community channels.`}
  canonicalUrl={`${siteUrl}/`}
  ogImage={`${siteUrl}/og-image.jpg`}
  ogType="website"
  isEditorialTheme={true}
  hideDesktopSidebar={true}
  hideFooter={true}
>
  <div class="relative min-h-screen overflow-x-clip bg-editorial-bg text-editorial-text selection:bg-editorial-accent/20 selection:text-editorial-accent transition-colors duration-200">
    <section
      class="border-t border-[#191613]/15 dark:border-white/10 bg-editorial-bg text-[#191613] dark:text-[#E7E0D8] transition-colors duration-200 relative z-30 overflow-x-clip"
      aria-labelledby="landing-heading"
    >
      <div class="mx-auto max-w-[1180px] px-5 pb-0 pt-16 sm:pt-20 text-center sm:px-8">
        <p
          class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.18em] text-[#FF4D00]"
        >
          Government exam preparation, simplified
        </p>
        <h1
          id="landing-heading"
          class="mx-auto mt-5 max-w-[920px] font-['EB_Garamond'] text-[clamp(3.25rem,5vw,6.5rem)] font-normal leading-[0.92] tracking-[-0.045em] text-[#191613] dark:text-[#F5EEE6]"
        >
          Prepare smarter.<br />Perform with confidence.
        </h1>
          <p
            class="mx-auto mt-7 max-w-[650px] font-['Geist'] text-[14px] leading-7 text-[#675F58] dark:text-[#A89D92] sm:text-[16px]"
          >
            Verified exam updates, focused quizzes, and live tests brought together to keep your
            preparation clear and measurable.
          </p>
          <div class="mt-8 flex justify-center">
            <a
              href="/test-series"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#FF4D00] px-7 font-['Geist'] text-[13px] font-semibold text-white transition-colors hover:bg-[#D94100] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-3"
            >
              Explore tests
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
                ></path></svg
              >
            </a>
          </div>

          <!-- Mac Screen -->
          <div class="relative mx-auto mb-8 mt-16 max-w-[1080px] translate-y-px text-left sm:mt-20">
            <div
              class="relative rounded-[20px] border border-black/80 dark:border-white/20 bg-[#111111] dark:bg-[#1C1A18] p-[7px] sm:p-[9px]"
            >
              <div class="relative aspect-[16/10] overflow-hidden rounded-[13px] bg-[#111111]">
                <Image
                  src={videoBg}
                  alt="GovtPariksha platform preview"
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover object-center"
                />
                {
                  homeCoverVideoUrl && (
                    <div class="home-video-frame group absolute inset-0 h-full w-full overflow-hidden rounded-[12px] border-0 bg-black p-0 shadow-[0_18px_50px_rgba(0,0,0,0.45),0_0_0_1px_rgba(0,0,0,0.55)] sm:inset-auto sm:left-1/2 sm:top-[12%] sm:h-[70%] sm:w-[68%] sm:-translate-x-1/2 sm:rounded-[15px] sm:border sm:border-white/70 sm:p-[3px]">
                      <div class="relative h-full overflow-hidden rounded-[6px] bg-black sm:rounded-[11px]">
                        <video
                          id="home-cover-video"
                          class="h-full w-full object-cover object-center"
                          src={homeCoverVideoUrl}
                          poster={videoBg.src}
                          autoplay
                          loop
                          playsinline
                          preload="metadata"
                          aria-label="GovtPariksha platform preview"
                        />
                        <div class="video-control-scrim pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent px-2 pb-2 pt-8 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100 sm:px-3 sm:pb-3 sm:pt-12">
                          <div class="pointer-events-auto flex items-center justify-end gap-1.5 sm:justify-between sm:gap-2.5" data-video-controls>
                            <button
                              type="button"
                              class="hidden size-8 shrink-0 place-items-center rounded-full bg-editorial-accent text-white shadow-lg backdrop-blur-md transition-colors hover:bg-editorial-accent-hover focus-visible:outline-2 focus-visible:outline-white sm:grid sm:size-10"
                              data-video-play
                              aria-label="Play video"
                            >
                              <svg class="hidden size-4 sm:size-5" data-pause-icon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5.5A1.5 1.5 0 0 1 8.5 4h1A1.5 1.5 0 0 1 11 5.5v13A1.5 1.5 0 0 1 9.5 20h-1A1.5 1.5 0 0 1 7 18.5v-13Zm6 0A1.5 1.5 0 0 1 14.5 4h1A1.5 1.5 0 0 1 17 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5v-13Z" /></svg>
                              <svg class="size-4 sm:size-5" data-play-icon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.4 4.7A1.5 1.5 0 0 1 9 4.8l9.2 5.9a1.5 1.5 0 0 1 0 2.6L9 19.2A1.5 1.5 0 0 1 6.7 18V6a1.5 1.5 0 0 1 .7-1.3Z" /></svg>
                            </button>
                            <button
                              type="button"
                              class="grid size-8 shrink-0 place-items-center rounded-full text-white/85 transition-colors hover:bg-white/15 hover:text-white focus-visible:outline-2 focus-visible:outline-white sm:size-10"
                              data-video-mute
                              aria-label="Mute video"
                            >
                              <svg class="hidden size-4 sm:size-5" data-muted-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" stroke-linejoin="round" /><path d="m16 9 5 6m0-6-5 6" stroke-linecap="round" /></svg>
                              <svg class="size-4 sm:size-5" data-sound-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" stroke-linejoin="round" /><path d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8 8 0 0 1 0 12" stroke-linecap="round" /></svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  )
                }
                <span
                  class="absolute left-1/2 top-0 h-[15px] w-[74px] -translate-x-1/2 rounded-b-[9px] bg-[#111111] sm:h-[18px] sm:w-[98px]"
                  aria-hidden="true"></span>
                <div
                  class="absolute bottom-4 left-1/2 hidden -translate-x-1/2 items-end gap-1.5 rounded-[18px] border border-white/35 bg-white/45 p-2 shadow-[0_8px_24px_rgba(0,0,0,0.18)] backdrop-blur-xl sm:flex"
                  aria-hidden="true"
                >
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-white/90 sm:size-10 sm:rounded-[10px]"
                  >
                    <span class="grid grid-cols-3 gap-[2px] sm:gap-[3px]">
                      <i class="size-[4px] rounded-[1px] bg-[#77DF2F] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FFD21E] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF8A00] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#DC3C72] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#5E6F75] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#FF4E62] sm:size-[6px]"></i>
                      <i class="size-[4px] rounded-[1px] bg-[#804CD9] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#385CE5] sm:size-[6px]"></i><i
                        class="size-[4px] rounded-[1px] bg-[#55C9AA] sm:size-[6px]"></i>
                    </span>
                  </span>
                  <span
                    class="relative grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#5AE5FF] to-[#1976F3] text-white sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[72%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="1.5"
                      ></circle><path d="m18.2 13.8-7 7 2.6-9.6 9-2-4.6 4.6Z" fill="white"
                      ></path><path d="m13.8 18.2 7-7-2.6 9.6-9 2 4.6-4.6Z" fill="#FF4D4D"
                      ></path></svg
                    >
                    <i
                      class="absolute -bottom-1 h-0.5 w-0.5 rounded-full bg-black/70 sm:-bottom-1.5"
                    ></i>
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#E8ECED] to-[#858B8D] text-[#333] sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[76%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="9.2" stroke="currentColor" stroke-width="3"
                      ></circle><circle
                        cx="16"
                        cy="16"
                        r="3.5"
                        stroke="currentColor"
                        stroke-width="2"></circle><path
                        d="M16 3v5M16 24v5M3 16h5M24 16h5M6.8 6.8l3.6 3.6M21.6 21.6l3.6 3.6M25.2 6.8l-3.6 3.6M10.4 21.6l-3.6 3.6"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"></path></svg
                    >
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#168EFF] to-[#0758D7] font-['Geist'] text-[8px] font-semibold tracking-[-0.06em] text-white sm:size-10 sm:rounded-[10px] sm:text-[12px]"
                  >
                    zoom
                  </span>
                  <span
                    class="grid size-7 place-items-center rounded-[7px] bg-gradient-to-b from-[#76CBFF] to-[#3896E8] text-white sm:size-10 sm:rounded-[10px]"
                  >
                    <svg class="size-[72%]" viewBox="0 0 32 32" fill="none"
                      ><circle cx="16" cy="16" r="10.5" stroke="currentColor" stroke-width="2"
                      ></circle><path
                        d="m9 20.5 7-10 1.5 7.5 5.5-4.5"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path></svg
                    >
                  </span>
                  <span class="mx-0.5 h-6 w-px bg-black/20 sm:h-9"></span>
                  <span class="grid size-7 place-items-center sm:size-10">
                    <svg class="h-full w-[80%] drop-shadow-sm" viewBox="0 0 32 38" fill="none"
                      ><path
                        d="M7 7.5h18l-1.6 27H8.6L7 7.5Z"
                        fill="url(#trash-body)"
                        stroke="#D4D0CC"></path><path
                        d="M5 7.5h22M11 4h10"
                        stroke="#D4D0CC"
                        stroke-width="2"
                        stroke-linecap="round"></path><path
                        d="M12 12v17M16 12v17M20 12v17"
                        stroke="#D7D2CD"></path><defs
                        ><linearGradient
                          id="trash-body"
                          x1="16"
                          y1="7.5"
                          x2="16"
                          y2="34.5"
                          gradientUnits="userSpaceOnUse"
                          ><stop stop-color="#FFF"></stop><stop offset="1" stop-color="#E9E4DE"
                          ></stop></linearGradient
                        ></defs
                      ></svg
                    >
                  </span>
                </div>
              </div>
            </div>
            <div
              class="relative left-1/2 h-[9px] w-[103%] -translate-x-1/2 rounded-b-[55%] border border-t-0 border-[#B8B5AF] dark:border-[#38332E] bg-[#D9D7D2] dark:bg-[#25221F] sm:h-3"
              aria-hidden="true"
            >
              <span class="mx-auto block h-[3px] w-16 rounded-b-full bg-[#AAA7A1] dark:bg-[#554E46] sm:w-24"></span>
            </div>
          </div>
        </div>
      </section>

      <InkOrbitFeatures client:visible theme="auto" brand={siteName} chip="PARIKSHA" />

      <section
        class="bg-editorial-bg border-t border-[#191613]/10 dark:border-white/10 px-5 py-20 text-[#191613] dark:text-[#E7E0D8] sm:px-8 sm:py-24 lg:px-10 lg:py-28 transition-colors duration-200"
        aria-labelledby="student-perspectives-heading"
      >
        <div class="mx-auto max-w-[1040px]">
          <div class="text-center">
            <p
              class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FF4D00]"
            >
              Student-first by design
            </p>
            <h2
              id="student-perspectives-heading"
              class="mt-3 font-['EB_Garamond'] text-4xl font-normal leading-tight tracking-[-0.02em] text-[#191613] dark:text-[#F5EEE6] sm:text-5xl"
            >
              Made for students everywhere
            </h2>
            <p class="mx-auto mt-4 max-w-xl font-['Geist'] text-[13px] leading-6 text-[#675F58] dark:text-[#A89D92]">
              Three principles shaping a clearer, calmer way to discover and verify exam
              information.
            </p>
          </div>

          <div class="student-marquee mt-12 overflow-hidden" aria-label="Student perspectives">
            <div class="student-marquee-track">
              {
                [false, true].map((duplicate) => (
                  <div class="student-marquee-group" aria-hidden={duplicate ? 'true' : undefined}>
                    {studentPerspectives.map((item) => (
                      <article class="flex min-h-[220px] w-[min(82vw,340px)] shrink-0 flex-col rounded-xl border border-[#191613]/15 dark:border-white/15 bg-[#fffaf1] dark:bg-[#1C1A18] p-6 sm:w-[340px] sm:p-7 lg:w-[360px] shadow-2xs transition-colors">
                        <div class="flex items-center gap-3">
                          <img
                            src={item.avatar}
                            width="40"
                            height="40"
                            alt=""
                            class="h-10 w-10 rounded-full border border-[#191613]/10 dark:border-white/10 bg-[#FFF1E8] dark:bg-[#2C1E18]"
                            loading="lazy"
                            decoding="async"
                          />
                          <div>
                            <h3 class="font-['EB_Garamond'] text-xl font-normal leading-tight text-[#191613] dark:text-[#F5EEE6]">
                              {item.title}
                            </h3>
                            <p class="mt-0.5 font-['Geist'] text-[10px] font-semibold uppercase tracking-[0.12em] text-[#FF4D00]">
                              Student perspective
                            </p>
                          </div>
                        </div>
                        <p class="mt-6 font-['Geist'] text-[13px] leading-6 text-[#514A44] dark:text-[#A89D92]">
                          {item.body}
                        </p>
                      </article>
                    ))}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section
        class="bg-editorial-bg border-t border-[#191613]/10 dark:border-white/10 px-5 py-20 text-[#191613] dark:text-[#E7E0D8] sm:px-8 sm:py-24 lg:px-10 lg:py-28 transition-colors duration-200"
        aria-labelledby="faq-heading"
      >
        <div class="mx-auto max-w-[920px] space-y-40">
          <div class="mx-auto max-w-[680px]">
            <p
              class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FF4D00]"
            >
              Need clarity?
            </p>
            <h2
              id="faq-heading"
              class="mt-3 font-['EB_Garamond'] text-4xl font-normal leading-tight tracking-[-0.02em] text-[#191613] dark:text-[#F5EEE6] sm:text-5xl"
            >
              Frequently asked questions
            </h2>

            <div class="mt-10 border-t border-[#191613]/20 dark:border-white/15">
              {
                siteFaqs.map((faq) => (
                  <details class="faq-item group border-b border-[#191613]/20 dark:border-white/15">
                    <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 font-['Geist'] text-[15px] font-medium text-[#25221f] dark:text-[#F5EEE6] marker:content-none tracking-tight hover:text-[#FF4D00] transition-colors">
                      <span>{faq.question}</span>
                      <svg
                        class="h-4 w-4 shrink-0 text-[#191613]/55 dark:text-[#A89D92] transition-transform duration-200 group-open:rotate-180"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <p class="max-w-[620px] pb-5 pr-10 font-['Geist'] text-[13px] leading-6 text-[#514A44] dark:text-[#A89D92]">
                      {faq.answer}
                    </p>
                  </details>
                ))
              }
            </div>
          </div>

          <div
            class="relative flex min-h-[400px] items-center justify-center overflow-hidden rounded-3xl border border-[#191613]/15 dark:border-white/15 bg-[#fffaf1] dark:bg-[#1C1A18] px-6 py-20 text-center sm:px-10 shadow-sm transition-colors"
          >
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end gap-1 sm:gap-1.5"
              aria-hidden="true"
            >
              {
                ctaBarHeights.map((height) => (
                  <span
                    class="min-w-0 flex-1 rounded-t-lg border border-b-0 border-[#FF4D00]/40 bg-[#FF4D00]/10 dark:bg-[#FF4D00]/15"
                    style={`height: ${height}px`}
                  />
                ))
              }
            </div>
            <div class="relative z-10">
              <p class="font-['Geist'] text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FF4D00]">Start early</p>
              <h2
                class="font-['EB_Garamond'] text-4xl font-normal leading-tight tracking-[-0.02em] text-[#191613] dark:text-[#F5EEE6] sm:text-5xl"
              >
                Start your preparation with us!
              </h2>
              <p class="mx-auto mt-4 max-w-xl font-['Geist'] text-[13px] leading-6 text-[#514A44] dark:text-[#A89D92]">
                Browse blogs recruitment notices, deadlines, exam resources, and official
                notification.
              </p>
              <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a
                  href="/blogs"


                  class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[#FF4D00] px-6 font-['Geist'] text-[12px] font-semibold text-white transition-colors hover:bg-[#D94100] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-2 shadow-xs"
                >
                  Explore exam updates
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                    ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
                    ></path></svg
                  >
                </a>
                <a
                  id="home-cta-auth-btn"
                  href="/signup"
                  class="inline-flex min-h-11 items-center justify-center rounded-full border border-[#191613]/20 dark:border-white/20 bg-white dark:bg-[#25221F] px-6 font-['Geist'] text-[12px] font-semibold text-[#191613] dark:text-[#F5EEE6] transition-colors hover:border-[#ff962d] hover:bg-[#fff5e2] dark:hover:bg-[#2F2B27] focus-visible:outline-2 focus-visible:outline-[#FF4D00] focus-visible:outline-offset-2 shadow-2xs"
                  >Create an account</a
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <footer
        class="min-h-screen border-t border-white/20 dark:border-white/10 bg-black px-5 py-12 sm:px-8 sm:py-16 lg:px-20 lg:py-20"
      >
        <div
