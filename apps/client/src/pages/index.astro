// Important Portals matching Reference Right Sidebar
const R2_PORTAL_BASE = 'https://pub-68568854a58845bc975b176de76b1ad5.r2.dev/portals';

const rightPortals = [
  {
    name: 'UPSC',
    url: 'upsc.gov.in',
    href: 'https://www.upsc.gov.in/',
