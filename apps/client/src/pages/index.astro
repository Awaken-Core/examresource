---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import { contactEmail, examPortals, siteDomain, siteName, siteSlogan, telegramChannel, whatsappChannel } from '../data/site';

const groups = [
  {
    title: 'Explore',
    links: [
      ['Exam updates', '/blogs'], ['Latest notifications', '/blogs#latest-updates'],
      ['Exam categories', '/blogs#categories'], ['Test series', '/test-series'],
      ['Bookmarks', '/bookmarks'], ['Favorites', '/favorites'], ['Notifications', '/notifications'],
    ],
  },
  {
    title: 'Exam streams',
    links: [
      ['Central Govt & UPSC', '/category/central-government'], ['SSC exams', '/category/ssc'],
      ['Railway exams', '/category/railways'], ['Banking exams', '/category/banking'],
      ['Latest govt jobs', '/category/latest-jobs'], ['Defence exams', '/category/defence'],
      ['Police recruitment', '/category/police'], ['Teaching exams', '/category/teaching'],
      ['PSU & engineering', '/category/psu-engineering'],
    ],
  },
  { title: 'Resources', links: examPortals.slice(0, 9).map(({ name, href }) => [name, href]) },
  {
    title: 'Company',
    links: [
      ['About our portal', '/blogs#faqs'], ['Contact us', '/contact-us'],
      ['Privacy policy', '/privacy-policy'], ['Terms of service', '/terms-of-service'],
      ['Sitemap', '/sitemap'], ['RSS feed', '/rss.xml'], ['Log in', '/login'], ['Create account', '/signup'],
    ],
  },
];
---

<!doctype html>
<html lang="en" class="theme-dark bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={`${siteName} links, exam resources, official portals, policies, and community channels.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteName} — Explore exam resources</title>
  </head>
  <body class="min-h-screen bg-black text-white antialiased">
    <main class="min-h-screen">
      <footer class="min-h-screen border-t border-white/20 bg-black px-5 py-12 sm:px-8 sm:py-16 lg:px-20 lg:py-20">
        <div class="mx-auto flex min-h-[calc(100vh-6rem)] max-w-[1440px] flex-col sm:min-h-[calc(100vh-8rem)] lg:min-h-[calc(100vh-10rem)]">
          <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-[1.45fr_1fr_1fr_1fr_1fr] lg:gap-x-12 xl:gap-x-16">
            <section class="sm:col-span-2 lg:col-span-1" aria-labelledby="footer-brand">
              <a href="/blogs" class="group inline-flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4">
                <BrandLogo size={38} class="transition-transform duration-200 group-hover:rotate-[-3deg]" />
                <h1 id="footer-brand" class="font-['EB_Garamond'] text-[2rem] font-normal leading-none tracking-[-0.02em] text-white">{siteName}</h1>
              </a>
              <p class="mt-5 max-w-[280px] font-['Geist'] text-[13px] leading-6 text-white/70">
                {siteSlogan}. Verified notices, practical exam resources, and direct links to official portals.
              </p>
              <div class="mt-6 flex items-center gap-2.5" aria-label="Community links">
                {whatsappChannel && (
                  <a href={whatsappChannel} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp channel" class="social-link hover:bg-[#25D366] focus-visible:outline-[#25D366]">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
                  </a>
                )}
                {telegramChannel && (
                  <a href={telegramChannel} target="_blank" rel="noopener noreferrer" aria-label="Telegram channel" class="social-link hover:bg-[#229ED9] focus-visible:outline-[#229ED9]">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 1 0 24 12 12 12 0 0 0 11.944 0Zm5.498 8.184-1.95 9.192c-.147.65-.535.808-1.084.503l-2.97-2.19-1.433 1.379a.747.747 0 0 1-.6.293l.213-3.025 5.506-4.975c.24-.213-.052-.332-.372-.119l-6.806 4.285-2.93-.916c-.637-.199-.65-.637.133-.943l11.458-4.416c.53-.199.995.12.835.932Z" /></svg>
                  </a>
                )}
                <a href={`mailto:${contactEmail}`} aria-label={`Email ${siteName}`} class="social-link hover:bg-accent focus-visible:outline-accent">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6.75A2.25 2.25 0 0 1 5.25 4.5h13.5A2.25 2.25 0 0 1 21 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 17.25V6.75Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 6 7.06 5.11a2 2 0 0 0 2.38 0L20.25 6"/></svg>
                </a>
              </div>
            </section>

            {groups.map((group) => (
              <nav aria-labelledby={`footer-${group.title.toLowerCase().replace(' ', '-')}`}>
                <h2 id={`footer-${group.title.toLowerCase().replace(' ', '-')}`} class="font-['EB_Garamond'] text-[24px] font-normal tracking-[0.01em] text-neutral-400">{group.title}</h2>
                <ul class="mt-5 space-y-3 font-['Geist']">
                  {group.links.map(([label, href]) => {
                    const external = href.startsWith('http');
                    return <li><a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="inline-flex min-h-5 items-center text-[15px] leading-5 text-white/95 transition-colors hover:text-accent focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2">{label}</a></li>;
                  })}
                </ul>
              </nav>
            ))}
          </div>

          <div class="mt-16 flex flex-col gap-4 border-t border-white/20 pt-6 font-['Geist'] text-[11px] text-white/65 sm:mt-auto sm:flex-row sm:items-center sm:justify-between">
            <p>© {new Date().getFullYear()} {siteDomain}. Independent educational information portal.</p>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
              <a href="/privacy-policy" class="transition-colors hover:text-white">Privacy</a>
              <a href="/terms-of-service" class="transition-colors hover:text-white">Terms</a>
              <a href="/contact-us" class="transition-colors hover:text-white">Contact</a>
              <span>English · हिन्दी</span>
            </div>
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(html) { color-scheme: dark; background: #000; }
  :global(body) { margin: 0; background: #000; color: #fafaf9; font-family: 'Geist', sans-serif; }
  .social-link { display: flex; width: 2.25rem; height: 2.25rem; align-items: center; justify-content: center; border-radius: 9999px; background: rgb(255 255 255 / 0.1); color: rgb(255 255 255 / 0.72); transition: color 150ms, background-color 150ms; }
  .social-link:hover { color: white; }
  .social-link:focus-visible { outline-width: 2px; outline-style: solid; outline-offset: 2px; }
</style>
