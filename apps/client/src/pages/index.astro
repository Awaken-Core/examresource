---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Sidebar from '../components/Sidebar.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import StateFilterWidget from '../components/StateFilterWidget.astro';
import { examArticleData } from '../data/examArticle';

const tocItems = [
  { id: "overview", text: "Bihar DECE LE Seat Allotment Overview" },
  { id: "quick-info", text: "Quick Information Summary" },
  { id: "important-dates", text: "Important Counselling Dates & Schedule" },
  { id: "application-fee", text: "Counselling & Admission Fee" },
  { id: "eligibility-seats", text: "Eligibility Criteria & Admission Seats" },
  { id: "selection-process", text: "Seat Allotment & Selection Process" },
  { id: "how-to-download", text: "Step-by-Step Guide to Download Allotment Order" },
  { id: "required-documents", text: "Documents Required for Physical Verification" },
  { id: "important-links", text: "Direct Links to Download Allotment & Schedule" },
  { id: "faqs", text: "Frequently Asked Questions (FAQs)" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      "headline": examArticleData.title,
      "description": examArticleData.summary,
      "datePublished": "2026-10-12T09:00:00+05:30",
      "dateModified": "2026-10-12T14:45:00+05:30",
      "author": {
        "@type": "Person",
        "name": examArticleData.author
      },
      "publisher": {
        "@type": "Organization",
        "name": "ExamPortal",
        "logo": {
          "@type": "ImageObject",
          "url": "https://example.com/logo.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://example.com/${examArticleData.slug}`
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": examArticleData.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={`${examArticleData.title} - ExamPortal`}
  description={examArticleData.summary}
  canonicalUrl={`https://example.com/${examArticleData.slug}`}
  jsonLd={structuredData}
>
  {/* Breadcrumbs Navigation */}
  <Breadcrumb 
    category={examArticleData.category} 
    title="Bihar DECE LE Seat Allotment 2026" 
  />

  {/* Main Container */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    
    {/* State-Wise Updates Filter Section */}
    <StateFilterWidget />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      {/* Left / Main Article Column (8 cols on desktop) */}
      <article class="lg:col-span-8 bg-white rounded-2xl border border-slate-200/90 p-5 sm:p-8 shadow-xs">
        
        {/* Category Pill and Notice Badge */}
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-1 rounded-md">
            {examArticleData.category.name}
          </span>
          <span class="bg-amber-100 text-amber-800 text-xs font-semibold px-2.5 py-1 rounded-md">
            Notice: {examArticleData.noticeNumber}
          </span>
          <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-2.5 py-1 rounded-md flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            Round 1 Out
          </span>
        </div>

        {/* Main Article Title (H1) */}
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
          {examArticleData.title}
        </h1>

        {/* Post Metadata Row */}
        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs sm:text-sm text-slate-500 pb-4 mb-6 border-b border-slate-200">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>By <strong class="text-slate-700">{examArticleData.author}</strong></span>
          </div>

          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Published: {examArticleData.postDate}</span>
          </div>

          <div class="flex items-center gap-1.5 text-blue-700 font-medium">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Updated: {examArticleData.updatedDate}</span>
          </div>

          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{examArticleData.readTime}</span>
          </div>
        </div>

        {/* Short Executive Summary / Intro */}
        <section id="overview" class="mb-6 scroll-mt-20">
          <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
            {examArticleData.summary}
          </p>
        </section>

        {/* Prominent High-Priority Alert Box */}
        <div class="bg-blue-50 border-l-4 border-blue-600 p-4 rounded-r-lg mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <p class="text-sm font-bold text-blue-900">
              ⚡ BCECEB Round 1 Allotment Order is Live!
            </p>
            <p class="text-xs text-blue-700 mt-0.5">
              Downloading period is open from 12th Oct to 16th Oct 2026. Keep your roll number ready.
            </p>
          </div>
          <a 
            href="#important-links" 
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-md shadow-xs transition shrink-0"
          >
            Direct Link Below ↓
          </a>
        </div>

        {/* Table of Contents */}
        <TableOfContents items={tocItems} />

        {/* Ad Space 1: Top in-article banner */}
        <AdPlaceholder slotId="article-top-banner" type="banner" label="Header In-Article Banner" />

        {/* Quick Information Summary Table */}
        <section id="quick-info" class="mt-8 mb-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b-2 border-blue-600 flex items-center gap-2">
            <span>📌</span>
            <span>Bihar DECE LE 2026: Quick Overview</span>
          </h2>
          
          <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="min-w-full text-sm text-left">
              <tbody class="divide-y divide-slate-200">
                <tr class="bg-slate-50">
                  <th class="py-3 px-4 font-semibold text-slate-700 w-1/3">Conducting Authority</th>
                  <td class="py-3 px-4 text-slate-800 font-medium">{examArticleData.organization}</td>
                </tr>
                <tr>
                  <th class="py-3 px-4 font-semibold text-slate-700">Exam / Admission Name</th>
                  <td class="py-3 px-4 text-slate-800">Diploma Entrance Competitive Exam [Lateral Entry] (DECE-LE 2026)</td>
                </tr>
                <tr class="bg-slate-50">
                  <th class="py-3 px-4 font-semibold text-slate-700">Course Level</th>
                  <td class="py-3 px-4 text-slate-800">Diploma 2nd Year (Lateral Entry 3-Year Engineering Courses)</td>
                </tr>
                <tr>
                  <th class="py-3 px-4 font-semibold text-slate-700">Allotment Round</th>
                  <td class="py-3 px-4 text-slate-800">1st Provisional Round (Round 1)</td>
                </tr>
                <tr class="bg-slate-50">
                  <th class="py-3 px-4 font-semibold text-slate-700">Allotment Release Date</th>
                  <td class="py-3 px-4 text-emerald-700 font-bold">12 October 2026 (Out)</td>
                </tr>
                <tr>
                  <th class="py-3 px-4 font-semibold text-slate-700">Verification Window</th>
                  <td class="py-3 px-4 text-slate-800 font-semibold">13 October to 16 October 2026</td>
                </tr>
                <tr class="bg-slate-50">
                  <th class="py-3 px-4 font-semibold text-slate-700">Mode of Allotment</th>
                  <td class="py-3 px-4 text-slate-800">Online through Candidate Login</td>
                </tr>
                <tr>
                  <th class="py-3 px-4 font-semibold text-slate-700">Official Website</th>
                  <td class="py-3 px-4">
                    <a href={examArticleData.officialWebsite} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-semibold">
                      bceceboard.bihar.gov.in ↗
                    </a>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        {/* Section: Important Dates */}
        <section id="important-dates" class="mt-8 mb-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b-2 border-blue-600 flex items-center gap-2">
            <span>📅</span>
            <span>Important Counselling Dates & Schedule</span>
          </h2>
          <p class="text-sm text-slate-600 mb-3 leading-relaxed">
            All candidates must adhere strictly to the following dates issued in the official BCECEB counseling calendar:
          </p>
          
          <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="min-w-full text-sm text-left">
              <thead class="bg-blue-50 text-blue-900 font-semibold border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4">Counselling Event / Activity</th>
                  <th class="py-3 px-4">Important Dates</th>
                  <th class="py-3 px-4 text-right">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {examArticleData.importantDates.map((item, index) => (
                  <tr class={index % 2 === 0 ? "bg-white" : "bg-slate-50"}>
                    <td class="py-3 px-4 font-medium text-slate-800">{item.event}</td>
                    <td class="py-3 px-4 text-slate-700 font-semibold">{item.date}</td>
                    <td class="py-3 px-4 text-right">
                      <span class={`text-[11px] font-bold px-2 py-0.5 rounded-full ${
                        item.statusBadge === 'Released Now' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' :
                        item.statusBadge === 'Active' ? 'bg-blue-100 text-blue-800' :
                        item.statusBadge === 'Upcoming' ? 'bg-amber-100 text-amber-800' :
                        'bg-slate-100 text-slate-600'
                      }`}>
                        {item.statusBadge}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {/* Section: Application Fees */}
        <section id="application-fee" class="mt-8 mb-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b-2 border-blue-600 flex items-center gap-2">
            <span>💳</span>
            <span>Allotment & Verification Fee Details</span>
          </h2>
          
          <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="min-w-full text-sm text-left">
              <thead class="bg-blue-50 text-blue-900 font-semibold border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4">Fee Head</th>
                  <th class="py-3 px-4">Applicable Fee Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {examArticleData.applicationFees.map((fee, idx) => (
                  <tr class={idx % 2 === 0 ? "bg-white" : "bg-slate-50"}>
                    <td class="py-3 px-4 font-medium text-slate-700">{fee.category}</td>
                    <td class="py-3 px-4 text-slate-800 font-semibold">{fee.fee}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {/* Ad Space 2: Mid-article banner */}
        <AdPlaceholder slotId="article-mid-banner" type="in-article" label="Mid Content In-Feed Ad" />

        {/* Section: Eligibility Criteria */}
        <section id="eligibility-seats" class="mt-8 mb-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b-2 border-blue-600 flex items-center gap-2">
            <span>🎓</span>
            <span>Eligibility Criteria & Seat Distribution</span>
          </h2>
          
          <div class="space-y-4">
            <div class="overflow-x-auto rounded-xl border border-slate-200">
              <table class="min-w-full text-sm text-left">
                <thead class="bg-blue-50 text-blue-900 font-semibold border-b border-slate-200">
                  <tr>
                    <th class="py-3 px-4">Course Stream</th>
                    <th class="py-3 px-4">Minimum Educational Qualification</th>
                    <th class="py-3 px-4">Seat Availability</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                  {examArticleData.eligibility.map((item, idx) => (
                    <tr class={idx % 2 === 0 ? "bg-white" : "bg-slate-50"}>
                      <td class="py-3 px-4 font-semibold text-slate-800">{item.post}</td>
                      <td class="py-3 px-4 text-slate-700">{item.qualification}</td>
                      <td class="py-3 px-4 text-slate-800 font-medium">{item.vacancies}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                <h3 class="font-bold text-slate-900 text-sm mb-2">Age Limit Guidelines</h3>
                <ul class="text-xs text-slate-600 space-y-1.5 list-disc pl-4">
                  {examArticleData.ageLimit.map((age) => (
                    <li><strong>{age.criteria}:</strong> {age.details}</li>
                  ))}
                </ul>
              </div>
              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                <h3 class="font-bold text-slate-900 text-sm mb-2">Seat Allocation Rule</h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Up to 10% sanctioned seats in 2nd year Diploma courses across Government and Private Polytechnic colleges are allocated through DECE (LE) ranking based on category reservation regulations of the Government of Bihar.
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* Section: Selection Process */}
        <section id="selection-process" class="mt-8 mb-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b-2 border-blue-600 flex items-center gap-2">
            <span>⚙️</span>
            <span>Admission & Selection Process</span>
          </h2>
          
          <div class="space-y-3">
            {examArticleData.selectionSteps.map((step, idx) => (
              <div class="flex items-start gap-3 p-3.5 bg-white border border-slate-200 rounded-lg shadow-2xs">
                <div class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                  {idx + 1}
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-slate-800">{step}</h3>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* Section: How to Check / Download */}
        <section id="how-to-download" class="mt-8 mb-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b-2 border-blue-600 flex items-center gap-2">
            <span>📥</span>
            <span>How to Check Bihar DECE LE Round 1 Allotment Result 2026</span>
          </h2>
          <p class="text-sm text-slate-600 mb-4 leading-relaxed">
            Follow these direct steps to log in to the official BCECE portal and print your provisional admission allotment order:
          </p>

          <ol class="space-y-2.5 list-none">
            {examArticleData.stepsToApply.map((step, idx) => (
              <li class="flex items-start gap-3 text-sm text-slate-700 bg-slate-50 p-3 rounded-lg border border-slate-200/80">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-blue-100 text-blue-800 font-bold text-xs shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <span class="leading-relaxed">{step}</span>
              </li>
            ))}
          </ol>
        </section>

        {/* Section: Documents Required for Verification */}
        <section id="required-documents" class="mt-8 mb-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b-2 border-blue-600 flex items-center gap-2">
            <span>📑</span>
            <span>List of Documents Required for Verification</span>
          </h2>
          <div class="p-4 bg-amber-50/70 border border-amber-200 rounded-xl text-sm text-slate-700">
            <p class="font-semibold text-amber-900 mb-2">
              Carry the original documents along with 2 sets of self-attested photocopies to your allotted nodal reporting center:
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-700">
              <li>Original Admit Card of DECE(LE)-2026 Examination</li>
              <li>Official Rank Card of DECE(LE)-2026</li>
              <li>Printed Provisional Seat Allotment Order (3 copies)</li>
              <li>Class 10th (Matric) Admit Card, Marks Sheet, and Passing Certificate</li>
              <li>Class 12th (Science/Vocational) OR ITI (2 Years) Marks Sheet & Certificates</li>
              <li>Permanent Residential Certificate (Domicile of Bihar)</li>
              <li>Caste Certificate (SC/ST/EBC/BC/EWS) issued by competent CO / SDO</li>
              <li>Character Certificate from the institution last attended</li>
              <li>Copy of Aadhaar Card as Government ID Proof</li>
              <li>6 Passport-size photographs matching the exam admit card photo</li>
              <li>Medical Fitness Certificate from a registered medical practitioner</li>
            </ul>
          </div>
        </section>

        {/* Ad Space 3: Before Important Links */}
        <AdPlaceholder slotId="article-bottom-banner" type="banner" label="Pre-Links Banner Ad" />

        {/* Section: Important Links Table */}
        <section id="important-links" class="mt-8 mb-6 scroll-mt-20">
          <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-4 rounded-t-xl flex items-center justify-between">
            <h2 class="text-lg font-bold tracking-wide !my-0 !border-0 !p-0 flex items-center gap-2 text-white">
              <span>🔗</span>
              <span>Important Official Links & Downloads</span>
            </h2>
            <span class="bg-amber-400 text-blue-950 text-xs font-bold px-2 py-0.5 rounded">Verified Direct Links</span>
          </div>

          <div class="overflow-x-auto rounded-b-xl border-x border-b border-slate-300">
            <table class="min-w-full text-sm text-left">
              <tbody class="divide-y divide-slate-200">
                {examArticleData.importantLinks.map((link, idx) => (
                  <tr class={`hover:bg-blue-50/50 transition ${idx % 2 === 0 ? 'bg-white' : 'bg-slate-50'}`}>
                    <th class="py-3.5 px-4 font-semibold text-slate-800 text-sm w-3/5">
                      <div class="flex items-center gap-2">
                        {link.highlight && (
                          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        )}
                        <span>{link.title}</span>
                      </div>
                    </th>
                    <td class="py-3.5 px-4 text-right">
                      <a 
                        href={link.url} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class={`inline-flex items-center gap-1.5 px-4 py-1.5 text-xs font-bold rounded-lg transition shadow-xs ${
                          link.highlight 
                            ? 'bg-blue-700 hover:bg-blue-800 text-white' 
                            : 'bg-slate-200 hover:bg-slate-300 text-slate-800'
                        }`}
                      >
                        <span>{link.linkText}</span>
                        <span>↗</span>
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {/* FAQs Component */}
        <FAQSection faqs={examArticleData.faqs} />

        {/* Related Articles Component */}
        <RelatedArticles articles={examArticleData.relatedArticles} />

      </article>

      {/* Right Column / Dedicated Ad & Sidebar Space (4 cols on desktop) */}
      <aside class="lg:col-span-4 space-y-6">
        <Sidebar officialWebsite={examArticleData.officialWebsite} />
      </aside>

    </div>
  </div>
</Layout>
