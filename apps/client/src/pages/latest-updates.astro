---
import Layout from '../layouts/Layout.astro';
import { siteDomain, siteName, siteUrl, whatsappChannel, telegramChannel } from '../data/site';
import {
  appLangToBlogLanguage,
  articleHref,
  preferredLangFromCookieHeader,
} from '../lib/preferred-lang';

const API_URL = import.meta.env.PUBLIC_API_URL.replace(/\/$/, '');
const preferredAppLang = preferredLangFromCookieHeader(Astro.request.headers.get('cookie'));
const listLanguage = appLangToBlogLanguage(preferredAppLang);

// Edge CDN caching: cache for 60s, serve stale up to 300s while revalidating
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('Vary', 'Cookie, Accept-Encoding');

let livePosts: any[] = [];
let fetchError: { type: 'network' | 'http' | 'json' | 'empty'; message?: string; status?: number; durationMs: number } | null = null;

const fetchStart = performance.now();
try {
  const res = await fetch(`${API_URL}/blogs?limit=100&language=${listLanguage}&includeImages=false`, {
    signal: AbortSignal.timeout(6000),
  });
  const durationMs = Math.round(performance.now() - fetchStart);

  if (!res.ok) {
    fetchError = { type: 'http', status: res.status, durationMs };
  } else {
    try {
      const data = await res.json();
      if (Array.isArray(data)) {
        livePosts = data;
        if (data.length === 0) {
          fetchError = { type: 'empty', status: res.status, durationMs };
        }
      } else {
        fetchError = { type: 'json', message: 'Payload is not an array', status: res.status, durationMs };
      }
    } catch (parseErr: any) {
      fetchError = { type: 'json', message: parseErr?.message, status: res.status, durationMs };
    }
  }
} catch (netErr: any) {
  const durationMs = Math.round(performance.now() - fetchStart);
  fetchError = { type: 'network', message: netErr?.message, durationMs };
}

// Compute NEW badge (within last 3 days) and format chronological list
const THREE_DAYS_MS = 3 * 24 * 60 * 60 * 1000;
const nowTime = Date.now();

const sortedPosts = [...livePosts].sort((a, b) => {
  const timeA = new Date(a.publishedAt || a.updatedAt || a.createdAt || 0).getTime();
  const timeB = new Date(b.publishedAt || b.updatedAt || b.createdAt || 0).getTime();
  return timeB - timeA;
});

const updatesList = sortedPosts.map((p) => {
  const title = p.title || 'Untitled Notification';
  const categoryName = p.category?.name || p.categories?.[0]?.name || 'Central Government';
  const categorySlug = p.category?.slug || p.categories?.[0]?.slug || 'central-government';
  const pubDate = new Date(p.publishedAt || p.updatedAt || p.createdAt || Date.now());
  const pubTime = pubDate.getTime();
  const diffMs = nowTime - pubTime;
  const isNew = diffMs >= 0 && diffMs <= THREE_DAYS_MS;

  // Relative time helper
  let relativeTime = 'Recently';
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  if (diffHours < 1) relativeTime = 'Just now';
  else if (diffHours < 24) relativeTime = `${diffHours}h ago`;
  else if (diffDays === 1) relativeTime = 'Yesterday';
  else if (diffDays <= 7) relativeTime = `${diffDays}d ago`;
  else {
    relativeTime = pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
  }

  return {
    title,
    slugKey: p.slug,
    slug: articleHref(p.slug, preferredAppLang),
    category: categoryName,
    categorySlug,
    categories: p.categories || (p.category ? [p.category] : []),
    summary: p.description || p.metaDescription || '',
    dateFormatted: pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
    relativeTime,
    isNew,
  };
});

// Category filter list extracted dynamically from articles
const categoryFilters = [
  { slug: 'all', name: 'All Updates' },
  ...Array.from(new Set(updatesList.map(u => u.category))).map(name => ({
    slug: updatesList.find(u => u.category === name)?.categorySlug || name.toLowerCase().replace(/\s+/g, '-'),
    name,
  })),
];

const newNoticesCount = updatesList.filter(u => u.isNew).length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Latest Exam Updates & Notifications — ${siteName}`,
  description: `Real-time government exam notices, admit card alerts, answer keys, and results published chronologically.`,
  url: `${siteUrl}/latest-updates`,
};
---

<Layout
  title={`Latest Exam Updates & Notifications — ${siteName}`}
  description={`Real-time government exam updates, fresh job alerts, admit card releases, answer keys, and official notices listed chronologically.`}
  canonicalUrl={`${siteUrl}/latest-updates`}
  ogType="website"
  jsonLd={jsonLd}
  isEditorialTheme={true}
>
  <div class="relative min-h-screen bg-editorial-bg text-editorial-text selection:bg-editorial-accent/20 selection:text-editorial-accent">
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-8 lg:px-12 pt-6 sm:pt-8 pb-20">

      {/* Breadcrumb Navigation */}
      <nav class="flex items-center gap-2 text-[12px] font-['Geist'] text-editorial-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-editorial-accent transition-colors">Home</a>
        <span class="text-editorial-border font-bold">/</span>
        <a href="/blogs" class="hover:text-editorial-accent transition-colors">Blogs</a>
        <span class="text-editorial-border font-bold">/</span>
        <span class="text-editorial-heading font-medium" aria-current="page">Latest updates</span>
      </nav>

      {/* Hero Header */}
      <header class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-editorial-accent/10 border border-editorial-accent/25 text-editorial-accent text-[11px] font-bold font-['Geist'] uppercase tracking-widest mb-3.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-editorial-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-editorial-accent"></span>
          </span>
          Live Examination Desk
        </div>

        <h1 class="font-['EB_Garamond'] text-[clamp(2.35rem,4vw,3.75rem)] font-normal leading-[1.02] tracking-[-0.035em] text-editorial-heading">
          Latest Exam Updates.<br />
          <span class="text-editorial-subheading">Fresh notices in real time.</span>
        </h1>

        <p class="mt-3 text-[13.5px] sm:text-[15px] leading-relaxed text-editorial-muted font-['Geist']">
          Chronological feed of official government notifications, admit cards, exam schedules, answer keys, and merit lists.
        </p>

        {/* Counter Pills */}
        <div class="mt-4 flex items-center justify-center gap-3 text-xs font-['Geist']">
          <span class="px-3 py-1 rounded-full bg-editorial-surface border border-editorial-border text-editorial-heading font-semibold">
            {updatesList.length} Total Notices
          </span>
          {newNoticesCount > 0 && (
            <span class="px-3 py-1 rounded-full bg-editorial-accent/15 border border-editorial-accent/30 text-editorial-accent font-bold flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-editorial-accent"></span>
              {newNoticesCount} Fresh Updates
            </span>
          )}
        </div>
      </header>

      {/* Filter and Search Bar */}
      <section class="mb-8" aria-label="Search and filter notices">
        <div class="bg-editorial-surface border border-editorial-border rounded-2xl p-3 sm:p-4 shadow-xs space-y-3">
          
          {/* Real-time Search Input */}
          <div class="relative">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-editorial-muted pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="updates-search-input"
              type="text"
              placeholder="Search notices by exam, department, or keyword..."
              class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-editorial-bg border border-editorial-border text-editorial-heading placeholder:text-editorial-muted text-sm font-['Geist'] focus:outline-none focus:border-editorial-accent focus:ring-2 focus:ring-editorial-accent/15 transition-all"
            />
          </div>

          {/* Category Filter Pills (Horizontal scroll on mobile) */}
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none font-['Geist'] text-xs" role="tablist" aria-label="Category filter">
            {categoryFilters.map((cat, idx) => (
              <button
                type="button"
                data-category-filter={cat.slug}
                class={`category-filter-btn px-3 py-1.5 rounded-full border transition cursor-pointer shrink-0 font-medium ${
                  idx === 0
                    ? 'active bg-editorial-accent text-white border-editorial-accent shadow-2xs font-semibold'
                    : 'bg-editorial-surface-raised border-editorial-border text-editorial-muted hover:text-editorial-heading hover:border-editorial-accent/40'
                }`}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                {cat.name}
              </button>
            ))}
          </div>
        </div>
      </section>

      {/* Vertical List of Notices */}
      <main class="space-y-3" id="updates-list-container">
        {updatesList.length === 0 ? (
          <div class="text-center py-16 px-4 bg-editorial-surface border border-editorial-border rounded-2xl">
            <svg class="w-12 h-12 text-editorial-muted mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <h3 class="font-['EB_Garamond'] text-2xl text-editorial-heading font-medium">No notices published yet</h3>
            <p class="text-sm text-editorial-muted font-['Geist'] mt-1 max-w-sm mx-auto">
              Check back shortly or explore current categories on the main blogs desk.
            </p>
            <a href="/blogs" class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-full bg-editorial-accent text-white text-xs font-semibold hover:bg-editorial-accent-hover transition">
              Browse All Streams →
            </a>
          </div>
        ) : (
          updatesList.map((item) => (
            <article
              class="update-row-card group bg-editorial-surface hover:bg-editorial-surface-raised border border-editorial-border hover:border-editorial-accent/35 rounded-2xl p-4 sm:p-5 transition-all duration-150 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-['Geist']"
              data-category={item.categorySlug}
              data-title={item.title.toLowerCase()}
              data-summary={item.summary.toLowerCase()}
            >
              {/* Left Column: Date & Badges + Content */}
              <div class="flex-1 min-w-0 space-y-1.5">
                {/* Metadata Row: Category + Relative Time + Date + NEW Badge */}
                <div class="flex items-center flex-wrap gap-2 text-[11px]">
                  <span class="px-2.5 py-0.5 rounded-md bg-editorial-surface-raised border border-editorial-border font-semibold text-editorial-subheading">
                    {item.category}
                  </span>

                  <span class="text-editorial-muted flex items-center gap-1">
                    <svg class="size-3 text-editorial-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {item.relativeTime}
                  </span>

                  <span class="text-editorial-border">•</span>

                  <span class="text-editorial-muted">
                    {item.dateFormatted}
                  </span>

                  {item.isNew && (
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-editorial-accent text-white shadow-2xs">
                      New
                    </span>
                  )}
                </div>

                {/* Title */}
                <h2 class="text-[16px] sm:text-[18px] font-semibold text-editorial-heading group-hover:text-editorial-accent transition-colors leading-snug">
                  <a href={item.slug} class="focus:outline-none focus-visible:underline">
                    {item.title}
                  </a>
                </h2>

                {/* Excerpt Summary */}
                {item.summary && (
                  <p class="text-[13px] text-editorial-muted line-clamp-2 leading-relaxed">
                    {item.summary}
                  </p>
                )}
              </div>

              {/* Right Column: CTA Action */}
              <div class="shrink-0 flex items-center sm:self-center pt-2 sm:pt-0 border-t sm:border-t-0 border-editorial-border/60">
                <a
                  href={item.slug}
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-editorial-surface-raised group-hover:bg-editorial-accent text-editorial-heading group-hover:text-white border border-editorial-border group-hover:border-editorial-accent text-xs font-semibold transition-all duration-150"
                  aria-label={`Read notice: ${item.title}`}
                >
                  <span>Read Notice</span>
                  <svg class="size-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))
        )}

        {/* Dynamic Empty State for Client-Side Search / Filter */}
        <div id="no-filter-results" class="hidden text-center py-12 px-4 bg-editorial-surface border border-editorial-border rounded-2xl">
          <p class="font-['EB_Garamond'] text-xl text-editorial-heading font-medium">No matching exam notices found</p>
          <p class="text-xs text-editorial-muted font-['Geist'] mt-1">Try another keyword or select "All Updates".</p>
          <button
            id="reset-filter-btn"
            type="button"
            class="mt-3 px-3 py-1.5 rounded-full bg-editorial-surface-raised border border-editorial-border text-editorial-heading text-xs font-semibold hover:border-editorial-accent transition cursor-pointer"
          >
            Clear Filters
          </button>
        </div>
      </main>

    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    function initUpdatesFilter() {
      const searchInput = document.getElementById('updates-search-input');
      const filterBtns = document.querySelectorAll('.category-filter-btn');
      const cards = document.querySelectorAll('.update-row-card');
      const noResults = document.getElementById('no-filter-results');
      const resetBtn = document.getElementById('reset-filter-btn');

      if (!cards.length) return;

      let activeCategory = 'all';
      let searchQuery = '';

      function applyFilter() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
          const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();
          const cardSummary = (card.getAttribute('data-summary') || '').toLowerCase();

          const matchesCategory = activeCategory === 'all' || cardCat === activeCategory;
          const matchesSearch = !searchQuery || cardTitle.includes(searchQuery) || cardSummary.includes(searchQuery);

          if (matchesCategory && matchesSearch) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', function () {
          filterBtns.forEach((b) => {
            b.classList.remove('active', 'bg-editorial-accent', 'text-white', 'border-editorial-accent', 'font-semibold');
            b.classList.add('bg-editorial-surface-raised', 'border-editorial-border', 'text-editorial-muted');
            b.setAttribute('aria-selected', 'false');
          });

          this.classList.add('active', 'bg-editorial-accent', 'text-white', 'border-editorial-accent', 'font-semibold');
          this.classList.remove('bg-editorial-surface-raised', 'border-editorial-border', 'text-editorial-muted');
          this.setAttribute('aria-selected', 'true');

          activeCategory = this.getAttribute('data-category-filter') || 'all';
          applyFilter();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', function (e) {
          searchQuery = (e.target.value || '').trim().toLowerCase();
          applyFilter();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          if (searchInput) searchInput.value = '';
          searchQuery = '';
          const allBtn = document.querySelector('[data-category-filter="all"]');
          if (allBtn) allBtn.click();
        });
      }
    }

    document.addEventListener('astro:page-load', initUpdatesFilter);
    initUpdatesFilter();
  })();
</script>

