---
import Layout from '../../../layouts/Layout.astro';
import { siteName } from '../../../data/site';
import { TestResultAnalysis } from '../../../components/test-series/TestResultAnalysis';

const { attemptId } = Astro.params;

if (!attemptId) {
  return Astro.redirect('/profile');
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Layout title={`Test Result & Detailed Analysis | ${siteName}`} noindex>
  <div class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <TestResultAnalysis client:load attemptId={attemptId} />
  </div>
</Layout>
