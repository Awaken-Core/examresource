---
import Layout from '../../../layouts/Layout.astro';
import { siteName, siteDomain, siteUrl } from '../../../data/site';
import { fetchPublicJson } from '../../../lib/publicFetch';
import { TestInstructions } from '../../../components/test-series/TestInstructions';

const { testId } = Astro.params;

if (!testId) {
  return Astro.redirect('/test-series');
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');

interface TestSeo {
  title?: string;
  slug?: string | null;
  description?: string | null;
  durationMinutes?: number | null;
  totalQuestionsCount?: number;
  positiveMarks?: number;
  negativeMarks?: number;
  negativeMarkingEnabled?: boolean;
  languages?: string[];
  testMode?: string;
}

const testSeo = await fetchPublicJson<TestSeo>(`/test-series/tests/${encodeURIComponent(testId)}`);

if (!testSeo) {
  return Astro.redirect('/test-series');
}

// 301 Permanent Redirect to canonical SEO slug if accessed via MongoDB ObjectId
if (testSeo.slug && testId.toLowerCase() !== testSeo.slug.toLowerCase()) {
  return Astro.redirect(`/test-series/instructions/${testSeo.slug}`, 301);
}

const testTitle = testSeo?.title?.trim();
const durationText = testSeo?.durationMinutes ? `${testSeo.durationMinutes} minutes` : 'the allotted time';
const questionText = testSeo?.totalQuestionsCount ? `${testSeo.totalQuestionsCount} questions` : 'the published question set';
const markingText = testSeo?.negativeMarkingEnabled
  ? `A correct answer scores +${testSeo.positiveMarks ?? 1}. An incorrect answer scores -${testSeo.negativeMarks ?? 0}.`
  : `A correct answer scores +${testSeo?.positiveMarks ?? 1}. There is no negative marking.`;
const pageTitle = testTitle
  ? `${testTitle} Instructions & Exam Pattern | ${siteName}`
  : `Test Instructions & Exam Pattern | ${siteName}`;
const pageDescription = testSeo?.description?.trim()
  || (testTitle
    ? `Read the instructions and marking scheme for ${testTitle} before the timed paper. ${questionText} in ${durationText} on ${siteName}.`
    : `Read the official examination guidelines, section breakdown, and marking scheme before starting your timed test on ${siteDomain}.`);
const canonicalUrl = `${siteUrl}/test-series/instructions/${testSeo?.slug || testId}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Quiz',
      name: testTitle || 'Mock test',
      description: pageDescription,
      url: canonicalUrl,
      educationalUse: 'assessment',
      inLanguage: testSeo?.languages?.length ? testSeo.languages : ['English', 'Hindi'],
      provider: { '@type': 'Organization', name: siteName, url: siteUrl },
      timeRequired: testSeo?.durationMinutes ? `PT${testSeo.durationMinutes}M` : undefined,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Test Series',
          item: `${siteUrl}/test-series`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: testTitle || 'Instructions',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'When do the test questions open?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The questions open after you agree to the code of conduct. Until then, responses are not recorded.',
          },
        },
        {
          '@type': 'Question',
          name: 'Which response is graded?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Save and next stores the current response. On the last question, save and end asks you to confirm that you are ready to end. The latest saved response is graded.',
          },
        },
        {
          '@type': 'Question',
          name: 'How is the paper laid out?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The question stays on the left and the options stay on the right. Single-correct choices use a round control. Multiple-correct choices use a square control. The palette marks the current question.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="w-full max-w-none px-4 sm:px-6 lg:px-8 py-5 sm:py-7">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-1.5 text-xs text-muted mb-4" aria-label="Breadcrumb">
      <a href="/" data-astro-prefetch="hover" class="hover:text-white transition">Home</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/test-series" data-astro-prefetch="hover" class="hover:text-white transition">Test Series</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-white font-medium">Pre-Test Instructions</span>
    </nav>

    {/* Dynamic Test Instructions Island */}
    <TestInstructions client:load testId={testId} initialData={testSeo as any} />

    <section class="max-w-3xl mt-8 space-y-4" aria-labelledby="exam-rules-heading">
      <h2 id="exam-rules-heading" class="text-lg font-bold text-slate-900 dark:text-white">
        How this computer-based paper runs
      </h2>
      <p class="text-sm leading-6 text-muted">
        {testTitle ? `${testTitle} contains ${questionText} and runs for ${durationText}.` : `This paper contains ${questionText} and runs for ${durationText}.`}
        {' '}{markingText}
        The question stays on the left. The options stay on the right. A round control means one answer. A square control means every correct option must be selected.
      </p>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">When do the questions open?</h3>
      <p class="text-sm leading-6 text-muted">
        After you agree to the code of conduct. Until that agreement, the question palette does not record an answer.
      </p>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">Which response is graded?</h3>
      <p class="text-sm leading-6 text-muted">
        Save and next stores the response before the next question. On the last question, save and end asks whether you are ready to end the examination. The latest saved response is the one that counts.
      </p>
    </section>
  </div>
</Layout>
