---
import Layout from '../../../layouts/Layout.astro';
import { siteName, siteDomain } from '../../../data/site';
import { TestInstructions } from '../../../components/test-series/TestInstructions';

const { testId } = Astro.params;

if (!testId) {
  return Astro.redirect('/test-series');
}

// Edge CDN caching: 60s
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');

const pageTitle = `Test Instructions | ${siteName}`;
const pageDescription = `Read the official examination guidelines, section breakdown, and marking scheme before starting your timed test on ${siteDomain}.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${Astro.url.origin}/test-series/instructions/${testId}`}
>
  <div class="w-full max-w-none px-4 sm:px-6 lg:px-8 py-5 sm:py-7">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-1.5 text-xs text-muted mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition">Home</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/test-series" class="hover:text-white transition">Test Series</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-white font-medium">Pre-Test Instructions</span>
    </nav>

    {/* Dynamic Test Instructions Island */}
    <TestInstructions client:load testId={testId} />
  </div>
</Layout>
