---
import Layout from '../../../layouts/Layout.astro';
import { siteName } from '../../../data/site';
import { CBTTestRunner } from '../../../components/test-series/CBTTestRunner';

const { attemptId } = Astro.params;

if (!attemptId) {
  return Astro.redirect('/test-series');
}

// Disable caching for live exam attempt screen
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');

const pageTitle = `CBT Candidate Examination Session | ${siteName}`;
const pageDescription =
  'Secure Computer-Based Testing environment with real-time proctoring and official examination protocol.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  hideHeaderFooter={true}
  noindex={true}
>
  <main class="w-full max-w-none px-3 sm:px-5 lg:px-6 py-3 min-h-screen">
    <CBTTestRunner client:only="react" attemptId={attemptId} />
  </main>
</Layout>
