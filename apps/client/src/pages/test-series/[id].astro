---
import Layout from '../../layouts/Layout.astro';
import { API_URL } from '../../lib/api';
import { siteName, siteDomain } from '../../data/site';

const { id } = Astro.params;

// Edge CDN caching: 60s
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');

interface QuestionOption {
  id: string;
  _id?: string;
  content: string;
  imageUrl?: string | null;
  position: number;
}

interface ExamQuestion {
  id: string;
  _id?: string;
  content: string;
  subject?: string;
  type: string;
  difficulty: 'easy' | 'medium' | 'hard';
  marks: number;
  negativeMarks: number;
  position: number;
  options: QuestionOption[];
}

interface ExamDetail {
  id: string;
  _id?: string;
  title: string;
  description?: string | null;
  type: 'exam' | 'quiz' | 'current_affairs_quiz';
  status: 'draft' | 'published' | 'archived';
  subject?: string | null;
  durationMinutes?: number | null;
  questionsCount?: number;
  createdAt?: string;
  updatedAt?: string;
  questions: ExamQuestion[];
}

import { mockTestSeriesData } from '../../data/test-series';

let exam: ExamDetail | null = null;
let fetchError: string | null = null;

try {
  const res = await fetch(`${API_URL}/exams/${id}`, {
    signal: AbortSignal.timeout(3000),
  });

  if (res.ok) {
    exam = await res.json();
  }
} catch {
  // Gracefully fallback to mock record if backend is unavailable or not seeded
}

// Fallback to mock data if id matches mock series
if (!exam) {
  const mockItem = mockTestSeriesData.find((m) => m.id === id);
  if (mockItem) {
    exam = {
      id: mockItem.id,
      title: mockItem.title,
      description: mockItem.description,
      type: 'exam',
      status: 'published',
      subject: mockItem.organization,
      durationMinutes: 90,
      questionsCount: mockItem.totalTests,
      questions: [
        {
          id: 'q1',
          content: 'Which article of the Indian Constitution provides for the establishment of the Finance Commission?',
          type: 'single_choice',
          difficulty: 'medium',
          marks: 2,
          negativeMarks: 0.5,
          position: 0,
          options: [
            { id: 'o1', content: 'Article 280', position: 0 },
            { id: 'o2', content: 'Article 324', position: 1 },
            { id: 'o3', content: 'Article 356', position: 2 },
            { id: 'o4', content: 'Article 360', position: 3 },
          ],
        },
        {
          id: 'q2',
          content: 'The headquarters of the Reserve Bank of India is situated in which of the following cities?',
          type: 'single_choice',
          difficulty: 'easy',
          marks: 2,
          negativeMarks: 0.5,
          position: 1,
          options: [
            { id: 'o5', content: 'New Delhi', position: 0 },
            { id: 'o6', content: 'Mumbai', position: 1 },
            { id: 'o7', content: 'Kolkata', position: 2 },
            { id: 'o8', content: 'Chennai', position: 3 },
          ],
        },
      ],
    };
  } else {
    return Astro.rewrite('/404');
  }
}

const totalQuestions = exam?.questions?.length || exam?.questionsCount || 0;
const totalMarks = exam?.questions?.reduce((sum, q) => sum + (q.marks || 1), 0) || 0;
const pageTitle = `${exam?.title || 'Test Series Detail'} | ${siteName}`;
const pageDescription = exam?.description || `Practise ${exam?.title} mock test on ${siteDomain}. Authentic exam questions, timed interface, and detailed performance insights.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${Astro.url.origin}/test-series/${id}`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition">Home</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/test-series" class="hover:text-white transition">Test Series</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-white font-medium truncate max-w-[200px] sm:max-w-md">{exam?.title || 'Overview'}</span>
    </nav>

    {fetchError ? (
      <div class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-5 text-sm text-rose-300">
        <h2 class="font-semibold text-rose-200">Unable to load exam details</h2>
        <p class="text-xs text-rose-300/80 mt-1">{fetchError}</p>
        <a href="/test-series" class="mt-4 inline-block text-xs font-semibold text-accent hover:underline">
          &larr; Back to all test series
        </a>
      </div>
    ) : exam && (
      <>
        {/* Main Header Card */}
        <section class="bg-surface border border-border rounded-2xl p-6 sm:p-8 shadow-2xs">
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
            <div class="space-y-3 flex-1 min-w-0">
              {/* Badges */}
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-surface-raised border border-border text-muted">
                  {exam.subject || 'General Studies'}
                </span>
                <span class="text-xs font-semibold uppercase tracking-wider text-accent bg-accent/10 px-2.5 py-0.5 rounded">
                  {exam.type === 'current_affairs_quiz'
                    ? 'Current Affairs'
                    : exam.type === 'quiz'
                    ? 'Daily Quiz'
                    : 'Full Length Mock'}
                </span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">
                  Free Access
                </span>
              </div>

              {/* Title */}
              <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
                {exam.title}
              </h1>

              {/* Description */}
              {exam.description && (
                <p class="text-sm text-muted leading-relaxed max-w-3xl">
                  {exam.description}
                </p>
              )}
            </div>

            {/* Primary Action Button Box */}
            <div class="w-full md:w-56 shrink-0 bg-surface-raised/50 border border-border rounded-xl p-4 flex flex-col justify-between gap-3 text-center">
              <div>
                <span class="text-[11px] uppercase tracking-wider font-semibold text-muted">Test Status</span>
                <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 mt-0.5">Available for Practice</p>
              </div>

              <button
                id="start-attempt-btn"
                type="button"
                data-exam-id={exam.id}
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-accent text-white hover:bg-accent/90 active:scale-[0.98] transition shadow-2xs cursor-pointer"
              >
                <span>Start Mock Test</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>

              <p class="text-[10px] text-muted">
                Requires login to record attempts & history
              </p>
            </div>
          </div>

          {/* Key Metrics Strip */}
          <div class="mt-6 pt-6 border-t border-border/60 grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="space-y-0.5">
              <span class="text-[11px] font-medium text-muted">Total Questions</span>
              <p class="text-base font-bold text-white">{totalQuestions}</p>
            </div>
            <div class="space-y-0.5">
              <span class="text-[11px] font-medium text-muted">Total Marks</span>
              <p class="text-base font-bold text-white">{totalMarks > 0 ? totalMarks : `${totalQuestions} M`}</p>
            </div>
            <div class="space-y-0.5">
              <span class="text-[11px] font-medium text-muted">Duration</span>
              <p class="text-base font-bold text-white">
                {exam.durationMinutes ? `${exam.durationMinutes} Minutes` : 'Untimed'}
              </p>
            </div>
            <div class="space-y-0.5">
              <span class="text-[11px] font-medium text-muted">Language Support</span>
              <p class="text-base font-bold text-white">English / Hindi</p>
            </div>
          </div>
        </section>

        {/* Test Contents & Syllabus Section */}
        <section class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-white tracking-tight">
              Test Syllabus & Question Breakdown
            </h2>
            <span class="text-xs text-muted">
              {totalQuestions} questions in this paper
            </span>
          </div>

          {/* Questions Preview List (Clean editorial accordion / preview) */}
          <div class="bg-surface border border-border rounded-2xl divide-y divide-border/60 shadow-2xs overflow-hidden">
            {exam.questions && exam.questions.length > 0 ? (
              exam.questions.map((q, idx) => (
                <div class="p-4 sm:p-5 flex items-start gap-4 hover:bg-surface-raised/30 transition">
                  <span class="shrink-0 w-7 h-7 rounded-lg bg-surface-raised border border-border flex items-center justify-center text-xs font-semibold text-muted">
                    {idx + 1}
                  </span>
                  <div class="flex-1 min-w-0 space-y-2">
                    <p class="text-xs sm:text-sm font-medium text-white leading-relaxed">
                      {q.content}
                    </p>

                    {/* Options list preview without leaking answers */}
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                      {q.options.map((opt, optIdx) => (
                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border/60 bg-surface-raised/40 text-xs text-muted">
                          <span class="w-4 h-4 rounded-full border border-border/80 flex items-center justify-center text-[10px] font-semibold text-muted shrink-0">
                            {String.fromCharCode(65 + optIdx)}
                          </span>
                          <span class="truncate">{opt.content}</span>
                        </div>
                      ))}
                    </div>

                    <div class="flex items-center gap-3 text-[11px] text-muted pt-1">
                      <span>Marks: <strong class="text-white">+{q.marks || 1}</strong></span>
                      {q.negativeMarks > 0 && (
                        <span>Negative: <strong class="text-rose-400">-{q.negativeMarks}</strong></span>
                      )}
                      <span class="capitalize">Difficulty: {q.difficulty || 'medium'}</span>
                    </div>
                  </div>
                </div>
              ))
            ) : (
              <div class="p-8 text-center text-xs text-muted">
                Question details are currently being curated for this test paper.
              </div>
            )}
          </div>
        </section>

        {/* Practice Guidelines Section */}
        <section class="bg-surface-raised/30 border border-border rounded-2xl p-5 text-xs text-muted space-y-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-white">Guidelines for Candidates</h3>
          <ul class="list-disc list-inside space-y-1 leading-relaxed text-muted">
            <li>Ensure a stable network connection before starting timed examination attempts.</li>
            <li>Once started, the countdown timer will continue until submission or duration expiry.</li>
            <li>Marks and negative marking follow standard commission rules as specified per question.</li>
            <li>Detailed answer explanations and question-level performance will be available immediately upon submission.</li>
          </ul>
        </section>
      </>
    )}
  </div>

  {/* Client-side attempt starter script */}
  <script is:inline>
    (function () {
      function setupAttemptBtn() {
        const btn = document.getElementById('start-attempt-btn');
        if (!btn) return;

        btn.addEventListener('click', async () => {
          const examId = btn.getAttribute('data-exam-id');
          if (!examId) return;

          btn.disabled = true;
          const originalText = btn.innerHTML;
          btn.innerHTML = '<span>Checking session...</span>';

          try {
            const apiRes = await fetch(`/api/v1/exams/${examId}/attempts`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Protection': '1' },
              credentials: 'include',
            });

            if (apiRes.status === 401 || apiRes.status === 403) {
              window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
              return;
            }

            if (!apiRes.ok) {
              const errData = await apiRes.json().catch(() => ({}));
              alert(errData.message || 'Unable to start attempt. Please log in or try again.');
              btn.disabled = false;
              btn.innerHTML = originalText;
              return;
            }

            const attempt = await apiRes.json();
            alert(`Attempt #${attempt.attemptNumber || 1} initialized. Test attempt screen is coming in the next release.`);
            btn.disabled = false;
            btn.innerHTML = originalText;
          } catch (err) {
            alert('Could not connect to the server. Please check your internet connection.');
            btn.disabled = false;
            btn.innerHTML = originalText;
          }
        });
      }

      setupAttemptBtn();
      document.addEventListener('astro:page-load', setupAttemptBtn);
    })();
  </script>
</Layout>
