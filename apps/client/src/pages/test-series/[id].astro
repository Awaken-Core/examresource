---
import Layout from '../../layouts/Layout.astro';
import { siteName, siteDomain } from '../../data/site';
import { TestSeriesDetail } from '../../components/test-series/TestSeriesDetail';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/test-series');
}

// Edge CDN caching: 60s
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');

const pageTitle = `Test Series Overview | ${siteName}`;
const pageDescription = `Explore subject-wise, chapter-wise and full tests for this competitive exam on ${siteDomain}.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${Astro.url.origin}/test-series/${id}`}
>
  <div class="w-full max-w-none px-4 sm:px-6 lg:px-8 py-5 sm:py-7 space-y-5">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-1.5 text-xs text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition">Home</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/test-series" class="hover:text-white transition">Test Series</a>
      <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-white font-medium truncate max-w-[200px] sm:max-w-md">Detail</span>
    </nav>

    {/* Dynamic Test Series Detail Island */}
    <TestSeriesDetail client:load seriesIdOrSlug={id} />
  </div>
</Layout>
