---
import Layout from '../../layouts/Layout.astro';
import { siteName, siteDomain, siteUrl } from '../../data/site';
import { fetchPublicJson } from '../../lib/publicFetch';
import { TestSeriesDetail } from '../../components/test-series/TestSeriesDetail';
import { normalizeTestsPayload, TESTS_API_PAGE_SIZE } from '../../lib/testList';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/test-series');
}

// Redirect legacy or alternate slugs to canonical series
if (id.toLowerCase() === 'dsssb-tgt-cs') {
  return Astro.redirect('/test-series/dsssb-tgt-computer-science', 301);
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('Vary', 'Accept-Encoding');

interface SeriesSeo {
  title?: string;
  description?: string | null;
  targetExam?: string;
  category?: string;
  organization?: string | null;
  slug?: string;
  accessType?: string;
  supportedLanguages?: string[];
  subjects?: Array<{ name?: string; customDisplayName?: string | null }>;
}

// Fetch series metadata + first page of full/PYQ tests (avoid serializing entire catalogs into HTML)
const [seriesSeo, fullTestsPayload, pyqTestsPayload] = await Promise.all([
  fetchPublicJson<SeriesSeo>(`/test-series/${encodeURIComponent(id)}`),
  fetchPublicJson<unknown>(
    `/test-series/${encodeURIComponent(id)}/tests?testMode=full&limit=${TESTS_API_PAGE_SIZE}&page=1`,
  ),
  fetchPublicJson<unknown>(
    `/test-series/${encodeURIComponent(id)}/tests?testMode=pyq&limit=${TESTS_API_PAGE_SIZE}&page=1`,
  ),
]);

if (!seriesSeo) {
  return Astro.redirect('/test-series');
}

// 301 Permanent Redirect to canonical SEO slug if accessed via MongoDB ObjectId or alternate casing
if (seriesSeo.slug && id.toLowerCase() !== seriesSeo.slug.toLowerCase()) {
  return Astro.redirect(`/test-series/${seriesSeo.slug}`, 301);
}

const isPyqPaper = (t: any) =>
  t.testMode === 'pyq' ||
  (t.slug && t.slug.toLowerCase().startsWith('pyq-')) ||
  (t.title && (t.title.startsWith('[PYQ]') || t.title.includes('PYQ')));

const fullPage = normalizeTestsPayload(fullTestsPayload);
const pyqPage = normalizeTestsPayload(pyqTestsPayload);
const initialFullTests = fullPage.items.filter((t: any) => !isPyqPaper(t));
const initialPyqTests = [
  ...pyqPage.items,
  ...fullPage.items.filter((t: any) => isPyqPaper(t)),
];
const initialFullTestsTotal = fullPage.total;
const initialPyqTestsTotal = pyqPage.total;

const seriesTitle = seriesSeo?.title?.replace(/[\u2014\u2013]/g, ' - ').replace(/\s+-\s+/g, ' - ').trim();
const subjectNames = (seriesSeo?.subjects ?? [])
  .map((subject) => subject.customDisplayName?.trim() || subject.name?.trim())
  .filter((name): name is string => Boolean(name))
  .slice(0, 12);
const pageTitle = seriesTitle
  ? `${seriesTitle} Mock Tests & CBT Practice | ${siteName}`
  : `Test Series Overview & Mock Tests | ${siteName}`;
const pageDescription = seriesSeo?.description?.trim()
  || (seriesTitle
    ? `${seriesTitle} complete online practice test series on ${siteName}. Includes subject tests, chapter tests, and full-length CBT mock tests with instant analysis.`
    : `Explore subject-wise, chapter-wise and full tests for this competitive exam on ${siteDomain}.`);
const canonicalUrl = `${siteUrl}/test-series/${seriesSeo?.slug || id}`;
const jsonLd = seriesTitle
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'LearningResource',
          name: seriesTitle,
          description: pageDescription,
          url: canonicalUrl,
          learningResourceType: 'Quiz',
          educationalUse: 'practice',
          inLanguage: seriesSeo?.supportedLanguages?.length ? seriesSeo.supportedLanguages : ['en', 'hi'],
          about: seriesSeo?.targetExam ? { '@type': 'Thing', name: seriesSeo.targetExam } : undefined,
          provider: { '@type': 'Organization', name: siteName, url: siteUrl },
          isAccessibleForFree: seriesSeo?.accessType === 'free' ? true : undefined,
          teaches: subjectNames.length ? subjectNames.join(', ') : undefined,
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'Home',
              item: siteUrl,
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: 'Test Series',
              item: `${siteUrl}/test-series`,
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: seriesTitle,
              item: canonicalUrl,
            },
          ],
        },
      ],
    }
  : undefined;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  isEditorialTheme={true}
>
  <div class="mx-auto w-full max-w-7xl px-3 py-4 sm:px-5 sm:py-6 lg:px-8">
    <nav class="mb-4 flex flex-wrap items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
      <a href="/" data-astro-prefetch="hover" class="rounded-md hover:text-heading transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Home</a>
      <span class="text-muted/60" aria-hidden="true">&gt;</span>
      <a href="/test-series" data-astro-prefetch="hover" class="rounded-md hover:text-heading transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Test Series</a>
      <span class="text-muted/60" aria-hidden="true">&gt;</span>
      <span class="inline-flex items-center rounded-full border border-amber-300/80 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-300">
        {seriesTitle || 'Aptitude & Reasoning Master Exam 2026'}
      </span>
    </nav>

    <TestSeriesDetail
      client:idle
      seriesIdOrSlug={id}
      initialData={seriesSeo as any}
      initialFullTests={initialFullTests}
      initialPyqTests={initialPyqTests}
      initialFullTestsTotal={initialFullTestsTotal}
      initialPyqTestsTotal={initialPyqTestsTotal}
    />

    {seriesTitle && (
      <details class="group mt-6 rounded-card border border-border bg-surface">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 py-2 text-body-sm font-semibold text-heading focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
          About this series
          <svg class="h-4 w-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div class="space-y-2 px-4 pb-4 text-body-sm leading-6 text-muted">
          <p>
            {pageDescription}
            {seriesSeo?.organization ? ` Prepared for ${seriesSeo.organization}.` : ''}
            {subjectNames.length ? ` Subjects include ${subjectNames.join(', ')}.` : ''}
          </p>
          <p>
            The live paper keeps each question on the left and the choices on the right. Answers open only after the code of conduct is accepted, and the latest saved response is the one that counts.
          </p>
        </div>
      </details>
    )}
  </div>
</Layout>
