---
import Layout from '../../layouts/Layout.astro';
import { siteName, siteDomain, siteUrl } from '../../data/site';
import {
  heroStats,
  featureShortcuts,
} from '../../data/test-series';
import { TestSeriesExplorer } from '../../components/test-series/TestSeriesExplorer';

// Edge CDN caching: 60s
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');



const pageTitle = `Online Test Series & Free Mock Tests 2026 | ${siteName}`;
const pageDescription = `Practice online mock test series for SSC, RRB Railways, Banking, UPSC, and State Govt Exams on ${siteDomain}. Free subject-wise, chapter-wise & full CBT mock tests with instant score analysis.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: `${siteUrl}/test-series`,
      provider: { '@type': 'Organization', name: siteName, url: siteUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Test Series',
          item: `${siteUrl}/test-series`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How does a live mock test work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The live paper fills the screen. The question stays on the left, the choices stay on the right, and the palette shows which questions are answered, unanswered, marked for review, or not visited.',
          },
        },
        {
          '@type': 'Question',
          name: 'When are mock test answers saved?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Save and next stores the current response. On the last question, save and end asks you to confirm that you are ready to end. The latest saved response is graded.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens before the questions open?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'You agree to the code of conduct first. Until then, the test questions do not accept answers.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${siteUrl}/test-series`}
  jsonLd={jsonLd}
>
  {/* Common Hero Wrapper: light and dark mode images and seamless matching backgrounds */}
  <section class="test-series-hero-wrapper relative overflow-hidden bg-[#EEF5FF] dark:bg-[#182648] border-b border-[#DBEAFE] dark:border-blue-900/40 w-full shadow-xs">
    {/* Light Mode Illustration */}
    <div 
      class="hero-illustration-light absolute right-0 top-0 bottom-0 h-full w-full md:w-[65%] lg:w-[60%] pointer-events-none select-none bg-no-repeat bg-right bg-cover md:bg-contain opacity-100"
      style="background-image: url('/testimage.png'); background-position: right top;"
      aria-hidden="true"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-[#EEF5FF] via-[#EEF5FF]/40 to-transparent"></div>
    </div>

    {/* Dark Mode Illustration */}
    <div 
      class="hero-illustration-dark absolute right-0 top-0 bottom-0 h-full w-full md:w-[65%] lg:w-[60%] pointer-events-none select-none bg-no-repeat bg-right bg-cover md:bg-contain opacity-100"
      style="background-image: url('/testimage-dark.png'); background-position: right top;"
      aria-hidden="true"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-[#182648] via-[#182648]/40 to-transparent"></div>
    </div>

    {/* Content Container spanning full page width */}
    <div class="relative z-10 w-full max-w-none px-4 sm:px-6 lg:px-8 py-3.5 sm:py-5 space-y-2.5">
      {/* Breadcrumbs covered by the continuous background */}
      <nav class="flex items-center gap-1.5 text-xs" aria-label="Breadcrumb">
        <a href="/" class="text-accent font-medium hover:underline">Home</a>
        <svg class="w-3.5 h-3.5 text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white font-medium">Test Series</span>
      </nav>

      {/* Hero Content Left */}
      <div class="w-full max-w-2xl lg:max-w-3xl space-y-2 pt-0.5 pb-1.5">
        <span class="inline-block text-[11px] font-bold tracking-wider uppercase text-accent">
          PRACTICE SMARTER
        </span>

        <h1 class="text-2xl sm:text-3xl lg:text-[34px] font-extrabold tracking-tight text-white leading-tight">
          Test Series
        </h1>

        <p class="text-xs sm:text-[13px] text-muted leading-relaxed max-w-lg">
          Get exam-ready with structured mock tests, previous year papers and chapter-wise practice for all major government exams.
        </p>

        {/* 4 Compact Stats - Single Row Desktop */}
        <div class="pt-2.5 flex items-center gap-x-5 gap-y-2 overflow-x-auto scrollbar-none">
          {heroStats.map((st) => (
            <div class="flex items-center gap-2 shrink-0">
              <div class="w-7 h-7 rounded-lg bg-accent/15 border border-accent/25 flex items-center justify-center shrink-0 text-accent">
                {st.icon === 'categories' && (
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                )}
                {st.icon === 'tests' && (
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                )}
                {st.icon === 'students' && (
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                )}
                {st.icon === 'language' && (
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
              </div>
              <div class="flex items-baseline gap-1">
                <span class="text-xs sm:text-[13px] font-bold text-white leading-none">{st.value}</span>
                <span class="text-[11px] text-muted font-medium leading-none">{st.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Main content below the hero section */}
  <div class="w-full max-w-none px-4 sm:px-6 lg:px-8 py-4 sm:py-5 space-y-4">

    {/* Feature Shortcut Row (4 Horizontal Cards) */}
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {featureShortcuts.map((item) => (
        <a
          href={item.href}
          class="group flex items-center justify-between p-3.5 rounded-xl bg-surface border border-border hover:border-accent/50 hover:shadow-md transition-all duration-200 shadow-2xs"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 ${
              item.id === 'mock-tests' ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20' :
              item.id === 'chapter-tests' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' :
              item.id === 'ai-generator' ? 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20' :
              'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20'
            }`}>
              {item.icon === 'doc' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              )}
              {item.icon === 'list' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
              )}
              {item.icon === 'ai' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {item.icon === 'note' && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              )}
            </div>
            <div class="min-w-0">
              <h2 class="text-xs sm:text-[13px] font-bold text-white group-hover:text-accent transition-colors truncate">
                {item.title}
              </h2>
              <p class="text-[11px] text-muted truncate">{item.description}</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-muted group-hover:text-accent group-hover:translate-x-0.5 transition shrink-0 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </section>

    {/* Real Published Test Series Explorer Island */}
    <TestSeriesExplorer client:load />

    <section class="max-w-3xl space-y-3 pt-2" aria-labelledby="cbt-faq-heading">
      <h2 id="cbt-faq-heading" class="text-lg font-bold text-slate-900 dark:text-white">
        How the computer-based mock test works
      </h2>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">How does a live mock test work?</h3>
      <p class="text-sm leading-6 text-muted">
        The live paper fills the screen. The question stays on the left, the choices stay on the right, and the palette shows which questions are answered, unanswered, marked for review, or not visited.
      </p>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">When are answers saved?</h3>
      <p class="text-sm leading-6 text-muted">
        Save and next stores the current response. On the last question, save and end asks you to confirm that you are ready to end. The latest saved response is graded.
      </p>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">What happens before the questions open?</h3>
      <p class="text-sm leading-6 text-muted">
        You agree to the code of conduct first. Until then, the test questions do not accept answers.
      </p>
    </section>

  </div>



  <style is:global>
    /* Default / Light Mode */
    .hero-illustration-light {
      display: block !important;
    }
    .hero-illustration-dark {
      display: none !important;
    }

    /* Dark Mode */
    html.theme-dark .test-series-hero-wrapper {
      background-color: #182648 !important;
    }
    html.theme-dark .hero-illustration-light {
      display: none !important;
    }
    html.theme-dark .hero-illustration-dark {
      display: block !important;
    }
  </style>
</Layout>
