---
import Layout from '../../layouts/Layout.astro';
import { siteName, siteDomain, siteUrl } from '../../data/site';
import { fetchPublicJson } from '../../lib/publicFetch';
import { TestSeriesExplorer } from '../../components/test-series/TestSeriesExplorer';
import { TestSeriesBannerCarousel } from '../../components/test-series/TestSeriesBannerCarousel';

// Edge CDN caching: 60s
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
Astro.response.headers.set('Vary', 'Accept-Encoding');

const initialSeries = (await fetchPublicJson<any[]>('/test-series')) || [];

const pageTitle = `Online Test Series & Free Mock Tests 2026 | ${siteName}`;
const pageDescription = `Practice online mock test series for DSSSB TGT Computer Science, SSC CGL, RRB Railways, and Teaching Govt Exams on ${siteDomain}. Free subject-wise, chapter-wise & full CBT mock tests with instant score analysis.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: `${siteUrl}/test-series`,
      provider: { '@type': 'Organization', name: siteName, url: siteUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Test Series',
          item: `${siteUrl}/test-series`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How does a live mock test work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The live paper fills the screen. The question stays on the left, the choices stay on the right, and the palette shows which questions are answered, unanswered, marked for review, or not visited.',
          },
        },
        {
          '@type': 'Question',
          name: 'When are mock test answers saved?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Save and next stores the current response. On the last question, save and end asks you to confirm that you are ready to end. The latest saved response is graded.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens before the questions open?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'You agree to the code of conduct first. Until then, the test questions do not accept answers.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${siteUrl}/test-series`}
  jsonLd={jsonLd}
  isEditorialTheme={true}
>
  <div class="relative min-h-screen bg-editorial-bg text-editorial-text selection:bg-editorial-accent/20 selection:text-editorial-accent">

    {/* Main Container aligned with Blogs max-w-6xl */}
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8 lg:px-12 pt-3 sm:pt-4 pb-16 flex flex-col gap-5 sm:gap-6">

      {/* ══════════════════════════════════════════════════════════
          1. BREADCRUMBS
          ══════════════════════════════════════════════════════════ */}
      <section class="space-y-2" aria-label="Breadcrumb Navigation">
        <h1 class="sr-only">Online Test Series & Free Mock Tests 2026</h1>
        {/* Subtle Breadcrumbs */}
        <nav class="flex items-center gap-1.5 font-['Geist'] text-[11.5px] text-editorial-muted" aria-label="Breadcrumb">
          <a href="/" data-astro-prefetch="hover" class="hover:text-editorial-heading transition-colors">Home</a>
          <svg class="w-3 h-3 text-editorial-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-editorial-heading font-medium">Test Series</span>
        </nav>
      </section>

      {/* ══════════════════════════════════════════════════════════
          2. FEATURED BANNER SLIDER / CAROUSEL (Testbook-style)
          ══════════════════════════════════════════════════════════ */}
      <section aria-label="Promotional and Featured Banners">
        <TestSeriesBannerCarousel client:load />
      </section>

      {/* ══════════════════════════════════════════════════════════
          3. CURATED TEST SERIES EXPLORER (React Island)
          ══════════════════════════════════════════════════════════ */}
      <section aria-label="Curated Test Series Explorer">
        <TestSeriesExplorer client:load initialList={initialSeries} />
      </section>

      {/* ══════════════════════════════════════════════════════════
          4. CBT FAQ ACCORDION / EDITORIAL GUIDE
          ══════════════════════════════════════════════════════════ */}
      <section class="mt-2 sm:mt-4 p-6 sm:p-7 rounded-2xl bg-editorial-surface border border-editorial-border space-y-4 font-['Geist']" aria-labelledby="cbt-faq-heading">
        <div class="flex items-center gap-2 pb-2 border-b border-editorial-border">
          <span class="w-1.5 h-4 bg-editorial-accent rounded-full inline-block"></span>
          <h2 id="cbt-faq-heading" class="font-['EB_Garamond'] text-xl sm:text-2xl font-normal text-editorial-heading tracking-tight">
            How Computer-Based Tests Work
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-1 text-[13px]">
          <div class="space-y-1.5">
            <h3 class="font-semibold text-editorial-heading text-[13.5px]">Live Exam Interface</h3>
            <p class="text-editorial-muted leading-relaxed">
              The live paper fills the screen. Questions stay on the left, choices on the right, and the palette marks answered, unanswered, and reviewed questions.
            </p>
          </div>
          <div class="space-y-1.5">
            <h3 class="font-semibold text-editorial-heading text-[13.5px]">Auto-Save Responses</h3>
            <p class="text-editorial-muted leading-relaxed">
              "Save and Next" safely stores each answer instantly. When completing the final question, confirm submission to get graded analysis.
            </p>
          </div>
          <div class="space-y-1.5">
            <h3 class="font-semibold text-editorial-heading text-[13.5px]">Strict Code of Conduct</h3>
            <p class="text-editorial-muted leading-relaxed">
              Before test questions unlock, read and accept the instructions and code of conduct just like the real examination hall.
            </p>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>
