---
import Layout from '../../layouts/Layout.astro';
import { API_URL } from '../../lib/api';

const { category: categoryParam } = Astro.params;
const categorySlug = (categoryParam || '').toLowerCase();

// Fetch live database articles for this category and all categories for navigation
let liveCategoryPosts: any[] = [];
let categoryInfo: any = null;
let allCategories: any[] = [];

try {
  const [postRes, catRes] = await Promise.all([
    fetch(`${API_URL}/blogs?category=${encodeURIComponent(categorySlug)}&limit=50`),
    fetch(`${API_URL}/categories`),
  ]);

  if (postRes.ok) liveCategoryPosts = await postRes.json();
  if (catRes.ok) {
    allCategories = await catRes.json();
    categoryInfo = allCategories.find((c: any) => c.slug === categorySlug);
  }
} catch (e) {
  liveCategoryPosts = [];
}

// Fallback category titles if categories endpoint returns empty
const defaultCategoryNames: Record<string, string> = {
  'central-government': 'Central Government',
  'state-exams': 'State Exams',
  'banking': 'Banking',
  'ssc-railways': 'SSC & Railways',
  'teaching': 'Teaching',
  'defence': 'Defence',
};

const categoryTitle = categoryInfo?.name || defaultCategoryNames[categorySlug] || categorySlug.replace(/-/g, ' ').toUpperCase();
const categoryDesc = categoryInfo?.description || `Browse notifications, exam patterns, syllabi, and official updates for ${categoryTitle}.`;

const pageTitle = `${categoryTitle} Exam Updates & Notifications | govtpariksha.com`;
const pageDescription = categoryDesc;
const canonicalUrl = `https://govtpariksha.com/category/${categorySlug}`;

// Schema.org structured data (BreadcrumbList & CollectionPage)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": categoryTitle,
      "description": categoryDesc,
      "url": canonicalUrl,
      "hasPart": (liveCategoryPosts || []).map((t: any) => ({
        "@type": "Article",
        "headline": t.title,
        "description": t.description || t.metaDescription,
        "url": `https://govtpariksha.com/${t.slug}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://govtpariksha.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": categoryTitle,
          "item": canonicalUrl
        }
      ]
    }
  ]
};

const displayCategories = allCategories && allCategories.length > 0 ? allCategories : [
  { name: 'Central Government', slug: 'central-government' },
  { name: 'State Exams', slug: 'state-exams' },
  { name: 'Banking', slug: 'banking' },
  { name: 'SSC & Railways', slug: 'ssc-railways' },
  { name: 'Teaching', slug: 'teaching' },
  { name: 'Defence', slug: 'defence' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      
      {/* Breadcrumb Header */}
      <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-xs text-muted">
        <a href="/" class="hover:text-accent transition">Home</a>
        <span>/</span>
        <a href="/#categories" class="hover:text-accent transition">Categories</a>
        <span>/</span>
        <span class="font-medium text-white">{categoryTitle}</span>
      </nav>

      {/* Category Pills Bar */}
      <nav aria-label="Exam Categories" class="flex items-center flex-wrap gap-2 pb-4 mb-6 border-b border-border overflow-x-auto">
        <a
          href="/"
          class="px-3 py-1.5 rounded-lg text-xs font-medium text-muted hover:text-white hover:bg-surface-raised shrink-0 transition"
        >
          All Updates
        </a>
        {displayCategories.map((c) => {
          const isActive = c.slug === categorySlug;
          return (
            <a
              href={`/category/${c.slug}`}
              class={`px-3 py-1.5 rounded-lg text-xs font-medium transition shrink-0 flex items-center gap-1.5 ${
                isActive
                  ? 'bg-surface text-accent font-semibold border border-border shadow-xs'
                  : 'text-muted hover:text-white hover:bg-surface-raised border border-transparent'
              }`}
            >
              <span>{c.name}</span>
            </a>
          );
        })}
      </nav>

      {/* Category Header Banner */}
      <header class="rounded-xl border border-border bg-surface p-6 sm:p-8 mb-8 shadow-xs">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-accent/10 text-accent text-xs font-semibold mb-3">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          Category Stream
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-2">
          {categoryTitle}
        </h1>
        <p class="text-sm sm:text-base text-muted leading-relaxed max-w-3xl">
          {categoryDesc}
        </p>
        <div class="flex items-center gap-4 text-xs text-muted mt-5 pt-4 border-t border-border">
          <span>Published Articles: <strong class="text-white">{liveCategoryPosts.length}</strong></span>
        </div>
      </header>

      {/* Articles Feed */}
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-border">
          <h2 class="text-xs uppercase tracking-wider font-bold text-muted">
            Articles in {categoryTitle}
          </h2>
          <span class="text-xs text-muted">Showing {liveCategoryPosts.length} updates</span>
        </div>

        {liveCategoryPosts.length > 0 ? (
          <div class="space-y-3">
            {liveCategoryPosts.map((post) => {
              const image = post.firstImage || post.coverImage || null;
              const date = new Date(post.publishedAt || post.updatedAt || Date.now()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
              return (
                <a 
                  href={`/${post.slug}`} 
                  class="flex flex-col sm:flex-row items-start gap-4 p-4 bg-surface border border-border rounded-lg shadow-2xs hover:shadow-xs hover:border-accent/40 transition duration-150 group cursor-pointer block"
                >
                  {/* Thumbnail on Left (only if image exists) */}
                  {image && (
                    <div class="w-full sm:w-48 h-32 sm:h-28 shrink-0 rounded-md overflow-hidden bg-surface-raised/80 border border-border/60 flex items-center justify-center p-1.5">
                      <img 
                        src={image} 
                        alt={post.title} 
                        class="max-w-full max-h-full object-contain select-none group-hover:scale-105 transition-transform duration-200" 
                        loading="lazy"
                        decoding="async"
                        width="360"
                        height="240"
                      />
                    </div>
                  )}

                  {/* Body Content */}
                  <div class="flex-1 min-w-0 flex flex-col justify-between self-stretch">
                    <div>
                      <div class="flex items-center justify-between gap-2">
                        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-accent/10 text-accent border border-accent/20">
                          {categoryTitle}
                        </span>
                        <span class="text-[11px] text-muted font-medium hidden sm:inline-block shrink-0">
                          {date}
                        </span>
                      </div>

                      <h3 class="mt-1.5 text-sm sm:text-base font-bold text-white group-hover:text-accent transition leading-snug">
                        {post.title}
                      </h3>

                      <p class="mt-1 text-xs text-muted line-clamp-2 leading-relaxed">
                        {post.description || post.metaDescription || 'Click to view full notification details and official links.'}
                      </p>
                    </div>

                    <div class="mt-3 flex items-center justify-between pt-2 border-t border-border/50 sm:border-0 sm:pt-0">
                      <span class="text-[11px] text-muted sm:hidden">
                        {date}
                      </span>
                      <span class="text-xs font-semibold text-accent group-hover:underline flex items-center gap-1 ml-auto">
                        <span>Read update</span>
                        <span aria-hidden="true">→</span>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="rounded-xl border border-border bg-surface p-10 text-center space-y-3">
            <svg class="w-10 h-10 text-muted mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <h3 class="text-base font-bold text-white">No articles published in {categoryTitle} yet</h3>
            <p class="text-xs text-muted max-w-md mx-auto">
              Our editorial desk is transcribing upcoming notices for this exam category. Check back soon or browse all current notifications on the homepage.
            </p>
            <div class="pt-2">
              <a 
                href="/" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-white font-semibold text-xs transition hover:bg-accent/90"
              >
                <span>Browse All Latest Updates</span>
                <span>→</span>
              </a>
            </div>
          </div>
        )}
      </div>

    </div>
  </div>
</Layout>
