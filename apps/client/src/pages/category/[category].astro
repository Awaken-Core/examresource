---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import { Image } from 'astro:assets';
import { API_URL } from '../../lib/api';
import { siteUrl, siteName, whatsappChannel, telegramChannel } from '../../data/site';
import {
  appLangToBlogLanguage,
  articleHref,
  preferredLangFromCookieHeader,
} from '../../lib/preferred-lang';

const { category: categoryParam } = Astro.params;
const rawCategorySlug = (categoryParam || '').toLowerCase();

// Common category slug aliases redirect cleanly to canonical category URL
const slugAliases: Record<string, string> = {
  'notifications': 'notification',
  'police-exams': 'police',
  'railway': 'railways',
  'rrb': 'railways',
  'admission': 'psu-engineering',
  'admissions': 'psu-engineering',
  'engineering': 'psu-engineering',
  'psu': 'psu-engineering',
  'latestupdate': 'latest-updates',
  'latest-update': 'latest-updates',
  'state-pcs': 'state-exams',
  'state-exam': 'state-exams',
  'latest-job': 'latest-jobs',
  'latestjob': 'latest-jobs',
  'latestjobs': 'latest-jobs',
  'jobs': 'latest-jobs',
  'job': 'latest-jobs',
};

if (slugAliases[rawCategorySlug]) {
  return Astro.redirect(`/category/${slugAliases[rawCategorySlug]}`, 301);
}

const categorySlug = rawCategorySlug;
const preferredAppLang = preferredLangFromCookieHeader(Astro.request.headers.get('cookie'));
const listLanguage = appLangToBlogLanguage(preferredAppLang);

// Fetch live database articles for this category and all categories for navigation
let liveCategoryPosts: any[] = [];
let categoryInfo: any = null;
let allCategories: any[] = [];

// Edge CDN caching: cache category list for 120s, serve stale up to 600s while revalidating
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=120, stale-while-revalidate=600');
Astro.response.headers.set('Vary', 'Cookie, Accept-Encoding');

try {
  const [postRes, catRes] = await Promise.all([
    fetch(`${API_URL}/blogs?category=${encodeURIComponent(categorySlug)}&limit=50&language=${listLanguage}`, {
      signal: AbortSignal.timeout(6000),
    }),
    fetch(`${API_URL}/categories`, {
      signal: AbortSignal.timeout(6000),
    }),
  ]);

  if (postRes.ok) liveCategoryPosts = await postRes.json();
  if (catRes.ok) {
    allCategories = await catRes.json();
    categoryInfo = allCategories.find((c: any) => c.slug === categorySlug);
  }
} catch (e) {
  liveCategoryPosts = [];
}

// If the category does not exist in the database and has no posts, return 404
if (!categoryInfo && liveCategoryPosts.length === 0) {
  return Astro.rewrite('/404');
}

const categoryTitle = categoryInfo?.name || categorySlug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

// Helper: is article published within last 3 days?
const THREE_DAYS_MS = 3 * 24 * 60 * 60 * 1000;
function computeIsNew(publishedAt: string | null | undefined): boolean {
  if (!publishedAt) return false;
  return Date.now() - new Date(publishedAt).getTime() < THREE_DAYS_MS;
}
const categoryDesc = categoryInfo?.description || `Verified recruitment notifications, exam dates, syllabi, admit cards, and official portal links for ${categoryTitle}.`;

const pageTitle = `${categoryTitle} Exam Updates & Notifications | ${siteName}`;
const pageDescription = categoryDesc;
const canonicalUrl = `${siteUrl}/category/${categorySlug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": categoryTitle,
      "description": categoryDesc,
      "url": canonicalUrl,
      "hasPart": (liveCategoryPosts || []).map((t: any) => ({
        "@type": "Article",
        "headline": t.title,
        "description": t.description || t.metaDescription,
        "url": `${siteUrl}/${t.slug}`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": categoryTitle,
          "item": canonicalUrl
        }
      ]
    }
  ]
};

const displayCategories = allCategories && allCategories.length > 0 ? allCategories : [
  { name: 'Central Govt & UPSC', slug: 'central-government' },
  { name: 'SSC Exams', slug: 'ssc' },
  { name: 'Railway Exams (RRB)', slug: 'railways' },
  { name: 'Banking & Insurance Exams', slug: 'banking' },
  { name: 'Latest Govt Jobs', slug: 'latest-jobs' },
  { name: 'Defence & Paramilitary Exams', slug: 'defence' },
  { name: 'Police Recruitment Exams', slug: 'police' },
  { name: 'Teaching & Education Exams', slug: 'teaching' },
  { name: 'PSU & Engineering Exams', slug: 'psu-engineering' },
];

const R2_PORTAL_BASE = 'https://pub-68568854a58845bc975b176de76b1ad5.r2.dev/portals';
const relevantPortals = [
  { name: 'UPSC', url: 'upsc.gov.in', href: 'https://www.upsc.gov.in/', logo: `${R2_PORTAL_BASE}/upsc.svg`, initial: 'U', bg: 'bg-[#0C2340]', textColor: 'text-[#E2B13C]' },
  { name: 'SSC', url: 'ssc.gov.in', href: 'https://ssc.gov.in/', logo: `${R2_PORTAL_BASE}/ssc.svg`, initial: 'S', bg: 'bg-[#8B0000]', textColor: 'text-[#FFD700]' },
  { name: 'Railways', url: 'rrb.indianrailways.gov.in', href: 'https://rrb.indianrailways.gov.in/', logo: `${R2_PORTAL_BASE}/railways.svg`, initial: 'R', bg: 'bg-[#003366]', textColor: 'text-[#E5A823]' },
  { name: 'IBPS', url: 'ibps.in', href: 'https://www.ibps.in/', logo: `${R2_PORTAL_BASE}/ibps.svg`, initial: 'I', bg: 'bg-[#312E81]', textColor: 'text-white' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-heading px-4 sm:px-6 lg:px-8 py-7 transition-colors duration-200">
    <div class="max-w-[1400px] mx-auto">
      
      {/* 2-Column Grid: Main Feed (Left) + Right Sidebar (Sticky) matching Home Layout */}
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_310px] xl:grid-cols-[minmax(0,1fr)_330px] gap-8 items-start">
        
        {/* MAIN FEED CONTENT */}
        <div class="min-w-0 space-y-7">
          
          {/* Breadcrumb */}
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-muted">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span>/</span>
            <a href="/#categories" class="hover:text-accent transition">Categories</a>
            <span>/</span>
            <span class="text-heading font-medium">{categoryTitle}</span>
          </nav>

          {/* Hero Header Banner */}
          <section class="p-6 sm:p-7 bg-surface border border-border rounded-xl shadow-2xs relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-44 h-44 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 space-y-3">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-accent/10 border border-accent/20 text-accent text-xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse will-change-[opacity] transform-gpu"></span>
                <span>Active Stream</span>
              </div>

              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-heading">
                  {categoryTitle}
                </h1>
                <span class="text-xs text-muted font-medium">
                  {liveCategoryPosts.length} published {liveCategoryPosts.length === 1 ? 'notice' : 'notices'}
                </span>
              </div>

              <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-3xl">
                {categoryDesc}
              </p>
              <div class="pt-3 border-t border-border/50 flex items-center gap-1.5 overflow-x-auto scrollbar-none">
                <a
                  href="/"
                  class="px-3 py-1.5 rounded-lg text-xs font-medium text-muted hover:text-heading hover:bg-surface-raised transition shrink-0"
                >
                  All
                </a>
                {displayCategories.map((c) => {
                  const isActive = c.slug === categorySlug;
                  return (
                    <a
                      href={`/category/${c.slug}`}
                      target="_blank"
                      rel="noopener"
                      data-astro-prefetch="false"
                      class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition shrink-0 border ${
                        isActive
                          ? 'bg-surface-raised text-heading border-border shadow-xs'
                          : 'text-muted hover:text-heading hover:bg-surface-raised/50 border-transparent'
                      }`}
                    >
                      {c.name}
                    </a>
                  );
                })}
              </div>
            </div>
          </section>

          {/* Notification Alert Strip */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            {whatsappChannel && (
              <div class="flex items-center justify-between p-3.5 bg-surface border border-border rounded-lg shadow-2xs gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 rounded-full bg-[#25D366]/10 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-bold text-heading truncate leading-tight">WhatsApp Alerts</p>
                    <p class="text-[11px] text-muted truncate leading-tight mt-0.5">Instant notices &amp; admit cards</p>
                  </div>
                </div>
                <a 
                  href={whatsappChannel} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-3 py-1.5 rounded-md border border-[#25D366]/40 text-[#25D366] text-xs font-semibold hover:bg-[#25D366]/10 transition shrink-0"
                >
                  Join
                </a>
              </div>
            )}

            {telegramChannel && (
              <div class="flex items-center justify-between p-3.5 bg-surface border border-border rounded-lg shadow-2xs gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 rounded-full bg-[#2AABEE]/10 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-[#2AABEE]" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-bold text-heading truncate leading-tight">Telegram Alerts</p>
                    <p class="text-[11px] text-muted truncate leading-tight mt-0.5">Real-time PDF summaries</p>
                  </div>
                </div>
                <a 
                  href={telegramChannel} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-3 py-1.5 rounded-md border border-accent/40 text-accent text-xs font-semibold hover:bg-accent/10 transition shrink-0"
                >
                  Join
                </a>
              </div>
            )}
          </div>

          {/* Articles Feed */}
          <section class="space-y-3.5">
            <div class="flex items-center justify-between pb-1 border-b border-border/50">
              <h2 class="text-sm font-bold text-heading">
                All {categoryTitle} Notices
              </h2>
              <span class="text-xs text-muted">Page 1</span>
            </div>

            {liveCategoryPosts.length > 0 ? (
              <div class="space-y-3">
                {liveCategoryPosts.map((article) => (
                  <ArticleCard
                    variant="standard"
                    title={article.title}
                    slug={article.slug}
                    href={articleHref(article.slug, preferredAppLang)}
                    category={categoryTitle}
                    publishedAt={article.publishedAt || article.updatedAt}
                    summary={article.description || article.metaDescription || 'Click to view full notification details and official links.'}
                    headingLevel="h3"
                  />
                ))}
              </div>
            ) : (
              <div class="rounded-xl border border-border bg-surface p-12 text-center space-y-3">
                <div class="w-12 h-12 rounded-full bg-surface-raised border border-border flex items-center justify-center mx-auto text-muted">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                </div>
                <h3 class="text-base font-bold text-heading">No articles published in {categoryTitle} yet</h3>
                <p class="text-xs text-muted max-w-sm mx-auto leading-relaxed">
                  Our editorial desk is preparing verified guides and exam summaries for this stream. Check back soon.
                </p>
                <div class="pt-2">
                  <a 
                    href="/" 
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-raised border border-border hover:border-accent text-heading font-semibold text-xs transition shadow-xs"
                  >
                    <span>Browse All Latest Updates</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            )}
          </section>

        </div>

        {/* RIGHT SIDEBAR (Sticky - Quick Navigation & Official Portals) */}
        <aside class="space-y-6 hidden lg:block sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto scrollbar-none">
          
          {/* Official Portals Box */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3.5 transition-colors">
            <div class="flex items-center justify-between pb-1 border-b border-border/50">
              <h3 class="text-sm font-bold text-heading">
                Official {categoryTitle} Portals
              </h3>
            </div>

            <div class="divide-y divide-border/50">
              {relevantPortals.map((portal) => (
                <a 
                  href={portal.href} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex items-center justify-between py-2.5 px-1 hover:bg-surface-raised rounded transition group cursor-pointer"
                  title={`Open official ${portal.name} portal`}
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8 h-8 rounded-full bg-surface-raised border border-border flex items-center justify-center p-1 shrink-0 overflow-hidden relative">
                      <Image 
                        src={portal.logo} 
                        alt={`${portal.name} logo`} 
                        class="w-full h-full object-contain" 
                        loading="eager"
                        decoding="async"
                        width={32}
                        height={32}
                        onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                      />
                      <div class={`w-full h-full rounded-full ${portal.bg} ${portal.textColor} hidden items-center justify-center font-bold text-[10px] select-none tracking-tight`}>
                        {portal.initial}
                      </div>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-heading group-hover:text-accent transition truncate leading-tight">
                        {portal.name}
                      </p>
                      <p class="text-[11px] text-muted truncate leading-tight mt-0.5">
                        {portal.url}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          {/* Other Categories Explorer */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3 transition-colors">
            <h3 class="text-sm font-bold text-heading pb-1 border-b border-border/50">
              Other Exam Streams
            </h3>
            <div class="space-y-1">
              {displayCategories.filter(c => c.slug !== categorySlug).map((c) => (
                <a
                  href={`/category/${c.slug}`}
                  target="_blank"
                  rel="noopener"
                  data-astro-prefetch="false"
                  class="flex items-center justify-between p-2 rounded hover:bg-surface-raised text-xs text-muted hover:text-heading transition group"
                >
                  <span class="truncate">{c.name}</span>
                  <span class="text-muted group-hover:text-accent group-hover:translate-x-0.5 transition-all text-[11px]">&rarr;</span>
                </a>
              ))}
            </div>
          </div>

        </aside>

      </div>
    </div>
  </div>
</Layout>
