---
import Layout from '../layouts/Layout.astro';
import { whatsappChannel, telegramChannel } from '../data/site';

const pageTitle = "Contact Us — govtpariksha.com Support & Editorial Desk";
const pageDescription = "Get in touch with the govtpariksha.com team for exam notification inquiries, corrections, technical assistance, or partnership proposals.";
const canonicalUrl = "https://govtpariksha.com/contact-us";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Us",
  "url": canonicalUrl,
  "description": pageDescription,
  "mainEntity": {
    "@type": "Organization",
    "name": "govtpariksha.com",
    "url": "https://govtpariksha.com",
    "logo": "https://govtpariksha.com/og-image.jpg",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@govtpariksha.com",
      "contactType": "Customer Support",
      "areaServed": "IN",
      "availableLanguage": ["en", "hi"]
    }
  },
  "breadcrumb": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://govtpariksha.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contact Us",
        "item": canonicalUrl
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white">
    {/* Hero Section */}
    <div class="border-b border-border/80 bg-surface/60 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-caption-xs text-muted">
          <a href="/" class="hover:text-accent transition">Home</a>
          <span class="text-border">/</span>
          <span class="text-white font-medium">Contact Us</span>
        </nav>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="space-y-3 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent text-caption-xs font-semibold uppercase tracking-wider">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
              </span>
              Support & Editorial Desk
            </div>
            <h1 class="text-heading-xl sm:text-heading-xxl font-extrabold text-white tracking-tight">
              Get in Touch with Us
            </h1>
            <p class="text-body-md text-muted leading-relaxed">
              Have a question about an exam pattern, spotted a corrigendum that needs updating, or want to discuss collaboration? Our team is ready to help.
            </p>
          </div>

          <div class="flex items-center gap-3 shrink-0 text-caption-xs text-muted bg-surface-raised/60 border border-border/80 px-4 py-3 rounded-xl">
            <div class="flex items-center gap-2 text-emerald-400 font-semibold">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Response SLA: Within 24-48 Hours</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Contact Cards Overview */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        
        {/* Card 1: Official Email */}
        <div class="p-6 rounded-2xl bg-surface border border-border/70 hover:border-accent/40 transition group relative overflow-hidden flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-body-md font-bold text-white mb-1">Direct Email</h3>
              <p class="text-caption-sm text-muted">For general queries, corrections, and editorial updates.</p>
            </div>
          </div>
          <div class="pt-4 mt-4 border-t border-border/50">
            <a 
              href="mailto:support@govtpariksha.com" 
              class="text-body-sm font-semibold text-accent hover:underline flex items-center gap-1.5"
            >
              <span>support@govtpariksha.com</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>

        {/* Card 2: WhatsApp Channel */}
        <div class="p-6 rounded-2xl bg-surface border border-border/70 hover:border-[#25D366]/40 transition group relative overflow-hidden flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.07-1.782-.406-1.464-.608-2.42-2.126-2.493-2.224-.072-.098-.59-1.026-.59-1.956 0-.93.486-1.385.66-1.577.174-.192.38-.24.507-.24.127 0 .253.002.364.007.119.006.278-.045.435.334.162.392.553 1.35.602 1.448.049.098.082.213.016.344-.066.13-.099.213-.197.327-.098.115-.207.257-.295.344-.099.098-.202.205-.087.402.115.197.512.844 1.098 1.366.755.672 1.391.88 1.588.978.197.098.312.082.427-.049.115-.13.493-.574.624-.77.131-.197.262-.164.442-.098.18.066 1.144.539 1.341.637.197.098.328.147.377.23.049.082.049.475-.095.88zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.178L2 22l4.981-1.395A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-body-md font-bold text-white mb-1">WhatsApp Channel</h3>
              <p class="text-caption-sm text-muted">Join over 10,000+ candidates for instant exam alerts and notifications.</p>
            </div>
          </div>
          <div class="pt-4 mt-4 border-t border-border/50">
            <a 
              href={whatsappChannel} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-body-sm font-semibold text-[#25D366] hover:underline flex items-center gap-1.5"
            >
              <span>Join WhatsApp Channel</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>

        {/* Card 3: Telegram Community */}
        <div class="p-6 rounded-2xl bg-surface border border-border/70 hover:border-[#2AABEE]/40 transition group relative overflow-hidden flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-xl bg-[#2AABEE]/10 text-[#2AABEE] flex items-center justify-center group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .36z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-body-md font-bold text-white mb-1">Telegram Community</h3>
              <p class="text-caption-sm text-muted">Real-time PDFs, syllabus revisions, and exam discussion group.</p>
            </div>
          </div>
          <div class="pt-4 mt-4 border-t border-border/50">
            <a 
              href={telegramChannel} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-body-sm font-semibold text-[#2AABEE] hover:underline flex items-center gap-1.5"
            >
              <span>Join Telegram Group</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>

    {/* Form & Support Details Section */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        {/* Left Form: Interactive Message & Correction Desk */}
        <div class="lg:col-span-7">
          <div class="p-6 sm:p-8 rounded-2xl bg-surface border border-border/80 shadow-sm relative">
            <div class="mb-6">
              <h2 class="text-heading-md font-bold text-white mb-1">Send a Message or Report an Update</h2>
              <p class="text-body-sm text-muted">
                Fill out the form below. We prioritize notification corrections, dead link reports, and candidate inquiries.
              </p>
            </div>

            {/* Success Banner (Hidden by default) */}
            <div id="contact-success-banner" class="hidden mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="text-caption-sm space-y-1">
                  <p class="font-bold text-emerald-300">Inquiry Received Successfully!</p>
                  <p class="text-emerald-400/90">Thank you for writing to us. Our editorial and support desk has logged your request and will review it promptly.</p>
                </div>
              </div>
            </div>

            {/* Interactive Form */}
            <form id="contact-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="contact-name" class="block text-caption-xs font-semibold uppercase tracking-wider text-muted">
                    Your Full Name <span class="text-accent">*</span>
                  </label>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="contact-name" 
                      name="name" 
                      required
                      placeholder="e.g. Rahul Sharma" 
                      class="w-full px-4 py-2.5 rounded-xl bg-canvas border border-border/80 text-white placeholder-muted/60 text-body-sm focus:outline-none focus:border-accent transition"
                    />
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label for="contact-email" class="block text-caption-xs font-semibold uppercase tracking-wider text-muted">
                    Email Address <span class="text-accent">*</span>
                  </label>
                  <div class="relative">
                    <input 
                      type="email" 
                      id="contact-email" 
                      name="email" 
                      required
                      placeholder="e.g. rahul@example.com" 
                      class="w-full px-4 py-2.5 rounded-xl bg-canvas border border-border/80 text-white placeholder-muted/60 text-body-sm focus:outline-none focus:border-accent transition"
                    />
                  </div>
                </div>
              </div>

              <div class="space-y-1.5">
                <label for="contact-subject" class="block text-caption-xs font-semibold uppercase tracking-wider text-muted">
                  Topic / Query Nature <span class="text-accent">*</span>
                </label>
                <select 
                  id="contact-subject" 
                  name="subject" 
                  required
                  class="w-full px-4 py-2.5 rounded-xl bg-canvas border border-border/80 text-white text-body-sm focus:outline-none focus:border-accent transition cursor-pointer"
                >
                  <option value="" disabled selected>Select an option...</option>
                  <option value="correction">Exam Notification Correction / Update</option>
                  <option value="general">General Candidate Inquiry</option>
                  <option value="broken-link">Broken Link or Official URL Issue</option>
                  <option value="advertisement">Advertising & Partnerships</option>
                  <option value="grievance">Grievance / Legal Inquiry</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label for="contact-article-url" class="block text-caption-xs font-semibold uppercase tracking-wider text-muted">
                  Article or Exam URL <span class="text-muted/60 font-normal">(Optional)</span>
                </label>
                <input 
                  type="url" 
                  id="contact-article-url" 
                  name="articleUrl" 
                  placeholder="https://govtpariksha.com/rrb-ntpc-recruitment..." 
                  class="w-full px-4 py-2.5 rounded-xl bg-canvas border border-border/80 text-white placeholder-muted/60 text-body-sm focus:outline-none focus:border-accent transition"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-message" class="block text-caption-xs font-semibold uppercase tracking-wider text-muted">
                  Your Message <span class="text-accent">*</span>
                </label>
                <textarea 
                  id="contact-message" 
                  name="message" 
                  rows="5" 
                  required
                  placeholder="Please describe your query or specify the exact date/notice details that need attention..."
                  class="w-full px-4 py-2.5 rounded-xl bg-canvas border border-border/80 text-white placeholder-muted/60 text-body-sm focus:outline-none focus:border-accent transition resize-y"
                ></textarea>
              </div>

              <div class="pt-2 flex items-center justify-between gap-4">
                <p class="text-[11px] text-muted">
                  We respect your privacy. No spam, ever.
                </p>
                <button 
                  type="submit" 
                  id="contact-submit-btn"
                  class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-accent hover:bg-accent/90 text-white font-semibold text-body-sm transition shadow-sm cursor-pointer disabled:opacity-50"
                >
                  <span>Send Message</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </div>

        {/* Right Info: FAQs & Operational Details */}
        <div class="lg:col-span-5 space-y-6">
          
          {/* Quick FAQ card */}
          <div class="p-6 rounded-2xl bg-surface border border-border/80 space-y-4">
            <h3 class="text-body-md font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Common Questions
            </h3>

            <div class="space-y-3">
              <div class="p-3.5 rounded-xl bg-surface-raised border border-border/60">
                <h4 class="text-caption-sm font-semibold text-white mb-1">Can I apply directly on this website?</h4>
                <p class="text-caption-xs text-muted leading-relaxed">
                  No. govtpariksha.com provides exam guides and eligibility summaries. You must apply and pay exam fees only on the official board portal (e.g. ssc.gov.in, upsc.gov.in) linked in our tables.
                </p>
              </div>

              <div class="p-3.5 rounded-xl bg-surface-raised border border-border/60">
                <h4 class="text-caption-sm font-semibold text-white mb-1">How fast are exam updates posted?</h4>
                <p class="text-caption-xs text-muted leading-relaxed">
                  Our team tracks official press releases and gazette releases daily. New notices, answer keys, and admit card links are published typically within 15–30 minutes of release.
                </p>
              </div>

              <div class="p-3.5 rounded-xl bg-surface-raised border border-border/60">
                <h4 class="text-caption-sm font-semibold text-white mb-1">Is there any fee to access guides?</h4>
                <p class="text-caption-xs text-muted leading-relaxed">
                  All syllabus breakdowns, exam pattern guides, and recruitment notifications are 100% free for all students and job seekers across India.
                </p>
              </div>
            </div>
          </div>

          {/* Operational hours & Grievance desk */}
          <div class="p-6 rounded-2xl bg-surface border border-border/80 space-y-3">
            <h3 class="text-body-md font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              Editorial & Operational Hours
            </h3>
            <p class="text-caption-sm text-muted">
              Our editorial and verification desk operates from Monday to Saturday, 9:00 AM – 6:00 PM IST. Critical recruitment notifications released on weekends are processed in expedited cycles.
            </p>
            <div class="pt-2 border-t border-border/60 flex items-center justify-between text-caption-xs text-muted">
              <span>Location: New Delhi / India</span>
              <span class="text-accent font-medium">IST (GMT +5:30)</span>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>

  {/* Client-side form handler */}
  <script is:inline>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-submit-btn');
    const successBanner = document.getElementById('contact-success-banner');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.checkValidity()) return;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = `
            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            Sending...
          `;
        }

        // Simulate fast polite client acknowledgement
        setTimeout(() => {
          if (successBanner) {
            successBanner.classList.remove('hidden');
            successBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          form.reset();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `
              <span>Message Sent!</span>
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            `;
            setTimeout(() => {
              submitBtn.innerHTML = `
                <span>Send Another Message</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
              `;
            }, 3000);
          }
        }, 600);
      });
    }
  </script>
</Layout>
