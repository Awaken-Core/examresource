---
import Layout from '../layouts/Layout.astro';
import { contactEmail, siteUrl, siteName, whatsappChannel, telegramChannel } from '../data/site';

const pageTitle = `Contact Us | ${siteName}`;
const pageDescription = `Get in touch with ${siteName} support team for questions, suggestions, or error reports regarding competitive exam notifications.`;
const canonicalUrl = `${siteUrl}/contact-us`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Us",
  "url": canonicalUrl,
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "url": siteUrl,
    "logo": `${siteUrl}/og-image.jpg`
  },
  "breadcrumb": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contact Us",
        "item": canonicalUrl
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white px-4 sm:px-6 lg:px-8 py-7 transition-colors duration-200">
    <div class="max-w-[1400px] mx-auto">
      
      {/* 2-Column Grid: Main Form (Left) + Direct Contact Channels (Right) */}
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_310px] xl:grid-cols-[minmax(0,1fr)_330px] gap-8 items-start">
        
        {/* MAIN FEED CONTENT */}
        <div class="min-w-0 space-y-7">
          
          {/* Breadcrumb */}
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-muted">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span>/</span>
            <span class="text-white font-medium">Contact Us</span>
          </nav>

          {/* Hero Banner */}
          <section class="p-6 sm:p-7 bg-surface border border-border rounded-xl shadow-2xs relative overflow-hidden">
            <div class="relative z-10 space-y-3">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-raised border border-border text-white text-xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Editorial Support Desk</span>
              </div>

              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                Contact Us
              </h1>

              <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
                Have a question regarding an exam notice, spotted a discrepancy in dates, or want to suggest new features? Fill out the form below and our team will get back to you.
              </p>
            </div>
          </section>

          {/* Contact Form Section */}
          <section class="p-6 sm:p-7 bg-surface border border-border rounded-xl shadow-2xs space-y-6">
            <div class="flex items-center justify-between pb-2 border-b border-border/50">
              <h2 class="text-sm font-bold text-white">
                Send a Message
              </h2>
              <span class="text-xs text-muted">Average reply: 24-48 hrs</span>
            </div>

            <!-- Success Banner -->
            <div id="contact-success-banner" class="hidden p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300">
              <p class="font-semibold text-sm">Message received!</p>
              <p id="contact-success-text" class="text-xs text-muted mt-1">Thank you for writing to us. We will get back to you soon.</p>
            </div>

            <!-- Error Banner -->
            <div id="contact-error-banner" class="hidden p-4 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-300">
              <p class="font-semibold text-sm">Unable to send message</p>
              <p id="contact-error-text" class="text-xs text-muted mt-1">Please try again or email us directly at {contactEmail}.</p>
            </div>

            <form id="contact-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="contact-name" class="block text-xs font-semibold text-white">
                    Your Name <span class="text-accent">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    placeholder="Rahul Sharma"
                    class="w-full px-3.5 py-2.5 rounded-lg bg-surface-raised border border-border text-white placeholder:text-muted text-sm focus:outline-none focus:border-accent transition"
                  />
                </div>

                <div class="space-y-1.5">
                  <label for="contact-email" class="block text-xs font-semibold text-white">
                    Email Address <span class="text-accent">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder="rahul@example.com"
                    class="w-full px-3.5 py-2.5 rounded-lg bg-surface-raised border border-border text-white placeholder:text-muted text-sm focus:outline-none focus:border-accent transition"
                  />
                </div>
              </div>

              <div class="space-y-1.5">
                <label for="contact-subject" class="block text-xs font-semibold text-white">
                  Topic / Query Nature <span class="text-accent">*</span>
                </label>
                <select
                  id="contact-subject"
                  name="subject"
                  required
                  class="w-full px-3.5 py-2.5 rounded-lg bg-surface-raised border border-border text-white text-sm focus:outline-none focus:border-accent transition cursor-pointer"
                >
                  <option value="" disabled selected class="bg-surface text-white">Select a query topic...</option>
                  <option value="content-error" class="bg-surface text-white">Report Content Error / Exam Date Typo</option>
                  <option value="feature-suggestion" class="bg-surface text-white">Feature Request or Suggestion</option>
                  <option value="technical-bug" class="bg-surface text-white">Website Bug / Technical Issue</option>
                  <option value="privacy-legal" class="bg-surface text-white">Privacy / DPDP Act / Legal Query</option>
                  <option value="general" class="bg-surface text-white">General Inquiry</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label for="contact-message" class="block text-xs font-semibold text-white">
                  Your Message <span class="text-accent">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="5"
                  placeholder="Explain your query, provide the article link, or describe the exam notification..."
                  class="w-full px-3.5 py-2.5 rounded-lg bg-surface-raised border border-border text-white placeholder:text-muted text-sm focus:outline-none focus:border-accent transition resize-y"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  id="contact-submit-btn"
                  class="px-5 py-2.5 rounded-lg bg-surface-raised border border-border hover:border-accent text-white font-semibold text-xs transition cursor-pointer flex items-center justify-center gap-2 shadow-xs"
                >
                  <span>Send Message</span>
                  <span>&rarr;</span>
                </button>
              </div>
            </form>
          </section>

        </div>

        {/* RIGHT SIDEBAR (Sticky Direct Channels & FAQ Links) */}
        <aside class="space-y-6 hidden lg:block sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto scrollbar-none">
          
          {/* Direct Email Card */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3 transition-colors">
            <h3 class="text-xs font-bold uppercase tracking-wider text-muted pb-1 border-b border-border/50">
              Direct Contact
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Prefer writing directly from your email client? Reach us here:
            </p>
            <a
              href={`mailto:${contactEmail}`}
              class="flex items-center gap-2 p-2 rounded bg-surface-raised border border-border hover:border-accent text-white text-xs font-medium transition truncate"
            >
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span class="truncate">{contactEmail}</span>
            </a>
          </div>

          {/* Social / Alert Channels */}
          {(whatsappChannel || telegramChannel) && (
            <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3 transition-colors">
              <h3 class="text-xs font-bold uppercase tracking-wider text-muted pb-1 border-b border-border/50">
                Official Channels
              </h3>
              <p class="text-xs text-muted leading-relaxed">
                Join our verified alert feeds for instant notifications:
              </p>
              <div class="space-y-2">
                {whatsappChannel && (
                  <a
                    href={whatsappChannel}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between p-2 rounded bg-surface-raised border border-border hover:border-[#25D366]/60 text-white text-xs font-medium transition group"
                  >
                    <span class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
                      <span>WhatsApp Channel</span>
                    </span>
                    <span class="text-muted group-hover:text-white transition">&rarr;</span>
                  </a>
                )}
                {telegramChannel && (
                  <a
                    href={telegramChannel}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between p-2 rounded bg-surface-raised border border-border hover:border-sky-500/60 text-white text-xs font-medium transition group"
                  >
                    <span class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                      <span>Telegram Channel</span>
                    </span>
                    <span class="text-muted group-hover:text-white transition">&rarr;</span>
                  </a>
                )}
              </div>
            </div>
          )}

          {/* Verification Reminder */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-2 text-xs text-muted">
            <p class="font-bold text-white text-sm">Response Time</p>
            <p class="leading-relaxed">
              We review submissions Monday through Saturday between 9:00 AM and 6:00 PM IST.
            </p>
          </div>

        </aside>

      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-submit-btn');
    const successBanner = document.getElementById('contact-success-banner');
    const errorBanner = document.getElementById('contact-error-banner');
    const successText = document.getElementById('contact-success-text');
    const errorText = document.getElementById('contact-error-text');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (successBanner) successBanner.classList.add('hidden');
        if (errorBanner) errorBanner.classList.add('hidden');

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Sending...</span>';
        }

        const formData = new FormData(form);
        const payload = {
          name: formData.get('name'),
          email: formData.get('email'),
          subject: formData.get('subject'),
          message: formData.get('message'),
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            if (successText && data.message) successText.textContent = data.message;
            if (successBanner) successBanner.classList.remove('hidden');
            form.reset();
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<span>Message Sent! ✓</span>';
              setTimeout(() => { submitBtn.innerHTML = '<span>Send Another Message &rarr;</span>'; }, 3000);
            }
          } else {
            throw new Error(data.error || 'Failed to send message. Please try again or email us.');
          }
        } catch (err) {
          if (errorText) errorText.textContent = err.message || 'Error sending message. Please try again.';
          if (errorBanner) errorBanner.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Send Message &rarr;</span>';
          }
        }
      });
    }
  </script>
</Layout>
