---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';

let livePosts: any[] = [];
try {
  const res = await fetch(`${API_URL}/blogs?limit=100`);
  if (res.ok) {
    livePosts = await res.json();
  }
} catch (e) {
  livePosts = [];
}

const fallbackArticles = [
  {
    title: 'MP Police Constable Driver Recruitment 2026',
    slug: 'mp-police-constable-driver-recruitment-2026',
    category: 'State Exams',
    date: 'Oct 2026'
  },
  {
    title: 'UPESSC PRT Assistant Teacher Recruitment 2026',
    slug: 'upessc-prt-assistant-teacher-recruitment-2026-english',
    category: 'Teaching',
    date: 'Oct 2026'
  },
  {
    title: 'RRB NTPC Graduate Recruitment 2026',
    slug: 'rrb-ntpc-graduate-recruitment-2026-english',
    category: 'SSC & Railways',
    date: 'Oct 2026'
  }
];

const articlesList = (livePosts && livePosts.length > 0)
  ? livePosts.map(p => ({
      title: p.title,
      slug: p.slug?.replace(/^\//, ''),
      category: p.category?.name || p.categories?.[0]?.name || 'Exam Guide',
      date: new Date(p.publishedAt || p.updatedAt || Date.now()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
    }))
  : fallbackArticles;

const examCategories = [
  { name: 'Central Government', path: '/category/central-government', desc: 'UPSC, SSC, Defence & Central PSU jobs' },
  { name: 'State Exams', path: '/category/state-exams', desc: 'State PSCs, Police, Revenue & Secretariat exams' },
  { name: 'Banking & Insurance', path: '/category/banking', desc: 'IBPS PO/Clerk, SBI, RBI Grade B, LIC' },
  { name: 'SSC & Railways', path: '/category/ssc-railways', desc: 'SSC CGL, CHSL, GD, MTS, RRB NTPC, ALP, Group D' },
  { name: 'Teaching Eligibility', path: '/category/teaching', desc: 'CTET, State TETs, KVS, NVS, Assistant Professor' },
  { name: 'Defence & Paramilitary', path: '/category/defence', desc: 'NDA, CDS, AFCAT, CAPF AC, Indian Coast Guard' }
];

const officialPortals = [
  { name: 'Staff Selection Commission (SSC)', url: 'https://ssc.gov.in/' },
  { name: 'Union Public Service Commission (UPSC)', url: 'https://www.upsc.gov.in/' },
  { name: 'Railway Recruitment Control Board (RRB)', url: 'https://rrb.indianrailways.gov.in/' },
  { name: 'Institute of Banking Personnel Selection (IBPS)', url: 'https://www.ibps.in/' },
  { name: 'National Testing Agency (NTA)', url: 'https://nta.ac.in/' },
  { name: 'National Portal of India', url: 'https://www.india.gov.in/' },
  { name: 'DigiLocker India', url: 'https://www.digilocker.gov.in/' },
  { name: 'Unique Identification Authority of India (UIDAI)', url: 'https://www.uidai.gov.in/' },
  { name: 'National Career Service (NCS)', url: 'https://www.ncs.gov.in/' }
];

const pageTitle = "Sitemap & Portal Directory — govtpariksha.com";
const pageDescription = "Browse the complete directory of government recruitment notifications, exam categories, syllabus guides, official commission portals, and legal resources on govtpariksha.com.";
const canonicalUrl = "https://govtpariksha.com/sitemap";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Sitemap & Portal Directory",
  "url": canonicalUrl,
  "description": pageDescription,
  "breadcrumb": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://govtpariksha.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Sitemap",
        "item": canonicalUrl
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      
      {/* Breadcrumb */}
      <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-1.5 text-xs text-muted">
        <a href="/" class="hover:text-accent transition">Home</a>
        <span>/</span>
        <span class="font-medium text-white">Sitemap</span>
      </nav>

      {/* Header Banner */}
      <header class="rounded-xl border border-border bg-surface p-6 sm:p-8 mb-6 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-accent/10 text-accent text-xs font-semibold">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            Complete Directory
          </div>

          <a 
            href="/sitemap.xml" 
            target="_blank" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-raised border border-border hover:border-accent text-white text-xs font-semibold transition group shadow-xs self-start"
          >
            <span>XML Sitemap (for Crawlers)</span>
            <svg class="w-3.5 h-3.5 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-3">
          Website Sitemap & Directory
        </h1>
        <p class="text-sm sm:text-base text-muted leading-relaxed max-w-3xl">
          Explore all examination streams, syllabus guides, official government recruiting commissions, and legal policies published across <strong class="text-white">govtpariksha.com</strong>.
        </p>
      </header>

      {/* Search / Filter Bar */}
      <div class="rounded-xl border border-border bg-surface p-4 mb-8">
        <div class="relative w-full">
          <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input 
            type="text" 
            id="sitemap-search-input" 
            placeholder="Type to filter links (e.g. UPSC, RRB, Syllabus, Privacy)..." 
            class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-raised border border-border text-white placeholder:text-muted text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition"
          />
        </div>
      </div>

      {/* Main Sitemap Content Grid */}
      <div class="space-y-8">
        
        {/* 1. Core Platform Pages */}
        <section class="sitemap-section space-y-3">
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white">Core Pages</h2>
            <span class="text-xs text-muted">• Main routes & legal policies</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <a href="/" class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group">
              <span class="text-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                Home
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
              <span class="text-xs text-muted block mt-1">Latest notifications & exam board overview</span>
            </a>

            <a href="/#latest-updates" class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group">
              <span class="text-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                Latest Updates Feed
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
              <span class="text-xs text-muted block mt-1">Real-time alerts, admit cards, and results</span>
            </a>

            <a href="/privacy-policy" class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group">
              <span class="text-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                Privacy Policy
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
              <span class="text-xs text-muted block mt-1">Data protection, cookies & privacy practices</span>
            </a>

            <a href="/terms-of-service" class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group">
              <span class="text-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                Terms of Service
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
              <span class="text-xs text-muted block mt-1">Non-government disclaimer & terms of use</span>
            </a>

            <a href="/contact-us" class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group">
              <span class="text-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                Contact Us
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
              <span class="text-xs text-muted block mt-1">Editorial desk, error reports & inquiries</span>
            </a>

            <a href="/sitemap.xml" target="_blank" class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group">
              <span class="text-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                XML Sitemap
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </span>
              <span class="text-xs text-muted block mt-1">Machine-readable index for search crawlers</span>
            </a>
          </div>
        </section>

        {/* 2. Exam Streams & Categories */}
        <section class="sitemap-section space-y-3">
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white">Exam Categories & Streams</h2>
            <span class="text-xs text-muted">• Category hubs for targeted prep</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {examCategories.map((cat) => (
              <a href={cat.path} class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group">
                <span class="text-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                  {cat.name}
                  <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
                <span class="text-xs text-muted block mt-1">{cat.desc}</span>
              </a>
            ))}
          </div>
        </section>

        {/* 3. Official Government Recruitment Portals */}
        <section class="sitemap-section space-y-3">
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white">Official Government Recruitment Portals</h2>
            <span class="text-xs text-muted">• Direct links to official boards</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {officialPortals.map((p) => (
              <a 
                href={p.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group"
              >
                <div class="flex items-start justify-between gap-2">
                  <span class="text-sm font-semibold text-white group-hover:text-accent transition">
                    {p.name}
                  </span>
                  <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent shrink-0 mt-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </div>
                <span class="text-xs text-muted block mt-1 font-mono truncate">{p.url}</span>
              </a>
            ))}
          </div>
        </section>

        {/* 4. Latest Recruitment Guides */}
        <section class="sitemap-section space-y-3">
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-bold text-white">Published Exam Guides & Notices</h2>
            <span class="text-xs text-muted">• Indexed articles & syllabus digests</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {articlesList.map((art) => (
              <a 
                href={`/${art.slug}`} 
                class="sitemap-link rounded-xl border border-border bg-surface p-4 hover:bg-surface-raised transition block group"
              >
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded bg-accent/10 text-accent text-[11px] font-semibold">
                    {art.category}
                  </span>
                  <span class="text-xs text-muted">{art.date}</span>
                </div>
                <h3 class="text-sm font-semibold text-white group-hover:text-accent transition line-clamp-2">
                  {art.title}
                </h3>
              </a>
            ))}
          </div>
        </section>

        {/* No Results Indicator */}
        <div id="sitemap-no-results" class="hidden text-center py-10 rounded-xl border border-border bg-surface p-6">
          <p class="text-sm font-semibold text-white">No matching links found</p>
          <p class="text-xs text-muted mt-1">Try another keyword.</p>
        </div>

      </div>
    </div>
  </div>

  {/* Live Search Script */}
  <script is:inline>
    const searchInput = document.getElementById('sitemap-search-input');
    const links = document.querySelectorAll('.sitemap-link');
    const sections = document.querySelectorAll('.sitemap-section');
    const noResults = document.getElementById('sitemap-no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let totalVisible = 0;

        links.forEach((link) => {
          const text = link.textContent.toLowerCase();
          if (!query || text.includes(query)) {
            link.style.display = '';
            totalVisible++;
          } else {
            link.style.display = 'none';
          }
        });

        sections.forEach((sec) => {
          const visibleInSec = sec.querySelectorAll('.sitemap-link:not([style*="display: none"])');
          if (visibleInSec.length === 0 && query) {
            sec.style.display = 'none';
          } else {
            sec.style.display = '';
          }
        });

        if (noResults) {
          if (totalVisible === 0 && query) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      });
    }
  </script>
</Layout>
