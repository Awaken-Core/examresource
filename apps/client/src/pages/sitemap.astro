---
import Layout from '../layouts/Layout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api/v1';

let livePosts: any[] = [];
try {
  const res = await fetch(`${API_URL}/blogs?limit=100`);
  if (res.ok) {
    livePosts = await res.json();
  }
} catch (e) {
  livePosts = [];
}

// Fallback articles if API is offline
const fallbackArticles = [
  {
    title: 'MP Police Constable Driver Recruitment 2026',
    slug: 'mp-police-constable-driver-recruitment-2026',
    category: 'State Exams',
    date: 'Oct 2026'
  },
  {
    title: 'UPESSC PRT Assistant Teacher Recruitment 2026',
    slug: 'upessc-prt-assistant-teacher-recruitment-2026-english',
    category: 'Teaching',
    date: 'Oct 2026'
  },
  {
    title: 'RRB NTPC Graduate Recruitment 2026',
    slug: 'rrb-ntpc-graduate-recruitment-2026-english',
    category: 'SSC & Railways',
    date: 'Oct 2026'
  }
];

const articlesList = (livePosts && livePosts.length > 0)
  ? livePosts.map(p => ({
      title: p.title,
      slug: p.slug?.replace(/^\//, ''),
      category: p.category?.name || p.categories?.[0]?.name || 'Exam Guide',
      date: new Date(p.publishedAt || p.updatedAt || Date.now()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
    }))
  : fallbackArticles;

const examCategories = [
  { name: 'Central Government', path: '/blog/central-government', desc: 'UPSC, SSC, Defence & Central PSU jobs' },
  { name: 'State Exams', path: '/blog/state-exams', desc: 'State PSCs, Police, Revenue & Secretariat exams' },
  { name: 'Banking & Insurance', path: '/blog/banking', desc: 'IBPS PO/Clerk, SBI, RBI Grade B, LIC' },
  { name: 'SSC & Railways', path: '/blog/ssc-railways', desc: 'SSC CGL, CHSL, GD, MTS, RRB NTPC, ALP, Group D' },
  { name: 'Teaching Eligibility', path: '/blog/teaching', desc: 'CTET, State TETs, KVS, NVS, Assistant Professor' },
  { name: 'Defence & Paramilitary', path: '/blog/defence', desc: 'NDA, CDS, AFCAT, CAPF AC, Indian Coast Guard' }
];

const officialPortals = [
  { name: 'Staff Selection Commission (SSC)', url: 'https://ssc.gov.in/' },
  { name: 'Union Public Service Commission (UPSC)', url: 'https://www.upsc.gov.in/' },
  { name: 'Railway Recruitment Control Board (RRB)', url: 'https://rrb.indianrailways.gov.in/' },
  { name: 'Institute of Banking Personnel Selection (IBPS)', url: 'https://www.ibps.in/' },
  { name: 'National Testing Agency (NTA)', url: 'https://nta.ac.in/' },
  { name: 'National Portal of India', url: 'https://www.india.gov.in/' },
  { name: 'DigiLocker India', url: 'https://www.digilocker.gov.in/' },
  { name: 'Unique Identification Authority of India (UIDAI)', url: 'https://www.uidai.gov.in/' },
  { name: 'National Career Service (NCS)', url: 'https://www.ncs.gov.in/' }
];

const pageTitle = "Sitemap & Portal Directory — govtpariksha.com";
const pageDescription = "Browse the complete directory of government recruitment notifications, exam categories, syllabus guides, official commission portals, and legal resources on govtpariksha.com.";
const canonicalUrl = "https://govtpariksha.com/sitemap";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Sitemap & Portal Directory",
  "url": canonicalUrl,
  "description": pageDescription,
  "breadcrumb": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://govtpariksha.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Sitemap",
        "item": canonicalUrl
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white">
    {/* Hero Section */}
    <div class="border-b border-border/80 bg-surface/60 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-caption-xs text-muted">
          <a href="/" class="hover:text-accent transition">Home</a>
          <span class="text-border">/</span>
          <span class="text-white font-medium">Sitemap</span>
        </nav>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="space-y-3 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent text-caption-xs font-semibold uppercase tracking-wider">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
              Complete Directory & Navigation
            </div>
            <h1 class="text-heading-xl sm:text-heading-xxl font-extrabold text-white tracking-tight">
              Website Sitemap
            </h1>
            <p class="text-body-md text-muted leading-relaxed">
              Explore all examination streams, syllabus guides, official government recruiting commissions, and legal policies published across <strong class="text-white">govtpariksha.com</strong>.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a 
              href="/sitemap.xml" 
              target="_blank" 
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-raised border border-border/80 hover:border-accent text-white text-body-sm font-semibold transition group shadow-sm"
            >
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
              <span>View XML Sitemap (for Crawlers)</span>
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Live Filter Bar */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="p-4 rounded-2xl bg-surface border border-border/70 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="relative w-full sm:w-96">
          <svg class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input 
            type="text" 
            id="sitemap-search-input" 
            placeholder="Filter links (e.g. UPSC, RRB, Syllabus, Privacy)..." 
            class="w-full pl-10 pr-4 py-2 rounded-xl bg-canvas border border-border/80 text-white placeholder-muted/60 text-body-sm focus:outline-none focus:border-accent transition"
          />
        </div>
        <div class="flex items-center gap-4 text-caption-xs text-muted w-full sm:w-auto justify-between sm:justify-end">
          <span>Total Guides: <strong class="text-white">{articlesList.length}</strong></span>
          <span>•</span>
          <span>Categories: <strong class="text-white">{examCategories.length}</strong></span>
          <span>•</span>
          <span>Official Portals: <strong class="text-white">{officialPortals.length}</strong></span>
        </div>
      </div>
    </div>

    {/* Main Sitemap Content Grid */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 space-y-10">
      
      {/* 1. Core Platform Pages */}
      <section class="sitemap-section space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-bold text-caption-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <div>
            <h2 class="text-heading-md font-bold text-white">Core Website Pages</h2>
            <p class="text-caption-xs text-muted">Primary application routes and informational resources</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <a href="/" class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group">
            <span class="text-body-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
              Home
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
            <span class="text-caption-xs text-muted block mt-1">Latest notifications & exam board overview</span>
          </a>

          <a href="/#latest-updates" class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group">
            <span class="text-body-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
              Latest Updates Feed
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
            <span class="text-caption-xs text-muted block mt-1">Real-time alerts, admit cards, and results</span>
          </a>

          <a href="/privacy-policy" class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group">
            <span class="text-body-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
              Privacy Policy
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
            <span class="text-caption-xs text-muted block mt-1">Data protection, cookies & privacy practices</span>
          </a>

          <a href="/terms-of-service" class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group">
            <span class="text-body-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
              Terms of Service
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
            <span class="text-caption-xs text-muted block mt-1">Non-government disclaimer & terms of use</span>
          </a>

          <a href="/contact-us" class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group">
            <span class="text-body-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
              Contact Us
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
            <span class="text-caption-xs text-muted block mt-1">Editorial desk, error reports & inquiries</span>
          </a>

          <a href="/sitemap.xml" target="_blank" class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group">
            <span class="text-body-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
              XML Sitemap
              <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </span>
            <span class="text-caption-xs text-muted block mt-1">Search engine indexed URL schema</span>
          </a>
        </div>
      </section>

      {/* 2. Exam Streams & Categories */}
      <section class="sitemap-section space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold text-caption-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <div>
            <h2 class="text-heading-md font-bold text-white">Exam Categories & Streams</h2>
            <p class="text-caption-xs text-muted">Dedicated category hubs for targeted recruitment prep</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {examCategories.map((cat) => (
            <a href={cat.path} class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group">
              <span class="text-body-sm font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                {cat.name}
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
              <span class="text-caption-xs text-muted block mt-1">{cat.desc}</span>
            </a>
          ))}
        </div>
      </section>

      {/* 3. Official Government Recruitment Portals */}
      <section class="sitemap-section space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-caption-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-heading-md font-bold text-white">Official Government Recruitment Portals</h2>
            <p class="text-caption-xs text-muted">Direct outbound links to verified government boards</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {officialPortals.map((p) => (
            <a 
              href={p.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-emerald-500/40 hover:bg-surface-raised transition block group"
            >
              <div class="flex items-start justify-between gap-2">
                <span class="text-body-sm font-semibold text-white group-hover:text-emerald-400 transition">
                  {p.name}
                </span>
                <svg class="w-3.5 h-3.5 text-muted group-hover:text-emerald-400 shrink-0 mt-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </div>
              <span class="text-caption-xs text-muted/80 block mt-1 font-mono truncate">{p.url}</span>
            </a>
          ))}
        </div>
      </section>

      {/* 4. Latest Recruitment Guides & Notifications */}
      <section class="sitemap-section space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-caption-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div>
            <h2 class="text-heading-md font-bold text-white">Published Exam Guides & Notices</h2>
            <p class="text-caption-xs text-muted">Complete index of notification summaries, cut-offs, and syllabus guides</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {articlesList.map((art) => (
            <a 
              href={`/${art.slug}`} 
              class="sitemap-link p-4 rounded-xl bg-surface border border-border/70 hover:border-accent/40 hover:bg-surface-raised transition block group"
            >
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2 py-0.5 rounded bg-accent/10 text-accent text-[11px] font-semibold">
                  {art.category}
                </span>
                <span class="text-caption-xs text-muted">{art.date}</span>
              </div>
              <h3 class="text-body-sm font-semibold text-white group-hover:text-accent transition line-clamp-2">
                {art.title}
              </h3>
            </a>
          ))}
        </div>
      </section>

      {/* No Results Indicator for Filter */}
      <div id="sitemap-no-results" class="hidden text-center py-12 p-8 rounded-2xl bg-surface border border-border/80">
        <svg class="w-10 h-10 text-muted mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="text-body-md font-semibold text-white">No matching links found</p>
        <p class="text-caption-sm text-muted mt-1">Try another keyword or search query.</p>
      </div>

    </div>
  </div>

  {/* Live Search Script */}
  <script is:inline>
    const searchInput = document.getElementById('sitemap-search-input');
    const links = document.querySelectorAll('.sitemap-link');
    const sections = document.querySelectorAll('.sitemap-section');
    const noResults = document.getElementById('sitemap-no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let totalVisible = 0;

        links.forEach((link) => {
          const text = link.textContent.toLowerCase();
          if (!query || text.includes(query)) {
            link.style.display = '';
            totalVisible++;
          } else {
            link.style.display = 'none';
          }
        });

        // Hide or show sections based on whether they contain visible links
        sections.forEach((sec) => {
          const visibleInSec = sec.querySelectorAll('.sitemap-link:not([style*="display: none"])');
          if (visibleInSec.length === 0 && query) {
            sec.style.display = 'none';
          } else {
            sec.style.display = '';
          }
        });

        if (noResults) {
          if (totalVisible === 0 && query) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      });
    }
  </script>
</Layout>
