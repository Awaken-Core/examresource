---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { siteUrl, siteName } from '../data/site';
import { API_URL } from '../lib/api';

interface LivePost {
  title: string;
  slug: string;
  category?: { name: string };
  categories?: { name: string }[];
  publishedAt?: string;
  updatedAt?: string;
}

let livePosts: LivePost[] = [];
let liveCategories: any[] = [];
try {
  const [postRes, catRes] = await Promise.all([
    fetch(`${API_URL}/blogs?limit=100`, { 
      credentials: 'omit',
      signal: AbortSignal.timeout(6000),
    }).catch(() => null),
    fetch(`${API_URL}/categories`, { 
      credentials: 'omit',
      signal: AbortSignal.timeout(6000),
    }).catch(() => null),
  ]);
  if (postRes && postRes.ok) {
    livePosts = await postRes.json();
  }
  if (catRes && catRes.ok) {
    liveCategories = await catRes.json();
  }
} catch (e) {
  livePosts = [];
  liveCategories = [];
}

const fallbackArticles = [
  {
    title: 'SSC CGL Notification 2026',
    slug: 'ssc-cgl-notification-2026',
    category: 'SSC & Railways',
  },
  {
    title: 'IBPS PO Prelims Exam Schedule 2026',
    slug: 'ibps-po-prelims-exam-schedule-2026',
    category: 'Banking',
  },
  {
    title: 'RRB NTPC Graduate Recruitment 2026',
    slug: 'rrb-ntpc-graduate-recruitment-2026',
    category: 'Railways',
  }
];

const articlesList = (livePosts && livePosts.length > 0)
  ? livePosts.map(p => ({
      title: p.title,
      slug: p.slug?.replace(/^\//, '')?.replace(/-(english|hinglish)$/i, ''),
      category: p.category?.name || p.categories?.[0]?.name || 'Exam Guide',
    }))
  : fallbackArticles;

const examCategories = (liveCategories && liveCategories.length > 0)
  ? liveCategories.map((c: any) => ({
      name: c.name,
      path: `/category/${c.slug}`,
      desc: c.description || `${c.name} exam notifications, eligibility, and updates`,
    }))
  : [];

const corePages = [
  { name: 'Home', path: '/', desc: 'Exam notifications, notices, and guides' },
  { name: 'Important Official Links', path: '/#important-links', desc: 'Direct portal directory' },
  { name: 'Frequently Asked Questions', path: '/#faqs', desc: 'Platform answers & help' },
  { name: 'Privacy Policy', path: '/privacy-policy', desc: 'DPDP Act 2023 compliance' },
  { name: 'Terms of Service', path: '/terms-of-service', desc: 'Platform rules and terms' },
  { name: 'Pricing', path: '/pricing', desc: 'Test Series Pass price and what it includes' },
  { name: 'Refund and Cancellation Policy', path: '/refund-policy', desc: 'Refunds for the Test Series Pass' },
  { name: 'Contact Us', path: '/contact-us', desc: 'Support desk and feedback' },
  { name: 'XML Sitemap', path: '/sitemap.xml', desc: 'Search engine index file' }
];

const R2_PORTAL_BASE = 'https://pub-68568854a58845bc975b176de76b1ad5.r2.dev/portals';
const officialPortals = [
  { name: 'Staff Selection Commission (SSC)', url: 'ssc.gov.in', href: 'https://ssc.gov.in/', logo: `${R2_PORTAL_BASE}/ssc.svg`, initial: 'S', bg: 'bg-[#8B0000]', textColor: 'text-[#FFD700]' },
  { name: 'Union Public Service Commission (UPSC)', url: 'upsc.gov.in', href: 'https://www.upsc.gov.in/', logo: `${R2_PORTAL_BASE}/upsc.svg`, initial: 'U', bg: 'bg-[#0C2340]', textColor: 'text-[#E2B13C]' },
  { name: 'Railway Recruitment Control Board (RRB)', url: 'rrb.indianrailways.gov.in', href: 'https://rrb.indianrailways.gov.in/', logo: `${R2_PORTAL_BASE}/railways.svg`, initial: 'R', bg: 'bg-[#003366]', textColor: 'text-[#E5A823]' },
  { name: 'Institute of Banking Personnel Selection', url: 'ibps.in', href: 'https://www.ibps.in/', logo: `${R2_PORTAL_BASE}/ibps.svg`, initial: 'I', bg: 'bg-[#312E81]', textColor: 'text-white' },
];

const pageTitle = `Sitemap | ${siteName}`;
const pageDescription = `Complete directory of exam categories, latest recruitment guides, official commission portals, and platform policies on ${siteName}.`;
const canonicalUrl = `${siteUrl}/sitemap`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Sitemap",
  "url": canonicalUrl,
  "description": pageDescription,
  "breadcrumb": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Sitemap",
        "item": canonicalUrl
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-canvas text-white px-4 sm:px-6 lg:px-8 py-7 transition-colors duration-200">
    <div class="max-w-[1400px] mx-auto">
      
      {/* 2-Column Grid: Main Directory (Left) + Sticky Quick Index (Right) */}
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_310px] xl:grid-cols-[minmax(0,1fr)_330px] gap-8 items-start">
        
        {/* MAIN FEED CONTENT */}
        <div class="min-w-0 space-y-7">
          
          {/* Breadcrumb */}
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-muted">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span>/</span>
            <span class="text-white font-medium">Sitemap</span>
          </nav>

          {/* Hero Banner */}
          <section class="p-6 sm:p-7 bg-surface border border-border rounded-xl shadow-2xs relative overflow-hidden">
            <div class="relative z-10 space-y-3">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-raised border border-border text-white text-xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                <span>Portal Directory</span>
              </div>

              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                  Sitemap &amp; Directory
                </h1>
                <a
                  href="/sitemap.xml"
                  target="_blank"
                  class="text-xs text-muted hover:text-white transition flex items-center gap-1 font-medium"
                >
                  <span>Raw XML Feed</span>
                  <span>&rarr;</span>
                </a>
              </div>

              <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-2xl">
                Quick index of all exam streams, latest recruitment summaries, official commission portals, and platform policies.
              </p>

              <!-- Live Filter -->
              <div class="pt-3 border-t border-border/50">
                <input
                  type="text"
                  id="sitemap-search-input"
                  placeholder="Filter links (e.g. SSC, UPSC, Banking, Terms)..."
                  class="w-full max-w-md px-3.5 py-2 rounded-lg bg-surface-raised border border-border text-white placeholder:text-muted text-xs focus:outline-none focus:border-accent transition"
                />
              </div>
            </div>
          </section>

          <!-- 1. Core Pages -->
          <section class="sitemap-section p-6 bg-surface border border-border rounded-xl shadow-2xs space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-border/50">
              <h2 class="text-sm font-bold text-white">Core Platform Pages</h2>
              <span class="text-xs text-muted">{corePages.length} routes</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {corePages.map((page) => (
                <a
                  href={page.path}
                  class="sitemap-link p-3 rounded-lg bg-surface-raised border border-border/60 hover:border-accent/40 transition block group"
                >
                  <div class="text-xs font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                    <span>{page.name}</span>
                    <span class="text-muted text-xs group-hover:text-accent transition">&rarr;</span>
                  </div>
                  <p class="text-[11px] text-muted mt-0.5">{page.desc}</p>
                </a>
              ))}
            </div>
          </section>

          <!-- 2. Exam Streams -->
          <section class="sitemap-section p-6 bg-surface border border-border rounded-xl shadow-2xs space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-border/50">
              <h2 class="text-sm font-bold text-white">Exam Streams &amp; Categories</h2>
              <span class="text-xs text-muted">{examCategories.length} categories</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {examCategories.map((cat) => (
                <a
                  href={cat.path}
                  target="_blank"
                  rel="noopener"
                  data-astro-prefetch="false"
                  class="sitemap-link p-3 rounded-lg bg-surface-raised border border-border/60 hover:border-accent/40 transition block group"
                >
                  <div class="text-xs font-semibold text-white group-hover:text-accent transition flex items-center justify-between">
                    <span>{cat.name}</span>
                    <span class="text-muted text-xs group-hover:text-accent transition">&rarr;</span>
                  </div>
                  <p class="text-[11px] text-muted mt-0.5">{cat.desc}</p>
                </a>
              ))}
            </div>
          </section>

          <!-- 3. Latest Articles -->
          {articlesList.length > 0 && (
            <section class="sitemap-section p-6 bg-surface border border-border rounded-xl shadow-2xs space-y-4">
              <div class="flex items-center justify-between pb-2 border-b border-border/50">
                <h2 class="text-sm font-bold text-white">Recent Recruitment Summaries</h2>
                <span class="text-xs text-muted">{articlesList.length} articles</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {articlesList.map((art) => (
                  <a
                    href={`/${art.slug}`}
                    class="sitemap-link p-3 rounded-lg bg-surface-raised border border-border/60 hover:border-accent/40 transition block group"
                  >
                    <span class="text-[10px] text-accent font-semibold block uppercase tracking-wider mb-0.5">
                      {art.category}
                    </span>
                    <p class="text-xs font-semibold text-white group-hover:text-accent transition line-clamp-1 leading-snug">
                      {art.title}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- No Results Indicator -->
          <div id="sitemap-no-results" class="hidden p-8 text-center text-muted text-xs bg-surface border border-border rounded-xl">
            No routes or articles match your query.
          </div>

        </div>

        {/* RIGHT SIDEBAR (Sticky Official Portals) */}
        <aside class="space-y-6 hidden lg:block sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto scrollbar-none">
          
          {/* Important Portals Box */}
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-3.5 transition-colors">
            <h3 class="text-sm font-bold text-white pb-1 border-b border-border/50">
              Government Commission Portals
            </h3>
            <div class="divide-y divide-border/50">
              {officialPortals.map((portal) => (
                <a 
                  href={portal.href} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex items-center justify-between py-2 px-1 hover:bg-surface-raised rounded transition group cursor-pointer"
                  title={`Open official ${portal.name} portal`}
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-7 h-7 rounded-full bg-surface-raised border border-border flex items-center justify-center p-0.5 shrink-0 overflow-hidden relative">
                      <Image 
                        src={portal.logo} 
                        alt={`${portal.name} emblem logo`} 
                        class="w-full h-full object-contain" 
                        loading="eager"
                        decoding="async"
                        width={28}
                        height={28}
                        onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                      />
                      <div class={`w-full h-full rounded-full ${portal.bg} ${portal.textColor} hidden items-center justify-center font-bold text-[9px] select-none tracking-tight`}>
                        {portal.initial}
                      </div>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-white group-hover:text-accent transition truncate leading-tight">
                        {portal.name}
                      </p>
                      <p class="text-[10px] text-muted truncate leading-tight mt-0.5">
                        {portal.url}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Policy Quick Links -->
          <div class="bg-surface border border-border rounded-lg p-4 shadow-2xs space-y-2 text-xs text-muted">
            <p class="font-bold text-white text-sm">Transparency</p>
            <p class="leading-relaxed">All mock tests and recruitment guides are verified against official commission gazettes.</p>
          </div>

        </aside>

      </div>
    </div>
  </div>

  <script is:inline>
    const searchInput = document.getElementById('sitemap-search-input');
    const links = document.querySelectorAll('.sitemap-link');
    const sections = document.querySelectorAll('.sitemap-section');
    const noResults = document.getElementById('sitemap-no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let totalVisible = 0;

        links.forEach((link) => {
          const text = link.textContent.toLowerCase();
          if (!query || text.includes(query)) {
            link.style.display = '';
            totalVisible++;
          } else {
            link.style.display = 'none';
          }
        });

        sections.forEach((sec) => {
          const visibleInSec = sec.querySelectorAll('.sitemap-link:not([style*="display: none"])');
          if (visibleInSec.length === 0 && query) {
            sec.style.display = 'none';
          } else {
            sec.style.display = '';
          }
        });

        if (noResults) {
          if (totalVisible === 0 && query) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      });
    }
  </script>
</Layout>
