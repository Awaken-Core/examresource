---
import '../styles/global.css';
import { siteName } from '../data/site';

interface Props {
  title?: string;
  activeNav?: 'posts' | 'new-post' | 'categories' | 'sitemap' | 'users' | 'notifications';
  fullWidth?: boolean;
}

const {
  title = 'Posts',
  activeNav = 'posts',
  fullWidth = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased admin-theme theme-light auth-pending">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function() {
        function applyStoredTheme() {
          var root = document.documentElement;
          var pref = localStorage.getItem('theme_preference') || localStorage.getItem('theme');
          var dark = pref === 'dark';
          root.classList.toggle('theme-dark', dark);
          root.classList.toggle('theme-light', !dark);
          root.style.colorScheme = dark ? 'dark' : 'light';
        }
        applyStoredTheme();
        if (!window.__examThemeBound) {
          window.__examThemeBound = true;
          document.addEventListener('astro:after-swap', applyStoredTheme);
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FF4D00" />
    <title>{title} · {siteName} Desk</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Admin chrome follows the same saved theme and self-hosted font as the public site -->
    <style is:inline>
      html.admin-theme, body.admin-theme-body {
        font-family: Inter, Geist, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        height: 100%;
      }
      html.auth-pending body {
        visibility: hidden;
      }
      html.admin-theme:not(.theme-dark),
      html.admin-theme:not(.theme-dark) body.admin-theme-body {
        background-color: #F8FAFC !important;
        color: #111827 !important;
      }
      html.admin-theme:not(.theme-dark) {
        --color-canvas: #F8FAFC !important;
        --color-surface: #FFFFFF !important;
        --color-surface-raised: #F1F5F9 !important;
        --color-white: #FFFFFF !important;
        --color-text-primary: #111827 !important;
        --color-muted: #64748B !important;
        --color-border: #E5E7EB !important;
        --color-subtle: #F3F4F6 !important;
        color-scheme: light !important;
      }
      html.admin-theme.theme-dark,
      html.admin-theme.theme-dark body.admin-theme-body {
        background-color: #131316 !important;
        color: #F8FAFC !important;
      }
      html.admin-theme.theme-dark {
        --color-canvas: #131316 !important;
        --color-surface: #1C1B1F !important;
        --color-surface-raised: #252528 !important;
        --color-white: #FFFFFF !important;
        --color-text-primary: #F8FAFC !important;
        --color-muted: #A0A0A3 !important;
        --color-border: #2A2925 !important;
        --color-subtle: #1D1A12 !important;
        color-scheme: dark !important;
      }
      html.admin-theme:not(.theme-dark) .bg-white {
        background-color: #FFFFFF !important;
      }
      html.admin-theme:not(.theme-dark) .bg-slate-50 {
        background-color: #F8FAFC !important;
      }
      html.admin-theme:not(.theme-dark) .bg-slate-100 {
        background-color: #F1F5F9 !important;
      }
      html.admin-theme:not(.theme-dark) .border-slate-200 {
        border-color: #E2E8F0 !important;
      }
      html.admin-theme:not(.theme-dark) .border-slate-100 {
        border-color: #F1F5F9 !important;
      }
      html.admin-theme:not(.theme-dark) .text-slate-900 {
        color: #0F172A !important;
      }
      html.admin-theme:not(.theme-dark) .text-slate-800 {
        color: #1E293B !important;
      }
      html.admin-theme:not(.theme-dark) .text-slate-700 {
        color: #334155 !important;
      }
      html.admin-theme:not(.theme-dark) .text-slate-600 {
        color: #475569 !important;
      }
      html.admin-theme:not(.theme-dark) .text-slate-500 {
        color: #64748B !important;
      }
      html.admin-theme:not(.theme-dark) .text-slate-400 {
        color: #94A3B8 !important;
      }
      html.admin-theme.theme-dark .text-white,
      html.admin-theme :is(button, a, span, div)[class*="bg-blue-"].text-white,
      html.admin-theme :is(button, a, span, div)[class*="bg-emerald-"].text-white,
      html.admin-theme :is(button, a, span, div)[class*="bg-rose-"].text-white,
      html.admin-theme :is(button, a, span, div)[class*="bg-red-"].text-white,
      html.admin-theme :is(button, a, span, div)[class*="bg-slate-900"].text-white,
      html.admin-theme :is(button, a, span, div)[class*="bg-slate-800"].text-white {
        color: #FFFFFF !important;
      }
      /* Desk shell uses the same foreground token as the public site.
         The rule above keeps literal white on existing blue buttons. */
      html.admin-theme .desk-fg {
        color: var(--color-text-primary) !important;
      }
      html.admin-theme .desk-hover:hover {
        color: var(--color-text-primary) !important;
      }
      html.admin-theme .desk-on-accent {
        color: #FFFFFF !important;
      }
      html.admin-theme:not(.theme-dark) input:not([type="checkbox"]):not([type="radio"]),
      html.admin-theme:not(.theme-dark) select,
      html.admin-theme:not(.theme-dark) textarea {
        background-color: #FFFFFF;
        color: #0F172A;
      }
      html.admin-theme:not(.theme-dark) input::placeholder,
      html.admin-theme:not(.theme-dark) textarea::placeholder {
        color: #94A3B8 !important;
      }
      html.admin-theme:not(.theme-dark) .ProseMirror {
        color: #1E293B !important;
        background-color: transparent !important;
      }
      html.admin-theme:not(.theme-dark) .ProseMirror p.is-editor-empty:first-child::before {
        color: #94A3B8 !important;
      }
      .find-match {
        background-color: #FDE68A;
        color: #1F2328;
        border-radius: 2px;
      }
      .find-match-active {
        background-color: #F59E0B;
        color: #1F2328;
        box-shadow: inset 0 -2px 0 #B45309;
      }
      html.admin-theme.theme-dark .bg-white {
        background-color: #1C1B1F !important;
      }
      html.admin-theme.theme-dark .hover\:bg-white:hover {
        background-color: #323238 !important;
      }
      html.admin-theme.theme-dark .bg-slate-50,
      html.admin-theme.theme-dark .bg-slate-50\/50,
      html.admin-theme.theme-dark .bg-slate-50\/60,
      html.admin-theme.theme-dark .bg-slate-50\/70,
      html.admin-theme.theme-dark .bg-slate-50\/80 {
        background-color: #16161A !important;
      }
      html.admin-theme.theme-dark .hover\:bg-slate-50:hover,
      html.admin-theme.theme-dark .hover\:bg-slate-50\/50:hover,
      html.admin-theme.theme-dark .hover\:bg-slate-50\/70:hover,
      html.admin-theme.theme-dark .hover\:bg-slate-50\/80:hover {
        background-color: #323238 !important;
      }
      html.admin-theme.theme-dark .bg-slate-100 {
        background-color: #2A2A30 !important;
      }
      html.admin-theme.theme-dark .hover\:bg-slate-100:hover {
        background-color: #3A3A42 !important;
      }
      html.admin-theme.theme-dark .bg-slate-200 {
        background-color: #2A2925 !important;
      }
      html.admin-theme.theme-dark .bg-slate-900 {
        background-color: #3F3F46 !important;
      }
      html.admin-theme.theme-dark .hover\:bg-slate-800:hover,
      html.admin-theme.theme-dark .bg-slate-800 {
        background-color: #52525B !important;
      }
      html.admin-theme.theme-dark .text-slate-900,
      html.admin-theme.theme-dark .text-slate-800,
      html.admin-theme.theme-dark .hover\:text-slate-900:hover,
      html.admin-theme.theme-dark .hover\:text-slate-800:hover {
        color: #F8FAFC !important;
      }
      html.admin-theme.theme-dark .text-slate-700,
      html.admin-theme.theme-dark .text-slate-600,
      html.admin-theme.theme-dark .hover\:text-slate-700:hover,
      html.admin-theme.theme-dark .hover\:text-slate-600:hover {
        color: #E2E8F0 !important;
      }
      html.admin-theme.theme-dark .text-slate-500,
      html.admin-theme.theme-dark .text-slate-400,
      html.admin-theme.theme-dark .hover\:text-slate-500:hover,
      html.admin-theme.theme-dark .hover\:text-slate-400:hover {
        color: #A0A0A3 !important;
      }
      html.admin-theme.theme-dark .text-blue-600,
      html.admin-theme.theme-dark .hover\:text-blue-600:hover,
      html.admin-theme.theme-dark .text-blue-700,
      html.admin-theme.theme-dark .hover\:text-blue-700:hover {
        color: #93C5FD !important;
      }
      html.admin-theme.theme-dark .text-red-500,
      html.admin-theme.theme-dark .text-red-600,
      html.admin-theme.theme-dark .text-red-700,
      html.admin-theme.theme-dark .text-red-800,
      html.admin-theme.theme-dark .text-rose-950,
      html.admin-theme.theme-dark .hover\:text-red-600:hover,
      html.admin-theme.theme-dark .hover\:text-red-800:hover {
        color: #FCA5A5 !important;
      }
      html.admin-theme.theme-dark .text-emerald-700,
      html.admin-theme.theme-dark .text-emerald-800,
      html.admin-theme.theme-dark .text-emerald-950 {
        color: #6EE7B7 !important;
      }
      html.admin-theme.theme-dark .text-amber-700,
      html.admin-theme.theme-dark .text-amber-900,
      html.admin-theme.theme-dark .text-amber-950 {
        color: #FCD34D !important;
      }
      html.admin-theme.theme-dark .bg-blue-50,
      html.admin-theme.theme-dark .bg-blue-50\/40,
      html.admin-theme.theme-dark .bg-blue-50\/50,
      html.admin-theme.theme-dark .hover\:bg-blue-50\/20:hover {
        background-color: rgba(50, 124, 246, 0.16) !important;
      }
      html.admin-theme.theme-dark .text-blue-950 {
        color: #BFDBFE !important;
      }
      html.admin-theme.theme-dark .bg-blue-100,
      html.admin-theme.theme-dark .hover\:bg-blue-100:hover {
        background-color: rgba(50, 124, 246, 0.28) !important;
      }
      html.admin-theme.theme-dark .bg-red-50,
      html.admin-theme.theme-dark .bg-rose-50\/50,
      html.admin-theme.theme-dark .hover\:bg-red-50:hover {
        background-color: rgba(239, 68, 68, 0.14) !important;
      }
      html.admin-theme.theme-dark .bg-red-100,
      html.admin-theme.theme-dark .hover\:bg-red-100:hover,
      html.admin-theme.theme-dark .hover\:bg-red-200:hover {
        background-color: rgba(239, 68, 68, 0.24) !important;
      }
      html.admin-theme.theme-dark .border-red-200 {
        border-color: rgba(248, 113, 113, 0.4) !important;
      }
      html.admin-theme.theme-dark .bg-emerald-50,
      html.admin-theme.theme-dark .bg-emerald-50\/50 {
        background-color: rgba(16, 185, 129, 0.14) !important;
      }
      html.admin-theme.theme-dark .border-emerald-200 {
        border-color: rgba(52, 211, 153, 0.4) !important;
      }
      html.admin-theme.theme-dark .bg-amber-50,
      html.admin-theme.theme-dark .bg-amber-50\/50,
      html.admin-theme.theme-dark .bg-amber-50\/60 {
        background-color: rgba(245, 158, 11, 0.14) !important;
      }
      html.admin-theme.theme-dark .border-amber-200 {
        border-color: rgba(251, 191, 36, 0.4) !important;
      }
      /* ── Violet / Bilingual AI accent overrides (dark mode) ── */
      html.admin-theme.theme-dark .bg-violet-600,
      html.admin-theme.theme-dark .hover\:bg-violet-700:hover,
      html.admin-theme.theme-dark .active\:bg-violet-800:active {
        background-color: #7C3AED !important;
      }
      html.admin-theme.theme-dark .hover\:bg-violet-700:hover {
        background-color: #6D28D9 !important;
      }
      html.admin-theme.theme-dark .bg-violet-100 {
        background-color: rgba(124, 58, 237, 0.18) !important;
      }
      html.admin-theme.theme-dark .bg-violet-50,
      html.admin-theme.theme-dark .hover\:bg-violet-100:hover {
        background-color: rgba(124, 58, 237, 0.14) !important;
      }
      html.admin-theme.theme-dark .text-violet-700 {
        color: #C4B5FD !important;
      }
      html.admin-theme.theme-dark .border-violet-200 {
        border-color: rgba(196, 181, 253, 0.35) !important;
      }
      html.admin-theme.theme-dark .focus\:border-violet-500:focus,
      html.admin-theme.theme-dark .focus\:border-violet-400:focus {
        border-color: rgba(167, 139, 250, 0.6) !important;
      }
      /* ── Indigo / AI Copilot overrides (dark mode) ── */
      html.admin-theme.theme-dark .bg-indigo-50,
      html.admin-theme.theme-dark .hover\:bg-indigo-100:hover {
        background-color: rgba(99, 102, 241, 0.16) !important;
      }
      html.admin-theme.theme-dark .text-indigo-700 {
        color: #A5B4FC !important;
      }
      html.admin-theme.theme-dark .border-indigo-200 {
        border-color: rgba(165, 180, 252, 0.35) !important;
      }
      html.admin-theme.theme-dark .text-emerald-700 {
        color: #6EE7B7 !important;
      }
      html.admin-theme.theme-dark .bg-emerald-600,
      html.admin-theme.theme-dark .hover\:bg-emerald-700:hover {
        background-color: #059669 !important;
      }
      html.admin-theme.theme-dark .selection\:bg-blue-100::selection,
      html.admin-theme.theme-dark .selection\:bg-blue-100 *::selection,
      html.admin-theme.theme-dark ::selection {
        background-color: #1D4ED8 !important;
        color: #FFFFFF !important;
      }
      html.admin-theme.theme-dark .placeholder\:text-slate-400::placeholder,
      html.admin-theme.theme-dark .placeholder\:text-slate-300::placeholder {
        color: #8B8B90 !important;
      }
      html.admin-theme.theme-dark .border-slate-100,
      html.admin-theme.theme-dark .border-slate-200,
      html.admin-theme.theme-dark .border-slate-300,
      html.admin-theme.theme-dark .divide-slate-100 > :not(:last-child),
      html.admin-theme.theme-dark .divide-slate-200 > :not(:last-child),
      html.admin-theme.theme-dark .divide-slate-100 > :not([hidden]) ~ :not([hidden]),
      html.admin-theme.theme-dark .divide-slate-200 > :not([hidden]) ~ :not([hidden]) {
        border-color: #2A2925 !important;
      }
      html.admin-theme.theme-dark input:not([type="checkbox"]):not([type="radio"]),
      html.admin-theme.theme-dark select,
      html.admin-theme.theme-dark textarea {
        background-color: #1C1B1F;
        color: #F8FAFC;
        border-color: #2A2925;
      }
      html.admin-theme.theme-dark textarea.bg-slate-900 {
        background-color: #0F0F12 !important;
        color: #F1F5F9 !important;
      }
      html.admin-theme.theme-dark .ProseMirror {
        color: #E2E8F0 !important;
        background-color: transparent !important;
      }
      html.admin-theme.theme-dark .ProseMirror p.is-editor-empty:first-child::before {
        color: #8B8B90 !important;
      }
      html.admin-theme.theme-dark .find-match {
        background-color: #854D0E;
        color: #FFFBEB;
      }
      html.admin-theme.theme-dark .find-match-active {
        background-color: #D97706;
        color: #FFFBEB;
        box-shadow: inset 0 -2px 0 #FDE68A;
      }
      html.admin-theme.theme-dark ::-webkit-scrollbar-thumb {
        background: #3F3F46;
      }
      html.admin-theme.theme-dark ::-webkit-scrollbar-thumb:hover {
        background: #52525B;
      }
      .admin-layout * {
        box-sizing: border-box;
      }
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94A3B8;
      }
    </style>
  </head>
  <body class="admin-layout admin-theme-body h-full flex overflow-hidden">

    <!-- Auth Verification Guard -->
    <script>
      import { deskGate, loadSession, roleLabel } from '../lib/adminSession';

      try {
        const user = await loadSession();
        const gate = deskGate(user, window.location.pathname);
        if (gate === 'login') {
          const returnTo = window.location.pathname + window.location.search;
          window.location.replace(`/login?returnTo=${encodeURIComponent(returnTo)}`);
        } else if (gate === 'home') {
          window.location.replace('/');
        } else if (gate === 'posts') {
          window.location.replace('/administrator');
        } else if (user) {
          const nameEl = document.getElementById('admin-user-name');
          const roleEl = document.getElementById('admin-user-role');
          const avatarEl = document.getElementById('admin-user-avatar');
          if (nameEl) nameEl.textContent = user.name || user.email || 'Staff';
          if (roleEl) roleEl.textContent = roleLabel(user.role);
          if (avatarEl) avatarEl.textContent = (user.name || user.email || 'S')[0].toUpperCase();
          document.documentElement.classList.remove('auth-pending');
        }
      } catch (_) {
        document.body.textContent = 'Unable to verify access. Please try again later.';
        document.documentElement.classList.remove('auth-pending');
      }

    </script>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div 
      id="admin-mobile-backdrop" 
      class="fixed inset-0 bg-slate-900/30 z-40 lg:hidden hidden transition-opacity"
    ></div>

    {!fullWidth && (
      <aside 
        id="admin-sidebar"
        class="fixed inset-y-0 left-0 z-50 w-60 bg-white border-r border-slate-200 flex flex-col justify-between transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out shrink-0"
      >
        <div>
          <!-- Top CMS Brand -->
          <div class="h-14 flex items-center justify-between px-5 border-b border-slate-100">
            <a href="/administrator" class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-md bg-blue-600 text-white flex items-center justify-center font-bold text-xs tracking-tight">
                EP
              </div>
              <div class="leading-tight">
                <span class="block text-xs font-bold text-slate-900 tracking-tight">{siteName}</span>
                <span class="block text-[10px] font-medium text-slate-400">Desk</span>
              </div>
            </a>
            <button 
              id="close-mobile-sidebar-btn" 
              class="lg:hidden p-1 rounded-md text-slate-400 hover:text-slate-600 hover:bg-slate-50"
              aria-label="Close menu"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Navigation Links (Clean & Uncluttered) -->
          <nav class="p-3 space-y-1 text-xs font-medium">
            <a 
              href="/administrator" 
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md transition ${
                activeNav === 'posts' 
                  ? 'bg-slate-100 text-slate-900 font-semibold' 
                  : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
              }`}
            >
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <span>Articles</span>
            </a>

            <a 
              href="/administrator#categories-section" 
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md transition ${
                activeNav === 'categories' 
                  ? 'bg-slate-100 text-slate-900 font-semibold' 
                  : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
              }`}
            >
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>Blog Categories</span>
            </a>

            <a 
              href="/editor" 
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md transition ${
                activeNav === 'new-post' 
                  ? 'bg-slate-100 text-slate-900 font-semibold' 
                  : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
              }`}
            >
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Write Article</span>
            </a>

            <a
              href="/administrator/users"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md transition ${
                activeNav === 'users'
                  ? 'bg-slate-100 text-slate-900 font-semibold'
                  : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
              }`}
            >
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2m18 0v-2a4 4 0 00-3-3.87m-1-12.15a4 4 0 010 7.75M12 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <span>Users</span>
            </a>

            <a
              href="/administrator/notifications"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-md transition ${
                activeNav === 'notifications'
                  ? 'bg-slate-100 text-slate-900 font-semibold'
                  : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
              }`}
            >
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              <span>Notifications</span>
            </a>

            <div class="pt-4 pb-1">
              <span class="px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400">External</span>
            </div>

            <a 
              href="/blog" 
              target="_blank"
              class="flex items-center justify-between px-3 py-2 rounded-md text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span>Public Blog</span>
              </div>
              <span class="text-[10px] text-slate-400 font-mono">↗</span>
            </a>

            <a 
              href="/sitemap.xml" 
              target="_blank"
              class="flex items-center justify-between px-3 py-2 rounded-md text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>XML Sitemap</span>
              </div>
              <span class="text-[10px] text-slate-400 font-mono">↗</span>
            </a>
          </nav>
        </div>

        <!-- Bottom User Account Badge -->
        <div class="p-3 border-t border-slate-100 bg-white">
          <div class="flex items-center gap-2.5 px-2 py-1.5">
            <div 
              id="admin-user-avatar"
              class="w-7 h-7 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-xs"
            >
              A
            </div>
            <div class="flex-1 min-w-0">
              <span id="admin-user-name" class="block text-xs font-semibold text-slate-800 truncate">Editorial Staff</span>
              <span id="admin-user-role" class="block text-[10px] font-mono text-slate-400">ADMIN</span>
            </div>
            <a 
              href="/" 
              title="Exit Admin"
              class="p-1 rounded text-slate-400 hover:text-slate-600 hover:bg-slate-50 transition"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </a>
          </div>
        </div>
      </aside>
    )}

    {!fullWidth && (
      <div class="flex-1 flex flex-col min-w-0 lg:pl-60">
        
        <!-- Top Action Bar (Clean light mode) -->
        <header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-6 shrink-0 z-30 shadow-2xs">
          
          <!-- Left: Mobile Menu Trigger + Context Breadcrumb -->
          <div class="flex items-center gap-3">
            <button 
              id="open-mobile-sidebar-btn"
              class="lg:hidden p-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition"
              aria-label="Open navigation"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>

            <div class="flex items-center gap-2 text-xs text-slate-500">
              <a href="/administrator" class="hover:text-slate-800 font-medium transition">Desk</a>
              <span>/</span>
              <span class="font-semibold text-slate-900">{title}</span>
            </div>
          </div>

          <!-- Right: Slot for page actions (e.g., Save Draft, Publish, etc.) -->
          <div class="flex items-center gap-2">
            <slot name="header-actions" />
          </div>
        </header>

        <!-- Scrollable Page Canvas -->
        <main class="flex-1 overflow-y-auto">
          <slot />
        </main>
      </div>
    )}

    {fullWidth && (
      <div class="flex-1 flex flex-col min-w-0 h-full overflow-hidden bg-white">
        <slot />
      </div>
    )}

    <!-- Mobile Drawer Interaction Script -->
    <script>
      const mobileBtn = document.getElementById('open-mobile-sidebar-btn');
      const closeBtn = document.getElementById('close-mobile-sidebar-btn');
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('admin-mobile-backdrop');

      function openDrawer() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
      }

      function closeDrawer() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
      }

      mobileBtn?.addEventListener('click', openDrawer);
      closeBtn?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);
    </script>
  </body>
</html>
