---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import TrendingBanner from '../components/TrendingBanner.astro';
import SearchModal from '../components/SearchModal.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { whatsappChannel, telegramChannel } from '../data/site';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: object;
  hideHeaderFooter?: boolean;
  alternateLinks?: { hreflang: string; href: string }[];
  noindex?: boolean;
}

const siteOrigin = 'https://govtpariksha.com';
const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '' : currentPath.replace(/\/$/, '');

const {
  title = "govtpariksha.com - Govt Jobs, Admissions & Results",
  description = "Get verified government examination notices, admit cards, answer keys and counselling results on govtpariksha.com.",
  canonicalUrl = `${siteOrigin}${cleanPath || '/'}`,
  ogImage = `${siteOrigin}/og-image.jpg`,
  ogType = Astro.props.publishedTime ? 'article' : 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  hideHeaderFooter = false,
  alternateLinks = [],
  noindex = false,
} = Astro.props;

// Ensure ogImage is always an absolute URL for social crawlers (WhatsApp, Facebook, Twitter, Telegram)
const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// Derive OG image MIME type from URL extension (blog images may be jpg/webp, not always png)
const ogImageExt = resolvedOgImage.split('?')[0].split('.').pop()?.toLowerCase() || 'png';
const ogImageType = ogImageExt === 'jpg' || ogImageExt === 'jpeg' ? 'image/jpeg'
  : ogImageExt === 'webp' ? 'image/webp'
  : ogImageExt === 'gif' ? 'image/gif'
  : 'image/png';

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const yandexVerification = import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en" class="theme-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Preconnect to Google Fonts (saves ~200ms per Lighthouse) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* DNS prefetch for Clerk & R2 (reduces connection setup time) */}
    <link rel="dns-prefetch" href="https://notable-raven-5844.clerk.accounts.dev" />
    <link rel="dns-prefetch" href="https://pub-68568854a58845bc975b176de76b1ad5.r2.dev" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a58ca" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    {/* Search Engine Verifications if configured */}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}

    {/* Multilingual Alternate Language Links */}
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    {/* Open Graph / Facebook / WhatsApp */}
    <meta property="og:site_name" content="GovtPariksha" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    {/* ClientRouter for page transitions */}
    <ClientRouter />

    {/* Structured Data (JSON-LD) */}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {/* Apply the saved theme before paint, and again after view transitions replace the html class */}
    <script is:inline>
      (function() {
        function applyStoredTheme() {
          var pref = localStorage.getItem('theme_preference') || localStorage.getItem('theme');
          var dark = pref === 'dark';
          document.documentElement.classList.toggle('theme-dark', dark);
          document.documentElement.classList.toggle('theme-light', !dark);
        }
        applyStoredTheme();
        if (!window.__examThemeBound) {
          window.__examThemeBound = true;
          document.addEventListener('astro:after-swap', applyStoredTheme);
        }
      })();
    </script>
  </head>
  <body class="bg-canvas min-h-screen flex flex-col font-sans text-white antialiased selection:bg-accent selection:text-white transition-colors duration-200">
    {/* Body Row: Sidebar on Left + Main Area (Header + Content + Footer) on Right */}
    <div class="flex-1 flex min-h-screen relative">
      {/* Desktop Left Navigation Sidebar (Full height on left) */}
      {!hideHeaderFooter && (
        <div id="desktop-sidebar-wrapper" class="hidden lg:block shrink-0 relative z-[1050] transition-all duration-300">
          <LeftSidebar prefix="desktop" />
        </div>
      )}

      {/* Main Area: Header (Header width decreases when sidebar is open!) + Content + Footer */}
      <div id="main-content-wrapper" class="flex-1 min-w-0 flex flex-col min-h-screen">
        {!hideHeaderFooter && <Header />}
        <main class="flex-grow">
          <slot />
        </main>
        {!hideHeaderFooter && <Footer />}
      </div>
    </div>

    {/* ══ Modern Mobile Sidebar Drawer ══════════════════════════════ */}
    {/* Backdrop — clicking it closes the drawer */}
    <div 
      id="mobile-sidebar-backdrop" 
      class="fixed inset-0 z-[9998] hidden"
      aria-hidden="true"
    >
      {/* Dark translucent overlay */}
      <div 
        id="mobile-backdrop-overlay"
        class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"
      ></div>
    </div>

    {/* Drawer Panel */}
    <div 
      id="mobile-sidebar-container" 
      class="fixed inset-y-0 left-0 z-[9999] w-72 max-w-[85vw] bg-canvas border-r border-border shadow-2xl flex flex-col transform -translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform"
      aria-label="Navigation menu"
      role="dialog"
      aria-modal="true"
    >
      {/* ── Drawer Header ── */}
      <div class="flex items-center justify-between h-14 px-4 border-b border-border/60 shrink-0 bg-canvas">
        <a href="/" class="flex items-center gap-2 group" aria-label="govtpariksha.com home">
          <BrandLogo size={32} class="group-hover:scale-105 transition-transform shrink-0" />
          <span class="font-bold text-sm tracking-tight text-white">
            govtpariksha<span class="text-accent">.com</span>
          </span>
        </a>
        <button 
          data-mobile-sidebar-close
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-lg text-muted hover:text-white hover:bg-surface-raised border border-border/40 hover:border-border transition-all cursor-pointer"
          aria-label="Close menu"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {/* ── Scrollable Nav Body ── */}
      <nav class="flex-1 overflow-y-auto overscroll-contain pt-0 px-3 pb-3 space-y-5 scrollbar-none">
        
        {/* Channels Section */}
        <div>
          <p class="px-3 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-muted/70">Channels</p>
          <div class="space-y-0.5">
            <a href={whatsappChannel} target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all group"
            >
              <svg class="w-4 h-4 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span class="text-sm font-medium">WhatsApp channel</span>
            </a>
            <a href={telegramChannel} target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all group"
            >
              <svg class="w-4 h-4 shrink-0 text-[#2AABEE]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              <span class="text-sm font-medium">Telegram channel</span>
            </a>
          </div>
        </div>

        {/* Browse Section */}
        <div>
          <p class="px-3 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-accent/80">Browse</p>
          <div class="space-y-0.5">
            <a href="/" data-mobile-sidebar-close
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-surface-raised text-white font-semibold text-sm shadow-xs border border-border/40"
            >
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10h5v-6h4v6h5V10" />
              </svg>
              <span>Home</span>
            </a>
            <a href="/#important-links" data-mobile-sidebar-close
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all text-sm font-medium"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5" />
              </svg>
              <span>Important links</span>
            </a>
            <a href="/#faqs" data-mobile-sidebar-close
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all text-sm font-medium"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>FAQs</span>
            </a>
          </div>
        </div>

        {/* Divider */}
        <div class="border-t border-border/50 mx-3"></div>

        {/* Help */}
        <div class="space-y-0.5">
          <a href="/#important-links" data-mobile-sidebar-close
            class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised transition-all text-sm font-medium"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"/>
            </svg>
            <span>Help and resources</span>
          </a>
        </div>
      </nav>

      {/* ── Bottom Auth Section ── */}
      <div class="p-3 border-t border-border/60 shrink-0">
        {/* Logged Out */}
        <div class="sidebar-auth-logged-out block">
          <a href="/login" data-mobile-sidebar-close
            class="flex items-center justify-center gap-2.5 w-full py-3 px-4 rounded-xl bg-accent hover:bg-accent/90 text-white font-semibold text-sm transition shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            Log in / Sign up
          </a>
        </div>

        {/* Logged In */}
        <div class="sidebar-auth-logged-in hidden">
          <button
            class="sidebar-profile-card w-full flex items-center gap-3 p-2.5 rounded-xl bg-surface-raised/40 hover:bg-surface-raised border border-border/50 hover:border-border transition cursor-pointer"
          >
            <div class="w-9 h-9 rounded-full bg-surface-raised border border-border text-white flex items-center justify-center font-bold text-xs shrink-0 overflow-hidden">
              <span class="user-avatar-initials">GP</span>
              <img class="user-avatar-img hidden w-full h-full object-cover" alt="Avatar" />
            </div>
            <div class="flex-1 min-w-0 text-left">
              <p class="user-display-name text-sm font-bold text-white truncate leading-tight">User</p>
              <p class="user-display-email text-xs text-muted leading-none mt-0.5 truncate">Free</p>
            </div>
          </button>
        </div>
      </div>
    </div>


    {/* Global Search Modal (Matching Image 1) */}
    <SearchModal />

    {/* Global Robust Interactive Script */}
    <script>
      import { markAllNotificationsRead, markNotificationRead, refreshNotifications, requestBrowserNotificationPermission, updateBrowserNotificationUI } from '../lib/notifications';

      (function initApp() {
        if ((window as any).__APP_INTERACTIVITY_INITIALIZED__) return;
        (window as any).__APP_INTERACTIVITY_INITIALIZED__ = true;

        // --- Theme Management ---
        function updateAllThemeToggles(isLight: boolean) {
          const knobs = document.querySelectorAll('.theme-toggle-knob');
          const darkIcons = document.querySelectorAll('.dark-icon');
          const lightIcons = document.querySelectorAll('.light-icon');

          knobs.forEach((knob) => {
            if (isLight) {
              knob.classList.remove('translate-x-6');
              knob.classList.add('translate-x-0.5');
            } else {
              knob.classList.remove('translate-x-0.5');
              knob.classList.add('translate-x-6');
            }
          });

          darkIcons.forEach((icon) => {
            if (isLight) icon.classList.add('hidden');
            else icon.classList.remove('hidden');
          });

          lightIcons.forEach((icon) => {
            if (isLight) icon.classList.remove('hidden');
            else icon.classList.add('hidden');
          });
        }

        function toggleTheme() {
          const isCurrentlyDark = document.documentElement.classList.contains('theme-dark');
          const nextLight = isCurrentlyDark; // If currently dark, toggle to light; otherwise toggle to dark

          if (nextLight) {
            document.documentElement.classList.remove('theme-dark');
            document.documentElement.classList.add('theme-light');
            localStorage.setItem('theme', 'light');
            localStorage.setItem('theme_preference', 'light');
          } else {
            document.documentElement.classList.add('theme-dark');
            document.documentElement.classList.remove('theme-light');
            localStorage.setItem('theme', 'dark');
            localStorage.setItem('theme_preference', 'dark');
          }

          updateAllThemeToggles(nextLight);
        }

        // --- Robust Dropdown Management (Safe from Timeout Clashes) ---
        function closeDropdown(menu: HTMLElement) {
          menu.classList.remove('scale-100', 'opacity-100');
          menu.classList.add('scale-95', 'opacity-0');

          const prevTimer = menu.getAttribute('data-close-timer');
          if (prevTimer) clearTimeout(Number(prevTimer));

          const timer = window.setTimeout(() => {
            menu.classList.add('hidden');
            menu.removeAttribute('data-close-timer');
          }, 150);
          menu.setAttribute('data-close-timer', String(timer));
        }

        function openDropdown(menu: HTMLElement, trigger: HTMLElement) {
          const prevTimer = menu.getAttribute('data-close-timer');
          if (prevTimer) {
            clearTimeout(Number(prevTimer));
            menu.removeAttribute('data-close-timer');
          }

          menu.classList.remove('hidden');
          requestAnimationFrame(() => {
            menu.classList.remove('scale-95', 'opacity-0');
            menu.classList.add('scale-100', 'opacity-100');
          });
          trigger.setAttribute('aria-expanded', 'true');
        }

        function closeAllDropdowns(exceptMenu?: HTMLElement | null) {
          document.querySelectorAll<HTMLElement>('[role="menu"]').forEach((menu) => {
            if (menu !== exceptMenu) {
              closeDropdown(menu);
            }
          });
          document.querySelectorAll('[data-profile-trigger]').forEach((trigger) => {
            if (!exceptMenu || trigger.getAttribute('data-profile-trigger') !== exceptMenu.id) {
              trigger.setAttribute('aria-expanded', 'false');
            }
          });
          // Close notifications popup
          const notifPopup = document.querySelector<HTMLElement>('[data-notification-popup]');
          if (notifPopup && notifPopup !== exceptMenu) {
            notifPopup.classList.add('hidden', 'scale-95', 'opacity-0');
            notifPopup.classList.remove('scale-100', 'opacity-100');
          }
          // Close language dropdown
          const langDropdown = document.getElementById('header-language-dropdown');
          if (langDropdown && langDropdown !== exceptMenu) {
            langDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            langDropdown.classList.remove('scale-100', 'opacity-100');
          }
          // Close favorites dropdown
          const favDropdown = document.getElementById('header-favorites-dropdown');
          if (favDropdown && favDropdown !== exceptMenu) {
            favDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            favDropdown.classList.remove('scale-100', 'opacity-100');
          }
        }

        // --- Mobile Drawer Management ---
        function updateHamburgerIcon(isOpen: boolean) {
          const btn = document.getElementById('mobile-drawer-toggle-btn');
          if (!btn) return;
          const svg = btn.querySelector('svg');
          if (!svg) return;
          if (isOpen) {
            svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
          } else {
            svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          }
        }

        function openMobileDrawer() {
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (!backdrop || !container) return;

          // Show backdrop wrapper first (makes overlay and container visible)
          backdrop.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          updateHamburgerIcon(true);

          // Animate in on next frame
          requestAnimationFrame(() => {
            if (overlay) overlay.classList.add('opacity-100');
            container.classList.remove('-translate-x-full');
            container.classList.add('translate-x-0');
          });
        }

        function closeMobileDrawer() {
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (!backdrop || !container) return;

          // Animate out
          if (overlay) overlay.classList.remove('opacity-100');
          container.classList.remove('translate-x-0');
          container.classList.add('-translate-x-full');
          updateHamburgerIcon(false);

          // Hide after animation completes
          setTimeout(() => {
            backdrop.classList.add('hidden');
            document.body.style.overflow = '';
          }, 320);
        }

        // --- Desktop Sidebar Collapse Management (Matches Image 1) ---
        let hoverPeekTimer: number | null = null;

        function setSidebarCollapsed(isCollapsed: boolean) {
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          const headerBrand = document.getElementById('header-brand-collapsed');
          const tooltipText = document.getElementById('sidebar-toggle-tooltip-text');
          if (wrapper) {
            wrapper.classList.remove('hover-peek');
            if (isCollapsed) {
              wrapper.classList.add('collapsed');
              if (headerBrand) {
                headerBrand.classList.remove('hidden');
                headerBrand.classList.add('flex');
              }
              if (tooltipText) tooltipText.textContent = 'Expand sidebar';
            } else {
              wrapper.classList.remove('collapsed');
              if (headerBrand) {
                headerBrand.classList.add('hidden');
                headerBrand.classList.remove('flex');
              }
              if (tooltipText) tooltipText.textContent = 'Collapse sidebar';
            }
            localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
          }
        }

        function toggleDesktopSidebar() {
          if (window.innerWidth < 1024) {
            openMobileDrawer();
          } else {
            const wrapper = document.getElementById('desktop-sidebar-wrapper');
            wrapper?.classList.remove('hover-peek');
            const isCurrentlyCollapsed = wrapper?.classList.contains('collapsed') ?? false;
            setSidebarCollapsed(!isCurrentlyCollapsed);
          }
        }

        // --- Hover-Peek: On hover of collapse icon/pill in header, open temporarily until clicked ---
        function startHoverPeek() {
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          if (!wrapper || !wrapper.classList.contains('collapsed')) return;
          if (hoverPeekTimer) {
            clearTimeout(hoverPeekTimer);
            hoverPeekTimer = null;
          }
          wrapper.classList.add('hover-peek');
        }

        function endHoverPeek() {
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          if (!wrapper) return;
          if (hoverPeekTimer) clearTimeout(hoverPeekTimer);
          hoverPeekTimer = window.setTimeout(() => {
            wrapper.classList.remove('hover-peek');
            hoverPeekTimer = null;
          }, 220);
        }

        function cancelHoverPeekTimer() {
          if (hoverPeekTimer) {
            clearTimeout(hoverPeekTimer);
            hoverPeekTimer = null;
          }
        }

        // Setup hover-peek triggers (Header button + Floating Sidebar)
        const headerToggleWrapper = document.getElementById('header-sidebar-toggle-wrapper');
        const desktopWrapper = document.getElementById('desktop-sidebar-wrapper');

        if (headerToggleWrapper) {
          headerToggleWrapper.addEventListener('mouseenter', startHoverPeek);
          headerToggleWrapper.addEventListener('mouseleave', endHoverPeek);
        }

        if (desktopWrapper) {
          desktopWrapper.addEventListener('mouseenter', cancelHoverPeekTimer);
          desktopWrapper.addEventListener('mouseleave', () => {
            if (desktopWrapper.classList.contains('hover-peek')) {
              endHoverPeek();
            }
          });
        }

        // Restore Collapsed State on Start
        const savedCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
        setSidebarCollapsed(savedCollapsed);

        // Sync theme UI toggle knobs on start (Default is LIGHT)
        const initialIsLight = !document.documentElement.classList.contains('theme-dark');
        updateAllThemeToggles(initialIsLight);

        // --- Language Switcher Integration ---
        function setLanguage(lang: string, shouldNavigate: boolean = false) {
          const normalized = (lang === 'en' || lang === 'english' || lang === 'ENGLISH') ? 'en' : 'hinglish';
          try {
            localStorage.setItem('preferred_exam_lang', normalized);
            localStorage.setItem('site_language', normalized);
            document.cookie = `preferred_lang=${normalized};path=/;max-age=31536000;SameSite=Lax`;
          } catch (e) {}

          const label = document.getElementById('current-language-label');
          if (label) label.textContent = normalized === 'en' ? 'EN' : 'HI';

          // Update UI buttons across ProfileDropdown, LeftSidebar, and LanguageSwitcher
          const appLangBtns = document.querySelectorAll<HTMLElement>('[data-app-lang], [data-global-lang]');
          appLangBtns.forEach((btn) => {
            const btnLang = btn.getAttribute('data-app-lang') || btn.getAttribute('data-global-lang');
            const isBtnActive = (btnLang === normalized);
            if (isBtnActive) {
              btn.classList.add('bg-accent/20', 'text-accent', 'font-bold', 'border-accent/40', 'shadow-2xs');
              btn.classList.remove('text-muted');
            } else {
              btn.classList.remove('bg-accent/20', 'text-accent', 'font-bold', 'border-accent/40', 'shadow-2xs');
              btn.classList.add('text-muted');
            }
          });

          // If on a blog article page and user initiated switch, navigate to corresponding language version
          if (shouldNavigate) {
            const currentPath = window.location.pathname;
            const currentSearch = new URLSearchParams(window.location.search);
            const isArticle = document.querySelector('.blog-reading-view') !== null || (currentPath !== '/' && !currentPath.startsWith('/admin') && !currentPath.startsWith('/login') && !currentPath.startsWith('/signup') && !currentPath.startsWith('/blog/'));

            if (isArticle) {
              if (normalized === 'en') {
                currentSearch.set('lang', 'en');
                const newUrl = `${currentPath}?${currentSearch.toString()}`;
                window.location.assign(newUrl);
              } else {
                currentSearch.delete('lang');
                const searchStr = currentSearch.toString();
                const newUrl = searchStr ? `${currentPath}?${searchStr}` : currentPath;
                window.location.assign(newUrl);
              }
            }
          }
        }

        const urlParams = new URLSearchParams(window.location.search);
        const urlLang = urlParams.get('lang');
        const initialLang = (urlLang === 'en' || urlLang === 'english')
          ? 'en'
          : (localStorage.getItem('preferred_exam_lang') || localStorage.getItem('site_language') || 'hinglish');
        setLanguage(initialLang, false);

        window.addEventListener('exam:language-change', ((e: CustomEvent) => {
          if (e.detail?.lang) setLanguage(e.detail.lang, false);
        }) as EventListener);

        // --- Global Spotlight Search Modal Management (Matching Image 1) ---
        const SEARCH_ITEMS = [
          { title: "UPSC", category: "exams", href: "https://www.upsc.gov.in/", tag: "Exam portal", icon: "🔗" },
          { title: "SSC", category: "exams", href: "https://ssc.gov.in/", tag: "Exam portal", icon: "🔗" },
          { title: "RRB", category: "exams", href: "https://rrb.indianrailways.gov.in/", tag: "Exam portal", icon: "🔗" },
          { title: "IBPS", category: "exams", href: "https://www.ibps.in/", tag: "Exam portal", icon: "🔗" },
          { title: "NTA", category: "exams", href: "https://nta.ac.in/", tag: "Exam portal", icon: "🔗" },
          { title: "BCECEB", category: "admissions", href: "https://bceceboard.bihar.gov.in/", tag: "Exam portal", icon: "🔗" },
          { title: "BPSC", category: "exams", href: "https://bpsc.bihar.gov.in/", tag: "Exam portal", icon: "🔗" },
          { title: "National Portal of India", category: "all", href: "https://www.india.gov.in/", tag: "Gov portal", icon: "🏛️" },
          { title: "DigiLocker", category: "all", href: "https://www.digilocker.gov.in/", tag: "Gov portal", icon: "🏛️" },
          { title: "Site FAQs", category: "all", href: "/#faqs", tag: "Help", icon: "❓" },
          { title: "Important official links", category: "all", href: "/#important-links", tag: "Links", icon: "📌" },
        ];

        let currentSearchCategory = 'all';
        let activeResultIndex = -1;

        function openSearchModal() {
          const modal = document.getElementById('global-search-modal');
          const container = document.getElementById('global-search-container');
          const input = document.getElementById('global-search-input') as HTMLInputElement | null;
          if (!modal || !container) return;

          closeAllDropdowns();
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          requestAnimationFrame(() => {
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
            container.classList.remove('scale-95');
            container.classList.add('scale-100');
          });
          if (input) {
            setTimeout(() => {
              input.focus();
              input.select();
            }, 60);
          }
        }

        function closeSearchModal() {
          const modal = document.getElementById('global-search-modal');
          const container = document.getElementById('global-search-container');
          if (!modal || !container) return;

          modal.classList.remove('opacity-100');
          modal.classList.add('opacity-0');
          container.classList.remove('scale-100');
          container.classList.add('scale-95');
          setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
          }, 180);
        }

        function renderSearchResults(query: string) {
          const emptyState = document.getElementById('search-empty-state');
          const resultsList = document.getElementById('search-results-list');
          if (!emptyState || !resultsList) return;

          const trimmed = query.trim().toLowerCase();
          if (trimmed.length < 2) {
            emptyState.classList.remove('hidden');
            resultsList.classList.add('hidden');
            resultsList.innerHTML = '';
            activeResultIndex = -1;
            return;
          }

          const filtered = SEARCH_ITEMS.filter((item) => {
            const matchesCategory = currentSearchCategory === 'all' || item.category === currentSearchCategory || item.category === 'all';
            const matchesQuery = item.title.toLowerCase().includes(trimmed) || item.tag.toLowerCase().includes(trimmed);
            return matchesCategory && matchesQuery;
          });

          emptyState.classList.add('hidden');
          resultsList.classList.remove('hidden');

          if (filtered.length === 0) {
            resultsList.innerHTML = `
              <div class="py-8 text-center text-muted text-body-sm">
                <p>No results found for "${query}"</p>
                <p class="text-caption-xs mt-1 text-muted/70">Try searching for UPSC, SSC, RRB, or an official portal</p>
              </div>
            `;
            activeResultIndex = -1;
            return;
          }

          resultsList.innerHTML = filtered.map((item, idx) => `
            <a 
              href="${item.href}" 
              data-result-index="${idx}"
              class="search-result-row flex items-center justify-between p-3 rounded-xl bg-surface-raised/40 hover:bg-surface-raised border border-border/40 hover:border-accent/40 transition group cursor-pointer"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-lg shrink-0">${item.icon}</span>
                <div class="truncate">
                  <p class="text-body-sm font-semibold text-white group-hover:text-accent transition truncate">${item.title}</p>
                  <p class="text-[11px] text-muted truncate">${item.tag} • govtpariksha.com</p>
                </div>
              </div>
              <svg class="w-4 h-4 text-muted group-hover:text-accent shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          `).join('');

          activeResultIndex = 0;
          highlightActiveResult();
        }

        function highlightActiveResult() {
          const rows = document.querySelectorAll<HTMLElement>('.search-result-row');
          rows.forEach((row, i) => {
            if (i === activeResultIndex) {
              row.classList.add('bg-surface-raised', 'border-accent/60', 'ring-1', 'ring-accent/40');
              row.scrollIntoView({ block: 'nearest' });
            } else {
              row.classList.remove('bg-surface-raised', 'border-accent/60', 'ring-1', 'ring-accent/40');
            }
          });
        }

        // Search Input & Tab Listeners
        const globalSearchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
        if (globalSearchInput) {
          globalSearchInput.addEventListener('input', (e) => {
            renderSearchResults((e.target as HTMLInputElement).value);
          });
        }

        document.querySelectorAll<HTMLElement>('.search-tab').forEach((tab) => {
          tab.addEventListener('click', () => {
            document.querySelectorAll('.search-tab').forEach(t => {
              t.classList.remove('bg-surface-raised', 'text-accent', 'border', 'border-border', 'font-semibold');
              t.classList.add('text-muted');
            });
            tab.classList.remove('text-muted');
            tab.classList.add('bg-surface-raised', 'text-accent', 'border', 'border-border', 'font-semibold');
            currentSearchCategory = tab.getAttribute('data-category') || 'all';
            if (globalSearchInput) {
              renderSearchResults(globalSearchInput.value);
            }
          });
        });

        // --- Central Event Delegation on Document (Guarantees No Auto-Close or Duplicates) ---
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;

          // 1. Profile Trigger Clicked
          const trigger = target.closest('[data-profile-trigger]') as HTMLElement | null;
          if (trigger) {
            e.preventDefault();
            e.stopPropagation();

            const dropdownId = trigger.getAttribute('data-profile-trigger');
            if (!dropdownId) return;

            const dropdown = document.getElementById(dropdownId);
            if (!dropdown) return;

            const isAlreadyOpen = !dropdown.classList.contains('hidden') && dropdown.classList.contains('opacity-100');

            if (isAlreadyOpen) {
              closeDropdown(dropdown);
              trigger.setAttribute('aria-expanded', 'false');
            } else {
              closeAllDropdowns(dropdown);
              openDropdown(dropdown, trigger);
            }
            return;
          }

          // Language button clicked anywhere (profile dropdown, sidebar slider, etc.)
          const appLangBtn = target.closest('[data-app-lang]');
          if (appLangBtn) {
            e.preventDefault();
            e.stopPropagation();
            const chosen = appLangBtn.getAttribute('data-app-lang') || 'hinglish';
            setLanguage(chosen, true);
            return;
          }

          // 2. Clicked Inside Profile Dropdown
          const dropdownMenu = target.closest('[role="menu"]');
          if (dropdownMenu) {
            // Theme toggle clicked
            if (target.closest('.theme-toggle-btn')) {
              e.preventDefault();
              e.stopPropagation();
              toggleTheme();
              return;
            }

            // Logout action clicked
            if (target.closest('[data-auth-action="logout"]')) {
              e.preventDefault();
              e.stopPropagation();
              const clerk = (window as any).Clerk;
              if (clerk && typeof clerk.signOut === 'function') {
                clerk.signOut().then(() => {
                  window.location.assign('/login');
                });
              } else {
                window.location.assign('/login');
              }
              return;
            }

            // Other links inside dropdown
            if (target.closest('a')) {
              closeAllDropdowns();
            }
            return;
          }

          // 3. Desktop or Toolbar Sidebar Collapse / Reopen Clicked
          const sidebarToggleBtn = target.closest('[data-sidebar-toggle], [data-sidebar-collapse], #collapsed-sidebar-reopen-pill');
          if (sidebarToggleBtn) {
            e.preventDefault();
            e.stopPropagation();
            toggleDesktopSidebar();
            return;
          }

          // 4. Notifications Popup Toggle / Interactions
          const notifTrigger = target.closest('[data-notification-trigger]');
          if (notifTrigger) {
            e.preventDefault();
            e.stopPropagation();
            const targetId = notifTrigger.getAttribute('data-notification-trigger');
            const notifPopup = targetId ? document.getElementById(targetId) : null;
            if (notifPopup) {
              const isOpen = !notifPopup.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                updateBrowserNotificationUI();
                notifPopup.classList.remove('hidden');
                requestAnimationFrame(() => {
                  notifPopup.classList.remove('scale-95', 'opacity-0');
                  notifPopup.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const closeNotifBtn = target.closest('[data-close-notifications]');
          if (closeNotifBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeAllDropdowns();
            return;
          }

          const enableBrowserBtn = target.closest('[data-enable-browser-notifications]');
          if (enableBrowserBtn) {
            e.preventDefault();
            e.stopPropagation();
            void requestBrowserNotificationPermission();
            return;
          }

          const dismissNotifBtn = target.closest('[data-dismiss-notification]');
          if (dismissNotifBtn) {
            e.preventDefault();
            e.stopPropagation();
            const notificationId = dismissNotifBtn.getAttribute('data-dismiss-notification');
            if (notificationId) markNotificationRead(notificationId);
            return;
          }

          const markAllReadBtn = target.closest('[data-mark-all-read]');
          if (markAllReadBtn) {
            e.preventDefault();
            e.stopPropagation();
            void markAllNotificationsRead();
            return;
          }

          const notificationLink = target.closest('[data-notification-link]');
          if (notificationLink) {
            const notificationId = notificationLink.getAttribute('data-notification-link');
            if (notificationId) markNotificationRead(notificationId);
          }

          // If clicked inside notifications popup, don't close
          if (target.closest('[data-notification-popup]')) {
            return;
          }

          // 5. Language Switcher Trigger & Selection
          const langBtn = target.closest('#header-language-btn');
          if (langBtn) {
            e.preventDefault();
            e.stopPropagation();
            const dropdown = document.getElementById('header-language-dropdown');
            if (dropdown) {
              const isOpen = !dropdown.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                dropdown.classList.remove('hidden');
                requestAnimationFrame(() => {
                  dropdown.classList.remove('scale-95', 'opacity-0');
                  dropdown.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const langOption = target.closest('[data-lang-option]');
          if (langOption) {
            e.preventDefault();
            e.stopPropagation();
            const chosenLang = langOption.getAttribute('data-lang-option') || 'en';
            setLanguage(chosenLang);
            closeAllDropdowns();
            return;
          }

          // 6. Favorites Button Trigger
          const favBtn = target.closest('#header-favorites-btn');
          if (favBtn) {
            e.preventDefault();
            e.stopPropagation();
            const dropdown = document.getElementById('header-favorites-dropdown');
            if (dropdown) {
              const isOpen = !dropdown.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                dropdown.classList.remove('hidden');
                requestAnimationFrame(() => {
                  dropdown.classList.remove('scale-95', 'opacity-0');
                  dropdown.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          // If clicked inside language or favorites dropdown, don't close
          if (target.closest('#header-language-dropdown, #header-favorites-dropdown')) {
            return;
          }

          // 7. Open Global Search Modal Trigger
          const searchTrigger = target.closest('[data-open-search]');
          if (searchTrigger) {
            e.preventDefault();
            e.stopPropagation();
            openSearchModal();
            return;
          }

          // 8. Search Modal Close Button or Backdrop Clicked
          const searchModal = document.getElementById('global-search-modal');
          const searchCloseBtn = target.closest('#global-search-close-btn');
          if (searchCloseBtn || target === searchModal) {
            e.preventDefault();
            e.stopPropagation();
            closeSearchModal();
            return;
          }

          // Click on search result or quick access link
          if (target.closest('.search-result-row, .quick-access-chip')) {
            closeSearchModal();
          }

          // 9. Mobile Drawer Close Clicked
          const mobileCloseBtn = target.closest('[data-mobile-sidebar-close]');
          if (mobileCloseBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeMobileDrawer();
            return;
          }

          // 10. Mobile Drawer Backdrop Clicked (overlay or backdrop wrapper)
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (backdrop && (target === backdrop || target === overlay) && !container?.contains(target)) {
            closeMobileDrawer();
            return;
          }

          // 11. Clicked Outside Everything: Close Dropdowns
          closeAllDropdowns();
        });

      // Keyboard Shortcuts
      document.addEventListener('keydown', (e) => {
        const activeEl = document.activeElement;
        const isSearchModalOpen = !document.getElementById('global-search-modal')?.classList.contains('hidden');

        // Search modal specific keys (Arrow Navigation & Enter)
        if (isSearchModalOpen) {
          const rows = document.querySelectorAll<HTMLElement>('.search-result-row');
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (rows.length > 0) {
              activeResultIndex = (activeResultIndex + 1) % rows.length;
              highlightActiveResult();
            }
            return;
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (rows.length > 0) {
              activeResultIndex = (activeResultIndex - 1 + rows.length) % rows.length;
              highlightActiveResult();
            }
            return;
          }
          if (e.key === 'Enter') {
            if (activeResultIndex >= 0 && rows[activeResultIndex]) {
              e.preventDefault();
              rows[activeResultIndex].click();
            }
            return;
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            closeSearchModal();
            return;
          }
        }

        const isInput = activeEl && (
          activeEl.tagName === 'INPUT' || 
          activeEl.tagName === 'TEXTAREA' || 
          activeEl.getAttribute('contenteditable') === 'true'
        );

        // Alt+B / Ctrl+B / Cmd+B to toggle sidebar (Matches takeUforward)
        if ((e.altKey || e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
          e.preventDefault();
          toggleDesktopSidebar();
          return;
        }

        if (!isInput && e.key === '[') {
          e.preventDefault();
          toggleDesktopSidebar();
          return;
        }

        // Ctrl+K / Cmd+K to open search modal (Matches takeUforward)
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          openSearchModal();
          return;
        }

        if (e.key === 'Escape') {
          closeSearchModal();
          closeAllDropdowns();
          closeMobileDrawer();
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          wrapper?.classList.remove('hover-peek');
        }
      });

        // --- Clerk User State Integration ---
        async function syncClerkProfile() {
          const clerk = (window as any).Clerk;
          if (!clerk) return;

          if (!clerk.loaded && typeof clerk.load === 'function') {
            try {
              await clerk.load();
            } catch (_) {}
          }

          if (typeof clerk.addListener === 'function' && !(window as any).__clerkListenerAttached) {
            (window as any).__clerkListenerAttached = true;
            clerk.addListener(() => syncClerkProfile());
          }

          const user = clerk.user || clerk.session?.user;
          const token = await clerk.session?.getToken?.().catch(() => null);
          const apiUrl = (import.meta.env.PUBLIC_API_URL || 'https://govtpariksha.com/api/v1').replace(/\/$/, '');

          if (token) {
            fetch(`${apiUrl}/me`, {
              headers: { Authorization: `Bearer ${token}` },
            }).catch(() => null);
            void refreshNotifications(token);

            // Periodically refresh notifications & fire browser notifications
            if (!(window as any).__notifPollInterval) {
              (window as any).__notifPollInterval = setInterval(async () => {
                const refreshedToken = await clerk.session?.getToken?.().catch(() => null);
                if (refreshedToken) {
                  void refreshNotifications(refreshedToken);
                }
              }, 45000);
            }
          } else {
            void refreshNotifications(null);
          }

          const nameEls = document.querySelectorAll('.user-display-name');
          const emailEls = document.querySelectorAll('.user-display-email');
          const initialEls = document.querySelectorAll('.user-avatar-initials');
          const imgEls = document.querySelectorAll<HTMLImageElement>('.user-avatar-img');
          const logoutBtns = document.querySelectorAll<HTMLElement>('.auth-logout-btn');
          const loginLinks = document.querySelectorAll<HTMLElement>('.auth-login-link');
          const headerProfileIcons = document.querySelectorAll<HTMLElement>('.header-profile-icon');
          const headerProfileInitials = document.querySelectorAll<HTMLElement>('.header-profile-initials');

          if (user) {
            const fullName = user.fullName || [user.firstName, user.lastName].filter(Boolean).join(' ') || 'User';
            const email = user.primaryEmailAddress?.emailAddress || user.emailAddresses?.[0]?.emailAddress || 'Account';
            const initials = ((user.firstName?.[0] || fullName[0] || 'U') + (user.lastName?.[0] || '')).toUpperCase();

            nameEls.forEach(el => el.textContent = fullName);
            emailEls.forEach(el => el.textContent = email);
            initialEls.forEach(el => el.textContent = initials);

            if (user.imageUrl) {
              imgEls.forEach(img => {
                img.src = user.imageUrl;
                img.classList.remove('hidden');
              });
              initialEls.forEach(el => el.classList.add('hidden'));
              headerProfileIcons.forEach(el => el.classList.add('hidden'));
            } else {
              imgEls.forEach(img => img.classList.add('hidden'));
              initialEls.forEach(el => el.classList.remove('hidden'));
              headerProfileIcons.forEach(el => el.classList.add('hidden'));
            }

            logoutBtns.forEach(b => b.classList.remove('hidden'));
            loginLinks.forEach(l => l.classList.add('hidden'));

            // Show Logged In Profile UI in Sidebar & Header, HIDE Logged Out CTA (Get Started button)
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
          } else {
            nameEls.forEach(el => el.textContent = 'Guest User');
            emailEls.forEach(el => el.textContent = 'Sign in to access your profile');
            initialEls.forEach(el => el.textContent = 'GP');
            imgEls.forEach(img => img.classList.add('hidden'));
            
            // In header profile button, show clean profile SVG icon and hide initials
            headerProfileIcons.forEach(el => el.classList.remove('hidden'));
            headerProfileInitials.forEach(el => el.classList.add('hidden'));
            document.querySelectorAll<HTMLElement>('.user-avatar-initials:not(.header-profile-initials)').forEach(el => el.classList.remove('hidden'));

            logoutBtns.forEach(b => b.classList.add('hidden'));
            loginLinks.forEach(l => l.classList.remove('hidden'));

            // Show Logged Out UI in Sidebar & Header, HIDE Profile Card & Profile Icon
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-in').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-out').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-in').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-out').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
          }
        }

        syncClerkProfile();
        window.addEventListener('load', syncClerkProfile);
        document.addEventListener('astro:page-load', syncClerkProfile);

        let clerkPollCount = 0;
        const clerkInterval = setInterval(() => {
          clerkPollCount++;
          if ((window as any).Clerk?.loaded || clerkPollCount > 15) {
            clearInterval(clerkInterval);
            syncClerkProfile();
          }
        }, 200);
      })();
    </script>
  </body>
</html>
