            class="sidebar-profile-card w-full flex items-center justify-between min-h-[44px] px-2.5 py-1.5 rounded-xl bg-editorial-surface hover:bg-editorial-accent-soft border border-editorial-border transition-all duration-150 cursor-pointer group text-left"
