---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import SearchModal from '../components/SearchModal.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { whatsappChannel, telegramChannel, siteUrl, siteDomain, siteName } from '../data/site';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: object;
  hideHeaderFooter?: boolean;
  alternateLinks?: { hreflang: string; href: string }[];
  noindex?: boolean;
}

const siteOrigin = siteUrl;
const domainDotIndex = siteDomain.lastIndexOf('.');
const domainPrefix = domainDotIndex !== -1 ? siteDomain.slice(0, domainDotIndex) : siteDomain;
const domainSuffix = domainDotIndex !== -1 ? siteDomain.slice(domainDotIndex) : '';
const twitterHandle = `@${siteName.toLowerCase().replace(/\s+/g, '')}`;
const defaultAvatarInitials = siteName.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase() || 'GP';
const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '' : currentPath.replace(/\/$/, '');

const {
  title = `${siteDomain} - Govt Jobs, Admissions & Results`,
  description = `Get verified government examination notices, admit cards, answer keys and counselling results on ${siteDomain}.`,
  canonicalUrl = `${siteOrigin}${cleanPath || '/'}`,
  ogImage = `${siteOrigin}/og-image.jpg`,
  ogType = Astro.props.publishedTime ? 'article' : 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  hideHeaderFooter = false,
  alternateLinks = [],
  noindex = false,
} = Astro.props;

// Ensure ogImage is always an absolute URL for social crawlers (WhatsApp, Facebook, Twitter, Telegram)
const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// Derive OG image MIME type from URL extension (blog images may be jpg/webp, not always png)
const ogImageExt = resolvedOgImage.split('?')[0].split('.').pop()?.toLowerCase() || 'png';
const ogImageType = ogImageExt === 'jpg' || ogImageExt === 'jpeg' ? 'image/jpeg'
  : ogImageExt === 'webp' ? 'image/webp'
  : ogImageExt === 'gif' ? 'image/gif'
  : 'image/png';

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const yandexVerification = import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en" class="theme-light">
  <head>
    <!-- Google tag (gtag.js) & GTM (Deferred for zero render-blocking & maximum mobile speed) -->
    <script is:inline define:vars={{ gaMeasurementId, gtmId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (gaMeasurementId) {
        gtag('config', gaMeasurementId, { send_page_view: false });
      }

      // Track page views on Astro ClientRouter view transitions
      document.addEventListener('astro:page-load', function() {
        if (typeof gtag === 'function' && gaMeasurementId) {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
        if (window.dataLayer) {
          window.dataLayer.push({
            event: 'page_view',
            page_path: window.location.pathname,
            page_title: document.title,
            page_location: window.location.href
          });
        }
      });

      // Lazy load analytics on first user interaction or idle to unblock mobile main-thread
      function loadThirdPartyAnalytics() {
        if (window.__thirdPartyAnalyticsLoaded) return;
        window.__thirdPartyAnalyticsLoaded = true;

        if (gaMeasurementId) {
          var gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.setAttribute('fetchpriority', 'low');
          gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
          document.head.appendChild(gaScript);
        }

        if (gtmId) {
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.setAttribute('fetchpriority', 'low');j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        }
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { setTimeout(loadThirdPartyAnalytics, 2000); });
      } else {
        setTimeout(loadThirdPartyAnalytics, 2500);
      }
      ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach(function(evt) {
        window.addEventListener(evt, loadThirdPartyAnalytics, { once: true, passive: true });
      });
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Google Fonts: Preconnect & Asynchronous Non-blocking Stylesheet */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap" />
    </noscript>

    {/* Preconnect and DNS prefetch for the media CDN */}
    <link rel="preconnect" href="https://pub-68568854a58845bc975b176de76b1ad5.r2.dev" crossorigin />
    <link rel="dns-prefetch" href="https://pub-68568854a58845bc975b176de76b1ad5.r2.dev" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a58ca" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={siteName} />
    <meta name="publisher" content={siteName} />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    {/* Feeds & AI Agent Discovery */}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href={`${siteOrigin}/rss.xml`} />
    <link rel="alternate" type="text/plain" href={`${siteOrigin}/llms.txt`} title="LLM Context Summary" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteOrigin}/sitemap.xml`} />

    {/* Search Engine Verifications if configured */}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}

    {/* Multilingual Alternate Language Links */}
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    {/* Open Graph / Facebook / WhatsApp */}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:locale:alternate" content="hi_IN" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    {/* ClientRouter for page transitions */}
    <ClientRouter />

    {/* Structured Data (JSON-LD) */}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {/* Apply the saved theme before paint, and again after view transitions replace the html class */}
    <script is:inline>
      (function() {
        function applyStoredTheme() {
          var pref = localStorage.getItem('theme_preference') || localStorage.getItem('theme');
          var dark = pref === 'dark';
          document.documentElement.classList.toggle('theme-dark', dark);
          document.documentElement.classList.toggle('theme-light', !dark);
        }
        applyStoredTheme();
        if (!window.__examThemeBound) {
          window.__examThemeBound = true;
          document.addEventListener('astro:after-swap', applyStoredTheme);
        }
      })();
    </script>
  </head>
  <body class="bg-canvas min-h-screen flex flex-col font-sans text-white antialiased selection:bg-accent selection:text-white transition-colors duration-200">
    <div id="route-loading-bar" class="fixed top-0 left-0 right-0 h-[2px] bg-accent z-[99999] opacity-0 pointer-events-none origin-left scale-x-0" transition:persist></div>
    {/* Google Tag Manager (noscript) */}
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    {/* End Google Tag Manager (noscript) */}
    {/* Body Row: Sidebar on Left + Main Area (Header + Content + Footer) on Right */}
    <div class="flex-1 flex min-h-screen relative">
      {/* Desktop Left Navigation Sidebar (Full height on left) */}
      {!hideHeaderFooter && (
        <div 
          id="desktop-sidebar-wrapper" 
          class="hidden lg:block shrink-0 relative z-[1050] transition-all duration-300"
          transition:persist="desktop-sidebar"
        >
          <LeftSidebar prefix="desktop" />
        </div>
      )}

      {/* Main Area: Header (Header width decreases when sidebar is open!) + Content + Footer */}
      <div id="main-content-wrapper" class="flex-1 min-w-0 flex flex-col min-h-screen">
        {!hideHeaderFooter && <Header transition:persist="main-header" />}
        <main class="flex-grow">
          <slot />
        </main>
        {!hideHeaderFooter && <Footer />}
      </div>
    </div>

    {/* ══ Modern Mobile Sidebar Drawer ══════════════════════════════ */}
    {/* Backdrop — clicking it closes the drawer */}
    <div 
      id="mobile-sidebar-backdrop" 
      class="fixed inset-0 z-[9998] hidden"
      aria-hidden="true"
      transition:persist="mobile-sidebar-backdrop"
    >
      {/* Dark translucent overlay */}
      <div 
        id="mobile-backdrop-overlay"
        class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"
      ></div>
    </div>

    {/* Drawer Panel */}
    <div 
      id="mobile-sidebar-container" 
      class="fixed inset-y-0 left-0 z-[9999] w-72 max-w-[85vw] bg-canvas border-r border-border shadow-2xl flex flex-col transform -translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform"
      aria-label="Navigation menu"
      role="dialog"
      aria-modal="true"
      transition:persist="mobile-sidebar-container"
    >
      {/* ── Drawer Header ── */}
      <div class="flex items-center justify-between h-14 px-4 border-b border-border/60 shrink-0 bg-canvas">
        <a href="/" class="flex items-center gap-2 group" aria-label={`${siteDomain} home`}>
          <BrandLogo size={32} class="group-hover:scale-105 transition-transform shrink-0" />
          <span class="font-bold text-sm tracking-tight text-white">
            {domainPrefix}<span class="text-accent">{domainSuffix}</span>
          </span>
        </a>
        <button 
          data-mobile-sidebar-close
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-lg text-muted hover:text-white hover:bg-surface-raised border border-border/40 hover:border-border transition-all cursor-pointer"
          aria-label="Close menu"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {/* ── Scrollable Nav Body ── */}
      <nav class="flex-1 overflow-y-auto overscroll-contain pt-0 px-3 pb-3 space-y-5 scrollbar-none">
        
        {/* Channels Section */}
        <div>
          <p class="px-3 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-muted/70">Channels</p>
          <div class="space-y-0.5">
            <a href={whatsappChannel} target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all group"
            >
              <svg class="w-4 h-4 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span class="text-sm font-medium">WhatsApp channel</span>
            </a>
            <a href={telegramChannel} target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all group"
            >
              <svg class="w-4 h-4 shrink-0 text-[#2AABEE]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              <span class="text-sm font-medium">Telegram channel</span>
            </a>
          </div>
        </div>

        {/* Browse Section */}
        <div>
          <p class="px-3 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-accent/80">Browse</p>
          <div class="space-y-0.5">
            <a href="/" data-mobile-sidebar-close
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-surface-raised text-white font-semibold text-sm shadow-xs border border-border/40"
            >
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10h5v-6h4v6h5V10" />
              </svg>
              <span>Home</span>
            </a>
            <a href="/#important-links" data-mobile-sidebar-close
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all text-sm font-medium"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5" />
              </svg>
              <span>Important links</span>
            </a>
          </div>
        </div>

        {/* Mobile Sidebar Preferences (Language & Theme Toggles for Mobile & Tablet) */}
        <div class="pt-3 pb-1 border-t border-border/50 space-y-2.5">
          <p class="px-1 text-[10px] font-bold uppercase tracking-widest text-muted/70">Preferences</p>

          {/* Language Toggle Row */}
          <div class="flex items-center justify-between gap-3 px-3 py-2 rounded-xl bg-surface-raised/50 border border-border/60">
            <span class="text-xs font-semibold text-white/90 flex items-center gap-2">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
              </svg>
              <span>Language</span>
            </span>
            <div class="inline-flex items-center p-0.5 bg-canvas border border-border rounded-lg text-xs font-semibold select-none" role="group" aria-label="Language selection">
              <button
                type="button"
                data-app-lang="hinglish"
                class="app-lang-btn px-2.5 py-1 rounded-md text-[11px] font-semibold transition-colors duration-150 cursor-pointer text-muted hover:text-white"
                title="Switch to Hinglish"
              >
                HI
              </button>
              <button
                type="button"
                data-app-lang="en"
                class="app-lang-btn px-2.5 py-1 rounded-md text-[11px] font-semibold transition-colors duration-150 cursor-pointer text-muted hover:text-white"
                title="Switch to English"
              >
                EN
              </button>
            </div>
          </div>

          {/* Theme Toggle Row */}
          <div class="flex items-center justify-between gap-3 px-3 py-2 rounded-xl bg-surface-raised/50 border border-border/60">
            <span class="text-xs font-semibold text-white/90 flex items-center gap-2">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <span>Theme</span>
            </span>
            <button
              type="button"
              class="theme-toggle-btn relative w-13 h-7 bg-canvas border border-border rounded-pill p-0.5 flex items-center cursor-pointer transition-colors focus:outline-none shrink-0"
              title="Toggle Dark and Light Mode"
              aria-label="Toggle Dark and Light Mode"
            >
              <span
                class="theme-toggle-knob w-5 h-5 rounded-full bg-surface-raised border border-border text-white flex items-center justify-center text-xs shadow-sm transition-transform duration-200 translate-x-0.5"
              >
                <span class="light-icon text-[11px] select-none leading-none">☀️</span>
                <span class="dark-icon text-[11px] select-none leading-none hidden">🌙</span>
              </span>
            </button>
          </div>
        </div>
      </nav>

      {/* ── Bottom Auth Section ── */}
      <div class="p-3 border-t border-border/60 shrink-0">
        {/* Logged Out */}
        <div class="sidebar-auth-logged-out block">
          <a href="/login" data-mobile-sidebar-close
            class="flex items-center justify-center gap-2.5 w-full py-3 px-4 rounded-xl bg-accent hover:bg-accent/90 text-white font-semibold text-sm transition shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            Log in / Sign up
          </a>
        </div>

        {/* Logged In */}
        <div class="sidebar-auth-logged-in hidden space-y-2">
          <button
            type="button"
            class="sidebar-profile-card w-full flex items-center gap-3 p-2.5 rounded-xl bg-surface-raised/40 hover:bg-surface-raised border border-border/50 hover:border-border transition cursor-pointer"
          >
            <div class="w-9 h-9 rounded-full bg-surface-raised border border-border text-white flex items-center justify-center font-bold text-xs shrink-0 overflow-hidden shadow-xs select-none">
              <span class="user-avatar-initials inline-flex items-center justify-center text-center text-xs font-bold leading-none uppercase">{defaultAvatarInitials}</span>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <p class="user-display-name text-sm font-bold text-white truncate leading-tight">User</p>
              <p class="user-display-email text-xs text-muted leading-none mt-0.5 truncate">Free</p>
            </div>
          </button>

          {/* Mobile Drawer Quick Actions: Bookmarks & Notifications */}
          <div class="grid grid-cols-2 gap-1.5 pt-0.5">
            <a
              href="/bookmarks"
              data-mobile-sidebar-close
              class="flex items-center justify-center gap-2 px-2.5 py-2 rounded-xl bg-surface-raised/60 hover:bg-surface-raised border border-border/60 text-xs font-semibold text-white transition cursor-pointer"
            >
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
              </svg>
              <span>Bookmarks</span>
              <span class="favorites-count-badge hidden px-1.5 py-0.2 rounded-full bg-accent/20 text-accent text-[9px] font-bold">0</span>
            </a>

            <a
              href="/notifications"
              data-mobile-sidebar-close
              class="flex items-center justify-center gap-2 px-2.5 py-2 rounded-xl bg-surface-raised/60 hover:bg-surface-raised border border-border/60 text-xs font-semibold text-white transition cursor-pointer"
            >
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              <span>Notifications</span>
              <span class="notification-badge-count hidden px-1.5 py-0.2 rounded-full bg-accent/20 text-accent text-[9px] font-bold">0</span>
            </a>
          </div>
        </div>
      </div>
    </div>


    {/* Global Search Modal */}
    <SearchModal />

    {/* Global Non-intrusive Toast Notification (For Sign-in prompts, status feedback) */}
    <div 
      id="global-toast" 
      class="fixed bottom-5 right-5 z-[10000] max-w-sm w-[calc(100vw-2.5rem)] sm:w-auto bg-surface-raised border border-border/80 shadow-2xl rounded-2xl p-3.5 flex items-center justify-between gap-3 text-white text-xs transition-all duration-300 transform translate-y-12 opacity-0 pointer-events-none backdrop-blur-md"
      role="status"
      aria-live="polite"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <span id="global-toast-icon" class="w-6 h-6 rounded-lg bg-accent/15 border border-accent/30 text-accent flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </span>
        <p id="global-toast-msg" class="truncate font-medium text-white/95">Message</p>
      </div>
      <a id="global-toast-action" href="/login" class="hidden px-2.5 py-1 rounded-lg bg-accent text-white font-semibold text-[11px] shrink-0 hover:bg-accent/90 transition shadow-2xs">
        Sign in
      </a>
    </div>

    {/* Global Robust Interactive Script */}
    <script>
      import { markAllNotificationsRead, markNotificationRead, refreshNotifications, requestBrowserNotificationPermission, updateBrowserNotificationUI } from '../lib/notifications';
      import { canSwapArticleLanguage, getDisplayedArticleLang, swapArticleLanguage } from '../lib/article-lang-swap';
      import { appLangToBlogLanguage, articleHref, normalizeAppLang } from '../lib/preferred-lang';
      import { API_URL } from '../lib/api';
      import { searchItems, siteDomain } from '../data/site';
      import { updateFavoritesUI, toggleBookmark, removeBookmark, clearAllBookmarks } from '../lib/bookmarks';
      import { navigate } from 'astro:transitions/client';

      (function initApp() {

        // --- Theme Management ---
        function updateAllThemeToggles(isLight: boolean) {
          const knobs = document.querySelectorAll('.theme-toggle-knob');
          const darkIcons = document.querySelectorAll('.dark-icon');
          const lightIcons = document.querySelectorAll('.light-icon');

          knobs.forEach((knob) => {
            if (isLight) {
              knob.classList.remove('translate-x-6');
              knob.classList.add('translate-x-0.5');
            } else {
              knob.classList.remove('translate-x-0.5');
              knob.classList.add('translate-x-6');
            }
          });

          darkIcons.forEach((icon) => {
            if (isLight) icon.classList.add('hidden');
            else icon.classList.remove('hidden');
          });

          lightIcons.forEach((icon) => {
            if (isLight) icon.classList.remove('hidden');
            else icon.classList.add('hidden');
          });

          document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
            btn.setAttribute('title', isLight ? 'Switch to dark mode' : 'Switch to light mode');
            btn.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
          });
        }

        function toggleTheme() {
          const isCurrentlyDark = document.documentElement.classList.contains('theme-dark');
          const nextLight = isCurrentlyDark; // If currently dark, toggle to light; otherwise toggle to dark

          if (nextLight) {
            document.documentElement.classList.remove('theme-dark');
            document.documentElement.classList.add('theme-light');
            localStorage.setItem('theme', 'light');
            localStorage.setItem('theme_preference', 'light');
          } else {
            document.documentElement.classList.add('theme-dark');
            document.documentElement.classList.remove('theme-light');
            localStorage.setItem('theme', 'dark');
            localStorage.setItem('theme_preference', 'dark');
          }

          updateAllThemeToggles(nextLight);
        }

        // --- Robust Dropdown Management (Safe from Timeout Clashes) ---
        function closeDropdown(menu: HTMLElement) {
          menu.classList.remove('scale-100', 'opacity-100');
          menu.classList.add('scale-95', 'opacity-0');

          const prevTimer = menu.getAttribute('data-close-timer');
          if (prevTimer) clearTimeout(Number(prevTimer));

          const timer = window.setTimeout(() => {
            menu.classList.add('hidden');
            menu.removeAttribute('data-close-timer');
          }, 150);
          menu.setAttribute('data-close-timer', String(timer));
        }

        function openDropdown(menu: HTMLElement, trigger: HTMLElement) {
          const prevTimer = menu.getAttribute('data-close-timer');
          if (prevTimer) {
            clearTimeout(Number(prevTimer));
            menu.removeAttribute('data-close-timer');
          }

          menu.classList.remove('hidden');
          requestAnimationFrame(() => {
            menu.classList.remove('scale-95', 'opacity-0');
            menu.classList.add('scale-100', 'opacity-100');
          });
          trigger.setAttribute('aria-expanded', 'true');
        }

        function closeAllDropdowns(exceptMenu?: HTMLElement | null) {
          document.querySelectorAll<HTMLElement>('[role="menu"]').forEach((menu) => {
            if (menu !== exceptMenu) {
              closeDropdown(menu);
            }
          });
          document.querySelectorAll('[data-profile-trigger]').forEach((trigger) => {
            if (!exceptMenu || trigger.getAttribute('data-profile-trigger') !== exceptMenu.id) {
              trigger.setAttribute('aria-expanded', 'false');
            }
          });
          // Close all notification popups
          document.querySelectorAll<HTMLElement>('[data-notification-popup]').forEach((notifPopup) => {
            if (notifPopup !== exceptMenu) {
              notifPopup.classList.add('hidden', 'scale-95', 'opacity-0');
              notifPopup.classList.remove('scale-100', 'opacity-100');
            }
          });
          // Close language dropdown
          const langDropdown = document.getElementById('header-language-dropdown');
          if (langDropdown && langDropdown !== exceptMenu) {
            langDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            langDropdown.classList.remove('scale-100', 'opacity-100');
          }
          // Close favorites dropdown
          const favDropdown = document.getElementById('header-favorites-dropdown');
          if (favDropdown && favDropdown !== exceptMenu) {
            favDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            favDropdown.classList.remove('scale-100', 'opacity-100');
          }
        }

        // --- Mobile Drawer Management ---
        function updateHamburgerIcon(isOpen: boolean) {
          const btn = document.getElementById('mobile-drawer-toggle-btn');
          if (!btn) return;
          const svg = btn.querySelector('svg');
          if (!svg) return;
          if (isOpen) {
            svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
          } else {
            svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          }
        }

        function openMobileDrawer() {
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (!backdrop || !container) return;

          // Show backdrop wrapper first (makes overlay and container visible)
          backdrop.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          updateHamburgerIcon(true);

          // Animate in on next frame
          requestAnimationFrame(() => {
            if (overlay) overlay.classList.add('opacity-100');
            container.classList.remove('-translate-x-full');
            container.classList.add('translate-x-0');
          });
        }

        function closeMobileDrawer() {
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (!backdrop || !container) return;

          // Animate out
          if (overlay) overlay.classList.remove('opacity-100');
          container.classList.remove('translate-x-0');
          container.classList.add('-translate-x-full');
          updateHamburgerIcon(false);

          // Hide after animation completes
          setTimeout(() => {
            backdrop.classList.add('hidden');
            document.body.style.overflow = '';
          }, 320);
        }

        // --- Desktop Sidebar Collapse Management (Matches Image 1) ---
        let hoverPeekTimer: number | null = null;

        function setSidebarCollapsed(isCollapsed: boolean) {
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          const headerBrand = document.getElementById('header-brand-collapsed');
          const tooltipText = document.getElementById('sidebar-toggle-tooltip-text');
          if (wrapper) {
            wrapper.classList.remove('hover-peek');
            if (isCollapsed) {
              wrapper.classList.add('collapsed');
              if (headerBrand) {
                headerBrand.classList.remove('hidden');
                headerBrand.classList.add('flex');
              }
              if (tooltipText) tooltipText.textContent = 'Expand sidebar';
            } else {
              wrapper.classList.remove('collapsed');
              if (headerBrand) {
                headerBrand.classList.add('hidden');
                headerBrand.classList.remove('flex');
              }
              if (tooltipText) tooltipText.textContent = 'Collapse sidebar';
            }
            localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
          }
        }

        function toggleDesktopSidebar() {
          if (window.innerWidth < 1024) {
            openMobileDrawer();
          } else {
            const wrapper = document.getElementById('desktop-sidebar-wrapper');
            wrapper?.classList.remove('hover-peek');
            const isCurrentlyCollapsed = wrapper?.classList.contains('collapsed') ?? false;
            setSidebarCollapsed(!isCurrentlyCollapsed);
          }
        }

        // --- Hover-Peek: On hover of collapse icon/pill in header, open temporarily until clicked ---
        function startHoverPeek() {
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          if (!wrapper || !wrapper.classList.contains('collapsed')) return;
          if (hoverPeekTimer) {
            clearTimeout(hoverPeekTimer);
            hoverPeekTimer = null;
          }
          wrapper.classList.add('hover-peek');
        }

        function endHoverPeek() {
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          if (!wrapper) return;
          if (hoverPeekTimer) clearTimeout(hoverPeekTimer);
          hoverPeekTimer = window.setTimeout(() => {
            wrapper.classList.remove('hover-peek');
            hoverPeekTimer = null;
          }, 220);
        }

        function cancelHoverPeekTimer() {
          if (hoverPeekTimer) {
            clearTimeout(hoverPeekTimer);
            hoverPeekTimer = null;
          }
        }

        // --- Language Switcher Integration ---
        function syncListingCardLinks(lang: string) {
          const normalized = normalizeAppLang(lang);
          document.querySelectorAll<HTMLAnchorElement>('[data-article-link]').forEach((a) => {
            const slug = a.getAttribute('data-article-link');
            if (!slug) return;
            a.setAttribute('href', articleHref(slug, normalized));
          });
        }

        function softNavigate(url: string) {
          void import('astro:transitions/client')
            .then(({ navigate }) => navigate(url))
            .catch(() => { window.location.href = url; });
        }

        /** Update home/category cards in place — no navigation, no scroll jump. */
        async function refreshListingCardsInPlace(lang: string) {
          const normalized = normalizeAppLang(lang);
          const blogLang = appLangToBlogLanguage(normalized);
          const path = window.location.pathname;
          const categoryMatch = path.match(/^\/category\/([^/]+)\/?$/);
          const params = new URLSearchParams({ limit: '50', language: blogLang, includeImages: 'false' });
          if (categoryMatch?.[1]) params.set('category', categoryMatch[1]);

          try {
            const res = await fetch(`${API_URL}/blogs?${params.toString()}`, { priority: 'high' } as any);
            if (!res.ok) return;
            const posts = await res.json();
            if (!Array.isArray(posts)) return;

            const bySlug = new Map<string, any>();
            posts.forEach((p: any) => {
              if (p?.slug) bySlug.set(String(p.slug).toLowerCase(), p);
            });

            document.querySelectorAll<HTMLAnchorElement>('[data-article-link]').forEach((a) => {
              const slug = (a.getAttribute('data-article-link') || '').toLowerCase();
              const post = bySlug.get(slug);
              if (!post) return;

              a.setAttribute('href', articleHref(slug, normalized));

              const titleEl = a.querySelector<HTMLElement>('[data-article-title]');
              if (titleEl && post.title) titleEl.textContent = post.title;

              const summaryEl = a.querySelector<HTMLElement>('[data-article-summary]');
              if (summaryEl) {
                summaryEl.textContent =
                  post.description || post.metaDescription || summaryEl.textContent || '';
              }

              const img = a.querySelector<HTMLImageElement>('img');
              if (img && post.title) img.alt = post.title;
            });
          } catch {
            // Keep existing card text; hrefs already updated via syncListingCardLinks
          }
        }

        function setLanguage(lang: string, shouldNavigate: boolean = false) {
          const normalized = normalizeAppLang(lang);
          let previous: string = 'hinglish';
          try {
            previous = normalizeAppLang(
              localStorage.getItem('preferred_exam_lang')
                || localStorage.getItem('site_language')
                || 'hinglish',
            );
            localStorage.setItem('preferred_exam_lang', normalized);
            localStorage.setItem('site_language', normalized);
            document.cookie = `preferred_lang=${normalized};path=/;max-age=31536000;SameSite=Lax`;
          } catch (e) {}

          const label = document.getElementById('current-language-label');
          if (label) label.textContent = normalized === 'en' ? 'EN' : 'HI';

          // Update profile language toggle buttons
          const appLangBtns = document.querySelectorAll<HTMLElement>('[data-app-lang], [data-global-lang]');
          appLangBtns.forEach((btn) => {
            const btnLang = btn.getAttribute('data-app-lang') || btn.getAttribute('data-global-lang');
            const isBtnActive = (btnLang === normalized);
            if (isBtnActive) {
              btn.classList.add('bg-accent', 'text-white', 'font-bold', 'shadow-2xs');
              btn.classList.remove('text-muted', 'bg-accent/20', 'text-accent');
            } else {
              btn.classList.remove('bg-accent', 'text-white', 'font-bold', 'shadow-2xs', 'bg-accent/20', 'text-accent');
              btn.classList.add('text-muted');
            }
          });

          // Keep listing card links aligned with preference
          syncListingCardLinks(normalized);

          if (!shouldNavigate) return;

          const isArticle = document.querySelector('.blog-reading-view') !== null
            || document.getElementById('article-lang-data') !== null;

          if (isArticle) {
            const displayed = getDisplayedArticleLang();
            if (displayed === normalized) return;

            if (canSwapArticleLanguage(normalized)) {
              swapArticleLanguage(normalized);
            } else {
              const path = window.location.pathname;
              const search = new URLSearchParams(window.location.search);
              if (normalized === 'en') search.set('lang', 'en');
              else search.delete('lang');
              const qs = search.toString();
              softNavigate(qs ? `${path}?${qs}` : path);
            }
            return;
          }

          // Home / category: update cards in place (preserves scroll position)
          const path = window.location.pathname;
          if ((path === '/' || path.startsWith('/category/')) && previous !== normalized) {
            void refreshListingCardsInPlace(normalized);
          }
        }

        // --- Global Spotlight Search Modal Items ---
        const SEARCH_ITEMS = searchItems;

        let currentSearchCategory = 'all';
        let activeResultIndex = -1;

        function openSearchModal() {
          const modal = document.getElementById('global-search-modal');
          const container = document.getElementById('global-search-container');
          const input = document.getElementById('global-search-input') as HTMLInputElement | null;
          if (!modal || !container) return;

          closeAllDropdowns();
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          requestAnimationFrame(() => {
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
            container.classList.remove('scale-95');
            container.classList.add('scale-100');
          });
          if (input) {
            setTimeout(() => {
              input.focus();
              input.select();
            }, 60);
          }
        }

        function closeSearchModal() {
          const modal = document.getElementById('global-search-modal');
          const container = document.getElementById('global-search-container');
          if (!modal || !container) return;

          modal.classList.remove('opacity-100');
          modal.classList.add('opacity-0');
          container.classList.remove('scale-100');
          container.classList.add('scale-95');
          setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
          }, 180);
        }

        function renderSearchResults(query: string) {
          const emptyState = document.getElementById('search-empty-state');
          const resultsList = document.getElementById('search-results-list');
          if (!emptyState || !resultsList) return;

          const trimmed = query.trim().toLowerCase();
          if (trimmed.length < 2) {
            emptyState.classList.remove('hidden');
            resultsList.classList.add('hidden');
            resultsList.innerHTML = '';
            activeResultIndex = -1;
            return;
          }

          const filtered = SEARCH_ITEMS.filter((item) => {
            const matchesCategory = currentSearchCategory === 'all' || item.category === currentSearchCategory || item.category === 'all';
            const matchesQuery = item.title.toLowerCase().includes(trimmed) || item.tag.toLowerCase().includes(trimmed);
            return matchesCategory && matchesQuery;
          });

          emptyState.classList.add('hidden');
          resultsList.classList.remove('hidden');

          if (filtered.length === 0) {
            resultsList.innerHTML = `
              <div class="py-8 text-center text-muted text-body-sm">
                <p>No results found for "${query}"</p>
                <p class="text-caption-xs mt-1 text-muted/70">Try searching for UPSC, SSC, RRB, or an official portal</p>
              </div>
            `;
            activeResultIndex = -1;
            return;
          }

          resultsList.innerHTML = filtered.map((item, idx) => `
            <a 
              href="${item.href}" 
              data-result-index="${idx}"
              class="search-result-row flex items-center justify-between p-3 rounded-xl bg-surface-raised/40 hover:bg-surface-raised border border-border/40 hover:border-accent/40 transition group cursor-pointer"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-lg shrink-0">${item.icon}</span>
                <div class="truncate">
                  <p class="text-body-sm font-semibold text-white group-hover:text-accent transition truncate">${item.title}</p>
                  <p class="text-[11px] text-muted truncate">${item.tag} • ${siteDomain}</p>
                </div>
              </div>
              <svg class="w-4 h-4 text-muted group-hover:text-accent shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          `).join('');

          activeResultIndex = 0;
          highlightActiveResult();
        }

        function highlightActiveResult() {
          const rows = document.querySelectorAll<HTMLElement>('.search-result-row');
          rows.forEach((row, i) => {
            if (i === activeResultIndex) {
              row.classList.add('bg-surface-raised', 'border-accent/60', 'ring-1', 'ring-accent/40');
              row.scrollIntoView({ block: 'nearest' });
            } else {
              row.classList.remove('bg-surface-raised', 'border-accent/60', 'ring-1', 'ring-accent/40');
            }
          });
        }

        // --- Central Event Delegation on Document (Guarantees No Auto-Close or Duplicates) ---
        function handleGlobalClick(e: MouseEvent) {
          const target = e.target as HTMLElement;

          // 1. Profile Trigger Clicked
          const trigger = target.closest('[data-profile-trigger]') as HTMLElement | null;
          if (trigger) {
            e.preventDefault();
            e.stopPropagation();

            const dropdownId = trigger.getAttribute('data-profile-trigger');
            if (!dropdownId) return;

            const dropdown = document.getElementById(dropdownId);
            if (!dropdown) return;

            const isAlreadyOpen = !dropdown.classList.contains('hidden') && dropdown.classList.contains('opacity-100');

            if (isAlreadyOpen) {
              closeDropdown(dropdown);
              trigger.setAttribute('aria-expanded', 'false');
            } else {
              closeAllDropdowns(dropdown);
              openDropdown(dropdown, trigger);
            }
            return;
          }

          // Language button clicked anywhere (header, mobile drawer, profile dropdown)
          const appLangBtn = target.closest('[data-app-lang]');
          if (appLangBtn) {
            e.preventDefault();
            e.stopPropagation();
            const chosen = appLangBtn.getAttribute('data-app-lang') || 'hinglish';
            setLanguage(chosen, true);
            return;
          }

          // Theme toggle button clicked anywhere (header, mobile drawer, profile dropdown)
          const themeBtn = target.closest('.theme-toggle-btn');
          if (themeBtn) {
            e.preventDefault();
            e.stopPropagation();
            toggleTheme();
            return;
          }

          // 2. Clicked Inside Profile Dropdown
          const dropdownMenu = target.closest('[role="menu"]');
          if (dropdownMenu) {

            // Logout action clicked
            if (target.closest('[data-auth-action="logout"]')) {
              e.preventDefault();
              e.stopPropagation();
              const apiUrl = API_URL;
              void fetch(`${apiUrl}/auth/logout`, {
                method: 'POST',
                priority: 'high',
                credentials: 'include',
                headers: { 'X-CSRF-Protection': '1' },
              } as any).finally(() => window.location.assign('/login'));
              return;
            }

            // Other links inside dropdown
            if (target.closest('a')) {
              closeAllDropdowns();
            }
            return;
          }

          // 3. Desktop or Toolbar Sidebar Collapse / Reopen Clicked
          const sidebarToggleBtn = target.closest('[data-sidebar-toggle], [data-sidebar-collapse], #collapsed-sidebar-reopen-pill');
          if (sidebarToggleBtn) {
            e.preventDefault();
            e.stopPropagation();
            toggleDesktopSidebar();
            return;
          }

          // 4. Notifications Popup Toggle / Interactions
          const notifTrigger = target.closest('[data-notification-trigger]');
          if (notifTrigger) {
            e.preventDefault();
            e.stopPropagation();
            if (window.innerWidth < 1024) {
              closeAllDropdowns();
              navigate('/notifications');
              return;
            }
            const targetId = notifTrigger.getAttribute('data-notification-trigger');
            const notifPopup = targetId ? document.getElementById(targetId) : null;
            if (notifPopup) {
              const isOpen = !notifPopup.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                updateBrowserNotificationUI();
                notifPopup.classList.remove('hidden');
                requestAnimationFrame(() => {
                  notifPopup.classList.remove('scale-95', 'opacity-0');
                  notifPopup.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const closeNotifBtn = target.closest('[data-close-notifications]');
          if (closeNotifBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeAllDropdowns();
            return;
          }

          const enableBrowserBtn = target.closest('[data-enable-browser-notifications]');
          if (enableBrowserBtn) {
            e.preventDefault();
            e.stopPropagation();
            void requestBrowserNotificationPermission();
            return;
          }

          const dismissNotifBtn = target.closest('[data-dismiss-notification]');
          if (dismissNotifBtn) {
            e.preventDefault();
            e.stopPropagation();
            const notificationId = dismissNotifBtn.getAttribute('data-dismiss-notification');
            if (notificationId) markNotificationRead(notificationId);
            return;
          }

          const markAllReadBtn = target.closest('[data-mark-all-read]');
          if (markAllReadBtn) {
            e.preventDefault();
            e.stopPropagation();
            void markAllNotificationsRead();
            return;
          }

          const notificationLink = target.closest('[data-notification-link]');
          if (notificationLink) {
            const notificationId = notificationLink.getAttribute('data-notification-link');
            if (notificationId) markNotificationRead(notificationId);
          }

          // If clicked inside notifications popup, don't close
          if (target.closest('[data-notification-popup]')) {
            return;
          }

          // 5. Language Switcher Trigger & Selection
          const langBtn = target.closest('#header-language-btn');
          if (langBtn) {
            e.preventDefault();
            e.stopPropagation();
            const dropdown = document.getElementById('header-language-dropdown');
            if (dropdown) {
              const isOpen = !dropdown.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                dropdown.classList.remove('hidden');
                requestAnimationFrame(() => {
                  dropdown.classList.remove('scale-95', 'opacity-0');
                  dropdown.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const langOption = target.closest('[data-lang-option]');
          if (langOption) {
            e.preventDefault();
            e.stopPropagation();
            const chosenLang = langOption.getAttribute('data-lang-option') || 'en';
            setLanguage(chosenLang);
            closeAllDropdowns();
            return;
          }

          // 6. Favorites Button Trigger & Bookmarks Actions
          const favBtn = target.closest('#header-favorites-btn, [data-open-favorites]');
          if (favBtn) {
            e.preventDefault();
            e.stopPropagation();
            if (window.innerWidth < 1024) {
              closeAllDropdowns();
              navigate('/bookmarks');
              return;
            }
            const dropdown = document.getElementById('header-favorites-dropdown');
            if (dropdown) {
              const isOpen = !dropdown.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                updateFavoritesUI();
                dropdown.classList.remove('hidden');
                requestAnimationFrame(() => {
                  dropdown.classList.remove('scale-95', 'opacity-0');
                  dropdown.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const closeFavBtn = target.closest('[data-close-favorites]');
          if (closeFavBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeAllDropdowns();
            return;
          }

          const removeFavBtn = target.closest('[data-remove-bookmark]') as HTMLElement | null;
          if (removeFavBtn) {
            e.preventDefault();
            e.stopPropagation();
            const slug = removeFavBtn.getAttribute('data-remove-bookmark');
            if (slug) removeBookmark(slug);
            return;
          }

          const clearFavBtn = target.closest('[data-clear-bookmarks]');
          if (clearFavBtn) {
            e.preventDefault();
            e.stopPropagation();
            clearAllBookmarks();
            return;
          }

          const bookmarkBtn = target.closest('[data-bookmark-slug]') as HTMLElement | null;
          if (bookmarkBtn) {
            e.preventDefault();
            e.stopPropagation();

            const isAuthenticated = document.documentElement.getAttribute('data-authenticated') === 'true' || Boolean((window as any).__currentUser);
            if (!isAuthenticated) {
              if (typeof (window as any).showGlobalToast === 'function') {
                (window as any).showGlobalToast('Please sign in to save articles to your bookmarks', 'Sign in', '/login');
              }
              return;
            }

            const slug = bookmarkBtn.getAttribute('data-bookmark-slug') || '';
            const title = bookmarkBtn.getAttribute('data-bookmark-title') || '';
            const category = bookmarkBtn.getAttribute('data-bookmark-category') || '';
            const url = bookmarkBtn.getAttribute('data-bookmark-url') || `/${slug}`;
            const isSaved = toggleBookmark({ slug, title, category, url });
            if (typeof (window as any).showGlobalToast === 'function') {
              (window as any).showGlobalToast(isSaved ? 'Article saved to your bookmarks' : 'Article removed from bookmarks');
            }
            return;
          }

          // If clicked inside language or favorites dropdown, don't close
          if (target.closest('#header-language-dropdown, #header-favorites-dropdown')) {
            return;
          }

          // 7. Open Global Search Modal Trigger
          const searchTrigger = target.closest('[data-open-search]');
          if (searchTrigger) {
            e.preventDefault();
            e.stopPropagation();
            openSearchModal();
            return;
          }

          // 8. Search Modal Close Button or Backdrop Clicked
          const searchModal = document.getElementById('global-search-modal');
          const searchCloseBtn = target.closest('#global-search-close-btn');
          if (searchCloseBtn || target === searchModal) {
            e.preventDefault();
            e.stopPropagation();
            closeSearchModal();
            return;
          }

          // Click on search result or quick access link
          if (target.closest('.search-result-row, .quick-access-chip')) {
            closeSearchModal();
          }

          // 9. Mobile Drawer Close Clicked
          const mobileCloseBtn = target.closest('[data-mobile-sidebar-close]');
          if (mobileCloseBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeMobileDrawer();
            return;
          }

          // 10. Mobile Drawer Backdrop Clicked (overlay or backdrop wrapper)
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (backdrop && (target === backdrop || target === overlay) && !container?.contains(target)) {
            closeMobileDrawer();
            return;
          }

          // 11. Clicked Outside Everything: Close Dropdowns
          closeAllDropdowns();
        }

        // Keyboard Shortcuts
        function handleGlobalKeydown(e: KeyboardEvent) {
        const activeEl = document.activeElement;
        const isSearchModalOpen = !document.getElementById('global-search-modal')?.classList.contains('hidden');

        // Search modal specific keys (Arrow Navigation & Enter)
        if (isSearchModalOpen) {
          const rows = document.querySelectorAll<HTMLElement>('.search-result-row');
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (rows.length > 0) {
              activeResultIndex = (activeResultIndex + 1) % rows.length;
              highlightActiveResult();
            }
            return;
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (rows.length > 0) {
              activeResultIndex = (activeResultIndex - 1 + rows.length) % rows.length;
              highlightActiveResult();
            }
            return;
          }
          if (e.key === 'Enter') {
            if (activeResultIndex >= 0 && rows[activeResultIndex]) {
              e.preventDefault();
              rows[activeResultIndex].click();
            }
            return;
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            closeSearchModal();
            return;
          }
        }

        const isInput = activeEl && (
          activeEl.tagName === 'INPUT' || 
          activeEl.tagName === 'TEXTAREA' || 
          activeEl.getAttribute('contenteditable') === 'true'
        );

        // Alt+B / Ctrl+B / Cmd+B to toggle sidebar (Matches takeUforward)
        if ((e.altKey || e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
          e.preventDefault();
          toggleDesktopSidebar();
          return;
        }

        if (!isInput && e.key === '[') {
          e.preventDefault();
          toggleDesktopSidebar();
          return;
        }

        // Ctrl+K / Cmd+K to open search modal (Matches takeUforward)
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          openSearchModal();
          return;
        }

        if (e.key === 'Escape') {
          closeSearchModal();
          closeAllDropdowns();
          closeMobileDrawer();
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          wrapper?.classList.remove('hover-peek');
        }
      }

        async function syncAuthProfile() {
          const apiUrl = API_URL;
          const response = await fetch(`${apiUrl}/me`, { priority: 'low', credentials: 'include' } as any).catch(() => null);
          const user = response?.ok ? await response.json().catch(() => null) : null;

          if (user) {
            void refreshNotifications('session');

            if (!(window as any).__notifPollInterval) {
              (window as any).__notifPollInterval = setInterval(() => void refreshNotifications('session'), 45000);
            }
          } else {
            void refreshNotifications(null);
          }

          const nameEls = document.querySelectorAll('.user-display-name');
          const emailEls = document.querySelectorAll('.user-display-email');
          const initialEls = document.querySelectorAll('.user-avatar-initials');
          const logoutBtns = document.querySelectorAll<HTMLElement>('.auth-logout-btn');
          const loginLinks = document.querySelectorAll<HTMLElement>('.auth-login-link');
          const adminPanelLinks = document.querySelectorAll<HTMLElement>('.admin-panel-link');

          if (user) {
            const fullName = (user.name || 'User').trim();
            const email = user.email || 'Account';
            const parts = fullName.split(/\s+/).filter(Boolean);
            const initials = parts.length > 1
              ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
              : (fullName.slice(0, 2)).toUpperCase() || 'U';

            nameEls.forEach(el => el.textContent = fullName);
            emailEls.forEach(el => el.textContent = email);
            initialEls.forEach(el => {
              el.textContent = initials;
              el.classList.remove('hidden');
            });

            adminPanelLinks.forEach((link) => {
              const canAccess = user.role === 'admin' || user.role === 'editor';
              link.classList.toggle('hidden', !canAccess);
              link.style.display = canAccess ? 'flex' : 'none';
            });

            logoutBtns.forEach((b) => {
              b.classList.remove('hidden');
              b.style.display = 'flex';
            });
            loginLinks.forEach((l) => {
              l.classList.add('hidden');
              l.style.display = 'none';
            });

            // Set authenticated attribute and expose global user state
            document.documentElement.setAttribute('data-authenticated', 'true');
            (window as any).__currentUser = user;

            document.querySelectorAll<HTMLElement>('.auth-logged-in-only').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });

            // Show Logged In Profile UI in Sidebar & Header, HIDE Logged Out CTA (Get Started button)
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
          } else {
            document.documentElement.removeAttribute('data-authenticated');
            (window as any).__currentUser = null;

            document.querySelectorAll<HTMLElement>('.auth-logged-in-only').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });

            nameEls.forEach(el => el.textContent = 'Guest User');
            emailEls.forEach(el => el.textContent = 'Sign in to access your profile');
            initialEls.forEach(el => {
              el.textContent = 'GU';
              el.classList.remove('hidden');
            });
            adminPanelLinks.forEach((link) => {
              link.classList.add('hidden');
              link.style.display = 'none';
            });

            logoutBtns.forEach((b) => {
              b.classList.add('hidden');
              b.style.display = 'none';
            });
            loginLinks.forEach((l) => {
              l.classList.remove('hidden');
              l.style.display = 'flex';
            });

            // Show Logged Out UI in Sidebar & Header, HIDE Profile Card & Profile Icon
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-in').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-out').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-in').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-out').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
          }
        }

        let toastTimer: any = null;
        function showGlobalToast(message: string, actionLabel?: string, actionHref?: string) {
          const toast = document.getElementById('global-toast');
          const msgEl = document.getElementById('global-toast-msg');
          const actionEl = document.getElementById('global-toast-action') as HTMLAnchorElement | null;
          if (!toast || !msgEl) return;

          msgEl.textContent = message;
          if (actionEl && actionLabel && actionHref) {
            actionEl.textContent = actionLabel;
            actionEl.href = actionHref;
            actionEl.classList.remove('hidden');
            actionEl.style.display = 'inline-flex';
          } else if (actionEl) {
            actionEl.classList.add('hidden');
            actionEl.style.display = 'none';
          }

          toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
          toast.classList.add('translate-y-0', 'opacity-100');

          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.remove('translate-y-0', 'opacity-100');
          }, 4500);
        }

        (window as any).showGlobalToast = showGlobalToast;

        function updateSidebarActiveLinks() {
          const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
          const navItems = document.querySelectorAll<HTMLAnchorElement>('.sidebar-nav-item');

          navItems.forEach((link) => {
            const rawHref = (link.getAttribute('href') || '').trim();
            const isAnchor = rawHref.includes('#');
            const isExternal = link.getAttribute('target') === '_blank' || rawHref.startsWith('http://') || rawHref.startsWith('https://');
            const isSocial = isExternal || rawHref.includes('wa.me') || rawHref.includes('t.me');

            if (isSocial || !rawHref) {
              return;
            }

            const linkPath = rawHref.split('#')[0].replace(/\/$/, '') || '/';

            let isActive = false;
            if (rawHref === '/') {
              isActive = currentPath === '/';
            } else if (!isAnchor && linkPath !== '/') {
              isActive = currentPath === linkPath || currentPath.startsWith(linkPath + '/');
            }

            const svg = link.querySelector('svg');

            if (isActive) {
              link.classList.add('bg-[#EBF2FE]', 'text-[#2563EB]', 'font-semibold', 'theme-dark:bg-[#2563EB]/20', 'theme-dark:text-[#60A5FA]');
              link.classList.remove('text-muted', 'hover:text-white', 'hover:bg-surface-raised');
              if (svg && !svg.classList.contains('text-[#25D366]') && !svg.classList.contains('text-[#2AABEE]')) {
                svg.classList.add('text-[#2563EB]', 'theme-dark:text-[#60A5FA]');
                svg.classList.remove('text-muted');
              }
            } else {
              link.classList.remove('bg-[#EBF2FE]', 'text-[#2563EB]', 'font-semibold', 'theme-dark:bg-[#2563EB]/20', 'theme-dark:text-[#60A5FA]');
              link.classList.add('text-muted', 'hover:text-white', 'hover:bg-surface-raised');
              if (svg && !svg.classList.contains('text-[#25D366]') && !svg.classList.contains('text-[#2AABEE]')) {
                svg.classList.remove('text-[#2563EB]', 'theme-dark:text-[#60A5FA]');
              }
            }
          });
        }

        function reinitPageElements() {
          // Sync sidebar active links
          updateSidebarActiveLinks();

          // Restore Collapsed State
          const savedCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
          setSidebarCollapsed(savedCollapsed);

          // Sync theme UI toggle knobs (Default is LIGHT)
          const initialIsLight = !document.documentElement.classList.contains('theme-dark');
          updateAllThemeToggles(initialIsLight);

          // Sync language toggle with rendered content (fixes EN toggle + Hinglish body)
          const preferred = normalizeAppLang(
            localStorage.getItem('preferred_exam_lang')
              || localStorage.getItem('site_language')
              || 'hinglish',
          );
          const displayedArticleLang = getDisplayedArticleLang();
          const urlLangRaw = new URLSearchParams(window.location.search).get('lang');
          const hasExplicitUrlLang = urlLangRaw != null && urlLangRaw !== '';

          if (displayedArticleLang) {
            if (hasExplicitUrlLang) {
              // Explicit ?lang= wins — sync preference to match URL/content
              setLanguage(displayedArticleLang, false);
            } else {
              setLanguage(displayedArticleLang, false);
              if (preferred !== displayedArticleLang && canSwapArticleLanguage(preferred)) {
                setLanguage(preferred, true);
              }
            }
          } else {
            setLanguage(preferred, false);
          }



          // Search Input & Tab Listeners
          const globalSearchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
          if (globalSearchInput) {
            globalSearchInput.oninput = (e) => {
              renderSearchResults((e.target as HTMLInputElement).value);
            };
          }

          document.querySelectorAll<HTMLElement>('.search-tab').forEach((tab) => {
            tab.onclick = () => {
              document.querySelectorAll('.search-tab').forEach((t) => {
                t.classList.remove('bg-surface-raised', 'text-accent', 'border', 'border-border', 'font-semibold');
                t.classList.add('text-muted');
              });
              tab.classList.remove('text-muted');
              tab.classList.add('bg-surface-raised', 'text-accent', 'border', 'border-border', 'font-semibold');
              currentSearchCategory = tab.getAttribute('data-category') || 'all';
              if (globalSearchInput) {
                renderSearchResults(globalSearchInput.value);
              }
            };
          });

          updateFavoritesUI();
          queueSyncAuthProfile();
        }

        let authProfileQueued = false;
        function queueSyncAuthProfile() {
          if (authProfileQueued) return;
          authProfileQueued = true;
          const run = () => {
            authProfileQueued = false;
            void syncAuthProfile();
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(run, { timeout: 2000 });
          } else {
            setTimeout(run, 1000);
          }
        }

        // --- Global One-Time Event Listeners & Lifecycles ---
        if (!(window as any).__APP_GLOBAL_LISTENERS_INITIALIZED__) {
          (window as any).__APP_GLOBAL_LISTENERS_INITIALIZED__ = true;

          // Central Click Event Delegation
          document.addEventListener('click', handleGlobalClick);

          // Global Keyboard Shortcuts
          document.addEventListener('keydown', handleGlobalKeydown);

          // Reactive bookmarks event
          window.addEventListener('bookmarks-updated', () => updateFavoritesUI());

          // Window language change event
          window.addEventListener('exam:language-change', ((e: CustomEvent) => {
            if (e.detail?.lang) setLanguage(e.detail.lang, false);
          }) as EventListener);

          // Cleanup before page swap
          document.addEventListener('astro:before-swap', () => {
            closeAllDropdowns();
            closeSearchModal();
            closeMobileDrawer();
            if (hoverPeekTimer) {
              clearTimeout(hoverPeekTimer);
              hoverPeekTimer = null;
            }
          });

          document.addEventListener('astro:before-preparation', () => {
            const bar = document.getElementById('route-loading-bar');
            if (bar) {
              bar.style.transition = 'transform 0.3s ease, opacity 0.15s ease';
              bar.style.opacity = '1';
              bar.style.transform = 'scaleX(0.7)';
            }
          });

          // Re-initialize dynamic elements on every Astro ClientRouter navigation
          document.addEventListener('astro:page-load', () => {
            const bar = document.getElementById('route-loading-bar');
            if (bar) {
              bar.style.transform = 'scaleX(1)';
              setTimeout(() => {
                bar.style.opacity = '0';
                setTimeout(() => {
                  bar.style.transform = 'scaleX(0)';
                }, 200);
              }, 150);
            }
            reinitPageElements();
          });
        }

        // Run immediately for initial page render
        reinitPageElements();
      })();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
