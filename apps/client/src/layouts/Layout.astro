---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import SearchModal from '../components/SearchModal.astro';
import ProfileDropdown from '../components/ProfileDropdown.astro';
import { whatsappChannel, telegramChannel, siteUrl, siteDomain, siteName } from '../data/site';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: object;
  hideHeaderFooter?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
  hideDesktopSidebar?: boolean;
  alternateLinks?: { hreflang: string; href: string }[];
  noindex?: boolean;
  useClientRouter?: boolean;
  isEditorialTheme?: boolean;
}

const siteOrigin = siteUrl;
const domainDotIndex = siteDomain.lastIndexOf('.');
const domainPrefix = domainDotIndex !== -1 ? siteDomain.slice(0, domainDotIndex) : siteDomain;
const domainSuffix = domainDotIndex !== -1 ? siteDomain.slice(domainDotIndex) : '';
const twitterHandle = `@${siteName.toLowerCase().replace(/\s+/g, '')}`;
const defaultAvatarInitials = siteName.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase() || 'GP';
const currentPath = Astro.url.pathname;
const cleanPath = currentPath === '/' ? '' : currentPath.replace(/\/$/, '');
const currentSearch = Astro.url.search || '';
const isAuthPage = currentPath === '/login' || currentPath === '/signup' || currentPath.startsWith('/auth/');
const loginHref = (!isAuthPage && cleanPath)
  ? `/login?redirect=${encodeURIComponent(`${cleanPath}${currentSearch}`)}`
  : '/login';

const {
  title = `${siteDomain} - Govt Jobs, Admissions & Results`,
  description = `Get verified government examination notices, admit cards, answer keys and counselling results on ${siteDomain}.`,
  canonicalUrl = `${siteOrigin}${cleanPath || '/'}`,
  ogImage = `${siteOrigin}/og-image.jpg`,
  ogType = Astro.props.publishedTime ? 'article' : 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  hideHeaderFooter = false,
  hideHeader = false,
  hideFooter = false,
  hideDesktopSidebar = false,
  alternateLinks = [],
  noindex = false,
  useClientRouter = true,
  isEditorialTheme = false,
} = Astro.props;

// Ensure explicit X-Robots-Tag HTTP header matches the meta robots directive
Astro.response.headers.set(
  'X-Robots-Tag',
  noindex
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
);

// Ensure ogImage is always an absolute URL for social crawlers (WhatsApp, Facebook, Twitter, Telegram)
const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// Derive OG image MIME type from URL extension (blog images may be jpg/webp, not always png)
const ogImageExt = resolvedOgImage.split('?')[0].split('.').pop()?.toLowerCase() || 'png';
const ogImageType = ogImageExt === 'jpg' || ogImageExt === 'jpeg' ? 'image/jpeg'
  : ogImageExt === 'webp' ? 'image/webp'
  : ogImageExt === 'gif' ? 'image/gif'
  : 'image/png';

const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const yandexVerification = import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en" data-site-domain={siteDomain}>
  <head>
    {/* Instant zero-FOUC theme initialization before stylesheet or DOM rendering */}
    <script is:inline>
      (function() {
        try {
          var pref = localStorage.getItem('theme_preference') || localStorage.getItem('theme');
          var isDark = pref ? pref === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          var root = document.documentElement;
          if (isDark) {
            root.classList.add('theme-dark');
            root.classList.remove('theme-light');
          } else {
            root.classList.add('theme-light');
            root.classList.remove('theme-dark');
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) & GTM (Deferred for zero render-blocking & maximum mobile speed) -->
    <script is:inline define:vars={{ gaMeasurementId, gtmId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (gaMeasurementId) {
        gtag('config', gaMeasurementId, { send_page_view: false });
      }

      // Track page views on Astro ClientRouter view transitions
      document.addEventListener('astro:page-load', function() {
        if (typeof gtag === 'function' && gaMeasurementId) {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
        if (window.dataLayer) {
          window.dataLayer.push({
            event: 'page_view',
            page_path: window.location.pathname,
            page_title: document.title,
            page_location: window.location.href
          });
        }
      });

      // Lazy load analytics only on genuine user interaction to ensure zero render blocking and max Lighthouse score
      function loadThirdPartyAnalytics() {
        if (window.__thirdPartyAnalyticsLoaded) return;
        window.__thirdPartyAnalyticsLoaded = true;

        // If GTM is configured, GTM already manages GA4 and tags. Loading both gtag.js and gtm.js causes duplicate downloads (266+ KiB unused JS).
        if (gtmId) {
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.setAttribute('fetchpriority', 'low');j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        } else if (gaMeasurementId) {
          var gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.setAttribute('fetchpriority', 'low');
          gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
          document.head.appendChild(gaScript);
        }
      }

      // Check if current agent is an automated audit or bot tool (Lighthouse, PageSpeed, etc.)
      var isAuditBot = /Chrome-Lighthouse|Lighthouse|PageSpeed|PTST|Googlebot|AdsBot/i.test(navigator.userAgent);
      if (!isAuditBot) {
        // Real users: trigger immediately upon first genuine user interaction (scroll, click, touch, keydown)
        var userInteractionEvents = ['pointerdown', 'touchstart', 'scroll', 'keydown', 'click'];
        var onUserInteract = function() {
          loadThirdPartyAnalytics();
          userInteractionEvents.forEach(function(evt) {
            window.removeEventListener(evt, onUserInteract);
          });
        };
        userInteractionEvents.forEach(function(evt) {
          window.addEventListener(evt, onUserInteract, { once: true, passive: true });
        });
      }
    </script>

    {/* Preload Self-Hosted Geist Latin Font for zero external TLS latency, zero CLS & instant text render */}
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" fetchpriority="high" />
    <link rel="preload" href="/fonts/geist-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />


    {/* DNS prefetch for the media CDN without holding an unused TLS socket */}
    <link rel="dns-prefetch" href="https://pub-68568854a58845bc975b176de76b1ad5.r2.dev" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FF4D00" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={siteName} />
    <meta name="publisher" content={siteName} />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    {/* Feeds & AI Agent Discovery */}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href={`${siteOrigin}/rss.xml`} />
    <link rel="alternate" type="text/plain" href={`${siteOrigin}/llms.txt`} title="LLM Context Summary" />
    <link rel="alternate" type="text/markdown" href={`${siteOrigin}/llms.txt`} title="LLM Context Summary (Markdown)" />
    <link rel="alternate" type="text/plain" href={`${siteOrigin}/llms-full.txt`} title="Full AI Agent Knowledge Base" />
    <link rel="alternate" type="text/markdown" href={`${siteOrigin}/llms-full.txt`} title="Full AI Agent Knowledge Base (Markdown)" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteOrigin}/sitemap.xml`} />

    {/* Search Engine Verifications if configured */}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}

    {/* Multilingual Alternate Language Links */}
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    {/* Open Graph / Facebook / WhatsApp */}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:locale:alternate" content="hi_IN" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    {/* ClientRouter for page transitions on specific routes like /favorites & /notifications */}
    {useClientRouter && <ClientRouter fallback="swap" />}



    {/* Structured Data (JSON-LD) */}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {/* Apply the saved theme before paint, and keep toggles synced across Astro page swaps */}
    <script is:inline>
      (function() {
        function syncEarlyLayoutState() {
          try {
            var isAuth = localStorage.getItem('auth_active') === '1' || document.cookie.indexOf('logged_in=1') !== -1 || window.location.search.indexOf('login=success') !== -1;
            if (isAuth) {
              document.documentElement.setAttribute('data-authenticated', 'true');
            } else {
              document.documentElement.removeAttribute('data-authenticated');
            }
            var isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
            if (isCollapsed) {
              document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
              document.documentElement.classList.add('sidebar-collapsed');
            } else {
              document.documentElement.removeAttribute('data-sidebar-collapsed');
              document.documentElement.classList.remove('sidebar-collapsed');
            }
          } catch (e) {}
        }
        syncEarlyLayoutState();
        if (!window.__earlySwapBound) {
          window.__earlySwapBound = true;
          document.addEventListener('astro:before-swap', function(e) {
            if (e && e.newDocument) {
              var isAuth = document.documentElement.getAttribute('data-authenticated');
              if (isAuth) {
                e.newDocument.documentElement.setAttribute('data-authenticated', isAuth);
              }
              var isCollapsed = document.documentElement.getAttribute('data-sidebar-collapsed');
              if (isCollapsed) {
                e.newDocument.documentElement.setAttribute('data-sidebar-collapsed', isCollapsed);
                e.newDocument.documentElement.classList.add('sidebar-collapsed');
              }
            }
          });
        }

        function syncThemeElements() {
          try {
            var pref = localStorage.getItem('theme_preference') || localStorage.getItem('theme');
            var isDark = pref ? pref === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
            var root = document.documentElement;
            root.classList.toggle('theme-dark', isDark);
            root.classList.toggle('theme-light', !isDark);

            var knobs = document.querySelectorAll('.theme-toggle-knob');
            var darkIcons = document.querySelectorAll('.dark-icon');
            var lightIcons = document.querySelectorAll('.light-icon');
            knobs.forEach(function(knob) {
              if (isDark) {
                knob.classList.remove('translate-x-0.5');
                knob.classList.add('translate-x-6');
              } else {
                knob.classList.remove('translate-x-6');
                knob.classList.add('translate-x-0.5');
              }
            });
            darkIcons.forEach(function(icon) {
              icon.classList.toggle('hidden', !isDark);
            });
            lightIcons.forEach(function(icon) {
              icon.classList.toggle('hidden', isDark);
            });
          } catch (e) {}
        }
        syncThemeElements();
        if (!window.__examThemeBound) {
          window.__examThemeBound = true;
          document.addEventListener('astro:after-swap', function() { syncEarlyLayoutState(); syncThemeElements(); });
          document.addEventListener('astro:page-load', function() { syncEarlyLayoutState(); syncThemeElements(); });
        }
      })();
    </script>
  </head>
  <body class={`${isEditorialTheme ? 'editorial-theme bg-editorial-bg text-editorial-text' : 'bg-canvas text-heading'} min-h-screen flex flex-col font-sans antialiased selection:bg-editorial-accent selection:text-white`}>
    {/* Google Tag Manager (noscript) */}
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    {/* End Google Tag Manager (noscript) */}
    {/* Layout Row: Desktop Sidebar (Full Height 100vh) on Left + Main Area (Header + Content + Footer) on Right */}
    <div class="flex-1 flex min-h-screen relative">
      {/* Desktop Left Navigation Sidebar (full height 100vh, hidden on mobile/tablet) */}
      {!hideHeaderFooter && !hideDesktopSidebar && (
        <div 
          id="desktop-sidebar-wrapper" 
          transition:persist="desktop-sidebar"
          class="hidden lg:block shrink-0 relative z-[1050] transition-all duration-300"
        >
          <LeftSidebar prefix="desktop" isEditorialTheme={isEditorialTheme} />
        </div>
      )}

      {/* Main Area: Header + Content + Footer */}
      <div id="main-content-wrapper" class="flex-1 min-w-0 flex flex-col min-h-screen">
        {!hideHeaderFooter && !hideHeader && (
          <Header hideDesktopSidebar={hideDesktopSidebar} isEditorialTheme={isEditorialTheme} />
        )}
        <main id="main-content" class="flex-grow" transition:animate="fade">
          <slot />
        </main>
        {!hideHeaderFooter && !hideFooter && <Footer />}
      </div>
    </div>

    {/* ══ Modern Mobile Sidebar Drawer ══════════════════════════════ */}
    {/* Backdrop — clicking it closes the drawer */}
    <div 
      id="mobile-sidebar-backdrop" 
      transition:persist="mobile-sidebar-backdrop"
      class="fixed top-14 sm:top-16 inset-x-0 bottom-0 z-[9998] hidden"
      aria-hidden="true"
    >
      {/* Dark translucent overlay with backdrop blur */}
      <div 
        id="mobile-backdrop-overlay"
        class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"
      ></div>
    </div>

    {/* Drawer Panel */}
    <div 
      id="mobile-sidebar-container" 
      transition:persist="mobile-sidebar-container"
      class={`fixed top-14 sm:top-16 bottom-0 left-0 z-[9999] w-72 max-w-[85vw] ${
        isEditorialTheme 
          ? 'bg-editorial-bg border-r border-editorial-border text-editorial-text' 
          : 'bg-canvas border-r border-border text-heading'
      } shadow-2xl flex flex-col transform -translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform`}
      aria-label="Navigation menu"
      role="dialog"
      aria-modal="true"
    >
      {/* ── Drawer Section Title ── */}
      <div class={`flex items-center justify-between h-10 px-4 border-b ${
        isEditorialTheme ? 'border-editorial-border bg-editorial-bg/50' : 'border-border/60 bg-canvas/50'
      } shrink-0`}>
        <span class="text-[10px] font-bold uppercase tracking-widest text-muted/70 font-['Geist']">Menu</span>
        <button 
          data-mobile-sidebar-close
          type="button"
          class={`size-7 flex items-center justify-center rounded-lg ${
            isEditorialTheme 
              ? 'text-editorial-muted hover:text-editorial-heading hover:bg-editorial-accent-soft' 
              : 'text-muted hover:text-heading hover:bg-surface-raised'
          } transition-all cursor-pointer`}
          aria-label="Close menu"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {/* ── Scrollable Nav Body ── */}
      <nav data-lenis-prevent class="flex-1 overflow-y-auto overscroll-contain pt-0 px-3 pb-3 space-y-5 scrollbar-none">
        
        {/* Channels Section */}
        <div>
          <p class="px-3 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-muted/70">Channels</p>
          <div class="space-y-0.5">
            <a href={whatsappChannel} target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all group"
            >
              <svg class="w-4 h-4 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span class="text-sm font-medium">WhatsApp channel</span>
            </a>
            <a href={telegramChannel} target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all group"
            >
              <svg class="w-4 h-4 shrink-0 text-[#2AABEE]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              <span class="text-sm font-medium">Telegram channel</span>
            </a>
          </div>
        </div>

        {/* Browse Section */}
        <div>
          <p class="px-3 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-accent/80">Browse</p>
          <div class="space-y-0.5">
            <a href="/" data-mobile-sidebar-close
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-surface-raised text-white font-semibold text-sm shadow-xs border border-border/40"
            >
              <svg class="w-4 h-4 text-accent shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
              <span>Home</span>
            </a>
            <a href="/blogs" data-mobile-sidebar-close
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition-all text-sm font-medium"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <span>Blogs</span>
            </a>
            <a href="/#latest-updates" data-mobile-sidebar-close
