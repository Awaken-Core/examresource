    {/* Global Search Modal */}
    <SearchModal />

    {/* Global Non-intrusive Toast Notification (For Sign-in prompts, status feedback) */}
    <div 
      id="global-toast" 
      transition:persist="global-toast"
      class="fixed bottom-5 right-5 z-[10000] max-w-sm w-[calc(100vw-2.5rem)] sm:w-auto bg-surface-raised border border-border/80 shadow-2xl rounded-2xl p-3.5 flex items-center justify-between gap-3 text-white text-xs transition-all duration-300 transform translate-y-12 opacity-0 pointer-events-none backdrop-blur-md"
      role="status"
      aria-live="polite"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <span id="global-toast-icon" class="w-6 h-6 rounded-lg bg-accent/15 border border-accent/30 text-accent flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </span>
        <p id="global-toast-msg" class="truncate font-medium text-white/95">Message</p>
      </div>
      <a id="global-toast-action" href="/login" class="hidden px-2.5 py-1 rounded-lg bg-accent text-on-accent font-semibold text-[11px] shrink-0 hover:bg-accent/90 transition shadow-2xs">
        Sign in
      </a>
    </div>

    {/* Global Robust Interactive Script */}
    <script>
      import { appLangToBlogLanguage, articleHref, normalizeAppLang } from '../lib/preferred-lang';
      import { initLenis, destroyLenis, stopLenis, startLenis } from '../lib/lenis';

      const siteDomain = document.documentElement.getAttribute('data-site-domain') || window.location.hostname;
      const API_URL = (import.meta.env.PUBLIC_API_URL || '').replace(/\/$/, '');

      function getDisplayedArticleLang(): 'hinglish' | 'en' | null {
        const view = document.querySelector<HTMLElement>('.blog-reading-view, [data-article-lang]');
        if (!view && !document.getElementById('article-lang-data')) return null;
        const fromAttr = view?.dataset.articleLang;
        if (fromAttr === 'en' || fromAttr === 'hinglish') return fromAttr;
        const urlLang = new URLSearchParams(window.location.search).get('lang');
        if (urlLang === 'en' || urlLang === 'english') return 'en';
        return 'hinglish';
      }

      (function initApp() {

        // --- Theme Management ---
        function updateAllThemeToggles(isLight: boolean) {
          const knobs = document.querySelectorAll('.theme-toggle-knob');
          const darkIcons = document.querySelectorAll('.dark-icon');
          const lightIcons = document.querySelectorAll('.light-icon');

          knobs.forEach((knob) => {
            if (isLight) {
              knob.classList.remove('translate-x-6');
              knob.classList.add('translate-x-0.5');
            } else {
              knob.classList.remove('translate-x-0.5');
              knob.classList.add('translate-x-6');
            }
          });

          darkIcons.forEach((icon) => {
            if (isLight) icon.classList.add('hidden');
            else icon.classList.remove('hidden');
          });

          lightIcons.forEach((icon) => {
            if (isLight) icon.classList.remove('hidden');
            else icon.classList.add('hidden');
          });

          document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
            btn.setAttribute('title', isLight ? 'Switch to dark mode' : 'Switch to light mode');
            btn.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
          });
        }

        function toggleTheme() {
          const isCurrentlyDark = document.documentElement.classList.contains('theme-dark');
          const nextLight = isCurrentlyDark; // If currently dark, toggle to light; otherwise toggle to dark

          if (nextLight) {
            document.documentElement.classList.remove('theme-dark');
            document.documentElement.classList.add('theme-light');
            localStorage.setItem('theme', 'light');
            localStorage.setItem('theme_preference', 'light');
          } else {
            document.documentElement.classList.add('theme-dark');
            document.documentElement.classList.remove('theme-light');
            localStorage.setItem('theme', 'dark');
            localStorage.setItem('theme_preference', 'dark');
          }

          updateAllThemeToggles(nextLight);
        }

        // --- Robust Dropdown Management (Safe from Timeout Clashes) ---
        function closeDropdown(menu: HTMLElement) {
          menu.classList.remove('scale-100', 'opacity-100');
          menu.classList.add('scale-95', 'opacity-0');

          const prevTimer = menu.getAttribute('data-close-timer');
          if (prevTimer) clearTimeout(Number(prevTimer));

          const timer = window.setTimeout(() => {
            menu.classList.add('hidden');
            menu.removeAttribute('data-close-timer');
          }, 150);
          menu.setAttribute('data-close-timer', String(timer));
        }

        function openDropdown(menu: HTMLElement, trigger: HTMLElement) {
          const prevTimer = menu.getAttribute('data-close-timer');
          if (prevTimer) {
            clearTimeout(Number(prevTimer));
            menu.removeAttribute('data-close-timer');
          }

          menu.classList.remove('hidden');
          requestAnimationFrame(() => {
            menu.classList.remove('scale-95', 'opacity-0');
            menu.classList.add('scale-100', 'opacity-100');
          });
          trigger.setAttribute('aria-expanded', 'true');
        }

        function closeAllDropdowns(exceptMenu?: HTMLElement | null) {
          document.querySelectorAll<HTMLElement>('[role="menu"]').forEach((menu) => {
            if (menu !== exceptMenu) {
              closeDropdown(menu);
            }
          });
          document.querySelectorAll('[data-profile-trigger]').forEach((trigger) => {
            if (!exceptMenu || trigger.getAttribute('data-profile-trigger') !== exceptMenu.id) {
              trigger.setAttribute('aria-expanded', 'false');
            }
          });
          // Close all notification popups
          document.querySelectorAll<HTMLElement>('[data-notification-popup]').forEach((notifPopup) => {
            if (notifPopup !== exceptMenu) {
              notifPopup.classList.add('hidden', 'scale-95', 'opacity-0');
              notifPopup.classList.remove('scale-100', 'opacity-100');
            }
          });
          // Close language dropdown
          const langDropdown = document.getElementById('header-language-dropdown');
          if (langDropdown && langDropdown !== exceptMenu) {
            langDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            langDropdown.classList.remove('scale-100', 'opacity-100');
          }
          // Close favorites dropdown
          const favDropdown = document.getElementById('header-favorites-dropdown');
          if (favDropdown && favDropdown !== exceptMenu) {
            favDropdown.classList.add('hidden', 'scale-95', 'opacity-0');
            favDropdown.classList.remove('scale-100', 'opacity-100');
          }
        }

        // --- Mobile Drawer Management ---
        function updateHamburgerIcon(isOpen: boolean) {
          const btn = document.getElementById('mobile-drawer-toggle-btn');
          if (!btn) return;
          btn.classList.toggle('is-active', isOpen);
          btn.setAttribute('aria-expanded', String(isOpen));
          btn.setAttribute('title', isOpen ? 'Close Navigation Menu' : 'Open Navigation Menu');
          btn.setAttribute('aria-label', isOpen ? 'Close Navigation Menu' : 'Open Navigation Menu');
        }

        function openMobileDrawer() {
          stopLenis();
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (!backdrop || !container) return;

          // Show backdrop wrapper first (makes overlay and container visible)
          backdrop.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          updateHamburgerIcon(true);

          // Animate in on next frame
          requestAnimationFrame(() => {
            if (overlay) overlay.classList.add('opacity-100');
            container.classList.remove('-translate-x-full');
            container.classList.add('translate-x-0');
          });
        }

        function closeMobileDrawer() {
          startLenis();
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (!backdrop || !container) return;

          // Animate out
          if (overlay) overlay.classList.remove('opacity-100');
          container.classList.remove('translate-x-0');
          container.classList.add('-translate-x-full');
          updateHamburgerIcon(false);

          // Hide after animation completes
          setTimeout(() => {
            backdrop.classList.add('hidden');
            document.body.style.overflow = '';
          }, 320);
        }

        // --- Desktop Sidebar Collapse Management (Matches Image 1) ---

        function setSidebarCollapsed(isCollapsed: boolean, immediate = false) {
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          if (isCollapsed) {
            wrapper?.classList.add('collapsed');
            document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
            document.documentElement.classList.add('sidebar-collapsed');
          } else {
            wrapper?.classList.remove('collapsed');
            document.documentElement.removeAttribute('data-sidebar-collapsed');
            document.documentElement.classList.remove('sidebar-collapsed');
          }
          const tooltipText = document.getElementById('sidebar-toggle-tooltip-text');
          if (tooltipText) tooltipText.textContent = isCollapsed ? 'Expand sidebar' : 'Collapse sidebar';
          localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
        }

        function toggleDesktopSidebar() {
          if (window.innerWidth < 1024) {
            const container = document.getElementById('mobile-sidebar-container');
            const isDrawerOpen = container?.classList.contains('translate-x-0') ?? false;
            if (isDrawerOpen) {
              closeMobileDrawer();
            } else {
              openMobileDrawer();
            }
            return;
          }
          document.documentElement.classList.add('sidebar-ready');
          const isCurrentlyCollapsed = document.documentElement.getAttribute('data-sidebar-collapsed') === 'true' ||
            (document.getElementById('desktop-sidebar-wrapper')?.classList.contains('collapsed') ?? false);
          setSidebarCollapsed(!isCurrentlyCollapsed);
        }



        // --- Language Switcher Integration ---
        function syncListingCardLinks(lang: string) {
          const normalized = normalizeAppLang(lang);
          document.querySelectorAll<HTMLAnchorElement>('[data-article-link]').forEach((a) => {
            const slug = a.getAttribute('data-article-link');
            if (!slug) return;
            a.setAttribute('href', articleHref(slug, normalized));
          });
        }

        function softNavigate(url: string) {
          window.location.href = url;
        }

        /** Update home/category cards in place — no navigation, no scroll jump. */
        async function refreshListingCardsInPlace(lang: string) {
          const normalized = normalizeAppLang(lang);
          const blogLang = appLangToBlogLanguage(normalized);
          const path = window.location.pathname;
          const categoryMatch = path.match(/^\/category\/([^/]+)\/?$/);
          const params = new URLSearchParams({ limit: '50', language: blogLang, includeImages: 'false' });
          if (categoryMatch?.[1]) params.set('category', categoryMatch[1]);

          try {
            const res = await fetch(`${API_URL}/blogs?${params.toString()}`, { priority: 'high' } as any);
            if (!res.ok) return;
            const posts = await res.json();
            if (!Array.isArray(posts)) return;

            const bySlug = new Map<string, any>();
            posts.forEach((p: any) => {
              if (p?.slug) bySlug.set(String(p.slug).toLowerCase(), p);
            });

            document.querySelectorAll<HTMLAnchorElement>('[data-article-link]').forEach((a) => {
              const slug = (a.getAttribute('data-article-link') || '').toLowerCase();
              const post = bySlug.get(slug);
              if (!post) return;

              a.setAttribute('href', articleHref(slug, normalized));

              const titleEl = a.querySelector<HTMLElement>('[data-article-title]');
              if (titleEl && post.title) titleEl.textContent = post.title;

              const summaryEl = a.querySelector<HTMLElement>('[data-article-summary]');
              if (summaryEl) {
                summaryEl.textContent =
                  post.description || post.metaDescription || summaryEl.textContent || '';
              }

              const img = a.querySelector<HTMLImageElement>('img');
              if (img && post.title) img.alt = post.title;
            });
          } catch {
            // Keep existing card text; hrefs already updated via syncListingCardLinks
          }
        }

        function setLanguage(lang: string, shouldNavigate: boolean = false) {
          const normalized = normalizeAppLang(lang);
          let previous: string = 'hinglish';
          try {
            previous = normalizeAppLang(
              localStorage.getItem('preferred_exam_lang')
                || localStorage.getItem('site_language')
                || 'hinglish',
            );
            localStorage.setItem('preferred_exam_lang', normalized);
            localStorage.setItem('site_language', normalized);
            document.cookie = `preferred_lang=${normalized};path=/;max-age=31536000;SameSite=Lax`;
          } catch (e) {}

          const label = document.getElementById('current-language-label');
          if (label) label.textContent = normalized === 'en' ? 'EN' : 'HI';

          // Update profile language toggle buttons
          const appLangBtns = document.querySelectorAll<HTMLElement>('[data-app-lang], [data-global-lang]');
          appLangBtns.forEach((btn) => {
            const btnLang = btn.getAttribute('data-app-lang') || btn.getAttribute('data-global-lang');
            const isBtnActive = (btnLang === normalized);
            if (isBtnActive) {
              btn.classList.add('bg-editorial-accent', 'bg-accent', '!text-white', 'font-bold', 'shadow-2xs');
              btn.classList.remove('text-muted', 'text-editorial-muted', 'bg-accent/20', 'text-accent');
              btn.setAttribute('aria-pressed', 'true');
            } else {
              btn.classList.remove('bg-editorial-accent', 'bg-accent', '!text-white', '!text-[#ffffff]', 'font-bold', 'shadow-2xs', 'bg-accent/20', 'text-accent');
              btn.classList.add('text-muted', 'text-editorial-muted');
              btn.setAttribute('aria-pressed', 'false');
            }
          });

          // Keep listing card links aligned with preference
          syncListingCardLinks(normalized);

          if (!shouldNavigate) return;

          const isArticle = document.querySelector('.blog-reading-view') !== null
            || document.getElementById('article-lang-data') !== null;

          if (isArticle) {
            const displayed = getDisplayedArticleLang();
            if (displayed === normalized) return;

            void import('../lib/article-lang-swap').then(({ canSwapArticleLanguage, swapArticleLanguage }) => {
              if (canSwapArticleLanguage(normalized)) {
                swapArticleLanguage(normalized);
              } else {
                const path = window.location.pathname;
                const search = new URLSearchParams(window.location.search);
                if (normalized === 'en') search.set('lang', 'en');
                else search.delete('lang');
                const qs = search.toString();
                softNavigate(qs ? `${path}?${qs}` : path);
              }
            });
            return;
          }

          // Home / category: update cards in place (preserves scroll position)
          const path = window.location.pathname;
          if ((path === '/' || path.startsWith('/category/')) && previous !== normalized) {
            void refreshListingCardsInPlace(normalized);
          }
        }

        // --- Global Spotlight Search Modal Items ---
        let cachedSearchItems: typeof import('../data/site').searchItems | null = null;
        async function loadSearchItems() {
          if (!cachedSearchItems) {
            const mod = await import('../data/site');
            cachedSearchItems = mod.searchItems;
          }
          return cachedSearchItems;
        }

        let currentSearchCategory = 'all';
        let activeResultIndex = -1;

        function openSearchModal() {
          stopLenis();
          const modal = document.getElementById('global-search-modal');
          const container = document.getElementById('global-search-container');
          const input = document.getElementById('global-search-input') as HTMLInputElement | null;
          if (!modal || !container) return;

          void loadSearchItems();
          closeAllDropdowns();
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          requestAnimationFrame(() => {
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
            container.classList.remove('scale-95');
            container.classList.add('scale-100');
          });
          if (input) {
            setTimeout(() => {
              input.focus();
              input.select();
            }, 60);
          }
        }

        function closeSearchModal() {
          startLenis();
          const modal = document.getElementById('global-search-modal');
          const container = document.getElementById('global-search-container');
          if (!modal || !container) return;

          modal.classList.remove('opacity-100');
          modal.classList.add('opacity-0');
          container.classList.remove('scale-100');
          container.classList.add('scale-95');
          setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
          }, 180);
        }

        async function renderSearchResults(query: string) {
          const emptyState = document.getElementById('search-empty-state');
          const resultsList = document.getElementById('search-results-list');
          if (!emptyState || !resultsList) return;

          const trimmed = query.trim().toLowerCase();
          if (trimmed.length < 2) {
            emptyState.classList.remove('hidden');
            resultsList.classList.add('hidden');
            resultsList.innerHTML = '';
            activeResultIndex = -1;
            return;
          }

          const items = await loadSearchItems();
          const filtered = items.filter((item) => {
            const matchesCategory = currentSearchCategory === 'all' || item.category === currentSearchCategory || item.category === 'all';
            const matchesQuery = item.title.toLowerCase().includes(trimmed) || item.tag.toLowerCase().includes(trimmed);
            return matchesCategory && matchesQuery;
          });

          emptyState.classList.add('hidden');
          resultsList.classList.remove('hidden');

          if (filtered.length === 0) {
            resultsList.innerHTML = `
              <div class="py-8 text-center text-muted text-body-sm">
                <p>No results found for "${query}"</p>
                <p class="text-caption-xs mt-1 text-muted/70">Try searching for UPSC, SSC, RRB, or an official portal</p>
              </div>
            `;
            activeResultIndex = -1;
            return;
          }

          resultsList.innerHTML = filtered.map((item, idx) => `
            <a 
              href="${item.href}" 
              target="_blank"
              rel="noopener"
              data-astro-prefetch="false"
              data-result-index="${idx}"
              class="search-result-row flex items-center justify-between p-3 rounded-xl bg-surface-raised/40 hover:bg-surface-raised border border-border/40 hover:border-accent/40 transition group cursor-pointer"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-lg shrink-0">${item.icon}</span>
                <div class="truncate">
                  <p class="text-body-sm font-semibold text-heading group-hover:text-accent transition truncate">${item.title}</p>
                  <p class="text-[11px] text-muted truncate">${item.tag} • ${siteDomain}</p>
                </div>
              </div>
              <svg class="w-4 h-4 text-muted group-hover:text-accent shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          `).join('');

          activeResultIndex = 0;
          highlightActiveResult();
        }

        function highlightActiveResult() {
          const rows = document.querySelectorAll<HTMLElement>('.search-result-row');
          rows.forEach((row, i) => {
            if (i === activeResultIndex) {
              row.classList.add('bg-surface-raised', 'border-accent/60', 'ring-1', 'ring-accent/40');
              row.scrollIntoView({ block: 'nearest' });
            } else {
              row.classList.remove('bg-surface-raised', 'border-accent/60', 'ring-1', 'ring-accent/40');
            }
          });
        }

        // --- Central Event Delegation on Document (Guarantees No Auto-Close or Duplicates) ---
        function handleGlobalClick(e: MouseEvent) {
          const target = e.target as HTMLElement;

          // 1. Profile Trigger Clicked
          const trigger = target.closest('[data-profile-trigger]') as HTMLElement | null;
          if (trigger) {
            e.preventDefault();
            e.stopPropagation();

            const dropdownId = trigger.getAttribute('data-profile-trigger');
            if (!dropdownId) return;

            const dropdown = document.getElementById(dropdownId);
            if (!dropdown) return;

            const isAlreadyOpen = !dropdown.classList.contains('hidden') && dropdown.classList.contains('opacity-100');

            if (isAlreadyOpen) {
              closeDropdown(dropdown);
              trigger.setAttribute('aria-expanded', 'false');
            } else {
              closeAllDropdowns(dropdown);
              openDropdown(dropdown, trigger);
            }
            return;
          }

          // Language button clicked anywhere (header, mobile drawer, profile dropdown)
          const appLangBtn = target.closest('[data-app-lang]');
          if (appLangBtn) {
            e.preventDefault();
            e.stopPropagation();
            const chosen = appLangBtn.getAttribute('data-app-lang') || 'hinglish';
            setLanguage(chosen, true);
            return;
          }

          // Theme toggle button clicked anywhere (header, mobile drawer, profile dropdown)
          const themeBtn = target.closest('.theme-toggle-btn');
          if (themeBtn) {
            e.preventDefault();
            e.stopPropagation();
            toggleTheme();
            return;
          }

          // 2. Clicked Inside Profile Dropdown
          const dropdownMenu = target.closest('[role="menu"]');
          if (dropdownMenu) {

            // Logout action clicked
            if (target.closest('[data-auth-action="logout"]')) {
              e.preventDefault();
              e.stopPropagation();
              try { localStorage.removeItem('auth_active'); } catch (e) {}
              const apiUrl = API_URL;
              void fetch(`${apiUrl}/auth/logout`, {
                method: 'POST',
                priority: 'high',
                credentials: 'include',
                headers: { 'X-CSRF-Protection': '1' },
              } as any).finally(() => window.location.assign('/login'));
              return;
            }

            // Other links inside dropdown
            if (target.closest('a')) {
              closeAllDropdowns();
            }
            return;
          }

          // 3. Desktop or Toolbar Sidebar Collapse / Reopen Clicked
          const sidebarToggleBtn = target.closest('[data-sidebar-toggle], [data-sidebar-collapse], #collapsed-sidebar-reopen-pill');
          if (sidebarToggleBtn) {
            e.preventDefault();
            e.stopPropagation();
            toggleDesktopSidebar();
            return;
          }

          // 4. Notifications Popup Toggle / Interactions
          const notifTrigger = target.closest('[data-notification-trigger]');
          if (notifTrigger) {
            e.preventDefault();
            e.stopPropagation();
            if (window.innerWidth < 1024) {
              closeAllDropdowns();
              void import('astro:transitions/client').then(({ navigate }) => navigate('/notifications')).catch(() => {
                window.location.href = '/notifications';
              });
              return;
            }
            const targetId = notifTrigger.getAttribute('data-notification-trigger');
            const notifPopup = targetId ? document.getElementById(targetId) : null;
            if (notifPopup) {
              const isOpen = !notifPopup.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                void import('../lib/notifications').then(({ updateBrowserNotificationUI }) => updateBrowserNotificationUI());
                notifPopup.classList.remove('hidden');
                requestAnimationFrame(() => {
                  notifPopup.classList.remove('scale-95', 'opacity-0');
                  notifPopup.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const closeNotifBtn = target.closest('[data-close-notifications]');
          if (closeNotifBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeAllDropdowns();
            return;
          }

          const enableBrowserBtn = target.closest('[data-enable-browser-notifications]');
          if (enableBrowserBtn) {
            e.preventDefault();
            e.stopPropagation();
            void import('../lib/notifications').then(({ requestBrowserNotificationPermission }) => requestBrowserNotificationPermission());
            return;
          }

          const dismissNotifBtn = target.closest('[data-dismiss-notification]');
          if (dismissNotifBtn) {
            e.preventDefault();
            e.stopPropagation();
            const notificationId = dismissNotifBtn.getAttribute('data-dismiss-notification');
            if (notificationId) {
              void import('../lib/notifications').then(({ markNotificationRead }) => markNotificationRead(notificationId));
            }
            return;
          }

          const markAllReadBtn = target.closest('[data-mark-all-read]');
          if (markAllReadBtn) {
            e.preventDefault();
            e.stopPropagation();
            void import('../lib/notifications').then(({ markAllNotificationsRead }) => markAllNotificationsRead());
            return;
          }

          const notificationLink = target.closest('[data-notification-link]');
          if (notificationLink) {
            const notificationId = notificationLink.getAttribute('data-notification-link');
            if (notificationId) {
              void import('../lib/notifications').then(({ markNotificationRead }) => markNotificationRead(notificationId));
            }
          }

          // If clicked inside notifications popup, don't close
          if (target.closest('[data-notification-popup]')) {
            return;
          }

          // 5. Language Switcher Trigger & Selection
          const langBtn = target.closest('#header-language-btn');
          if (langBtn) {
            e.preventDefault();
            e.stopPropagation();
            const dropdown = document.getElementById('header-language-dropdown');
            if (dropdown) {
              const isOpen = !dropdown.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                dropdown.classList.remove('hidden');
                requestAnimationFrame(() => {
                  dropdown.classList.remove('scale-95', 'opacity-0');
                  dropdown.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const langOption = target.closest('[data-lang-option]');
          if (langOption) {
            e.preventDefault();
            e.stopPropagation();
            const chosenLang = langOption.getAttribute('data-lang-option') || 'en';
            setLanguage(chosenLang);
            closeAllDropdowns();
            return;
          }

          // 6. Favorites Button Trigger & Bookmarks Actions
          const favBtn = target.closest('#header-favorites-btn, [data-open-favorites]');
          if (favBtn) {
            e.preventDefault();
            e.stopPropagation();
            if (window.innerWidth < 1024) {
              closeAllDropdowns();
              void import('astro:transitions/client').then(({ navigate }) => navigate('/favorites')).catch(() => {
                window.location.href = '/favorites';
              });
              return;
            }
            const dropdown = document.getElementById('header-favorites-dropdown');
            if (dropdown) {
              const isOpen = !dropdown.classList.contains('hidden');
              closeAllDropdowns();
              if (!isOpen) {
                void import('../lib/bookmarks').then(({ updateFavoritesUI }) => updateFavoritesUI());
                dropdown.classList.remove('hidden');
                requestAnimationFrame(() => {
                  dropdown.classList.remove('scale-95', 'opacity-0');
                  dropdown.classList.add('scale-100', 'opacity-100');
                });
              }
            }
            return;
          }

          const closeFavBtn = target.closest('[data-close-favorites]');
          if (closeFavBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeAllDropdowns();
            return;
          }

          const removeFavBtn = target.closest('[data-remove-favorite], [data-remove-bookmark]') as HTMLElement | null;
          if (removeFavBtn) {
            e.preventDefault();
            e.stopPropagation();
            const slug = removeFavBtn.getAttribute('data-remove-favorite') || removeFavBtn.getAttribute('data-remove-bookmark');
            if (slug) {
              void import('../lib/bookmarks').then(({ removeBookmark }) => removeBookmark(slug));
            }
            return;
          }

          const clearFavBtn = target.closest('[data-clear-favorites], [data-clear-bookmarks]');
          if (clearFavBtn) {
            e.preventDefault();
            e.stopPropagation();
            void import('../lib/bookmarks').then(({ clearAllBookmarks }) => clearAllBookmarks());
            return;
          }

          // Favorite toggle (stored in localStorage without requiring login)
          const favoriteBtn = target.closest('[data-favorite-slug], [data-bookmark-slug]') as HTMLElement | null;
          if (favoriteBtn) {
            e.preventDefault();
            e.stopPropagation();

            const slug = favoriteBtn.getAttribute('data-favorite-slug') || favoriteBtn.getAttribute('data-bookmark-slug') || '';
            const title = favoriteBtn.getAttribute('data-favorite-title') || favoriteBtn.getAttribute('data-bookmark-title') || '';
            const category = favoriteBtn.getAttribute('data-favorite-category') || favoriteBtn.getAttribute('data-bookmark-category') || '';
            const url = favoriteBtn.getAttribute('data-favorite-url') || favoriteBtn.getAttribute('data-bookmark-url') || `/${slug}`;
            void import('../lib/bookmarks').then(({ toggleBookmark }) => {
              const isSaved = toggleBookmark({ slug, title, category, url });
              if (typeof (window as any).showGlobalToast === 'function') {
                (window as any).showGlobalToast(isSaved ? 'Article added to favorites' : 'Article removed from favorites');
              }
            });
            return;
          }

          // Article Share Button Trigger
          const shareBtn = target.closest('[data-share-btn], [data-share-url]') as HTMLElement | null;
          if (shareBtn) {
            e.preventDefault();
            e.stopPropagation();
            const shareUrl = shareBtn.getAttribute('data-share-url') || window.location.href;
            const shareTitle = shareBtn.getAttribute('data-share-title') || document.title;
            if (navigator.share) {
              navigator.share({ title: shareTitle, url: shareUrl }).catch(() => {});
            } else if (navigator.clipboard) {
              navigator.clipboard.writeText(shareUrl).then(() => {
                if (typeof (window as any).showGlobalToast === 'function') {
                  (window as any).showGlobalToast('Article link copied to clipboard!');
                }
              }).catch(() => {
                prompt('Copy article link:', shareUrl);
              });
            } else {
              prompt('Copy article link:', shareUrl);
            }
            return;
          }

          // If clicked inside language or favorites dropdown, don't close
          if (target.closest('#header-language-dropdown, #header-favorites-dropdown')) {
            return;
          }

          // 7. Open Global Search Modal Trigger
          const searchTrigger = target.closest('[data-open-search]');
          if (searchTrigger) {
            e.preventDefault();
            e.stopPropagation();
            openSearchModal();
            return;
          }

          // 8. Search Modal Close Button or Backdrop Clicked
          const searchModal = document.getElementById('global-search-modal');
          const searchCloseBtn = target.closest('#global-search-close-btn');
          if (searchCloseBtn || target === searchModal) {
            e.preventDefault();
            e.stopPropagation();
            closeSearchModal();
            return;
          }

          // Click on search result or quick access link
          if (target.closest('.search-result-row, .quick-access-chip')) {
            closeSearchModal();
          }

          // 9. Mobile Drawer Close Clicked
          const mobileCloseBtn = target.closest('[data-mobile-sidebar-close]');
          if (mobileCloseBtn) {
            e.preventDefault();
            e.stopPropagation();
            closeMobileDrawer();
            return;
          }

          // 10. Mobile Drawer Backdrop Clicked (overlay or backdrop wrapper)
          const backdrop = document.getElementById('mobile-sidebar-backdrop');
          const overlay = document.getElementById('mobile-backdrop-overlay');
          const container = document.getElementById('mobile-sidebar-container');
          if (backdrop && (target === backdrop || target === overlay) && !container?.contains(target)) {
            closeMobileDrawer();
            return;
          }

          // 11. Clicked Outside Everything: Close Dropdowns
          closeAllDropdowns();
        }

        // Keyboard Shortcuts
        function handleGlobalKeydown(e: KeyboardEvent) {
        const activeEl = document.activeElement;
        const isSearchModalOpen = !document.getElementById('global-search-modal')?.classList.contains('hidden');

        // Search modal specific keys (Arrow Navigation & Enter)
        if (isSearchModalOpen) {
          const rows = document.querySelectorAll<HTMLElement>('.search-result-row');
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (rows.length > 0) {
              activeResultIndex = (activeResultIndex + 1) % rows.length;
              highlightActiveResult();
            }
            return;
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (rows.length > 0) {
              activeResultIndex = (activeResultIndex - 1 + rows.length) % rows.length;
              highlightActiveResult();
            }
            return;
          }
          if (e.key === 'Enter') {
            if (activeResultIndex >= 0 && rows[activeResultIndex]) {
              e.preventDefault();
              rows[activeResultIndex].click();
            }
            return;
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            closeSearchModal();
            return;
          }
        }

        const isInput = activeEl && (
          activeEl.tagName === 'INPUT' || 
          activeEl.tagName === 'TEXTAREA' || 
          activeEl.getAttribute('contenteditable') === 'true'
        );

        // Alt+B / Ctrl+B / Cmd+B to toggle sidebar (Matches takeUforward)
        if ((e.altKey || e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
          e.preventDefault();
          toggleDesktopSidebar();
          return;
        }

        if (!isInput && e.key === '[') {
          e.preventDefault();
          toggleDesktopSidebar();
          return;
        }

        // Ctrl+K / Cmd+K to open search modal (Matches takeUforward)
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          openSearchModal();
          return;
        }

        if (e.key === 'Escape') {
          closeSearchModal();
          closeAllDropdowns();
          closeMobileDrawer();
          const wrapper = document.getElementById('desktop-sidebar-wrapper');
          wrapper?.classList.remove('hover-peek');
        }
      }

        async function syncAuthProfile() {
          if (window.location.search.includes('login=success')) {
            try { localStorage.setItem('auth_active', '1'); } catch (e) {}
            showGlobalToast('Welcome back! Successfully signed in.');
            try {
              const url = new URL(window.location.href);
              url.searchParams.delete('login');
              window.history.replaceState({}, document.title, url.pathname + (url.search || '') + (url.hash || ''));
            } catch (e) {}
          }

          const apiUrl = API_URL;
          const response = await fetch(`${apiUrl}/me`, { priority: 'low', credentials: 'include' } as any).catch(() => null);

          // If request was aborted (e.g. navigation in flight), network failed, or server had 5xx blip:
          // NEVER touch auth state or reset UI to logged-out. Keep optimistic state intact!
          if (!response || response.status >= 500) return;

          if (response.status === 401) {
            try {
              localStorage.removeItem('auth_active');
              localStorage.removeItem('auth_user');
            } catch (e) {}
          }

          const user = response.ok ? await response.json().catch(() => null) : null;
          const isUserLoggedIn = Boolean(user && user.id);

          if (isUserLoggedIn) {
            try {
              localStorage.setItem('auth_active', '1');
              localStorage.setItem('auth_user', JSON.stringify({
                id: user.id,
                name: user.name,
                email: user.email,
                role: user.role,
              }));
            } catch (e) {}
          } else if (response.status === 401 || (response.ok && !user)) {
            try {
              localStorage.removeItem('auth_active');
              localStorage.removeItem('auth_user');
            } catch (e) {}
          }

          const { refreshNotifications, requestBrowserNotificationPermission } = await import('../lib/notifications');
          if (isUserLoggedIn) {
            void refreshNotifications('session');

            if (!(window as any).__notifPollInterval) {
              (window as any).__notifPollInterval = setInterval(() => void refreshNotifications('session'), 45000);
            }
          } else {
            void refreshNotifications(null);
          }

          // Directly trigger native browser notification permission prompt on visit
          if (typeof window !== 'undefined' && 'Notification' in window && Notification.permission === 'default') {
            const promptDirect = () => {
              if (Notification.permission === 'default') {
                void requestBrowserNotificationPermission();
              }
            };

            // Attempt direct native browser permission dialog
            promptDirect();

            // Also attach to first user interaction on the page if browser requires user activation gesture
            const triggerOnGesture = () => {
              promptDirect();
              window.removeEventListener('pointerdown', triggerOnGesture);
              window.removeEventListener('keydown', triggerOnGesture);
              window.removeEventListener('touchstart', triggerOnGesture);
            };
            window.addEventListener('pointerdown', triggerOnGesture, { once: true, passive: true });
            window.addEventListener('keydown', triggerOnGesture, { once: true, passive: true });
            window.addEventListener('touchstart', triggerOnGesture, { once: true, passive: true });
          }

          const nameEls = document.querySelectorAll('.user-display-name');
          const emailEls = document.querySelectorAll('.user-display-email');
          const initialEls = document.querySelectorAll('.user-avatar-initials');
          const logoutBtns = document.querySelectorAll<HTMLElement>('.auth-logout-btn');
          const loginLinks = document.querySelectorAll<HTMLElement>('.auth-login-link');
          const adminPanelLinks = document.querySelectorAll<HTMLElement>('.admin-panel-link');

          if (isUserLoggedIn) {
            const fullName = (user.name || 'User').trim();
            const email = user.email || 'Account';
            const parts = fullName.split(/\s+/).filter(Boolean);
            const initials = parts.length > 1
              ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
              : (fullName.slice(0, 2)).toUpperCase() || 'U';

            const roleEls = document.querySelectorAll('.user-display-role');
            const formattedRole = user.role === 'admin' ? 'Administrator' : user.role === 'editor' ? 'Editor' : (user.role || 'Aspirant');
            roleEls.forEach(el => el.textContent = formattedRole);

            nameEls.forEach(el => el.textContent = fullName);
            emailEls.forEach(el => el.textContent = email);
            initialEls.forEach(el => {
              el.textContent = initials;
              el.classList.remove('hidden');
            });

            adminPanelLinks.forEach((link) => {
              const canAccess = user.role === 'admin' || user.role === 'editor';
              link.classList.toggle('hidden', !canAccess);
              link.style.display = canAccess ? 'flex' : 'none';
            });

            logoutBtns.forEach((b) => {
              b.classList.remove('hidden');
              b.style.display = 'flex';
            });
            loginLinks.forEach((l) => {
              l.classList.add('hidden');
              l.style.display = 'none';
            });

            // Set authenticated attribute and expose global user state
            document.documentElement.setAttribute('data-authenticated', 'true');
            (window as any).__currentUser = user;

            document.querySelectorAll<HTMLElement>('.auth-logged-in-only').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });

            // Show Logged In Profile UI in Sidebar & Header, HIDE Logged Out CTA (Get Started button)
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.classList.add('flex');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.classList.remove('flex');
              el.style.display = 'none';
            });
            window.dispatchEvent(new CustomEvent('auth:change', { detail: { user } }));
          } else if (response.status === 401 || (response.ok && !user)) {
            document.documentElement.removeAttribute('data-authenticated');
            (window as any).__currentUser = null;

            document.querySelectorAll<HTMLElement>('.auth-logged-in-only').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });

            nameEls.forEach(el => el.textContent = 'Guest User');
            emailEls.forEach(el => el.textContent = 'Sign in to access your profile');
            initialEls.forEach(el => {
              el.textContent = 'GU';
              el.classList.remove('hidden');
            });
            adminPanelLinks.forEach((link) => {
              link.classList.add('hidden');
              link.style.display = 'none';
            });

            logoutBtns.forEach((b) => {
              b.classList.add('hidden');
              b.style.display = 'none';
            });
            loginLinks.forEach((l) => {
              l.classList.remove('hidden');
              l.style.display = 'flex';
            });

            // Show Logged Out UI in Sidebar & Header, HIDE Profile Card & Profile Icon
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-in').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-out').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-in').forEach(el => {
              el.classList.add('hidden');
              el.classList.remove('flex');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-out').forEach(el => {
              el.classList.remove('hidden');
              el.classList.add('flex');
              el.style.display = '';
            });
            window.dispatchEvent(new CustomEvent('auth:change', { detail: { user: null } }));
          }
        }

        let toastTimer: any = null;
        function showGlobalToast(message: string, actionLabel?: string, actionHref?: string) {
          const toast = document.getElementById('global-toast');
          const msgEl = document.getElementById('global-toast-msg');
          const actionEl = document.getElementById('global-toast-action') as HTMLAnchorElement | null;
          if (!toast || !msgEl) return;

          msgEl.textContent = message;
          if (actionEl && actionLabel && actionHref) {
            actionEl.textContent = actionLabel;
            actionEl.href = actionHref;
            actionEl.classList.remove('hidden');
            actionEl.style.display = 'inline-flex';
          } else if (actionEl) {
            actionEl.classList.add('hidden');
            actionEl.style.display = 'none';
          }

          toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
          toast.classList.add('translate-y-0', 'opacity-100');

          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.remove('translate-y-0', 'opacity-100');
          }, 4500);
        }

        (window as any).showGlobalToast = showGlobalToast;

        function updateSidebarActiveLinks() {
          const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
          const navItems = document.querySelectorAll<HTMLAnchorElement>('.sidebar-nav-item');

          navItems.forEach((link) => {
            const rawHref = (link.getAttribute('href') || '').trim();
            const isAnchor = rawHref.includes('#');
            const isExternal = link.getAttribute('target') === '_blank' || rawHref.startsWith('http://') || rawHref.startsWith('https://');
            const isSocial = isExternal || rawHref.includes('wa.me') || rawHref.includes('t.me');

            if (isSocial || !rawHref) {
              return;
            }

            const linkPath = rawHref.split('#')[0].replace(/\/$/, '') || '/';

            let isActive = false;
            if (rawHref === '/') {
              isActive = currentPath === '/';
            } else if (!isAnchor && linkPath !== '/') {
              isActive = currentPath === linkPath || currentPath.startsWith(linkPath + '/');
            }

            const svg = link.querySelector('svg');

            if (isActive) {
              link.classList.add('bg-accent/10', 'text-accent', 'font-semibold', 'border', 'border-accent/20');
              link.classList.remove('text-muted', 'hover:text-white', 'hover:bg-surface-raised');
              if (svg && !svg.classList.contains('text-[#25D366]') && !svg.classList.contains('text-[#2AABEE]')) {
                svg.classList.add('text-accent');
                svg.classList.remove('text-muted');
              }
            } else {
              link.classList.remove('bg-accent/10', 'text-accent', 'font-semibold', 'border', 'border-accent/20');
              link.classList.add('text-muted', 'hover:text-white', 'hover:bg-surface-raised');
              if (svg && !svg.classList.contains('text-[#25D366]') && !svg.classList.contains('text-[#2AABEE]')) {
                svg.classList.remove('text-accent');
              }
            }
          });
        }

        function syncLoginLinks() {
          const path = window.location.pathname;
          if (path === '/login' || path === '/signup' || path.startsWith('/auth/') || path === '/logout') return;
          const here = `${path}${window.location.search}${window.location.hash}`;
          if (!here || here === '/') {
            document.querySelectorAll<HTMLAnchorElement>('a[data-login-link], a.auth-login-link, a#header-login-btn').forEach(link => {
              if (link.getAttribute('href')?.startsWith('/login')) {
                link.href = '/login';
              }
            });
            return;
          }
          const targetHref = `/login?redirect=${encodeURIComponent(here)}`;
          document.querySelectorAll<HTMLAnchorElement>('a[data-login-link], a.auth-login-link, a#header-login-btn').forEach(link => {
            link.href = targetHref;
          });
        }

        function reinitPageElements() {
          // Initialize Lenis smooth scroll
          initLenis({ headerOffset: -70 });

          // Instantly show logged-in shell from cache — zero network, zero delay
          applyOptimisticAuth();

          // Sync login buttons with current return URL
          syncLoginLinks();

          // Sync sidebar active links
          updateSidebarActiveLinks();

          // Restore Collapsed State
          const savedCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
          setSidebarCollapsed(savedCollapsed, true);

          // Sync theme UI toggle knobs (Default is LIGHT)
          const initialIsLight = !document.documentElement.classList.contains('theme-dark');
          updateAllThemeToggles(initialIsLight);

          // Sync language toggle with rendered content (fixes EN toggle + Hinglish body)
          const preferred = normalizeAppLang(
            localStorage.getItem('preferred_exam_lang')
              || localStorage.getItem('site_language')
              || 'hinglish',
          );
          const displayedArticleLang = getDisplayedArticleLang();
          const urlLangRaw = new URLSearchParams(window.location.search).get('lang');
          const hasExplicitUrlLang = urlLangRaw != null && urlLangRaw !== '';

          if (displayedArticleLang) {
            if (hasExplicitUrlLang) {
              // Explicit ?lang= wins — sync preference to match URL/content
              setLanguage(displayedArticleLang, false);
            } else {
              setLanguage(displayedArticleLang, false);
              if (preferred !== displayedArticleLang) {
                void import('../lib/article-lang-swap').then(({ canSwapArticleLanguage }) => {
                  if (canSwapArticleLanguage(preferred)) {
                    setLanguage(preferred, true);
                  }
                });
              }
            }
          } else {
            setLanguage(preferred, false);
          }



          // Search Input & Tab Listeners
          const globalSearchInput = document.getElementById('global-search-input') as HTMLInputElement | null;
          if (globalSearchInput) {
            globalSearchInput.oninput = (e) => {
              renderSearchResults((e.target as HTMLInputElement).value);
            };
          }

          document.querySelectorAll<HTMLElement>('.search-tab').forEach((tab) => {
            tab.onclick = () => {
              document.querySelectorAll('.search-tab').forEach((t) => {
                t.classList.remove('bg-surface-raised', 'text-accent', 'border', 'border-border', 'font-semibold');
                t.classList.add('text-muted');
              });
              tab.classList.remove('text-muted');
              tab.classList.add('bg-surface-raised', 'text-accent', 'border', 'border-border', 'font-semibold');
              currentSearchCategory = tab.getAttribute('data-category') || 'all';
              if (globalSearchInput) {
                renderSearchResults(globalSearchInput.value);
              }
            };
          });

          const hasSavedFavorites = (function() {
            try {
              return !!(localStorage.getItem('exam_saved_favorites') || localStorage.getItem('exam_saved_bookmarks'));
            } catch (e) {
              return false;
            }
          })();

          if (hasSavedFavorites) {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(() => {
                void import('../lib/bookmarks').then(({ updateFavoritesUI }) => updateFavoritesUI());
              }, { timeout: 3000 });
            } else {
              setTimeout(() => {
                void import('../lib/bookmarks').then(({ updateFavoritesUI }) => updateFavoritesUI());
              }, 2000);
            }
          }
          queueSyncAuthProfile();
        }

        /**
         * Instant optimistic auth: reads localStorage/cookie without any network call.
         * Shows the logged-in header/sidebar shell in <1ms so there's zero visible flash.
         * The real fetch in syncAuthProfile() will correct it if the session has expired.
         */
        /**
         * Instant optimistic auth: reads localStorage/cookie without any network call.
         * Shows the logged-in header/sidebar shell in <1ms so there's zero visible flash.
         * The real fetch in syncAuthProfile() will correct it if the session has expired.
         */
        function applyOptimisticAuth() {
          let isLoggedIn = false;
          try {
            const hasLoginSuccess = typeof window !== 'undefined' && window.location.search.includes('login=success');
            isLoggedIn = hasLoginSuccess || localStorage.getItem('auth_active') === '1' || document.cookie.includes('logged_in=1');
          } catch (e) {}

          if (isLoggedIn) {
            document.querySelectorAll<HTMLElement>('.header-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.classList.add('flex');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.header-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.classList.remove('flex');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-in').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.sidebar-auth-logged-out').forEach(el => {
              el.classList.add('hidden');
              el.style.display = 'none';
            });
            document.querySelectorAll<HTMLElement>('.auth-logged-in-only').forEach(el => {
              el.classList.remove('hidden');
              el.style.display = '';
            });
            document.querySelectorAll<HTMLElement>('.auth-logout-btn').forEach(b => {
              b.classList.remove('hidden');
              b.style.display = 'flex';
            });
            document.querySelectorAll<HTMLElement>('.auth-login-link').forEach(l => {
              l.classList.add('hidden');
              l.style.display = 'none';
            });

            // Instant hydrate cached user initials and name to eliminate flash of guest profile
            try {
              const rawUser = localStorage.getItem('auth_user');
              if (rawUser) {
                const u = JSON.parse(rawUser);
                const fullName = (u.name || 'User').trim();
                const email = u.email || 'Account';
                const parts = fullName.split(/\s+/).filter(Boolean);
                const initials = parts.length > 1
                  ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
                  : (fullName.slice(0, 2)).toUpperCase() || 'U';

                const roleEls = document.querySelectorAll('.user-display-role');
                const formattedRole = u.role === 'admin' ? 'Administrator' : u.role === 'editor' ? 'Editor' : (u.role || 'Aspirant');
                roleEls.forEach(el => el.textContent = formattedRole);

                document.querySelectorAll('.user-display-name').forEach(el => el.textContent = fullName);
                document.querySelectorAll('.user-display-email').forEach(el => el.textContent = email);
                document.querySelectorAll('.user-avatar-initials').forEach(el => {
                  el.textContent = initials;
                  el.classList.remove('hidden');
                });
                if (u.role === 'admin' || u.role === 'editor') {
                  document.querySelectorAll<HTMLElement>('.admin-panel-link').forEach(link => {
                    link.classList.remove('hidden');
                    link.style.display = 'flex';
                  });
                }
              }
            } catch (e) {}
          }
        }

        let authProfileQueued = false;
        function queueSyncAuthProfile() {
          // API-host cookies are unreadable here in production; always verify the session.
          if (authProfileQueued) return;
          authProfileQueued = true;
          const run = () => {
            authProfileQueued = false;
            void syncAuthProfile();
          };
          // Fire immediately after layout paint — no artificial delay.
          // requestAnimationFrame chains twice to ensure DOM is stable before fetch.
          requestAnimationFrame(() => requestAnimationFrame(run));
        }

        // --- Global One-Time Event Listeners & Lifecycles ---
        if (!(window as any).__APP_GLOBAL_LISTENERS_INITIALIZED__) {
          (window as any).__APP_GLOBAL_LISTENERS_INITIALIZED__ = true;

          document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const link = target.closest('a[data-login-link], a.auth-login-link, a#header-login-btn, a[href^="/login"]');
            if (!(link instanceof HTMLAnchorElement)) return;
            const path = window.location.pathname;
            if (path === '/login' || path === '/signup' || path.startsWith('/auth/') || path === '/logout') return;
            const currentHref = link.getAttribute('href') || '';
            if (currentHref.includes('redirect=') || currentHref.includes('returnTo=')) return;
            const here = `${path}${window.location.search}${window.location.hash}`;
            if (here && here !== '/') {
              link.href = `/login?redirect=${encodeURIComponent(here)}`;
            }
          }, true);

          // Central Click Event Delegation
          document.addEventListener('click', handleGlobalClick);

          // Global Keyboard Shortcuts
          document.addEventListener('keydown', handleGlobalKeydown);

          // Reactive bookmarks event
          window.addEventListener('bookmarks-updated', () => {
            void import('../lib/bookmarks').then(({ updateFavoritesUI }) => updateFavoritesUI());
          });

          // Window language change event
          window.addEventListener('exam:language-change', ((e: CustomEvent) => {
            if (e.detail?.lang) setLanguage(e.detail.lang, false);
          }) as EventListener);

          // Apply optimistic auth to the newly swapped DOM immediately before browser paint
          document.addEventListener('astro:after-swap', () => {
            applyOptimisticAuth();
          });

          // Lenis smooth scroll and page elements re-init on EVERY page load / client transition
          document.addEventListener('astro:page-load', () => {
            reinitPageElements();
            requestAnimationFrame(() => document.documentElement.classList.add('sidebar-ready'));
          });
          document.addEventListener('astro:before-swap', () => {
            document.documentElement.classList.remove('sidebar-ready');
            destroyLenis();
            closeMobileDrawer();
          });

          // Dispatch astro:page-load so any components listening to it continue working seamlessly
          try {
            document.dispatchEvent(new Event('astro:page-load'));
          } catch (e) {}
        }

        // Run smoothly without blocking initial layout paint or causing forced reflow
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            requestAnimationFrame(reinitPageElements);
          }, { once: true });
        } else {
          requestAnimationFrame(reinitPageElements);
        }
      })();
    </script>
    <Analytics />
    <SpeedInsights />
  </body>
</html>
