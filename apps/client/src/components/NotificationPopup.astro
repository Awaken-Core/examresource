---
// NotificationPopup.astro - Notifications popover filled from the signed-in user's feed
interface Props {
  id?: string;
  prefix?: string;
}

const { id = "desktop-notification-popup", prefix = "desktop" } = Astro.props;
---

<div 
  id={id} 
  data-notification-popup
  data-notification-prefix={prefix}
  class={`hidden absolute ${
    prefix === 'mobile'
      ? 'left-0 bottom-full mb-2 w-full max-w-[280px]'
      : 'left-[calc(100%+14px)] bottom-0 w-84 sm:w-90'
  } bg-surface border border-border rounded-2xl shadow-elevated p-4 z-[9999] transition-all duration-150 transform scale-95 opacity-0 select-none`}
  role="dialog"
  aria-label="Notifications"
>
  <div class="flex items-center justify-between pb-3 border-b border-border/50">
    <h3 class="text-sm font-semibold text-white tracking-tight">Notifications</h3>
    <button 
      type="button" 
      data-close-notifications
      class="text-muted hover:text-white p-1 rounded-lg hover:bg-surface-raised transition cursor-pointer"
      title="Close notifications"
      aria-label="Close notifications"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="flex items-center justify-between py-2.5 text-xs">
    <div class="flex items-center gap-1.5 font-medium text-muted">
      <span>New</span>
      <span class="notification-badge-count px-1.5 py-0.5 rounded-full bg-surface-raised text-[10px] font-bold text-white border border-border/60 leading-none">
        0
      </span>
    </div>
    <button 
      type="button" 
      data-mark-all-read
      class="text-caption-xs text-muted hover:text-white hover:underline transition cursor-pointer font-medium"
    >
      Mark all as read
    </button>
  </div>

  {/* Browser / Device Alert Opt-In Banner */}
  <div data-browser-notification-prompt class="hidden mb-2.5 p-2.5 rounded-xl bg-accent/10 border border-accent/30 text-xs">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-sm shrink-0">🔔</span>
        <span class="text-[11px] text-white/90 font-medium leading-tight">Enable device alerts for new exams & results</span>
      </div>
      <button 
        type="button" 
        data-enable-browser-notifications
        class="px-2 py-1 rounded bg-accent text-on-accent text-[10px] font-bold hover:brightness-110 transition shrink-0 cursor-pointer"
      >
        Enable
      </button>
    </div>
  </div>

  <div data-notification-new class="space-y-2 mt-1 max-h-[380px] overflow-y-auto pr-1">
    <p class="text-xs text-muted py-2 text-center">Loading notifications...</p>
  </div>

  <div data-notification-caught-up class="hidden mt-3 flex items-center justify-center gap-2 py-4 px-3 rounded-xl bg-surface-raised/30 border border-border/30 text-muted text-xs">
    <div class="w-4 h-4 rounded-full bg-emerald-500/15 text-emerald-500 border border-emerald-500/30 flex items-center justify-center shrink-0">
      <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>
    <span class="font-medium text-muted">You're all caught up!</span>
  </div>
</div>
