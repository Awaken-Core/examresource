---
interface Props {
  items: { id: string; text: string }[];
}

const { items } = Astro.props;
---

<div class="my-6 p-4 sm:p-5 bg-blue-50/50 rounded-xl border border-blue-200/80 shadow-xs">
  <div class="flex items-center justify-between pb-3 border-b border-blue-200/60">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
      </svg>
      <h2 class="text-base font-bold text-slate-900 tracking-tight !my-0 !border-0 !p-0">Table of Contents</h2>
    </div>
    <span class="text-xs text-blue-800 font-medium bg-blue-100/70 px-2 py-0.5 rounded">Quick Navigation</span>
  </div>
  
  <ul class="mt-3.5 space-y-2 text-sm text-slate-700">
    {items.map((item, index) => (
      <li class="flex items-start gap-2 hover:text-blue-700 transition">
        <span class="text-blue-600 font-semibold text-xs mt-0.5">{index + 1}.</span>
        <a href={`#${item.id}`} class="hover:underline hover:text-blue-800 transition font-medium">
          {item.text}
        </a>
      </li>
    ))}
  </ul>
</div>
