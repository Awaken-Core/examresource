---
interface Props {
  activeTab: 'notifications' | 'bookmarks';
}

const { activeTab } = Astro.props;
---

<header class="mb-6 sm:mb-8">
  {/* Top Bar: Back Button, Title & Breadcrumb */}
  <div class="flex items-center justify-between gap-3 mb-4 sm:mb-5">
    <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
      <button
        type="button"
        id="activity-back-btn"
        class="w-9 h-9 flex items-center justify-center rounded-xl bg-surface border border-border hover:border-accent/40 text-muted hover:text-white transition-all duration-150 cursor-pointer shadow-2xs shrink-0 active:scale-95"
        title="Go back"
        aria-label="Go back to previous page"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div class="min-w-0">
        <h1 class="text-lg sm:text-2xl font-bold text-white tracking-tight leading-tight truncate">
          {activeTab === 'notifications' ? 'Notifications' : 'Saved Bookmarks'}
        </h1>
        <p class="text-xs text-muted leading-tight mt-0.5 truncate hidden xs:block">
          {activeTab === 'notifications' ? 'Exam alerts, admit card updates & announcements' : 'Important articles and notifications you have bookmarked'}
        </p>
      </div>
    </div>

    <a
      href="/"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface border border-border hover:border-accent/40 text-xs font-semibold text-muted hover:text-white transition-all shrink-0 shadow-2xs"
    >
      <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="hidden sm:inline">Explore Exams</span>
      <span class="sm:hidden">Home</span>
    </a>
  </div>

  {/* Segmented Navigation Tabs */}
  <nav 
    class="flex p-1 rounded-2xl bg-surface border border-border shadow-2xs" 
    aria-label="Notifications and Bookmarks navigation"
    role="tablist"
  >
    <a
      href="/notifications"
      role="tab"
      aria-selected={activeTab === 'notifications'}
      class={`flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150 select-none ${
        activeTab === 'notifications'
          ? 'bg-surface-raised text-white border border-border/80 shadow-xs'
          : 'text-muted hover:text-white hover:bg-surface-raised/40'
      }`}
    >
      <svg class={`w-4 h-4 shrink-0 transition-colors ${activeTab === 'notifications' ? 'text-accent' : 'text-muted'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <span>Notifications</span>
      <span class="notification-badge-count hidden px-1.5 py-0.5 rounded-full bg-accent text-[10px] font-bold text-white leading-none shadow-2xs">
        0
      </span>
    </a>

    <a
      href="/bookmarks"
      role="tab"
      aria-selected={activeTab === 'bookmarks'}
      class={`flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150 select-none ${
        activeTab === 'bookmarks'
          ? 'bg-surface-raised text-white border border-border/80 shadow-xs'
          : 'text-muted hover:text-white hover:bg-surface-raised/40'
      }`}
    >
      <svg class={`w-4 h-4 shrink-0 transition-colors ${activeTab === 'bookmarks' ? 'text-accent fill-accent/20' : 'text-muted'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
      </svg>
      <span>Saved Bookmarks</span>
      <span class="favorites-count-badge hidden px-1.5 py-0.5 rounded-full bg-accent text-[10px] font-bold text-white leading-none shadow-2xs">
        0
      </span>
    </a>
  </nav>
</header>

<script>
  function setupBackBtn() {
    const backBtn = document.getElementById('activity-back-btn');
    if (backBtn && !backBtn.hasAttribute('data-bound')) {
      backBtn.setAttribute('data-bound', 'true');
      backBtn.addEventListener('click', () => {
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/';
        }
      });
    }
  }

  setupBackBtn();
  document.addEventListener('astro:page-load', setupBackBtn);
</script>
