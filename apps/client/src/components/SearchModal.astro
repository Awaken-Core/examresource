---
import { siteDomain } from '../data/site';
// SearchModal.astro - Global Spotlight Search Dialog (Matching takeUforward Image 1)
---

<div 
  id="global-search-modal" 
  transition:persist="global-search-modal"
  class="fixed inset-0 z-[10000] hidden items-start justify-center pt-16 sm:pt-24 px-4 bg-black/70 backdrop-blur-sm transition-opacity duration-200 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-label="Global Search"
>
  <div 
    id="global-search-container"
    class="w-full max-w-2xl bg-surface border border-border/80 rounded-2xl shadow-elevated overflow-hidden transform scale-95 transition-all duration-200 select-none flex flex-col max-h-[80vh]"
  >
    {/* Search Input Bar */}
    <div class="p-4 border-b border-border/60 flex items-center gap-3 relative">
      <svg class="w-5 h-5 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        id="global-search-input"
        type="text" 
        placeholder={`Search anything on ${siteDomain}...`} 
        class="w-full bg-transparent text-heading placeholder:text-muted text-base sm:text-lg focus:outline-none focus:ring-0 border-none p-0 font-medium"
        autocomplete="off"
        spellcheck="false"
      />
      <button 
        id="global-search-close-btn"
        type="button"
        class="text-muted hover:text-heading p-1 rounded-lg hover:bg-surface-raised transition cursor-pointer shrink-0"
        aria-label="Close search"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* Category Tabs (Matching Image 1: All, Problems/Exams, Editorials/Admissions, Notes/Results, etc.) */}
    <div class="px-4 py-2 border-b border-border/40 flex items-center gap-2 overflow-x-auto scrollbar-none text-caption-sm font-medium">
      <button type="button" class="search-tab px-3 py-1.5 rounded-lg bg-surface-raised text-accent border border-border font-semibold cursor-pointer shrink-0" data-category="all">All</button>
      <button type="button" class="search-tab px-3 py-1.5 rounded-lg text-muted hover:text-heading hover:bg-surface-raised/50 transition cursor-pointer shrink-0" data-category="exams">Exams</button>
      <button type="button" class="search-tab px-3 py-1.5 rounded-lg text-muted hover:text-heading hover:bg-surface-raised/50 transition cursor-pointer shrink-0" data-category="admissions">Admissions</button>
      <button type="button" class="search-tab px-3 py-1.5 rounded-lg text-muted hover:text-heading hover:bg-surface-raised/50 transition cursor-pointer shrink-0" data-category="results">Results</button>
      <button type="button" class="search-tab px-3 py-1.5 rounded-lg text-muted hover:text-heading hover:bg-surface-raised/50 transition cursor-pointer shrink-0" data-category="admit-cards">Admit Cards</button>
      <button type="button" class="search-tab px-3 py-1.5 rounded-lg text-muted hover:text-heading hover:bg-surface-raised/50 transition cursor-pointer shrink-0" data-category="state">State Updates</button>
    </div>

    {/* Quick Access Section (Matching Image 1) */}
    <div class="px-4 pt-3 pb-2">
      <p class="text-[11px] font-semibold text-muted uppercase tracking-wider mb-2">Quick Access</p>
      <div class="flex flex-wrap gap-2" id="search-quick-access">
        <a href="/#important-links" class="quick-access-chip inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-raised/70 hover:bg-surface-raised border border-border/50 text-body-xs text-heading transition hover:border-accent/40">
          <span class="text-accent">🔗</span>
          <span>Official portals</span>
        </a>
        <a href="https://ssc.gov.in/" class="quick-access-chip inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-raised/70 hover:bg-surface-raised border border-border/50 text-body-xs text-heading transition hover:border-accent/40" rel="noopener noreferrer" target="_blank">
          <span>SSC</span>
        </a>
        <a href="https://www.upsc.gov.in/" class="quick-access-chip inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-raised/70 hover:bg-surface-raised border border-border/50 text-body-xs text-heading transition hover:border-accent/40" rel="noopener noreferrer" target="_blank">
          <span>UPSC</span>
        </a>
        <a href="/#faqs" class="quick-access-chip inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-raised/70 hover:bg-surface-raised border border-border/50 text-body-xs text-heading transition hover:border-accent/40">
          <span>Help and FAQs</span>
        </a>
      </div>
    </div>

    {/* Search Results / Content Area */}
    <div data-lenis-prevent class="p-4 flex-1 overflow-y-auto max-h-96 min-h-[220px] scrollbar-none flex flex-col justify-center items-center" id="search-results-area">
      {/* Empty State (Matching Image 1) */}
      <div id="search-empty-state" class="text-center py-8">
        <div class="w-12 h-12 rounded-2xl bg-surface-raised border border-border/60 mx-auto flex items-center justify-center text-muted mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h4 class="text-body-md font-semibold text-heading">Search anything</h4>
        <p class="text-caption-sm text-muted mt-1">Type at least 2 characters to begin search</p>
      </div>

      {/* Dynamic Results List */}
      <div id="search-results-list" class="w-full space-y-1.5 hidden">
        {/* Rendered via JS */}
      </div>
    </div>

    {/* Footer Shortcuts Guide (Exact Match to Image 1: ↑ ↓ MOVE, ↵ SELECT, ESC QUIT) */}
    <div class="px-4 py-2.5 bg-subtle/60 border-t border-border/60 flex items-center justify-between text-[11px] text-muted">
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-[10px] text-heading font-mono">↑</kbd>
          <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-[10px] text-heading font-mono">↓</kbd>
          <span>MOVE</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-[10px] text-heading font-mono">↵</kbd>
          <span>SELECT</span>
        </span>
      </div>
      <div class="flex items-center gap-1">
        <kbd class="px-1.5 py-0.5 rounded bg-surface border border-border text-[10px] text-heading font-mono">ESC</kbd>
        <span>QUIT</span>
      </div>
    </div>
  </div>
</div>
