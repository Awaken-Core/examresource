---
import ProfileDropdown from './ProfileDropdown.astro';
import Tooltip from './Tooltip.astro';
import NotificationPopup from './NotificationPopup.astro';

interface Props {
  prefix?: string;
  isMobileDrawer?: boolean;
}

const { prefix = "desktop", isMobileDrawer = false } = Astro.props;
---

<aside 
  id={`${prefix}-sidebar`} 
  class="w-64 bg-canvas border-r border-border h-screen md:h-[calc(100vh-2.25rem)] sticky top-0 md:top-9 flex flex-col justify-between shrink-0 select-none z-[1050] transition-all duration-300 overflow-visible"
>
  {/* Top Logo, Logoname & Collapse/Close Button in Sidebar */}
  <div>
    <div class="sidebar-header h-16 px-4 flex items-center justify-between border-b border-border/60">
      <a href="/" class="flex items-center gap-2.5 group truncate">
        <div class="w-7 h-7 rounded-lg bg-accent/15 border border-accent/30 flex items-center justify-center text-accent shrink-0 shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <div class="sidebar-text flex items-center truncate font-bold text-base tracking-tight text-white">
          <span>govtpariksha</span><span class="text-accent">.com</span>
        </div>
      </a>

      {isMobileDrawer ? (
        <button 
          id={`${prefix}-sidebar-close-btn`}
          data-mobile-sidebar-close
          type="button"
          class="text-muted hover:text-white p-1.5 rounded-lg hover:bg-surface-raised transition cursor-pointer"
          title="Close drawer"
          aria-label="Close navigation drawer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      ) : (
        <div class="relative group">
          <button 
            id={`${prefix}-sidebar-toggle-btn`} 
            data-sidebar-collapse
            type="button"
            class="text-muted hover:text-white p-1.5 rounded-lg hover:bg-surface-raised border border-border/60 hover:border-border transition cursor-pointer shrink-0 flex items-center justify-center"
            aria-label="Collapse sidebar (Alt+B)"
          >
            {/* ◫ icon matching reference */}
            <svg class="w-4 h-4 text-muted hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="2"/>
              <line x1="9" y1="3" x2="9" y2="21" stroke-width="2"/>
            </svg>
          </button>

          {/* Attached Tooltip */}
          <Tooltip text="Collapse sidebar" shortcut={['Alt', 'B']} position="bottom" />
        </div>
      )}
    </div>

    {/* Navigation Scrollable Body */}
    <nav class="p-3 space-y-6 overflow-y-auto max-h-[calc(100vh-220px)] scrollbar-none">
      
      {/* Group: Prep */}
      <div>
        <div class="sidebar-text flex items-center justify-between px-2 mb-2 text-caption-xs font-semibold text-accent uppercase tracking-wider">
          <span>Prep</span>
          <svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>

        <div class="space-y-1">
          {/* Dashboard (Active) */}
          <a 
            href="/" 
            class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl bg-surface-raised text-white font-semibold text-body-sm shadow-xs border border-border/40"
            title="Dashboard"
          >
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span class="sidebar-text truncate">Dashboard</span>
          </a>

          {/* Prep Hub */}
          <a 
            href="#quick-info" 
            class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium"
            title="Prep Hub"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span class="sidebar-text truncate">Prep Hub</span>
          </a>

          {/* Practice (Subtree) */}
          <div class="space-y-0.5">
            <div class="sidebar-nav-item flex items-center justify-between px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium cursor-pointer">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                <span class="sidebar-text truncate">Practice</span>
              </div>
              <svg class="sidebar-text w-3.5 h-3.5 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
              </svg>
            </div>

            {/* Tree branch links */}
            <div class="sidebar-text pl-8 pr-2 space-y-1 border-l border-border/40 ml-5 my-1">
              <a href="#important-dates" class="block py-1 text-caption-sm text-muted hover:text-white transition">Schedule</a>
              <a href="#selection-process" class="block py-1 text-caption-sm text-muted hover:text-white transition">Exam Process</a>
              <a href="#required-documents" class="block py-1 text-caption-sm text-muted hover:text-white transition">Verification Docs</a>
            </div>
          </div>

          {/* State Updates */}
          <a 
            href="#state-filter-widget" 
            class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium"
            title="State Updates"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="sidebar-text truncate">State Updates</span>
          </a>

          {/* Community */}
          <a 
            href="#faqs" 
            class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium"
            title="Community"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="sidebar-text truncate">Community</span>
          </a>
        </div>
      </div>

      {/* Group: Explore */}
      <div>
        <div class="sidebar-text flex items-center justify-between px-2 mb-2 text-caption-xs font-semibold text-muted uppercase tracking-wider">
          <span>Explore</span>
          <svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>

        <div class="space-y-1">
          <a href="#exams" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Exams">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a3 3 0 006 0M9 5a3 3 0 016 0M9 12h6m-6 4h6" /></svg>
            <span class="sidebar-text truncate">Exams</span>
          </a>
          <a href="#saved-questions" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Saved Questions">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4a2 2 0 012-2h8a2 2 0 012 2v18l-6-4-6 4V4z" /></svg>
            <span class="sidebar-text truncate">Saved Questions</span>
          </a>
          <a href="#reported-questions" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Reported Questions">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.3 3.7L2.6 17a2 2 0 001.7 3h15.4a2 2 0 001.7-3L13.7 3.7a2 2 0 00-3.4 0z" /></svg>
            <span class="sidebar-text truncate">Reported Questions</span>
          </a>
          <a href="#doubts" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Doubts">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10a4 4 0 118 0c0 3-4 3-4 6m0 3h.01M5 4H4a2 2 0 00-2 2v14l4-3h12a2 2 0 002-2V6a2 2 0 00-2-2h-1" /></svg>
            <span class="sidebar-text truncate">Doubts</span>
          </a>
          <a href="#gk-current-affairs" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="GK &amp; Current Affairs">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18" /></svg>
            <span class="sidebar-text truncate">GK &amp; Current Affairs</span>
          </a>
          <a href="#books" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Books">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19.5A2.5 2.5 0 016.5 17H20V4H6.5A2.5 2.5 0 004 6.5v13zm0 0A2.5 2.5 0 006.5 22H20v-5" /></svg>
            <span class="sidebar-text truncate">Books</span>
          </a>
        </div>
      </div>

      {/* Group: Tests */}
      <div>
        <div class="sidebar-text flex items-center justify-between px-2 mb-2 text-caption-xs font-semibold text-muted uppercase tracking-wider">
          <span>Tests</span>
          <svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
        <div class="space-y-1">
          <a href="#test-series" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Test Series">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h6m-7 0a2 2 0 00-2 2v13h12V7a2 2 0 00-2-2m-8 5h8m-8 4h8" /></svg>
            <span class="sidebar-text truncate">Test Series</span>
          </a>
          <a href="#live-tests-quizzes" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Live Tests &amp; Quizzes">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 9l1.5 1.5L11 8m2 2h4M7 14h10M12 18v3m-4 0h8" /></svg>
            <span class="sidebar-text truncate">Live Tests &amp; Quizzes</span>
          </a>
          <a href="#previous-year-papers" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Previous Year Papers">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 3h7l5 5v13H7V3zm7 0v5h5M10 13l-2 2 2 2m4-4l2 2-2 2" /></svg>
            <span class="sidebar-text truncate">Previous Year Papers</span>
          </a>
          <a href="#study-notes" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Study Notes">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a3 3 0 013-3h5v18H7a3 3 0 00-3 2V5zm16 0a3 3 0 00-3-3h-5v18h5a3 3 0 013 2V5z" /></svg>
            <span class="sidebar-text truncate">Study Notes</span>
            <span class="sidebar-text ml-auto rounded-md bg-orange-500 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white">NEW</span>
          </a>
          <a href="#practice" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Practice">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12a8 8 0 108-8M4 4v5h5M8 12h4V8" /></svg>
            <span class="sidebar-text truncate">Practice</span>
          </a>
          <a href="#free-quizzes" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Free Quizzes">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.5 9a2.5 2.5 0 014.9.7c0 1.8-2.4 2.1-2.4 3.8m0 3h.01" /></svg>
            <span class="sidebar-text truncate">Free Quizzes</span>
            <span class="sidebar-text ml-auto rounded-md bg-orange-500 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white">NEW</span>
          </a>
          <a href="#attempted-tests" class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium" title="Attempted Tests">
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12l2.5 2.5L16 9" /></svg>
            <span class="sidebar-text truncate">Attempted Tests</span>
          </a>
        </div>
      </div>

      {/* Group: Additionals */}
      <div>
        <div class="sidebar-text flex items-center justify-between px-2 mb-2 text-caption-xs font-semibold text-muted uppercase tracking-wider">
          <span>Additionals</span>
          <svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>

        <div class="space-y-1">
          {/* Blogs */}
          <a 
            href="/blog/java" 
            class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium"
            title="Blogs"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <span class="sidebar-text truncate">Blogs</span>
          </a>

          {/* Unlock */}
          <a 
            href="#important-links" 
            class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium"
            title="Unlock Direct Links"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span class="sidebar-text truncate">Unlock Direct Links</span>
          </a>

          {/* Dev Tools */}
          <a 
            href="/editor" 
            class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised/60 transition text-body-sm font-medium"
            title="Editor Tools"
          >
            <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span class="sidebar-text truncate">Editor Tools</span>
          </a>
        </div>
      </div>
    </nav>
  </div>

  {/* BOTTOM PROFILE / AUTH SECTION (Exact match to Image 2) */}
  <div class="p-3 border-t border-border/60 relative overflow-visible space-y-2">
    {/* Popover Dropdown (Positioned Bottom-Up) */}
    <ProfileDropdown id={`${prefix}-profile-dropdown`} position="bottom" />

    {/* Contact support & See plans and pricing links (Matches Image 2) */}
    <div class="space-y-0.5">
      <a 
        href="#support" 
        class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised transition text-body-sm font-medium"
        title="Contact support"
      >
        <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"/>
        </svg>
        <span class="sidebar-text truncate">Contact support</span>
      </a>

      <a 
        href="#pricing" 
        class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised transition text-body-sm font-medium"
        title="See plans and pricing"
      >
        <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="2" y="5" width="20" height="14" rx="2" stroke-width="2"/>
          <line x1="2" y1="10" x2="22" y2="10" stroke-width="2"/>
        </svg>
        <span class="sidebar-text truncate">See plans and pricing</span>
      </a>
    </div>

    {/* Logged Out State: Log in / Sign up Button (Exact match to Image 2) */}
    <div class="sidebar-auth-logged-out block">
      <a 
        href="/login" 
        class="flex items-center justify-center gap-2.5 w-full py-2.5 px-4 rounded-xl bg-surface-raised hover:bg-surface-elevated text-white font-semibold text-body-sm border border-border transition shadow-xs group"
        title="Log in / Sign up"
      >
        <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
        </svg>
        <span class="sidebar-text truncate">Log in / Sign up</span>
      </a>
    </div>

    {/* Logged In State: User Profile Card & Notification Pill (Exact match to Images 3 & 4) */}
    <div class="sidebar-auth-logged-in hidden space-y-2">
