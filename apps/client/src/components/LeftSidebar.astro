---
import ProfileDropdown from './ProfileDropdown.astro';
import Tooltip from './Tooltip.astro';
import NotificationPopup from './NotificationPopup.astro';
import BrandLogo from './BrandLogo.astro';
import { telegramChannel, whatsappChannel, siteDomain } from '../data/site';

interface Props {
  prefix?: string;
  isMobileDrawer?: boolean;
  isEditorialTheme?: boolean;
}

const { prefix = "desktop", isMobileDrawer = false, isEditorialTheme = false } = Astro.props;
const [brandPrefix, ...brandRest] = siteDomain.split('.');
const brandSuffix = brandRest.length > 0 ? `.${brandRest.join('.')}` : '';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isBlogs = currentPath === '/blogs' || currentPath.startsWith('/blogs/');
const isTestSeries = currentPath.startsWith('/test-series');
const currentSearch = Astro.url.search || '';
const isAuthPage = currentPath === '/login' || currentPath === '/signup' || currentPath.startsWith('/auth/');
const loginHref = (!isAuthPage && currentPath !== '/')
  ? `/login?redirect=${encodeURIComponent(`${currentPath}${currentSearch}`)}`
  : '/login';
---

<aside 
  id={`${prefix}-sidebar`} 
  class={`w-64 ${
    isEditorialTheme 
      ? 'bg-editorial-bg border-r border-editorial-border text-editorial-text font-[\'Geist\']' 
      : 'bg-canvas border-r border-border/80 text-heading'
  } sticky top-0 h-screen flex flex-col justify-between shrink-0 select-none z-[1050] transition-all duration-300 overflow-visible`}
>
  {/* Top Section Header & Collapse Button (Logo is in main header) */}
  <div>
    <div class={`sidebar-header h-14 sm:h-16 px-4 flex items-center justify-between border-b ${isEditorialTheme ? 'border-editorial-border' : 'border-border/70'}`}>
      <span class="sidebar-text text-[11px] font-semibold tracking-wider uppercase text-editorial-muted font-['Geist']">
        Navigation
      </span>
      <div class="relative group">
        <button 
          id={`${prefix}-sidebar-toggle-btn`} 
          data-sidebar-collapse
          type="button"
          class={`w-8 h-8 ${
            isEditorialTheme 
              ? 'text-editorial-muted hover:text-editorial-heading hover:bg-editorial-accent-soft border-editorial-border hover:border-editorial-accent/40' 
              : 'text-muted hover:text-heading hover:bg-surface-raised border-border/70 hover:border-accent/30'
          } rounded-lg border transition cursor-pointer shrink-0 flex items-center justify-center focus-visible:outline-2 focus-visible:outline-accent`}
          aria-label="Collapse sidebar (Alt+B)"
        >
          <svg class="w-4 h-4 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="2"/>
            <line x1="9" y1="3" x2="9" y2="21" stroke-width="2"/>
          </svg>
        </button>
        {/* Attached Tooltip */}
        <Tooltip text="Collapse sidebar" shortcut={['Alt', 'B']} position="bottom" />
      </div>
    </div>

    {/* Navigation */}
    <nav class="pt-3 px-3 pb-3 space-y-0.5 overflow-y-auto max-h-[calc(100vh-144px)] scrollbar-none" aria-label="Primary navigation">
      {/* 1. Blogs */}
      <a 
        href="/blogs" 
        aria-current={isBlogs ? 'page' : undefined}
        class={`sidebar-nav-item relative flex items-center gap-3 min-h-11 md:min-h-10 px-3 rounded-lg text-xs transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-accent ${
          isEditorialTheme
            ? isBlogs
              ? 'bg-editorial-accent-soft text-editorial-accent font-semibold border border-editorial-accent/30'
              : 'text-editorial-subheading hover:text-editorial-heading hover:bg-editorial-accent-soft/60 font-medium border border-transparent'
            : isBlogs 
              ? 'bg-accent/10 text-accent font-semibold border border-accent/25 before:absolute before:left-0 before:top-2.5 before:bottom-2.5 before:w-0.5 before:rounded-full before:bg-accent'
              : 'text-muted hover:text-heading hover:bg-surface-raised font-medium border border-transparent'
        }`}
        title="Blogs"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <span class="sidebar-text truncate">Blogs</span>
      </a>

      {/* 2. Latest updates */}
      <a 
        href="/blogs#latest-updates"
        class={`sidebar-nav-item flex items-center gap-3 min-h-11 md:min-h-10 px-3 rounded-lg ${
          isEditorialTheme 
            ? 'text-editorial-subheading hover:text-editorial-heading hover:bg-editorial-accent-soft/60' 
            : 'text-muted hover:text-heading hover:bg-surface-raised'
        } transition-colors duration-150 text-xs font-medium border border-transparent focus-visible:outline-2 focus-visible:outline-accent`}
        title="Latest updates"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span class="sidebar-text truncate">Latest Updates</span>
      </a>

      {/* 3. PYQs (Previous Year Questions) */}
      <a 
        href="/blogs#categories"
        class={`sidebar-nav-item flex items-center justify-between min-h-11 md:min-h-10 px-3 rounded-lg ${
          isEditorialTheme 
            ? 'text-editorial-subheading hover:text-editorial-heading hover:bg-editorial-accent-soft/60' 
            : 'text-muted hover:text-heading hover:bg-surface-raised'
        } transition-colors duration-150 text-xs font-medium group border border-transparent focus-visible:outline-2 focus-visible:outline-accent`}
        title="Previous Year Questions (PYQs)"
      >
        <div class="flex items-center gap-3 min-w-0">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span class="sidebar-text truncate">PYQs</span>
        </div>
        <svg class={`w-3.5 h-3.5 ${isEditorialTheme ? 'text-editorial-muted/70 group-hover:text-editorial-heading' : 'text-muted/70 group-hover:text-heading'} transition-transform`} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      {/* 3b. Test Series */}
      <a 
        href="/test-series" 
        class={`sidebar-nav-item relative flex items-center gap-3 min-h-11 md:min-h-10 px-3 rounded-lg text-xs transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-accent ${
          isEditorialTheme
            ? isTestSeries
              ? 'bg-editorial-accent-soft text-editorial-accent font-semibold border border-editorial-accent/30'
              : 'text-editorial-subheading hover:text-editorial-heading hover:bg-editorial-accent-soft/60 font-medium border border-transparent'
            : isTestSeries 
              ? 'bg-accent/10 text-accent font-semibold border border-accent/25 before:absolute before:left-0 before:top-2.5 before:bottom-2.5 before:w-0.5 before:rounded-full before:bg-accent'
              : 'text-muted hover:text-heading hover:bg-surface-raised font-medium border border-transparent'
        }`}
        title="Test Series & Mock Tests"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
        <span class="sidebar-text truncate">Test Series</span>
      </a>

      {/* Channels Section */}
      <div class={`pt-3 border-t ${isEditorialTheme ? 'border-editorial-border' : 'border-border/60'} mt-2.5 space-y-0.5`}>
        <p class={`sidebar-text px-3.5 mb-2 text-[10px] font-bold uppercase tracking-[0.16em] ${isEditorialTheme ? 'text-editorial-muted' : 'text-muted/80'}`}>Channels</p>
        <a 
          href={whatsappChannel} 
          target="_blank" 
          rel="noopener noreferrer"
          class={`flex items-center gap-3 min-h-11 md:min-h-10 px-3 rounded-lg ${isEditorialTheme ? 'text-editorial-subheading hover:text-editorial-heading hover:bg-editorial-accent-soft/60' : 'text-muted hover:text-heading hover:bg-surface-raised'} transition-colors duration-150 text-xs font-medium group border border-transparent focus-visible:outline-2 focus-visible:outline-[#25D366]`}
          title="WhatsApp Channel"
        >
          <svg class="w-[18px] h-[18px] shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span class="sidebar-text truncate">WhatsApp</span>
        </a>
        <a 
          href={telegramChannel} 
          target="_blank" 
          rel="noopener noreferrer"
          class={`flex items-center gap-3 min-h-11 md:min-h-10 px-3 rounded-lg ${isEditorialTheme ? 'text-editorial-subheading hover:text-editorial-heading hover:bg-editorial-accent-soft/60' : 'text-muted hover:text-heading hover:bg-surface-raised'} transition-colors duration-150 text-xs font-medium group border border-transparent focus-visible:outline-2 focus-visible:outline-[#2AABEE]`}
          title="Telegram Channel"
        >
          <svg class="w-[18px] h-[18px] shrink-0 text-[#2AABEE]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span class="sidebar-text truncate">Telegram</span>
        </a>
      </div>
    </nav>
  </div>

  {/* BOTTOM PROFILE / AUTH SECTION */}
  <div class={`p-3 border-t ${isEditorialTheme ? 'border-editorial-border bg-editorial-bg' : 'border-border/70 bg-surface/25'} relative overflow-visible space-y-2`}>
    {/* Popover Dropdown */}
    <ProfileDropdown id={`${prefix}-profile-dropdown`} position={isMobileDrawer ? 'mobile' : 'bottom'} />

    {/* Quick Preferences: Theme & Language */}
    <div class="sidebar-preferences sidebar-text space-y-2">
      <div class={`flex items-center justify-between gap-2 min-h-11 md:min-h-10 px-2.5 rounded-xl ${isEditorialTheme ? 'bg-editorial-surface border-editorial-border' : 'bg-surface-raised/45 border-border/60 hover:border-border'} border transition-colors`}>
        <span class={`text-[12px] font-medium ${isEditorialTheme ? 'text-editorial-muted' : 'text-muted'} flex items-center gap-2`}>
          <svg class={`w-3.5 h-3.5 ${isEditorialTheme ? 'text-editorial-accent' : 'text-accent'} shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span>Language</span>
        </span>
        <div class={`inline-flex items-center p-0.5 ${isEditorialTheme ? 'bg-editorial-bg border-editorial-border' : 'bg-canvas border-border'} border rounded-lg text-xs font-semibold select-none`} role="group" aria-label="Language selection">
          <button
            type="button"
            data-app-lang="hinglish"
            class="app-lang-btn px-2.5 py-0.5 rounded-md text-[10px] font-bold cursor-pointer transition-colors"
            title="Switch to Hinglish"
            aria-pressed="true"
          >
            HI
          </button>
          <button
            type="button"
            data-app-lang="en"
            class="app-lang-btn px-2.5 py-0.5 rounded-md text-[10px] font-semibold cursor-pointer transition-colors"
            title="Switch to English"
            aria-pressed="false"
          >
            EN
          </button>
        </div>
      </div>

      <div class={`flex items-center justify-between gap-2 min-h-11 md:min-h-10 px-2.5 rounded-xl ${isEditorialTheme ? 'bg-editorial-surface border-editorial-border' : 'bg-surface-raised/45 border-border/60 hover:border-border'} border transition-colors`}>
        <span class={`text-[12px] font-medium ${isEditorialTheme ? 'text-editorial-muted' : 'text-muted'} flex items-center gap-2`}>
          <svg class={`w-3.5 h-3.5 ${isEditorialTheme ? 'text-editorial-accent' : 'text-accent'} shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span>Theme</span>
        </span>
        <button
          type="button"
          class="theme-toggle-btn relative w-13 h-7 bg-canvas border border-border rounded-full p-0.5 flex items-center cursor-pointer transition-colors focus:outline-none shrink-0"
          title="Toggle Dark and Light Mode"
          aria-label="Toggle Dark and Light Mode"
        >
          <span
            class="theme-toggle-knob w-5 h-5 rounded-full bg-surface border border-border text-accent flex items-center justify-center text-xs shadow-2xs transition-transform duration-200 translate-x-0.5"
          >
            <span class="light-icon text-[11px] select-none leading-none">☀️</span>
            <span class="dark-icon text-[11px] select-none leading-none hidden">🌙</span>
          </span>
        </button>
      </div>
    </div>

    {/* Logged Out State */}
    <div class="sidebar-auth-logged-out block">
      <a 
        href={loginHref}
        data-login-link
        class={`auth-login-link flex items-center justify-center gap-2 w-full min-h-11 md:min-h-10 px-4 rounded-xl ${
          isEditorialTheme
            ? 'bg-editorial-accent hover:bg-editorial-accent-hover text-white border border-editorial-accent'
            : 'bg-accent hover:bg-accent/90 text-white border border-accent'
        } font-semibold text-xs transition-colors shadow-sm group focus-visible:outline-2 focus-visible:outline-accent`}
        title="Log in / Sign up"
      >
        <svg class="w-4 h-4 text-white/80 group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
        </svg>
        <span class="sidebar-text truncate">Log in / Sign up</span>
      </a>
    </div>

    {/* Logged In State */}
    <div class="sidebar-auth-logged-in hidden space-y-2">
      {/* Notification Pill Button */}
      <div class="relative">
        <button 
          id={`${prefix}-notification-trigger`}
          data-notification-trigger={`${prefix}-notification-popup`}
          type="button"
          class={`sidebar-notification-pill-btn w-full px-3 py-2.5 rounded-xl ${
            isEditorialTheme 
              ? 'bg-editorial-surface hover:bg-editorial-accent-soft border-editorial-border text-editorial-text' 
              : 'bg-surface-raised/50 hover:bg-surface-raised border-border/60 text-heading'
          } border transition flex items-center justify-between text-xs cursor-pointer text-left group`}
          title="Open Notifications"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <svg class={`w-4 h-4 ${isEditorialTheme ? 'text-editorial-accent' : 'text-accent'} shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span class={`sidebar-text truncate text-xs font-medium ${isEditorialTheme ? 'text-editorial-text' : 'text-muted'} notification-pill-text`}>You have notifications</span>
          </div>
          <span class={`sidebar-text notification-pill-badge px-2 py-0.5 rounded-full ${
            isEditorialTheme
              ? 'bg-editorial-accent-soft text-editorial-accent border border-editorial-accent/30'
              : 'bg-accent/15 text-accent border border-accent/30'
          } text-[10px] font-bold leading-none`}>
            0
          </span>
        </button>

        {/* Notification Popup */}
        <NotificationPopup id={`${prefix}-notification-popup`} prefix={prefix} />
      </div>

      <button 
        id={`${prefix}-profile-trigger`}
        data-profile-trigger={`${prefix}-profile-dropdown`}
        type="button"
        class={`sidebar-profile-card w-full flex items-center justify-between p-2.5 rounded-xl ${
          isEditorialTheme
            ? 'bg-editorial-surface hover:bg-editorial-accent-soft border-editorial-border'
            : 'bg-surface-raised/40 hover:bg-surface-raised border-border/50 hover:border-border'
        } border transition-all duration-150 cursor-pointer group text-left`}
        aria-haspopup="true"
        aria-expanded="false"
        title="User Profile & Settings"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          {/* Avatar Circle */}
          <div class={`w-9 h-9 rounded-full ${
            isEditorialTheme
              ? 'bg-editorial-accent text-white border-transparent'
              : 'bg-surface-raised text-white border-border'
          } border font-bold flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform overflow-hidden shadow-xs select-none`}>
            <span class="user-avatar-initials inline-flex items-center justify-center text-center text-xs font-bold leading-none uppercase">U</span>
          </div>
          <div class="sidebar-text truncate">
            <p class={`user-display-name text-xs font-bold ${isEditorialTheme ? 'text-editorial-heading' : 'text-heading'} truncate leading-tight`}>User</p>
            <p class={`user-display-email text-[11px] ${isEditorialTheme ? 'text-editorial-muted' : 'text-muted'} leading-none mt-0.5 truncate`}>user@example.com</p>
          </div>
        </div>
      </button>
    </div>
  </div>
</aside>
