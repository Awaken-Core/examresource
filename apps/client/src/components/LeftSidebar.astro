---
import ProfileDropdown from './ProfileDropdown.astro';
import Tooltip from './Tooltip.astro';
import NotificationPopup from './NotificationPopup.astro';
import BrandLogo from './BrandLogo.astro';
import { telegramChannel, whatsappChannel, siteDomain } from '../data/site';

interface Props {
  prefix?: string;
  isMobileDrawer?: boolean;
}

const { prefix = "desktop", isMobileDrawer = false } = Astro.props;
const [brandPrefix, ...brandRest] = siteDomain.split('.');
const brandSuffix = brandRest.length > 0 ? `.${brandRest.join('.')}` : '';
---

<aside 
  id={`${prefix}-sidebar`} 
  class="w-64 bg-canvas border-r border-border h-screen sticky top-0 flex flex-col justify-between shrink-0 select-none z-[1050] transition-all duration-300 overflow-visible"
>
  {/* Top Logo, Logoname & Collapse/Close Button in Sidebar */}
  <div>
    <div class="sidebar-header h-16 px-4 flex items-center justify-between border-b border-border/60">
      <a href="/" class="flex items-center gap-2.5 group truncate" aria-label={`${siteDomain} home`}>
        <BrandLogo size={36} class="group-hover:scale-105 transition-transform shrink-0" />
        <div class="sidebar-text flex items-center truncate font-bold text-base tracking-tight text-white">
          <span>{brandPrefix}</span><span class="text-accent">{brandSuffix}</span>
        </div>
      </a>

      {isMobileDrawer ? (
        <button 
          id={`${prefix}-sidebar-close-btn`}
          data-mobile-sidebar-close
          type="button"
          class="text-muted hover:text-white p-1.5 rounded-lg hover:bg-surface-raised transition cursor-pointer"
          title="Close drawer"
          aria-label="Close navigation drawer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      ) : (
        <div class="relative group">
          <button 
            id={`${prefix}-sidebar-toggle-btn`} 
            data-sidebar-collapse
            type="button"
            class="text-muted hover:text-white p-1.5 rounded-lg hover:bg-surface-raised border border-border/60 hover:border-border transition cursor-pointer shrink-0 flex items-center justify-center"
            aria-label="Collapse sidebar (Alt+B)"
          >
            {/* ◫ icon matching reference */}
            <svg class="w-4 h-4 text-muted hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="2"/>
              <line x1="9" y1="3" x2="9" y2="21" stroke-width="2"/>
            </svg>
          </button>

          {/* Attached Tooltip */}
          <Tooltip text="Collapse sidebar" shortcut={['Alt', 'B']} position="bottom" />
        </div>
      )}
    </div>

    {/* Navigation Scrollable Body (Clean minimal educational layout matching reference) */}
    <nav class="pt-0 px-3 pb-3 space-y-1 overflow-y-auto max-h-[calc(100vh-140px)] scrollbar-none">
      {/* 1. Home (Active state) */}
      <a 
        href="/" 
        class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-lg bg-[#EBF2FE] text-[#2563EB] font-semibold text-xs transition" 
        title="Home"
      >
        <svg class="w-4 h-4 text-[#2563EB] shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
        <span class="sidebar-text truncate">Home</span>
      </a>

      {/* 2. Latest updates */}
      <a 
        href="/#latest-updates" 
        class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium" 
        title="Latest updates"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <span class="sidebar-text truncate">Latest updates</span>
      </a>

      {/* 3. Exams (with chevron) */}
      <a 
        href="/#categories" 
        class="sidebar-nav-item flex items-center justify-between px-3.5 py-2.5 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium group" 
        title="Exams"
      >
        <div class="flex items-center gap-3 min-w-0">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="sidebar-text truncate">Exams</span>
        </div>
        <svg class="w-3.5 h-3.5 text-muted/70 group-hover:text-white transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      {/* 4. Results */}
      <a 
        href="/#latest-updates" 
        class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium" 
        title="Exam results"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="sidebar-text truncate">Results</span>
      </a>

      {/* 5. Admit cards */}
      <a 
        href="/#latest-updates" 
        class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium" 
        title="Download admit cards"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2"/>
          <line x1="7" y1="8" x2="11" y2="8" stroke-width="2"/>
          <line x1="7" y1="12" x2="17" y2="12" stroke-width="2"/>
        </svg>
        <span class="sidebar-text truncate">Admit cards</span>
      </a>

      {/* 6. Important links */}
      <a 
        href="/#important-links" 
        class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium" 
        title="Important links"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5M10.172 13.828a4 4 0 010-5.656l3-3a4 4 0 015.656 5.656l-1.5 1.5" />
        </svg>
        <span class="sidebar-text truncate">Important links</span>
      </a>

      {/* 7. FAQs */}
      <a 
        href="/#faqs" 
        class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium" 
        title="FAQs"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"/>
        </svg>
        <span class="sidebar-text truncate">FAQs</span>
      </a>

      {/* Channels Section */}
      <div class="pt-2 border-t border-border/40 mt-2 space-y-0.5">
        <p class="sidebar-text px-3.5 mb-1 text-[10px] font-bold uppercase tracking-widest text-muted/70">Channels</p>
        <a 
          href={whatsappChannel} 
          target="_blank" 
          rel="noopener noreferrer"
          class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium group" 
          title="WhatsApp Channel"
        >
          <svg class="w-4 h-4 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span class="sidebar-text truncate">WhatsApp</span>
        </a>
        <a 
          href={telegramChannel} 
          target="_blank" 
          rel="noopener noreferrer"
          class="sidebar-nav-item flex items-center gap-3 px-3.5 py-2 rounded-lg text-muted hover:text-white hover:bg-surface-raised transition text-xs font-medium group" 
          title="Telegram Channel"
        >
          <svg class="w-4 h-4 shrink-0 text-[#2AABEE]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span class="sidebar-text truncate">Telegram</span>
        </a>
      </div>
    </nav>
  </div>

  {/* BOTTOM PROFILE / AUTH SECTION (Exact match to Image 2) */}
  <div class="p-3 border-t border-border/60 relative overflow-visible space-y-2">
    {/* Popover Dropdown (Positioned Bottom-Up on Desktop or Mobile) */}
    <ProfileDropdown id={`${prefix}-profile-dropdown`} position={isMobileDrawer ? 'mobile' : 'bottom'} />

    {/* Contact support & See plans and pricing links (Matches Image 2) */}
    <div class="space-y-0.5">
      <a 
        href="/#faqs" 
        class="sidebar-nav-item flex items-center gap-3 px-3 py-2 rounded-xl text-muted hover:text-white hover:bg-surface-raised transition text-body-sm font-medium"
        title="Help and FAQs"
      >
        <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"/>
        </svg>
        <span class="sidebar-text truncate">Help and FAQs</span>
      </a>
    </div>

    {/* Logged Out State: Log in / Sign up Button (Exact match to Image 2) */}
    <div class="sidebar-auth-logged-out block">
      <a 
        href="/login" 
        class="flex items-center justify-center gap-2.5 w-full py-2.5 px-4 rounded-xl bg-surface-raised hover:bg-surface-elevated text-white font-semibold text-body-sm border border-border transition shadow-xs group"
        title="Log in / Sign up"
      >
        <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
        </svg>
        <span class="sidebar-text truncate">Log in / Sign up</span>
      </a>
    </div>

    {/* Logged In State: User Profile Card & Notification Pill (Exact match to Images 3 & 4) */}
    <div class="sidebar-auth-logged-in hidden space-y-2">
      {/* Notification Pill Button (Opens Notification Popup matching ss) */}
      <div class="relative">
        <button 
          id={`${prefix}-notification-trigger`}
          data-notification-trigger={`${prefix}-notification-popup`}
          type="button"
          class="sidebar-notification-pill-btn w-full px-3 py-2 rounded-xl bg-surface-raised/50 hover:bg-surface-raised border border-border/60 hover:border-border transition flex items-center justify-between text-body-sm text-white/90 cursor-pointer text-left group"
          title="Open Notifications"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="notification-dot-indicator relative flex h-2 w-2 shrink-0 hidden">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
            </span>
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span class="sidebar-text truncate text-caption-xs font-medium text-muted notification-pill-text">Notifications</span>
          </div>
          <span class="sidebar-text notification-pill-badge px-1.5 py-0.5 rounded-full bg-accent/15 text-accent text-[10px] font-bold border border-accent/30 leading-none">
            0
          </span>
        </button>

        {/* Popover Notification Popup anchored beside sidebar */}
        <NotificationPopup id={`${prefix}-notification-popup`} prefix={prefix} />
      </div>

      <button 
        id={`${prefix}-profile-trigger`}
        data-profile-trigger={`${prefix}-profile-dropdown`}
        type="button"
        class="sidebar-profile-card w-full flex items-center justify-between p-2 rounded-xl bg-surface-raised/40 hover:bg-surface-raised border border-border/50 hover:border-border transition-all duration-150 cursor-pointer group text-left"
        aria-haspopup="true"
        aria-expanded="false"
        title="User Profile & Settings"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          {/* Avatar Circle */}
          <div class="w-8 h-8 rounded-full bg-surface-raised border border-border text-white font-bold flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform overflow-hidden shadow-xs select-none">
            <span class="user-avatar-initials inline-flex items-center justify-center text-center text-xs font-bold leading-none uppercase">DW</span>
          </div>
          <div class="sidebar-text truncate">
            <p class="user-display-name text-body-sm font-bold text-white truncate leading-tight">Devil</p>
            <p class="user-display-email text-[11px] text-muted leading-none mt-0.5 truncate">Free</p>
          </div>
        </div>
      </button>
    </div>
  </div>
</aside>
