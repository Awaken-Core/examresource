---
import BrandLogo from './BrandLogo.astro';
import { whatsappChannel, telegramChannel, siteDomain } from '../data/site';

const [brandPrefix, ...brandRest] = siteDomain.split('.');
const brandSuffix = brandRest.length > 0 ? `.${brandRest.join('.')}` : '';
---

<footer class="bg-surface text-muted mt-16 border-t border-border text-body-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {/* Brand Column */}
      <div class="md:col-span-1 space-y-3">
        <div class="flex items-center gap-2.5">
          <BrandLogo size={32} class="shrink-0" />
          <span class="text-heading-sm font-bold text-white tracking-tight">
            {brandPrefix}<span class="text-accent">{brandSuffix}</span>
          </span>
        </div>
        <p class="text-caption-sm text-muted leading-relaxed">
          Your trusted source for verified government job notifications, admit cards, exam answer keys, and college admission counselling updates across India.
        </p>
      </div>

      {/* Quick Links 1 */}
      <div>
        <h4 class="text-white font-semibold text-caption-xs uppercase tracking-wider mb-3">Exam portals</h4>
        <ul class="space-y-2 text-caption-sm text-muted">
          <li><a href="https://ssc.gov.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">SSC</a></li>
          <li><a href="https://www.upsc.gov.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">UPSC</a></li>
          <li><a href="https://rrb.indianrailways.gov.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">Railway RRB</a></li>
          <li><a href="https://www.ibps.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">IBPS</a></li>
          <li><a href="https://nta.ac.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">NTA</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold text-caption-xs uppercase tracking-wider mb-3">Government portals</h4>
        <ul class="space-y-2 text-caption-sm text-muted">
          <li><a href="https://www.india.gov.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">National Portal of India</a></li>
          <li><a href="https://www.digilocker.gov.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">DigiLocker</a></li>
          <li><a href="https://www.uidai.gov.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">UIDAI</a></li>
          <li><a href="https://www.ncs.gov.in/" class="hover:text-white transition" rel="noopener noreferrer" target="_blank">National Career Service</a></li>
          <li><a href="/#important-links" class="hover:text-white transition">All important links</a></li>
        </ul>
      </div>

      {/* Disclaimer */}
      <div>
        <h4 class="text-white font-semibold text-caption-xs uppercase tracking-wider mb-3">Disclaimer</h4>
        <p class="text-caption-sm text-muted leading-relaxed">
          Guides published on this site are summaries. Apply, pay fees, and download admit cards only from the official portal named in the notice. {siteDomain} is an informational education portal and is not associated with any government department or recruitment commission.
        </p>
      </div>
    </div>

    <div class="border-t border-border mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between text-caption-xs text-muted gap-4">
      <p>© 2026 {siteDomain}. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-4">
        <a href={whatsappChannel} target="_blank" rel="noopener noreferrer" class="hover:text-[#25D366] transition inline-flex items-center gap-1 font-medium min-h-[44px] py-2">WhatsApp</a>
        <a href={telegramChannel} target="_blank" rel="noopener noreferrer" class="hover:text-[#2AABEE] transition inline-flex items-center gap-1 font-medium min-h-[44px] py-2">Telegram</a>
        <a href="/privacy-policy" class="hover:text-white transition min-h-[44px] py-2 inline-flex items-center">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-white transition min-h-[44px] py-2 inline-flex items-center">Terms of Service</a>
        <a href="/contact-us" class="hover:text-white transition min-h-[44px] py-2 inline-flex items-center">Contact Us</a>
        <a href="/sitemap" class="hover:text-white transition min-h-[44px] py-2 inline-flex items-center">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
