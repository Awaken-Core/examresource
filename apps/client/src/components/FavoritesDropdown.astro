---
interface Props {
  id?: string;
}

const { id = "header-favorites-dropdown" } = Astro.props;
---

<div 
  id={id} 
  data-favorites-dropdown
  class="hidden absolute top-full right-0 mt-2 w-80 sm:w-88 max-w-[calc(100vw-24px)] bg-surface border border-border rounded-2xl shadow-elevated p-3 sm:p-4 z-[9999] transition-all duration-150 transform scale-95 opacity-0 select-none"
  role="dialog"
  aria-label="Favorite Articles"
>
  <div class="flex items-center justify-between pb-2.5 border-b border-border/50">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded-lg bg-rose-500/15 text-rose-400 flex items-center justify-center shrink-0">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-heading tracking-tight">Favorites</h3>
      <span class="favorites-count-badge hidden px-1.5 py-0.5 rounded-full bg-rose-500/15 text-rose-400 text-[10px] font-bold border border-rose-500/30 leading-none">
        0
      </span>
    </div>

    <div class="flex items-center gap-1">
      <button 
        type="button" 
        data-clear-bookmarks
        class="hidden text-[11px] text-muted hover:text-red-400 hover:underline px-1.5 py-0.5 rounded transition cursor-pointer"
        title="Clear all favorites"
      >
        Clear all
      </button>
      <button 
        type="button" 
        data-close-favorites
        class="text-muted hover:text-heading p-1 rounded-lg hover:bg-surface-raised transition cursor-pointer"
        title="Close favorites"
        aria-label="Close favorites"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  {/* Container for rendered list or empty state */}
  <div data-favorites-list class="mt-2">
    <div class="py-6 text-center text-xs text-muted">Loading favorites...</div>
  </div>

  <div class="mt-2.5 pt-2 border-t border-border/50 text-center">
    <a 
      href="/favorites"
      class="text-[11px] font-semibold text-rose-400 hover:underline inline-flex items-center gap-1 transition"
    >
      <span>Open full favorites page</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
