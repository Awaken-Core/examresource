---
import type { AuthMode } from '../stores/auth';
import { SignIn, SignUp } from '@clerk/astro/components';

interface Props { mode: AuthMode }
const { mode } = Astro.props;
const isSignup = mode === 'signup';
---

<main class="flex min-h-screen items-center justify-center bg-[radial-gradient(circle_at_top_left,_#ffe5dc,_#fff8f5_47%,_#f7fbff)] p-4">
  <section class="w-full max-w-md rounded-[2rem] bg-white p-6 shadow-[0_22px_70px_rgba(176,83,95,0.16)] sm:p-10">
    <a href="/" class="text-xl font-black tracking-tight text-[#db2f72]">Exam<span class="text-[#102332]">Resource.</span></a>
    <p class="mt-7 text-sm font-extrabold uppercase tracking-[.18em] text-[#db2f72]">Welcome</p>
    <h1 class="mt-2 text-3xl font-black text-[#102332]">{isSignup ? 'Create your account' : 'Log in'}</h1>
    <p class="mt-2 text-slate-500">{isSignup ? 'Start preparing with your secure account.' : 'Continue your preparation where you left off.'}</p>
    <div class="mt-6">
      {isSignup ? (
        <SignUp afterSignUpUrl="/home" signInUrl="/login" />
      ) : (
        <SignIn afterSignInUrl="/home" signUpUrl="/signup" />
      )}
    </div>
  </section>
</main>
