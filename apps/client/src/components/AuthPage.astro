---
import type { AuthMode } from '../stores/auth';
import BrandLogo from './BrandLogo.astro';
import { siteDomain } from '../data/site';
import { API_URL } from '../lib/api';

import { safeDeskReturn } from '../lib/adminSession';

interface Props { mode: AuthMode }
const { mode } = Astro.props;
const [brandPrefix, ...brandRest] = siteDomain.split('.');
const brandSuffix = brandRest.length ? `.${brandRest.join('.')}` : '';
const title = mode === 'signup' ? 'Create your account' : 'Welcome back';
const rawReturn = Astro.url.searchParams.get('redirect') || Astro.url.searchParams.get('returnTo');
const safeReturn = safeDeskReturn(rawReturn);
const googleAuthUrl = safeReturn
  ? `${API_URL}/auth/google?returnTo=${encodeURIComponent(safeReturn)}`
  : `${API_URL}/auth/google`;
---

<main class="min-h-screen w-full bg-canvas px-4 py-8 flex items-center justify-center">
  <section class="card w-full max-w-md p-6 sm:p-8" aria-labelledby="auth-title">
    <a href="/" class="mb-8 flex items-center justify-center gap-3" aria-label={`${siteDomain} home`}>
      <BrandLogo size={38} class="shrink-0" />
      <span class="text-heading-sm font-bold tracking-tight text-white">
        {brandPrefix}<span class="text-accent">{brandSuffix}</span>
      </span>
    </a>
    <div class="text-center">
      <h1 id="auth-title" class="text-heading-lg font-bold text-white">{title}</h1>
      <p class="mt-2 text-body-md text-muted">Continue securely with your Google account.</p>
    </div>
    <div id="auth-error" role="alert" class="mt-5 hidden rounded-xl border border-error bg-error/10 p-3 text-body-sm text-white">
      Google sign-in could not be completed. Please try again.
    </div>
    <a
      id="google-continue-btn"
      href={googleAuthUrl}
      class="mt-7 flex min-h-11 w-full items-center justify-center gap-3 rounded-pill border border-border bg-surface-raised px-5 py-3 text-button-md font-semibold text-white transition hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      <span>Continue with Google</span>
    </a>
    <p class="mt-5 text-center text-caption-xs text-muted">
      By continuing, you agree to our <a class="text-accent hover:underline" href="/terms-of-service">Terms</a> and <a class="text-accent hover:underline" href="/privacy-policy">Privacy Policy</a>.
    </p>
    <p class="mt-6 text-center">
      <a href="/" class="text-body-sm text-muted transition hover:text-white">Continue without signing in</a>
    </p>
  </section>
</main>

<script>
  import { API_URL } from '../lib/api';
  import { safeDeskReturn } from '../lib/adminSession';

  function setupGoogleAuth() {
    const link = document.getElementById('google-continue-btn') as HTMLAnchorElement | null;
    if (!link) return;
    const params = new URLSearchParams(window.location.search);
    const returnTo = safeDeskReturn(params.get('redirect') || params.get('returnTo'));
    link.href = returnTo
      ? `${API_URL}/auth/google?returnTo=${encodeURIComponent(returnTo)}`
      : `${API_URL}/auth/google`;
    if (!link.dataset.clickBound) {
      link.dataset.clickBound = 'true';
      link.addEventListener('click', () => {
        link.setAttribute('aria-disabled', 'true');
        link.classList.add('pointer-events-none', 'opacity-70');
        const label = link.querySelector('span');
        if (label) label.textContent = 'Redirecting to Google…';
      });
    }
    if (new URLSearchParams(window.location.search).has('error')) {
      document.getElementById('auth-error')?.classList.remove('hidden');
    }
  }

  document.addEventListener('astro:page-load', setupGoogleAuth);
  setupGoogleAuth();
</script>
