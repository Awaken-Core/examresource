---
import type { AuthMode } from "../stores/auth";

interface Props {
  apiUrl: string;
  mode: AuthMode;
}

const { apiUrl, mode } = Astro.props;
const isSignup = mode === "signup";
const heading = isSignup ? "Create your account" : "Log in";
const description = isSignup
  ? "Join ExamResource with your Google account."
  : "Continue your preparation where you left off.";
const alternate = isSignup
  ? { text: "Already have an account?", href: "/login", label: "Log in" }
  : { text: "New to ExamResource?", href: "/signup", label: "Sign up" };
---

<main
  id="auth-root"
  data-api-url={apiUrl}
  data-mode={mode}
  class="flex h-screen overflow-hidden items-center justify-center bg-[radial-gradient(circle_at_top_left,_#ffe5dc,_#fff8f5_47%,_#f7fbff)] p-3 sm:p-6"
>
  <section
    class="relative grid h-full max-h-[calc(100vh-1.5rem)] w-full max-w-6xl overflow-hidden rounded-[2rem] bg-white shadow-[0_22px_70px_rgba(176,83,95,0.16)] lg:grid-cols-[1.03fr_.97fr] sm:max-h-[calc(100vh-3rem)]"
    aria-labelledby="auth-title"
  >
    <aside
      class="relative hidden min-h-0 overflow-hidden bg-[#ffe5df] lg:block"
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_72%_24%,rgba(255,255,255,.95)_0_3%,transparent_3.2%),radial-gradient(circle_at_65%_65%,rgba(255,255,255,.7)_0_4%,transparent_4.2%),linear-gradient(145deg,#ffece7_0%,#f7d4cc_100%)]"
      >
      </div>
      <img
        src="/images/auth-study-illustration.png"
        alt="Student preparing with study notes"
        class="absolute bottom-0 left-0 h-[83%] w-full object-contain object-bottom"
      />
      <div class="relative flex h-full flex-col justify-between p-10">
        <div class="text-xl font-black tracking-tight text-[#db2f72]">
          Exam<span class="text-[#102332]">Resource.</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="h-3 w-3 rounded-full bg-[#ff7780]"></span><span
            class="h-3 w-16 rounded-full bg-[#c04d7b]"></span>
        </div>
      </div>
    </aside>
    <section
      class="relative flex min-h-0 items-center justify-center px-6 py-4 sm:px-14 lg:px-16"
    >
      <button
        id="close-auth"
        class="absolute right-6 top-6 grid h-10 w-10 place-items-center rounded-full text-3xl font-light text-[#102332] transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-[#ff7780]"
        aria-label="Close sign in dialog">&times;</button
      >
      <div class="w-full max-w-sm text-center">
        <div
          class="mb-10 text-xl font-black tracking-tight text-[#db2f72] lg:hidden"
        >
          Exam<span class="text-[#102332]">Resource.</span>
        </div>
        <p
          class="mb-2 text-sm font-extrabold uppercase tracking-[.18em] text-[#db2f72]"
        >
          Welcome to ExamResource
        </p>
        <h1
          id="auth-title"
          class="text-3xl font-black tracking-tight text-[#102332] sm:text-4xl"
        >
          {heading}
        </h1>
        <p id="auth-description" class="mt-3 text-slate-500">{description}</p>
        <p
          id="auth-notice"
          class="mt-6 hidden rounded-xl border px-4 py-3 text-sm font-semibold"
          role="status"
        >
        </p>
        <form id="email-auth-form" class="mt-5 space-y-3 text-left">
          {isSignup && (
            <label class="block">
              <span class="mb-1.5 block text-sm font-bold text-[#102332]">Full name</span>
              <input name="name" type="text" autocomplete="name" required minlength="2" placeholder="Your full name" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-[#102332] outline-none transition placeholder:text-slate-400 focus:border-[#db2f72] focus:ring-2 focus:ring-[#db2f72]/15" />
            </label>
          )}
          <label class="block">
            <span class="mb-1.5 block text-sm font-bold text-[#102332]">Email</span>
            <input name="email" type="email" autocomplete="email" required placeholder="you@example.com" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-[#102332] outline-none transition placeholder:text-slate-400 focus:border-[#db2f72] focus:ring-2 focus:ring-[#db2f72]/15" />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-bold text-[#102332]">Password</span>
            <span class="relative block">
              <input id="auth-password" name="password" type="password" autocomplete={isSignup ? 'new-password' : 'current-password'} required minlength={isSignup ? 12 : 1} placeholder={isSignup ? 'At least 12 characters' : 'Your password'} class="w-full rounded-xl border border-slate-200 px-4 py-3 pr-12 text-[#102332] outline-none transition placeholder:text-slate-400 focus:border-[#db2f72] focus:ring-2 focus:ring-[#db2f72]/15" />
              <button id="password-toggle" type="button" class="absolute inset-y-0 right-0 grid w-12 place-items-center text-[#db2f72] transition hover:text-[#b51f5d] focus:outline-none" aria-label="Show password" aria-pressed="false" onclick="const input = document.getElementById('auth-password'); const isVisible = input.type === 'text'; input.type = isVisible ? 'password' : 'text'; this.setAttribute('aria-pressed', String(!isVisible)); this.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password'); this.querySelector('[data-eye=show]').classList.toggle('hidden', !isVisible); this.querySelector('[data-eye=hide]').classList.toggle('hidden', isVisible);">
                <svg data-eye="show" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg>
                <svg data-eye="hide" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3l18 18"></path><path d="M10.6 6.2A10.7 10.7 0 0 1 12 6c6.5 0 10 6 10 6a18.5 18.5 0 0 1-3.2 3.8"></path><path d="M6.1 6.1C3.5 8 2 12 2 12s3.5 6 10 6a10.2 10.2 0 0 0 3.1-.5"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg>
              </button>
            </span>
          </label>
          <button id="email-auth-submit" type="submit" class="w-full rounded-xl bg-[#ff7780] px-5 py-3.5 font-extrabold text-white shadow-sm transition hover:bg-[#ef6670] focus:outline-none focus:ring-2 focus:ring-[#ff7780] focus:ring-offset-2">{isSignup ? 'Create account' : 'Log in'}</button>
        </form>
        <div class="my-4 flex items-center gap-4 text-xs font-bold uppercase tracking-[.16em] text-slate-400"><span class="h-px flex-1 bg-slate-200"></span>or<span class="h-px flex-1 bg-slate-200"></span></div>
        <button
          id="google-auth"
          class="mt-6 flex w-full items-center justify-center gap-3 rounded-xl border border-slate-200 bg-white px-5 py-4 font-extrabold text-[#102332] shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[#ff7780] focus:ring-offset-2"
          ><svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true"
            ><path
              fill="#4285F4"
              d="M21.35 12.23c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.51h3.14c1.84-1.7 2.91-4.2 2.91-7.28Z"
            ></path><path
              fill="#34A853"
              d="M12 21.75c2.63 0 4.84-.87 6.45-2.35l-3.14-2.51c-.87.59-1.99.94-3.31.94-2.54 0-4.7-1.72-5.47-4.03H3.29v2.59A9.75 9.75 0 0 0 12 21.75Z"
            ></path><path
              fill="#FBBC05"
              d="M6.53 13.8a5.87 5.87 0 0 1 0-3.6V7.61H3.29a9.75 9.75 0 0 0 0 8.78l3.24-2.59Z"
            ></path><path
              fill="#EA4335"
              d="M12 6.17c1.44 0 2.73.5 3.75 1.47l2.81-2.81C16.83 3.22 14.63 2.25 12 2.25a9.75 9.75 0 0 0-8.71 5.36l3.24 2.59C7.3 7.89 9.46 6.17 12 6.17Z"
            ></path></svg
          ><span id="google-label">Continue with Google</span></button
        >
        <p class="mt-4 text-sm leading-5 text-slate-500">
          By continuing, you agree to our Terms of Service and Privacy Policy.
        </p><p class="mt-4 text-sm font-semibold text-[#102332]">
          {alternate.text}
          <a
            href={alternate.href}
            class="font-extrabold text-[#d49a32] underline decoration-1 underline-offset-2 transition hover:text-[#b57813]"
            >{alternate.label}</a>
        </p>
      </div>
    </section>
  </section>
</main>

<script>
  import { authStore } from "../stores/auth";

  function initializeAuthPage() {
    const root = document.querySelector<HTMLElement>("#auth-root");
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = "true";
    const apiUrl = root.dataset.apiUrl;
    const mode = root.dataset.mode;
    if (!apiUrl || (mode !== "login" && mode !== "signup")) return;
  const notice = document.querySelector<HTMLElement>("#auth-notice");
  const googleButton = document.querySelector<HTMLButtonElement>("#google-auth");
  const googleLabel = document.querySelector<HTMLElement>("#google-label");
  const emailForm = document.querySelector<HTMLFormElement>("#email-auth-form");
  const emailSubmit = document.querySelector<HTMLButtonElement>("#email-auth-submit");
  const closeButton = document.querySelector<HTMLButtonElement>("#close-auth");
  if (!notice || !googleButton || !googleLabel || !emailForm || !emailSubmit || !closeButton) return;
  authStore.getState().setMode(mode);

  function showNotice(message, type = "error") {
    authStore.getState().setMessage(message);
    notice.textContent = message;
    notice.className = type === "success"
      ? "mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700"
      : "mt-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700";
  }

  emailForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = new FormData(emailForm);
    const payload = Object.fromEntries(form.entries());
    authStore.getState().setLoading(true);
    emailSubmit.disabled = true;
    emailSubmit.textContent = mode === "signup" ? "Creating account..." : "Logging in...";

    try {
      const response = await fetch(`${apiUrl}/auth/${mode === "signup" ? "register" : "login"}`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json", "x-csrf-protection": "1" },
        body: JSON.stringify(payload),
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(Array.isArray(body.message) ? body.message[0] : body.message || "Unable to continue. Please try again.");
      if (mode === "signup") {
        authStore.getState().setUser(body.user);
        window.location.assign("/home");
      } else {
        authStore.getState().setUser(body.user);
        window.location.assign("/home");
      }
    } catch (error) {
      showNotice(error instanceof Error ? error.message : "Unable to continue. Please try again.");
    } finally {
      authStore.getState().setLoading(false);
      emailSubmit.disabled = false;
      emailSubmit.textContent = mode === "signup" ? "Create account" : "Log in";
    }
  });
  document.querySelector("#google-auth").addEventListener("click", () => {
    authStore.getState().setLoading(true);
    googleButton.disabled = true;
    googleLabel.textContent = "Opening Google...";
    window.location.assign(`${apiUrl}/auth/google`);
  });
  closeButton.addEventListener("click", () => window.history.back());
  if (new URLSearchParams(window.location.search).get("login") === "success") {
    authStore.getState().setMessage("You are successfully signed in.");
    notice.textContent = authStore.getState().message;
    notice.className =
      "mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700";
  }

  }

  document.addEventListener("astro:page-load", initializeAuthPage);
  initializeAuthPage();
</script>
