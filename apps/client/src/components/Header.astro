---
import ProfileDropdown from './ProfileDropdown.astro';
import Tooltip from './Tooltip.astro';
---

<header class="bg-surface border-b border-border sticky top-0 z-[1000] shadow-2xs relative h-14 sm:h-16">
  {/* Main Navbar */}
  <div class="w-full flex items-center justify-between h-14 sm:h-16">
    
    {/* Left: Mobile Drawer Button + Header Brand (Exact same w-64 px-4 justify-between as LeftSidebar!) */}
    <div class="flex items-center shrink-0 min-w-0">
      {/* Mobile Drawer Toggle (visible ONLY on mobile/tablet screens) */}
      <button 
        id="mobile-drawer-toggle-btn"
        data-sidebar-toggle
        type="button"
        class="lg:hidden ml-3 sm:ml-4 text-muted hover:text-white p-2 rounded-xl hover:bg-surface-raised border border-border/60 transition cursor-pointer flex items-center justify-center shrink-0"
        title="Open Menu"
        aria-label="Open Navigation Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {/* Mobile Brand Logo — visible on mobile/tablet only (hidden on desktop where sidebar shows brand) */}
      <a href="/" class="lg:hidden flex items-center gap-2 ml-2.5 group shrink-0" aria-label="govtpariksha.com home">
        <div class="w-7 h-7 rounded-lg bg-accent/15 border border-accent/30 flex items-center justify-center text-accent shrink-0 shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <span class="hidden sm:flex items-center font-bold text-sm tracking-tight text-white">
          govtpariksha<span class="text-accent">.com</span>
        </span>
      </a>

      {/* Collapsed State Header Brand & Expand Toggle (Exact same coordinates as LeftSidebar header!) */}
      <div id="header-brand-collapsed" class="hidden h-16 w-64 px-4 items-center justify-between border-r border-border/60 shrink-0">
        {/* Brand Logo & Name */}
        <a href="/" class="flex items-center gap-2.5 group truncate">
          <div class="w-7 h-7 rounded-lg bg-accent/15 border border-accent/30 flex items-center justify-center text-accent shrink-0 shadow-sm group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div class="flex items-center truncate font-bold text-base tracking-tight text-white">
            <span>govtpariksha</span><span class="text-accent">.com</span>
          </div>
        </a>

        {/* Desktop Sidebar Expand Button with Tooltip */}
        <div class="relative group" id="header-sidebar-toggle-wrapper">
          <button 
            id="toolbar-sidebar-expand-btn"
            data-sidebar-toggle
            type="button"
            class="text-muted hover:text-white p-1.5 rounded-lg hover:bg-surface-raised border border-border/60 hover:border-border transition cursor-pointer shrink-0 flex items-center justify-center"
            aria-label="Expand sidebar (Alt+B)"
          >
            <svg class="w-4 h-4 text-muted hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="2"/>
              <line x1="9" y1="3" x2="9" y2="21" stroke-width="2"/>
            </svg>
          </button>
          <Tooltip id="sidebar-toggle-tooltip" textId="sidebar-toggle-tooltip-text" text="Expand sidebar" shortcut={['Alt', 'B']} position="bottom" />
        </div>
      </div>
    </div>
    {/* Center: Search Section — visible on ALL screen sizes */}
    <div class="flex flex-1 items-center justify-center px-2 sm:px-6 min-w-0">
      <div class="w-full max-w-xl">
        <button 
          id="desktop-search-trigger"
          data-open-search
          type="button"
          class="relative w-full flex items-center bg-surface border border-border hover:border-accent/40 rounded-lg py-2 pl-3 pr-2.5 text-body-sm text-muted cursor-pointer transition text-left gap-2"
          title="Search anything (Ctrl+K)"
        >
          <svg class="w-4 h-4 shrink-0 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>

          <span class="truncate flex-1 select-none text-xs sm:text-sm text-muted">
            Search exams, results...
          </span>

          {/* Shortcut Key Badge */}
          <kbd class="hidden md:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] text-muted bg-surface-raised border border-border rounded font-mono font-medium shrink-0">
            <span>Ctrl K</span>
          </kbd>
        </button>
      </div>
    </div>

    {/* Right Toolbar Items: Official Portals, FAQs, Theme Toggle */}
    <div class="flex items-center gap-3 sm:gap-4 shrink-0 px-3 sm:px-5">
      <a href="/#important-links" class="hidden sm:inline-block text-xs font-medium text-muted hover:text-white transition">Official portals</a>
      <a href="/#faqs" class="hidden sm:inline-block text-xs font-medium text-muted hover:text-white transition">FAQs</a>

      {/* Theme Toggle Button */}
      <button
        id="header-theme-toggle-btn"
        type="button"
        class="p-1.5 text-muted hover:text-white rounded-lg hover:bg-surface-raised transition cursor-pointer flex items-center justify-center"
        aria-label="Toggle theme"
        title="Toggle dark/light mode"
        onclick="const html = document.documentElement; const isDark = html.classList.toggle('theme-dark'); html.classList.toggle('theme-light', !isDark); localStorage.setItem('theme_preference', isDark ? 'dark' : 'light');"
      >
        {/* Sun Icon */}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <circle cx="12" cy="12" r="5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
      </button>
    </div>
  </div>
</header>
