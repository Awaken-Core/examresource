---
import ProfileDropdown from './ProfileDropdown.astro';
---

<header class="bg-surface border-b border-border sticky top-0 z-[1000] shadow-sm relative">
  {/* Top quick banner / breaking updates ticker */}
  <div class="bg-subtle text-muted text-caption-sm py-1.5 px-4 hidden md:block border-b border-border/50">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="badge-accent text-[10px] font-bold uppercase tracking-wider py-0.5 px-2">
          Latest Update
        </span>
        <span class="truncate max-w-2xl text-white">
          Bihar DECE LE 2026 Round 1 Allotment Letter Out • Direct Download Link Activated
        </span>
      </div>
      <div class="flex items-center gap-4 text-muted">
        <a href="#important-links" class="hover:text-white transition">Direct Links</a>
        <span>•</span>
        <a href="#important-dates" class="hover:text-white transition">Schedule</a>
        <span>•</span>
        <a href="#faqs" class="hover:text-white transition">FAQs</a>
      </div>
    </div>
  </div>

  {/* Main Navbar */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      {/* Left: Mobile Drawer Toggle + Desktop Collapsed Sidebar Reopen Pill (Matching Image 1) */}
      <div class="flex items-center gap-2 shrink-0">
        {/* Mobile Drawer Toggle (visible ONLY on mobile screens) */}
        <button 
          id="mobile-drawer-toggle-btn"
          data-sidebar-toggle
          type="button"
          class="lg:hidden text-muted hover:text-white p-2 rounded-xl hover:bg-surface-raised border border-border/60 transition cursor-pointer flex items-center justify-center"
          title="Open Menu"
          aria-label="Open Navigation Menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        {/* Collapsed Sidebar Reopen Pill (Matching Image 1 - visible ONLY when desktop sidebar is collapsed) */}
        <div 
          id="collapsed-sidebar-reopen-pill" 
          class="hidden items-center gap-2 px-2.5 py-1.5 rounded-xl bg-surface-raised border border-border/80 shadow-xs"
        >
          <a href="/" class="flex items-center gap-2 group">
            <div class="w-6 h-6 rounded-md bg-accent/15 border border-accent/30 flex items-center justify-center text-accent shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
              </svg>
            </div>
            <span class="text-caption-sm font-bold tracking-tight text-white flex items-center">
              govtpariksha<span class="text-accent">.com</span>
            </span>
          </a>

          {/* Reopen Sidebar Button (◫ icon) with Tooltip */}
          <div class="relative group">
            <button 
              id="toolbar-sidebar-expand-btn"
              data-sidebar-toggle
              type="button"
              class="text-muted hover:text-white p-1 rounded-md hover:bg-surface border border-border/50 hover:border-border transition cursor-pointer flex items-center justify-center ml-1"
              aria-label="Expand Sidebar (Alt+B)"
            >
              <svg class="w-4 h-4 text-muted hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="2"/>
                <line x1="9" y1="3" x2="9" y2="21" stroke-width="2"/>
              </svg>
            </button>
            <div class="pointer-events-none absolute left-full ml-2 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 scale-95 group-hover:scale-100 transition-all duration-150 z-[100] flex flex-col items-center whitespace-nowrap bg-surface border border-border/80 rounded-xl px-3 py-1.5 shadow-elevated">
              <span class="text-caption-xs font-semibold text-white">Expand sidebar</span>
              <div class="inline-flex items-center gap-1 mt-1">
                <kbd class="px-1.5 py-0.5 rounded bg-surface-raised border border-border text-[10px] text-muted font-mono font-bold">Alt</kbd>
                <span class="text-[10px] text-muted font-bold">+</span>
                <kbd class="px-1.5 py-0.5 rounded bg-surface-raised border border-border text-[10px] text-muted font-mono font-bold">B</kbd>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Desktop Search Bar Button (Opens Spotlight Search Modal Image 1) */}
      <div class="hidden md:flex flex-1 max-w-md mx-6">
        <button 
          id="desktop-search-trigger"
          data-open-search
          type="button"
          class="relative w-full flex items-center justify-between bg-surface-raised hover:bg-surface-elevated border border-border/80 hover:border-border rounded-pill py-2 pl-10 pr-3 text-body-sm text-muted cursor-pointer transition shadow-2xs group text-left"
          title="Search anything (Ctrl+K)"
        >
          <svg class="w-4 h-4 text-muted group-hover:text-white transition absolute left-3.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="truncate">Search exams, notifications, results...</span>
          <kbd class="hidden sm:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] text-muted bg-canvas border border-border rounded font-mono font-bold">
            <span>Ctrl</span><span>K</span>
          </kbd>
        </button>
      </div>

      {/* Right Toolbar Items: Quick links, Upgrade badge, and Profile Avatar */}
      <div class="flex items-center gap-3">
        <nav class="hidden xl:flex items-center gap-3 font-medium text-body-sm">
          <a href="/" class="nav-link">Home</a>
          <a href="#state-filter-widget" class="nav-link-muted">State Updates</a>
          <a href="#important-links" class="nav-link-muted">Admissions</a>
          <a href="#quick-info" class="nav-link-muted">Results</a>
        </nav>

        {/* Upgrade / Plus Pill Button (Matching screenshot toolbar) */}
        <a 
          href="#important-links"
          class="hidden sm:inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#241e12] border border-[#59441a] text-[#f5a623] hover:bg-[#332a18] text-xs font-semibold shrink-0 transition shadow-2xs"
        >
          <span>✨</span>
          <span>Upgrade</span>
        </a>

        {/* TOP RIGHT PROFILE SECTION & DROPDOWN (Shown ONLY when user is logged in) */}
        <div id="header-profile-section" class="header-auth-logged-in hidden relative z-[1100]">
          <button 
            id="header-profile-trigger"
            data-profile-trigger="header-profile-dropdown"
            type="button"
            class="header-profile-avatar-btn w-9 h-9 rounded-full bg-surface-raised border border-border hover:border-accent text-white flex items-center justify-center font-bold text-caption-xs transition cursor-pointer shadow-xs focus:outline-none focus:ring-2 focus:ring-accent/40 overflow-hidden"
            aria-label="Open User Profile Menu"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span class="user-avatar-initials">GP</span>
            <img class="user-avatar-img hidden w-full h-full object-cover" alt="Profile" />
          </button>

          {/* Mount Dropdown at Top */}
          <ProfileDropdown id="header-profile-dropdown" position="top" />
        </div>

        {/* Modern "Get Started >" Button (Shown when user is NOT logged in) */}
        <div class="header-auth-logged-out flex items-center">
          <a 
            href="/login"
            id="header-login-btn"
            class="group inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-accent hover:bg-accent/90 text-[#ffffff] font-semibold text-xs shadow-xs hover:shadow-sm transition-all duration-150 shrink-0 cursor-pointer"
            title="Get Started on govtpariksha.com"
          >
            <span class="tracking-tight">Get Started</span>
            <svg 
              class="w-3.5 h-3.5 text-[#ffffff] transition-transform duration-200 ease-out group-hover:translate-x-1" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2.5" 
              stroke-linecap="round" 
              stroke-linejoin="round"
            >
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  {/* Mobile Dropdown Search */}
  <div id="mobile-search-bar" class="md:hidden border-t border-border bg-surface px-4 py-2">
    <button 
      type="button"
      data-open-search
      class="relative w-full flex items-center bg-surface-raised border border-border rounded-xl py-2 pl-9 pr-3 text-body-sm text-muted cursor-pointer text-left"
    >
      <svg class="w-4 h-4 text-muted absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span>Search exams on govtpariksha.com...</span>
    </button>
  </div>
</header>
