---
---

<header class="bg-surface/90 backdrop-blur-md border-b border-border sticky top-0 z-sticky shadow-sm">
  {/* Top quick banner / breaking updates ticker */}
  <div class="bg-subtle text-muted text-caption-sm py-1.5 px-4 hidden md:block border-b border-border/50">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="badge-accent text-[10px] font-bold uppercase tracking-wider py-0.5 px-2">
          Latest Update
        </span>
        <span class="truncate max-w-2xl text-white">
          Bihar DECE LE 2026 Round 1 Allotment Letter Out • Direct Download Link Activated
        </span>
      </div>
      <div class="flex items-center gap-4 text-muted">
        <a href="#important-links" class="hover:text-white transition">Direct Links</a>
        <span>•</span>
        <a href="#important-dates" class="hover:text-white transition">Schedule</a>
        <span>•</span>
        <a href="#faqs" class="hover:text-white transition">FAQs</a>
      </div>
    </div>
  </div>

  {/* Main Navbar */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      {/* Brand Logo & Name */}
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-lg bg-accent flex items-center justify-center text-white font-bold text-base shadow-sm group-hover:scale-105 transition-transform">
            EP
          </div>
          <div>
            <span class="text-heading-sm font-bold tracking-tight text-white block leading-tight">
              Exam<span class="text-accent">Portal</span>
            </span>
            <span class="text-[10px] text-muted font-medium tracking-wide uppercase">
              Govt Jobs & Results Hub
            </span>
          </div>
        </a>
      </div>

      {/* Desktop Search Bar */}
      <div class="hidden md:flex flex-1 max-w-md mx-8">
        <div class="relative w-full">
          <input 
            type="text" 
            placeholder="Search exam results, admit cards, notifications..." 
            class="w-full bg-surface-raised border border-border rounded-pill py-1.5 pl-10 pr-4 text-body-sm text-white placeholder:text-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition"
          />
          <svg class="w-4 h-4 text-muted absolute left-3.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      {/* Nav Links */}
      <nav class="hidden lg:flex items-center gap-3 font-medium text-body-sm">
        <a href="/" class="nav-link">Home</a>
        <a href="#state-filter-widget" class="nav-link-muted">State Updates</a>
        <a href="#" class="px-3 py-1.5 rounded-pill text-accent bg-accent/10 font-semibold transition">Admission</a>
        <a href="#" class="nav-link-muted">Latest Jobs</a>
        <a href="#" class="nav-link-muted">Results</a>
        <a href="/admin" class="btn-outline text-button-sm h-8 px-3">Admin Panel</a>
        <a href="/editor" class="btn-primary text-button-sm h-8 px-3">Editor</a>
      </nav>

      {/* Mobile Menu Button */}
      <div class="flex items-center lg:hidden">
        <button 
          id="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          class="btn-icon"
        >
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Dropdown Menu */}
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-surface px-4 pt-3 pb-4 space-y-2.5">
    <div class="pt-1 pb-2">
      <input 
        type="text" 
        placeholder="Search exams..." 
        class="w-full bg-surface-raised border border-border rounded-xl py-2 px-3 text-body-sm text-white placeholder:text-muted focus:border-accent focus:outline-none"
      />
    </div>
    <div class="flex flex-col space-y-1 font-medium text-body-sm">
      <a href="/" class="px-3 py-2 rounded-lg text-white hover:bg-surface-raised">Home</a>
      <a href="#state-filter-widget" class="px-3 py-2 rounded-lg text-muted hover:text-white hover:bg-surface-raised">State Updates</a>
      <a href="#" class="px-3 py-2 rounded-lg text-accent bg-accent/10 font-semibold">Admission & Counselling</a>
      <a href="#" class="px-3 py-2 rounded-lg text-muted hover:text-white hover:bg-surface-raised">Latest Jobs</a>
      <a href="#" class="px-3 py-2 rounded-lg text-muted hover:text-white hover:bg-surface-raised">Results</a>
      <div class="pt-2 border-t border-border flex gap-2">
        <a href="/admin" class="flex-1 btn-outline text-center text-button-sm h-8">Admin Panel</a>
        <a href="/editor" class="flex-1 btn-primary text-center text-button-sm h-8">Article Editor</a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
