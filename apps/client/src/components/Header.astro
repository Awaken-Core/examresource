---
import BrandLogo from './BrandLogo.astro';
import ProfileDropdown from './ProfileDropdown.astro';
import NotificationPopup from './NotificationPopup.astro';
import FavoritesDropdown from './FavoritesDropdown.astro';
import Tooltip from './Tooltip.astro';
import { siteDomain } from '../data/site';

interface Props {
  hideDesktopSidebar?: boolean;
  isEditorialTheme?: boolean;
}

const { isEditorialTheme = false } = Astro.props;
const [brandPrefix, ...brandRest] = siteDomain.split('.');
const brandSuffix = brandRest.length > 0 ? `.${brandRest.join('.')}` : '';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = currentPath === '/';
const isBlogsActive = currentPath === '/blogs' || currentPath.startsWith('/blogs/') || currentPath.startsWith('/category/');
const isTestSeriesActive = currentPath === '/test-series' || currentPath.startsWith('/test-series/');
const isDailyQuizActive = currentPath === '/daily-quiz' || currentPath.startsWith('/daily-quiz/');
const currentSearch = Astro.url.search || '';
const isAuthPage = currentPath === '/login' || currentPath === '/signup' || currentPath.startsWith('/auth/');
const loginHref = (!isAuthPage && currentPath !== '/')
  ? `/login?redirect=${encodeURIComponent(`${currentPath}${currentSearch}`)}`
  : '/login';
---

<header id="main-header" class={`${
  isEditorialTheme 
    ? 'bg-editorial-bg/95 border-b border-editorial-border text-editorial-text' 
    : 'bg-surface/95 border-b border-border/60'
} backdrop-blur-sm sticky top-0 z-[10000] relative h-14 sm:h-16`}>
  {/* Main Navbar */}
  <div class="w-full flex items-center justify-between h-14 sm:h-16 px-2.5 sm:px-6 md:px-8">

    {/* ── Left: Mobile Hamburger Toggle + Brand Logo (Always in Header) + Desktop Sidebar Expand Trigger ── */}
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0 min-w-0">
      {/* ── Mobile/Tablet Animated Hamburger Toggle (Left side, transparent, no outer border) ── */}
      <button
        id="mobile-drawer-toggle-btn"
        data-sidebar-toggle
        type="button"
        class={`mobile-hamburger-btn group lg:hidden relative size-9 flex flex-col items-center justify-center gap-1.5 rounded-lg bg-transparent border-0 outline-none transition-all duration-300 cursor-pointer shrink-0 focus-visible:outline-2 focus-visible:outline-accent touch-manipulation z-[10005] -ml-1 sm:ml-0 ${
          isEditorialTheme
            ? 'text-editorial-heading hover:text-editorial-accent'
            : 'text-heading hover:text-accent'
        }`}
        title="Open Navigation Menu"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
      >
        <span class="hamburger-line line-top block h-0.5 w-5 rounded-full bg-current transition-all duration-300 pointer-events-none"></span>
        <span class="hamburger-line line-middle block h-0.5 w-5 rounded-full bg-current transition-all duration-300 pointer-events-none"></span>
        <span class="hamburger-line line-bottom block h-0.5 w-5 rounded-full bg-current transition-all duration-300 pointer-events-none"></span>
      </button>

      {/* Brand logo — visible on all screens in header; brand name only visible on / */}
      <a
        href="/"
        class="flex items-center gap-1.5 sm:gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-editorial-accent focus-visible:outline-offset-3 group shrink-0"
        aria-label={`${siteDomain} home`}
      >
        <BrandLogo size={24} class="sm:hidden shrink-0 group-hover:scale-105 transition-transform" />
        <BrandLogo size={32} class="hidden sm:block shrink-0 group-hover:scale-105 transition-transform" />
        <span
          id="header-brand-name"
          class={`${isHomePage ? 'flex' : 'hidden'} items-center font-semibold font-['Geist'] font-medium tracking-tight whitespace-nowrap ${
            isEditorialTheme 
              ? 'text-[16px] min-[360px]:text-[18px] sm:text-[23px] text-editorial-heading'
              : 'text-heading text-base sm:text-lg font-bold'
          }`}
        >
          {brandPrefix}<span class={isEditorialTheme ? 'text-editorial-accent' : 'text-accent font-semibold'}>{brandSuffix}</span>
        </span>
      </a>

      </div>

    {/* ── Center: Search bar (standard) OR Nav links (editorial) ── */}
    {isEditorialTheme ? (
      <div class="hidden md:flex flex-1 items-center justify-center px-3 sm:px-6 min-w-0">
        <nav class="flex items-center gap-7 font-['Geist'] text-[13px]">
          <a
            href="/blogs" data-header-nav-link data-astro-prefetch="hover"
            class={`relative py-1 transition-colors ${
              isBlogsActive
                ? 'text-editorial-heading font-semibold after:content-[\'\'] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-editorial-accent after:rounded-full'
                : 'text-editorial-subheading hover:text-editorial-heading'
            }`}
          >
            Blogs
          </a>
          <a
            href="/test-series" data-header-nav-link data-astro-prefetch="hover"
            class={`relative py-1 transition-colors ${
              isTestSeriesActive
                ? 'text-editorial-heading font-semibold after:content-[\'\'] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-editorial-accent after:rounded-full'
                : 'text-editorial-subheading hover:text-editorial-heading font-medium'
            }`}
          >
            Test Series
          </a>
          <a
            href="/daily-quiz" data-header-nav-link data-astro-prefetch="hover"
            class={`relative py-1 transition-colors ${
              isDailyQuizActive
                ? 'text-editorial-heading font-semibold after:content-[\'\'] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-editorial-accent after:rounded-full'
                : 'text-editorial-subheading hover:text-editorial-heading font-medium'
            }`}
          >
            Quizzes
          </a>
        </nav>
      </div>
    ) : (
      <div class="hidden md:flex flex-1 items-center justify-center px-3 sm:px-6 min-w-0">
        <div class="w-full max-w-xl">
          <button
            id="desktop-search-trigger"
            data-open-search
            type="button"
            class="group relative w-full flex items-center bg-canvas border border-border hover:border-accent/50 rounded-xl py-2.5 pl-3.5 pr-3 text-sm text-muted cursor-pointer transition-all duration-150 text-left gap-2.5 shadow-sm hover:shadow-none"
            title="Search anything (Ctrl+K)"
          >
            <svg class="w-4 h-4 shrink-0 text-muted group-hover:text-accent transition-colors duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="truncate flex-1 select-none text-[13px] text-muted">
              Search exams, admit cards, results...
            </span>
            <kbd class="hidden md:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] text-muted bg-surface-raised border border-border rounded-md font-mono font-medium shrink-0">
              Ctrl K
            </kbd>
          </button>
        </div>
      </div>
    )}

    {/* ── Right: Toggles + Actions ── */}
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">

      {/* Desktop-only: Language switcher + Theme toggle (Standard mode only) */}
      {!isEditorialTheme && (
        <div class="hidden lg:flex items-center gap-2 mr-1">
          {/* Language Switcher */}
          <div
            class="inline-flex items-center p-0.5 bg-canvas border border-border/80 rounded-lg select-none shrink-0"
            role="group"
            aria-label="Language selection"
          >
            <button
              type="button"
              data-app-lang="hinglish"
              class="app-lang-btn px-2.5 py-1 rounded-md text-[11px] font-bold cursor-pointer transition-colors"
              title="Switch to Hinglish"
              aria-pressed="true"
            >
              HI
            </button>
            <button
              type="button"
              data-app-lang="en"
              class="app-lang-btn px-2.5 py-1 rounded-md text-[11px] font-semibold cursor-pointer transition-colors"
              title="Switch to English"
              aria-pressed="false"
            >
              EN
            </button>
          </div>

          {/* Theme Toggle */}
          <button
            type="button"
            class="theme-toggle-btn relative w-13 h-7 bg-canvas border border-border/80 hover:border-accent/40 rounded-full p-0.5 flex items-center cursor-pointer transition-all duration-150 focus:outline-none shrink-0"
            title="Toggle Dark and Light Mode"
            aria-label="Toggle Dark and Light Mode"
          >
            <span class="theme-toggle-knob w-5 h-5 rounded-full bg-surface-raised border border-border text-white flex items-center justify-center text-xs shadow-sm transition-transform duration-200 translate-x-0.5">
              <span class="light-icon text-[11px] select-none leading-none">☀️</span>
              <span class="dark-icon text-[11px] select-none leading-none hidden">🌙</span>
            </span>
          </button>
        </div>
      )}

      {/* Favorites (standard desktop only) */}
      {!isEditorialTheme && (
        <div class="hidden lg:flex items-center relative z-[1090]">
          <button
            id="header-favorites-btn"
            type="button"
            class="relative w-9 h-9 flex items-center justify-center rounded-xl bg-canvas border border-border/80 hover:border-accent/40 text-muted hover:text-heading transition-all duration-150 cursor-pointer shadow-sm hover:shadow-none focus:outline-none hover:bg-surface-raised"
            title="Saved Favorites"
            aria-label="Saved Favorites"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <svg class="w-4 h-4 hover:text-rose-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span class="favorites-count-badge hidden absolute -top-1 -right-1 px-1 min-w-[16px] h-4 rounded-full bg-rose-500 text-[9px] font-bold text-white flex items-center justify-center leading-none shadow-xs border border-surface">
              0
            </span>
          </button>
          <FavoritesDropdown id="header-favorites-dropdown" />
        </div>
      )}

      {/* Notifications (Desktop/tablet only; mobile access is inside drawer) */}
      <div class="hidden md:flex items-center relative z-[1090]">
        <button
          id="header-notification-btn"
          data-notification-trigger="header-notification-popup"
          type="button"
          class={`group relative w-8.5 h-8.5 flex items-center justify-center rounded-xl transition-all duration-150 cursor-pointer shadow-2xs hover:shadow-none focus:outline-none ${
            isEditorialTheme
              ? 'bg-editorial-surface border border-editorial-border text-editorial-muted hover:text-editorial-heading hover:border-editorial-accent/40'
              : 'bg-canvas border border-border/80 hover:border-accent/40 text-muted hover:text-heading hover:bg-surface-raised'
          }`}
          title="Notifications"
          aria-label="Notifications"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <svg class="w-4 h-4 group-hover:text-editorial-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span class="notification-dot-indicator absolute -top-0.5 -right-0.5 flex h-2 w-2 hidden pointer-events-none z-10">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-editorial-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-editorial-accent"></span>
          </span>
          <span class="notification-badge-count absolute -top-1 -right-1 px-1 min-w-[15px] h-3.5 rounded-full bg-editorial-accent text-[8px] font-bold text-white hidden items-center justify-center leading-none">0</span>
        </button>
        <NotificationPopup id="header-notification-popup" prefix="header" />
      </div>

      {/* Profile (logged in) */}
      <div id="header-profile-section" class="header-auth-logged-in relative z-[1100]">
        <button
          id="header-profile-trigger"
          data-profile-trigger="header-profile-dropdown"
          type="button"
          class={`flex min-h-[38px] sm:min-h-[42px] items-center gap-2 pl-1 pr-2.5 py-0.5 rounded-full transition cursor-pointer select-none font-['Geist'] touch-manipulation ${
            isEditorialTheme 
              ? 'hover:bg-black/5 dark:hover:bg-white/5' 
              : 'hover:bg-surface-raised border border-border/60 hover:border-border'
          }`}
          aria-label="Open User Profile Menu"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span class="user-avatar-initials header-profile-initials size-7.5 sm:size-8 rounded-full bg-editorial-accent text-white inline-flex items-center justify-center text-center text-[11px] sm:text-[12px] font-bold leading-none uppercase shrink-0">
            U
          </span>
          <div class="hidden sm:flex flex-col text-left leading-none">
            <span class="user-display-name text-[12px] font-bold text-heading truncate max-w-[120px]">User</span>
            <span class="user-display-role text-[10px] text-muted capitalize mt-0.5">Aspirant</span>
          </div>
          <svg class="profile-chevron-arrow size-3.5 text-muted shrink-0 transition-transform duration-200 ease-out" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
        <ProfileDropdown id="header-profile-dropdown" position="top" isEditorialTheme={isEditorialTheme} />
      </div>

      {/* Log in / Get Started (Single CTA button) */}
      <div class="header-auth-logged-out flex items-center shrink-0">
        <a
          href={loginHref}
          id="header-login-btn"
          data-login-link
          data-astro-prefetch="hover"
          class={`inline-flex min-h-[32px] sm:min-h-9 items-center justify-center rounded-full ${
            isEditorialTheme 
              ? 'bg-editorial-accent hover:bg-editorial-accent-hover' 
              : 'bg-accent hover:bg-accent/90'
          } px-3 sm:px-4.5 font-['Geist'] text-[11px] sm:text-[13px] font-semibold text-white transition-all shadow-xs hover:shadow-sm active:scale-[0.98] whitespace-nowrap touch-manipulation`}
          title="Get Started / Log in"
        >
          <span>Get Started</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function syncHeaderState() {
      var brandEl = document.getElementById('header-brand-name');
      var path = window.location.pathname.replace(/\/$/, '') || '/';
      var isHome = path === '/';
      if (brandEl) {
        if (isHome) {
          brandEl.classList.remove('hidden');
          brandEl.classList.add('flex');
        } else {
          brandEl.classList.add('hidden');
          brandEl.classList.remove('flex');
        }
      }

      var navLinks = document.querySelectorAll('header#main-header nav a[data-header-nav-link]');
      var activeClasses = ['text-editorial-heading', 'font-semibold', "after:content-['']", 'after:absolute', 'after:bottom-0', 'after:left-0', 'after:right-0', 'after:h-[2px]', 'after:bg-editorial-accent', 'after:rounded-full'];
      var inactiveClasses = ['text-editorial-subheading', 'hover:text-editorial-heading'];

      navLinks.forEach(function (link) {
        var href = link.getAttribute('href');
        var isActive = false;
        if (href === '/blogs') {
          isActive = path === '/blogs' || path.startsWith('/blogs/') || path.startsWith('/category/');
        } else if (href === '/test-series') {
          isActive = path === '/test-series' || path.startsWith('/test-series/');
        } else if (href === '/daily-quiz') {
          isActive = path === '/daily-quiz' || path.startsWith('/daily-quiz/');
        }

        if (isActive) {
          inactiveClasses.forEach(function (c) { link.classList.remove(c); });
          activeClasses.forEach(function (c) { link.classList.add(c); });
        } else {
          activeClasses.forEach(function (c) { link.classList.remove(c); });
          inactiveClasses.forEach(function (c) { link.classList.add(c); });
        }
      });
    }

    document.addEventListener('astro:page-load', syncHeaderState);
    document.addEventListener('astro:after-swap', syncHeaderState);
    window.addEventListener('popstate', syncHeaderState);
    syncHeaderState();
  })();
</script>
