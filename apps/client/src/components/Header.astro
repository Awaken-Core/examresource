---
import Tooltip from './Tooltip.astro';
import BrandLogo from './BrandLogo.astro';
import ProfileDropdown from './ProfileDropdown.astro';
import NotificationPopup from './NotificationPopup.astro';
import FavoritesDropdown from './FavoritesDropdown.astro';
import { siteDomain } from '../data/site';

interface Props {
  hideDesktopSidebar?: boolean;
}

const { hideDesktopSidebar = false } = Astro.props;
const [brandPrefix, ...brandRest] = siteDomain.split('.');
const brandSuffix = brandRest.length > 0 ? `.${brandRest.join('.')}` : '';
---

<header id="main-header" class="bg-surface border-b border-border sticky top-0 z-[1000] shadow-2xs relative h-14 sm:h-16">
  {/* Main Navbar */}
  <div class="w-full flex items-center justify-between h-14 sm:h-16">
    
    {/* Left: Mobile Drawer Button + Brand */}
    <div class="flex items-center shrink-0 min-w-0">
      {/* Mobile Drawer Toggle (visible ONLY on mobile/tablet screens) */}
      <button 
        id="mobile-drawer-toggle-btn"
        data-sidebar-toggle
        type="button"
        class="lg:hidden ml-3 sm:ml-4 text-muted hover:text-white p-2 rounded-xl hover:bg-surface-raised border border-border/60 transition cursor-pointer flex items-center justify-center shrink-0"
        title="Open Menu"
        aria-label="Open Navigation Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {/* Brand Logo — visible on all screens when desktop sidebar is hidden, or mobile-only when desktop sidebar is active */}
      <a href="/" class={`${hideDesktopSidebar ? 'flex' : 'lg:hidden flex'} items-center gap-2 ml-2.5 sm:ml-4 group shrink-0`} aria-label={`${siteDomain} home`}>
        <BrandLogo size={30} class="group-hover:scale-105 transition-transform shrink-0" />
        <span class="flex items-center font-bold text-sm tracking-tight text-white">
          {brandPrefix}<span class="text-accent">{brandSuffix}</span>
        </span>
      </a>

      {/* Collapsed State Desktop Expand Button in Corner (only when desktop sidebar is enabled) */}
      {!hideDesktopSidebar && (
        <div id="header-brand-collapsed" class="hidden items-center pl-3 sm:pl-4 shrink-0">
          <button 
            id="toolbar-sidebar-expand-btn"
            data-sidebar-toggle
            type="button"
            class="text-muted hover:text-white p-1.5 rounded-lg hover:bg-surface-raised border border-border/60 hover:border-border transition cursor-pointer shrink-0 flex items-center justify-center"
            title="Expand sidebar (Alt+B)"
            aria-label="Expand sidebar (Alt+B)"
          >
            <svg class="w-4 h-4 text-muted hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="2"/>
              <line x1="9" y1="3" x2="9" y2="21" stroke-width="2"/>
            </svg>
          </button>
        </div>
      )}
    </div>

    {/* Center: Search Section — visible on ALL screen sizes */}
    <div class="flex flex-1 items-center justify-center px-2 sm:px-6 min-w-0">
      <div class="w-full max-w-xl">
        <button 
          id="desktop-search-trigger"
          data-open-search
          type="button"
          class="relative w-full flex items-center bg-surface border border-border hover:border-accent/40 rounded-lg py-2 pl-3 pr-2.5 text-body-sm text-muted cursor-pointer transition text-left gap-2"
          title="Search anything (Ctrl+K)"
        >
          <svg class="w-4 h-4 shrink-0 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>

          <span class="truncate flex-1 select-none text-xs sm:text-sm text-muted">
            Search exams, results...
          </span>

          {/* Shortcut Key Badge */}
          <kbd class="hidden md:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] text-muted bg-surface-raised border border-border rounded font-mono font-medium shrink-0">
            <span>Ctrl K</span>
          </kbd>
        </button>
      </div>
    </div>

    {/* Right Toolbar Items: Desktop Toggles, Favorites, Notifications, Profile & Log in */}
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0 px-2 sm:px-4">
      {/* Desktop Header Toggles: Language & Theme (Hidden on mobile & tablet; available in sidebar drawer) */}
      <div class="hidden lg:flex items-center gap-2 mr-1">
        {/* Language Switcher Pill */}
        <div class="inline-flex items-center p-0.5 bg-canvas border border-border/80 rounded-lg text-xs font-semibold select-none shrink-0" role="group" aria-label="Language selection">
          <button
            type="button"
            data-app-lang="hinglish"
            class="app-lang-btn px-2.5 py-1 rounded-md text-[11px] font-semibold cursor-pointer bg-accent !text-white"
            title="Switch to Hinglish"
            aria-pressed="true"
          >
            HI
          </button>
          <button
            type="button"
            data-app-lang="en"
            class="app-lang-btn px-2.5 py-1 rounded-md text-[11px] font-semibold cursor-pointer text-muted hover:text-white"
            title="Switch to English"
            aria-pressed="false"
          >
            EN
          </button>
        </div>

        {/* Theme Toggle Button */}
        <button
          type="button"
          class="theme-toggle-btn relative w-13 h-7 bg-canvas border border-border/80 hover:border-accent/40 rounded-pill p-0.5 flex items-center cursor-pointer transition-colors focus:outline-none shrink-0"
          title="Toggle Dark and Light Mode"
          aria-label="Toggle Dark and Light Mode"
        >
          <span
            class="theme-toggle-knob w-5 h-5 rounded-full bg-surface-raised border border-border text-white flex items-center justify-center text-xs shadow-2xs transition-transform duration-200 translate-x-0.5"
          >
            <span class="light-icon text-[11px] select-none leading-none">☀️</span>
            <span class="dark-icon text-[11px] select-none leading-none hidden">🌙</span>
          </span>
        </button>
      </div>

      {/* Bookmarks / Favorites Button & Dropdown (Desktop only) */}
      <div class="hidden lg:flex items-center relative z-[1090]">
        <button 
          id="header-favorites-btn"
          type="button"
          class="relative w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-xl bg-canvas border border-border/80 hover:border-accent/40 text-muted hover:text-white transition cursor-pointer shadow-2xs focus:outline-none hover:bg-surface-raised"
          title="Saved Favorites"
          aria-label="Saved Favorites"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <svg class="w-4 h-4 text-muted hover:text-rose-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span class="favorites-count-badge hidden absolute -top-1 -right-1 px-1 min-w-[16px] h-4 rounded-full bg-rose-500 text-[9px] font-bold text-white flex items-center justify-center leading-none shadow-xs border border-surface">
            0
          </span>
        </button>

        {/* Dropdown Container */}
        <FavoritesDropdown id="header-favorites-dropdown" />
      </div>

      {/* Notifications Button & Dropdown (Desktop only) */}
      <div class="hidden lg:flex items-center relative z-[1090]">
        <button 
          id="header-notification-btn"
          data-notification-trigger="header-notification-popup"
          type="button"
          class="group relative w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-xl bg-canvas border border-border/80 hover:border-accent/40 text-muted hover:text-white transition cursor-pointer shadow-2xs focus:outline-none hover:bg-surface-raised"
          title="Notifications"
          aria-label="Notifications"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <svg class="w-4 h-4 text-muted group-hover:text-accent transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span class="notification-dot-indicator absolute top-1.5 right-1.5 flex h-2 w-2 hidden pointer-events-none z-10">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          <span class="notification-badge-count sr-only">0</span>
        </button>

        {/* Header Notification Popover */}
        <NotificationPopup id="header-notification-popup" prefix="header" />
      </div>

      {/* TOP RIGHT PROFILE SECTION & DROPDOWN (Shown when user is logged in) */}
      <div id="header-profile-section" class="header-auth-logged-in hidden relative z-[1100]">
        <button 
          id="header-profile-trigger"
          data-profile-trigger="header-profile-dropdown"
          type="button"
          class="header-profile-avatar-btn w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-surface-raised border border-border text-white font-bold flex items-center justify-center transition cursor-pointer shadow-xs focus:outline-none focus:ring-2 focus:ring-accent/40 select-none overflow-hidden shrink-0 hover:border-accent/40"
          aria-label="Open User Profile Menu"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span class="user-avatar-initials header-profile-initials inline-flex items-center justify-center text-center text-xs sm:text-[13px] font-bold leading-none uppercase">U</span>
        </button>

        {/* Mount Dropdown at Top */}
        <ProfileDropdown id="header-profile-dropdown" position="top" />
      </div>

      {/* Modern "Log in" / "Get Started" Button (Shown when user is NOT logged in) */}
      <div class="header-auth-logged-out flex items-center">
        <a 
          href="/login"
          id="header-login-btn"
          class="group inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-1.5 rounded-xl bg-accent hover:bg-accent/90 text-[#ffffff] font-semibold text-xs shadow-xs hover:shadow-sm transition-all duration-150 shrink-0 cursor-pointer"
          title="Log in / Get Started"
        >
          <span class="tracking-tight sm:hidden">Log in</span>
          <span class="tracking-tight hidden sm:inline">Get Started</span>
          <svg 
            class="w-3.5 h-3.5 text-[#ffffff] transition-transform duration-200 ease-out group-hover:translate-x-1" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2.5" 
            stroke-linecap="round" 
            stroke-linejoin="round"
          >
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
