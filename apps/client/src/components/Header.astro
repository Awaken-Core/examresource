---
import ProfileDropdown from './ProfileDropdown.astro';
import Tooltip from './Tooltip.astro';
---

<header class="bg-surface border-b border-border sticky top-0 md:top-9 z-[1000] shadow-sm relative h-16">
  {/* Main Navbar */}
  <div class="w-full flex items-center justify-between h-16">
    
    {/* Left: Mobile Drawer Button + Header Brand (Exact same w-64 px-4 justify-between as LeftSidebar!) */}
    <div class="flex items-center shrink-0">
      {/* Mobile Drawer Toggle (visible ONLY on mobile screens) */}
      <button 
        id="mobile-drawer-toggle-btn"
        data-sidebar-toggle
        type="button"
        class="lg:hidden ml-4 text-muted hover:text-white p-2 rounded-xl hover:bg-surface-raised border border-border/60 transition cursor-pointer flex items-center justify-center"
        title="Open Menu"
        aria-label="Open Navigation Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {/* Collapsed State Header Brand & Expand Toggle (Exact same coordinates as LeftSidebar header!) */}
      <div id="header-brand-collapsed" class="hidden h-16 w-64 px-4 items-center justify-between border-r border-border/60 shrink-0">
        {/* Brand Logo & Name */}
        <a href="/" class="flex items-center gap-2.5 group truncate">
          <div class="w-7 h-7 rounded-lg bg-accent/15 border border-accent/30 flex items-center justify-center text-accent shrink-0 shadow-sm group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div class="flex items-center truncate font-bold text-base tracking-tight text-white">
            <span>govtpariksha</span><span class="text-accent">.com</span>
          </div>
        </a>

        {/* Desktop Sidebar Expand Button with Tooltip */}
        <div class="relative group" id="header-sidebar-toggle-wrapper">
          <button 
            id="toolbar-sidebar-expand-btn"
            data-sidebar-toggle
            type="button"
            class="text-muted hover:text-white p-1.5 rounded-lg hover:bg-surface-raised border border-border/60 hover:border-border transition cursor-pointer shrink-0 flex items-center justify-center"
            aria-label="Expand sidebar (Alt+B)"
          >
            <svg class="w-4 h-4 text-muted hover:text-white transition" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke-width="2"/>
              <line x1="9" y1="3" x2="9" y2="21" stroke-width="2"/>
            </svg>
          </button>
          <Tooltip id="sidebar-toggle-tooltip" textId="sidebar-toggle-tooltip-text" text="Expand sidebar" shortcut={['Alt', 'B']} position="bottom" />
        </div>
      </div>
    </div>

    {/* Center: Search Section in Mid */}
    <div class="hidden md:flex flex-1 items-center justify-center px-4 min-w-0">
      <div class="w-full max-w-md lg:max-w-lg">
        <button 
          id="desktop-search-trigger"
          data-open-search
          type="button"
          class="relative w-full flex items-center justify-between bg-surface-raised hover:bg-surface-elevated border border-border/80 hover:border-border rounded-pill py-2 pl-3 pr-3 text-body-sm text-muted cursor-pointer transition shadow-2xs text-left"
          title="Search anything (Ctrl+K)"
        >
          {/* Search Icon with its own Tooltip */}
          <div class="relative group flex items-center justify-center p-1 -m-1 rounded-md text-muted hover:text-white transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <Tooltip text="Search" position="bottom" />
          </div>

          <span class="truncate pl-2.5 flex-1 select-none">Search exams, notifications, results...</span>

          {/* Shortcut Key Badge with its own Tooltip */}
          <div class="relative group hidden sm:inline-flex items-center">
            <kbd class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] text-muted hover:text-white bg-canvas hover:bg-surface-elevated border border-border rounded font-mono font-bold transition">
              <span>Ctrl</span><span>K</span>
            </kbd>
            <Tooltip text="Quick Search" shortcut={['Ctrl', 'K']} position="bottom" />
          </div>
        </button>
      </div>
    </div>

    {/* Right Toolbar Items: Quick links, Upgrade badge, Language, Favorites, and Profile Avatar */}
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0 px-4 sm:px-6">
      <nav class="hidden xl:flex items-center gap-3 font-medium text-body-sm">
        <a href="/" class="nav-link">Home</a>
        <a href="#state-filter-widget" class="nav-link-muted">State Updates</a>
        <a href="#important-links" class="nav-link-muted">Admissions</a>
        <a href="#quick-info" class="nav-link-muted">Results</a>
      </nav>

      {/* Upgrade / Plus Pill Button (Matching screenshot toolbar) */}
      <a 
        href="#important-links"
        class="hidden sm:inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#241e12] border border-[#59441a] text-[#f5a623] hover:bg-[#332a18] text-xs font-semibold shrink-0 transition shadow-2xs"
      >
        <span>✨</span>
        <span>Upgrade</span>
      </a>

      {/* Language Switcher (English / Hindi) */}
      <div class="relative" id="header-language-container">
        <div class="relative group">
          <button 
            id="header-language-btn"
            type="button"
            class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-surface-raised/50 hover:bg-surface-raised border border-border/60 hover:border-border text-xs font-semibold text-muted hover:text-white transition cursor-pointer"
            aria-label="Change Language"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <svg class="w-3.5 h-3.5 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9c-.933-2.128-2.15-4.24-3.5-6.147M13 14l3.5 8m0 0l3.5-8m-3.5 8v-8M21 5h-4M17 3v2" />
            </svg>
            <span id="current-language-label" class="font-bold tracking-tight text-white uppercase text-[11px]">EN</span>
            <svg class="w-3 h-3 text-muted transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <Tooltip text="Language (EN / HI)" position="bottom" />
        </div>

        {/* Language Dropdown Menu */}
        <div 
          id="header-language-dropdown" 
          class="hidden absolute right-0 top-full mt-2 w-44 bg-surface border border-border rounded-2xl shadow-elevated p-1.5 z-[1200] transition-all duration-150 transform scale-95 opacity-0 select-none"
        >
          <div class="px-2.5 py-1.5 text-[11px] font-semibold text-muted border-b border-border/40 mb-1">
            Select Language
          </div>
          <button 
            type="button" 
            data-lang-option="en"
            class="language-option-btn w-full flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium hover:bg-surface-raised text-white transition cursor-pointer text-left"
          >
            <div class="flex items-center gap-2">
              <span>🇬🇧</span>
              <span>English</span>
            </div>
            <svg class="lang-check-en w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </button>
          <button 
            type="button" 
            data-lang-option="hi"
            class="language-option-btn w-full flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium hover:bg-surface-raised text-muted hover:text-white transition cursor-pointer text-left"
          >
            <div class="flex items-center gap-2">
              <span>🇮🇳</span>
              <span>हिन्दी (Hindi)</span>
            </div>
            <svg class="lang-check-hi w-3.5 h-3.5 text-accent hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </div>
      </div>

      {/* Favorites / Saved Notices Button */}
      <div class="relative" id="header-favorites-container">
        <div class="relative group">
          <button 
            id="header-favorites-btn"
            type="button"
            class="p-2 rounded-xl bg-surface-raised/50 hover:bg-surface-raised border border-border/60 hover:border-border text-muted hover:text-amber-400 transition cursor-pointer flex items-center justify-center relative"
            title="Saved Favorites"
            aria-label="Saved Favorites"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            <span id="header-favorites-count-badge" class="hidden absolute -top-1 -right-1 w-4 h-4 rounded-full bg-accent text-[9px] font-bold text-white flex items-center justify-center border border-surface leading-none">
              0
            </span>
          </button>
          <Tooltip text="Favorites" position="bottom" />
        </div>

        {/* Favorites Popover */}
        <div 
          id="header-favorites-dropdown"
          class="hidden absolute right-0 top-full mt-2 w-72 bg-surface border border-border rounded-2xl shadow-elevated p-3.5 z-[1200] transition-all duration-150 transform scale-95 opacity-0 select-none"
        >
          <div class="flex items-center justify-between pb-2.5 border-b border-border/50 mb-2.5">
            <h4 class="text-xs font-semibold text-white">Favorite Notices</h4>
            <span class="text-[10px] text-muted font-medium" id="favorites-count-label">0 saved</span>
          </div>
          <div id="favorites-list-empty" class="py-4 text-center">
            <span class="text-2xl">⭐</span>
            <p class="mt-2 text-xs font-medium text-white">No favorites yet</p>
            <p class="text-[11px] text-muted mt-0.5">Click star on notices to save them here for quick access.</p>
          </div>
        </div>
      </div>

      {/* TOP RIGHT PROFILE SECTION & DROPDOWN (Shown ONLY when user is logged in) */}
      <div id="header-profile-section" class="header-auth-logged-in hidden relative z-[1100]">
        <button 
          id="header-profile-trigger"
          data-profile-trigger="header-profile-dropdown"
          type="button"
          class="header-profile-avatar-btn w-9 h-9 rounded-full bg-surface-raised border border-border hover:border-accent text-white flex items-center justify-center font-bold text-caption-xs transition cursor-pointer shadow-xs focus:outline-none focus:ring-2 focus:ring-accent/40 overflow-hidden"
          aria-label="Open User Profile Menu"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span class="user-avatar-initials">GP</span>
          <img class="user-avatar-img hidden w-full h-full object-cover" alt="Profile" />
        </button>

        {/* Mount Dropdown at Top */}
        <ProfileDropdown id="header-profile-dropdown" position="top" />
      </div>

      {/* Modern "Get Started >" Button (Shown when user is NOT logged in) */}
      <div class="header-auth-logged-out flex items-center">
        <a 
          href="/login"
          id="header-login-btn"
          class="group inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-accent hover:bg-accent/90 text-[#ffffff] font-semibold text-xs shadow-xs hover:shadow-sm transition-all duration-150 shrink-0 cursor-pointer"
          title="Get Started on govtpariksha.com"
        >
          <span class="tracking-tight">Get Started</span>
          <svg 
            class="w-3.5 h-3.5 text-[#ffffff] transition-transform duration-200 ease-out group-hover:translate-x-1" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2.5" 
            stroke-linecap="round" 
            stroke-linejoin="round"
          >
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  {/* Mobile Dropdown Search */}
  <div id="mobile-search-bar" class="md:hidden border-t border-border bg-surface px-4 py-2">
    <button 
      type="button"
      data-open-search
      class="relative w-full flex items-center bg-surface-raised border border-border rounded-xl py-2 pl-9 pr-3 text-body-sm text-muted cursor-pointer text-left"
    >
      <svg class="w-4 h-4 text-muted absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span>Search exams on govtpariksha.com...</span>
    </button>
  </div>
</header>
