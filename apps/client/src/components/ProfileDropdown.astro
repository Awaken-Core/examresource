---
interface Props {
  id?: string;
  position?: "top" | "bottom" | "mobile";
}

const { id = "profile-dropdown", position = "top" } = Astro.props;
---

<div
  id={id}
  data-profile-dropdown={id}
  class={`hidden absolute ${
    position === "bottom"
      ? "left-[calc(100%+12px)] bottom-0 w-64"
      : position === "mobile"
        ? "left-0 bottom-full mb-2 w-full max-w-[260px]"
        : "top-full right-0 mt-2 w-64"
  } bg-surface border border-border rounded-2xl shadow-elevated p-2 z-[9999] transition-all duration-150 transform scale-95 opacity-0 select-none`}
  role="menu"
  aria-orientation="vertical"
>
  {/* Left pointer notch when positioned to the right of the sidebar */}
  {
    position === "bottom" && (
      <div class="absolute -left-1.5 bottom-6 w-3 h-3 bg-surface border-l border-b border-border rotate-45 pointer-events-none" />
    )
  }

  {/* Clean User Identity Header */}
  <div class="px-3 py-2.5 border-b border-border/50 mb-1">
    <div class="flex items-center gap-2.5">
      <div
        class="w-8 h-8 rounded-full bg-accent/15 dark:bg-accent/25 border border-accent/40 text-accent font-bold flex items-center justify-center shrink-0 overflow-hidden shadow-xs select-none"
      >
        <span
          class="user-avatar-initials inline-flex items-center justify-center text-center text-xs font-bold leading-none uppercase text-accent"
          >U</span
        >
      </div>
      <div class="truncate flex-1">
        <p
          class="user-display-name text-body-sm font-bold text-slate-900 leading-tight truncate dark:text-slate-100"
        >
          User
        </p>
        <p class="user-display-email text-[11px] text-muted truncate">Free</p>
      </div>
    </div>
  </div>

  {/* Clean Minimal Options */}
  <div class="space-y-0.5">
    <a
      href="/profile"
      class="auth-logged-in-only hidden w-full items-center gap-3 rounded-xl px-3 py-2 text-body-sm text-slate-900 hover:bg-surface-raised [&:not(.hidden)]:flex dark:text-slate-100"
    >
      <svg
        class="h-4 w-4 shrink-0 text-muted"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      <span class="min-w-0 truncate font-medium">My Preparation</span>
    </a>

    {
      /* Admin-only navigation: revealed only after the server confirms the role */
    }
    <a
      href="/administrator"
      class="admin-panel-link hidden w-full items-center gap-3 rounded-xl px-3 py-2 text-body-sm text-slate-900 hover:bg-surface-raised [&:not(.hidden)]:flex dark:text-slate-100"
    >
      <svg
        class="h-4 w-4 shrink-0 text-muted"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 3l7 4v5c0 4.55-2.99 7.9-7 9-4.01-1.1-7-4.45-7-9V7l7-4z"></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9.5 12l1.5 1.5 3.5-3.5"></path>
      </svg>
      <span class="min-w-0 truncate font-medium">Open Desk</span>
    </a>


    {/* Saved Articles / Favorites link */}
    <a
      href="/favorites"
      class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2 text-left text-body-sm text-slate-900 hover:bg-surface-raised dark:text-slate-100"
    >
      <div class="flex min-w-0 items-center gap-3">
        <svg class="h-4 w-4 shrink-0 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <span class="min-w-0 truncate font-medium">Saved Favorites</span>
      </div>

      <span class="favorites-count-badge hidden px-1.5 py-0.5 rounded-full bg-rose-500/15 text-rose-400 text-[10px] font-bold border border-rose-500/30 leading-none">0</span>

    </a>

    {/* Notifications link */}
    <a
      href="/notifications"
      class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2 text-left text-body-sm text-slate-900 hover:bg-surface-raised dark:text-slate-100"
    >
      <div class="flex min-w-0 items-center gap-3">
        <svg
          class="h-4 w-4 shrink-0 text-muted"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          ></path>
        </svg>
        <span class="min-w-0 truncate font-medium">Notifications</span>
      </div>
      <span
        class="notification-badge-count hidden px-1.5 py-0.5 rounded-full bg-accent/15 text-accent text-[10px] font-bold border border-accent/30 leading-none"
        >0</span
      >
    </a>

    {/* Auth Action: Sign in or Logout */}
    <div class="border-t border-border/60 mt-1 pt-1">
      <button
        type="button"
        data-auth-action="logout"
        class="auth-logout-btn hidden w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-body-sm text-red-500 hover:bg-red-500/10 [&:not(.hidden)]:flex"
      >
        <svg
          class="w-4 h-4 text-red-500 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
          ></path>
        </svg>
        <span class="font-medium">Logout</span>
      </button>

      <a
        href="/login"
        data-login-link
        data-auth-action="login"
        class="auth-login-link flex w-full items-center gap-3 px-3 py-2 rounded-xl text-body-sm text-accent hover:bg-accent/10 transition font-medium"
      >
        <svg
          class="w-4 h-4 text-accent shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
          ></path>
        </svg>
        <span>Sign In / Register</span>
      </a>
    </div>
  </div>
</div>
