---
interface Props {
  id?: string;
  position?: 'top' | 'bottom' | 'mobile';
}

const { id = "profile-dropdown", position = "top" } = Astro.props;
---

<div 
  id={id} 
  data-profile-dropdown={id}
  class={`hidden absolute ${
    position === 'bottom'
      ? 'left-[calc(100%+12px)] bottom-0 w-64'
      : position === 'mobile'
      ? 'left-0 bottom-full mb-2 w-full max-w-[260px]'
      : 'top-full right-0 mt-2 w-64'
  } bg-surface border border-border rounded-2xl shadow-elevated p-2 z-[9999] transition-all duration-150 transform scale-95 opacity-0 select-none`}
  role="menu"
  aria-orientation="vertical"
>
  {/* Left pointer notch when positioned to the right of the sidebar (Image 3) */}
  {position === 'bottom' && (
    <div class="absolute -left-1.5 bottom-6 w-3 h-3 bg-surface border-l border-b border-border rotate-45 pointer-events-none"></div>
  )}

  {/* User summary header */}
  <div class="px-3 py-2 border-b border-border/50 mb-1">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-full bg-surface-raised border border-border text-white font-bold flex items-center justify-center shrink-0 overflow-hidden shadow-xs select-none">
        <span class="user-avatar-initials inline-flex items-center justify-center text-center text-xs font-bold leading-none uppercase">DW</span>
      </div>
      <div class="truncate flex-1">
        <p class="user-display-name text-body-sm font-bold text-white leading-tight truncate">Devil</p>
        <p class="user-display-email text-[11px] text-muted truncate">Free</p>
      </div>
    </div>
  </div>

  <div class="space-y-0.5">
    {/* Profile */}
    <button 
      type="button" 
      class="w-full flex items-center gap-3 px-3 py-2 rounded-xl text-body-sm text-white hover:bg-surface-raised transition group cursor-pointer text-left"
    >
      <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <span>Profile</span>
    </button>

    {/* Notifications */}
    <button 
      type="button" 
      class="w-full flex items-center gap-3 px-3 py-2 rounded-xl text-body-sm text-white hover:bg-surface-raised transition group cursor-pointer text-left"
    >
      <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <span>Notifications</span>
    </button>

    {/* Admin-only navigation: revealed only after the server confirms the role. */}
    <a
      href="/admin"
      class="admin-panel-link hidden items-center gap-3 px-3 py-2 rounded-xl text-body-sm text-white hover:bg-surface-raised transition group"
    >
      <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l7 4v5c0 4.55-2.99 7.9-7 9-4.01-1.1-7-4.45-7-9V7l7-4z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.5 12l1.5 1.5 3.5-3.5" />
      </svg>
      <span>Admin panel</span>
    </a>

    {/* Account */}
    <button 
      type="button" 
      class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-body-sm text-white hover:bg-surface-raised transition group cursor-pointer text-left"
    >
      <div class="flex items-center gap-3">
        <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Account</span>
      </div>
      <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    {/* Troubleshooting */}
    <a 
      href="/contact-us" 
      class="flex items-center gap-3 px-3 py-2 rounded-xl text-body-sm text-white hover:bg-surface-raised transition group"
    >
      <svg class="w-4 h-4 text-muted group-hover:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
      </svg>
      <span>Troubleshooting</span>
    </a>

    {/* Language + Theme (side by side) */}
    <div class="flex items-stretch gap-1 px-1.5 py-1">
      <div class="flex-1 flex flex-col gap-1.5 px-1.5 py-1.5 rounded-xl hover:bg-surface-raised transition">
        <div class="flex items-center gap-1.5 text-[11px] font-medium text-muted">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span>Language</span>
        </div>
        <div class="inline-flex items-center p-0.5 bg-canvas border border-border rounded-lg text-xs font-semibold select-none w-full" role="group" aria-label="Language">
          <button
            type="button"
            data-app-lang="hinglish"
            class="app-lang-btn flex-1 px-2 py-1 rounded-md text-[11px] font-semibold transition-all cursor-pointer text-muted hover:text-white"
            title="Switch to Hinglish"
          >
            HI
          </button>
          <button
            type="button"
            data-app-lang="en"
            class="app-lang-btn flex-1 px-2 py-1 rounded-md text-[11px] font-semibold transition-all cursor-pointer text-muted hover:text-white"
            title="Switch to English"
          >
            EN
          </button>
        </div>
      </div>

      <div class="flex-1 flex flex-col gap-1.5 px-1.5 py-1.5 rounded-xl hover:bg-surface-raised transition">
        <div class="flex items-center gap-1.5 text-[11px] font-medium text-muted">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 5 5 0 013-4.582V9a7 7 0 0114 0v3.418A5 5 0 0121 17a4 4 0 01-4 4H7z" />
          </svg>
          <span>Theme</span>
        </div>
        <button
          type="button"
          class="theme-toggle-btn relative w-13 h-7 bg-canvas border border-border rounded-pill p-0.5 flex items-center cursor-pointer transition-colors focus:outline-none self-start"
          aria-label="Toggle Dark and Light Mode"
        >
          <span
            class="theme-toggle-knob w-5 h-5 rounded-full bg-surface-raised border border-border text-white flex items-center justify-center text-xs shadow-sm transition-transform duration-200 translate-x-0.5"
          >
            <span class="light-icon">☀️</span>
            <span class="dark-icon hidden">🌙</span>
          </span>
        </button>
      </div>
    </div>

    {/* Auth footer — one row at a time (guest vs signed-in) */}
    <div class="border-t border-border/60 mt-1 pt-1">
      <button
        type="button"
        data-auth-action="logout"
        class="auth-logout-btn hidden w-full items-center gap-3 px-3 py-2.5 rounded-xl text-body-sm text-red-500 hover:bg-red-500/10 transition cursor-pointer text-left"
      >
        <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span class="font-medium">Logout</span>
      </button>

      <a
        href="/login"
        data-auth-action="login"
        class="auth-login-link flex w-full items-center gap-3 px-3 py-2.5 rounded-xl text-body-sm text-accent hover:bg-accent/10 transition font-medium"
      >
        <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
        </svg>
        <span>Sign In / Register</span>
      </a>
    </div>
  </div>
</div>
