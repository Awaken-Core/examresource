---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<section id="faqs" class="mt-10 mb-8 scroll-mt-20">
  <div class="flex items-center gap-2 mb-4 pb-2 border-b-2 border-blue-600">
    <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h2 class="text-xl font-bold text-slate-900 !my-0 !border-0 !p-0">Frequently Asked Questions (FAQs)</h2>
  </div>

  <div class="space-y-3">
    {faqs.map((faq, i) => (
      <details class="group bg-white border border-slate-200 rounded-lg p-4 transition-all duration-200 hover:border-blue-300">
        <summary class="flex justify-between items-center font-semibold text-slate-900 cursor-pointer text-sm sm:text-base list-none">
          <span class="flex items-start gap-2.5">
            <span class="text-blue-700 font-bold">Q{i + 1}.</span>
            <span>{faq.question}</span>
          </span>
          <span class="ml-2 text-slate-400 group-open:rotate-180 transition-transform duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="mt-3 text-sm text-slate-600 leading-relaxed pl-7 border-t border-slate-100 pt-3">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>
