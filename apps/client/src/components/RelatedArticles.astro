---
interface Props {
  articles: { title: string; date: string; category: string; url: string }[];
}

const { articles } = Astro.props;
---

<section class="mt-8 mb-6">
  <div class="flex items-center gap-2 mb-4 pb-2 border-b border-border">
    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
    </svg>
    <h2 class="text-heading-lg font-bold text-white !my-0 !border-0 !p-0">Related Updates & Resources</h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {articles.map((item) => (
      <a 
        href={item.url} 
        class="card-flat p-4 hover:border-accent hover:shadow-elevated transition group block"
      >
        <div class="flex items-center justify-between text-caption-xs text-muted mb-2">
          <span class="badge-outline text-[11px]">
            {item.category}
          </span>
          <span>{item.date}</span>
        </div>
        <h3 class="text-body-md font-semibold text-white group-hover:text-accent transition line-clamp-2 leading-snug">
          {item.title}
        </h3>
        <span class="inline-flex items-center gap-1 text-caption-sm text-accent font-medium mt-3 group-hover:translate-x-0.5 transition-transform">
          Read Details →
        </span>
      </a>
    ))}
  </div>
</section>
