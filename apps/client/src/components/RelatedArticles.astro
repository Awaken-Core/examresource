---
interface Props {
  articles: { title: string; date: string; category: string; url: string }[];
}

const { articles } = Astro.props;
---

<section class="mt-8 mb-6">
  <div class="flex items-center gap-2 mb-4 pb-2 border-b-2 border-blue-600">
    <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
    </svg>
    <h2 class="text-xl font-bold text-slate-900 !my-0 !border-0 !p-0">Related Updates & Resources</h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {articles.map((item) => (
      <a 
        href={item.url} 
        class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-blue-400 hover:shadow-md transition group"
      >
        <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
          <span class="bg-blue-50 text-blue-700 font-semibold px-2 py-0.5 rounded text-[11px]">
            {item.category}
          </span>
          <span>{item.date}</span>
        </div>
        <h3 class="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition line-clamp-2 leading-snug">
          {item.title}
        </h3>
        <span class="inline-flex items-center gap-1 text-xs text-blue-600 font-medium mt-3 group-hover:translate-x-0.5 transition-transform">
          Read Details →
        </span>
      </a>
    ))}
  </div>
</section>
