---
import AdPlaceholder from './AdPlaceholder.astro';

interface Props {
  officialWebsite: string;
}

const { officialWebsite } = Astro.props;

const liveUpdates = [
  { text: "BCECE LE 2026 Round 1 Allotment Released", tag: "New", isHot: true },
  { text: "Bihar DECE Polytechnic Counseling Schedule", tag: "Active" },
  { text: "BCECE Agriculture & Pharmacy Rank Cards", tag: "Updated" },
  { text: "BSSC CGL 4 Notification Expected Soon", tag: "Alert" },
  { text: "Bihar Police Constable Re-exam Result Date", tag: "Notice" }
];
---

<aside class="space-y-6">
  {/* Sticky CTA Card for quick download */}
  <div class="card p-5 bg-gradient-to-b from-surface-raised to-surface border border-border shadow-elevated">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-block w-2 h-2 bg-success rounded-full animate-pulse"></span>
      <span class="text-caption-xs uppercase font-bold tracking-wider text-muted">Official Link Active</span>
    </div>
    <h3 class="text-heading-sm font-bold text-white leading-tight mb-2">Round 1 Allotment Order 2026</h3>
    <p class="text-body-xs text-muted mb-4 leading-relaxed">
      Download your provisional seat allotment letter and check verification reporting center.
    </p>
    <a 
      href="#important-links" 
      class="btn-primary w-full text-center block text-button-sm"
    >
      Download Allotment Letter
    </a>
  </div>

  {/* Ad Unit 1: Top Sidebar Ad (300x250) */}
  <div class="card-flat p-3">
    <AdPlaceholder slotId="sidebar-top-300x250" type="sidebar" label="Top Sidebar Ad Placement" />
  </div>

  {/* Trending Updates Widget */}
  <div class="card-flat p-4">
    <div class="flex items-center gap-2 pb-3 mb-3 border-b border-border">
      <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <h3 class="font-bold text-white text-body-md">Trending Exam Updates</h3>
    </div>
    <ul class="space-y-3 text-body-xs">
      {liveUpdates.map((item) => (
        <li class="flex items-start justify-between gap-2 border-b border-border/50 pb-2 last:border-0 last:pb-0">
          <a href="#" class="text-muted hover:text-white transition font-medium line-clamp-2">
            {item.text}
          </a>
          <span class={`text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0 ${
            item.isHot ? 'badge-accent' : 'badge-outline'
          }`}>
            {item.tag}
          </span>
        </li>
      ))}
    </ul>
  </div>

  {/* Telegram / Social community box */}
  <div class="card-flat p-4 bg-surface-raised/40">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-accent flex items-center justify-center text-white shrink-0 font-bold">
        📢
      </div>
      <div>
        <h4 class="text-body-md font-bold text-white">Join Exam Alerts Group</h4>
        <p class="text-caption-sm text-muted mt-0.5">Get direct PDF & link alerts on your mobile</p>
      </div>
    </div>
    <div class="mt-3 flex gap-2">
      <a href="#" class="btn-primary flex-1 text-center text-button-xs h-8">
        Telegram
      </a>
      <a href="#" class="btn-secondary flex-1 text-center text-button-xs h-8">
        WhatsApp
      </a>
    </div>
  </div>

  {/* Ad Unit 2: Sticky / Lower Sidebar Ad (300x600) */}
  <div class="sticky top-20 card-flat p-3">
    <AdPlaceholder slotId="sidebar-sticky-300x600" type="sidebar" label="Sticky Sidebar Ad Placement" />
  </div>
</aside>
