---
import { telegramChannel, whatsappChannel } from '../data/site';

interface Props {
  officialWebsite?: string;
}

const { officialWebsite } = Astro.props;

const liveUpdates = [
  { text: "BCECE LE 2026 Round 1 Allotment Released", tag: "New", isHot: true },
  { text: "Bihar DECE Polytechnic Counseling Schedule", tag: "Active" },
  { text: "BCECE Agriculture & Pharmacy Rank Cards", tag: "Updated" },
  { text: "BSSC CGL 4 Notification Expected Soon", tag: "Alert" },
  { text: "Bihar Police Constable Re-exam Result Date", tag: "Notice" }
];
---

<aside class="space-y-6">
  {/* Trending Updates Widget */}
  <div class="card-flat p-4">
    <div class="flex items-center gap-2 pb-3 mb-3 border-b border-border">
      <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <h3 class="font-bold text-white text-body-md">Trending Exam Updates</h3>
    </div>
    <ul class="space-y-3 text-body-xs">
      {liveUpdates.map((item) => (
        <li class="flex items-start justify-between gap-2 border-b border-border/50 pb-2 last:border-0 last:pb-0">
          <a href="/#latest-updates" class="text-muted hover:text-white transition font-medium line-clamp-2">
            {item.text}
          </a>
          <span class={`text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0 ${
            item.isHot ? 'badge-accent' : 'badge-outline'
          }`}>
            {item.tag}
          </span>
        </li>
      ))}
    </ul>
  </div>

  {/* Telegram / Social community box */}
  <div class="card-flat p-4 bg-surface-raised/40">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-[#2AABEE]/15 border border-[#2AABEE]/30 flex items-center justify-center text-[#2AABEE] shrink-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
      </div>
      <div>
        <h4 class="text-body-md font-bold text-white">Join Exam Alerts Group</h4>
        <p class="text-caption-sm text-muted mt-0.5">Get direct PDF & link alerts on your mobile</p>
      </div>
    </div>
    <div class="mt-3 flex gap-2">
      <a href={telegramChannel} target="_blank" rel="noopener noreferrer" class="btn-primary flex-1 text-center text-button-xs h-8 inline-flex items-center justify-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        Telegram
      </a>
      <a href={whatsappChannel} target="_blank" rel="noopener noreferrer" class="btn-secondary flex-1 text-center text-button-xs h-8 inline-flex items-center justify-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</aside>
