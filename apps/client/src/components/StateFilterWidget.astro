---
import { STATES_LIST, INITIAL_MOCK_POSTS, CATEGORIES_LIST } from '../data/portalMockData';
---

<div id="state-filter-widget" class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-xs mb-8">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-100">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-blue-100 text-blue-700 font-bold text-sm">
          📍
        </span>
        <h2 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
          Explore Government Exam Updates by State
        </h2>
      </div>
      <p class="text-xs text-slate-500 mt-1">
        Select your state or explore All-India notifications, results, and admission alerts.
      </p>
    </div>

    {/* State selector & Category selector controls */}
    <div class="flex flex-wrap items-center gap-2.5">
      {/* State Dropdown */}
      <div class="relative min-w-[170px] flex-1 sm:flex-initial">
        <label for="state-dropdown" class="sr-only">Select State</label>
        <div class="relative">
          <select 
            id="state-dropdown"
            class="w-full appearance-none bg-blue-50/60 border border-blue-200 text-blue-900 font-semibold text-xs sm:text-sm rounded-lg pl-3 pr-8 py-2.5 hover:bg-blue-50 focus:outline-hidden focus:ring-2 focus:ring-blue-600 transition cursor-pointer"
          >
            {STATES_LIST.map((state) => (
              <option value={state}>{state === 'All India' ? '🇮🇳 All India Updates' : `🏛️ ${state}`}</option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-blue-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      {/* Category Dropdown */}
      <div class="relative min-w-[160px] flex-1 sm:flex-initial">
        <label for="category-dropdown" class="sr-only">Select Category</label>
        <div class="relative">
          <select 
            id="category-dropdown"
            class="w-full appearance-none bg-slate-50 border border-slate-200 text-slate-800 font-medium text-xs sm:text-sm rounded-lg pl-3 pr-8 py-2.5 hover:bg-slate-100 focus:outline-hidden focus:ring-2 focus:ring-blue-600 transition cursor-pointer"
          >
            {CATEGORIES_LIST.map((cat) => (
              <option value={cat.name}>{cat.name}</option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      {/* Reset filter button */}
      <button 
        id="reset-filter-btn"
        class="text-xs text-slate-500 hover:text-blue-700 font-semibold px-2.5 py-2 rounded-md hover:bg-slate-100 transition hidden"
        title="Reset filters"
      >
        ✕ Reset
      </button>
    </div>
  </div>

  {/* Active Filter Status Bar */}
  <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2 text-xs">
    <div class="flex items-center gap-2">
      <span class="text-slate-500">Showing updates for:</span>
      <span id="active-state-badge" class="bg-blue-600 text-white font-semibold px-2 py-0.5 rounded-full shadow-2xs">
        All India
      </span>
      <span id="active-cat-badge" class="bg-slate-100 text-slate-700 font-medium px-2 py-0.5 rounded-full border border-slate-200">
        All Categories
      </span>
    </div>
    <div class="text-slate-500">
      Found <span id="filtered-count" class="font-bold text-slate-800">{INITIAL_MOCK_POSTS.length}</span> updates
    </div>
  </div>

  {/* Filtered Posts Card Grid */}
  <div id="posts-container" class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3.5">
    {INITIAL_MOCK_POSTS.map((post) => (
      <div 
        class="post-card p-3.5 rounded-xl border border-slate-200 bg-white hover:border-blue-400 hover:shadow-xs transition flex flex-col justify-between"
        data-state={post.state}
        data-category={post.category}
      >
        <div>
          <div class="flex items-center justify-between text-[11px] mb-2">
            <span class="bg-blue-50 text-blue-700 font-semibold px-2 py-0.5 rounded">
              {post.category}
            </span>
            <span class="bg-slate-100 text-slate-600 font-medium px-1.5 py-0.5 rounded text-[10px]">
              📍 {post.state}
            </span>
          </div>
          <h3 class="text-xs sm:text-sm font-bold text-slate-900 hover:text-blue-700 transition leading-snug line-clamp-2">
            <a href={post.slug === 'bihar-dece-le-seat-allotment-2026' ? '/' : '#'}>
              {post.title}
            </a>
          </h3>
          <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">
            {post.summary}
          </p>
        </div>

        <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
          <span>📅 {post.postDate}</span>
          <a 
            href={post.slug === 'bihar-dece-le-seat-allotment-2026' ? '/' : '#'}
            class="text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center gap-0.5"
          >
            {post.slug === 'bihar-dece-le-seat-allotment-2026' ? 'Open Article →' : 'Read Update →'}
          </a>
        </div>
      </div>
    ))}
  </div>

  {/* Empty state when no results match */}
  <div id="no-results-msg" class="hidden text-center py-8">
    <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-xl mb-2">
      🔍
    </div>
    <h3 class="text-sm font-bold text-slate-800">No updates found for this filter</h3>
    <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
      Try selecting "All India" or another state to view active notices and results.
    </p>
  </div>
</div>

<script>
  const stateSelect = document.getElementById('state-dropdown') as HTMLSelectElement | null;
  const categorySelect = document.getElementById('category-dropdown') as HTMLSelectElement | null;
  const activeStateBadge = document.getElementById('active-state-badge');
  const activeCatBadge = document.getElementById('active-cat-badge');
  const filteredCount = document.getElementById('filtered-count');
  const resetBtn = document.getElementById('reset-filter-btn');
  const noResultsMsg = document.getElementById('no-results-msg');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');

  function applyFilters() {
    if (!stateSelect || !categorySelect) return;
    const selectedState = stateSelect.value;
    const selectedCategory = categorySelect.value;

    let visibleCount = 0;

    cards.forEach((card) => {
      const cardState = card.dataset.state || '';
      const cardCategory = card.dataset.category || '';

      const stateMatches = selectedState === 'All India' || cardState === selectedState;
      const categoryMatches = selectedCategory === 'All Categories' || cardCategory === selectedCategory;

      if (stateMatches && categoryMatches) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (activeStateBadge) activeStateBadge.textContent = selectedState;
    if (activeCatBadge) activeCatBadge.textContent = selectedCategory;
    if (filteredCount) filteredCount.textContent = visibleCount.toString();

    if (noResultsMsg) {
      if (visibleCount === 0) {
        noResultsMsg.classList.remove('hidden');
      } else {
        noResultsMsg.classList.add('hidden');
      }
    }

    if (resetBtn) {
      if (selectedState !== 'All India' || selectedCategory !== 'All Categories') {
        resetBtn.classList.remove('hidden');
      } else {
        resetBtn.classList.add('hidden');
      }
    }
  }

  stateSelect?.addEventListener('change', applyFilters);
  categorySelect?.addEventListener('change', applyFilters);

  resetBtn?.addEventListener('click', () => {
    if (stateSelect) stateSelect.value = 'All India';
    if (categorySelect) categorySelect.value = 'All Categories';
    applyFilters();
  });
</script>
