---
import { STATES_LIST } from '../data/portalMockData';
import { API_URL } from '../lib/api';

let livePosts: any[] = [];
try {
  const res = await fetch(`${API_URL}/blogs?limit=50`);
  if (res.ok) livePosts = await res.json();
} catch (e) {}

let categoriesList: any[] = [];
try {
  const catRes = await fetch(`${API_URL}/categories`);
  if (catRes.ok) categoriesList = await catRes.json();
} catch (e) {}
---

<div id="state-filter-widget" class="card p-5 sm:p-6 mb-8 relative z-0">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-border">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-surface-raised border border-border text-accent text-sm">
          📍
        </span>
        <h2 class="text-heading-sm font-bold text-white tracking-tight">
          Explore Government Exam Updates by State
        </h2>
      </div>
      <p class="text-body-xs text-muted mt-1">
        Select your state or explore All-India notifications, results, and admission alerts.
      </p>
    </div>

    {/* State selector & Category selector controls */}
    <div class="flex flex-wrap items-center gap-2.5">
      {/* State Dropdown */}
      <div class="relative min-w-[170px] flex-1 sm:flex-initial z-0">
        <label for="state-dropdown" class="sr-only">Select State</label>
        <div class="relative">
          <select 
            id="state-dropdown"
            class="w-full appearance-none bg-surface-raised border border-border text-white font-medium text-body-sm rounded-xl pl-3 pr-8 py-2 hover:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition cursor-pointer"
          >
            {STATES_LIST.map((state) => (
              <option value={state} class="bg-surface text-white">{state === 'All India' ? '🇮🇳 All India Updates' : `🏛️ ${state}`}</option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      {/* Category Dropdown */}
      <div class="relative min-w-[160px] flex-1 sm:flex-initial z-0">
        <label for="category-dropdown" class="sr-only">Select Category</label>
        <div class="relative">
          <select 
            id="category-dropdown"
            class="w-full appearance-none bg-surface-raised border border-border text-white font-medium text-body-sm rounded-xl pl-3 pr-8 py-2 hover:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition cursor-pointer"
          >
            <option value="All Categories" class="bg-surface text-white">All Categories</option>
            {categoriesList.map((cat) => (
              <option value={cat.name} class="bg-surface text-white">{cat.name}</option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      {/* Reset filter button */}
      <button 
        id="reset-filter-btn"
        class="btn-ghost text-caption-xs h-8 hidden"
        title="Reset filters"
      >
        ✕ Reset
      </button>
    </div>
  </div>

  {/* Active Filter Status Bar */}
  <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2 text-caption-sm">
    <div class="flex items-center gap-2">
      <span class="text-muted">Showing updates for:</span>
      <span id="active-state-badge" class="badge-accent">
        All India
      </span>
      <span id="active-cat-badge" class="badge-outline">
        All Categories
      </span>
    </div>
    <div class="text-muted">
      Found <span id="filtered-count" class="font-bold text-white">{livePosts.length}</span> updates
    </div>
  </div>

  {/* Filtered Posts Card Grid */}
  <div id="posts-container" class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3.5">
    {livePosts.length > 0 ? (
      livePosts.map((post) => {
        const catName = post.category?.name || 'General';
        const articleHref = `/${post.slug}`;
        const dateStr = post.publishedAt || post.updatedAt ? new Date(post.publishedAt || post.updatedAt).toLocaleDateString() : 'Recent';

        return (
          <div 
            class="post-card p-4 rounded-xl border border-border bg-surface-raised/40 hover:border-accent hover:bg-surface-raised/80 transition-all duration-200 flex flex-col justify-between"
            data-state="All India"
            data-category={catName}
          >
            <div>
              <div class="flex items-center justify-between text-[11px] mb-2">
                <span class="badge-outline text-[11px] py-0.5 px-2">
                  {catName}
                </span>
                <span class="bg-surface-raised border border-border text-muted px-2 py-0.5 rounded-xs text-[10px]">
                  📍 All India
                </span>
              </div>
              <h3 class="text-body-md font-bold text-white hover:text-accent transition leading-snug line-clamp-2">
                <a href={articleHref}>
                  {post.title}
                </a>
              </h3>
              <p class="text-body-xs text-muted mt-1.5 line-clamp-2 leading-relaxed">
                {post.description || post.metaDescription || 'Click to view the complete guide.'}
              </p>
            </div>

            <div class="mt-3 pt-2.5 border-t border-border/50 flex items-center justify-between text-caption-xs text-muted">
              <span>📅 {dateStr}</span>
              <a 
                href={articleHref}
                class="text-accent hover:underline font-medium inline-flex items-center gap-0.5"
              >
                Open Article →
              </a>
            </div>
          </div>
        );
      })
    ) : (
      <div class="col-span-full p-8 text-center bg-surface border border-border rounded-xl text-muted">
        <p class="text-sm">No live articles published yet. Publish an article from the CMS to show it here.</p>
      </div>
    )}
  </div>

  {/* Empty state when no results match */}
  <div id="no-results-msg" class="hidden text-center py-8">
    <div class="w-12 h-12 rounded-full bg-surface-raised border border-border text-muted flex items-center justify-center mx-auto text-xl mb-2">
      🔍
    </div>
    <h3 class="text-body-md font-bold text-white">No updates found for this filter</h3>
    <p class="text-body-xs text-muted mt-1 max-w-sm mx-auto">
      Try selecting "All India" or another state to view active notices and results.
    </p>
  </div>
</div>

<script>
  const stateSelect = document.getElementById('state-dropdown') as HTMLSelectElement | null;
  const categorySelect = document.getElementById('category-dropdown') as HTMLSelectElement | null;
  const activeStateBadge = document.getElementById('active-state-badge');
  const activeCatBadge = document.getElementById('active-cat-badge');
  const filteredCount = document.getElementById('filtered-count');
  const resetBtn = document.getElementById('reset-filter-btn');
  const noResultsMsg = document.getElementById('no-results-msg');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');

  function applyFilters() {
    if (!stateSelect || !categorySelect) return;
    const selectedState = stateSelect.value;
    const selectedCategory = categorySelect.value;

    let visibleCount = 0;

    cards.forEach((card) => {
      const cardState = card.dataset.state || '';
      const cardCategory = card.dataset.category || '';

      const stateMatches = selectedState === 'All India' || cardState === selectedState;
      const categoryMatches = selectedCategory === 'All Categories' || cardCategory === selectedCategory;

      if (stateMatches && categoryMatches) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (activeStateBadge) activeStateBadge.textContent = selectedState;
    if (activeCatBadge) activeCatBadge.textContent = selectedCategory;
    if (filteredCount) filteredCount.textContent = visibleCount.toString();

    if (noResultsMsg) {
      if (visibleCount === 0) {
        noResultsMsg.classList.remove('hidden');
      } else {
        noResultsMsg.classList.add('hidden');
      }
    }

    if (resetBtn) {
      if (selectedState !== 'All India' || selectedCategory !== 'All Categories') {
        resetBtn.classList.remove('hidden');
      } else {
        resetBtn.classList.add('hidden');
      }
    }
  }

  stateSelect?.addEventListener('change', applyFilters);
  categorySelect?.addEventListener('change', applyFilters);

  resetBtn?.addEventListener('click', () => {
    if (stateSelect) stateSelect.value = 'All India';
    if (categorySelect) categorySelect.value = 'All Categories';
    applyFilters();
  });
</script>
