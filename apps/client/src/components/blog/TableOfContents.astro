---
export interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<div class="toc-container flex h-full min-h-0 select-none flex-col px-2 pb-3">
  <div class="mb-1 shrink-0 border-b border-border/80 px-2 pb-2 pt-1">
    <span class="text-[12px] font-bold uppercase tracking-wider text-muted">On this page</span>
  </div>

  <nav id="toc-scroll" class="relative max-h-80 min-h-0 flex-1 overflow-y-auto pr-1 text-[13px] scrollbar-none xl:max-h-none">
    <div id="toc-list" class="relative">
      <span id="toc-highlight-bg" class="pointer-events-none absolute left-0 right-1 rounded-md bg-accent/10 opacity-0 transition-all duration-300 ease-out"></span>
      <span id="toc-highlight" class="pointer-events-none absolute left-0 w-[3px] rounded-full bg-accent opacity-0 transition-all duration-300 ease-out"></span>
      {items.map((item) => (
        <a
          href={`#${item.id}`}
          data-toc-id={item.id}
          class:list={[
            'toc-link relative z-[1] block rounded-md px-2.5 py-1.5 leading-snug transition-colors duration-150 hover:text-accent',
            item.level > 2 ? 'pl-5 text-[12px] text-muted' : 'font-medium text-white/90',
          ]}
        >
          <span class="block truncate">{item.text}</span>
        </a>
      ))}
    </div>
  </nav>
</div>
