---
export interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<div class="toc-container select-none">
  <div class="flex items-center justify-between pb-3 mb-2 border-b border-border/80">
    <span class="text-[12px] font-bold text-muted tracking-wider uppercase">On this page</span>
    <span id="reading-percent-label" class="text-[12px] font-bold text-accent font-mono">0%</span>
  </div>

  <nav class="space-y-1 max-h-[calc(100vh-260px)] overflow-y-auto pr-1 text-[13px] scrollbar-none">
    {items.map((item) => (
      <a
        href={`#${item.id}`}
        data-toc-id={item.id}
        class={`toc-link block py-1.5 transition-colors duration-150 leading-snug rounded-lg px-2.5 ${
          item.level === 3 ? 'pl-5 text-[12px] text-muted' : 'font-medium text-white/90'
        } hover:text-accent hover:bg-surface-raised`}
      >
        <span class="truncate block">{item.text}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  .toc-link.active {
    color: var(--color-accent, #327CF6) !important;
    background-color: rgba(50, 124, 246, 0.08) !important;
    font-weight: 600 !important;
    border-left: 2px solid var(--color-accent, #327CF6);
  }
</style>

<script>
  function setupTocObserver() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (!links.length) return;

    const headingIds = Array.from(links).map((l) => l.getAttribute('data-toc-id')).filter(Boolean) as string[];
    const headings = headingIds.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    function onScroll() {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? Math.min(100, Math.max(0, Math.round((winScroll / height) * 100))) : 0;
      
      const percentEl = document.getElementById('reading-percent-label');
      if (percentEl) percentEl.textContent = `${scrolled}%`;

      let currentActiveId = '';
      const scrollPosition = window.scrollY + 120;

      for (let i = headings.length - 1; i >= 0; i--) {
        const heading = headings[i];
        if (heading.offsetTop <= scrollPosition) {
          currentActiveId = heading.id;
          break;
        }
      }

      if (!currentActiveId && headings.length > 0) {
        currentActiveId = headings[0].id;
      }

      links.forEach((link) => {
        if (link.getAttribute('data-toc-id') === currentActiveId) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  setupTocObserver();
  document.addEventListener('astro:page-load', setupTocObserver);
</script>
