---
interface Props {
  title: string;
  slug: string;
  href?: string;
  category?: string;
  categories?: Array<{ name: string; slug?: string }>;
  date?: string;
  publishedAt?: string | null;
  summary?: string | null;
  variant?: 'standard' | 'compact';
  headingLevel?: 'h2' | 'h3' | 'h4';
  prefetch?: 'viewport' | 'hover' | 'tap' | boolean;
  isNew?: boolean;
  class?: string;
}

const {
  title,
  slug,
  href,
  category,
  categories,
  date,
  publishedAt,
  summary,
  variant = 'standard',
  headingLevel = 'h3',
  prefetch,
  isNew,
  class: className = '',
} = Astro.props;

const targetUrl = href || `/${slug.replace(/^\//, '')}`;

const formattedDate = date || (publishedAt ? new Date(publishedAt).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: variant === 'compact' ? undefined : 'numeric',
}) : null);

const HeadingTag = headingLevel;
const allCategories = categories && categories.length > 0
  ? categories
  : category
  ? [{ name: category }]
  : [];

const cardHoverClass = 'hover:border-accent/40 hover:-translate-y-0.5 active:translate-y-0 hover:shadow-lg';
---

{variant === 'compact' ? (
  <a
    href={targetUrl}
    target="_blank"
    rel="noopener"
    data-article-link={slug}
    data-astro-prefetch={prefetch ?? 'false'}
    class={`group flex items-start gap-3 p-3 rounded-xl hover:bg-surface-raised transition-all duration-150 border border-transparent hover:border-border/60 cursor-pointer ${className}`}
  >
    <div class="w-0.5 self-stretch bg-border group-hover:bg-accent rounded-full shrink-0 transition-colors duration-200 min-h-[40px]"></div>
    <div class="min-w-0 flex-1">
      {allCategories.length > 0 && (
        <span class="inline-block text-[10px] font-semibold text-accent/80 leading-none mb-1 truncate max-w-full uppercase tracking-wide">
          {allCategories[0].name}
        </span>
      )}
      <HeadingTag
        class="text-[13px] font-semibold text-slate-900 dark:text-slate-100 group-hover:text-accent line-clamp-2 leading-[1.6] transition-colors duration-150"
        data-article-title
      >
        {title}
      </HeadingTag>
      {formattedDate && (
        <span class="text-[10px] text-slate-500 dark:text-slate-400 mt-1 block font-medium tabular-nums">
          {formattedDate}
        </span>
      )}
    </div>
    <svg class="w-3.5 h-3.5 text-border group-hover:text-accent shrink-0 mt-1 transition-colors duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </a>
) : (
  <a
    href={targetUrl}
    target="_blank"
    rel="noopener"
    data-article-link={slug}
    data-astro-prefetch={prefetch ?? 'false'}
    class={`group relative flex flex-col bg-surface border border-border/70 rounded-2xl overflow-hidden ${cardHoverClass} transition-all duration-200 cursor-pointer ${className}`}
  >
    {/* Hover top accent */}
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-accent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

    <div class="p-4 sm:p-5 flex-1 flex flex-col">

      {/* Header: categories + date */}
      <div class="flex items-start justify-between gap-3 mb-3">
        <div class="flex flex-wrap items-center gap-1.5 min-w-0">
          {isNew && (
            <span class="badge-new inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25 shrink-0 select-none">
              <span class="w-1 h-1 rounded-full bg-emerald-500 inline-block"></span>
              New
            </span>
          )}
          {allCategories.length > 0 ? (
            allCategories.slice(0, 2).map((c) => (
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-[11px] font-semibold bg-accent/8 text-accent border border-accent/15 truncate max-w-[180px]">
                {c.name}
              </span>
            ))
          ) : (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-[11px] font-semibold bg-accent/8 text-accent border border-accent/15">
              Latest Updates
            </span>
          )}
        </div>
        {formattedDate && (
          <time class="text-[11px] text-slate-500 dark:text-slate-400 font-medium shrink-0 tabular-nums mt-0.5">
            {formattedDate}
          </time>
        )}
      </div>

      {/* Title */}
      <HeadingTag
        class="text-[15px] sm:text-base font-bold text-slate-900 dark:text-slate-100 group-hover:text-accent transition-colors duration-150 leading-snug line-clamp-2 mb-2 tracking-tight"
        data-article-title
      >
        {title}
      </HeadingTag>

      {/* Summary */}
      {summary && (
        <p class="text-[13px] text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-2 flex-1" data-article-summary>
          {summary}
        </p>
      )}
    </div>

    {/* Card footer */}
    <div class="px-4 sm:px-5 py-2.5 border-t border-border/40 flex items-center justify-between bg-surface-raised/30">
      <span class="text-[11px] font-semibold text-accent group-hover:underline underline-offset-2">
        Read more
      </span>
      <svg class="w-3.5 h-3.5 text-accent/60 group-hover:translate-x-0.5 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </a>
)}
