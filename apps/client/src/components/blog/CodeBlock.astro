---
import { highlightLine, languageLabel } from '../../lib/highlight-code';

interface Props {
  code: string;
  language?: string;
  filename?: string;
  highlightLines?: number[];
}

const {
  code,
  language = 'java',
  filename,
  highlightLines = [],
} = Astro.props;

const rawLines = code.replace(/\s+$/, '').split('\n');
---

<div class="tf-code my-5">
  <div class="tf-code-bar">
    <span class="tf-code-lang">{filename || languageLabel(language)}</span>
    <button type="button" class="tf-code-copy" aria-label="Copy code">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" stroke-width="2"></rect>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="tf-code-copy-label">Copy</span>
    </button>
  </div>
  <div class="tf-code-body">
    <pre><code>
      {rawLines.map((line, index) => {
        const lineNum = index + 1;
        return (
          <span class:list={['tf-line', highlightLines.includes(lineNum) && 'tf-line-mark']}>
            <span class="tf-ln">{lineNum}</span>
            <span class="tf-lc" set:html={highlightLine(line, language) || ' '} />
          </span>
        );
      })}
    </code></pre>
  </div>
</div>

<script>
  import { bindCodeCopy } from '../../lib/article-reading';

  bindCodeCopy();
  document.addEventListener('astro:page-load', bindCodeCopy);
</script>
