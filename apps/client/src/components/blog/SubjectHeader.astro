---
import type { SubjectData } from '../../data/blogData';

interface Props {
  subject: SubjectData;
}

const { subject } = Astro.props;
---

<header class="subject-header mb-8 pb-6 border-b border-border/70">
  {/* Minimal clean breadcrumb */}
  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-muted mb-4 font-mono">
    <a href="/blog/java" class="hover:text-accent transition">Articles</a>
    <span class="text-border">/</span>
    <span class="text-white font-medium">{subject.title}</span>
  </nav>

  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-accent uppercase tracking-wider mb-2">
        <span>Technical Subject</span>
        <span class="text-border">•</span>
        <span class="text-muted font-normal lowercase">{subject.topicsCount} articles available</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
        {subject.title}
      </h1>
      <p class="text-sm sm:text-base text-muted mt-2.5 leading-relaxed">
        {subject.description}
      </p>
    </div>

    {/* Search field */}
    <div class="w-full md:w-80 shrink-0">
      <label for="topic-search-input" class="sr-only">Search articles</label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="topic-search-input"
          placeholder="Filter topics by title or keyword..."
          class="w-full pl-9 pr-3.5 py-2 bg-surface border border-border rounded-lg text-sm text-white placeholder:text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition shadow-2xs"
        />
      </div>
    </div>
  </div>
</header>
