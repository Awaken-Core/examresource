---
import CodeBlock from './CodeBlock.astro';
import type { TopicDetail } from '../../data/blogData';

interface Props {
  article: TopicDetail;
}

const { article } = Astro.props;

const difficultyColors = {
  Beginner: 'text-emerald-700 border-emerald-200 bg-emerald-50/70',
  Intermediate: 'text-blue-700 border-blue-200 bg-blue-50/70',
  Advanced: 'text-purple-700 border-purple-200 bg-purple-50/70',
};
---

<article class="blog-article max-w-3xl w-full mx-auto text-white leading-relaxed">
  {/* Header & Meta */}
  <header class="mb-4 pb-3.5 sm:mb-8 sm:pb-6 border-b border-border/80">
    {/* Clean text breadcrumb */}
    <nav aria-label="Article Breadcrumb" class="flex items-center gap-2 text-[11px] sm:text-xs text-muted font-mono mb-2 sm:mb-4 overflow-x-auto scrollbar-none whitespace-nowrap">
      <a href={`/blog/${article.subjectSlug}`} class="hover:text-accent transition shrink-0">
        {article.subjectTitle}
      </a>
      <span class="text-border shrink-0">/</span>
      <span class="text-white font-medium shrink-0">{article.category}</span>
    </nav>

    <h1 class="text-xl sm:text-3xl lg:text-[42px] font-extrabold text-white tracking-tight leading-snug sm:leading-tight mb-2 sm:mb-4">
      {article.title}
    </h1>

    <p class="text-xs sm:text-base text-muted leading-relaxed mb-3 sm:mb-5">
      {article.description}
    </p>

    {/* Metadata row */}
    <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-[11px] sm:text-xs text-muted font-mono pt-2.5 sm:pt-4 border-t border-border/60">
      <span class={`px-2 py-0.5 rounded border text-[10px] sm:text-[11px] font-semibold ${difficultyColors[article.difficulty]}`}>
        {article.difficulty}
      </span>
      <span class="text-border">•</span>
      <span>{article.readTime}</span>
      <span class="text-border">•</span>
      <span>Updated {article.updatedDate}</span>
    </div>
  </header>

  {/* Intro Paragraphs */}
  <div class="space-y-4 mb-8 text-[#374151] text-[15.5px] leading-relaxed">
    {article.introParagraphs.map((p) => (
      <p>{p}</p>
    ))}
  </div>

  {/* Main Overview Code Block if present */}
  {article.overviewCode && (
    <div class="mb-10">
      <CodeBlock 
        code={article.overviewCode.code} 
        language={article.overviewCode.language} 
        filename={article.overviewCode.filename}
        highlightLines={article.overviewCode.highlightLines}
      />
    </div>
  )}

  {/* Sections */}
  <div class="space-y-6 sm:space-y-12">
    {article.sections.map((sec) => (
      <section id={sec.id} class="scroll-mt-24 space-y-4">
        {sec.level === 3 ? (
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight pt-2">
            {sec.title}
          </h3>
        ) : (
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight pb-2 border-b border-border/80">
            {sec.title}
          </h2>
        )}

        {sec.content.map((p) => (
          <p class="text-[#374151] text-[15.5px] leading-relaxed">{p}</p>
        ))}

        {/* Bullet points */}
        {sec.bullets && sec.bullets.length > 0 && (
          <ul class="my-4 space-y-2 list-disc pl-5 text-[#374151] text-[15px]">
            {sec.bullets.map((b) => (
              <li class="leading-relaxed">{b}</li>
            ))}
          </ul>
        )}

        {/* Numbered steps */}
        {sec.numberedSteps && sec.numberedSteps.length > 0 && (
          <ol class="my-4 space-y-2 list-decimal pl-5 text-[#374151] text-[15px]">
            {sec.numberedSteps.map((step) => (
              <li class="leading-relaxed pl-1">{step}</li>
            ))}
          </ol>
        )}

        {/* Code snippet inside section */}
        {sec.codeSnippet && (
          <CodeBlock 
            code={sec.codeSnippet.code}
            language={sec.codeSnippet.language}
            filename={sec.codeSnippet.filename}
            highlightLines={sec.codeSnippet.highlightLines}
          />
        )}

        {/* Technical Callout Box */}
        {sec.infobox && (
          <div class={`p-4 rounded-lg border my-5 text-sm leading-relaxed ${
            sec.infobox.type === 'warning' 
              ? 'bg-amber-50 border-amber-200 text-amber-900' 
              : sec.infobox.type === 'tip'
                ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
                : 'bg-blue-50 border-blue-200 text-blue-900'
          }`}>
            <div class="font-semibold text-xs uppercase tracking-wider mb-1 font-mono">
              {sec.infobox.type === 'warning' ? 'Notice' : sec.infobox.type === 'tip' ? 'Best Practice' : 'Note'}
            </div>
            <div>{sec.infobox.text}</div>
          </div>
        )}
      </section>
    ))}
  </div>

  {/* Hand-drawn / Technical Architecture Diagram */}
  {article.slug === 'object-lifecycle-in-java' && (
    <div class="my-10 p-6 rounded-xl bg-surface border border-border shadow-2xs">
      <div class="border-b border-border pb-3 mb-5">
        <h3 class="text-base font-bold text-white tracking-tight">Lifecycle Architecture: Object Allocation & Resolution</h3>
        <p class="text-xs text-muted font-mono mt-0.5">Stack pointer reference binding to JVM Young Generation Heap</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-5 font-mono text-xs">
        <div class="p-3.5 rounded-lg border border-border bg-surface-raised">
          <div class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1.5">Phase 1: Declaration</div>
          <div class="p-1.5 rounded bg-surface border border-border text-white font-semibold mb-2">Student student;</div>
          <div class="text-[11px] text-muted">Stack reference frame allocated. Pointer contains null reference.</div>
        </div>

        <div class="p-3.5 rounded-lg border border-border bg-surface-raised">
          <div class="text-[11px] font-bold text-accent uppercase tracking-wider mb-1.5">Phase 2: Instantiation</div>
          <div class="p-1.5 rounded bg-surface border border-border text-white font-semibold mb-2">new Student(...)</div>
          <div class="text-[11px] text-muted">Heap memory reserved in Eden space for mark word and instance fields.</div>
        </div>

        <div class="p-3.5 rounded-lg border border-border bg-surface-raised">
          <div class="text-[11px] font-bold text-emerald-700 uppercase tracking-wider mb-1.5">Phase 3: Initialization</div>
          <div class="p-1.5 rounded bg-surface border border-border text-white font-semibold mb-2">&lt;init&gt; constructor</div>
          <div class="text-[11px] text-muted">Constructor executes, fields initialized, memory address returned to stack.</div>
        </div>
      </div>

      <div class="p-2.5 rounded-lg bg-surface-raised border border-border text-xs text-muted flex items-center justify-center gap-2 font-mono">
        <span>Stack Reference</span>
        <span class="text-border">→</span>
        <span>Heap Allocation</span>
        <span class="text-border">→</span>
        <span>Constructor Execution</span>
        <span class="text-border">→</span>
        <span class="text-accent font-semibold">Active Method Invocation</span>
      </div>
    </div>
  )}

  {/* Key Takeaways */}
  {article.summaryPoints && article.summaryPoints.length > 0 && (
    <div class="my-10 p-6 rounded-xl bg-surface-raised/60 border border-border">
      <h3 class="text-base font-bold text-white mb-3">
        Key Takeaways
      </h3>
      <ul class="space-y-2 list-disc pl-5 text-[#374151] text-sm">
        {article.summaryPoints.map((pt) => (
          <li class="leading-relaxed">{pt}</li>
        ))}
      </ul>
    </div>
  )}
</article>
