---
interface Props {
  currentLanguage?: 'HINGLISH' | 'ENGLISH';
  hinglishUrl: string;
  englishUrl?: string | null;
  className?: string;
}

const {
  currentLanguage = 'HINGLISH',
  hinglishUrl,
  englishUrl,
  className = '',
} = Astro.props;

const isHinglish = currentLanguage === 'HINGLISH';
---

<div class={`language-switcher-pill inline-flex items-center gap-1 p-0.5 sm:p-1 bg-surface-elevated/90 backdrop-blur-md border border-border/80 rounded-full shadow-xs select-none shrink-0 max-w-full ${className}`} role="group" aria-label="Language Switcher">
  <!-- Hinglish Option (Default) -->
  <a
    href={hinglishUrl}
    data-lang="hinglish"
    data-global-lang="hinglish"
    class={`flex items-center gap-1 px-2.5 py-1 sm:px-3 sm:py-1 rounded-full text-[11px] sm:text-xs font-semibold tracking-wide transition-all duration-200 shrink-0 ${
      isHinglish
        ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-xs'
        : 'text-muted hover:text-white hover:bg-white/5'
    }`}
    aria-current={isHinglish ? 'true' : undefined}
    title="Read in conversational Hinglish"
  >
    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
    <span>🇮🇳 Hinglish</span>
    {isHinglish && <span class="hidden sm:inline-block text-[9px] uppercase tracking-wider font-bold opacity-75 ml-0.5">Default</span>}
  </a>

  <!-- English Option -->
  {englishUrl ? (
    <a
      href={englishUrl}
      data-lang="en"
      data-global-lang="en"
      class={`flex items-center gap-1 px-2.5 py-1 sm:px-3 sm:py-1 rounded-full text-[11px] sm:text-xs font-semibold tracking-wide transition-all duration-200 shrink-0 ${
        !isHinglish
          ? 'bg-blue-500/20 text-blue-300 border border-blue-500/40 shadow-xs'
          : 'text-muted hover:text-white hover:bg-white/5'
      }`}
      aria-current={!isHinglish ? 'true' : undefined}
      title="Read in formal English"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0"></span>
      <span>🌐 English</span>
    </a>
  ) : (
    <span
      class="flex items-center gap-1 px-2 py-1 rounded-full text-[11px] sm:text-xs font-medium text-muted/50 cursor-not-allowed shrink-0"
      title="English version coming soon"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-muted/40 shrink-0"></span>
      <span>English (Soon)</span>
    </span>
  )}
</div>

<script>
  import { canSwapArticleLanguage, swapArticleLanguage } from '../../lib/article-lang-swap';

  function persistLang(lang: string) {
    try {
      localStorage.setItem('preferred_exam_lang', lang);
      document.cookie = `preferred_lang=${lang};path=/;max-age=31536000;SameSite=Lax`;
    } catch {}
  }

  function setupLangSwitchers() {
    const switchers = document.querySelectorAll<HTMLAnchorElement>('.language-switcher-pill a[data-lang]');
    switchers.forEach((el) => {
      if ((el as any).__langSwapBound) return;
      (el as any).__langSwapBound = true;

      el.addEventListener('click', (e) => {
        const lang = el.dataset.lang;
        if (!lang) return;

        // Instant client-side swap when both languages are embedded
        if (canSwapArticleLanguage(lang)) {
          e.preventDefault();
          e.stopPropagation();
          persistLang(lang);
          swapArticleLanguage(lang);
          return;
        }

        // Fallback: normal navigation (ClientRouter) when alternate isn't embedded
        persistLang(lang);
        window.dispatchEvent(new CustomEvent('exam:language-change', { detail: { lang } }));
      });
    });
  }

  async function softNavigate(lang: string) {
    const path = window.location.pathname;
    const search = new URLSearchParams(window.location.search);
    if (lang === 'en' || lang === 'english' || lang === 'ENGLISH') {
      search.set('lang', 'en');
    } else {
      search.delete('lang');
    }
    const qs = search.toString();
    const url = qs ? `${path}?${qs}` : path;
    try {
      const { navigate } = await import('astro:transitions/client');
      navigate(url);
    } catch {
      window.location.href = url;
    }
  }

  function onArticleLangSwap(e: Event) {
    const detail = (e as CustomEvent).detail;
    const lang = detail?.lang;
    if (!lang) return;
    persistLang(lang);
    if (canSwapArticleLanguage(lang)) {
      swapArticleLanguage(lang);
    } else {
      void softNavigate(lang);
    }
  }

  setupLangSwitchers();
  document.addEventListener('astro:after-swap', setupLangSwitchers);
  document.addEventListener('astro:page-load', setupLangSwitchers);

  if (!(window as any).__ARTICLE_LANG_SWAP_LISTENER__) {
    (window as any).__ARTICLE_LANG_SWAP_LISTENER__ = true;
    window.addEventListener('exam:article-lang-swap', onArticleLangSwap as EventListener);
  }
</script>
