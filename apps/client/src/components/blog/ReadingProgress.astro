---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`reading-progress-widget bg-surface border border-border rounded-2xl p-4 shadow-sm ${className}`}>
  <div class="flex items-center justify-between text-xs text-muted mb-2 font-medium">
    <div class="flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span class="font-semibold text-white/90">Reading Progress</span>
    </div>
    <span id="reading-progress-num" class="font-mono font-bold text-accent">0%</span>
  </div>

  <div class="w-full bg-surface-raised rounded-full h-1.5 overflow-hidden">
    <div 
      id="reading-progress-bar"
      class="bg-accent h-full rounded-full transition-all duration-150 ease-out" 
      style="width: 0%"
    ></div>
  </div>
</div>

<script>
  function setupProgressBar() {
    const bar = document.getElementById('reading-progress-bar');
    const num = document.getElementById('reading-progress-num');
    if (!bar || !num) return;

    function update() {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? Math.min(100, Math.max(0, Math.round((winScroll / height) * 100))) : 0;
      
      bar.style.width = `${scrolled}%`;
      num.textContent = `${scrolled}%`;
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  setupProgressBar();
  document.addEventListener('astro:page-load', setupProgressBar);
</script>
