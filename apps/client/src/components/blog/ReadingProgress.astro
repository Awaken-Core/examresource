---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['px-3.5 pt-3.5 pb-3', className]}>
  <div class="mb-2 flex items-center justify-between text-xs font-medium text-muted">
    <div class="flex items-center gap-1.5">
      <svg class="h-3.5 w-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span class="font-semibold text-white/90">Reading Progress</span>
    </div>
    <span id="reading-progress-num" class="font-mono font-bold text-accent">0%</span>
  </div>
  <div class="h-1 overflow-hidden rounded-full bg-surface-raised">
    <div
      id="reading-progress-bar"
      class="h-full origin-left rounded-full bg-accent transition-transform duration-200 ease-out"
      style="transform: scaleX(0)"
    ></div>
  </div>
</div>

<script>
  import { bindArticleReading } from '../../lib/article-reading';

  bindArticleReading();
  document.addEventListener('astro:page-load', bindArticleReading);
</script>
