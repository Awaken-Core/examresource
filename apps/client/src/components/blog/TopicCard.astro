---
import type { TopicSummary } from '../../data/blogData';

interface Props {
  topic: TopicSummary;
  subjectSlug: string;
}

const { topic, subjectSlug } = Astro.props;

const difficultyBadge = {
  Beginner: 'text-emerald-700 bg-emerald-50/70 border-emerald-200',
  Intermediate: 'text-blue-700 bg-blue-50/70 border-blue-200',
  Advanced: 'text-purple-700 bg-purple-50/70 border-purple-200',
};
---

<article
  data-topic-item
  data-topic-title={topic.title.toLowerCase()}
  data-topic-desc={topic.description.toLowerCase()}
  data-topic-category={topic.category.toLowerCase()}
  class="group py-5 border-b border-border/70 last:border-b-0 hover:bg-surface-raised/40 transition-colors duration-150 px-3 -mx-3 rounded-lg"
>
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-1.5">
    <div class="flex items-center gap-2.5">
      <span class="text-xs font-mono text-muted/70 w-5 shrink-0">
        {String(topic.order).padStart(2, '0')}
      </span>
      <h3 class="text-base sm:text-lg font-bold text-heading group-hover:text-accent transition-colors leading-snug">
        <a href={`/${topic.slug}`} class="focus:outline-none">
          {topic.title}
        </a>
      </h3>
    </div>

    <div class="flex items-center gap-2 shrink-0 text-xs ml-7 sm:ml-0 font-mono">
      <span class="text-muted text-[11px]">{topic.category}</span>
      <span class="text-border">•</span>
      {topic.difficulty && (
        <span class={`text-[10px] font-semibold px-2 py-0.5 rounded border ${difficultyBadge[topic.difficulty]}`}>
          {topic.difficulty}
        </span>
      )}
      <span class="text-border">•</span>
      <span class="text-muted text-[11px]">{topic.readTime}</span>
    </div>
  </div>

  <p class="text-xs sm:text-sm text-muted leading-relaxed pl-7 max-w-3xl">
    {topic.description}
  </p>
</article>
