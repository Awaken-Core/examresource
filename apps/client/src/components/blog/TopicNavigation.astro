---
interface Props {
  subjectSlug: string;
  prevTopic?: {
    slug: string;
    title: string;
  };
  nextTopic?: {
    slug: string;
    title: string;
  };
}

const { subjectSlug, prevTopic, nextTopic } = Astro.props;
---

<nav aria-label="Topic Navigation" class="topic-navigation mt-12 pt-8 border-t border-border/80 grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
  {prevTopic ? (
    <a
      href={`/blog/${subjectSlug}/${prevTopic.slug}`}
      class="group p-4 rounded-lg border border-border bg-surface hover:bg-surface-raised transition-colors flex flex-col justify-between"
    >
      <span class="text-[11px] font-mono uppercase tracking-wider text-muted group-hover:text-accent">
        ← Previous Topic
      </span>
      <span class="text-sm font-semibold text-white group-hover:text-accent mt-1 transition-colors">
        {prevTopic.title}
      </span>
    </a>
  ) : (
    <div class="hidden sm:block"></div>
  )}

  {nextTopic && (
    <a
      href={`/blog/${subjectSlug}/${nextTopic.slug}`}
      class="group p-4 rounded-lg border border-border bg-surface hover:bg-surface-raised transition-colors flex flex-col justify-between text-right sm:col-start-2"
    >
      <span class="text-[11px] font-mono uppercase tracking-wider text-muted group-hover:text-accent">
        Next Topic →
      </span>
      <span class="text-sm font-semibold text-white group-hover:text-accent mt-1 transition-colors">
        {nextTopic.title}
      </span>
    </a>
  )}
</nav>
