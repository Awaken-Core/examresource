{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exam-client",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
