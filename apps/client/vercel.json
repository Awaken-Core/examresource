{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "release/prod": true,
      "*": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.govtpariksha.com"
        }
      ],
      "destination": "https://govtpariksha.com/:path*",
      "permanent": true
    }
  ]
}