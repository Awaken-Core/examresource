{
  "name": "exam-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "worker:dev": "bun run build && wrangler dev",
    "worker:deploy": "bun run build && wrangler deploy",
    "worker:types": "wrangler types",
    "worker:check": "bun run build && wrangler deploy --dry-run",
    "migrate:pg-to-mongo": "node scripts/migrate-pg-to-mongo.mjs",
    "seed:test-series": "node scripts/seed-test-series.mjs",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/observe": "0.3.17",
    "@nestjs/platform-express": "12.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "18.0.9",
    "google-auth-library": "^11.3.1",
    "jsonrepair": "^3.15.0",
    "mongoose": "9.11.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/mau": "0.2.9",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
