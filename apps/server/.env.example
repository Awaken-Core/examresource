DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
# Configure this only when the Clerk webhook endpoint is added.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_your_clerk_webhook_secret
# Cloudflare R2 (server-only credentials; never expose these in the client app)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=examresource-media
# Public bucket custom domain or r2.dev URL, without a trailing slash
R2_PUBLIC_BASE_URL=https://media.example.com
# Google Gemini API Key for Auto-Translation and SEO Analysis
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
