DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/examresource?retryWrites=true&w=majority
# Required only while running `npm run migrate:pg-to-mongo`.
PG_DATABASE_URL=postgres://user:password@hostname:5432/database
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SESSION_TTL_DAYS=30
# A random 32+ character server-only value used to hash anonymous commenter IPs.
COMMENT_IP_HASH_SECRET=
# Google Cloud OAuth web-client credentials. Add this exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# Cloudflare R2 (server-only credentials; never expose these in the client app)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=examresource-media
# Public bucket custom domain or r2.dev URL, without a trailing slash
R2_PUBLIC_BASE_URL=https://media.example.com
# Google Gemini API Key for Auto-Translation and SEO Analysis
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Server-only article providers. Leave blank to keep them disabled.
# BASE_URL must be the provider's API base ending in /v1 (not /chat/completions).
# Model choices and image capabilities live in src/modules/blog/article-models.ts.
# MODEL selects the default from that catalog.
# AI_REQUEST_TIMEOUT_MS= (optional; default: no timeout)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=openai/gpt-oss-120b
