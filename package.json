{
  "name": "Exam",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server \"bun run --cwd apps/client dev\" \"bun run --cwd apps/server start:dev\"",
    "build": "bun run --cwd apps/client build && bun run --cwd apps/server build",
    "start": "bun run --cwd apps/client start && bun run --cwd apps/server start:prod",
    "test": "bun run --cwd apps/server test",
    "typecheck": "bun run --cwd apps/server tsc --noEmit",
    "check:client": "bun run --cwd apps/client astro check",
    "check": "bun run typecheck && bun run check:client",
    "lint": "bun run --cwd apps/server lint",
    "lint:sonar": "eslint \"apps/**/*.ts\" \"apps/**/*.tsx\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@dietrichgebert/ponytail": "5.3.3",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "prettier": "^3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0"
  }
}